# Non-secret settings, available in Builds and Functions on the separate site.
DOS_EMDASH_STAGING=1
# Or https://cms.dzaleka.com after DNS, HTTPS and administrator login are ready.
EMDASH_STAGING_ORIGIN=https://YOUR-STAGING-SITE.netlify.app
EMDASH_STAGING_SITE_ID=YOUR-STAGING-SITE-ID

# Secrets: configure through Netlify. This staging plan uses owner-approved all scopes.
# Prefer Functions-only scope if supported by the plan. Never commit real values.
# Use a separate Supabase project. Runtime uses Transaction pooler (6543); migrations use Session pooler (5432).
# Copy the actual pooler hostname; it cannot be derived from the region.
DATABASE_URL=postgresql://postgres.PROJECT-REF:PASSWORD@POOLER-HOST:6543/postgres?sslmode=verify-full
EMDASH_MIGRATIONS_MODE=check
# Keep DIRECT_URL local for explicit migration commands; Functions do not need it.
DIRECT_URL=postgresql://postgres.PROJECT-REF:PASSWORD@POOLER-HOST:5432/postgres?sslmode=verify-full
# Base64-encode the CA certificate downloaded from Database Settings > SSL configuration.
DATABASE_CA_CERT_BASE64=
# Copy endpoint, region and generated S3 credentials from Supabase Storage settings.
S3_ENDPOINT=https://PROJECT-REF.storage.supabase.co/storage/v1/s3
S3_BUCKET=dos-news-staging
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=YOUR-SUPABASE-PROJECT-REGION
# Leave S3_PUBLIC_URL unset: media stays behind the staging access gate.
EMDASH_ENCRYPTION_KEY=
DOS_STAGING_PASSWORD=
EMDASH_CRON_SECRET=
