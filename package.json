{
  "name": "dzaleka-heritage-archive",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "node ./dist/server/entry.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "news:pilot:prepare": "node scripts/emdash/prepare.mjs",
    "news:pilot": "npm run news:pilot:prepare && node scripts/emdash/dev.mjs",
    "news:pilot:verify": "node scripts/emdash/verify-http.mjs",
    "news:staging:build": "node scripts/emdash/build-staging.mjs",
    "news:staging:check": "node --input-type=module -e \"import { validateStagingRuntime } from './scripts/emdash/staging-env.mjs'; validateStagingRuntime(); console.log('Staging configuration is valid.');\"",
    "news:staging:prepare": "node scripts/emdash/prepare-staging.mjs",
    "news:staging:initialize": "node --env-file=.env.staging scripts/emdash/initialize-staging.mjs",
    "news:staging:verify-build": "node --no-experimental-require-module scripts/emdash/verify-netlify-build.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/netlify": "^8.1.1",
    "@astrojs/node": "^11.0.2",
    "@astrojs/react": "^6.0.1",
    "@aws-sdk/client-s3": "^3.1143.0",
    "@aws-sdk/s3-request-presigner": "^3.1143.0",
    "@googleapis/sheets": "^13.0.2",
    "@netlify/functions": "^5.3.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.6",
    "@tailwindcss/typography": "^0.5.9",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "alpinejs": "^3.13.3",
    "astro": "^7.3.5",
    "astro-icon": "^1.1.4",
    "autoprefixer": "^10.5.2",
    "chart.js": "^4.4.1",
    "cloudinary": "^2.10.0",
    "date-fns": "^2.30.0",
    "emdash": "1.1.0",
    "github-slugger": "2.0.0",
    "googleapis": "^173.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.2.1",
    "leaflet": "^1.9.4",
    "linkedom": "^0.18.12",
    "marked": "^16.1.2",
    "minisearch": "^7.1.1",
    "motion": "^10.16.2",
    "nanostores": "^0.9.5",
    "nodemailer": "^9.0.3",
    "pg": "^8.23.0",
    "postcss": "^8.5.16",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "remark-slug": "^7.0.1",
    "remark-toc": "^8.0.1",
    "resend": "^6.17.1",
    "tailwindcss": "^3.3.3",
    "zod": "^3.22.2"
  },
  "overrides": {
    "@opentelemetry/core": "2.9.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-trace-base": "2.9.0",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "kysely": "0.29.6",
    "vitest": "^3.2.7"
  },
  "emdash": {
    "seed": ".emdash-pilot/seed.json"
  }
}
