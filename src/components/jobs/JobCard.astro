---
import { formatDate } from '../../utils/dateHelpers';

interface Props {
  job: any;
  featured?: boolean;
  isExpired?: boolean;
}

const { job, featured = false, isExpired = false } = Astro.props;
const isClosed = job.data.status === 'closed' || isExpired;

function formatDate(date: Date) {
  return new Date(date).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  });
}

// Category color mapping with standard Tailwind colors
const categoryColors = {
  'education': 'bg-blue-100 text-blue-800 border-blue-200',
  'health': 'bg-green-100 text-green-800 border-green-200',
  'legal': 'bg-purple-100 text-purple-800 border-purple-200',
  'technology': 'bg-indigo-100 text-indigo-800 border-indigo-200',
  'business': 'bg-yellow-100 text-yellow-800 border-yellow-200',
  'community': 'bg-pink-100 text-pink-800 border-pink-200',
  'default': 'bg-gray-100 text-gray-800 border-gray-200'
};

const categoryColor = categoryColors[job.data.category?.toLowerCase()] || categoryColors.default;
---

<article
  class:list={[
    'group relative bg-white rounded-xl shadow-sm hover:shadow-md transition-all duration-200 border border-gray-200 hover:border-primary-200 overflow-hidden',
    featured && 'shadow-md hover:shadow-lg',
    isClosed && 'opacity-75'
  ]}
>
  <!-- Featured Badge -->
  {featured && (
    <div class="absolute -top-3 right-4 z-10">
      <div class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary-600 text-white text-xs font-bold uppercase tracking-wider shadow-md rounded-full">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        Featured
      </div>
    </div>
  )}

  <div class="p-6 sm:p-8">
    <div class="flex flex-col lg:flex-row lg:items-start gap-6">
      <!-- Company Logo/Icon -->
      <div class="flex-shrink-0 hidden lg:block">
        <div class="w-20 h-20 rounded-lg flex items-center justify-center bg-gradient-to-br from-primary-50 to-white border-2 border-primary-200">
          <svg class="w-10 h-10 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
      </div>

      <!-- Job Content -->
      <div class="flex-1 min-w-0">
        <!-- Header Section -->
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-4">
          <div class="flex-1">
            <!-- Organization -->
            <div class="flex items-center gap-2 mb-2">
              <span class="text-sm font-semibold uppercase tracking-wide text-primary-700">
                {job.data.organization}
              </span>
              {/* Status Badge */}
              {isClosed ? (
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-700 border border-red-200">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                  </svg>
                  Closed
                </span>
              ) : (
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold bg-green-100 text-green-700 border border-green-200">
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  Open
                </span>
              )}
            </div>

            <!-- Job Title -->
            <h3 class="text-xl font-bold text-gray-900 mb-3 leading-tight group-hover:text-primary-700 transition-colors">
              <a href={`/jobs/${job.slug}`} class="hover:underline">
                {job.data.title}
              </a>
            </h3>

            <!-- Job Description -->
            {job.data.description && (
              <p class="text-base text-gray-600 line-clamp-2 leading-relaxed">
                {job.data.description}
              </p>
            )}
          </div>
        </div>

        <!-- Job Metadata -->
        <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-gray-100">
          <!-- Location -->
          <div class="inline-flex items-center gap-1.5 text-sm text-gray-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span class="font-medium">{job.data.location}</span>
          </div>

          <!-- Deadline -->
          <div class="inline-flex items-center gap-1.5 text-sm text-gray-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            <span class="font-medium">{formatDate(job.data.deadline)}</span>
          </div>

          <!-- Job Type -->
          <span class="inline-flex items-center px-3 py-1 text-xs font-bold uppercase tracking-wide bg-primary-100 text-primary-800 border border-primary-200 rounded-full">
            {job.data.type}
          </span>

          <!-- Category -->
          <span class:list={[
            'inline-flex items-center px-3 py-1 text-xs font-bold uppercase tracking-wide border rounded-full',
            categoryColor
          ]}>
            {job.data.category}
          </span>

          <!-- View Details Link -->
          <a
            href={`/jobs/${job.slug}`}
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-700 hover:text-primary-900 ml-auto group/link"
          >
            View Details
            <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</article>
