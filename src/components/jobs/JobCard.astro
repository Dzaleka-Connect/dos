---
import { formatDate } from '../../utils/dateHelpers';

interface Props {
  job: any;
  featured?: boolean;
  isExpired?: boolean;
}

const { job, featured = false, isExpired = false } = Astro.props;
const isClosed = job.data.status === 'closed' || isExpired;
---

<article
  class:list={[
    'group flex flex-col sm:flex-row gap-4 sm:items-start justify-between py-5 border-b border-gray-200 last:border-0 hover:bg-slate-50 transition-colors px-3 -mx-3 rounded-xl sm:rounded-none sm:px-0 sm:mx-0 sm:hover:bg-transparent',
    isClosed && 'opacity-60 grayscale-[50%]'
  ]}
>
  <div class="flex-1 min-w-0">
    <div class="flex flex-wrap items-center gap-2 mb-2">
      <span class="text-sm font-semibold text-slate-900">
        {job.data.organization}
      </span>
      {featured && (
        <span class="inline-flex rounded bg-slate-900 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">
          Featured
        </span>
      )}
      {isClosed ? (
        <span class="inline-flex rounded bg-slate-200 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-700">
          Closed
        </span>
      ) : (
        <span class="inline-flex rounded border border-green-200 bg-green-50 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-green-800">
          Open
        </span>
      )}
    </div>

    <h3 class="text-lg sm:text-xl font-bold text-gray-900 mb-2 leading-tight">
      <a href={`/jobs/${job.id}`} class="hover:underline hover:text-slate-700">
        {job.data.title}
      </a>
    </h3>

    {job.data.description && (
      <p class="text-sm text-gray-600 line-clamp-2 md:line-clamp-1 mb-3">
        {job.data.description}
      </p>
    )}

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs sm:text-sm text-gray-500">
      <div class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {job.data.location}
      </div>
      <div class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {formatDate(job.data.deadline)}
      </div>
      <div class="inline-flex items-center gap-1.5 capitalize text-slate-700 font-medium">
        {job.data.type}
      </div>
      <div class="inline-flex items-center gap-1.5 text-slate-500">
        &middot; {job.data.category}
      </div>
    </div>
  </div>
  
  <div class="sm:mt-2 hidden sm:block">
    <a
      href={`/jobs/${job.id}`}
      class="inline-flex items-center text-sm font-medium text-slate-700 hover:text-slate-900 group/link"
    >
      View details
      <svg class="w-4 h-4 ml-1 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</article>
