---
import type { ScoredCoverage } from '../../utils/relatedCoverage';

interface Props {
  items: ScoredCoverage[];
}

const { items } = Astro.props;

const dateFormat = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const kindLabel = (kind: string) =>
  kind === 'resource' ? 'Report' : kind === 'dispatch' ? 'dzaleka.com' : 'News';

const kindClass = (kind: string) =>
  kind === 'resource'
    ? 'bg-primary-50 text-primary-700 ring-1 ring-primary-100'
    : kind === 'dispatch'
      ? 'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-100'
      : 'bg-slate-100 text-slate-600';
---

{items.length > 0 && (
  <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xs" aria-labelledby="coverage-heading">
    <div class="border-b border-slate-200 bg-slate-50 px-4 py-3">
      <h2 id="coverage-heading" class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-slate-600">
        <svg class="h-4 w-4 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        Ongoing coverage
      </h2>
      <p class="mt-1 text-[11px] leading-4 text-slate-500">
        Reporting related to this topic, updated as new items are published.
      </p>
    </div>

    <ul class="divide-y divide-slate-100">
      {items.map((item) => (
        <li>
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class="block px-4 py-3 transition-colors hover:bg-slate-50 focus:bg-slate-50 focus:outline-none"
          >
            <div class="flex items-center gap-2">
              <span class={`rounded px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide ${kindClass(item.kind)}`}>
                {kindLabel(item.kind)}
              </span>
              <time datetime={item.date.toISOString()} class="text-[11px] text-slate-500">
                {dateFormat(item.date)}
              </time>
            </div>
            <p class="mt-1.5 text-sm font-medium leading-5 text-slate-900">
              {item.title}
              {item.external && <span class="ml-1 text-slate-400" aria-label="opens on another site">&#8599;</span>}
            </p>
            {item.publisher && !item.external && (
              <p class="mt-1 text-[11px] text-slate-500">{item.publisher}</p>
            )}
          </a>
        </li>
      ))}
    </ul>

    <div class="border-t border-slate-100 bg-slate-50 px-4 py-2.5">
      <a href="/news" class="text-xs font-medium text-primary-700 underline-offset-2 transition-colors hover:text-primary-900 hover:underline">
        All news and reports &rarr;
      </a>
    </div>
  </section>
)}
