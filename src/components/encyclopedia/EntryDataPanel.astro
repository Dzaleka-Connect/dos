---
import { EntryStatChart } from './EntryStatChart';
import {
  formatPoint,
  scopeLabel,
  sourcesForSeries,
  STAT_SOURCES,
  type StatSeries,
} from '../../data/campStatistics';

interface Props {
  series: StatSeries;
}

const { series } = Astro.props;
const sources = sourcesForSeries(series);
const tableId = `stat-table-${series.id}`;
const headingId = `stat-heading-${series.id}`;
---

{/*
  The figures are rendered as a real <table> in the server HTML, and the chart
  is a progressive enhancement layered on top. With JavaScript disabled, or for
  a crawler, the whole series is still readable.
*/}
<figure
  class="my-8 overflow-hidden rounded-xl border border-slate-200 bg-white not-prose"
  aria-labelledby={headingId}
>
  <div class="border-b border-slate-200 bg-slate-50 px-5 py-4">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h3 id={headingId} class="text-sm font-semibold text-slate-900">{series.title}</h3>
        <p class="mt-1 text-xs text-slate-500">
          {scopeLabel(series.scope)} &middot; measured in {series.unit}
        </p>
      </div>
      <span class="rounded-md border border-slate-200 bg-white px-2 py-1 text-[11px] font-medium text-slate-600">
        {series.points.length} sourced {series.points.length === 1 ? 'point' : 'points'}
      </span>
    </div>
    <p class="mt-3 text-sm leading-6 text-slate-600">{series.description}</p>
  </div>

  <div class="px-5 py-5">
    <EntryStatChart series={series} client:visible />
  </div>

  {series.caveat && (
    <p class="mx-5 mb-5 rounded-lg bg-amber-50 px-4 py-3 text-xs leading-5 text-amber-900 ring-1 ring-amber-200">
      <span class="font-semibold">How to read this:</span> {series.caveat}
    </p>
  )}

  <details class="border-t border-slate-200 group">
    <summary class="cursor-pointer list-none px-5 py-3 text-xs font-semibold text-slate-700 transition-colors hover:bg-slate-50 flex items-center justify-between">
      <span>View the figures and their sources</span>
      <span class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true">&#9662;</span>
    </summary>
    <div class="overflow-x-auto border-t border-slate-100">
      <table id={tableId} class="min-w-full text-sm">
        <caption class="sr-only">
          {series.title}. {scopeLabel(series.scope)}. Measured in {series.unit}.
        </caption>
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="px-5 py-2.5 text-left text-xs font-semibold text-slate-700">Period</th>
            <th scope="col" class="px-5 py-2.5 text-left text-xs font-semibold text-slate-700">Figure</th>
            <th scope="col" class="px-5 py-2.5 text-left text-xs font-semibold text-slate-700">Source</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {series.points.map((point) => {
            const source = STAT_SOURCES[point.sourceId];
            return (
              <tr>
                <th scope="row" class="px-5 py-3 text-left align-top font-medium text-slate-900">
                  {point.label}
                </th>
                <td class="px-5 py-3 align-top text-slate-800">
                  {formatPoint(point, series.unit)}
                  {point.note && <span class="mt-1 block text-xs leading-5 text-slate-500">{point.note}</span>}
                </td>
                <td class="px-5 py-3 align-top text-xs text-slate-600">
                  {source ? (
                    <a
                      href={source.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline underline-offset-2 transition-colors hover:text-primary-700"
                    >
                      {source.publisher}, {source.date}
                    </a>
                  ) : (
                    <span class="text-slate-400">Source not recorded</span>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>

    {sources.length > 0 && (
      <div class="border-t border-slate-100 bg-slate-50 px-5 py-3">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-slate-500">Sources</p>
        <ul class="mt-2 space-y-1.5">
          {sources.map((source) => (
            <li class="text-xs leading-5 text-slate-600">
              <a
                href={source.url}
                target="_blank"
                rel="noopener noreferrer"
                class="underline underline-offset-2 transition-colors hover:text-primary-700"
              >
                {source.title}
              </a>
              <span class="text-slate-500"> &mdash; {source.publisher}, {source.date}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </details>
</figure>
