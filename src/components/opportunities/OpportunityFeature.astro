---
import type { CuratedOpportunity } from '../../data/grantsPrograms';
import { formatOpportunityDate, opportunityStatus } from '../../utils/opportunityDates';
interface Props { program: CuratedOpportunity; }
const { program } = Astro.props;
const status = opportunityStatus(program);
---
<aside class="opportunity-feature" aria-labelledby={`feature-${program.slug}`}>
  {program.image && <a href={`/grants-and-programs/${program.slug}`} tabindex="-1" aria-hidden="true" class="feature-image"><img src={program.image.src} alt="" width="2279" height="879" loading="lazy" /></a>}
  <div class="feature-copy">
    <p class="feature-label">Artist opportunity <span aria-hidden="true">/</span> {status === 'closed' ? 'Applications closed' : status === 'opening soon' ? 'Opening soon' : 'Applications open'}</p>
    <h2 id={`feature-${program.slug}`}><a href={`/grants-and-programs/${program.slug}`}>{program.title}</a></h2>
    <p>{program.summary}</p>
    <p class="feature-date">{program.period}{program.deadline && <> · {status === 'closed' ? 'Closed' : 'Closes'} {formatOpportunityDate(program.deadline)}</>}</p>
    <a class="feature-link" href={`/grants-and-programs/${program.slug}`}>Read eligibility and application details <span aria-hidden="true">→</span></a>
  </div>
</aside>
<style>
  .opportunity-feature { display:grid; gap:1.75rem; align-items:center; padding-block:2rem; border-block:1px solid #cbd5e1; }
  .feature-image { display:block; background:#f1f5f9; }
  .feature-image img { display:block; width:100%; height:auto; }
  .feature-label { color:#475569; font-size:.8125rem; margin-bottom:.65rem; }
  .feature-label span { margin-inline:.5rem; color:#94a3b8; }
  h2 { font-size:1.5rem; line-height:1.3; }
  h2 a { color:#1e4865; text-decoration:none; }
  h2 a:hover { text-decoration:underline; text-underline-offset:4px; }
  .feature-copy > p:not(.feature-label) { color:#475569; font-size:.9375rem; line-height:1.7; margin-top:.75rem; }
  .feature-copy .feature-date { font-size:.8125rem; }
  .feature-link { display:inline-flex; align-items:center; min-height:44px; gap:.6rem; color:#1e4865; text-decoration:underline; text-underline-offset:4px; font-size:.875rem; margin-top:.25rem; }
  @media(min-width:768px) { .opportunity-feature { grid-template-columns: minmax(0,1fr) minmax(0,1.2fr); gap:2.5rem; } }
</style>
