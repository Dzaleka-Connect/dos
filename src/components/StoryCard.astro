---
import { CloudinaryPresets, getPlaceholderUrl } from '../utils/cloudinary';
import { formatDate } from '../utils/dateHelpers';

interface Props {
  story: {
    id: string;
    data: {
      title: string;
      description: string;
      date: string;
      coverImage: string;
      author: {
        name: string;
        role?: string;
      };
      tags?: string[];
      featured?: boolean;
      source?: {
        title: string;
        url: string;
      };
      photos?: Array<{
        image: string;
      }>;
      content?: Array<{
        image?: string;
      }>;
    };
  };
}

const { story } = Astro.props;
const { title, description, date, coverImage, author, tags, featured, source, photos, content } = story.data;
const storyTags = tags ?? [];
const photoCount = photos?.length ?? content?.filter((section) => Boolean(section.image)).length ?? 0;
const displayTags = storyTags.slice(0, 3);

// Optimize cover image using Cloudinary (only if it's a Cloudinary URL)
const originalImage = coverImage;
const optimizedImage = originalImage ? CloudinaryPresets.card(originalImage) : originalImage;
const placeholderImage = (originalImage && optimizedImage !== originalImage)
  ? getPlaceholderUrl(originalImage)
  : null;
---

<article
  data-story-card
  data-story-id={story.id}
  data-title={title.toLowerCase()}
  data-description={description.toLowerCase()}
  data-tags={storyTags.map((tag) => tag.toLowerCase()).join('|')}
  class="h-full"
>
  <a
    href={`/stories/${story.id}`}
    class="flex h-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition hover:border-gray-300 hover:shadow-sm"
  >
    <div class="aspect-[4/3] overflow-hidden bg-gray-100">
      <img
        src={placeholderImage || optimizedImage}
        data-src={placeholderImage ? optimizedImage : undefined}
        alt={title}
        class={`${placeholderImage ? 'lazy-load' : ''} h-full w-full object-cover`}
        loading="lazy"
      />
    </div>

    <div class="flex flex-1 flex-col p-5">
      <div class="flex flex-wrap gap-2">
        <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">
          Photo story
        </span>
        {featured && (
          <span class="rounded-md bg-primary-50 px-2.5 py-1 text-xs font-medium text-primary-700">
            Featured
          </span>
        )}
        {source && (
          <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">
            Adapted source
          </span>
        )}
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-gray-500">
        <span>{formatDate(date)}</span>
        {photoCount > 0 && <span>{photoCount} photos</span>}
      </div>

      <h2 class="mt-3 text-xl font-semibold leading-tight text-gray-900">
        {title}
      </h2>

      <p class="mt-3 line-clamp-3 text-sm leading-6 text-gray-600">
        {description}
      </p>

      {displayTags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {displayTags.map((tag) => (
            <span class="rounded-md bg-gray-50 px-2 py-1 text-xs text-gray-600">
              {tag}
            </span>
          ))}
          {storyTags.length > displayTags.length && (
            <span class="rounded-md bg-gray-50 px-2 py-1 text-xs text-gray-500">
              +{storyTags.length - displayTags.length} more
            </span>
          )}
        </div>
      )}

      <div class="mt-6 flex items-end justify-between gap-4 border-t border-gray-100 pt-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-sm font-semibold text-gray-700">
            <span>
              {author.name.charAt(0)}
            </span>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-900">{author.name}</p>
            {author.role && <p class="text-xs text-gray-500">{author.role}</p>}
          </div>
        </div>

        <span class="text-sm font-medium text-primary-700">
          Read story
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style> 
