---
import { format } from 'date-fns';

interface Props {
  story: {
    data: {
      title: string;
      description: string;
      date: string;
      coverImage: string;
      author: {
        name: string;
        role: string;
      };
      tags: string[];
    };
    slug: string;
  };
}

const { story } = Astro.props;
const { title, description, date, coverImage, author, tags } = story.data;
---

<article class="group relative bg-white rounded-lg shadow-md overflow-hidden transition-all duration-300 hover:shadow-xl">
  <a href={`/stories/${story.slug}`} class="block">
    <div class="aspect-w-16 aspect-h-9 overflow-hidden">
      <img
        src={coverImage}
        alt={title}
        class="w-full h-full object-cover transform transition-transform duration-300 group-hover:scale-105"
      />
    </div>
    
    <div class="p-6">
      <div class="flex items-center gap-2 mb-3">
        {tags.map(tag => (
          <span class="px-2 py-1 text-xs font-medium text-blue-600 bg-blue-50 rounded-full">
            {tag}
          </span>
        ))}
      </div>
      
      <h2 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
        {title}
      </h2>
      
      <p class="text-gray-600 text-sm mb-4 line-clamp-2">
        {description}
      </p>
      
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-gray-200 flex items-center justify-center">
            <span class="text-sm font-medium text-gray-600">
              {author.name.charAt(0)}
            </span>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-900">{author.name}</p>
            <p class="text-xs text-gray-500">{author.role}</p>
          </div>
        </div>
        
        <time class="text-sm text-gray-500">
          {format(new Date(date), 'MMM d, yyyy')}
        </time>
      </div>
    </div>
  </a>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style> 