---
---

<div class="bg-blue-50 p-6 rounded-xl border border-blue-100 my-8">
  <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
    <span class="mr-2">🧮</span> Mobile Money Fee Estimator
  </h3>
  
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Amount to Send (MWK)</label>
      <input 
        type="number" 
        id="amount-input" 
        placeholder="For example, 50000"
        class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 p-2 border"
      />
      <p class="text-xs text-gray-500 mt-1">Includes 2026 Levy (0.05% > K100k)</p>
    </div>

    <div class="bg-white p-4 rounded-lg border border-gray-200 shadow-sm">
      <div class="flex justify-between items-center mb-2">
        <span class="text-sm text-gray-600">Cross-Network Fee:</span>
        <span id="fee-display" class="font-bold text-gray-900">K0</span>
      </div>
      <div class="flex justify-between items-center mb-2">
        <span class="text-sm text-gray-600">Govt Levy (0.05%):</span>
        <span id="levy-display" class="font-bold text-red-600">K0</span>
      </div>
      <div class="border-t border-gray-100 pt-2 flex justify-between items-center">
        <span class="font-bold text-gray-900">Est. Total Cost:</span>
        <span id="total-display" class="font-bold text-blue-600 text-lg">K0</span>
      </div>
    </div>
  </div>
</div>

<script>
  const input = document.getElementById('amount-input') as HTMLInputElement;
  const feeDisplay = document.getElementById('fee-display');
  const levyDisplay = document.getElementById('levy-display');
  const totalDisplay = document.getElementById('total-display');

  function calculate(amount) {
    let fee = 0;
    let levy = 0;

    // Govt Levy: 0.05% for amounts > 100,000
    if (amount > 100000) {
      levy = amount * 0.0005;
    }

    // Cross-Network Fees (Estimates from text)
    if (amount >= 30000 && amount <= 49999) {
      fee = 1765;
    } else if (amount >= 100000 && amount <= 199999) {
      fee = 4165;
    } else if (amount > 0) {
      // Fallback rough estimate for other ranges (~3%)
      fee = amount * 0.03; 
    }

    return { fee, levy };
  }

  if (input) {
    input.addEventListener('input', (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value) || 0;
      const { fee, levy } = calculate(val);

      if (feeDisplay) feeDisplay.textContent = `K${Math.round(fee).toLocaleString()}`;
      if (levyDisplay) levyDisplay.textContent = `K${Math.round(levy).toLocaleString()}`;
      if (totalDisplay) totalDisplay.textContent = `K${Math.round(val + fee + levy).toLocaleString()}`;
    });
  }
</script>
