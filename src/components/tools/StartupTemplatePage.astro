---
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumb from "../ui/Breadcrumb.astro";
import type { CollectionEntry } from "astro:content";
import {
  toolsLibrary,
  templatePath,
  toolsBreadcrumb,
  toolsImage,
} from "../../utils/startupTemplates";

interface Props {
  template: CollectionEntry<"startup-templates">;
  relatedTools: CollectionEntry<"startup-templates">[];
}
const { template, relatedTools } = Astro.props;
const { data } = template;
const canonical = new URL(templatePath(template.id), toolsLibrary.canonical)
  .href;
const downloadPath = `/downloads/templates/${template.id}.txt`;
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: data.title,
  description: data.description,
  url: canonical,
  breadcrumb: toolsBreadcrumb({ id: template.id, title: data.title }),
  isPartOf: {
    "@type": "CollectionPage",
    name: toolsLibrary.title,
    url: toolsLibrary.canonical,
  },
};
---

<MainLayout
  title={data.title}
  description={data.description}
  canonical={canonical}
  image={toolsImage}
  schema={schema}
>
  <div class="startup-template-page bg-white" data-worksheet-title={data.title}>
    <section class="worksheet-header border-b border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-6xl px-4 py-7 sm:px-6 lg:px-8 lg:py-9">
        <div class="template-screen-only">
          <Breadcrumb
            items={[
              { label: "Home", href: "/" },
              { label: "Tools and templates", href: "/tools-and-templates" },
              { label: data.shortTitle },
            ]}
          />
        </div>
        <p class="text-sm font-semibold uppercase tracking-widest text-primary-700">
          Business worksheet
        </p>
        <h1 class="mt-3 max-w-4xl text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          {data.title}
        </h1>
        <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">
          {data.description}
        </p>
        <div class="template-screen-only mt-6 flex flex-wrap items-center gap-3">
          <a
            href="#worksheet"
            class="inline-flex min-h-[44px] items-center justify-center rounded bg-primary-900 px-5 py-3 font-semibold text-white hover:bg-primary-800"
          >
            Start worksheet{" "}
            <span class="ml-3" aria-hidden="true">
              ↓
            </span>
          </a>
          <a
            href={downloadPath}
            download={`${template.id}.txt`}
            class="inline-flex min-h-[44px] items-center justify-center rounded border border-slate-300 bg-white px-4 py-3 font-medium text-slate-700 hover:border-slate-500"
          >
            Download blank (.txt)
          </a>
          <button
            type="button"
            data-worksheet-print
            data-worksheet-js
            hidden
            class="min-h-[44px] rounded px-3 py-3 font-medium text-primary-800 underline underline-offset-4 hover:text-primary-600"
          >
            Print worksheet
          </button>
        </div>
        <p class="hidden print:mt-2 print:block print:text-sm">
          Dzaleka Online Services
        </p>
      </div>
    </section>

    <div class="worksheet-layout mx-auto grid max-w-6xl gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-12 lg:px-8">
      <aside class="template-screen-only hidden lg:block">
        <nav aria-label="Worksheet sections" class="sticky top-28">
          <h2 class="border-b border-slate-200 pb-3 text-sm font-semibold text-slate-900">
            In this worksheet
          </h2>
          <ol class="mt-2 space-y-1">
            {data.sections.map((section, index) => (
              <li>
                <a
                  href={`#section-${index + 1}`}
                  class="flex min-h-[44px] items-start gap-3 py-2 text-sm leading-6 text-slate-600 hover:text-primary-800 hover:underline"
                >
                  <span
                    class="font-semibold text-primary-700"
                    aria-hidden="true"
                  >
                    {index + 1}.
                  </span>
                  {section.title}
                </a>
              </li>
            ))}
          </ol>
          <a
            href="#worked-example"
            class="mt-4 block border-t border-slate-200 py-4 text-sm font-medium text-primary-800 underline underline-offset-4"
          >
            See a fictional example
          </a>
        </nav>
      </aside>

      <div class="min-w-0">
        <details class="template-screen-only mb-7 rounded border border-slate-200 bg-white">
          <summary class="cursor-pointer px-5 py-4 font-semibold text-slate-900">
            Before you start
          </summary>
          <div class="border-t border-slate-200 px-5 py-4 text-sm leading-7 text-slate-600">
            <p>
              <strong class="text-slate-900">Useful for:</strong> {data.bestFor}
              .
            </p>
            <ul class="mt-3 list-disc space-y-1 pl-5">
              {data.beforeYouStart.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </details>
        <details class="template-screen-only mb-6 border-b border-slate-200 pb-4 lg:hidden">
          <summary class="cursor-pointer font-semibold text-primary-800">
            Jump to a section
          </summary>
          <ol class="mt-3 space-y-1">
            {data.sections.map((section, index) => (
              <li>
                <a
                  href={`#section-${index + 1}`}
                  class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4"
                >
                  {index + 1}. {section.title}
                </a>
              </li>
            ))}
          </ol>
        </details>

        <section
          id="worksheet"
          tabindex="-1"
          aria-labelledby="worksheet-heading"
          class="scroll-mt-28"
        >
          <div class="template-screen-only mb-6">
            <h2
              id="worksheet-heading"
              class="text-2xl font-bold text-slate-900"
            >
              Your worksheet
            </h2>
            <p
              id="worksheet-instructions"
              class="mt-2 text-sm leading-6 text-slate-600"
            >
              Type your notes below, then download or print a copy. Notes stay
              on this page and are not saved when you leave.
            </p>
            <noscript>
              <p class="mt-2 text-sm text-slate-600">
                To include typed notes in a download or printout, enable
                JavaScript. You can still download the blank worksheet.
              </p>
            </noscript>
          </div>
          <div class="space-y-8">
            {data.sections.map((section, sectionIndex) => (
              <section
                id={`section-${sectionIndex + 1}`}
                data-worksheet-section={section.title}
                aria-labelledby={`section-heading-${sectionIndex}`}
                class="worksheet-section scroll-mt-28 border-t-2 border-primary-800"
              >
                <div class="section-heading flex gap-3 bg-slate-50 px-4 py-4 sm:px-5">
                  <span
                    class="section-number text-xl font-semibold text-primary-700"
                    aria-hidden="true"
                  >
                    {String(sectionIndex + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <h3
                      id={`section-heading-${sectionIndex}`}
                      class="text-xl font-bold text-slate-900"
                    >
                      {section.title}
                    </h3>
                    <p class="mt-1 text-sm leading-6 text-slate-600">
                      {section.description}
                    </p>
                  </div>
                </div>
                <div class="divide-y divide-slate-200 border-x border-b border-slate-200">
                  {section.rows.map((row, rowIndex) => {
                    const id = `answer-${sectionIndex}-${rowIndex}`;
                    return (
                      <div class="worksheet-row grid gap-3 px-4 py-5 sm:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] sm:gap-5 sm:px-5">
                        <div>
                          <label for={id} class="font-semibold text-slate-900">
                            {row.label}
                          </label>
                          <p
                            id={`${id}-hint`}
                            class="mt-1 text-sm leading-6 text-slate-600"
                          >
                            {row.prompt}
                          </p>
                        </div>
                        <textarea
                          id={id}
                          rows={3}
                          autocomplete="off"
                          aria-describedby={`${id}-hint worksheet-instructions`}
                          data-label={row.label}
                          data-prompt={row.prompt}
                          class="min-h-[100px] w-full resize-y rounded border border-slate-400 bg-white px-3 py-2 text-base leading-6 text-slate-900 focus:border-primary-700 focus:ring-2 focus:ring-primary-600"
                        ></textarea>
                        <div
                          data-print-answer={id}
                          class="print-answer hidden whitespace-pre-wrap break-words print:block"
                        ></div>
                      </div>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>
          <div
            class="template-screen-only mt-7 border-l-4 border-primary-700 bg-primary-50 p-5"
            data-worksheet-js
            hidden
          >
            <h3 class="font-semibold text-slate-900">
              Keep a copy of your notes
            </h3>
            <div class="mt-3 flex flex-wrap gap-3">
              <a
                href={downloadPath}
                download={`${template.id}.txt`}
                data-worksheet-download
                class="inline-flex min-h-[44px] items-center rounded bg-primary-900 px-4 py-3 font-semibold text-white hover:bg-primary-800"
              >
                Download notes (.txt)
              </a>
              <button
                type="button"
                data-worksheet-print
                class="min-h-[44px] rounded border border-primary-300 bg-white px-4 py-3 font-medium text-primary-900 hover:border-primary-700"
              >
                Print worksheet
              </button>
            </div>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              The text file opens in a text editor. You can also choose “Save as
              PDF” in your browser’s print menu.
            </p>
          </div>
        </section>

        <section
          id="worked-example"
          aria-labelledby="example-heading"
          class="template-screen-only mt-10 scroll-mt-28"
        >
          <h2 id="example-heading" class="text-2xl font-bold text-slate-900">
            Worked example
          </h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            A fictional business, shown to help you fill in the worksheet.
          </p>
          <details class="mt-4 rounded border border-slate-200">
            <summary class="cursor-pointer bg-slate-50 px-5 py-4 font-semibold text-primary-800">
              {data.example.businessName}: {data.example.businessType}
            </summary>
            <div class="space-y-5 border-t border-slate-200 p-5 text-sm leading-7 text-slate-600">
              <p>{data.example.summary}</p>
              {data.example.sections.map((section) => (
                <div>
                  <h3 class="font-semibold text-slate-900">{section.title}</h3>
                  <ul class="mt-2 list-disc space-y-1 pl-5">
                    {section.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        </section>
        {relatedTools.length > 0 && (
          <section
            aria-labelledby="related-heading"
            class="template-screen-only mt-10 border-t border-slate-200 pt-7"
          >
            <h2 id="related-heading" class="text-xl font-bold text-slate-900">
              Related templates
            </h2>
            <ul class="mt-3 divide-y divide-slate-200">
              {relatedTools.map((tool) => (
                <li>
                  <a
                    href={templatePath(tool.id)}
                    class="flex min-h-[44px] items-center justify-between gap-3 py-3 font-medium text-primary-800 underline underline-offset-4 hover:text-primary-600"
                  >
                    {tool.data.shortTitle}
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
            <a
              href="/tools-and-templates"
              class="mt-4 inline-flex min-h-[44px] items-center text-sm font-medium text-primary-800 underline underline-offset-4"
            >
              All tools and templates
            </a>
          </section>
        )}
      </div>
    </div>
  </div>
</MainLayout>

<script>
  import { initWorksheet } from "../../utils/startupTemplates";
  document
    .querySelectorAll<HTMLElement>("[data-worksheet-title]")
    .forEach(initWorksheet);
</script>

<style>
  .startup-template-page [hidden] {
    display: none;
  }
  .startup-template-page :is(a, button, summary):focus-visible {
    outline: 3px solid #0284c7;
    outline-offset: 3px;
  }
  @media print {
    @page {
      margin: 15mm;
    }
    :global(body) {
      background: white !important;
    }
    :global(body > astro-dev-toolbar),
    :global(.toast-container) {
      display: none !important;
    }
    .template-screen-only,
    textarea {
      display: none !important;
    }
    .worksheet-layout {
      display: block;
      padding: 0;
      max-width: none;
    }
    .worksheet-header {
      background: white;
      border: 0;
    }
    .worksheet-header > div {
      padding: 0 0 1rem;
    }
    h1 {
      font-size: 22pt;
    }
    .worksheet-header p {
      font-size: 10pt;
      line-height: 1.5;
    }
    .worksheet-section {
      margin-top: 1rem;
      border-color: #334155;
    }
    .section-heading {
      break-after: avoid;
      padding: 0.5rem 0;
      background: white;
    }
    .section-heading h3 {
      font-size: 13pt;
    }
    .section-heading p {
      font-size: 9pt;
      line-height: 1.4;
    }
    .worksheet-row {
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: 1rem;
      padding: 0.65rem;
      break-inside: avoid;
      font-size: 10pt;
    }
    .worksheet-row p {
      font-size: 9pt;
      line-height: 1.4;
    }
    .print-answer {
      display: block;
      min-height: 3.5rem;
      font-size: 10pt;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }
    .print-answer:empty {
      border-bottom: 1px solid #94a3b8;
    }
  }
</style>
