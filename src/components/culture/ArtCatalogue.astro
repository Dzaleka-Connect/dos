---
import { getCollection } from 'astro:content';
import Breadcrumb from '../ui/Breadcrumb.astro';
import Pagination from '../ui/Pagination.astro';
import CultureNav from './CultureNav.astro';
import OpportunityFeature from '../opportunities/OpportunityFeature.astro';
import { papitaKhasuResidency } from '../../data/papitaKhasuResidency';
import { formatRecordDate } from '../../utils/recordMedia';
const { currentPage = 1 } = Astro.props;
const artworks = Object.values(import.meta.glob('../../content/artworks/*.md', { eager: true }));
const slug = artwork => artwork.file.split('/').pop().replace('.md', '');
const artworkHref = artwork => `/public-art-catalogue/${slug(artwork)}`;
const artistCredit = artwork => artwork.frontmatter.artistName === 'Unknown' ? 'Artist not yet identified' : artwork.frontmatter.artistName;
// Prefer featured works with a precise installation date; preserve approximate dates as supplied.
const installedTime = artwork => /^\d{4}(-\d{2})?(-\d{2})?$/.test(String(artwork.frontmatter.dateInstalled)) ? Date.parse(artwork.frontmatter.dateInstalled) : 0;
artworks.sort((a, b) => Number(Boolean(b.frontmatter.featured)) - Number(Boolean(a.frontmatter.featured)) || installedTime(b) - installedTime(a) || a.frontmatter.title.localeCompare(b.frontmatter.title));
const artists = (await getCollection('artists')).filter(artist => artist.data.spotlight).sort((a, b) => a.data.artistName.localeCompare(b.data.artistName)).slice(0, 6);
const totalPages = Math.max(1, Math.ceil(artworks.length / 9));
const page = Math.min(Math.max(Number.isFinite(currentPage) ? currentPage : 1, 1), totalPages);
const start = (page - 1) * 9;
const visible = artworks.slice(start, start + 9);
const featured = page === 1 ? visible[0] : undefined;
const remaining = featured ? visible.slice(1) : visible;
---
<div class="art-catalogue">
  <header class="catalogue-heading catalogue-width">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Culture', href: '/culture' }, { label: 'Public Art Catalogue' }]} />
    <div class="heading-row">
      <div><h1>Public Art Catalogue</h1><p>Art on the walls and in the shared spaces of Dzaleka. Explore the works, the artists and the stories behind them.</p></div>
      <a class="text-link" href="/public-art-catalogue/submit">Contribute an artwork <span aria-hidden="true">↗</span></a>
    </div>
  </header>
  <CultureNav current="/public-art-catalogue" />
  <div class="catalogue-width catalogue-body">
    <section id="artworks" aria-labelledby="collection-heading">
      <div class="section-heading"><h2 id="collection-heading">In the collection</h2><p>{artworks.length} documented {artworks.length === 1 ? 'work' : 'works'}</p></div>
      {featured && <figure class="featured-work">
        <a class="art-image featured-image" href={artworkHref(featured)} aria-label={`View ${featured.frontmatter.title}`}><img src={featured.frontmatter.image} alt={featured.frontmatter.title} fetchpriority="high" /></a>
        <figcaption class="featured-caption">
          <div><p class="art-meta">{featured.frontmatter.category} · {formatRecordDate(featured.frontmatter.dateInstalled)}</p><h3><a href={artworkHref(featured)}>{featured.frontmatter.title}</a></h3></div>
          <div><p class="artist-credit">{artistCredit(featured)}</p><p class="art-location">{featured.frontmatter.location}</p><a class="text-link" href={artworkHref(featured)}>Explore this artwork <span aria-hidden="true">→</span></a></div>
        </figcaption>
      </figure>}
      <div class="artwork-grid">{remaining.map(artwork => <figure>
        <a class="art-image collection-image" href={artworkHref(artwork)} aria-label={`View ${artwork.frontmatter.title}`}><img src={artwork.frontmatter.image} alt={artwork.frontmatter.title} loading="lazy" /></a>
        <figcaption><p class="art-meta">{artwork.frontmatter.category} · {formatRecordDate(artwork.frontmatter.dateInstalled)}</p><h3><a href={artworkHref(artwork)}>{artwork.frontmatter.title}</a></h3><p class="artist-credit">{artistCredit(artwork)}</p><p class="art-location">{artwork.frontmatter.campZone}</p></figcaption>
      </figure>)}</div>
      {!visible.length && <p>No artworks have been published yet. You can help by contributing a record.</p>}
      {totalPages > 1 && <div class="catalogue-pagination"><Pagination currentPage={page} totalPages={totalPages} baseUrl="/public-art-catalogue" /></div>}
    </section>
    {page === 1 && <>
      {artists.length > 0 && <section class="artist-section" aria-labelledby="artists-heading">
        <div class="section-heading"><h2 id="artists-heading">Dzaleka’s visual artists</h2><a class="text-link" href="/public-art-catalogue/visual-arts-community">All visual artists <span aria-hidden="true">→</span></a></div>
        <ul class="artist-list">{artists.map(artist => <li><a href={`/public-art-catalogue/artist/${artist.id}`}>
          {artist.data.image && <img src={artist.data.image} alt="" width="80" height="100" loading="lazy" />}
          <span><strong>{artist.data.artistName}</strong><span class="artist-medium">{artist.data.medium}</span></span>
        </a></li>)}</ul>
      </section>}
      <OpportunityFeature program={papitaKhasuResidency} />
    </>}
    <aside class="collection-note"><h2>A growing record of public art</h2><div><p>This community catalogue documents artworks, locations and artist credits as information becomes available. Help us identify an artist, add a work or correct a record.</p><div class="collection-links"><a class="text-link" href="/public-art-catalogue/about">About the catalogue</a><a class="text-link" href="/photo-guidelines">Photo guidelines</a><a class="text-link" href="/public-art-catalogue/license">Image and artwork usage</a></div></div></aside>
  </div>
</div>
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Dzaleka Public Art Catalogue', numberOfItems: artworks.length,
  itemListElement: visible.map((artwork, index) => ({ '@type': 'ListItem', position: start + index + 1, name: artwork.frontmatter.title, url: `https://services.dzaleka.com${artworkHref(artwork)}` })),
})} />
<style>
  .art-catalogue { background:white; color:#334155; }
  .catalogue-width { max-width:80rem; margin-inline:auto; padding-inline:2rem; }
  .catalogue-heading { padding-block:1.75rem 2rem; }
  .heading-row { display:flex; justify-content:space-between; align-items:end; gap:2rem; margin-top:1.5rem; }
  h1 { font-size:clamp(2rem,4vw,3rem); line-height:1.15; color:#1e4865; letter-spacing:-.025em; }
  .heading-row p { max-width:43rem; font-size:1rem; line-height:1.75; margin-top:1rem; }
  .heading-row > a { flex-shrink:0; }
  .text-link { display:inline-flex; align-items:center; gap:.5rem; min-height:44px; font-size:.875rem; color:#1e4865; text-decoration:underline; text-underline-offset:4px; }
  .catalogue-body { padding-block:2rem 3rem; display:grid; gap:3rem; }
  .section-heading { display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:.5rem 1.5rem; margin-bottom:1.5rem; }
  h2 { font-size:1.5rem; line-height:1.35; color:#1e4865; }
  .section-heading p { font-size:.8125rem; color:#64748b; }
  .art-image { display:block; background:#f1f3f4; }
  .art-image img { display:block; width:100%; }
  .featured-image img { height:auto; max-height:36rem; object-fit:contain; }
  .featured-caption { display:grid; grid-template-columns:1.2fr 1fr; gap:2rem; padding-block:1.25rem 2.25rem; }
  .art-meta { font-size:.8125rem; color:#64748b; margin-bottom:.5rem; }
  h3 { font-size:1.25rem; line-height:1.4; }
  .featured-caption h3 { font-size:clamp(1.4rem,2.5vw,1.875rem); max-width:35rem; }
  h3 a { color:#1e4865; text-decoration:underline; text-decoration-color:#b1c0ca; text-underline-offset:5px; text-decoration-thickness:1px; }
  h3 a:hover { text-decoration-color:currentColor; }
  .artist-credit { font-size:.9375rem; line-height:1.6; margin-top:.6rem; }
  .featured-caption .artist-credit { margin-top:0; }
  .art-location { font-size:.8125rem; line-height:1.6; color:#64748b; margin-top:.35rem; }
  .artwork-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2.5rem 2rem; }
  .collection-image img { aspect-ratio:3/2; object-fit:contain; }
  .artwork-grid figcaption { padding-top:1rem; }
  .catalogue-pagination { border-top:1px solid #e2e8f0; margin-top:2rem; padding-top:1.5rem; }
  .artist-section { border-top:1px solid #cbd5e1; padding-top:2rem; }
  .artist-list { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; list-style:none; padding:0; }
  .artist-list a { display:flex; align-items:center; gap:1rem; color:#1e4865; text-decoration:none; }
  .artist-list img { flex-shrink:0; width:4rem; height:5rem; object-fit:contain; background:#f1f3f4; }
  .artist-list strong { font-size:.9375rem; line-height:1.4; font-weight:600; }
  .artist-list a:hover strong { text-decoration:underline; text-underline-offset:4px; }
  .artist-medium { display:block; font-size:.8125rem; color:#64748b; line-height:1.6; margin-top:.35rem; }
  .collection-note { display:grid; grid-template-columns:1fr 2fr; gap:2rem; }
  .collection-note h2 { font-size:1.125rem; }
  .collection-note p { font-size:.9375rem; line-height:1.75; max-width:45rem; }
  .collection-links { display:flex; flex-wrap:wrap; gap:0 1.5rem; margin-top:.5rem; }
  @media(max-width:767px) {
    .catalogue-width { padding-inline:1rem; }
    .catalogue-heading { padding-top:1.25rem; padding-bottom:1.25rem; }
    .heading-row { display:block; margin-top:1rem; }
    .heading-row p { margin-top:.75rem; }
    .heading-row > a { margin-top:.5rem; }
    .catalogue-body { padding-top:1.5rem; gap:2rem; }
    .featured-caption { grid-template-columns:1fr; gap:.75rem; padding-bottom:1.5rem; }
    .artwork-grid { gap:2rem; }
    .artist-list { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .collection-note { grid-template-columns:1fr; gap:.75rem; }
  }
  @media(max-width:479px) { .artwork-grid,.artist-list { grid-template-columns:1fr; } }
</style>
