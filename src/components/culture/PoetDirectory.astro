---
import { getCollection } from 'astro:content';
import CollectionHeader from '../ui/CollectionHeader.astro';
import DirectoryCard from '../ui/DirectoryCard.astro';
import Pagination from '../ui/Pagination.astro';
import CultureNav from './CultureNav.astro';
const { currentPage = 1 } = Astro.props;
const profiles = (await getCollection('poets')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const totalPages = Math.max(1, Math.ceil(profiles.length / 6));
const start = (currentPage - 1) * 6;
const visible = profiles.slice(start, start + 6);
---
<CollectionHeader title="Poets from Dzaleka" description="Read about Dzaleka’s poets and spoken word artists, explore their writing, and find information about readings and performances." action={{ label: 'Add a poet profile', href: '/poets/submit' }} />
<CultureNav current="/poets" />
<section id="browse-poets" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
  <div class="mb-6 flex flex-wrap items-baseline justify-between gap-3"><h2 class="text-primary-900">Poet directory</h2><p class="text-sm text-slate-600">{profiles.length ? `${start + 1}–${Math.min(start + 6, profiles.length)} of ${profiles.length} poets` : 'No profiles published yet'}</p></div>
  <div class="grid auto-rows-fr gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {visible.map(poet => <DirectoryCard title={poet.data.title} href={`/poets/${poet.id}`} image={poet.data.image} description={poet.data.description} meta={poet.data.nationality} portrait contain />)}
  </div>
  {totalPages > 1 && <div class="mt-8 border-t border-slate-200 pt-6"><Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/poets" urlStyle="path" /></div>}
  <aside class="mt-10 border-t border-slate-200 pt-6"><h2 class="text-primary-900">Readings and spoken word</h2><p class="mt-3 max-w-3xl text-base leading-7 text-slate-700">Individual profiles include writing, background and available contact information. You can also <a href="/contact" class="text-primary-800 underline underline-offset-4">ask the team about a reading</a> or <a href="/events" class="text-primary-800 underline underline-offset-4">browse community events</a>.</p></aside>
</section>
<script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'ItemList', name: 'Poets from Dzaleka', numberOfItems: profiles.length, itemListElement: visible.map((poet, i) => ({ '@type': 'ListItem', position: start + i + 1, name: poet.data.title, url: `https://services.dzaleka.com/poets/${poet.id}` })) })} />
