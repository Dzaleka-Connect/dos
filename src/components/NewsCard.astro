---
import { getCloudinaryUrl, getPlaceholderUrl } from '../utils/cloudinary';

interface Props {
  news: any;
  featured?: boolean;
  large?: boolean;
}

const { news, featured = false, large = false } = Astro.props;
const { data, id } = news;

// Format date
const formattedDate = new Date(data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Get category label
const categoryLabels = {
  'business-spotlight': 'Business Spotlight',
  'announcement': 'Announcement',
  'success-story': 'Success Story',
  'news': 'News',
  'business-guide': 'Business Guide'
};

// Get category color - Using standard Tailwind colors for better readability
const categoryColors = {
  'business-spotlight': 'bg-orange-100 text-orange-800 border-orange-300',
  'announcement': 'bg-yellow-100 text-yellow-800 border-yellow-300',
  'success-story': 'bg-green-100 text-green-800 border-green-300',
  'news': 'bg-blue-100 text-blue-800 border-blue-300',
  'business-guide': 'bg-purple-100 text-purple-800 border-purple-300'
};

// Optimize image using Cloudinary (only if it's a Cloudinary URL)
const optimizedImage = data.image
  ? getCloudinaryUrl(data.image, {
      width: large ? 1200 : 800,
      height: large ? 675 : 450,
      crop: 'fill',
      gravity: 'auto',
      quality: 'auto:good',
      dpr: 'auto'
    })
  : null;

// Only use placeholder for Cloudinary images
const placeholderImage = (data.image && optimizedImage !== data.image)
  ? getPlaceholderUrl(data.image)
  : null;
---

<a
  href={`/news/${id}`}
  class={`group relative flex ${large ? 'flex-col lg:flex-row' : 'flex-col'} bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-500 overflow-hidden border-2 ${featured ? 'border-primary-200' : 'border-gray-100 hover:border-primary-200'}`}
>
  <div class={`relative ${large ? 'lg:w-2/3' : 'w-full'}`}>
    {optimizedImage ? (
      <img
        src={placeholderImage || optimizedImage}
        data-src={placeholderImage ? optimizedImage : undefined}
        alt={data.title}
        class={`${placeholderImage ? 'lazy-load' : ''} w-full object-cover ${large ? 'h-72 lg:h-full' : 'h-48'} transition-opacity duration-300`}
        loading="lazy"
      />
    ) : (
      <div class={`w-full flex items-center justify-center bg-gray-100 ${large ? 'h-72 lg:h-full' : 'h-48'}`}>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-2-2h-2" />
        </svg>
      </div>
    )}
    <div class="absolute top-4 left-4 flex flex-wrap gap-2 max-w-[calc(100%-2rem)]">
      <span class={`inline-flex items-center px-3 py-1.5 rounded-full text-sm font-semibold border-2 backdrop-blur-sm ${categoryColors[data.category]}`}>>
        {categoryLabels[data.category]}
      </span>
      {featured && (
        <span class="inline-flex items-center px-3 py-1.5 rounded-full text-sm font-semibold bg-primary-100 text-primary-800 border-2 border-primary-300 backdrop-blur-sm">
          Featured
        </span>
      )}
    </div>
  </div>

  <div class={`flex flex-col ${large ? 'lg:w-1/3' : ''} p-6 ${large ? 'lg:p-8' : ''}`}>
    <div class="flex items-center gap-2 text-sm text-gray-600 mb-3">
      <time datetime={data.date.toISOString()}>{formattedDate}</time>
      {data.author && (
        <>
          <span>•</span>
          <span>{data.author}</span>
        </>
      )}
    </div>

    <h3 class={`font-heading ${large ? 'text-2xl lg:text-3xl' : 'text-xl'} font-bold text-gray-900 group-hover:text-primary-600 transition-colors duration-300 mb-3`}>>
      {data.title}
    </h3>

    <p class={`font-body text-gray-700 ${large ? 'text-lg' : ''} mb-6 line-clamp-3 leading-relaxed`}>
      {data.description}
    </p>

    {data.businessName && (
      <div class="mt-auto border-t pt-4">
        <div class="text-sm text-gray-600">
          <p><span class="font-medium">Business:</span> {data.businessName}</p>
          {data.businessOwner && (
            <p><span class="font-medium">Owner:</span> {data.businessOwner}</p>
          )}
        </div>
      </div>
    )}

    <div class="mt-6 flex items-center font-body text-primary-600 font-medium group-hover:text-primary-700 transition-colors duration-300">
      Read more
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </div>
  </div>
</a>
