---
import { getCloudinaryUrl, getPlaceholderUrl } from '../utils/cloudinary';

interface Props {
  news: any;
  featured?: boolean;
  large?: boolean;
}

const { news, featured = false, large = false } = Astro.props;
const { data, id } = news;

const formattedDate = new Date(data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const categoryLabels = {
  'business-spotlight': 'Business spotlight',
  announcement: 'Announcement',
  'success-story': 'Success story',
  news: 'Community update',
  'business-guide': 'Business guide'
};

const optimizedImage = data.image
  ? getCloudinaryUrl(data.image, {
      width: large ? 1200 : 800,
      height: large ? 780 : 450,
      crop: 'fill',
      gravity: 'auto',
      quality: 'auto:good',
      dpr: 'auto'
    })
  : null;

const placeholderImage = data.image && optimizedImage !== data.image
  ? getPlaceholderUrl(data.image)
  : null;
---

<a
  href={`/news/${id}`}
  class={`group block overflow-hidden rounded-lg border border-slate-200 bg-white transition-colors hover:border-slate-300 ${large ? 'h-full' : ''}`}
>
  <div class="relative overflow-hidden bg-slate-100 aspect-[16/10]">
    {optimizedImage ? (
      <img
        src={placeholderImage || optimizedImage}
        data-src={placeholderImage ? optimizedImage : undefined}
        alt={data.title}
        class={`${placeholderImage ? 'lazy-load' : ''} h-full w-full object-cover`}
        loading="lazy"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center bg-slate-100">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2 2 0 00-2-2h-2" />
        </svg>
      </div>
    )}

    <div class="absolute left-4 top-4 flex flex-wrap gap-2">
      <span class="inline-flex items-center rounded-md bg-white/95 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-slate-700">
        {categoryLabels[data.category]}
      </span>
      {featured && (
        <span class="inline-flex items-center rounded-md bg-slate-900 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-white">
          Featured
        </span>
      )}
    </div>
  </div>

  <div class={`p-5 ${large ? 'sm:p-6' : ''}`}>
    <div class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
      <time datetime={data.date.toISOString()}>{formattedDate}</time>
      {data.author && (
        <>
          <span aria-hidden="true">•</span>
          <span>{data.author}</span>
        </>
      )}
    </div>

    <h3 class={`mt-3 font-semibold tracking-tight text-slate-900 ${large ? 'text-2xl sm:text-[2rem]' : 'text-lg'}`}>
      {data.title}
    </h3>

    <p class={`mt-3 text-slate-600 ${large ? 'text-base leading-7' : 'text-sm leading-6'} line-clamp-3`}>
      {data.description}
    </p>

    {data.businessName && (
      <div class="mt-4 border-t border-slate-200 pt-4 text-sm text-slate-600">
        <p><span class="font-medium text-slate-800">Business:</span> {data.businessName}</p>
        {data.businessOwner && (
          <p class="mt-1"><span class="font-medium text-slate-800">Owner:</span> {data.businessOwner}</p>
        )}
      </div>
    )}

    <div class="mt-5 text-sm font-medium text-primary-700">
      Read article
    </div>
  </div>
</a>
