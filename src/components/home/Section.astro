---
interface Props {
  id: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  tone?: 'white' | 'subtle';
}

const { id, title, description, href, linkLabel, tone = 'white' } = Astro.props;
---

<section class:list={['py-10 sm:py-12', tone === 'subtle' ? 'bg-slate-50' : 'bg-white']} aria-labelledby={id}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-6 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
      <div>
        <h2 id={id} class="text-2xl font-semibold text-slate-900">{title}</h2>
        {description && <p class="mt-2 text-sm leading-6 text-slate-600">{description}</p>}
      </div>
      {href && linkLabel && (
        <a href={href} class="inline-flex min-h-[44px] shrink-0 items-center gap-2 self-start text-sm font-medium text-primary-800 underline underline-offset-4 hover:text-primary-900 hover:decoration-2">
          {linkLabel}<span aria-hidden="true">→</span>
        </a>
      )}
    </div>
    <slot />
  </div>
</section>
