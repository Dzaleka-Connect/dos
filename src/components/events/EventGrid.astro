---
import { format } from 'date-fns';
import type { CollectionEntry } from 'astro:content';

interface Props {
  events: CollectionEntry<'events'>[];
}

const { events } = Astro.props;

// Function to format location
function formatLocation(location: any) {
  if (typeof location === 'string') return location;
  return location.venue && location.city ? `${location.venue}, ${location.city}` : location.venue || location.city || 'Location TBA';
}

// Function to format date in CAT timezone (UTC+2)
function formatDateInCAT(date: Date, formatString: string) {
  try {
    // Create a new date object and add 2 hours for CAT timezone
    const catDate = new Date(date.getTime() + (2 * 60 * 60 * 1000));
    return format(catDate, formatString);
  } catch (error) {
    // Fallback to original date if conversion fails
    return format(date, formatString);
  }
}
---

<div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
  {events.map(event => (
    <article class="group relative flex h-full min-w-0 flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition-colors hover:border-gray-300">
      <a href={`/events/${event.id}`} class="flex min-w-0 flex-grow flex-col">
        <div class="aspect-w-16 aspect-h-9 relative overflow-hidden flex-shrink-0">
          <img
            src={event.data.image}
            alt={event.data.title}
            class="w-full h-full object-cover"
          />
          {/* Category badge */}
          <div class="absolute bottom-3 right-3 z-10 max-w-[calc(100%-1.5rem)]">
            <span class="inline-flex w-fit max-w-full truncate rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-medium text-gray-800 shadow-sm">
              {event.data.category}
            </span>
          </div>
        </div>
        <div class="flex min-w-0 flex-1 flex-col p-5 sm:p-6">
          <div class="mb-3 flex min-w-0 flex-wrap items-center gap-2">
            <time datetime={event.data.date.toISOString()} class:list={[
              'inline-flex w-fit max-w-full flex-none items-center rounded-md bg-gray-50 px-2.5 py-1 text-sm font-body',
              event.data.isTBA ? 'text-amber-700 font-medium' : 'text-gray-500'
            ]}>
              <svg xmlns="http://www.w3.org/2000/svg" class="mr-1 h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span class="truncate">{event.data.isTBA ? 'Date TBA' : formatDateInCAT(event.data.date, 'MMM d, yyyy')}</span>
            </time>

            {/* Status indicator */}
            <span class="inline-flex w-fit flex-none rounded-full px-2 py-1 text-xs font-medium capitalize" class:list={{
              'bg-gray-100 text-gray-700 border border-gray-200': event.data.status === 'upcoming',
              'bg-gray-50 text-gray-600 border border-gray-100': event.data.status === 'past'
            }}>
              {event.data.status}
            </span>

            {/* Panelist indicator */}
            {event.data.panelists && event.data.panelists.length > 0 && (
              <span class="inline-flex w-fit flex-none items-center gap-1 rounded-full border border-gray-200 bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600">
                <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                <span>{event.data.panelists.length} panelist{event.data.panelists.length > 1 ? 's' : ''}</span>
              </span>
            )}
          </div>
          <h3 class="font-heading text-lg font-bold text-gray-900 mb-3 group-hover:text-gray-700 transition-colors duration-300 line-clamp-2 break-words">{event.data.title}</h3>
          <p class="font-body text-gray-700 text-sm mb-4 line-clamp-2 leading-relaxed break-words">{event.data.description}</p>

          {/* Time and Location - Stack on mobile, side by side on desktop */}
          <div class="space-y-3 mb-4">
            <div class="flex min-w-0 items-center text-gray-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <time datetime={event.data.date.toISOString()} class:list={[
                'text-sm font-body',
                event.data.isTBA ? 'text-amber-700 font-medium' : ''
              ]}>
                {event.data.isTBA ? 'Time TBA' : formatDateInCAT(event.data.date, 'h:mm a')}
              </time>
            </div>
            <div class="flex min-w-0 items-start text-gray-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span class="min-w-0 break-words text-sm leading-5 line-clamp-2">{formatLocation(event.data.location)}</span>
            </div>
          </div>

          <div class="flex justify-end mt-auto pt-4">
            <span class="text-sm font-medium font-body text-gray-600 group-hover:text-gray-900 transition-colors duration-300 flex items-center">
              View event
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </div>
      </a>
    </article>
  ))}
</div>
