---
const steps = [
  {
    title: "Registration",
    desc: "Arrival at Dzaleka. Initial biometric registration with UNHCR/Government."
  },
  {
    title: "Eligibility Interview",
    desc: "Detailed interview with a Status Determination Officer to assess your claim."
  },
  {
    title: "Status Determination",
    desc: "The Refugee Status Determination (RSD) Committee reviews your case."
  },
  {
    title: "Notification",
    desc: "You receive a written decision granting or denying refugee status."
  },
  {
    title: "Appeal (if denied)",
    desc: "You have the right to appeal to the Minister within 14 days of rejection."
  }
];
---

<div class="my-12 max-w-2xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <h3 class="text-xl font-bold text-gray-900 font-heading">Status determination process</h3>
  </div>

  <div class="relative">
    {/* Vertical Line */}
    <div class="absolute left-6 top-4 bottom-4 w-0.5 bg-gray-200" aria-hidden="true"></div>

    <div class="space-y-10">
      {steps.map((step, index) => (
        <div class="relative flex gap-6 group">
          
          {/* Step number */}
          <div class="flex flex-col items-center z-10">
            <div class={`
              w-12 h-12 rounded-full flex items-center justify-center border-4 border-white text-lg font-semibold
              ${index === steps.length - 1 ? 'bg-red-50 text-red-600' : 'bg-blue-50 text-blue-600'}
            `}>
              {index + 1}
            </div>
          </div>

          {/* Content Card */}
          <div class="flex-1 bg-white p-5 rounded border border-gray-100 relative -top-1">
             {/* Arrow visual */}
             <div class="absolute top-5 -left-1.5 w-3 h-3 bg-white border-l border-b border-gray-100 transform rotate-45"></div>
             
             <h4 class="font-bold text-gray-900 text-lg mb-2">{step.title}</h4>
             
             <p class="text-gray-600 text-sm leading-relaxed">{step.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
