---
import { format } from 'date-fns';
import type { PhotoGallery } from '../types';
import Badge from './ui/Badge.astro';
import { CloudinaryPresets, getPlaceholderUrl } from '../utils/cloudinary';

interface Props {
  photo: PhotoGallery;
}

const { photo } = Astro.props;

// Optimize image using Cloudinary (only if it's a Cloudinary URL)
const originalImage = photo.imageUrl;
const optimizedImage = originalImage ? CloudinaryPresets.gallery(originalImage) : originalImage;
const placeholderImage = (originalImage && optimizedImage !== originalImage)
  ? getPlaceholderUrl(originalImage)
  : null;
---

<article class="bg-white rounded-lg shadow-md overflow-hidden  transition-shadow">
  <div class="relative">
    <img
      src={placeholderImage || optimizedImage}
      data-src={placeholderImage ? optimizedImage : undefined}
      alt={photo.title}
      class={`${placeholderImage ? 'lazy-load' : ''} w-full h-48 object-cover transition-opacity duration-300`}
      loading="lazy"
    />
    <time
      class="absolute bottom-2 right-2 bg-black/50 text-white px-2 py-1 rounded text-sm"
      datetime={photo.date.toISOString()}
    >
      {format(photo.date, 'MMMM d, yyyy')}
    </time>
  </div>
  <div class="p-4">
    <h2 class="text-xl font-semibold mb-2 text-gray-900">{photo.title}</h2>
    <div class="prose prose-sm mb-3 text-gray-700" set:html={photo.description} />
    <div class="flex flex-wrap gap-2">
      {photo.tags.map(tag => (
        <Badge variant="blue">{tag}</Badge>
      ))}
    </div>
  </div>
</article>