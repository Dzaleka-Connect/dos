---
interface Props {
  variant?: 'default' | 'elevated' | 'outlined' | 'ghost';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  hover?: boolean;
  rounded?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const {
  variant = 'default',
  padding = 'md',
  hover = false,
  rounded = 'xl',
  class: className = ''
} = Astro.props;

const variantClasses = {
  default: 'bg-white shadow-sm',
  elevated: 'bg-white shadow-md',
  outlined: 'bg-white border border-gray-200',
  ghost: 'bg-transparent'
};

const paddingClasses = {
  none: '',
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8'
};

const roundedClasses = {
  sm: 'rounded-md',
  md: 'rounded-lg',
  lg: 'rounded-xl',
  xl: 'rounded-xl'
};

const hoverClass = hover ? 'hover:shadow-md transition-shadow duration-200' : '';

const cardClasses = `${variantClasses[variant]} ${paddingClasses[padding]} ${roundedClasses[rounded]} ${hoverClass} ${className}`;
---

<div class={cardClasses}>
  <slot />
</div>
