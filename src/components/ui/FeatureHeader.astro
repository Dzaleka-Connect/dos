---
import Breadcrumb from './Breadcrumb.astro';
interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  image: string;
  imageAlt: string;
  caption?: string;
  action?: { label: string; href: string };
  secondary?: { label: string; href: string };
  breadcrumbs?: { label: string; href?: string }[];
}
const { title, description, eyebrow, image, imageAlt, caption, action, secondary, breadcrumbs = [{ label: 'Home', href: '/' }, { label: title }] } = Astro.props;
---
<header class="border-b border-slate-200">
  <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8"><Breadcrumb items={breadcrumbs} /></div>
  <div class="bg-primary-900">
    <div class="mx-auto grid max-w-7xl md:grid-cols-2">
      <div class="flex flex-col justify-center px-4 py-8 text-white sm:px-6 lg:px-8 lg:py-12">
        {eyebrow && <p class="mb-3 text-sm font-medium text-primary-200">{eyebrow}</p>}
        <h1 class="max-w-xl text-white">{title}</h1>
        <p class="mt-4 max-w-xl text-base leading-7 text-slate-200">{description}</p>
        {(action || secondary) && <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
          {action && <a href={action.href} class="inline-flex min-h-[44px] items-center justify-center rounded bg-white px-5 py-3 text-sm font-semibold text-primary-900 hover:bg-primary-50">{action.label}</a>}
          {secondary && <a href={secondary.href} class="inline-flex min-h-[44px] items-center text-sm text-white underline underline-offset-4">{secondary.label}</a>}
        </div>}
      </div>
      <figure class="relative m-0 min-w-0">
        <img src={image} alt={imageAlt} width="960" height="640" class="h-44 w-full object-cover sm:h-56 md:h-full md:min-h-[18rem] md:max-h-[26rem]" fetchpriority="high" />
        {caption && <figcaption class="absolute bottom-0 left-0 right-0 bg-slate-950/80 px-4 py-2 text-xs leading-5 text-white">{caption}</figcaption>}
      </figure>
    </div>
  </div>
</header>
