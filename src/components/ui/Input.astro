---
/**
 * Input Component with built-in validation UI
 *
 * @param name - Input name attribute
 * @param label - Label text
 * @param type - Input type (text, email, tel, etc.)
 * @param placeholder - Placeholder text
 * @param required - Whether the field is required
 * @param pattern - Regex pattern for validation
 * @param minlength - Minimum length
 * @param maxlength - Maximum length
 * @param helpText - Helper text shown below input
 * @param value - Default value
 */

export interface Props {
  name: string;
  label: string;
  type?: string;
  placeholder?: string;
  required?: boolean;
  pattern?: string;
  minlength?: number;
  maxlength?: number;
  helpText?: string;
  value?: string;
  class?: string;
}

const {
  name,
  label,
  type = 'text',
  placeholder = '',
  required = false,
  pattern,
  minlength,
  maxlength,
  helpText,
  value = '',
  class: className = ''
} = Astro.props;

const inputId = `input-${name}`;
---

<div class={`mb-4 ${className}`}>
  <label for={inputId} class="block text-sm font-medium text-gray-700 mb-1">
    {label}
    {required && <span class="text-red-500">*</span>}
  </label>

  <div class="relative">
    <input
      aria-describedby={[helpText && `${inputId}-help`, `${inputId}-error`].filter(Boolean).join(' ')}
      type={type}
      id={inputId}
      name={name}
      value={value}
      placeholder={placeholder}
      required={required}
      pattern={pattern}
      minlength={minlength}
      maxlength={maxlength}
      class="peer w-full px-4 py-2.5 min-h-[44px] text-sm border border-slate-400 rounded focus:ring-2 focus:ring-primary-700 focus:border-primary-700 aria-[invalid=true]:border-red-600"
    />

  </div>

  {helpText && (
    <p id={`${inputId}-help`} class="mt-2 text-sm text-slate-600">{helpText}</p>
  )}

  <!-- Error message (shown via JavaScript) -->
  <p id={`${inputId}-error`} aria-live="polite" class="hidden mt-2 text-sm text-red-700"></p>
</div>

<script define:vars={{ inputId, label }}>
  // Add custom validation messages
  const input = document.getElementById(inputId);

  if (input) {
    input.addEventListener('invalid', (e) => {
      input.setAttribute('aria-invalid', 'true');
      const errorEl = document.getElementById(`${inputId}-error`);

      if (errorEl) {
        errorEl.classList.remove('hidden');

        if (input.validity.valueMissing) {
          errorEl.textContent = `${label} is required`;
        } else if (input.validity.typeMismatch) {
          errorEl.textContent = `Enter a valid ${input.type}`;
        } else if (input.validity.patternMismatch) {
          errorEl.textContent = `Match the required format`;
        } else if (input.validity.tooShort) {
          errorEl.textContent = `Minimum ${input.minLength} characters required`;
        } else if (input.validity.tooLong) {
          errorEl.textContent = `Maximum ${input.maxLength} characters allowed`;
        } else {
          errorEl.textContent = `Check your input`;
        }
      }
    });

    input.addEventListener('input', () => {
      const errorEl = document.getElementById(`${inputId}-error`);
      if (errorEl && input.validity.valid) {
        input.removeAttribute('aria-invalid');
        errorEl.classList.add('hidden');
      }
    });
  }
</script>

<style>
  /* Ensure icons don't show until user has interacted */
  input:placeholder-shown ~ svg {
    display: none !important;
  }
</style>
