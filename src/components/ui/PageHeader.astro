---
interface Props {
  title: string;
  description?: string;
  kicker?: string;
}

const { title, description, kicker } = Astro.props;
---

<header class="mb-12 max-w-3xl">
  {kicker && <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-slate-500">{kicker}</p>}
  <h1 class="mb-5 text-4xl font-bold text-slate-900 sm:text-5xl">
    {title}
  </h1>
  {description && (
    <p class="text-lg leading-8 text-slate-600 sm:text-xl">
      {description}
    </p>
  )}
</header>
