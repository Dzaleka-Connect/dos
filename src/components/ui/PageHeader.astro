---
interface Props {
  title: string;
  description?: string;
  kicker?: string;
}

const { title, description, kicker } = Astro.props;
---

<header class="mb-8 max-w-3xl">
  {kicker && <p class="mb-2 text-sm font-medium text-slate-600">{kicker}</p>}
  <h1 class="mb-3 text-3xl font-semibold text-primary-900 sm:text-4xl">
    {title}
  </h1>
  {description && (
    <p class="text-sm leading-6 text-slate-600">
      {description}
    </p>
  )}
</header>
