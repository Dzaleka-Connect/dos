---
interface Props {
  placeholder?: string;
  initialValue?: string;
  section?: string;
  fullWidth?: boolean;
}

const {
  placeholder = 'Search...',
  initialValue = '',
  section = '',
  fullWidth = false
} = Astro.props;

// Determine the form action based on section
const formAction = section === 'search' ? '/search/results' : `/${section || ''}`;
---

<form action={formAction} method="GET" role="search" aria-label="Site search" class:list={['w-full', fullWidth ? 'mx-auto max-w-2xl' : 'max-w-md']}>
  <label for="search-input" class="sr-only">Search the site</label>
  <div class="flex rounded ring-1 ring-slate-400">
    <div class="relative min-w-0 flex-1">
      <input type="search" id="search-input" name="q" value={initialValue} placeholder={placeholder} required minlength="2" class="block w-full min-w-0 border-0 bg-white py-3 pl-4 pr-12 text-sm text-slate-900 focus:ring-2 focus:ring-primary-700" />
      <button type="button" id="clear-search" class="absolute right-0.5 top-1/2 hidden h-11 w-11 -translate-y-1/2 items-center justify-center text-slate-600 hover:text-primary-900" aria-label="Clear search">
        <svg class="mx-auto h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="m6 6 12 12M6 18 18 6" /></svg>
      </button>
    </div>
    <button type="submit" id="search-button" class="min-h-[48px] shrink-0 rounded-r bg-primary-900 px-4 py-3 text-sm font-medium text-white hover:bg-primary-800 disabled:opacity-50 sm:px-6">
      <span id="search-button-text">Search</span>
      <svg id="search-button-spinner" class="mx-auto hidden h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" /><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8V0A12 12 0 0 0 0 12h4Z" /></svg>
    </button>
  </div>
</form>

<script>
// Get elements
const input = document.getElementById('search-input') as HTMLInputElement;
const clearButton = document.getElementById('clear-search');
const searchButton = document.getElementById('search-button') as HTMLButtonElement;
const buttonText = document.getElementById('search-button-text');
const spinner = document.getElementById('search-button-spinner');

// Function to update clear button visibility
function updateClearButton() {
  if (input && clearButton) {
    if (input.value.length > 0) {
      clearButton.classList.remove('hidden');
    } else {
      clearButton.classList.add('hidden');
    }
  }
}

// Show/hide clear button on input
input?.addEventListener('input', updateClearButton);

// Clear input when clear button is clicked
clearButton?.addEventListener('click', () => {
  if (input) {
    input.value = '';
    updateClearButton();
    input.focus();
  }
});

// Initialize clear button visibility on page load
updateClearButton();

// Ensure form is not submitted empty and trim input
input?.form?.addEventListener('submit', (e) => {
  const value = input?.value.trim() || '';
  if (!value) {
    e.preventDefault();
    input?.focus();
    return;
  }

  if (input) {
    input.value = value;
  }

  // Show loading state
  if (searchButton && buttonText && spinner) {
    searchButton.disabled = true;
    buttonText.classList.add('hidden');
    spinner.classList.remove('hidden');
  }
});
window.addEventListener('pageshow', () => {
  if (searchButton) searchButton.disabled = false;
  buttonText?.classList.remove('hidden');
  spinner?.classList.add('hidden');
});
</script>