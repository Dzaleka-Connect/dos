---
import WhatsNewWidget from '../WhatsNewWidget.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
const primaryLinks = [
  { href: '/services', label: 'Services' },
  { href: '/jobs', label: 'Jobs' },
  { href: '/events', label: 'Events' },
  { href: '/resources', label: 'Resources' },
  { href: '/community-voice', label: 'Have your say' },
  { href: '/easy-read', label: 'Easy read' },
];

// Share the same destinations across desktop and mobile navigation.
const navigationGroups = [
  {
    title: 'Life in Dzaleka',
    links: [
      { href: '/start-here', label: 'Start here' },
      { href: '/new-to-dzaleka', label: 'New to Dzaleka' },
      { href: '/rights-navigator', label: 'Rights and protection' },
      { href: '/dzaleka-wellbeing', label: 'Wellbeing' },
      { href: '/marketplace', label: 'Marketplace' },
      { href: '/grants-and-programs', label: 'Grants and programs' },
      { href: '/languages', label: 'Languages' },
    ],
  },
  {
    title: 'Explore the community',
    links: [
      { href: '/explore', label: 'Keeping Place' },
      { href: '/visit', label: 'Visit Dzaleka' },
      { href: '/map', label: 'Interactive map' },
      { href: '/site-register', label: 'Site register' },
      { href: '/public-art-catalogue', label: 'Public art' },
      { href: '/communities', label: 'Communities' },
      { href: '/photos', label: 'Photo archive' },
      { href: '/news', label: 'News and notices' },
      { href: '/encyclopedia', label: 'Encyclopedia' },
    ],
  },
  {
    title: 'About and open data',
    links: [
      { href: '/about', label: 'About us' },
      { href: '/contact', label: 'Contact us' },
      { href: '/open-data-platform', label: 'Open data platform' },
      { href: '/data', label: 'Data catalogue' },
      { href: '/api-docs', label: 'API reference' },
      { href: '/docs', label: 'Documentation' },
      { href: '/tools-and-templates', label: 'Tools and templates' },
    ],
  },
];
const moreIsActive = navigationGroups.some(({ links }) => links.some(({ href }) => isActive(href)));
---

<nav class="relative border-b border-slate-200 bg-white" aria-label="Main navigation">
  <div class="mx-auto flex h-[76px] lg:h-[88px] max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="shrink-0 text-primary-900" aria-label="Dzaleka Online Services home">
      <img src="/images/dzaleka-digital-heritage.png" alt="Dzaleka Online Services" width="387" height="386" class="h-14 w-14 object-contain lg:h-16 lg:w-16" />
    </a>

    <div class="flex shrink-0 items-center gap-2 sm:gap-3">
      <a href="/languages" class="hidden min-h-[44px] items-center gap-2 px-2 text-sm text-slate-700 underline-offset-4 hover:text-primary-800 hover:underline sm:inline-flex">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5h12M9 3v2m4 0c-1 6-4 9-9 11m2-8c1 4 4 7 8 8m0 5 4-10 4 10m-6.5-4h5" /></svg>
        Languages
      </a>
      <div class="hidden lg:block"><WhatsNewWidget /></div>
      <a href="/search" class="inline-flex h-11 w-11 items-center justify-center rounded-md text-slate-600 hover:bg-slate-50 hover:text-slate-950" aria-label="Search the site">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0" /></svg>
      </a>
      <a href="/get-help-now" aria-current={isActive('/get-help-now') ? 'page' : undefined} class="hidden min-h-[44px] items-center rounded border border-red-200 bg-red-50 px-4 py-2 text-sm font-medium text-red-800 hover:bg-red-100 lg:inline-flex">Get help now</a>
      <button id="menu-button" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open main menu"
        class="inline-flex h-11 items-center gap-2 rounded-md px-2 text-sm font-medium text-slate-700 hover:bg-slate-50 lg:hidden">
        <span class="sr-only" data-menu-label>Open main menu</span>
        <span aria-hidden="true">Menu</span>
        <svg data-menu-icon-open class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
        <svg data-menu-icon-close class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="m6 6 12 12M6 18 18 6" /></svg>
      </button>
    </div>
  </div>

  <div class="hidden border-t border-slate-200 bg-slate-50 lg:block">
    <div class="mx-auto flex h-12 max-w-7xl items-center gap-1 px-6 lg:px-8">
      {primaryLinks.map(({ href, label }) => (
        <a href={href} aria-current={isActive(href) ? 'page' : undefined}
          class:list={[
            'inline-flex h-full items-center border-b-2 px-3 text-sm font-medium',
            isActive(href) ? 'border-primary-700 text-primary-800' : 'border-transparent text-slate-700 hover:bg-slate-200/60 hover:text-primary-900',
          ]}>{label}</a>
      ))}
      <div class="group flex h-full items-center" data-more-navigation>
        <button id="more-navigation-button" type="button" aria-controls="more-navigation-panel" aria-expanded="false"
          class:list={[
            'inline-flex h-full items-center gap-2 border-b-2 px-3 text-sm font-medium',
            moreIsActive ? 'border-primary-700 text-primary-800' : 'border-transparent text-slate-700 hover:bg-slate-200/60 hover:text-primary-900',
          ]}>
          More
          <svg class="h-4 w-4 group-[[data-open]]:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6" /></svg>
        </button>
        <div id="more-navigation-panel" class="absolute inset-x-0 top-full z-50 hidden max-h-[calc(100dvh-12rem)] overflow-y-auto bg-white shadow-lg ring-1 ring-slate-200">
          <div class="mx-auto grid max-w-7xl grid-cols-3 gap-10 px-8 py-6">
            {navigationGroups.map(({ title, links }) => (
              <div>
                <p class="mb-3 border-b border-slate-200 pb-3 text-sm font-semibold text-slate-900">{title}</p>
                <ul>
                  {links.map(({ href, label }) => (
                    <li><a href={href} aria-current={isActive(href) ? 'page' : undefined}
                      class:list={['block rounded px-2 py-2 text-sm', isActive(href) ? 'bg-primary-50 font-medium text-primary-800' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-950']}>{label}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="mobile-menu" aria-hidden="true" class="absolute inset-x-0 top-full z-50 hidden max-h-[calc(100dvh-7rem)] overflow-y-auto overscroll-contain border-b border-slate-200 bg-white px-4 pb-6 shadow-lg lg:hidden">
    <div class="grid grid-cols-2 gap-x-6 border-t border-slate-200 py-3">
      {primaryLinks.map(({ href, label }) => (
        <a href={href} aria-current={isActive(href) ? 'page' : undefined}
          class:list={['py-3 text-sm font-medium', isActive(href) ? 'text-primary-800 underline underline-offset-4' : 'text-slate-800']}>{label}</a>
      ))}
    </div>
    <a href="/get-help-now" class="mb-4 flex min-h-[44px] items-center justify-between rounded-md bg-red-50 px-3 py-2 text-sm font-medium text-red-800">Get help now <span aria-hidden="true">→</span></a>
    {navigationGroups.map(({ title, links }) => (
      <details class="mobile-navigation-group border-t border-slate-200" open={links.some(({ href }) => isActive(href))}>
        <summary class="flex min-h-[48px] cursor-pointer list-none items-center justify-between gap-2 py-3 text-sm font-medium text-slate-900">
          {title}<svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 9 6 6 6-6" /></svg>
        </summary>
        <ul class="grid grid-cols-2 gap-x-4 pb-3">
          {links.map(({ href, label }) => (
            <li><a href={href} aria-current={isActive(href) ? 'page' : undefined}
              class:list={['block py-2.5 text-sm', isActive(href) ? 'font-medium text-primary-800 underline underline-offset-4' : 'text-slate-600 hover:text-slate-950']}>{label}</a></li>
          ))}
        </ul>
      </details>
    ))}
  </div>
</nav>

<script>
  const setupMoreMenu = () => {
    const menu = document.querySelector<HTMLElement>('[data-more-navigation]');
    const button = document.querySelector<HTMLButtonElement>('#more-navigation-button');
    const panel = document.getElementById('more-navigation-panel');
    if (!menu || !button || !panel || menu.dataset.menuReady) return;
    menu.dataset.menuReady = 'true';
    let openedByPointer = false;
    const setOpen = (open: boolean) => {
      panel.classList.toggle('hidden', !open);
      button.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('data-open', open);
    };
    button.addEventListener('click', (event) => {
      // A mouse click after hover keeps the menu open; keyboard clicks toggle it.
      const open = openedByPointer && event.detail > 0 ? true : button.getAttribute('aria-expanded') !== 'true';
      openedByPointer = false;
      setOpen(open);
    });
    menu.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse') {
        openedByPointer = button.getAttribute('aria-expanded') !== 'true';
        setOpen(true);
      }
    });
    menu.addEventListener('pointerleave', () => {
      openedByPointer = false;
      if (!menu.contains(document.activeElement)) setOpen(false);
    });
    menu.addEventListener('focusout', (event) => {
      if (!(event.relatedTarget instanceof Node) || !menu.contains(event.relatedTarget)) setOpen(false);
    });
    button.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setOpen(true);
        panel.querySelector<HTMLAnchorElement>('a')?.focus();
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) setOpen(false);
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', () => setOpen(false));
    window.addEventListener('pagehide', () => setOpen(false));
    window.addEventListener('pageshow', () => setOpen(false));
  };
  setupMoreMenu();
  document.addEventListener('astro:page-load', setupMoreMenu);

  const setupMobileMenu = () => {
    const menuButton = document.getElementById('menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const openIcon = menuButton?.querySelector('[data-menu-icon-open]');
    const closeIcon = menuButton?.querySelector('[data-menu-icon-close]');
    const menuLabel = menuButton?.querySelector('[data-menu-label]');

    if (!menuButton || !mobileMenu || menuButton.dataset.menuReady === 'true') return;
    menuButton.dataset.menuReady = 'true';

    const setMobileMenuOpen = (isOpen) => {
      mobileMenu.classList.toggle('hidden', !isOpen);
      mobileMenu.setAttribute('aria-hidden', (!isOpen).toString());
      menuButton.setAttribute('aria-expanded', isOpen.toString());
      menuButton.setAttribute('aria-label', isOpen ? 'Close main menu' : 'Open main menu');
      if (menuLabel) menuLabel.textContent = isOpen ? 'Close main menu' : 'Open main menu';
      openIcon?.classList.toggle('hidden', isOpen);
      closeIcon?.classList.toggle('hidden', !isOpen);
    };

    const closeMobileMenu = () => setMobileMenuOpen(false);

    closeMobileMenu();

    menuButton.addEventListener('click', () => {
      setMobileMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
        closeMobileMenu();
        menuButton.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (mobileMenu.classList.contains('hidden')) return;
      const target = event.target;
      if (target instanceof Node && !mobileMenu.contains(target) && !menuButton.contains(target)) {
        closeMobileMenu();
      }
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });

    window.matchMedia('(min-width: 1024px)').addEventListener('change', closeMobileMenu);
    window.addEventListener('pagehide', closeMobileMenu);
    window.addEventListener('pageshow', closeMobileMenu);
  };

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>

<style>
  summary::-webkit-details-marker { display: none; }
  .mobile-navigation-group[open] > summary svg { transform: rotate(180deg); }
</style>
