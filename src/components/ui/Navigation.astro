---
import WhatsNewWidget from '../WhatsNewWidget.astro';
const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/'
  ? currentPath === '/'
  : currentPath === href || currentPath.startsWith(`${href}/`);

// Primary navigation favors urgent and task-based routes over internal taxonomy.
const primaryLinks = [
  { href: '/get-help-now', label: 'Get help', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v4m0 4h.01M10.29 3.86l-7.5 13A1 1 0 003.66 18h16.68a1 1 0 00.87-1.5l-7.5-13a1 1 0 00-1.74 0z" /></svg>' },
  { href: '/services', label: 'Services', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>' },
  { href: '/jobs', label: 'Jobs', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>' },
  { href: '/events', label: 'Events', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>' },
  { href: '/resources', label: 'Resources', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4h7l3 3v13H7V4zm7 0v4h4M9 12h6M9 16h6" /></svg>' }
];

// Secondary navigation - dropdown "More" menu
const moreDropdownLinks = [
  { href: '/explore', label: 'Explore (Keeping Place)', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.447 2.724A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>' },
  { href: '/start-here', label: 'Start Here', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>' },
  { href: '/encyclopedia', label: 'Encyclopedia', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5.5A2.5 2.5 0 016.5 3H11v16H6.5A2.5 2.5 0 004 21.5v-16zm16 0A2.5 2.5 0 0017.5 3H13v16h4.5a2.5 2.5 0 012.5 2.5v-16z" /></svg>' },
  { href: '/communities', label: 'Communities', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-5-3.87M9 20H4v-2a4 4 0 015-3.87M12 11a4 4 0 100-8 4 4 0 000 8zm6 1a3 3 0 100-6 3 3 0 000 6zM6 12a3 3 0 100-6 3 3 0 000 6z" /></svg>' },
  { href: '/search', label: 'Search', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>' },
  { href: '/new-to-dzaleka', label: 'New to Dzaleka', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>' },
  { href: '/easy-read', label: 'Easy Read', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>' },
  { href: '/languages', label: 'Languages', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" /></svg>' },
  { href: '/rights-navigator', label: 'Rights Navigator', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" /></svg>' },
  { href: '/dzaleka-wellbeing', label: 'Wellbeing', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>' },
  { href: '/marketplace', label: 'Marketplace', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>' },
  { href: '/grants-and-programs', label: 'Grants & Programs', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 1.12-3 2.5S10.343 13 12 13s3 1.12 3 2.5S13.657 18 12 18m0-10V6m0 12v-2m7-4a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>' },
  { href: '/tools-and-templates', label: 'Tools & Templates', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.7 6.3l3 3m-9.4 9.4l-5 1 1-5 9.9-9.9a2.121 2.121 0 013 3L8.3 17.7z" /></svg>' },
  { href: '/photos', label: 'Photos', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>' },
  { href: '/news', label: 'News', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>' },
  { href: '/data', label: 'Data', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 19h16M7 16V9m5 7V5m5 11v-4" /></svg>' },
  { href: '/docs', label: 'Docs', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>' },
  { href: '/about', label: 'About', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>' },
  { href: '/contact', label: 'Contact', icon: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>' }
];

const moreIsActive = moreDropdownLinks.some(({ href }) => isActive(href));
const mobileMoreHrefs = new Set([
  '/start-here',
  '/encyclopedia',
  '/communities',
  '/new-to-dzaleka',
  '/easy-read',
  '/languages',
  '/rights-navigator',
  '/dzaleka-wellbeing',
  '/about'
]);
const mobileMoreLinks = moreDropdownLinks.filter(({ href }) => mobileMoreHrefs.has(href));
---

<nav class="relative border-b border-slate-200 bg-white" aria-label="Main navigation">
  <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex min-w-0 items-center">
        <span class="truncate text-lg font-bold text-slate-900 sm:text-xl">Dzaleka Online Services</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center ml-8 gap-4">
        <div class="flex items-center gap-1">
          {/* Primary nav links */}
          {primaryLinks.map(({ href, label, icon }) => (
            <a
              href={href}
              class:list={[
                'flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold transition-colors',
                isActive(href)
                  ? 'bg-slate-900 text-white'
                  : 'text-slate-600 hover:bg-slate-100 hover:text-slate-950'
              ]}
            >
              <Fragment set:html={icon} />
              <span>{label}</span>
            </a>
          ))}

          {/* More dropdown */}
          <div class="relative group">
            <button
              class:list={[
                'flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-semibold transition-colors',
                moreIsActive
                  ? 'bg-slate-100 text-slate-950'
                  : 'text-slate-600 hover:bg-slate-100 hover:text-slate-950'
              ]}
              aria-haspopup="true"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z" />
              </svg>
              <span>More</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            {/* Categorized Desktop Mega Dropdown Menu (Comfortable Size & Readable Icons) */}
            <div class="absolute top-full right-0 origin-top-right z-50 mt-2 w-[580px] rounded-2xl border border-slate-200 bg-white p-3.5 shadow-2xl opacity-0 invisible transition-all duration-200 group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible">
              <div class="grid grid-cols-2 gap-3.5">
                
                {/* EXPLORE & MAPS */}
                <div class="bg-slate-50/70 rounded-xl p-3.5 border border-slate-200/60 flex flex-col justify-between">
                  <div>
                    <div class="text-xs font-bold uppercase tracking-wider text-slate-500 font-mono mb-2.5 px-1 border-b border-slate-200/80 pb-1.5">
                      Explore & Maps
                    </div>
                    <div class="space-y-1">
                      <a href="/explore" class:list={['flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold transition-colors', isActive('/explore') ? 'bg-slate-900 text-white [&_svg]:text-white' : 'text-slate-700 hover:bg-white hover:text-slate-950 hover:shadow-xs [&_svg]:text-slate-500']}>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l5.447 2.724A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>
                        <span>Keeping Place</span>
                      </a>
                      <a href="/map" class:list={['flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold transition-colors', isActive('/map') ? 'bg-slate-900 text-white [&_svg]:text-white' : 'text-slate-700 hover:bg-white hover:text-slate-950 hover:shadow-xs [&_svg]:text-slate-500']}>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        <span>Interactive Map</span>
                      </a>
                      <a href="/site-register" class:list={['flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold transition-colors', isActive('/site-register') ? 'bg-slate-900 text-white [&_svg]:text-white' : 'text-slate-700 hover:bg-white hover:text-slate-950 hover:shadow-xs [&_svg]:text-slate-500']}>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                        <span>Site Register</span>
                      </a>
                      <a href="/public-art-catalogue" class:list={['flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold transition-colors', isActive('/public-art-catalogue') ? 'bg-slate-900 text-white [&_svg]:text-white' : 'text-slate-700 hover:bg-white hover:text-slate-950 hover:shadow-xs [&_svg]:text-slate-500']}>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                        <span>Public Art</span>
                      </a>
                      <a href="/communities" class:list={['flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold transition-colors', isActive('/communities') ? 'bg-slate-900 text-white [&_svg]:text-white' : 'text-slate-700 hover:bg-white hover:text-slate-950 hover:shadow-xs [&_svg]:text-slate-500']}>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-5-3.87M9 20H4v-2a4 4 0 015-3.87M12 11a4 4 0 100-8 4 4 0 000 8zm6 1a3 3 0 100-6 3 3 0 000 6zM6 12a3 3 0 100-6 3 3 0 000 6z" /></svg>
                        <span>Communities</span>
                      </a>
                    </div>
                  </div>
                </div>

                {/* GUIDES & PROTECTION */}
                <div class="bg-slate-50/70 rounded-xl p-3.5 border border-slate-200/60 flex flex-col justify-between">
                  <div>
                    <div class="text-xs font-bold uppercase tracking-wider text-slate-500 font-mono mb-2.5 px-1 border-b border-slate-200/80 pb-1.5">
                      <span>Guides & Support</span>
                    </div>
                    <div class="space-y-1">
                      <a href="/start-here" class:list={['flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold transition-colors', isActive('/start-here') ? 'bg-slate-900 text-white [&_svg]:text-white' : 'text-slate-700 hover:bg-white hover:text-slate-950 hover:shadow-xs [&_svg]:text-slate-500']}>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                        <span>Start Here</span>
                      </a>
                      <a href="/new-to-dzaleka" class:list={['flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold transition-colors', isActive('/new-to-dzaleka') ? 'bg-slate-900 text-white [&_svg]:text-white' : 'text-slate-700 hover:bg-white hover:text-slate-950 hover:shadow-xs [&_svg]:text-slate-500']}>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
                        <span>New to Dzaleka</span>
                      </a>
                      <a href="/encyclopedia" class:list={['flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold transition-colors', isActive('/encyclopedia') ? 'bg-slate-900 text-white [&_svg]:text-white' : 'text-slate-700 hover:bg-white hover:text-slate-950 hover:shadow-xs [&_svg]:text-slate-500']}>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5.5A2.5 2.5 0 016.5 3H11v16H6.5A2.5 2.5 0 004 21.5v-16zm16 0A2.5 2.5 0 0017.5 3H13v16h4.5a2.5 2.5 0 012.5 2.5v-16z" /></svg>
                        <span>Encyclopedia</span>
                      </a>
                      <a href="/rights-navigator" class:list={['flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-semibold transition-colors', isActive('/rights-navigator') ? 'bg-slate-900 text-white [&_svg]:text-white' : 'text-slate-700 hover:bg-white hover:text-slate-950 hover:shadow-xs [&_svg]:text-slate-500']}>
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" /></svg>
                        <span>Rights Navigator</span>
