---
/**
 * EmptyState Component
 *
 * A reusable component for displaying empty states with consistent styling
 *
 * @param title - Main heading for the empty state
 * @param description - Supporting text explaining the empty state
 * @param iconType - Type of icon to display
 * @param size - Size of the empty state: 'sm' | 'md' | 'lg'
 */

export interface Props {
  title: string;
  description: string;
  iconType?: 'search' | 'content' | 'error' | 'calendar' | 'photo' | 'document' | 'custom';
  size?: 'sm' | 'md' | 'lg';
}

const { title, description, iconType = 'content', size = 'md' } = Astro.props;

const sizeClasses = {
  sm: 'py-8',
  md: 'py-12',
  lg: 'py-16'
};

const iconSizes = {
  sm: 'w-12 h-12',
  md: 'w-16 h-16',
  lg: 'w-20 h-20'
};

const containerSizes = {
  sm: 'w-16 h-16',
  md: 'w-24 h-24',
  lg: 'w-32 h-32'
};

const icons = {
  search: `<svg class="${iconSizes[size]} text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
  </svg>`,
  content: `<svg class="${iconSizes[size]} text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
  </svg>`,
  error: `<svg class="${iconSizes[size]} text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
  </svg>`,
  calendar: `<svg class="${iconSizes[size]} text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
  </svg>`,
  photo: `<svg class="${iconSizes[size]} text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
  </svg>`,
  document: `<svg class="${iconSizes[size]} text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
  </svg>`
};
---

<div class={`text-center ${sizeClasses[size]}`}>
  <div class="flex justify-center mb-6">
    <div class={`${containerSizes[size]} rounded-full bg-gray-100 flex items-center justify-center`}>
      {iconType !== 'custom' ? (
        <Fragment set:html={icons[iconType]} />
      ) : (
        <slot name="icon" />
      )}
    </div>
  </div>

  <h3 class="text-lg font-semibold text-gray-900 mb-2">{title}</h3>
  <p class="text-gray-600 max-w-md mx-auto mb-8 text-sm">{description}</p>

  <div class="flex flex-col sm:flex-row gap-3 justify-center">
    <slot name="action" />
  </div>
</div>
