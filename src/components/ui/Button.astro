---
/**
 * Button Component
 *
 * A reusable button component with consistent styling across the site.
 *
 * @param variant - Button style variant: 'primary' | 'secondary' | 'outline' | 'ghost'
 * @param size - Button size: 'sm' | 'md' | 'lg'
 * @param href - Optional link href (renders as <a> instead of <button>)
 * @param type - Button type: 'button' | 'submit' | 'reset' (default: 'button')
 * @param disabled - Whether the button is disabled
 * @param fullWidth - Whether the button should take full width
 * @param className - Additional CSS classes
 */

export interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  fullWidth?: boolean;
  className?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  target,
  rel,
  type = 'button',
  disabled = false,
  fullWidth = false,
  className = '',
} = Astro.props;

// Base classes that apply to all buttons
const baseClasses = [
  'inline-flex',
  'items-center',
  'justify-center',
  'font-medium',
  'focus:outline-none',
  'focus:ring-2',
  'focus:ring-offset-2',
  'disabled:opacity-50',
  'disabled:cursor-not-allowed',
  'disabled:pointer-events-none',
];

// Variant-specific classes
const variantClasses = {
  primary: [
    'bg-primary-900',
    'text-white',
    'hover:bg-primary-800',
    'focus:ring-primary-700',
  ],
  secondary: [
    'border',
    'border-primary-800',
    'text-primary-900',
    'bg-white',
    'hover:bg-slate-50',
    'focus:ring-primary-700',
  ],
  outline: [
    'border',
    'border-gray-300',
    'text-gray-700',
    'bg-white',
    'hover:bg-gray-50',
    'focus:ring-gray-500',
  ],
  ghost: [
    'text-gray-700',
    'bg-transparent',
    'hover:bg-gray-100',
    'focus:ring-gray-500',
  ],
};

// Size-specific classes
const sizeClasses = {
  sm: ['min-h-[40px]', 'px-4', 'py-2', 'text-sm', 'rounded'],
  md: ['min-h-[44px]', 'px-5', 'py-2.5', 'text-sm', 'rounded'],
  lg: ['min-h-[48px]', 'px-6', 'py-3', 'text-sm', 'rounded'],
};

// Width classes
const widthClasses = fullWidth ? ['w-full'] : [];

// Combine all classes
const buttonClasses = [
  ...baseClasses,
  ...variantClasses[variant],
  ...sizeClasses[size],
  ...widthClasses,
  className,
  disabled && 'opacity-50 cursor-not-allowed',
].filter(Boolean).join(' ');

// Choose component type based on href
const Component = href ? 'a' : 'button';
const componentProps = href
  ? { target, rel, href: disabled ? undefined : href, role: disabled ? 'link' : undefined, 'aria-disabled': disabled || undefined, class: buttonClasses }
  : { type, disabled, class: buttonClasses };
---

<Component {...componentProps}>
  <slot />
</Component>
