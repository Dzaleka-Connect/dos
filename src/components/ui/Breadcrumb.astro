---
/**
 * Breadcrumb Component
 *
 * Provides hierarchical navigation for detail pages
 *
 * @param items - Array of breadcrumb items with label and href
 */

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
  light?: boolean;
}

const { items, light = false } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-5 -mx-1 px-1">
  <ol class="flex flex-wrap items-center gap-y-1 text-sm">
    {items.map((item, index) => (
      <li class="flex min-w-0 items-center">
        {index > 0 && (
          <svg class:list={["w-4 h-4 mx-2 shrink-0", light ? "text-white/70" : "text-gray-400"]} fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        )}
        {item.href ? (
          <a
            href={item.href}
            class:list={[
              "inline-flex min-h-[32px] items-center underline underline-offset-4",
              light ? "text-white/90 hover:text-white" : "text-gray-600 hover:text-primary-600"
            ]}
          >
            {item.label}
          </a>
        ) : (
          <span class:list={["font-medium break-words", light ? "text-white" : "text-gray-900"]} aria-current="page">
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
