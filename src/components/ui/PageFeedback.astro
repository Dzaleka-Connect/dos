---
const path = Astro.url.pathname;
---
<section data-page-feedback lang="en" aria-label="Page feedback" class="border-t border-slate-200 bg-slate-50 py-7 print:hidden">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <form action="https://formspree.io/f/xqaaajae" method="POST" class="max-w-2xl">
      <input type="hidden" name="subject" value="Website page feedback" />
      <input type="hidden" name="page_path" value={path} />
      <fieldset class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <legend class="mb-2 text-base font-semibold text-slate-900">Was this page useful?</legend>
        <label class="inline-flex min-h-[44px] cursor-pointer items-center gap-3 text-slate-800"><input type="radio" name="useful" value="yes" required class="h-5 w-5 border-slate-400 text-primary-800" /> Yes</label>
        <label class="inline-flex min-h-[44px] cursor-pointer items-center gap-3 text-slate-800"><input type="radio" name="useful" value="no" required class="h-5 w-5 border-slate-400 text-primary-800" /> No</label>
      </fieldset>
      <details class="mb-3">
        <summary class="inline-flex min-h-[44px] cursor-pointer items-center text-sm text-primary-800 underline underline-offset-4">Add a comment (optional)</summary>
        <label for="page-feedback-details" class="mt-2 block text-sm font-semibold text-slate-800">What could we improve?</label>
        <p id="page-feedback-hint" class="my-2 text-sm text-slate-600">Do not include names, phone numbers or other personal information.</p>
        <textarea id="page-feedback-details" name="details" maxlength="2000" rows="3" aria-describedby="page-feedback-hint" class="w-full rounded border-slate-400"></textarea>
      </details>
      <p data-feedback-error role="alert" tabindex="-1" hidden class="mb-4 border-l-4 border-red-700 bg-red-50 p-4 text-sm text-red-900"></p>
      <button type="submit" class="min-h-[44px] rounded border border-slate-400 bg-white px-4 py-2 text-sm font-semibold text-primary-900 hover:bg-slate-100 disabled:opacity-60">Send feedback</button>
    </form>
    <p data-feedback-status role="status" tabindex="-1" hidden class="font-semibold text-slate-900">Thank you. Your feedback has been sent.</p>
  </div>
</section>
<script>
  import { initPageFeedback } from '../../utils/pageFeedback';
  document.querySelectorAll<HTMLElement>('[data-page-feedback]').forEach(root => initPageFeedback(root, new URL(window.location.href)));
</script>
