---
import Breadcrumb from './Breadcrumb.astro';
interface Props { title: string; description: string; parent: string; href: string; }
const { title, description, parent, href } = Astro.props;
---
<header class="border-b border-slate-200 bg-slate-50">
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: parent, href }, { label: title }]} />
    <h1 class="mt-5 text-primary-900">{title}</h1>
    <p class="mt-4 max-w-2xl text-base leading-7 text-slate-700">{description}</p>
  </div>
</header>
