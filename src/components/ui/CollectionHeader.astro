---
import Breadcrumb from './Breadcrumb.astro';
interface Props {
  title: string;
  description: string;
  breadcrumbs?: { label: string; href?: string }[];
  action?: { label: string; href: string };
}
const { title, description, breadcrumbs = [{ label: 'Home', href: '/' }, { label: title }], action } = Astro.props;
---
<header class="collection-header border-b border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
    <Breadcrumb items={breadcrumbs} />
    <div class="mt-5 flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end">
      <div class="max-w-3xl min-w-0">
        <h1 class="text-primary-900">{title}</h1>
        {description && <p class="mt-3 text-base leading-7 text-slate-700">{description}</p>}
      </div>
      {action && <a href={action.href} class="inline-flex min-h-[44px] shrink-0 items-center justify-center rounded bg-primary-900 px-5 py-3 text-sm font-medium text-white hover:bg-primary-800">{action.label}</a>}
    </div>
    {Astro.slots.has('default') && <div class="mt-6"><slot /></div>}
  </div>
</header>
