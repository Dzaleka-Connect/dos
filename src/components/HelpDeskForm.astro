---
const categories = [
  "Website problem",
  "Listing correction",
  "Submitting content",
  "Data or API question",
  "Accessibility",
  "Other question",
];
---

<div data-support-request>
  <form
    method="POST"
    id="supportForm"
    action="https://formcarry.com/s/w40iBX_iU0b"
    class="submission-form space-y-5"
  >
    <input type="hidden" name="_subject" value="Website support request" />
    <input
      type="hidden"
      name="_next"
      value="https://services.dzaleka.com/thank-you?type=support"
    />
    <p class="text-sm text-slate-500">
      All fields are required unless marked optional.
    </p>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="support-name" class="block font-semibold text-slate-900">
          Your name
        </label>
        <input
          id="support-name"
          name="name"
          type="text"
          autocomplete="name"
          required
          class="mt-2 w-full rounded border border-slate-400 px-3 py-3"
        />
      </div>
      <div>
        <label for="support-email" class="block font-semibold text-slate-900">
          Email address
        </label>
        <input
          id="support-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          class="mt-2 w-full rounded border border-slate-400 px-3 py-3"
        />
      </div>
    </div>
    <div>
      <label for="support-category" class="block font-semibold text-slate-900">
        What is your message about?
      </label>
      <select
        id="support-category"
        name="category"
        required
        class="mt-2 w-full rounded border border-slate-400 px-3 py-3"
      >
        <option value="">Choose a topic</option>
        {categories.map((category) => (
          <option value={category}>{category}</option>
        ))}
      </select>
    </div>
    <div>
      <label for="support-page" class="block font-semibold text-slate-900">
        Page address <span class="font-normal text-slate-500">(optional)</span>
      </label>
      <p id="support-page-hint" class="mb-1 text-sm text-slate-600">For example, https://services.dzaleka.com/</p>
      <input aria-describedby="support-page-hint"
        id="support-page"
        type="url"
        name="page"
        inputmode="url"
        class="mt-2 w-full rounded border border-slate-400 px-3 py-3"
      />
    </div>
    <div>
      <label for="support-message" class="block font-semibold text-slate-900">
        Your message
      </label>
      <textarea
        id="support-message"
        name="message"
        rows="6"
        minlength="10"
        required
        class="mt-2 w-full rounded border border-slate-400 px-3 py-3"
      ></textarea>
    </div>
    <p class="text-sm leading-6 text-slate-600">
      Your message is sent to the site team through Formcarry.{" "}
      <a href="/privacy" target="_blank" rel="noopener noreferrer" class="text-primary-800 underline underline-offset-4">
        Read our privacy policy (opens in a new tab)</a>
      .
    </p>
    <p
      data-support-error
      hidden
      role="alert"
      tabindex="-1"
      class="rounded border border-red-300 bg-red-50 p-4 text-red-800"
    >
      Your message could not be sent. Your answers are still here. Try again or
      email dzalekaconnect@gmail.com.
    </p>
    <button
      type="submit"
      class="min-h-[44px] rounded bg-primary-900 px-6 py-3 font-semibold text-white hover:bg-primary-800 disabled:opacity-60"
    >
      Send message
    </button>
  </form>
  <div
    data-support-success
    hidden
    role="status"
    tabindex="-1"
    class="rounded border border-green-300 bg-green-50 p-6"
  >
    <h3 class="text-xl font-semibold text-green-900">Message sent</h3>
    <p class="mt-2 leading-7 text-green-900">
      Thank you. Your message has been sent to the site team.
    </p>
  </div>
</div>
<script>
  import { initSupportRequest } from "../utils/supportRequest";
  document
    .querySelectorAll<HTMLElement>("[data-support-request]")
    .forEach((root) => initSupportRequest(root));
</script>
<style>
  [hidden] {
    display: none !important;
  }
</style>
