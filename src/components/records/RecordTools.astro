---
interface Props { title: string; url: string; printHref: string; updateHref?: string; reportHref?: string; }
const { title, url, printHref, updateHref, reportHref } = Astro.props;
const qrCodeUrl = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(url)}`;
---
<section class="record-tools record-section" data-record-tools data-title={title} data-url={url}>
  <h2 class="text-primary-900">Share this record</h2>
  <div class="flex flex-wrap gap-3"><button type="button" data-record-share hidden class="record-button">Share or copy link</button><a href={printHref} class="record-button">Print record</a></div>
  <p data-share-status role="status" class="mt-3 text-sm leading-6 text-slate-700"></p>
  <details class="mt-2"><summary class="min-h-[44px] cursor-pointer py-2 text-sm font-medium text-primary-800 underline underline-offset-4">QR code and page link</summary><div class="mt-3 rounded-lg border border-slate-200 bg-white p-4"><img src={qrCodeUrl} alt={`QR code for ${title}`} width="200" height="200" loading="lazy" class="mx-auto h-40 w-40" /><label class="mt-4 block text-sm text-slate-600">Page link<input readonly value={url} class="mt-2 block w-full rounded border border-slate-400 bg-white px-3 py-2 text-sm text-slate-800" /></label></div></details>
  {(updateHref || reportHref) && <div class="mt-5 border-t border-slate-200 pt-4"><p class="text-sm font-semibold text-slate-900">Help keep this record accurate</p><div class="mt-2 flex flex-col items-start gap-1">{updateHref && <a href={updateHref} class="inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">Suggest an update</a>}{reportHref && <a href={reportHref} class="inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">Report an issue</a>}</div></div>}
</section>
<script>
  function initRecordTools() {
    document.querySelectorAll<HTMLElement>('[data-record-tools]').forEach(root => {
      if (root.dataset.ready) return; root.dataset.ready = 'true';
      const button = root.querySelector<HTMLButtonElement>('[data-record-share]')!;
      const status = root.querySelector<HTMLElement>('[data-share-status]')!;
      button.hidden = false;
      root.querySelector('input')?.addEventListener('focus', event => (event.target as HTMLInputElement).select());
      button.addEventListener('click', async () => {
        const url = root.dataset.url!;
        try {
          if (navigator.share) await navigator.share({ title: root.dataset.title, url });
          else { await navigator.clipboard.writeText(url); status.textContent = 'Page link copied.'; }
        } catch (error) {
          if ((error as Error).name === 'AbortError') return;
          status.textContent = 'Copy the page link below to share this record.';
          root.querySelector('details')!.open = true;
          root.querySelector('input')?.focus();
        }
      });
    });
  }
  initRecordTools(); document.addEventListener('astro:page-load', initRecordTools);
</script>
