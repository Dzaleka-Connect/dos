---
interface Props { title: string; items: { title: string; href: string; image?: string; meta?: string }[]; contain?: boolean; }
const { title, items, contain = false } = Astro.props;
---
{items.length > 0 && <section class="record-section"><h2 class="text-primary-900">{title}</h2><div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{items.map(item => <a href={item.href} class="group overflow-hidden rounded-lg border border-slate-200 bg-white hover:border-primary-700">{item.image && <div class="relative aspect-[4/3] bg-slate-100"><img src={item.image} alt="" loading="lazy" class:list={['absolute inset-0 h-full w-full', contain ? 'object-contain' : 'object-cover']} onerror="this.onerror=null;this.src='/images/unavailable-image.svg'" /></div>}<div class="p-5"><h3 class="text-lg font-semibold leading-6 text-primary-800 underline underline-offset-4">{item.title}</h3>{item.meta && <p class="mt-3 text-sm leading-6 text-slate-600">{item.meta}</p>}</div></a>)}</div></section>}
