---
import SocialLinks from './ui/SocialLinks.astro';
import { CloudinaryPresets, getCloudinaryUrl } from '../utils/cloudinary';

interface Props {
  title: string;
  description: string;
  category: string;
  featured?: boolean;
  verified?: boolean;
  href: string;
  email?: string;
  phone?: string;
  address?: string;
  logo?: string;
  socialMedia?: {
    twitter?: string;
    facebook?: string;
    instagram?: string;
    linkedin?: string;
    website?: string;
  };
}

const {
  title,
  description,
  category,
  featured,
  verified,
  href,
  email,
  phone,
  address,
  logo,
  socialMedia
} = Astro.props;

// Optimize logo using Cloudinary (only if it's a Cloudinary URL)
const originalLogo = logo || '/logos/default.png';
const optimizedLogo = logo
  ? getCloudinaryUrl(logo, {
      width: 200,
      height: 200,
      crop: 'fit',
      quality: 'auto:good',
      dpr: 'auto'
    })
  : originalLogo;

// Function to get category color - Cultural palette
function getCategoryColor(category: string) {
  const colors = {
    'Cultural': 'bg-terracotta/10 text-terracotta border-terracotta/30',
    'Education': 'bg-ochre/10 text-ochre border-ochre/30',
    'Youth': 'bg-earth/10 text-earth border-earth/30',
    'Entrepreneurship': 'bg-terracotta/15 text-terracotta border-terracotta/40',
    'Health': 'bg-ochre/15 text-ochre border-ochre/40',
    'Humanitarian Aid': 'bg-earth/15 text-earth border-earth/40',
    'Advocacy': 'bg-terracotta/20 text-terracotta border-terracotta/50',
    'Non-profit Organizations': 'bg-ochre/10 text-ochre border-ochre/30'
  };
  return colors[category] || 'bg-warm/50 text-gray-700 border-ochre/20';
}
---

<article class="group relative bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-500 overflow-hidden h-full flex flex-col border-2 border-ochre/20 hover:border-terracotta/40">
  <div class="p-4 sm:p-6 flex flex-col h-full bg-white">
    <!-- Header -->
    <div class="flex items-start gap-3 sm:gap-4 mb-4">
      <div class="relative w-16 h-16 sm:w-20 sm:h-20 flex-shrink-0 bg-gray-50 rounded-lg p-2 sm:p-3 flex items-center justify-center border-2 border-ochre/20 group-hover:border-terracotta/40 transition-all duration-300">
        <img
          src={optimizedLogo}
          alt={`${title} logo`}
          class="w-full h-full object-contain"
          loading="lazy"
          onerror="this.src='/logos/default.png'; this.onerror=null;"
        />
      </div>
      <div class="flex-grow min-w-0 relative">
        <div class="flex items-start justify-between">
          <h3 class="font-heading text-base sm:text-lg lg:text-xl font-bold text-gray-900 line-clamp-2 mb-2 group-hover:text-terracotta transition-colors duration-300 pr-16 sm:pr-20">
            {title}
          </h3>
          {featured && (
            <div class="absolute top-0 right-0">
              <span class="inline-flex items-center px-2 py-1 text-xs font-medium bg-terracotta/10 text-terracotta border border-terracotta/30 rounded-md">
                Featured
              </span>
            </div>
          )}
        </div>
        <div class="flex flex-wrap gap-1 sm:gap-2">
          <span class={`inline-flex items-center px-2 sm:px-3 py-1 text-xs sm:text-sm font-medium rounded-full ${getCategoryColor(category)}`}>
            {category}
          </span>
          {verified && (
            <span class="inline-flex items-center text-xs sm:text-sm font-medium text-terracotta">
              <svg class="w-3 h-3 sm:w-4 sm:h-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Verified
            </span>
          )}
        </div>
      </div>
    </div>

    <!-- Description -->
    <p class="font-body text-gray-700 text-sm sm:text-base mb-4 line-clamp-3 leading-relaxed">
      {description}
    </p>

    <!-- Clickable overlay for main content -->
    <a href={href} class="absolute inset-0 z-10" aria-label={`View details for ${title}`} style="pointer-events: auto; background: transparent;"></a>

    <!-- Contact Info -->
    <div class="mt-auto space-y-2 sm:space-y-3 relative z-20">
      {(email || phone || address || socialMedia?.website) && (
        <div class="flex flex-col gap-1 sm:gap-2 text-sm sm:text-base text-gray-600">
          {socialMedia?.website && (
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
              <a
                href={socialMedia.website}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-terracotta transition-colors duration-300 z-20"
                onclick="event.stopPropagation();"
              >
                {new URL(socialMedia.website).hostname}
              </a>
            </div>
          )}
          {email && (
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
              </svg>
              <a href={`mailto:${email}`} class="hover:text-terracotta transition-colors duration-300 z-20" onclick="event.stopPropagation();">{email}</a>
            </div>
          )}
          {phone && (
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
              </svg>
              <a href={`tel:${phone}`} class="hover:text-terracotta transition-colors duration-300 z-20" onclick="event.stopPropagation();">{phone}</a>
            </div>
          )}
          {address && (
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
              <span>{address}</span>
            </div>
          )}
        </div>
      )}

      <!-- Social Links -->
      {socialMedia && Object.values(socialMedia).some(Boolean) && (
        <div class="border-t border-gray-100 pt-2 sm:pt-3 relative z-20">
          <div class="flex items-center justify-between">
            <SocialLinks
              facebook={socialMedia.facebook}
              twitter={socialMedia.twitter}
              instagram={socialMedia.instagram}
              linkedin={socialMedia.linkedin}
              website={socialMedia.website}
              className="justify-start"
            />
            {socialMedia.website && (
              <a
                href={socialMedia.website}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center text-sm sm:text-base font-medium text-terracotta hover:text-earth group/link transition-colors duration-300"
                onclick="event.stopPropagation();"
              >
                Visit Website
                <svg class="w-4 h-4 sm:w-5 sm:h-5 ml-1 transform transition-transform duration-300 group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                </svg>
              </a>
            )}
          </div>
        </div>
      )}
    </div>
  </div>

  <a href={href} class="absolute inset-0 z-10" aria-label={`View details for ${title}`} style="pointer-events: none;">
    <span class="sr-only">View details</span>
  </a>
</article>