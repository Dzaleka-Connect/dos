---
import SocialLinks from './ui/SocialLinks.astro';
import { CloudinaryPresets, getCloudinaryUrl } from '../utils/cloudinary';
import { getServiceStatus } from '../utils/serviceHelpers';

interface Props {
  title: string;
  description: string;
  category: string;
  featured?: boolean;
  verified?: boolean;
  href: string;
  email?: string;
  phone?: string;
  address?: string;
  logo?: string;
  hours?: string;
  location?: {
    coordinates?: {
      lat: number;
      lng: number;
    };
  };
  socialMedia?: {
    twitter?: string;
    facebook?: string;
    instagram?: string;
    linkedin?: string;
    website?: string;
  };
}

const {
  title,
  description,
  category,
  featured,
  verified,
  href,
  email,
  phone,
  address,
  logo,
  hours,
  location,
  socialMedia
} = Astro.props;

// Optimize logo using Cloudinary (only if it's a Cloudinary URL)
const originalLogo = logo || '/logos/default.png';
const optimizedLogo = logo
  ? getCloudinaryUrl(logo, {
      width: 200,
      height: 200,
      crop: 'fit',
      quality: 'auto:good',
      dpr: 'auto'
    })
  : originalLogo;

// Function to get category color - Cultural palette
function getCategoryColor(category: string) {
  const colors = {
    'Cultural': 'bg-terracotta/10 text-terracotta border-terracotta/30',
    'Education': 'bg-ochre/10 text-ochre border-ochre/30',
    'Youth': 'bg-earth/10 text-earth border-earth/30',
    'Entrepreneurship': 'bg-terracotta/15 text-terracotta border-terracotta/40',
    'Health': 'bg-ochre/15 text-ochre border-ochre/40',
    'Humanitarian Aid': 'bg-earth/15 text-earth border-earth/40',
    'Advocacy': 'bg-terracotta/20 text-terracotta border-terracotta/50',
    'Non-profit Organizations': 'bg-ochre/10 text-ochre border-ochre/30'
  };
  // @ts-ignore
  return colors[category] || 'bg-warm/50 text-gray-700 border-ochre/20';
}

const serviceStatus = hours ? getServiceStatus(hours) : null;
// Clean phone number for WhatsApp
const whatsappNumber = phone ? phone.replace(/\D/g, '') : null;
const whatsappUrl = whatsappNumber ? `https://wa.me/${whatsappNumber}` : null;

// Generate Google Maps URL
const googleMapsUrl = location?.coordinates 
  ? `https://www.google.com/maps?q=${location.coordinates.lat},${location.coordinates.lng}`
  : (address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}` : null);
---

<article class="group relative bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-500 overflow-hidden h-full flex flex-col border-2 border-ochre/20 hover:border-terracotta/40">
  <div class="p-4 sm:p-6 flex flex-col h-full bg-white">
    <!-- Header -->
    <div class="flex items-start gap-3 sm:gap-4 mb-4">
      <div class="relative w-16 h-16 sm:w-20 sm:h-20 flex-shrink-0 bg-gray-50 rounded-lg p-2 sm:p-3 flex items-center justify-center border-2 border-ochre/20 group-hover:border-terracotta/40 transition-all duration-300">
        <img
          src={optimizedLogo}
          alt={`${title} logo`}
          class="w-full h-full object-contain"
          loading="lazy"
          onerror="this.src='/logos/default.png'; this.onerror=null;"
        />
      </div>
      <div class="flex-grow min-w-0 relative">
        <div class="flex items-start justify-between">
          <h3 class="font-heading text-base sm:text-lg lg:text-xl font-bold text-gray-900 line-clamp-2 mb-2 group-hover:text-terracotta transition-colors duration-300 pr-16 sm:pr-20">
            {title}
          </h3>
          <div class="absolute top-0 right-0 flex flex-col gap-1 items-end p-2 pointer-events-none z-20">
            {serviceStatus && hours && (
               <div class="relative inline-block group/tooltip pointer-events-auto" onclick="event.stopPropagation(); this.querySelector('.hours-tooltip').classList.toggle('hidden')">
                   <div class="cursor-help transition-transform hover:scale-105">
                       <span class={`inline-flex items-center px-2 py-1 rounded-md text-xs font-medium border shadow-sm backdrop-blur-sm ${
                         serviceStatus === 'open' 
                           ? 'bg-green-50/90 text-green-700 border-green-200' 
                           : 'bg-gray-50/90 text-gray-600 border-gray-200'
                       }`}>
                         <span class={`w-1.5 h-1.5 rounded-full mr-1.5 ${
                           serviceStatus === 'open' ? 'bg-green-500' : 'bg-gray-400'
                         } animate-pulse`}></span>
                         {serviceStatus === 'open' ? 'Open' : 'Closed'}
                         <svg class="w-3 h-3 ml-1 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                       </span>
                   </div>
                   
                   <!-- Tooltip -->
                   <div class="hours-tooltip hidden group-hover/tooltip:block absolute top-full right-0 mt-2 w-48 p-3 bg-white text-gray-700 text-xs rounded-lg shadow-xl z-50 border border-gray-100 ring-1 ring-black/5">
                     <div class="font-semibold mb-1 text-gray-900 border-b border-gray-100 pb-1">Opening Hours</div>
                     <div class="whitespace-pre-line leading-relaxed">{hours}</div>
                     <!-- Arrow -->
                     <div class="absolute bottom-full right-4 border-4 border-transparent border-b-white"></div>
                   </div>
               </div>
            )}
          </div>
        </div>
        <div class="flex flex-wrap gap-1 sm:gap-2 items-center">
          <span class={`inline-flex items-center px-2 sm:px-3 py-1 text-xs sm:text-sm font-medium rounded-full ${getCategoryColor(category)}`}>
            {category}
          </span>
          {verified && (
            <span class="inline-flex items-center text-xs sm:text-sm font-medium text-terracotta">
              <svg class="w-3 h-3 sm:w-4 sm:h-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Verified
            </span>
          )}

        </div>
      </div>
    </div>

    <!-- Description -->
    <p class="font-body text-gray-700 text-sm sm:text-base mb-4 line-clamp-3 leading-relaxed">
      {description}
    </p>

    <!-- Clickable overlay for main content -->
    <a href={href} class="absolute inset-0 z-10" aria-label={`View details for ${title}`} style="pointer-events: auto; background: transparent;"></a>

    <!-- Contact Info & Actions -->
    <div class="mt-auto space-y-3 relative z-20">
      <div class="flex flex-col gap-1 sm:gap-2 text-sm sm:text-base text-gray-600">

         {/* Standard Contact Info */}
         <div onclick="event.stopPropagation()">
            {(socialMedia || email) && (
              <SocialLinks
                facebook={socialMedia?.facebook}
                twitter={socialMedia?.twitter}
                instagram={socialMedia?.instagram}
                linkedin={socialMedia?.linkedin}
                website={socialMedia?.website}
                email={email}
                className="mb-2"
              />
            )}
         </div>
         
         {address && (
           <div class="flex items-center gap-2">
             <svg class="w-4 h-4 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
               <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
             </svg>
             <span class="truncate">{address}</span>
           </div>
         )}
      </div>

       {/* Action Buttons Row */}
       <div class="flex flex-wrap gap-2 pt-2">
          {whatsappUrl && (
             <a 
               href={whatsappUrl}
               target="_blank"
               rel="noopener noreferrer"
               class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-[#25D366]/10 text-[#25D366] hover:bg-[#25D366]/20 border border-[#25D366]/20 rounded-lg text-sm font-medium transition-colors"
               onclick="event.stopPropagation();"
             >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                WhatsApp
             </a>
          )}
          {googleMapsUrl && (
             <a 
               href={googleMapsUrl}
               target="_blank"
               rel="noopener noreferrer"
               class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 bg-primary-100/50 text-primary-700 hover:bg-primary-100 border border-primary-200 rounded-lg text-sm font-medium transition-colors"
               onclick="event.stopPropagation();"
             >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                   <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                Directions
             </a>
          )}
       </div>

    </div>
  </div>
</article>