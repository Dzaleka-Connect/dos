---
import SocialLinks from './ui/SocialLinks.astro';
import ServiceLogo from './services/ServiceLogo.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  featured?: boolean;
  verified?: boolean;
  href: string;
  email?: string;
  phone?: string;
  address?: string;
  logo?: string;
  hours?: string;
  location?: {
    coordinates?: {
      lat: number;
      lng: number;
    };
  };
  socialMedia?: {
    twitter?: string;
    facebook?: string;
    instagram?: string;
    linkedin?: string;
    website?: string;
  };
}

const {
  title,
  description,
  category,
  featured,
  verified,
  href,
  email,
  phone,
  address,
  logo,
  hours,
  location,
  socialMedia
} = Astro.props;

// Clean phone number for WhatsApp
const whatsappNumber = phone ? phone.replace(/\D/g, '') : null;
const whatsappUrl = whatsappNumber ? `https://wa.me/${whatsappNumber}` : null;

// Generate Google Maps URL
const googleMapsUrl = location?.coordinates
  ? `https://www.google.com/maps?q=${location.coordinates.lat},${location.coordinates.lng}`
  : (address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}` : null);
---

<article class="flex h-full min-w-0 flex-col rounded border border-slate-200 bg-white p-5 sm:p-6">
  <div class="flex items-start gap-4">
    <ServiceLogo title={title} logo={logo} />
    <div class="min-w-0">
      <h3 class="text-lg font-semibold leading-7"><a href={href} class="text-primary-800 underline decoration-primary-800/40 underline-offset-4 hover:text-primary-900 hover:decoration-2">{title}</a></h3>
      <p class="mt-1 text-sm text-slate-600">{category}</p>
    </div>
  </div>
  {(featured || verified) && <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium text-slate-600">
    {featured && <span>Featured</span>}
    {verified && <span class="text-primary-800">Verified</span>}
  </div>}
  <p class="my-4 line-clamp-3 text-sm leading-6 text-slate-600">{description}</p>
  {hours && <details class="mb-3 text-sm">
    <summary class="cursor-pointer py-2 text-primary-800 underline underline-offset-4">Opening hours</summary>
    <p class="mt-1 whitespace-pre-line leading-6 text-slate-600">{hours}</p>
  </details>}
  <div class="mt-auto">
    {address && <p class="mb-2 text-sm leading-6 text-slate-600">{address}</p>}
    {(socialMedia || email) && <SocialLinks facebook={socialMedia?.facebook} twitter={socialMedia?.twitter} instagram={socialMedia?.instagram} linkedin={socialMedia?.linkedin} website={socialMedia?.website} email={email} className="mb-3" />}
    {(whatsappUrl || googleMapsUrl) && <div class="flex flex-wrap gap-3 border-t border-slate-200 pt-4">
      {whatsappUrl && <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] flex-1 items-center justify-center rounded border border-green-700 px-3 py-2 text-sm font-medium text-green-800 hover:bg-green-50">WhatsApp<span class="sr-only"> for {title} (opens in a new tab)</span></a>}
      {googleMapsUrl && <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] flex-1 items-center justify-center rounded border border-primary-800 px-3 py-2 text-sm font-medium text-primary-900 hover:bg-primary-50">Directions<span class="sr-only"> to {title} (opens in a new tab)</span></a>}
    </div>}
  </div>
</article>
