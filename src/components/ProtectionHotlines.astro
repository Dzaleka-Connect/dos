---
const hotlines = [
  {
    number: "5600",
    label: "GBV Crisis Line (Tithandizane)",
    desc: "24/7 for Gender-Based Violence, child marriage, & trafficking.",
    color: "bg-red-50 text-red-800 hover:bg-red-100 border-red-200"
  },
  {
    number: "116",
    label: "Child Protection Helpline",
    desc: "Reporting child abuse or exploitation.",
    color: "bg-blue-100 text-blue-700 hover:bg-blue-200 border-blue-200"
  },
  {
    number: "1195",
    label: "SGBV Support",
    desc: "Support for Sexual & Gender-Based Violence survivors.",
    color: "bg-red-50 text-red-800 hover:bg-red-100 border-red-200"
  },
  {
    number: "393",
    label: "Youth Helpline",
    desc: "Sexual health & relationship support.",
    color: "bg-green-100 text-green-700 hover:bg-green-200 border-green-200"
  }
];

const contacts = [
  {
    name: "UNHCR Malawi Main Line",
    val: "+265 1 772 155",
    type: "tel",
    icon: "🇺🇳"
  },
  {
    name: "UNHCR Protection Email",
    val: "mlwli@unhcr.org",
    type: "mailto",
    icon: "✉️"
  }
];
---

<div class="space-y-8 my-8">
  
  <!-- National Hotlines Grid -->
  <div>
    <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
      <span class="mr-2">🆘</span> National Toll-Free Numbers
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {hotlines.map(line => (
        <a href={`tel:${line.number}`} class={`block p-4 rounded-xl border transition duration-200 flex items-start ${line.color} group`}>
          <div class="flex-1">
            <div class="flex items-center justify-between mb-1">
              <span class="font-bold text-lg group-hover:underline">{line.number}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-70" viewBox="0 0 20 20" fill="currentColor">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
              </svg>
            </div>
            <h4 class="font-semibold text-sm mb-1 text-gray-900">{line.label}</h4>
            <p class="text-xs opacity-80 leading-snug">{line.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- UNHCR Contacts -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6">
    <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
      <span class="mr-2">🇺🇳</span> UNHCR & Humanitarian Contacts
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {contacts.map(contact => (
        <a href={`${contact.type}:${contact.val}`} class="flex items-center p-3 bg-white rounded-lg border border-gray-200 hover:border-blue-300 hover:shadow-sm transition">
          <span class="text-2xl mr-3">{contact.icon}</span>
          <div>
            <h4 class="text-xs text-gray-500 uppercase tracking-wide font-semibold">{contact.name}</h4>
            <span class="text-blue-700 font-bold block">{contact.val}</span>
          </div>
        </a>
      ))}
    </div>
  </div>

</div>
