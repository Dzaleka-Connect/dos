---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import Toast from '../components/ui/Toast.astro';

interface Props {
	title: string;
	description?: string;
	author?: string;
	keywords?: string;
	type?: string;
	canonical?: string;
	image?: string;
	ogImage?: string;
	robots?: string;
	schema?: object;
	openGraph?: {
		title?: string;
		description?: string;
		type?: string;
		image?: {
			url: string;
			width?: number;
			height?: number;
			alt?: string;
			type?: string;
		} | string;
		site_name?: string;
		locale?: string;
		url?: string;
		article?: {
			publishedTime?: string;
			modifiedTime?: string;
			author?: string | string[];
			tags?: string[];
			section?: string;
		};
		event?: {
			startTime?: string;
			endTime?: string;
			location?: string;
			organizer?: string;
		};
	};
	twitter?: {
		card?: string;
		title?: string;
		description?: string;
		image?: string;
		creator?: string;
	};
}

const {
	title,
	description,
	author,
	keywords,
	type = "website",
	canonical = Astro.url.pathname,
	image,
	robots,
	schema,
	openGraph,
	twitter
} = Astro.props;

// Prepare OpenGraph image for Layout
const ogImage = openGraph?.images?.[0]?.url
	|| (openGraph?.image ? (typeof openGraph.image === 'string' ? openGraph.image : openGraph.image.url) : image);
---

<Layout
	title={title}
	description={description}
	author={author}
	keywords={keywords}
	type={type}
	canonical={canonical}
	ogImage={ogImage}
	robots={robots}
	schema={schema}
	openGraph={openGraph}
	twitter={twitter}
>
	<slot name="head" slot="head" />

  <!-- Skip to content link for accessibility -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-primary-600 text-white px-4 py-2 rounded-lg shadow-lg z-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
  >
    Skip to main content
  </a>

  <div class="flex flex-col min-h-screen">
    <Header />
    <main id="main-content" tabindex="-1" class="min-w-0 flex-grow">
      <slot />
    </main>
    <Footer />
  </div>


  <Toast />
</Layout>
