---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import PageFeedback from '../components/ui/PageFeedback.astro';
import Footer from '../components/Footer.astro';

import Toast from '../components/ui/Toast.astro';
import { contentSeo } from '../lib/news/content-seo';

interface Props {
	cmsSeo?: unknown;
	isPreview?: boolean;
	lang?: string;
	showFeedback?: boolean;
	title: string;
	description?: string;
	author?: string;
	keywords?: string;
	type?: string;
	canonical?: string;
	image?: string;
	ogImage?: string;
	robots?: string;
	schema?: object;
	openGraph?: {
		title?: string;
		description?: string;
		type?: string;
		image?: {
			url: string;
			width?: number;
			height?: number;
			alt?: string;
			type?: string;
		} | string;
		site_name?: string;
		locale?: string;
		url?: string;
		article?: {
			publishedTime?: string;
			modifiedTime?: string;
			author?: string | string[];
			tags?: string[];
			section?: string;
		};
		event?: {
			startTime?: string;
			endTime?: string;
			location?: string;
			organizer?: string;
		};
	};
	twitter?: {
		card?: string;
		title?: string;
		description?: string;
		image?: string;
		creator?: string;
	};
}

const {
	lang = "en",
	showFeedback = true,
	title,
	description,
	author,
	keywords,
	type = "website",
	canonical = Astro.url.pathname,
	image,
	robots,
	schema,
	openGraph,
	twitter
} = Astro.props;

// Prepare OpenGraph image for Layout
const ogImage = openGraph?.images?.[0]?.url
	|| (openGraph?.image ? (typeof openGraph.image === 'string' ? openGraph.image : openGraph.image.url) : image);
const cms = contentSeo(Astro.props.cmsSeo);
const resolvedOpenGraph = {
	...openGraph,
	...(cms.title && { title: cms.title }),
	...(cms.description && { description: cms.description }),
	...(cms.canonical && { url: cms.canonical }),
	...(cms.image && { image: cms.image }),
};
const resolvedTwitter = {
	...twitter,
	...(cms.title && { title: cms.title }),
	...(cms.description && { description: cms.description }),
	...(cms.image && { image: cms.image }),
};
---

<Layout
	lang={lang}
	title={cms.title || title}
	description={cms.description || description}
	exactTitle={Boolean(cms.title)}
	exactDescription={Boolean(cms.description)}
	author={author}
	keywords={keywords}
	type={type}
	canonical={cms.canonical || canonical}
	ogImage={cms.image || ogImage}
	robots={Astro.props.isPreview || cms.noIndex ? 'noindex, nofollow' : robots}
	schema={schema}
	openGraph={resolvedOpenGraph}
	twitter={resolvedTwitter}
>
	<slot name="head" slot="head" />

  <!-- Skip to content link for accessibility -->
  <a
    lang="en"
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-primary-600 text-white px-4 py-2 rounded shadow-lg z-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
  >
    Skip to main content
  </a>

  <div class="flex flex-col min-h-screen">
    <Header />
    <main id="main-content" tabindex="-1" class="min-w-0 flex-grow">
      <slot />
    </main>
    {showFeedback && <PageFeedback />}
    <div lang="en" class="print:hidden"><Footer /></div>
  </div>


  <Toast />
</Layout>
