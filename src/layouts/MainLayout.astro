---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageViewCounter from '../components/analytics/PageViewCounter.astro';

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	type?: string;
	canonical?: string;
	image?: string;
	openGraph?: {
		title?: string;
		description?: string;
		type?: string;
		image?: {
			url: string;
			width?: number;
			height?: number;
			alt?: string;
			type?: string;
		} | string;
		site_name?: string;
		locale?: string;
		url?: string;
		article?: {
			publishedTime?: string;
			modifiedTime?: string;
			author?: string | string[];
			tags?: string[];
			section?: string;
		};
		event?: {
			startTime?: string;
			endTime?: string;
			location?: string;
			organizer?: string;
		};
	};
	twitter?: {
		card?: string;
		title?: string;
		description?: string;
		image?: string;
		creator?: string;
	};
}

const { 
	title,
	description,
	keywords,
	type = "website",
	canonical = Astro.url.pathname,
	image,
	openGraph,
	twitter
} = Astro.props;

// Prepare OpenGraph image for Layout
const ogImage = openGraph?.images?.[0]?.url
	|| (openGraph?.image ? (typeof openGraph.image === 'string' ? openGraph.image : openGraph.image.url) : image);
---

<Layout 
	title={title}
	description={description}
	keywords={keywords}
	type={type}
	canonical={canonical}
	ogImage={ogImage}
	openGraph={openGraph}
	twitter={twitter}
>
	<slot name="head" slot="head" />
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </div>
  <PageViewCounter />
</Layout>
