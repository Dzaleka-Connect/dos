<script is:inline define:vars={{ chartDataJSON: JSON.stringify(chartData), allContentJSON: JSON.stringify(allContent) }}>
  // Tab management
  const tabClass = "inline-flex items-center justify-center px-3 py-2.5 text-sm font-medium rounded-md transition-colors duration-200 ease-in-out";
  const inactiveTabClass = "text-gray-500 hover:text-gray-700 bg-gray-100 hover:bg-gray-200";
  const activeTabClass = "text-white bg-primary-600";

  function initTabs() {
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tabId = button.getAttribute('data-tab');
        
        // Update buttons
        tabButtons.forEach(btn => {
          btn.setAttribute('aria-selected', 'false');
          // Remove active classes
          btn.className = tabClass + " " + inactiveTabClass;
        });
        
        button.setAttribute('aria-selected', 'true');
        // Add active classes
        button.className = tabClass + " " + activeTabClass;

        // Update panels
        tabPanels.forEach(panel => {
          panel.classList.add('hidden');
          if (panel.id === `${tabId}-panel`) {
            panel.classList.remove('hidden');
            // Re-trigger animation
            panel.classList.remove('animate-fade-in-up');
            void panel.offsetWidth; // trigger reflow
            panel.classList.add('animate-fade-in-up');
          }
        });

        // Initialize charts when analytics tab is shown
        if (tabId === 'analytics') {
          setTimeout(() => initCharts(), 100);
        }
      });
    });

    // Activate first tab
    if (tabButtons.length > 0) {
      // Manually trigger click on first tab to set initial state
      const firstTab = tabButtons[0];
      const tabId = firstTab.getAttribute('data-tab');
      
      // Set initial classes
      tabButtons.forEach(btn => btn.className = tabClass + " " + inactiveTabClass);
      firstTab.className = tabClass + " " + activeTabClass;
      
      tabPanels.forEach(panel => {
        panel.classList.add('hidden');
        if (panel.id === `${tabId}-panel`) panel.classList.remove('hidden');
      });
    }
  }

  // Store chart instances to destroy them before re-rendering
  const chartInstances = {};

  // Chart initialization
  function initCharts() {
    if (typeof Chart === 'undefined') {
      console.error('Chart.js not loaded');
      return;
    }

    try {

      const chartData = JSON.parse(chartDataJSON);
      const colors = {
        primary: ['#3B82F6', '#60A5FA', '#93C5FD', '#BFDBFE', '#DBEAFE'],
        success: '#10B981',
        warning: '#F59E0B',
        danger: '#EF4444',
        info: '#6366F1',
        purple: '#8B5CF6',
        pink: '#EC4899',
        orange: '#F97316',
        teal: '#14B8A6'
