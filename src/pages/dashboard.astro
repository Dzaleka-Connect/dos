  // Activity Feed Logic
  let activityPage = 1;
  const activityPerPage = 10;

  function initActivityFeed() {
    const loadMoreBtn = document.getElementById('loadMoreActivity');
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        activityPage++;
        renderActivityFeed();
      });
    }
  }



  function renderActivityFeed() {
    const container = document.getElementById('activityList');
    const loadMoreBtn = document.getElementById('loadMoreActivity');
    
    if (!container) return;

    const start = (activityPage - 1) * activityPerPage;
    const end = start + activityPerPage;
    // We skip the first 10 because they are already rendered by server
    // Actually, to be safe and consistent, we should probably re-render everything or append.
    // But the server rendered the first 10.
    // Let's just append the next batch.
    
    // Wait, if we use allContent, it contains EVERYTHING.
    // The server rendered the first 10 of `recentActivity`.
    // `recentActivity` is sorted by date. `allContent` is also sorted by date.
    // So we can just take slices from `allContent`.
    
    const newItems = allContent.slice(start, end);
    
    if (newItems.length === 0) {
      if (loadMoreBtn) {
        loadMoreBtn.textContent = 'No more activity';
        loadMoreBtn.disabled = true;
        loadMoreBtn.classList.add('opacity-50', 'cursor-not-allowed');
      }
      return;
    }

    // If it's the first page (which is already rendered), we don't do anything unless we want to replace it.
    // But here we are called on "Load More", so we are on page 2+.
    // However, the server rendered items 0-10.
    // So if activityPage starts at 1, and we increment to 2.
    // We want items 10-20.
    // So start = (2-1) * 10 = 10. Correct.

    const html = newItems.map(item => `
      <div class="p-4 hover:bg-gray-50 transition-colors activity-item">
        <div class="flex items-start space-x-3">
          <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 ${
            item.type === 'service' ? 'bg-blue-100' :
            item.type === 'event' ? 'bg-purple-100' :
            item.type === 'news' ? 'bg-green-100' :
            'bg-yellow-100'
          }">
            ${getIconForType(item.type)}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900 truncate">${item.title}</p>
            <p class="text-sm text-gray-500 capitalize">${item.type} • ${new Date(item.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</p>
            ${item.description ? `<p class="text-sm text-gray-600 mt-1 line-clamp-2">${item.description}</p>` : ''}
          </div>
          <a
            href="${getPathForType(item)}/${item.slug}"
            class="text-primary-600 hover:text-primary-700 text-sm font-medium whitespace-nowrap"
          >
            View →
          </a>
        </div>
      </div>
    `).join('');

    container.insertAdjacentHTML('beforeend', html);
    
    if (end >= allContent.length) {
      if (loadMoreBtn) {
        loadMoreBtn.textContent = 'No more activity';
        loadMoreBtn.disabled = true;
        loadMoreBtn.classList.add('opacity-50', 'cursor-not-allowed');
      }
    }
  }

    showToast('Dashboard loaded successfully', 'success');
    
    // Initialize content table
    initContentTable();
  });

  // Content Table Logic
  let currentPage = 1;
  const itemsPerPage = 10;
  let filteredContent = [];
  let allContent = [];

  function initContentTable() {
    try {
      allContent = JSON.parse(allContentJSON);
      filteredContent = [...allContent];
      
      const searchInput = document.getElementById('contentSearch');
      const filterSelect = document.getElementById('contentFilter');
      const prevBtn = document.getElementById('prevPage');
      const nextBtn = document.getElementById('nextPage');

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          filterContent(e.target.value, filterSelect ? filterSelect.value : 'all');
        });
      }

      if (filterSelect) {
        filterSelect.addEventListener('change', (e) => {
          filterContent(searchInput ? searchInput.value : '', e.target.value);
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (currentPage > 1) {
            currentPage--;
            renderContentTable();
          }
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          const maxPage = Math.ceil(filteredContent.length / itemsPerPage);
          if (currentPage < maxPage) {
            currentPage++;
            renderContentTable();
          }
        });
      }

      renderContentTable();

      // Export button
      const exportBtn = document.getElementById('exportButton');
      if (exportBtn) {
        exportBtn.addEventListener('click', exportData);
      }
    } catch (e) {
      console.error('Error initializing content table:', e);
    }
  }

  function exportData() {
    try {
      // Convert data to CSV format
      const headers = ['ID', 'Type', 'Title', 'Category', 'Status', 'Date', 'Description'];
      const csvRows = [headers.join(',')];
      
      // Use filtered content if available, otherwise all content
      const dataToExport = filteredContent.length > 0 ? filteredContent : allContent;
      
      dataToExport.forEach(item => {
        const row = [
          item.id,
          item.type,
          `"${(item.title || '').replace(/"/g, '""')}"`,
          `"${(item.category || '').replace(/"/g, '""')}"`,
          item.status,
          new Date(item.date).toLocaleDateString(),
          `"${(item.description || '').replace(/"/g, '""')}"`
        ];
        csvRows.push(row.join(','));
      });
      
      const csvContent = csvRows.join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `dashboard_export_${new Date().toISOString().split('T')[0]}.csv`);
      link.style.visibility = 'hidden';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      
      showToast('Export started successfully', 'success');
    } catch (e) {
      console.error('Export failed:', e);
      showToast('Failed to export data', 'error');
    }
  }

  function getPathForType(item) {
    if (item.urlPrefix) return item.urlPrefix;
    switch (item.type) {
      case 'job': return '/jobs';
      case 'news': return '/news';
      case 'event': return '/events';
      case 'dancer': return '/dancers';
      case 'poet': return '/poets';
      case 'site': return '/sites';
      case 'artist': return '/artists';
      case 'artwork': return '/artworks';
      case 'photo': return '/photos';
      case 'resource': return '/resources';
      default: return '/services';
    }
  }

  function filterContent(searchTerm, typeFilter) {
    searchTerm = searchTerm.toLowerCase();
    
    filteredContent = allContent.filter(item => {
      const matchesSearch = item.title.toLowerCase().includes(searchTerm) || 
                            (item.category && item.category.toLowerCase().includes(searchTerm));
      const matchesType = typeFilter === 'all' || item.type === typeFilter || item.type + 's' === typeFilter;
      
      return matchesSearch && matchesType;
    });

    currentPage = 1;
    renderContentTable();
  }

  function renderContentTable() {
    const tbody = document.getElementById('contentTableBody');
    const startEl = document.getElementById('contentStart');
    const endEl = document.getElementById('contentEnd');
    const totalEl = document.getElementById('contentTotal');
    const prevBtn = document.getElementById('prevPage');
    const nextBtn = document.getElementById('nextPage');

    if (!tbody) return;

    // Calculate pagination
    const start = (currentPage - 1) * itemsPerPage;
    const end = start + itemsPerPage;
    const pageItems = filteredContent.slice(start, end);
    const total = filteredContent.length;

    // Update stats
    if (startEl) startEl.textContent = total > 0 ? start + 1 : 0;
    if (endEl) endEl.textContent = Math.min(end, total);
    if (totalEl) totalEl.textContent = total;

    // Update buttons
    if (prevBtn) prevBtn.disabled = currentPage === 1;
    if (nextBtn) nextBtn.disabled = currentPage >= Math.ceil(total / itemsPerPage) || total === 0;

    // Render rows
    tbody.innerHTML = pageItems.map(item => `
      <tr class="hover:bg-gray-50 transition-colors">
        <td class="px-6 py-4 whitespace-nowrap">
          <div class="flex items-center">
            <div class="flex-shrink-0 h-10 w-10 flex items-center justify-center rounded-full ${
              item.type === 'service' ? 'bg-blue-100 text-blue-600' :
              item.type === 'resource' ? 'bg-indigo-100 text-indigo-600' :
              item.type === 'event' ? 'bg-purple-100 text-purple-600' :
              item.type === 'photo' ? 'bg-pink-100 text-pink-600' :
              item.type === 'job' ? 'bg-yellow-100 text-yellow-600' :
