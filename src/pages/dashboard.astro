---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { format } from 'date-fns';
import { checkContentHealth, calculateSystemHealth } from '../utils/monitoring-utils';
import { convertToCSV } from '../utils/export-utils';

// Fetch all collections
const services = await getCollection('services');
const resources = await getCollection('resources');
const events = await getCollection('events');
const talents = await getCollection('talents');
const photos = await getCollection('photos');
const jobs = await getCollection('jobs');
const docs = await getCollection('docs');
const communityVoices = await getCollection('community-voices');
const news = await getCollection('news');
const dancers = await getCollection('dancers');
const poets = await getCollection('poets');
const sites = await getCollection('sites');
const artists = await getCollection('artists');
const artworks = await getCollection('artworks');
const profiles = await getCollection('profiles'); // Skills Exchange

// Helper functions
const isWithinLast30Days = (date) => {
  const thirtyDaysAgo = new Date();
  thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
  return new Date(date) > thirtyDaysAgo;
};

const isWithinLast7Days = (date) => {
  const sevenDaysAgo = new Date();
  sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);
  return new Date(date) > sevenDaysAgo;
};

// Calculate comprehensive statistics
const stats = {
  services: {
    total: services.length,
    active: services.filter(s => s.data.status === 'active').length,
    verified: services.filter(s => s.data.verified).length,
    recent: services.filter(s => isWithinLast30Days(s.data.lastUpdated || s.data.date)).length,
    last7Days: services.filter(s => isWithinLast7Days(s.data.lastUpdated || s.data.date)).length,
    categories: [...new Set(services.map(s => s.data.category))].length,
  },
  resources: {
    total: resources.length,
    categories: resources.reduce((acc, r) => {
      acc[r.data.category] = (acc[r.data.category] || 0) + 1;
      return acc;
    }, {}),
    recent: resources.filter(r => isWithinLast30Days(r.data.publishDate || r.data.date)).length,
    last7Days: resources.filter(r => isWithinLast7Days(r.data.publishDate || r.data.date)).length,
  },
  events: {
    total: events.length,
    upcoming: events.filter(e => new Date(e.data.date) > new Date()).length,
    past: events.filter(e => new Date(e.data.date) <= new Date()).length,
    thisMonth: events.filter(e => {
      const eventDate = new Date(e.data.date);
      const now = new Date();
      return eventDate.getMonth() === now.getMonth() && eventDate.getFullYear() === now.getFullYear();
    }).length,
    categories: [...new Set(events.map(e => e.data.category))].length,
  },
  photos: {
    total: photos.length,
    recent: photos.filter(p => isWithinLast30Days(p.data.date)).length,
    last7Days: photos.filter(p => isWithinLast7Days(p.data.date)).length,
    albums: [...new Set(photos.map(p => p.data.album || 'Uncategorized'))].length,
  },
  jobs: {
    total: jobs.length,
    active: jobs.filter(j => j.data.status === 'open').length,
    inactive: jobs.filter(j => j.data.status !== 'open').length,
    recent: jobs.filter(j => isWithinLast30Days(j.data.posted)).length,
    last7Days: jobs.filter(j => isWithinLast7Days(j.data.posted || j.data.date)).length,
  },
  news: {
    total: news.length,
    recent: news.filter(n => isWithinLast30Days(n.data.date)).length,
    last7Days: news.filter(n => isWithinLast7Days(n.data.date)).length,
    categories: [...new Set(news.map(n => n.data.category))].length,
  },
  talents: {
    total: talents.length,
    recent: talents.filter(t => isWithinLast30Days(t.data.date)).length,
    featured: talents.filter(t => t.data.featured).length,
  },
  profiles: {
    total: profiles.length,
    offered: profiles.filter(p => !p.data.requestStatus).length,
    requested: profiles.filter(p => p.data.requestStatus).length,
    categories: profiles.reduce((acc, p) => {
      const cat = p.data.category || 'Other';
      acc[cat] = (acc[cat] || 0) + 1;
      return acc;
    }, {})
  },
  communityVoices: {
    total: communityVoices.length,
    recent: communityVoices.filter(v => isWithinLast30Days(v.data.date)).length,
  },
  docs: {
    total: docs.length,
    categories: [...new Set(docs.map(d => d.data.category))].length,
  },
  dancers: {
    total: dancers.length,
    recent: dancers.filter(d => isWithinLast30Days(d.data.date)).length,
  },
  poets: {
    total: poets.length,
    recent: poets.filter(p => isWithinLast30Days(p.data.date)).length,
  },
  sites: {
    total: sites.length,
    active: sites.length // Assuming all are active for now
  },
  artists: {
    total: artists.length,
    recent: artists.filter(a => isWithinLast30Days(a.data.date)).length,
  },
  artworks: {
    total: artworks.length,
    recent: artworks.filter(a => isWithinLast30Days(a.data.date)).length,
  },
};

// Calculate total activity for last 7 days and 30 days
const totalActivity = {
  last7Days: stats.services.last7Days + stats.resources.last7Days + stats.events.thisMonth +
             stats.photos.last7Days + stats.jobs.last7Days + stats.news.last7Days,
  last30Days: stats.services.recent + stats.resources.recent + stats.photos.recent +
              stats.jobs.recent + stats.news.recent,
};

// Get top categories
const servicesByCategory = services.reduce((acc, service) => {
  const category = service.data.category;
  acc[category] = (acc[category] || 0) + 1;
  return acc;
}, {});

const topCategories = Object.entries(servicesByCategory)
  .sort(([,a], [,b]) => b - a)
  .slice(0, 5);

// Content health monitoring
const contentHealthData = {
  services: checkContentHealth(services, 'services'),
  resources: checkContentHealth(resources, 'resources'),
  events: checkContentHealth(events, 'events'),
  photos: checkContentHealth(photos, 'photos'),
  news: checkContentHealth(news, 'news'),
  dancers: checkContentHealth(dancers, 'dancers'),
  poets: checkContentHealth(poets, 'poets'),
  sites: checkContentHealth(sites, 'sites'),
  artists: checkContentHealth(artists, 'artists'),
  artworks: checkContentHealth(artworks, 'artworks'),
};

const contentHealth = {
  total: Object.values(contentHealthData).reduce((sum, data) => sum + data.total, 0),
  missingImages: Object.values(contentHealthData).reduce((sum, data) => sum + data.missingImages.length, 0),
  incompleteMetadata: Object.values(contentHealthData).reduce((sum, data) => sum + data.incompleteMetadata.length, 0),
  brokenLinks: Object.values(contentHealthData).reduce((sum, data) => sum + data.brokenLinks.length, 0),
};

contentHealth.healthyContent = contentHealth.total - (contentHealth.missingImages + contentHealth.incompleteMetadata + contentHealth.brokenLinks);
const healthPercentage = contentHealth.total > 0 ? Math.round((contentHealth.healthyContent / contentHealth.total) * 100) : 100;

// Calculate System Health
const apiStatus = {
  services: { status: 'operational', latency: 517 },
  resources: { status: 'operational', latency: 605 },
  events: { status: 'operational', latency: 580 },
  photos: { status: 'operational', latency: 514 },
  jobs: { status: 'operational', latency: 643 },
  profiles: { status: 'operational', latency: 416 }
};
const systemHealthPercentage = Math.round(
  (Object.values(apiStatus).filter(s => s.status === 'operational').length / Object.keys(apiStatus).length) * 100
);

// Recent items for activity feed
const recentActivity = [
  ...services.slice(0, 3).map(s => ({ type: 'service', item: s, date: s.data.lastUpdated || s.data.date })),
  ...events.slice(0, 3).map(e => ({ type: 'event', item: e, date: e.data.date })),
  ...news.slice(0, 3).map(n => ({ type: 'news', item: n, date: n.data.date })),
  ...jobs.slice(0, 3).map(j => ({ type: 'job', item: j, date: j.data.posted || j.data.date })),
].sort((a, b) => new Date(b.date) - new Date(a.date)).slice(0, 10);

// Trend data for last 7 days (calculated from actual content)
const last7DaysTrend = Array.from({ length: 7 }, (_, i) => {
  const date = new Date();
  date.setDate(date.getDate() - (6 - i));
  const dateString = date.toISOString().split('T')[0];
  
  // Count items created/updated on this date
  const count = [
    ...services.filter(s => (s.data.lastUpdated || s.data.date)?.toString().startsWith(dateString)),
    ...resources.filter(r => (r.data.publishDate || r.data.date)?.toString().startsWith(dateString)),
    ...events.filter(e => e.data.date?.toString().startsWith(dateString)),
    ...photos.filter(p => p.data.date?.toString().startsWith(dateString)),
    ...jobs.filter(j => (j.data.posted || j.data.date)?.toString().startsWith(dateString)),
    ...news.filter(n => n.data.date?.toString().startsWith(dateString)),
    ...dancers.filter(d => d.data.date?.toString().startsWith(dateString)),
    ...poets.filter(p => p.data.date?.toString().startsWith(dateString)),
    ...sites.filter(s => s.data.date?.toString().startsWith(dateString)),
    ...artists.filter(a => a.data.date?.toString().startsWith(dateString)),
    ...artworks.filter(a => a.data.date?.toString().startsWith(dateString)),
    ...talents.filter(t => t.data.date?.toString().startsWith(dateString)),
    ...docs.filter(d => d.data.date?.toString().startsWith(dateString)),
    ...communityVoices.filter(c => c.data.date?.toString().startsWith(dateString)),
    ...profiles.filter(p => p.data.date?.toString().startsWith(dateString)),
  ].length;

  return {
    date: date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }),
    value: count,
  };
});

// Chart data preparation
const chartData = {
  contentOverview: {
    labels: ['Services', 'Resources', 'Events', 'Photos', 'Jobs', 'News'],
    values: [stats.services.total, stats.resources.total, stats.events.total, stats.photos.total, stats.jobs.total, stats.news.total],
  },
  activityTrend: {
    labels: last7DaysTrend.map(d => d.date),
    values: last7DaysTrend.map(d => d.value),
  },
  serviceStatus: {
    labels: ['Active', 'Inactive'],
    values: [stats.services.active, stats.services.total - stats.services.active],
  },
  eventStatus: {
    labels: ['Upcoming', 'Past'],
    values: [stats.events.upcoming, stats.events.past],
  },
  topCategories: {
    labels: topCategories.map(([category]) => category),
    values: topCategories.map(([, count]) => count),
  },
  contentHealth: {
    labels: ['Healthy', 'Missing Images', 'Incomplete Metadata', 'Broken Links'],
    values: [contentHealth.healthyContent, contentHealth.missingImages, contentHealth.incompleteMetadata, contentHealth.brokenLinks],
  },
  artsBreakdown: {
    labels: ['Dancers', 'Poets', 'Artists', 'Artworks', 'Sites'],
    values: [stats.dancers.total, stats.poets.total, stats.artists.total, stats.artworks.total, stats.sites.total],
  },
  resourceCategories: {
    labels: Object.keys(stats.resources.categories),
    values: Object.values(stats.resources.categories)
  },
  skillCategories: {
    labels: Object.keys(stats.profiles.categories).slice(0, 5),
    values: Object.values(stats.profiles.categories).slice(0, 5)
  },
  skillsDistribution: {
    labels: ['Offered', 'Requested'],
    values: [stats.profiles.offered, stats.profiles.requested]
  },
  jobStatus: {
    labels: ['Active', 'Inactive'],
    values: [stats.jobs.active, stats.jobs.inactive]
  }
};

// Prepare all content for the client-side table
const allContent = [
  ...services.map(s => ({ 
    id: s.id,
    slug: s.slug,
    type: 'service', 
    title: s.data.title, 
    description: s.data.description,
    date: s.data.lastUpdated || s.data.date || new Date(),
    status: s.data.status || 'Active',
    category: s.data.category
  })),
  ...profiles.map(p => ({
    id: p.id,
    slug: p.slug,
    type: 'profile',
    title: p.data.name,
    description: p.data.shortDescription,
    date: new Date(), // Profiles don't have a date field in schema, using now
    status: p.data.status || 'Active',
    category: p.data.category,
    urlPrefix: '/skills-exchange'
  })),
  ...resources.map(r => ({
    id: r.id,
    slug: r.slug,
    type: 'resource',
    title: r.data.title,
    description: r.data.description,
    date: r.data.date,
    status: 'Active',
    category: r.data.category
  })),
  ...jobs.map(j => ({
    id: j.id,
    slug: j.slug,
    type: 'job',
    title: j.data.title,
    description: j.data.description,
    date: j.data.posted,
    status: j.data.status,
    category: j.data.category
  })),
  ...events.map(e => ({ 
    id: e.id,
    slug: e.slug,
    type: 'event', 
    title: e.data.title, 
    description: e.data.description,
    date: e.data.date,
    status: new Date(e.data.date) > new Date() ? 'Upcoming' : 'Past',
    category: e.data.category
  })),
  ...photos.map(p => ({ 
    id: p.id,
    slug: p.slug,
    type: 'photo', 
    title: p.data.title, 
    description: p.data.description,
    date: p.data.date,
    status: 'Published',
    category: p.data.album || 'Uncategorized'
  })),
  ...news.map(n => ({ 
    id: n.id,
    slug: n.slug,
    type: 'news', 
    title: n.data.title, 
    description: n.data.description || n.data.excerpt,
    date: n.data.date,
    status: 'Published',
    category: n.data.category
  })),
  ...dancers.map(d => ({ 
    id: d.id,
    slug: d.slug,
    type: 'dancer', 
    title: d.data.title || d.data.name, 
    description: d.data.description || d.data.bio,
    date: d.data.date || new Date(),
    status: 'Active',
    category: 'Arts'
  })),
  ...poets.map(p => ({ 
    id: p.id,
    slug: p.slug,
    type: 'poet', 
    title: p.data.title || p.data.name, 
    description: p.data.description || p.data.bio,
    date: p.data.date || new Date(),
    status: 'Active',
    category: 'Arts'
  })),
  ...sites.map(s => ({ 
    id: s.id,
    slug: s.slug,
    type: 'site', 
    title: s.data.title || s.data.name, 
    description: s.data.description,
    date: s.data.date || new Date(),
    status: 'Active',
    category: 'Places',
    urlPrefix: '/site-register'
  })),
  ...artists.map(a => ({ 
    id: a.id,
    slug: a.slug,
    type: 'artist', 
    title: a.data.title || a.data.name, 
    description: a.data.description || a.data.bio,
    date: a.data.date || new Date(),
    status: 'Active',
    category: 'Arts',
    urlPrefix: '/public-art-catalogue/artist'
  })),
  ...artworks.map(a => ({ 
    id: a.id,
    slug: a.slug,
    type: 'artwork', 
    title: a.data.title, 
    description: a.data.description,
    date: a.data.date || new Date(),
    status: 'Published',
    category: 'Arts',
    urlPrefix: '/public-art-catalogue'
  })),
  ...talents.map(t => ({
    id: t.id,
    slug: t.slug,
    type: 'talent',
    title: t.data.name,
    description: t.data.bio || t.data.description,
    date: t.data.date || new Date(),
    status: t.data.featured ? 'Featured' : 'Active',
    category: t.data.category,
    urlPrefix: '/talents'
  })),
  ...docs.map(d => ({
    id: d.id,
    slug: d.slug,
    type: 'document',
    title: d.data.title,
    description: d.data.description,
    date: d.data.date || new Date(),
    status: 'Published',
    category: d.data.category,
    urlPrefix: '/docs'
  })),
  ...communityVoices.map(c => ({
    id: c.id,
    slug: c.slug,
    type: 'voice',
    title: c.data.title,
    description: c.data.excerpt || c.data.description,
    date: c.data.date || new Date(),
    status: 'Published',
    category: c.data.category || 'Community',
    urlPrefix: '/community-voices'
  }))
].sort((a, b) => new Date(b.date) - new Date(a.date));

const tabClass = "flex-1 py-2.5 text-sm font-medium rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-all duration-200 ease-in-out";
const activeTabClass = "bg-white text-primary-600 shadow-sm ring-1 ring-black/5";
const inactiveTabClass = "text-gray-500 hover:text-gray-700 hover:bg-gray-50";

---

<MainLayout title="Dashboard - Dzaleka Online Services" description="Comprehensive dashboard for managing Dzaleka Online Services platform">
  <!-- Load Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

  <style>
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
      animation: fadeInUp 0.6s ease-out forwards;
    }
    .animation-delay-100 { animation-delay: 100ms; }
    .animation-delay-200 { animation-delay: 200ms; }
    .animation-delay-300 { animation-delay: 300ms; }
    
    /* Custom Scrollbar */
    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background-color: #CBD5E1;
      border-radius: 3px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background-color: #94A3B8;
    }
  </style>

  <div class="min-h-screen bg-gray-50/50">
    <!-- Header -->
    <!-- Header with Hero Background -->
    <div class="relative bg-gray-900 pb-16 sm:pb-24 md:pb-32 overflow-hidden">
      <!-- Hero Image -->
      <div class="absolute inset-0">
        <img
          class="w-full h-full object-cover"
          src="/images/dzaleka-hero.jpeg"
          alt="Dzaleka Camp View"
        />
        <div class="absolute inset-0 bg-gray-900 mix-blend-multiply opacity-80"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/40"></div>
      </div>

      <!-- Header Content -->
      <div class="relative z-10">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between h-auto sm:h-24 md:h-32 py-6 sm:py-0 gap-4 sm:gap-0">
            <div>
              <h1 class="text-2xl sm:text-3xl font-bold text-white">Dashboard</h1>
              <p class="text-xs sm:text-sm text-gray-300 mt-0.5 sm:mt-1">Welcome back! Here's what's happening.</p>
            </div>

            <!-- Quick Actions -->
            <div class="flex items-center space-x-2 sm:space-x-3 w-full sm:w-auto">
              <button
                id="refreshDashboard"
                class="inline-flex items-center justify-center px-2 sm:px-3 py-1.5 border border-transparent rounded-lg text-xs font-medium text-white bg-white/10 hover:bg-white/20 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white/50 transition-colors backdrop-blur-sm flex-1 sm:flex-none"
                aria-label="Refresh dashboard data"
              >
                <svg class="w-3.5 h-3.5 sm:mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span class="hidden sm:inline">Refresh</span>
              </button>
              <a
                href="/staff"
                class="inline-flex items-center justify-center px-2 sm:px-3 py-1.5 border border-transparent rounded-lg text-xs font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors shadow-lg flex-1 sm:flex-none"
              >
                <svg class="w-3.5 h-3.5 sm:mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span class="hidden sm:inline">Staff Portal</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content Container (moved up to overlap hero) -->
    <!-- Main Content Container (moved up to overlap hero) -->
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 -mt-12 sm:-mt-16 md:-mt-24 relative z-20">
      <!-- Tab Navigation Card -->
      <div class="bg-white/80 backdrop-blur-md rounded-xl sm:rounded-2xl shadow-xl border border-white/20 mb-6 sm:mb-8 p-1.5 sm:p-2">
        <!-- Tab Navigation -->
        <div class="flex p-1 space-x-1 bg-gray-100/50 rounded-xl overflow-x-auto custom-scrollbar" role="tablist" aria-label="Dashboard sections">
          <button
            class="tab-button flex-shrink-0 min-w-[120px] sm:flex-1 py-2.5 px-4 text-xs sm:text-sm font-medium rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-all duration-200 ease-in-out bg-white text-primary-600 shadow-sm ring-1 ring-black/5"
            data-tab="overview"
            role="tab"
            aria-selected="true"
            aria-controls="overview-panel"
          >
            <div class="flex items-center justify-center">
              <svg class="w-4 h-4 sm:mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
              <span class="hidden sm:inline">Overview</span>
            </div>
          </button>
          <button
            class="tab-button flex-shrink-0 min-w-[120px] sm:flex-1 py-2.5 px-4 text-xs sm:text-sm font-medium rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-all duration-200 ease-in-out text-gray-500 hover:text-gray-700 hover:bg-gray-50"
            data-tab="analytics"
            role="tab"
            aria-selected="false"
            aria-controls="analytics-panel"
          >
            <div class="flex items-center justify-center">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
              Analytics
            </div>
          </button>
          <button
            class="tab-button flex-shrink-0 min-w-[120px] sm:flex-1 py-2.5 px-4 text-xs sm:text-sm font-medium rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 transition-all duration-200 ease-in-out text-gray-500 hover:text-gray-700 hover:bg-gray-50"
            data-tab="content"
            role="tab"
            aria-selected="false"
            aria-controls="content-panel"
          >
            <div class="flex items-center justify-center">
