              <div class="text-sm font-medium text-gray-900 max-w-xs truncate" title="${item.title}">${item.title}</div>
              <div class="text-sm text-gray-500">${item.category || item.type}</div>
            </div>
          </div>
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${
            item.type === 'service' ? 'bg-blue-100 text-blue-800' :
            item.type === 'resource' ? 'bg-indigo-100 text-indigo-800' :
            item.type === 'event' ? 'bg-purple-100 text-purple-800' :
            item.type === 'photo' ? 'bg-pink-100 text-pink-800' :
            item.type === 'job' ? 'bg-yellow-100 text-yellow-800' :
            'bg-green-100 text-green-800'
          }">
            ${item.type.charAt(0).toUpperCase() + item.type.slice(1)}
          </span>
        </td>
        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
          ${new Date(item.date).toLocaleDateString()}
        </td>
        <td class="px-6 py-4 whitespace-nowrap">
          <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${
            item.status === 'Active' || item.status === 'Published' || item.status === 'open' || item.status === 'Upcoming' ? 'bg-green-100 text-green-800' :
            item.status === 'Past' || item.status === 'closed' ? 'bg-gray-100 text-gray-800' :
            'bg-yellow-100 text-yellow-800'
          }">
            ${item.status}
