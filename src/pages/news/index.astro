---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import NewsCard from '../../components/NewsCard.astro';

const allNews = await getCollection('news');
const sortedNews = allNews.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryMeta = {
  'business-spotlight': {
    title: 'Business spotlights',
    description: 'Profiles, updates, and stories from local enterprises.',
    href: '/news/category/business-spotlight'
  },
  announcement: {
    title: 'Announcements',
    description: 'Important notices and time-sensitive updates.',
    href: '/news/category/announcement'
  },
  'success-story': {
    title: 'Success stories',
    description: 'Achievements and milestones from the community.',
    href: '/news/category/success-story'
  },
  'business-guide': {
    title: 'Business guides',
    description: 'Practical information for business owners and entrepreneurs.',
    href: '/news/category/business-guide'
  },
  news: {
    title: 'Community updates',
    description: 'General developments, programmes, and local news.',
    href: '/news/category/news'
  }
};

const categoryGroups = Object.entries(categoryMeta)
  .map(([key, meta]) => ({
    key,
    ...meta,
    items: sortedNews.filter((item) => item.data.category === key)
  }))
  .filter((group) => group.items.length > 0);

const featuredNews = sortedNews.filter((item) => item.data.featured);
const leadStory = featuredNews[0] || sortedNews[0];
const secondaryStories = sortedNews.filter((item) => item.id !== leadStory?.id).slice(0, 4);
const latestStories = sortedNews.slice(0, 9);

const seo = {
  title: 'News & Updates',
  description: 'Read community news, announcements, business stories, and local updates from Dzaleka Online Services.',
  type: 'website',
  canonical: 'https://services.dzaleka.com/news',
  openGraph: {
    title: 'News & Updates | Dzaleka Online Services',
    description: 'Read community news, announcements, business stories, and local updates from Dzaleka Online Services.',
    type: 'website',
    site_name: 'Dzaleka Online Services',
    locale: 'en_US',
    url: 'https://services.dzaleka.com/news',
    image: {
      url: 'https://services.dzaleka.com/images/dzaleka-hero.jpeg',
      width: 1200,
      height: 630,
      alt: 'Dzaleka Online Services News'
    }
  },
  twitter: {
    card: 'summary_large_image',
    title: 'News & Updates | Dzaleka Online Services',
    description: 'Read community news, announcements, business stories, and local updates from Dzaleka Online Services.',
    image: 'https://services.dzaleka.com/images/dzaleka-hero.jpeg'
  }
};

const newsStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'News & Updates',
  description: seo.description,
  url: 'https://services.dzaleka.com/news',
  publisher: {
    '@type': 'Organization',
    name: 'Dzaleka Online Services',
    logo: {
      '@type': 'ImageObject',
      url: 'https://services.dzaleka.com/images/dzaleka-digital-heritage.png'
    }
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: sortedNews.slice(0, 8).map((news, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Article',
        headline: news.data.title,
        description: news.data.description,
        datePublished: news.data.date.toISOString(),
        url: `https://services.dzaleka.com/news/${news.id}`
      }
    }))
  }
};

const formattedLatestDate = sortedNews[0]
  ? new Date(sortedNews[0].data.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  : null;
---

<MainLayout
  title={seo.title}
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  robots="index, follow, max-image-preview:large"
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(newsStructuredData)} />

  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">News</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">News & Updates</h1>
        <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">
          Announcements, community updates, business stories, and practical guides from Dzaleka Online Services.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-slate-600">
        <span><span class="font-semibold text-slate-900">{sortedNews.length}</span> articles</span>
        <span><span class="font-semibold text-slate-900">{categoryGroups.length}</span> categories</span>
        <span>Latest update: <span class="font-semibold text-slate-900">{formattedLatestDate || 'No articles yet'}</span></span>
      </div>

    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    {leadStory && (
      <section class="mb-12 grid gap-8 lg:grid-cols-[minmax(0,1.4fr)_320px]">
        <div>
          <!-- The lead story card renders an h3. This h2 gives it a section to
               sit under so the outline does not jump from h1 to h3. Hidden
               because the card's own headline is the visible label. -->
          <h2 class="sr-only">Featured story</h2>
          <NewsCard news={leadStory} featured={leadStory.data.featured} large={true} />
        </div>

        <aside class="border-t border-slate-200 pt-1 lg:border-t-0 lg:border-l lg:pl-8">
          <div class="flex items-center justify-between gap-4 pb-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">Latest</p>
              <h2 class="mt-2 text-xl font-semibold text-slate-900">Recent headlines</h2>
            </div>
            <a href="/search?q=news" class="text-sm font-medium text-primary-700 hover:text-primary-800">Search</a>
          </div>

          <div class="space-y-4">
            {secondaryStories.map((story) => (
              <a href={`/news/${story.id}`} class="block border-b border-slate-200 pb-4 last:border-b-0 last:pb-0">
                <div class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">
                  {new Date(story.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </div>
                <h3 class="mt-2 text-base font-semibold text-slate-900">{story.data.title}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600 line-clamp-2">{story.data.description}</p>
              </a>
            ))}
          </div>
        </aside>
      </section>
    )}

    <section class="mb-12">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Browse</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900">Categories</h2>
        </div>
        <a href="/search?q=news" class="text-sm font-medium text-primary-700 hover:text-primary-800">Browse all news in search</a>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {categoryGroups.map((group) => (
          <a href={group.href} class="rounded-lg border border-slate-200 bg-white p-5 transition-colors hover:border-slate-300 hover:bg-slate-50">
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-base font-semibold text-slate-900">{group.title}</h3>
              <span class="text-sm text-slate-500">{group.items.length}</span>
            </div>
            <p class="mt-3 text-sm leading-6 text-slate-600">{group.description}</p>
            <p class="mt-4 text-sm font-medium text-primary-700">Browse category</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mb-12">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Recent articles</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-900">Latest news</h2>
      </div>

      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {latestStories.map((news) => (
          <NewsCard news={news} featured={news.data.featured} />
        ))}
      </div>
    </section>

    <div class="space-y-12">
      {categoryGroups.map((group) => (
        <section class="border-t border-slate-200 pt-8">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <h2 class="text-2xl font-semibold text-slate-900">{group.title}</h2>
              <p class="mt-2 text-slate-600">{group.description}</p>
            </div>
            <a href={group.href} class="text-sm font-medium text-primary-700 hover:text-primary-800">
              View all
            </a>
          </div>

          <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {group.items.slice(0, 3).map((news) => (
              <NewsCard news={news} featured={news.data.featured} />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</MainLayout>
