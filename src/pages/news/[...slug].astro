---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import NewsCard from '../../components/NewsCard.astro';

export async function getStaticPaths() {
  const newsEntries = await getCollection('news');
  return newsEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allNews = await getCollection('news');
const relatedNews = allNews
  .filter((item) => item.id !== entry.id)
  .sort((a, b) => {
    const aMatch = a.data.category === entry.data.category ? 1 : 0;
    const bMatch = b.data.category === entry.data.category ? 1 : 0;
    if (aMatch !== bMatch) return bMatch - aMatch;
    return b.data.date.valueOf() - a.data.date.valueOf();
  })
  .slice(0, 3);

const formattedDate = new Date(entry.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const categoryLabels = {
  'business-spotlight': 'Business spotlight',
  announcement: 'Announcement',
  'success-story': 'Success story',
  'business-guide': 'Business guide',
  news: 'Community update'
};

const seo = {
  title: `${entry.data.title} | Dzaleka Online Services`,
  description: entry.data.description,
  type: 'article',
  canonical: `https://services.dzaleka.com/news/${entry.id}`,
  openGraph: {
    title: entry.data.title,
    description: entry.data.description,
    type: 'article',
    site_name: 'Dzaleka Online Services',
    locale: 'en_US',
    url: `https://services.dzaleka.com/news/${entry.id}`,
    image: entry.data.image ? {
      url: entry.data.image.startsWith('http') ? entry.data.image : `https://services.dzaleka.com${entry.data.image}`,
      width: 1200,
      height: 630,
      alt: entry.data.title,
      type: 'image/jpeg'
    } : {
      url: 'https://services.dzaleka.com/images/dzaleka-hero.jpeg',
      width: 1200,
      height: 630,
      alt: 'Dzaleka Online Services',
      type: 'image/jpeg'
    },
    article: {
      publishedTime: entry.data.date.toISOString(),
      modifiedTime: entry.data.updated ? entry.data.updated.toISOString() : entry.data.date.toISOString(),
      tags: entry.data.tags || [],
      section: categoryLabels[entry.data.category] || 'News'
    }
  },
  twitter: {
    card: 'summary_large_image',
    title: entry.data.title,
    description: entry.data.description,
    image: entry.data.image ? (
      entry.data.image.startsWith('http') ? entry.data.image : `https://services.dzaleka.com${entry.data.image}`
    ) : 'https://services.dzaleka.com/images/dzaleka-hero.jpeg',
    creator: entry.data.author ? `@${entry.data.author.replace(/\s+/g, '')}` : '@DzalekaConnect'
  }
};

const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: entry.data.title,
  description: entry.data.description,
  image: {
    '@type': 'ImageObject',
    url: entry.data.image ? (
      entry.data.image.startsWith('http') ? entry.data.image : `https://services.dzaleka.com${entry.data.image}`
    ) : 'https://services.dzaleka.com/images/dzaleka-hero.jpeg',
    width: 1200,
    height: 630,
    acquireLicensePage: 'https://services.dzaleka.com/contact',
    creditText: entry.data.author ? `Photo by ${entry.data.author}` : 'Dzaleka Online Services',
    copyrightNotice: `© ${new Date().getFullYear()} Dzaleka Online Services. All rights reserved.`
  },
  datePublished: entry.data.date.toISOString(),
  dateModified: entry.data.updated ? entry.data.updated.toISOString() : entry.data.date.toISOString(),
  author: {
    '@type': 'Person',
    name: entry.data.author || 'Dzaleka Online Services',
    url: 'https://services.dzaleka.com'
  },
  publisher: {
    '@type': 'Organization',
    name: 'Dzaleka Online Services',
    logo: {
      '@type': 'ImageObject',
      url: 'https://services.dzaleka.com/images/dzaleka-digital-heritage.png',
      width: '200',
      height: '200'
    },
    url: 'https://services.dzaleka.com'
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://services.dzaleka.com/news/${entry.id}`
  },
  articleSection: categoryLabels[entry.data.category] || 'News',
  keywords: entry.data.tags ? entry.data.tags.join(', ') : undefined,
  inLanguage: 'en-US',
  isAccessibleForFree: true
};
---

<MainLayout
  title={seo.title}
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />

  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <a href="/news" class="inline-flex items-center text-sm font-medium text-slate-600 hover:text-primary-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to news
      </a>

      <div class="mt-6">
        <div class="flex flex-wrap items-center gap-3 text-sm">
          <span class="font-semibold uppercase tracking-[0.12em] text-slate-500">
            {categoryLabels[entry.data.category]}
          </span>
          {entry.data.featured && (
            <span class="font-semibold uppercase tracking-[0.12em] text-primary-700">
              Featured
            </span>
          )}
        </div>

        <h1 class="mt-5 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">{entry.data.title}</h1>
        <p class="mt-5 text-lg leading-8 text-slate-600">{entry.data.description}</p>

        <div class="mt-6 flex flex-wrap items-center gap-2 text-sm text-slate-500">
          <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
          {entry.data.author && (
            <>
              <span aria-hidden="true">•</span>
              <span>{entry.data.author}</span>
            </>
          )}
        </div>
      </div>
    </div>
  </section>

  <article class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    {entry.data.image && (
      <div class="mb-10 overflow-hidden border border-slate-200">
        <img
          src={entry.data.image}
          alt={entry.data.title}
          class="h-full w-full object-cover"
          loading="eager"
        />
      </div>
    )}

    <div class="max-w-none">
      <div class="prose prose-lg max-w-none prose-headings:text-slate-900 prose-p:text-slate-700 prose-li:text-slate-700 prose-a:text-primary-700">
        <Content />
      </div>

      {entry.data.businessName && (
        <div class="mt-10 border-t border-slate-200 pt-6">
          <h2 class="text-2xl font-semibold text-slate-900">Business information</h2>
          <div class="mt-5 space-y-3 text-slate-700">
            <p><span class="font-semibold text-slate-900">Business:</span> {entry.data.businessName}</p>
            {entry.data.businessOwner && (
              <p><span class="font-semibold text-slate-900">Owner:</span> {entry.data.businessOwner}</p>
            )}
          </div>

          {entry.data.contactInfo && (
            <div class="mt-6 border-t border-slate-200 pt-5 space-y-3">
              <h3 class="font-semibold text-slate-900">Contact</h3>
              {entry.data.contactInfo.email && (
                <a href={`mailto:${entry.data.contactInfo.email}`} class="block text-primary-700 hover:underline">
                  {entry.data.contactInfo.email}
                </a>
              )}
              {entry.data.contactInfo.phone && (
                <a href={`tel:${entry.data.contactInfo.phone}`} class="block text-primary-700 hover:underline">
                  {entry.data.contactInfo.phone}
                </a>
              )}
              {entry.data.contactInfo.website && (
                <a href={entry.data.contactInfo.website} target="_blank" rel="noopener noreferrer" class="block text-primary-700 hover:underline">
                  Visit website
                </a>
              )}
            </div>
          )}
        </div>
      )}
    </div>

    {entry.data.tags && entry.data.tags.length > 0 && (
      <section class="mt-12 border-t border-slate-200 pt-8">
        <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Topics</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-900">Tags</h2>
        <div class="mt-5 flex flex-wrap gap-2">
          {entry.data.tags.map((tag) => (
            <span class="rounded-md border border-slate-200 px-3 py-1 text-sm text-slate-700">
              #{tag}
            </span>
          ))}
        </div>
      </section>
    )}

    {relatedNews.length > 0 && (
      <section class="mt-12 border-t border-slate-200 pt-8">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Continue reading</p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-900">More news</h2>
          </div>
          <a href="/news" class="text-sm font-medium text-primary-700 hover:text-primary-800">All news</a>
        </div>

        <div class="mt-6 grid gap-6 md:grid-cols-3">
          {relatedNews.map((item) => (
            <NewsCard news={item} featured={item.data.featured} />
          ))}
        </div>
      </section>
    )}
  </article>
</MainLayout>
