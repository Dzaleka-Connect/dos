---
import { getCollection } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';
import NewsCard from '../../../components/NewsCard.astro';

export async function getStaticPaths() {
  const categories = ['news', 'business-spotlight', 'announcement', 'success-story', 'business-guide'];
  return categories.map((category) => ({
    params: { category },
    props: { category }
  }));
}

const { category } = Astro.params;

const allNews = await getCollection('news');
const categoryNews = allNews
  .filter((item) => item.data.category === category)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categoryMeta = {
  'business-spotlight': {
    title: 'Business spotlights',
    description: 'Profiles, updates, and stories from local enterprises.'
  },
  announcement: {
    title: 'Announcements',
    description: 'Important notices and time-sensitive updates.'
  },
  'success-story': {
    title: 'Success stories',
    description: 'Achievements and milestones from the community.'
  },
  'business-guide': {
    title: 'Business guides',
    description: 'Practical information for business owners and entrepreneurs.'
  },
  news: {
    title: 'Community updates',
    description: 'General developments, programmes, and local news.'
  }
};

const selectedCategory = categoryMeta[category];

const seo = {
  title: `${selectedCategory.title} | News & Updates`,
  description: `Browse ${selectedCategory.title.toLowerCase()} published by Dzaleka Online Services.`,
  type: 'website',
  canonical: `https://services.dzaleka.com/news/category/${category}`,
  openGraph: {
    title: `${selectedCategory.title} | News & Updates`,
    description: `Browse ${selectedCategory.title.toLowerCase()} published by Dzaleka Online Services.`,
    type: 'website',
    site_name: 'Dzaleka Online Services',
    locale: 'en_US',
    url: `https://services.dzaleka.com/news/category/${category}`,
    image: {
      url: 'https://services.dzaleka.com/images/dzaleka-hero.jpeg',
      width: 1200,
      height: 630,
      alt: 'Dzaleka Online Services News'
    }
  },
  twitter: {
    card: 'summary_large_image',
    title: `${selectedCategory.title} | News & Updates`,
    description: `Browse ${selectedCategory.title.toLowerCase()} published by Dzaleka Online Services.`,
    image: 'https://services.dzaleka.com/images/dzaleka-hero.jpeg'
  }
};

const categoryStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${selectedCategory.title} | News & Updates`,
  description: seo.description,
  url: `https://services.dzaleka.com/news/category/${category}`,
  publisher: {
    '@type': 'Organization',
    name: 'Dzaleka Online Services',
    logo: {
      '@type': 'ImageObject',
      url: 'https://services.dzaleka.com/images/dzaleka-digital-heritage.png'
    }
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: categoryNews.map((news, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Article',
        headline: news.data.title,
        description: news.data.description,
        datePublished: news.data.date.toISOString(),
        url: `https://services.dzaleka.com/news/${news.id}`
      }
    }))
  }
};
---

<MainLayout
  title={seo.title}
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  robots="index, follow, max-image-preview:large"
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(categoryStructuredData)} />

  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <a href="/news" class="inline-flex items-center text-sm font-medium text-slate-600 hover:text-primary-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to news
      </a>

      <div class="mt-6 max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Category</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">{selectedCategory.title}</h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">{selectedCategory.description}</p>
        <p class="mt-6 text-sm text-slate-600">{categoryNews.length} article{categoryNews.length === 1 ? '' : 's'}</p>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    {categoryNews.length > 0 ? (
      <>
        <div class="mb-8 flex items-center justify-between gap-4 border-b border-slate-200 pb-4">
          <p class="text-sm text-slate-600">Showing the most recent articles in this category.</p>
          <a href="/news" class="text-sm font-medium text-primary-700 hover:text-primary-800">All news</a>
        </div>

        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {categoryNews.map((news) => (
            <NewsCard news={news} featured={news.data.featured} />
          ))}
        </div>
      </>
    ) : (
      <div class="border border-slate-200 bg-white px-6 py-12 text-center">
        <h2 class="text-2xl font-semibold text-slate-900">No articles found</h2>
        <p class="mt-3 text-slate-600">There are no articles in this category yet.</p>
      </div>
    )}
  </div>
</MainLayout>
