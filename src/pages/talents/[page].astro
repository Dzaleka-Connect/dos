---
import { getEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import TalentDirectory from '../../components/culture/TalentDirectory.astro';
export async function getStaticPaths() {
  const data = await getEntry('talents', 'data/talents');
  return Array.from({ length: Math.max(1, Math.ceil((data?.data.talents.length || 0) / 6)) }, (_, i) => ({ params: { page: String(i + 1) } }));
}
const currentPage = Number(Astro.params.page);
---
<MainLayout title={`Dzaleka talents — page ${currentPage}`} description="Browse professional and creative profiles from Dzaleka." canonical={`https://services.dzaleka.com/talents${currentPage > 1 ? `/${currentPage}` : ''}`}><TalentDirectory currentPage={currentPage} /></MainLayout>
