---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const voices = await getCollection('community-voices');
  return voices.map(voice => ({
    params: { slug: voice.id },
    props: { voice },
  }));
}

const { voice } = Astro.props;
const { Content } = await render(voice);

// Get related stories (same category)
const allVoices = await getCollection('community-voices');
const relatedStories = allVoices
  .filter(v => v.data.category === voice.data.category && v.id !== voice.id)
  .slice(0, 3);

// Create SEO metadata
const seo = {
  title: `${voice.data.title} - Community Voice | Dzaleka Online Services`,
  description: voice.data.excerpt,
  type: "article",
  canonical: `https://services.dzaleka.com/community-voices/${voice.id}`,
  openGraph: {
    title: voice.data.title,
    description: voice.data.excerpt,
    type: "article",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/community-voices/${voice.id}`,
    image: voice.data.image ? {
      url: voice.data.image.startsWith('http') ? voice.data.image : `https://services.dzaleka.com${voice.data.image}`,
      width: 1200,
      height: 630,
      alt: voice.data.title,
      type: "image/jpeg"
    } : {
      url: "https://services.dzaleka.com/images/placeholder-voice.jpg",
      width: 1200,
      height: 630,
      alt: "Dzaleka Community Voices",
      type: "image/jpeg"
    },
    article: {
      publishedTime: voice.data.date instanceof Date
        ? voice.data.date.toISOString()
        : new Date(voice.data.date).toISOString(),
      author: voice.data.author,
      tags: voice.data.tags || [],
      section: voice.data.category
    }
  },
  twitter: {
    card: "summary_large_image",
    title: `${voice.data.title} | Community Voice`,
    description: voice.data.excerpt,
    image: voice.data.image ? (
      voice.data.image.startsWith('http') ? voice.data.image : `https://services.dzaleka.com${voice.data.image}`
    ) : "https://services.dzaleka.com/images/placeholder-voice.jpg",
    creator: "@DzalekaConnect"
  }
};

const defaultImageMetadata = {
  "license": "https://services.dzaleka.com/terms",
  "acquireLicensePage": "https://services.dzaleka.com/contact",
  "creator": {
    "@type": "Organization",
    "name": "Dzaleka Online Services"
  },
  "creditText": "Dzaleka Online Services",
  "copyrightNotice": `© ${new Date().getFullYear()} Dzaleka Online Services`
};

// Create structured data
const articleStructuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": voice.data.title,
  "description": voice.data.excerpt,
  "image": {
    "@type": "ImageObject",
    "url": voice.data.image ? (
      voice.data.image.startsWith('http') ? voice.data.image : `https://services.dzaleka.com${voice.data.image}`
    ) : "https://services.dzaleka.com/images/placeholder-voice.jpg",
    "width": 1200,
    "height": 630,
    ...defaultImageMetadata,
    "creditText": `Photo by ${voice.data.author}`,
    "copyrightNotice": `© ${new Date().getFullYear()} Dzaleka Online Services. All rights reserved.`
  },
  "datePublished": voice.data.date instanceof Date
    ? voice.data.date.toISOString()
    : new Date(voice.data.date).toISOString(),
  "dateModified": voice.data.date instanceof Date
    ? voice.data.date.toISOString()
    : new Date(voice.data.date).toISOString(),
  "author": {
    "@type": "Person",
    "name": voice.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Dzaleka Online Services",
    "logo": {
      "@type": "ImageObject",
      "url": "https://services.dzaleka.com/images/dzaleka-digital-heritage.png",
      "width": "200",
      "height": "200",
      ...defaultImageMetadata
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://services.dzaleka.com/community-voices/${voice.id}`
  },
  "keywords": voice.data.tags ? voice.data.tags.join(", ") : undefined,
  "articleSection": voice.data.category
};
---

<MainLayout
  title={seo.title}
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleStructuredData)} />

  <div class="bg-gradient-to-b from-gray-50 to-white min-h-screen pb-16">
    <section class="border-b border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
        <a href="/community-voice" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Community voice</a>
        <p class="mt-5 text-sm text-slate-600">{voice.data.category} · <time datetime={new Date(voice.data.date).toISOString()}>{new Date(voice.data.date).toLocaleDateString('en-GB', {day:'numeric',month:'long',year:'numeric'})}</time></p>
        <h1 class="mt-3 text-slate-900">{voice.data.title}</h1>
        <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">{voice.data.excerpt}</p>
        <p class="mt-5 text-slate-700">By {voice.data.author}</p>
      </div>
    </section>

    <!-- Content -->
    <article class="max-w-4xl mx-auto px-4 py-12">
      {voice.data.image && <img src={voice.data.image} alt={voice.data.title} class="mb-8 max-h-[32rem] w-full rounded object-contain" />}
      <div class="prose prose-primary max-w-none">
        <Content />
      </div>

      {voice.data.tags && voice.data.tags.length > 0 && (
        <div class="mt-8 flex flex-wrap gap-2">
          {voice.data.tags.map(tag => (
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </article>

    <!-- Related Stories -->
    {relatedStories.length > 0 && (
      <section class="max-w-4xl mx-auto px-4 py-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Related Stories</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {relatedStories.map(story => (
            <a
              href={`/community-voices/${story.id}`}
              class="group bg-white rounded border border-gray-200 overflow-hidden transition-colors duration-200 hover:border-gray-300"
            >
              <div class="aspect-w-16 aspect-h-9 bg-gray-200">
                <img
                  src={story.data.image || '/images/placeholder-voice.jpg'}
                  alt={story.data.title}
                  class="w-full h-full object-cover transform transition-transform duration-500"
                />
              </div>
              <div class="p-6">
                <h3 class="font-semibold text-gray-900 mb-2 group-hover:text-slate-700 transition-colors">
                  {story.data.title}
                </h3>
                <p class="text-sm text-gray-600 line-clamp-2">{story.data.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Navigation -->
    <div class="max-w-4xl mx-auto px-4">
      <a
        href="/community-voice"
        class="inline-flex items-center text-slate-700 hover:text-slate-700 font-medium group"
      >
        <svg class="w-5 h-5 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Community Voice
      </a>
    </div>
  </div>
</MainLayout>

<style>
  .bg-grid-white {
    background-image: linear-gradient(to right, rgba(255, 255, 255, 0.1) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
  }

  .animate-fade-in {
    opacity: 0;
    animation: fadeIn 1s ease-out forwards;
  }

  .animate-fade-in-up {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 1s ease-out forwards;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.1;
    }
    50% {
      opacity: 0.2;
    }
  }

  /* Enhanced Typography for Markdown Content */
  :global(.prose) {
    max-width: none;
  }

  :global(.prose h2) {
    color: #1a202c;
    font-weight: 700;
    font-size: 1.875em;
    margin-top: 2em;
    margin-bottom: 1em;
    line-height: 1.3;
  }

  :global(.prose h3) {
    color: #1a202c;
    font-weight: 600;
    font-size: 1.5em;
    margin-top: 1.6em;
    margin-bottom: 0.6em;
    line-height: 1.3;
  }

  :global(.prose p) {
    margin-top: 1.25em;
    margin-bottom: 1.25em;
    line-height: 1.8;
  }

  :global(.prose strong) {
    color: #1a202c;
    font-weight: 600;
  }

  :global(.prose a) {
    color: #2563eb;
    text-decoration: underline;
    font-weight: 500;
    transition: color 0.2s;
  }

  :global(.prose a:hover) {
    color: #1d4ed8;
  }

  :global(.prose blockquote) {
    font-style: italic;
    color: #4a5568;
    border-left-color: #2563eb;
    border-left-width: 0.25rem;
    margin: 2em 0;
    padding-left: 1.5em;
  }

  :global(.prose ul) {
    margin-top: 1.25em;
    margin-bottom: 1.25em;
    list-style-type: disc;
    padding-left: 1.625em;
  }

  :global(.prose li) {
    margin-top: 0.5em;
    margin-bottom: 0.5em;
  }

  :global(.prose img) {
    margin-top: 2em;
    margin-bottom: 2em;
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  :global(.prose code) {
    color: #2563eb;
    background-color: #f1f5f9;
    padding: 0.2em 0.4em;
    border-radius: 0.25em;
    font-size: 0.875em;
  }
</style>
