<style>
  /* Player animations */
  /* Smooth transitions */
  .transition-all {
    transition-property: all;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }

  /* Custom volume slider styling */
  input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    height: 4px;
    background: #e5e7eb;
    border-radius: 2px;
    outline: none;
  }

  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    background: #4f46e5;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  input[type="range"]::-webkit-slider-thumb:hover {
    transform: scale(1.2);
  }

  input[type="range"]::-moz-range-thumb {
    width: 12px;
    height: 12px;
    background: #4f46e5;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
  }

  input[type="range"]::-moz-range-thumb:hover {
    transform: scale(1.2);
  }
</style>

<script>
  // Audio player functionality
  let audioPlayer = null;
  const playButton = document.getElementById('playButton');
  const nowPlaying = document.getElementById('nowPlaying');
  const artistInfo = document.getElementById('artistInfo');
  const volumeSlider = document.getElementById('volumeSlider');
  const volumeValue = document.getElementById('volumeValue');
  const muteButton = document.getElementById('muteButton');
  let previousVolume = 100;

  function initializePlayer() {
    const streamUrl = playButton.getAttribute('stream');
    audioPlayer = new Audio(streamUrl);
    
    // Set initial volume
    audioPlayer.volume = volumeSlider.value / 100;
    
    audioPlayer.addEventListener('playing', () => {
      playButton.innerHTML = `
        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
      `;
      playButton.classList.add('playing');
      updateNowPlaying();
    });

    audioPlayer.addEventListener('pause', () => {
      playButton.innerHTML = `
        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"/>
        </svg>
      `;
      playButton.classList.remove('playing');
      nowPlaying.textContent = "Yetu Radio";
      artistInfo.textContent = "Click to start listening";
    });

    audioPlayer.addEventListener('error', () => {
      playButton.innerHTML = `
        <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"/>
        </svg>
      `;
      playButton.classList.remove('playing');
      nowPlaying.textContent = "Yetu Radio";
      artistInfo.textContent = "Click to start listening";
    });
  }

  playButton.addEventListener('click', () => {
    if (!audioPlayer) {
      initializePlayer();
    }

    if (audioPlayer.paused) {
      const playPromise = audioPlayer.play();
      if (playPromise !== undefined) {
        playPromise.catch(error => {
          console.error("Stream playback failed:", error);
          // Reset UI
          playButton.classList.remove('playing');
           playButton.innerHTML = `
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z"/>
            </svg>
          `;
          artistInfo.textContent = "Stream currently unavailable (Offline)";
          artistInfo.classList.add('text-red-500');
        });
      }
    } else {
      audioPlayer.pause();
    }
  });

  // Volume control
  volumeSlider.addEventListener('input', (e) => {
    const volume = e.target.value;
    if (audioPlayer) {
      audioPlayer.volume = volume / 100;
    }
    volumeValue.textContent = `${volume}%`;
    
    // Update mute button icon
    if (volume > 0) {
      muteButton.innerHTML = `
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15.536a5 5 0 001.414 1.414m2.828-9.9a9 9 0 012.728-2.728" />
        </svg>
      `;
    } else {
      muteButton.innerHTML = `
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
        </svg>
      `;
    }
  });

  // Mute toggle
  muteButton.addEventListener('click', () => {
    if (!audioPlayer) return;
    
    if (audioPlayer.volume > 0) {
      previousVolume = audioPlayer.volume * 100;
      audioPlayer.volume = 0;
      volumeSlider.value = 0;
      volumeValue.textContent = '0%';
      muteButton.innerHTML = `
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" />
        </svg>
      `;
    } else {
      audioPlayer.volume = previousVolume / 100;
      volumeSlider.value = previousVolume;
      volumeValue.textContent = `${previousVolume}%`;
      muteButton.innerHTML = `
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15.536a5 5 0 001.414 1.414m2.828-9.9a9 9 0 012.728-2.728" />
        </svg>
      `;
    }
  });

  // Update now playing info
  function updateNowPlaying() {
    const currentTime = new Date();
    const hour = currentTime.getHours();
    
    // Define programming schedule based on time of day
    let programInfo = {
      title: "Yetu Radio",
      artist: "Live from Dzaleka Refugee Camp"
    };

    // Morning programming (6:00 - 12:00)
    if (hour >= 6 && hour < 12) {
      programInfo = {
        title: "Morning Show",
        artist: "News, Music & Community Updates"
      };
    }
    // Afternoon programming (12:00 - 18:00)
    else if (hour >= 12 && hour < 18) {
      programInfo = {
        title: "Afternoon Mix",
        artist: "Music & Entertainment"
      };
    }
    // Evening programming (18:00 - 22:00)
    else if (hour >= 18 && hour < 22) {
      programInfo = {
        title: "Evening Program",
        artist: "Music & Cultural Shows"
      };
    }
    // Late night programming (22:00 - 6:00)
    else {
      programInfo = {
        title: "Late Night Radio",
        artist: "Music & Special Programs"
      };
    }

    nowPlaying.textContent = programInfo.title;
    artistInfo.textContent = programInfo.artist;
  }

  // Update now playing info every hour
  setInterval(updateNowPlaying, 3600000);
  updateNowPlaying(); // Initial update

  // Favorite button functionality
  const favoriteButton = document.getElementById('favoriteButton');
  let isFavorited = false;

  favoriteButton.addEventListener('click', () => {
    isFavorited = !isFavorited;
    if (isFavorited) {
      favoriteButton.innerHTML = `
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
      `;
      favoriteButton.classList.remove('text-gray-500');
      favoriteButton.classList.add('text-red-500');
      // Save to localStorage
      localStorage.setItem('yetuRadioFavorited', 'true');
    } else {
      favoriteButton.innerHTML = `
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
      `;
      favoriteButton.classList.remove('text-red-500');
      favoriteButton.classList.add('text-gray-500');
      // Remove from localStorage
      localStorage.removeItem('yetuRadioFavorited');
    }
  });

  // Check if radio was previously favorited
  if (localStorage.getItem('yetuRadioFavorited') === 'true') {
    isFavorited = true;
    favoriteButton.innerHTML = `
      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
        <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
      </svg>
    `;
    favoriteButton.classList.remove('text-gray-500');
    favoriteButton.classList.add('text-red-500');
  }

  // Share button functionality
  const shareButton = document.getElementById('shareButton');
  
  shareButton.addEventListener('click', async () => {
    const shareData = {
      title: 'Yetu Radio',
      text: 'Listen to Yetu Radio, broadcasting on 99.1 MHz across central Malawi. The only radio station in Malawi broadcasting in five languages.',
      url: window.location.href
    };

    try {
      if (navigator.share) {
        await navigator.share(shareData);
      } else {
        // Fallback for browsers that don't support the Web Share API
        const url = encodeURIComponent(window.location.href);
        const text = encodeURIComponent(shareData.text);
        window.open(`https://twitter.com/intent/tweet?url=${url}&text=${text}`, '_blank');
      }
    } catch (err) {
      console.log('Error sharing:', err);
    }
  });
</script>
