---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import NewsWidget from '../components/radio/NewsWidget.astro';

const title = "Yetu Radio 99.1 MHz | Dzaleka Community Radio";
const description = "Listen to Yetu Radio 99.1 MHz, the only multilingual radio station in Malawi broadcasting in 5 languages (English, Chichewa, Kiswahili, French, Kinyarwanda) from Dzaleka Refugee Camp. Serving central Malawi with community news, cultural programming, and refugee voices.";

const seo = {
  title,
  description,
  type: "website",
  canonical: "https://services.dzaleka.com/yetu-radio",
  keywords: "Yetu Radio, 99.1 MHz, Dzaleka radio, refugee radio, Malawi radio, community radio, UNHCR radio, multilingual radio, Chichewa radio, Kiswahili radio, French radio, Kinyarwanda radio, central Malawi radio",
  openGraph: {
    title,
    description,
    type: "website",
    site_name: "Yetu Radio",
    locale: "en_US",
    url: "https://services.dzaleka.com/yetu-radio",
    images: [
      {
        url: "https://www.unhcr.org/sites/default/files/styles/d12/public/RF1321732.webp?itok=r_DIA-bu&t=1707819930",
        width: 1200,
        height: 630,
        alt: "Yetu Radio - Voice of Dzaleka Refugee Camp"
      }
    ]
  },
  twitter: {
    card: "summary_large_image",
    site: "@Dzalekaconnect",
    creator: "@Dzalekaconnect",
    title,
    description,
    image: "https://www.unhcr.org/sites/default/files/styles/d12/public/RF1321732.webp?itok=r_DIA-bu&t=1707819930"
  },
  additionalMetaTags: [
    {
      name: "geo.region",
      content: "MW"
    },
    {
      name: "geo.placename",
      content: "Dzaleka Refugee Camp"
    },
    {
      name: "geo.position",
      content: "-13.7000;33.9333"
    },
    {
      name: "ICBM",
      content: "-13.7000, 33.9333"
    },
    {
      name: "language",
      content: "en,ny,sw,fr,rw"
    },
    {
      name: "frequency",
      content: "99.1 MHz"
    },
    {
      name: "broadcast-area",
      content: "Central Region, Malawi"
    }
  ]
};

// Enhanced structured data for radio station
const structuredData = {
  "@context": "https://schema.org",
  "@type": "RadioStation",
  "name": "Yetu Radio",
  "description": description,
  "url": "https://services.dzaleka.com/yetu-radio",
  "broadcastDisplayName": "Yetu Radio 99.1 MHz",
  "broadcastTimezone": "Africa/Blantyre",
  "inLanguage": ["en", "ny", "sw", "fr", "rw"],
  "broadcastArea": {
    "@type": "Place",
    "name": "Central Region, Malawi",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "Malawi",
      "addressRegion": "Central Region"
    }
  },
  "foundingDate": "2018",
  "foundingOrganization": {
    "@type": "Organization",
    "name": "United Nations High Commissioner for Refugees",
    "abbreviation": "UNHCR"
  },
  "broadcastFrequency": "99.1 MHz",
  "genre": ["Community Radio", "Multilingual Radio", "Refugee Radio"],
  "slogan": "Voice of Dzaleka Refugee Camp",
  "location": {
    "@type": "Place",
    "name": "Dzaleka Refugee Camp",
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "-13.7000",
      "longitude": "33.9333"
    }
  },
  "potentialAction": {
    "@type": "ListenAction",
    "target": "https://play.streamafrica.net/yetu"
  }
};
---
<MainLayout {...seo}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8"><Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Yetu Radio' }]} /></div>
  <section class="bg-slate-950 text-white" aria-labelledby="station-title">
    <div class="mx-auto grid max-w-7xl items-center gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[1fr_1fr] lg:px-8 lg:py-14">
      <div class="flex items-start gap-5">
        <img src="https://cdn.onlineradiobox.com/img/l/9/111679.v19.png" alt="Yetu Radio logo" width="112" height="112" class="h-20 w-20 shrink-0 rounded bg-white object-contain sm:h-28 sm:w-28" />
        <div><p class="mb-3 text-sm text-primary-200">Community radio · 99.1 MHz</p><h1 id="station-title" class="text-white">Yetu Radio</h1><p class="mt-4 max-w-lg text-base leading-7 text-slate-200">Music, news and community programming from Dzaleka Refugee Camp.</p></div>
      </div>
      <div class="rounded border border-slate-600 bg-slate-900 p-6">
        <h2 class="text-lg text-white">Listen online</h2>
        <p id="radio-status" role="status" class="mb-5 mt-2 text-sm text-slate-300">Press play to connect to the station.</p>
        <audio id="radio-player" controls preload="none" aria-label="Yetu Radio stream" class="w-full" src="https://play.streamafrica.net/yetu">Your browser does not support the audio player.</audio>
        <a href="https://play.streamafrica.net/yetu" class="mt-4 inline-flex min-h-[44px] items-center text-sm text-white underline underline-offset-4">Open the stream directly ↗</a>
      </div>
    </div>
  </section>
  <div class="mx-auto grid max-w-7xl items-start gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:px-8">
    <div class="space-y-10">
      <section aria-labelledby="about-station" class="max-w-prose"><h2 id="about-station" class="text-primary-900">About Yetu Radio</h2>
        <p class="mt-4 text-base leading-7 text-slate-700">Yetu community radio was established in 2018 by UNHCR. Its programmes give refugee and Malawian communities a place to discuss child protection, gender-based violence, human rights and other issues affecting their lives.</p>
        <p class="mt-4 text-base leading-7 text-slate-700">The station broadcasts on 99.1 MHz in Malawi's Central Region, in English, Chichewa, Kiswahili, French and Kinyarwanda.</p>
      </section>
      <section class="border-t border-slate-200 pt-7" aria-labelledby="radio-news"><h2 id="radio-news" class="mb-5 text-primary-900">News from Dzaleka</h2><NewsWidget /><a href="/news" class="mt-4 inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">All news and announcements</a></section>
    </div>
    <aside class="rounded border border-slate-200 bg-slate-50 p-6" aria-labelledby="radio-contact"><h2 id="radio-contact" class="text-xl text-primary-900">Contact the station</h2>
      <dl class="mt-5 space-y-5 text-sm leading-6">
        <div><dt class="font-semibold text-slate-900">Location</dt><dd class="mt-1 text-slate-700">Dzaleka Refugee Camp, Dowa District, Malawi</dd></div>
        <div><dt class="font-semibold text-slate-900">Phone</dt><dd class="mt-1"><a href="tel:+265884909320" class="text-primary-800 underline underline-offset-4">+265 884 90 93 20</a></dd></div>
        <div><dt class="font-semibold text-slate-900">Email</dt><dd class="mt-1 break-words"><a href="mailto:yetufmradio@outlook.com" class="text-primary-800 underline underline-offset-4">yetufmradio@outlook.com</a></dd></div>
        <div><dt class="font-semibold text-slate-900">Social media</dt><dd class="mt-1"><a href="https://www.facebook.com/MalawiSportsNow/" class="text-primary-800 underline underline-offset-4">Yetu Radio on Facebook ↗</a></dd></div>
      </dl>
    </aside>
  </div>
</MainLayout>
<script>
  const player = document.querySelector<HTMLAudioElement>('#radio-player');
  const status = document.querySelector<HTMLElement>('#radio-status');
  if (player && status) {
    const messages = { playing: 'Playing Yetu Radio.', waiting: 'Connecting to the stream…', pause: 'Playback paused.', error: 'The stream could not be loaded. Try again or open it directly.' };
    for (const [event, message] of Object.entries(messages)) player.addEventListener(event, () => { status.textContent = message; });
  }
</script>
