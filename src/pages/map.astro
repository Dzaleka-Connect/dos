---
import '../styles/maps.css';
import MainLayout from '../layouts/MainLayout.astro';
import { DzalekaInteractiveMap } from '../components/data/DzalekaInteractiveMap';
import rawOsmPoints from '../data/dzalekaOsmPoints.json';

const pageTitle = "Dzaleka map | Dzaleka Online Services";
const description = "Find places, services and landmarks in Dzaleka Refugee Camp. Search the directory, explore the map and open directions.";
const keywords = "Dzaleka refugee camp map, Dzaleka directions, how to get to Dzaleka, Dzaleka coordinates, Dzaleka healthcare center location, Dzaleka police station, Dzaleka market, Dowa district refugee camp map, OpenStreetMap Dzaleka";

const keyPlaces = (rawOsmPoints as any[]).slice(0, 15).map(pt => ({
  "@type": "Place",
  "name": pt.name,
  "description": pt.description,
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": pt.lat,
    "longitude": pt.lng
  }
}));

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Place", "Map", "CivicStructure"],
      "name": "Dzaleka Refugee Camp",
      "description": description,
      "url": "https://services.dzaleka.com/map",
      "hasMap": "https://services.dzaleka.com/map",
      "image": "https://services.dzaleka.com/images/dzaleka-hero.jpeg",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -13.6592075,
        "longitude": 33.8704547
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "M7 Highway, Dzaleka Refugee Camp",
        "addressLocality": "Dowa District",
        "addressRegion": "Central Region",
        "addressCountry": "MW"
      },
      "containsPlace": keyPlaces
    }
  ]
};
---
<MainLayout title={pageTitle} description={description} keywords={keywords} image="/images/dzaleka-hero.jpeg" schema={structuredData}>
  <h1 class="sr-only">Dzaleka map</h1>
  <div class="map-workspace h-[calc(100dvh-7rem)] min-h-[36rem] w-full border-b border-slate-200 lg:h-[calc(100dvh-9rem)]"><DzalekaInteractiveMap client:load /></div>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="flex flex-wrap gap-x-6 gap-y-2"><a href="/explore" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Explore heritage records</a><a href="/services" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Service directory</a><a href="/visit/travel-guide" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Visitor travel guide</a></div>
    <details class="mt-5 border-t border-slate-200 pt-3"><summary class="cursor-pointer py-3 text-base font-semibold text-primary-900">Browse places without the map</summary><ul class="mt-3 grid gap-x-8 gap-y-4 sm:grid-cols-2 lg:grid-cols-3">{rawOsmPoints.map((point) => <li><h2 class="text-primary-900">{point.name}</h2><p class="mt-2 text-sm leading-6 text-slate-700">{point.description}</p><a href={`https://www.google.com/maps/search/?api=1&query=${point.lat},${point.lng}`} class="inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">Open in Google Maps</a></li>)}</ul></details>
  </div>
</MainLayout>
