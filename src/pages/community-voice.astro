---
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { getCollection } from 'astro:content';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

// Get all community voices
const allVoices = await getCollection('community-voices');
const sortedVoices = allVoices.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const featuredVoices = sortedVoices.filter(voice => voice.data.featured);

const categories = [
  {
    title: "Stories",
    description: "Personal journeys, experiences, and memories from Dzaleka",
    color: "bg-slate-50 text-slate-700 border-slate-200"
  },
  {
    title: "Culture",
    description: "Celebrating our diverse cultural heritage through stories and traditions",
    color: "bg-gray-50 text-gray-700 border-gray-200"
  },
  {
    title: "Community",
    description: "Community initiatives, events, and people making a difference",
    color: "bg-slate-50 text-slate-700 border-slate-200"
  }
];
---

<MainLayout title="Community Voice - Dzaleka Online Services">
  <main class="min-h-screen">
    <!-- Hero Section -->
    <div class="border-b border-gray-200 bg-white">
      <div class="container mx-auto px-4 py-16 sm:py-20">
        <!-- Breadcrumb -->
        <div class="mb-8">
          <Breadcrumb items={[
            { label: 'Home', href: '/' },
            { label: 'Community Voice' }
          ]} />
        </div>

        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Community Voice
          </h1>
          <p class="text-lg md:text-xl text-gray-600 mb-10 max-w-3xl mx-auto leading-relaxed">
            Stories, experiences, and perspectives from the hearts of our vibrant community
          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a
              class="inline-flex items-center px-8 py-4 text-lg font-semibold text-white bg-gray-900 hover:bg-gray-800 rounded-full transition-colors"
            >
              Share Your Story
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
            </a>
            <a
              href="#stories"
              class="inline-flex items-center px-8 py-4 border border-gray-900 text-lg font-semibold text-slate-700 bg-white hover:bg-slate-50 rounded-full transition-colors"
            >
              Explore Voices
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 py-12">

    <!-- Featured Stories with Parallax -->
    {featuredVoices.length > 0 && (
      <section class="relative py-20 overflow-hidden" id="stories">
        <div class="absolute inset-0 bg-gradient-to-b from-slate-100/50 to-transparent"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Featured Stories</h2>
          <p class="text-lg text-gray-600 mb-12">Highlighted voices from our community</p>
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            {featuredVoices.map(voice => (
              <article class="group relative bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-slate-400 transition-colors duration-200">
                <div class="aspect-w-16 aspect-h-9 bg-gray-200">
                  <img
                    src={voice.data.image || '/images/placeholder-voice.jpg'}
                    alt={voice.data.title}
                    class="w-full h-full object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent"></div>
                </div>
                <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                  <div class="flex items-center gap-3 mb-3">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-slate-800/60 text-white backdrop-blur-sm">
                      {voice.data.category}
                    </span>
                    <time class="text-sm text-white">{new Date(voice.data.date).toLocaleDateString()}</time>
                  </div>
                  <h3 class="text-2xl font-bold mb-2 group-hover:text-slate-300 transition-colors">
                    {voice.data.title}
                  </h3>
                  <p class="text-white line-clamp-2 mb-4">{voice.data.excerpt}</p>
                  <div class="flex items-center justify-between">
                    <span class="text-sm text-white">By {voice.data.author}</span>
                    <a 
                      href={`/community-voices/${voice.id}`} 
                      class="inline-flex items-center text-white font-medium hover:text-slate-300 transition-colors"
                    >
                      Read More
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Interactive Category Filters -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">Browse by Category</h2>
        <p class="text-lg text-gray-600 mb-12">Explore stories through different perspectives</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {categories.map((category) => (
            <a
              href={`/community-voices?category=${category.title.toLowerCase()}`}
              class={`block p-8 border rounded-xl ${category.color} transition-colors duration-200 text-left`}
            >
              <h3 class="text-xl font-semibold mb-2">{category.title}</h3>
              <p class="text-sm opacity-90">{category.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- All Stories Grid with Masonry Layout -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">All Stories</h2>
        <p class="text-lg text-gray-600 mb-12">Voices from our diverse community</p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedVoices.map((voice) => (
            <article class="group bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-slate-400 transition-colors duration-200">
              <div class="aspect-w-3 aspect-h-2 bg-gray-200">
                <img
                  src={voice.data.image || '/images/placeholder-voice.jpg'}
                  alt={voice.data.title}
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="p-6">
                <div class="flex items-center justify-between mb-3">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-slate-100 text-slate-800">
                    {voice.data.category}
                  </span>
                  <time class="text-sm text-gray-500">{new Date(voice.data.date).toLocaleDateString()}</time>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-slate-700 transition-colors">
                  {voice.data.title}
                </h3>
                <p class="text-gray-600 mb-4 line-clamp-2">{voice.data.excerpt}</p>
                <div class="flex items-center justify-between">
                  <span class="text-sm text-gray-500">By {voice.data.author}</span>
                  <a 
                    href={`/community-voices/${voice.id}`} 
                    class="inline-flex items-center text-slate-700 font-medium group-hover:text-slate-900"
                  >
                    Read More
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</MainLayout>
