---
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import { getCollection } from "astro:content";
const voices = (await getCollection("community-voices")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const [lead, ...more] = voices;
const description =
  "Read stories and perspectives from people connected to Dzaleka, including writing about community life, language and youth. Submit your own contribution.";
const canonical = "https://services.dzaleka.com/community-voice";
const formatDate = (value: Date) =>
  value.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Community Voice",
  description,
  url: canonical,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: voices.map((voice, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: voice.data.title,
      url: `${canonical.replace("/community-voice", "")}/community-voices/${voice.id}`,
    })),
  },
};
---

<MainLayout
  title="Community Voice"
  description={description}
  canonical={canonical}
  image={
    lead?.data.image ? new URL(lead.data.image, canonical).href : undefined
  }
  schema={schema}
>
  <section class="border-b border-slate-200 bg-primary-900 text-white">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <Breadcrumb
        light
        items={[{ label: "Home", href: "/" }, { label: "Community Voice" }]}
      />
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-primary-200">
            In our own words
          </p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
            Community Voice
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-primary-50">
            Stories, experiences and perspectives from people connected to
            Dzaleka.
          </p>
        </div>
        <a
          href="/submit-voice"
          class="inline-flex min-h-[44px] items-center rounded bg-white px-5 py-3 font-semibold text-primary-900 hover:bg-primary-50"
        >
          Share your story →
        </a>
      </div>
    </div>
  </section>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section
      id="stories"
      aria-labelledby="stories-heading"
      class="scroll-mt-28"
    >
      <h2
        id="stories-heading"
        class="mb-5 text-sm font-semibold uppercase tracking-widest text-slate-500"
      >
        Latest contribution
      </h2>
      {lead ? (
        <article class="grid overflow-hidden rounded border border-slate-200 lg:grid-cols-2">
          {lead.data.image && (
            <a
              href={`/community-voices/${lead.id}`}
              tabindex="-1"
              aria-hidden="true"
              class="block aspect-[4/3] bg-slate-100"
            >
              <img
                src={lead.data.image}
                alt=""
                class="h-full w-full object-cover object-top"
                fetchpriority="high"
                width="800"
                height="600"
              />
            </a>
          )}
          <div class="flex flex-col justify-center p-6 sm:p-8">
            <p class="text-sm text-slate-500">
              {lead.data.category} ·{" "}
              <time datetime={new Date(lead.data.date).toISOString()}>
                {formatDate(new Date(lead.data.date))}
              </time>
            </p>
            <h3 class="mt-3 text-2xl font-bold leading-tight text-slate-900 sm:text-3xl">
              <a
                href={`/community-voices/${lead.id}`}
                class="hover:text-primary-700"
              >
                {lead.data.title}
              </a>
            </h3>
            <p class="mt-4 text-lg leading-8 text-slate-600">
              {lead.data.excerpt}
            </p>
            <p class="mt-4 text-sm text-slate-500">By {lead.data.author}</p>
            <a
              href={`/community-voices/${lead.id}`}
              class="mt-5 inline-flex min-h-[44px] items-center font-semibold text-primary-800 underline underline-offset-4"
            >
              Read the story{" "}
              <span class="ml-3" aria-hidden="true">
                →
              </span>
            </a>
          </div>
        </article>
      ) : (
        <p class="py-8 text-slate-600">No stories have been published yet.</p>
      )}
    </section>
    {more.length > 0 && (
      <section class="mt-10">
        <h2 class="text-2xl font-bold text-slate-900">More voices</h2>
        <div class="mt-5 divide-y divide-slate-200">
          {more.map((voice) => (
            <article class="grid gap-6 border-t border-slate-200 py-6 sm:grid-cols-[220px_minmax(0,1fr)]">
              {voice.data.image && (
                <img
                  src={voice.data.image}
                  alt=""
                  width="440"
                  height="330"
                  loading="lazy"
                  class="aspect-[4/3] w-full rounded bg-slate-100 object-cover object-top"
                />
              )}
              <div>
                <p class="text-sm text-slate-500">
                  {voice.data.category} ·{" "}
                  <time datetime={new Date(voice.data.date).toISOString()}>
                    {formatDate(new Date(voice.data.date))}
                  </time>
                </p>
                <h3 class="mt-2 max-w-3xl text-xl font-bold">
                  <a
                    href={`/community-voices/${voice.id}`}
                    class="text-primary-800 underline underline-offset-4"
                  >
                    {voice.data.title}
                  </a>
                </h3>
                <p class="mt-3 max-w-3xl leading-7 text-slate-600">
                  {voice.data.excerpt}
                </p>
                <p class="mt-3 text-sm text-slate-500">
                  By {voice.data.author}
                </p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
    <aside class="mt-8 border-l-4 border-primary-700 bg-slate-50 p-6">
      <h2 class="text-lg font-semibold text-slate-900">
        Have a story to share?
      </h2>
      <p class="mt-2 max-w-3xl leading-7 text-slate-600">
        Send a personal account, reflection or story about community life
        through the contribution form.
      </p>
      <a
        href="/submit-voice"
        class="mt-3 inline-flex min-h-[44px] items-center font-semibold text-primary-800 underline underline-offset-4"
      >
        Submit a contribution →
      </a>
    </aside>
  </div>
</MainLayout>
