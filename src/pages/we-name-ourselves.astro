---
import MainLayout from '../layouts/MainLayout.astro';

const movieSchema = {
  "@context": "https://schema.org",
  "@type": "Movie",
  "name": "We Name Ourselves",
  "description": "From behind locked gates and closed borders, hope rises—in color, in sound, in story. A documentary about the power of art in Dzaleka Refugee Camp.",
  "image": "https://m.media-amazon.com/images/M/MV5BN2ViMGY2NzUtNWViNy00MzZhLTlkOWYtZGFiMTI0ZjU1MWVjXkEyXkFqcGc@._V1_FMjpg_UY4724_.jpg",
  "director": {
    "@type": "Person",
    "name": "Francisco Alcala Torreslanda"
  },
  "productionCompany": {
    "@type": "Organization",
    "name": "HOME Storytellers",
    "url": "https://www.wenameourselves.com/"
  },
  "datePublished": "2025-09",
  "actor": [
    { "@type": "Person", "name": "Espoir Kahitani" },
    { "@type": "Person", "name": "Nyota Ephrase" },
    { "@type": "Person", "name": "Charles Lipanda Mahigwe" },
    { "@type": "Person", "name": "Mutamba Lodima" },
    { "@type": "Person", "name": "Samuel Mundusa" },
    { "@type": "Person", "name": "Rudy Ruhigita Bienvenue" },
    { "@type": "Person", "name": "Heritier Havyarimana Kivunja" }
  ],
  "locationCreated": {
    "@type": "Place",
    "name": "Dzaleka Refugee Camp",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "Malawi"
    }
  }
};
---

{/* Inject Google Fonts for Cinematic Feel */}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Cinzel:wght@400;700&display=swap" rel="stylesheet">

<MainLayout title="We Name Ourselves | The Power of Art" schema={movieSchema}>
  <main class="bg-slate-950 text-white selection:bg-primary-900 selection:text-white font-sans">
    
    {/* Partners / Presents Section */}
    {/* Partners / Presents Section */}
    <div class="bg-slate-950 py-6 text-center uppercase tracking-[0.2em] text-[10px] md:text-xs text-slate-500 font-medium border-b border-slate-900/50">
      <div class="container mx-auto px-4 flex flex-col md:flex-row justify-center items-center gap-y-4 gap-x-8 opacity-80">
        <div class="flex items-center gap-2 text-primary-500/80">
           <span>Promoted by Dzaleka Online Services</span>
        </div>
        <span class="hidden md:inline text-slate-800">|</span>
        <div class="flex flex-col md:flex-row items-center gap-4 md:gap-8 text-slate-400">
            <a href="https://tbhf.ae/" target="_blank" class="hover:text-white transition-colors">The Big Heart Foundation</a>
            <span class="text-slate-700">•</span>
            <span>Presents</span>
            <span class="text-slate-700">•</span>
            <a href="https://www.wenameourselves.com/" target="_blank" class="hover:text-white transition-colors">A Home Storytellers Film</a>
        </div>
      </div>
    </div>

    {/* Hero Section */}
    {/* Hero Section */}
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden py-24 lg:py-0">
      <div class="absolute inset-0 z-0">
        <img 
          src="https://m.media-amazon.com/images/M/MV5BN2ViMGY2NzUtNWViNy00MzZhLTlkOWYtZGFiMTI0ZjU1MWVjXkEyXkFqcGc@._V1_FMjpg_UY4724_.jpg" 
          alt="We Name Ourselves Film Background" 
          class="w-full h-full object-cover opacity-30"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-slate-950/50 to-slate-950"></div>
      </div>
      
      <div class="relative z-10 container mx-auto px-4">
        <div class="flex flex-col lg:flex-row items-center lg:gap-16 xl:gap-24">
          {/* Text Content */}
          <div class="w-full lg:w-3/5 text-center lg:text-left order-2 lg:order-1 mt-12 lg:mt-0">
            <h1 class="font-serif italic text-5xl md:text-8xl lg:text-9xl mb-6 tracking-tight leading-none drop-shadow-2xl">
              We Name <br/> Ourselves
            </h1>
            <div class="w-24 h-1 bg-white mx-auto lg:mx-0 mb-8 opacity-50 rounded-lg"></div>
            <p class="text-lg md:text-2xl font-light max-w-2xl mx-auto lg:mx-0 mb-12 leading-relaxed text-gray-200 tracking-wide font-serif">
              From behind locked gates and closed borders, <br/> hope rises—in color, in sound, in story.
            </p>
            
            <div class="flex flex-col sm:flex-row justify-center lg:justify-start gap-6">
              <a href="https://www.wenameourselves.com/" target="_blank" class="px-10 py-4 bg-white text-slate-950 hover:bg-slate-100 rounded-full font-bold tracking-widest uppercase transition-all duration-300 text-sm md:text-base shadow-xl hover:scale-105 transform">
                Watch Trailer
              </a>
            </div>
          </div>

          {/* Poster Image (Visible on Mobile now) */}
          <div class="w-full lg:w-2/5 max-w-[280px] md:max-w-sm xl:max-w-md mx-auto order-1 lg:order-2">
             <img 
              src="https://m.media-amazon.com/images/M/MV5BN2ViMGY2NzUtNWViNy00MzZhLTlkOWYtZGFiMTI0ZjU1MWVjXkEyXkFqcGc@._V1_FMjpg_UY4724_.jpg" 
              alt="We Name Ourselves Official Poster" 
              class="w-full h-auto rounded-lg shadow-2xl border border-white/10 rotate-0 lg:rotate-2 hover:rotate-0 transition-transform duration-500"
            />
          </div>
        </div>
      </div>
    </section>

    {/* About The Story - Cinematic Text Layout */}
    <section id="about" class="py-32 bg-slate-950 relative overflow-hidden">
      {/* Background Image with Overlay */}
      <div class="absolute inset-0 z-0 opacity-40">
        <img 
          src="https://static.wixstatic.com/media/0b9838_003ecb4ea7f547d09f6f4f430816a29f~mv2.jpg/v1/fill/w_2104,h_1224,al_c,q_90,usm_0.66_1.00_0.01,enc_avif,quality_auto/MoviePoster_Photo_Trial2.jpg" 
          alt="Film Scene" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-slate-950 via-slate-950/80 to-slate-950"></div>
      </div>

      <div class="container mx-auto px-4 max-w-3xl text-center relative z-10">
        <h2 class="font-serif text-3xl md:text-4xl text-white mb-16 italic opacity-90">About the Story</h2>
        
        <div class="space-y-12 text-lg md:text-xl text-gray-300 font-light leading-relaxed">
          <p>
            <strong class="text-white font-serif text-2xl">Dzaleka Refugee Camp, Malawi</strong> is under-resourced and over-populated. Once a high-security prison, it now shelters over 53,000 displaced people from war-torn countries like the DRC, Burundi & Rwanda.
          </p>
          <p>
            Amidst ruins and neglect, a group of teenagers turn to <span class="text-white border-b border-primary-500/50 pb-1">spoken word poetry</span> as a way to navigate a world with the odds stacked against them. Their hopeful voices echo through the relentless monotony of daily life, expressing universal human emotions and questions.
          </p>
          <p>
            But once a year, the <strong class="text-white">Tumaini Festival</strong> transforms the camp into a vibrant celebration, drawing over 50,000 attendees. For a brief moment, it shatters the harsh reality of camp life and brings them out of the shadows.
          </p>
        </div>

        <div class="mt-24">
          <blockquote class="font-serif text-3xl md:text-5xl leading-tight text-white mb-6">
            "Our voices <br/> shall be heard!"
          </blockquote>
          <cite class="not-italic text-sm tracking-[0.2em] uppercase text-primary-500">— Espoir Kahitani</cite>
        </div>
      </div>
    </section>

    {/* The Poets / Cast Section */}
    <section class="py-24 bg-slate-900 border-t border-slate-800">
      <div class="container mx-auto px-4 max-w-5xl">
        <div class="text-center mb-16">
          <h2 class="font-serif text-3xl md:text-4xl text-white mb-4">The Poets</h2>
          <div class="w-12 h-1 bg-primary-600 mx-auto rounded-lg mb-8"></div>
          <p class="text-gray-400 font-light max-w-2xl mx-auto text-lg">
            Featuring the powerful voices of Dzaleka's young poets.
          </p>
        </div>

        <div class="flex flex-wrap justify-center gap-8 md:gap-12 text-center">
          {/* Poet Cards with centered flex layout */}
          <div class="group w-full sm:w-[calc(50%-3rem)] lg:w-[calc(25%-3rem)] min-w-[200px]">
            <div class="w-24 h-24 mx-auto bg-slate-800 rounded-lg mb-6 flex items-center justify-center border border-slate-700 group-hover:border-primary-500 group-hover:bg-slate-700 transition-all duration-300 shadow-sm group-hover:shadow-primary-900/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-500 group-hover:text-primary-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
            </div>
            <h3 class="text-white font-serif text-lg mb-1 group-hover:text-primary-400 transition-colors">Espoir Kahitani</h3>
            <span class="text-slate-500 text-xs tracking-widest uppercase">Poet</span>
          </div>
          
          <div class="group w-full sm:w-[calc(50%-3rem)] lg:w-[calc(25%-3rem)] min-w-[200px]">
            <div class="w-24 h-24 mx-auto bg-slate-800 rounded-lg mb-6 flex items-center justify-center border border-slate-700 group-hover:border-primary-500 group-hover:bg-slate-700 transition-all duration-300 shadow-sm group-hover:shadow-primary-900/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-500 group-hover:text-primary-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
            </div>
            <h3 class="text-white font-serif text-lg mb-1 group-hover:text-primary-400 transition-colors">Nyota Ephrase</h3>
            <span class="text-slate-500 text-xs tracking-widest uppercase">Poet</span>
          </div>

          <div class="group w-full sm:w-[calc(50%-3rem)] lg:w-[calc(25%-3rem)] min-w-[200px]">
             <div class="w-24 h-24 mx-auto bg-slate-800 rounded-lg mb-6 flex items-center justify-center border border-slate-700 group-hover:border-primary-500 group-hover:bg-slate-700 transition-all duration-300 shadow-sm group-hover:shadow-primary-900/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-500 group-hover:text-primary-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
            </div>
            <h3 class="text-white font-serif text-lg mb-1 group-hover:text-primary-400 transition-colors">Charles Lipanda Mahigwe</h3>
            <span class="text-slate-500 text-xs tracking-widest uppercase">Poet</span>
          </div>

          <div class="group w-full sm:w-[calc(50%-3rem)] lg:w-[calc(25%-3rem)] min-w-[200px]">
             <div class="w-24 h-24 mx-auto bg-slate-800 rounded-lg mb-6 flex items-center justify-center border border-slate-700 group-hover:border-primary-500 group-hover:bg-slate-700 transition-all duration-300 shadow-sm group-hover:shadow-primary-900/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-500 group-hover:text-primary-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
            </div>
            <h3 class="text-white font-serif text-lg mb-1 group-hover:text-primary-400 transition-colors">Mutamba Lodima</h3>
            <span class="text-slate-500 text-xs tracking-widest uppercase">Poet</span>
          </div>
          
           <div class="group w-full sm:w-[calc(50%-3rem)] lg:w-[calc(25%-3rem)] min-w-[200px]">
             <div class="w-24 h-24 mx-auto bg-slate-800 rounded-lg mb-6 flex items-center justify-center border border-slate-700 group-hover:border-primary-500 group-hover:bg-slate-700 transition-all duration-300 shadow-sm group-hover:shadow-primary-900/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-500 group-hover:text-primary-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
            </div>
            <h3 class="text-white font-serif text-lg mb-1 group-hover:text-primary-400 transition-colors">Samuel Mundusa</h3>
            <span class="text-slate-500 text-xs tracking-widest uppercase">Poet</span>
          </div>

          <div class="group w-full sm:w-[calc(50%-3rem)] lg:w-[calc(25%-3rem)] min-w-[200px]">
             <div class="w-24 h-24 mx-auto bg-slate-800 rounded-lg mb-6 flex items-center justify-center border border-slate-700 group-hover:border-primary-500 group-hover:bg-slate-700 transition-all duration-300 shadow-sm group-hover:shadow-primary-900/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-500 group-hover:text-primary-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
            </div>
             <h3 class="text-white font-serif text-lg mb-1 group-hover:text-primary-400 transition-colors">Rudy Ruhigita Bienvenue</h3>
            <span class="text-slate-500 text-xs tracking-widest uppercase">Poet</span>
          </div>
          
           <div class="group w-full sm:w-[calc(50%-3rem)] lg:w-[calc(25%-3rem)] min-w-[200px]">
             <div class="w-24 h-24 mx-auto bg-slate-800 rounded-lg mb-6 flex items-center justify-center border border-slate-700 group-hover:border-primary-500 group-hover:bg-slate-700 transition-all duration-300 shadow-sm group-hover:shadow-primary-900/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-gray-500 group-hover:text-primary-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
              </svg>
            </div>
             <h3 class="text-white font-serif text-lg mb-1 group-hover:text-primary-400 transition-colors">Heritier Havyarimana Kivunja</h3>
            <span class="text-slate-500 text-xs tracking-widest uppercase">Poet</span>
          </div>

        </div>
      </div>
    </section>

    {/* Our Release & Distribution */}
    <section class="py-24 bg-slate-950 border-y border-slate-800">
       <div class="container mx-auto px-4 max-w-4xl text-center">
          <span class="block text-primary-500 tracking-[0.2em] text-xs font-bold uppercase mb-4">The Release</span>
          <p class="text-2xl font-serif text-gray-300 leading-relaxed mb-12">
             Currently in post-production with expected completion in <span class="text-white">September 2025</span>. The film will be distributed globally through film festivals, streaming platforms, and partner-led screening events.
          </p>
          
          {/* Credits Grid */}
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 border-t border-slate-800 pt-12">
            <div>
              <span class="block text-slate-500 text-xs tracking-[0.2em] uppercase mb-2">Director</span>
              <span class="text-white font-serif text-lg">Francisco Alcala Torreslanda</span>
            </div>
            <div>
              <span class="block text-slate-500 text-xs tracking-[0.2em] uppercase mb-2">Cinematography & Editing</span>
              <span class="text-white font-serif text-lg">Alex García</span>
            </div>
            <div>
              <span class="block text-slate-500 text-xs tracking-[0.2em] uppercase mb-2">Produced By</span>
              <span class="text-white font-serif text-lg">HOME Storytellers</span>
            </div>
          </div>
       </div>
    </section>

    {/* Impact Section - New Initiatives */}
    <section class="py-32 bg-slate-950 relative overflow-hidden text-center">
      <div class="container mx-auto px-4 relative z-10">
        <div class="mb-20">
          <span class="block text-primary-500 tracking-[0.2em] text-xs font-bold uppercase mb-4">Real-World Impact</span>
          <h2 class="font-serif text-3xl md:text-5xl text-white mb-6">Creativity. Learning. Connection.</h2>
          <p class="text-gray-400 font-light max-w-2xl mx-auto text-lg">
            <strong class="text-white">HOME Storytellers</strong> has announced three major initiatives supported by <span class="text-white">The Big Heart Foundation (TBHF)</span> to turn these beliefs into reality.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto text-left">
          
          {/* Initiative 1: Artistic Livelihoods */}
          <div class="bg-slate-900/40 p-8 border border-slate-800 hover:border-primary-500/50 transition-all duration-500 group rounded-sm">
            <div class="mb-6 text-primary-500">
               <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
            </div>
            <h3 class="font-serif text-2xl text-white mb-4 group-hover:text-primary-400 transition-colors">Artistic Livelihoods</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">
              In partnership with <strong>Artolution, Salama Africa, and Tumaini Letu</strong>, Dzaleka’s new Digital Content Creation Lab is launching. This hub equips local artists with tools and mentorship to build sustainable careers.
            </p>
            <ul class="text-xs text-slate-500 uppercase tracking-wider space-y-2">
              <li class="flex items-center"><span class="w-1 h-1 bg-primary-500 rounded-lg mr-2"></span>2-Week Capacity Workshop</li>
              <li class="flex items-center"><span class="w-1 h-1 bg-primary-500 rounded-lg mr-2"></span>Fully Equipped Creator Lab</li>
            </ul>
          </div>

          {/* Initiative 2: The Library */}
          <div class="bg-slate-900/40 p-8 border border-slate-800 hover:border-primary-500/50 transition-all duration-500 group rounded-sm">
            <div class="mb-6 text-primary-500">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h3 class="font-serif text-2xl text-white mb-4 group-hover:text-primary-400 transition-colors">A new library</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">
              A <strong>140 m² library</strong> is being built in Dzaleka, managed by local educators. It provides a safe environment for study, exam prep, and digital literacy.
            </p>
             <ul class="text-xs text-slate-500 uppercase tracking-wider space-y-2">
              <li class="flex items-center"><span class="w-1 h-1 bg-primary-500 rounded-lg mr-2"></span>25 Laptops for Learning</li>
              <li class="flex items-center"><span class="w-1 h-1 bg-primary-500 rounded-lg mr-2"></span>Expanded Book Collection</li>
            </ul>
          </div>

          {/* Initiative 3: The Portal */}
          <div class="bg-slate-900/40 p-8 border border-slate-800 hover:border-primary-500/50 transition-all duration-500 group rounded-sm">
             <div class="mb-6 text-primary-500">
               <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
            </div>
            <h3 class="font-serif text-2xl text-white mb-4 group-hover:text-primary-400 transition-colors">The virtual portal</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">
              Together with <strong>Shared Studios and Ubuntu Nation</strong>, the campaign is bringing an immersive portal to Dzaleka, connecting it live with cities like Berlin & New York.
            </p>
             <ul class="text-xs text-slate-500 uppercase tracking-wider space-y-2">
              <li class="flex items-center"><span class="w-1 h-1 bg-primary-500 rounded-lg mr-2"></span>Global Real-Time Connection</li>
              <li class="flex items-center"><span class="w-1 h-1 bg-primary-500 rounded-lg mr-2"></span>Cultural Exchange Stage</li>
            </ul>
          </div>

        </div>
      </div>
    </section>

    {/* Call to Action - Minimalist */}
    <section class="py-32 bg-gradient-to-b from-slate-900 to-slate-950 text-center border-t border-slate-900">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="font-serif text-4xl md:text-5xl text-white mb-8">Work alongside us</h2>
        <p class="text-xl text-gray-400 mb-12 max-w-2xl mx-auto font-light leading-relaxed">
