---
import MainLayout from '../../layouts/MainLayout.astro';
---
<MainLayout title="Submission received" description="Your submission has been saved for editorial review.">
  <main class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-semibold">Submission received</h1>
    <p class="mt-4">Your information has been saved for review. An editor will check it before anything is published.</p>
    <a class="mt-6 inline-block underline" href="/">Return to Dzaleka Online Services</a>
  </main>
</MainLayout>
