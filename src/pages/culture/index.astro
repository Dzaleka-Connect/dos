---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import DirectoryCard from '../../components/ui/DirectoryCard.astro';
import CultureNav from '../../components/culture/CultureNav.astro';
const collections = [
  { title: 'Public art', href: '/public-art-catalogue', image: '/images/6976810_orig.jpg', description: 'Explore murals, public artworks and the stories behind them.' },
  { title: 'Visual artists', href: '/public-art-catalogue/visual-arts-community', image: '/images/artists/serge-kasongo.jpg', description: 'Meet painters, sculptors, designers and other visual artists.' },
  { title: 'Poetry and spoken word', href: '/poets', image: '/images/poets/hassan-c-honore.jpg', description: 'Read about the writers and performers sharing Dzaleka’s stories.' },
  { title: 'Dance', href: '/dancers', image: '/images/dancers/forus-crew.jpg', description: 'Discover dance crews, individual performers and booking information.' },
];
const organizations = [
  {
    "title": "Tumaini Festival",
    "image": "/images/tumaini_festival_cover.jpeg",
    "description": "A refugee-led festival presenting music, dance, theatre, poetry, film, and visual art.",
    "href": "https://tumaini-festival.dzaleka.com"
  },
  {
    "title": "Dzaleka Arts Lab",
    "image": "https://freight.cargo.site/w/2500/h/1562/q/75/i/H2041496616323746227278298378001/lead-image.png",
    "description": "A creative community creating physical and digital artworks, connecting refugee stories with the world through art and music.",
    "href": "https://dzalekaartslab.org"
  },
  {
    "title": "Kibebe",
    "image": "https://kibebe.com/cdn/shop/files/Team_adjusted_600x600.png?v=1613718687",
    "description": "A social enterprise selling textile products made by refugee artisans in Dzaleka.",
    "href": "/services/kibebe"
  },
  {
    "title": "Dzaleka Art Project",
    "image": "https://dzalekaartproject.com/images/visual%20arts%20images/Art1080x1080.jpg",
    "description": "A community-based initiative documenting and promoting the diverse artistic talents within the refugee camp.",
    "href": "https://dzalekaartproject.com"
  }
];
---
<MainLayout title="Culture in Dzaleka | Dzaleka Online Services" description="Explore Dzaleka’s artists, poetry, dance, public art and cultural organizations.">
  <header class="culture-intro mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Culture' }]} />
    <div class="mt-6 grid items-center gap-6 md:grid-cols-2 lg:gap-12">
      <div><h1 class="text-primary-900">Culture in Dzaleka</h1><p class="mt-4 max-w-xl text-base leading-7 text-slate-700">Discover the artists, writers and performers shaping life in Dzaleka. Explore their work, find a performance or connect with a creative community.</p><a href="/events" class="mt-4 inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">Find cultural events →</a></div>
      <figure><img src="/images/tumaini_festival_cover.jpeg" alt="Crowds gathered around the stage at Tumaini Festival" width="960" height="540" class="h-auto w-full" fetchpriority="high" /><figcaption class="mt-2 text-xs text-slate-600">Tumaini Festival, Dzaleka</figcaption></figure>
    </div>
  </header>
  <CultureNav current="/culture" />
  <div class="mx-auto max-w-7xl space-y-12 px-4 py-8 sm:px-6 lg:px-8">
    <section><h2 class="mb-6 text-primary-900">Explore arts and culture</h2><div class="grid auto-rows-fr gap-6 sm:grid-cols-2 lg:grid-cols-4">{collections.map(collection => <DirectoryCard {...collection} contain />)}</div></section>
    <section id="organizations" class="border-t border-slate-200 pt-8"><h2 class="text-primary-900">Cultural organizations</h2><p class="mb-6 mt-3 text-base leading-7 text-slate-700">Find out who is making, teaching and presenting work in Dzaleka.</p><div class="grid gap-x-10 gap-y-6 md:grid-cols-2">{organizations.map(organization => <article class="flex gap-4 border-b border-slate-200 pb-6"><img src={organization.image} alt="" loading="lazy" class="h-20 w-24 shrink-0 bg-slate-100 object-contain" /><div class="min-w-0"><h3 class="text-xl text-primary-900"><a href={organization.href} class="underline decoration-primary-800/40 underline-offset-4">{organization.title} <span aria-hidden="true">{organization.href.startsWith('https:') ? '↗' : '→'}</span></a></h3><p class="mt-2 text-sm leading-6 text-slate-700">{organization.description}</p></div></article>)}</div></section>
    <aside class="border-t border-slate-200 pt-6"><h2 class="text-primary-900">Culture in context</h2><p class="mt-3 max-w-3xl text-base leading-7 text-slate-700">Explore the <a href="/encyclopedia" class="text-primary-800 underline underline-offset-4">Dzaleka Encyclopedia</a> and <a href="/photos" class="text-primary-800 underline underline-offset-4">Photo Archive</a> for more community history and documentation.</p><details class="mt-4"><summary class="min-h-[44px] cursor-pointer py-3 text-sm font-medium text-primary-800">Further reading about cultural work</summary><ul class="space-y-3 py-3 text-sm text-primary-800"><li><a class="underline underline-offset-4" href="https://blogs.worldbank.org/nasikiliza/breaking-mold-refugees-founding-tumaini-festival-dzaleka-refugee-camp-malawi">World Bank: the founding of Tumaini Festival</a></li><li><a class="underline underline-offset-4" href="https://www.wilsoncenter.org/article/refugee-creativity-fun-and-initiative-dzaleka-refugee-camp-malawi">Wilson Center: creativity and initiative in Dzaleka</a></li><li><a class="underline underline-offset-4" href="https://seed.uno/enterprise-profiles/kibebe">SEED: Kibebe enterprise profile</a></li></ul></details></aside>
  </div>
</MainLayout>
