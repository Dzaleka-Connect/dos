---
import Layout from '../layouts/Layout.astro';
import MainLayout from '../layouts/MainLayout.astro';

const title = "Photo Guidelines - Dzaleka Heritage Archive";
const description = "Simple tips for taking great photos for the Dzaleka Digital Site Register and Public Art Catalogue.";
---

<MainLayout title={title} description={description}>
  <Layout>
    <!-- Hero Section -->
    <div class="relative bg-gradient-to-br from-blue-900 via-purple-900 to-indigo-900 text-white">
      <div class="absolute inset-0 bg-black/40"></div>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
        <h1 class="text-4xl font-bold sm:text-5xl mb-6">
          Photo Guidelines
        </h1>
        <p class="text-xl text-gray-200 max-w-2xl mx-auto">
          Simple tips for great photos
        </p>
      </div>
    </div>

    <!-- Guidelines Content -->
    <section class="py-16">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Back Button -->
        <div class="mb-8">
          <button 
            onclick="history.back()"
            class="inline-flex items-center text-blue-600 hover:text-blue-700 font-medium"
          >
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back
          </button>
        </div>

        <!-- General Tips -->
        <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">General Tips</h2>
          
          <div class="space-y-4">
            <div class="flex items-start">
              <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Good Lighting</h3>
                <p class="text-gray-600">Natural daylight is best. Avoid harsh shadows and direct sunlight.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Keep It Steady</h3>
                <p class="text-gray-600">Hold your camera steady and keep it level for clear photos.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Show Context</h3>
                <p class="text-gray-600">Include surroundings to show where things are located.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Take Multiple Shots</h3>
                <p class="text-gray-600">Take several photos from different angles to get the best one.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Site Register Tips -->
        <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">For Site Register</h2>
          
          <div class="space-y-4">
            <div class="flex items-start">
              <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Full View</h3>
                <p class="text-gray-600">Show the entire site in one photo.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Important Details</h3>
                <p class="text-gray-600">Take close-up shots of signs, plaques, or special features.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Condition</h3>
                <p class="text-gray-600">Show the current state of the site.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Public Art Tips -->
        <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">For Public Art</h2>
          
          <div class="space-y-4">
            <div class="flex items-start">
              <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Complete Artwork</h3>
                <p class="text-gray-600">Show the entire artwork in one photo.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Materials & Textures</h3>
                <p class="text-gray-600">Take close-ups to show what the artwork is made of.</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center mr-3 mt-1">
                <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-gray-900">Location Context</h3>
                <p class="text-gray-600">Show where the artwork is located in the community.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- File Requirements -->
        <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">File Requirements</h2>
          
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">Format</h3>
              <p class="text-gray-600">JPEG or PNG files</p>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">Size</h3>
              <p class="text-gray-600">Minimum 1200px width</p>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">File Size</h3>
              <p class="text-gray-600">Maximum 10MB per file</p>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">Quality</h3>
              <p class="text-gray-600">Clear, focused images</p>
            </div>
          </div>
        </div>

        <!-- Important Notes -->
        <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6 mb-8">
          <h2 class="text-xl font-bold text-yellow-900 mb-4">Important Notes</h2>
          <ul class="space-y-2 text-yellow-800">
            <li class="flex items-start">
              <svg class="w-5 h-5 text-yellow-600 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
              </svg>
              Always ask permission before photographing people
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-yellow-600 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
              </svg>
              Respect private property and restricted areas
            </li>
            <li class="flex items-start">
              <svg class="w-5 h-5 text-yellow-600 mr-2 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
              </svg>
              Do not damage or disturb sites or artworks
            </li>
          </ul>
        </div>

        <!-- Call to Action -->
        <div class="text-center">
          <p class="text-lg text-gray-600 mb-6">Ready to submit your photos?</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/site-register/submit" class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors">
              Submit to Site Register
            </a>
            <a href="/public-art-catalogue/submit" class="inline-flex items-center justify-center px-6 py-3 bg-purple-600 text-white font-semibold rounded-lg hover:bg-purple-700 transition-colors">
              Submit to Art Catalogue
            </a>
          </div>
        </div>
      </div>
    </section>
  </Layout>
</MainLayout>
