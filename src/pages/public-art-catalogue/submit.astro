---
import MainLayout from '../../layouts/MainLayout.astro';
import FormHeader from '../../components/ui/FormHeader.astro';

const title = "Submit Artwork - Dzaleka Online Services";
const description = "Submit information about public artworks in Dzaleka Refugee Camp for inclusion in our art catalogue.";
---

<MainLayout title={title} description={description}>
    <FormHeader title="Submit an artwork" description="Help document public art in Dzaleka. Add the artist, location, photographs and the story behind the work where known." parent="Public Art Catalogue" href="/public-art-catalogue" />

    <!-- Form Section -->
    <section class="py-10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded border border-slate-200 p-5 sm:p-8">
          <form id="submitForm" action="https://formspree.io/f/xqaaajae" method="POST" class="submission-form space-y-8">
            <!-- Artwork Information -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Artwork information</h2>

              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="artworkTitle" class="block text-sm font-medium text-gray-700 mb-2">
                    Artwork title <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="artworkTitle-hint" class="mb-1 text-sm text-slate-600">Enter artwork title (or mark as 'Untitled')</p>
                  <input aria-describedby="artworkTitle-hint"
                    type="text"
                    id="artworkTitle"
                    name="artworkTitle"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>

                <div>
                  <label for="artistName" class="block text-sm font-medium text-gray-700 mb-2">
                    Artist name
                  </label>
                  <input
                    type="text"
                    id="artistName"
                    name="artistName"
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>
              </div>

              <div class="mt-6">
                <label for="dateInstalled" class="block text-sm font-medium text-gray-700 mb-2">
                  Date installed <span class="font-normal text-slate-600">(optional)</span></label>
                <input
                  type="date"
                  id="dateInstalled"
                  name="dateInstalled"
                  class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                />
              </div>

              <div class="mt-6">
                <label for="materialsUsed" class="block text-sm font-medium text-gray-700 mb-2">
                  Materials used <span class="font-normal text-slate-600">(optional)</span></label>
                <p id="materialsUsed-hint" class="mb-1 text-sm text-slate-600">For example, Acrylic paint, wood, metal</p>
                <input aria-describedby="materialsUsed-hint"
                  type="text"
                  id="materialsUsed"
                  name="materialsUsed"
                  class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                />
              </div>
            </div>

            <!-- Location -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Location</h2>

              <div class="space-y-6">
                <div>
                  <label for="location" class="block text-sm font-medium text-gray-700 mb-2">
                    Location in Dzaleka
                  </label>
                  <p id="location-hint" class="mb-1 text-sm text-slate-600">Describe the specific location of the artwork</p>
                  <input aria-describedby="location-hint"
                    type="text"
                    id="location"
                    name="location"
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>

                <div>
                  <label for="campZone" class="block text-sm font-medium text-gray-700 mb-2">
                    Camp zone location <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="campZone-hint" class="mb-1 text-sm text-slate-600">For example, Zone A, Block 3, near the market</p>
                  <input aria-describedby="campZone-hint"
                    type="text"
                    id="campZone"
                    name="campZone"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>
              </div>
            </div>

            <!-- Description & History -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Description & history</h2>

              <div class="space-y-6">
                <div>
                  <label for="description" class="block text-sm font-medium text-gray-700 mb-2">
                    Description
                  </label>
                  <p id="description-hint" class="mb-1 text-sm text-slate-600">Describe the physical appearance, dimensions, colors, and style of the artwork</p>
                  <textarea aria-describedby="description-hint"
                    id="description"
                    name="description"
                    required
                    rows="6"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>

                <div>
                  <label for="history" class="block text-sm font-medium text-gray-700 mb-2">
                    A brief history
                  </label>
                  <p id="history-hint" class="mb-1 text-sm text-slate-600">Tell the story of when and why it was created, including commissioning story if relevant</p>
                  <textarea aria-describedby="history-hint"
                    id="history"
                    name="history"
                    required
                    rows="6"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>

                <div>
                  <label for="culturalSignificance" class="block text-sm font-medium text-gray-700 mb-2">
                    Cultural significance <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="culturalSignificance-hint" class="mb-1 text-sm text-slate-600">Explain the symbolism and meaning behind the piece and how it reflects Dzaleka's history, values, or current events</p>
                  <textarea aria-describedby="culturalSignificance-hint"
                    id="culturalSignificance"
                    name="culturalSignificance"
                    rows="4"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>
              </div>
            </div>

            <!-- Artist Profile -->
            <details class="form-secondary-details">
              <summary>Artist profile (optional)</summary>

              <div class="space-y-6">
                <div>
                  <label for="artistBiography" class="block text-sm font-medium text-gray-700 mb-2">
                    Artist biography <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="artistBiography-hint" class="mb-1 text-sm text-slate-600">Provide a short biography of the artist or art collective</p>
                  <textarea aria-describedby="artistBiography-hint"
                    id="artistBiography"
                    name="artistBiography"
                    rows="4"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>

                <div>
                  <label for="otherWorks" class="block text-sm font-medium text-gray-700 mb-2">
                    Other notable works <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="otherWorks-hint" class="mb-1 text-sm text-slate-600">Mention other notable works by this artist</p>
                  <textarea aria-describedby="otherWorks-hint"
                    id="otherWorks"
                    name="otherWorks"
                    rows="3"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>

                <div>
                  <label for="artistLinks" class="block text-sm font-medium text-gray-700 mb-2">
                    Artist's online presence <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="artistLinks-hint" class="mb-1 text-sm text-slate-600">URL to artist's website, social media, or portfolio</p>
                  <input aria-describedby="artistLinks-hint"
                    type="url"
                    id="artistLinks"
                    name="artistLinks"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>
              </div>
            </details>

            <!-- Additional Information -->
            <details class="form-secondary-details">
              <summary>Additional information (optional)</summary>

              <div class="space-y-6">
                <div>
                  <label for="artSignage" class="block text-sm font-medium text-gray-700 mb-2">
                    Art signage <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="artSignage-hint" class="mb-1 text-sm text-slate-600">Full transcription of any plaques or accompanying text</p>
                  <textarea aria-describedby="artSignage-hint"
                    id="artSignage"
                    name="artSignage"
                    rows="3"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>

                <div>
                  <label for="maintenanceNotes" class="block text-sm font-medium text-gray-700 mb-2">
                    Maintenance notes <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="maintenanceNotes-hint" class="mb-1 text-sm text-slate-600">Describe preservation needs or restoration history</p>
                  <textarea aria-describedby="maintenanceNotes-hint"
                    id="maintenanceNotes"
                    name="maintenanceNotes"
                    rows="3"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>

                <div>
                  <label for="communityReactions" class="block text-sm font-medium text-gray-700 mb-2">
                    Community reactions <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="communityReactions-hint" class="mb-1 text-sm text-slate-600">Include quotes, short stories, or public reactions to the artwork</p>
                  <textarea aria-describedby="communityReactions-hint"
                    id="communityReactions"
                    name="communityReactions"
                    rows="4"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>
              </div>
            </details>

            <!-- Photos -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Photos</h2>

              <div>
                <p class="block text-sm font-medium text-gray-700 mb-2">
                  Upload photos
                </p>
                <div class="border-2 border-dashed border-gray-300 rounded p-6 text-center">
                  <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                    <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <div class="mt-4">
                    <label for="photo-upload" class="mb-2 block text-sm font-medium text-slate-700">Select photographs</label>
                    <input id="photo-upload" data-error-required="Choose at least one photograph." name="photos" type="file" multiple accept="image/*" class="block w-full" aria-describedby="photoUploadStatus" required />
                  </div>
                  <p class="mt-2 text-sm text-gray-600">
                    Upload multiple photos: full view + detail shots showing different angles and important elements
                  </p>
                  <p id="photoUploadStatus" role="status" class="text-sm mt-2"></p>
                </div>
              </div>
              <!-- Hidden field for uploaded photo URLs -->
              <input type="hidden" name="photoUrls" id="photoUrlsInput" />
            </div>

            <!-- Contributor Information -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Contributor information</h2>

              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="contributorName" class="block text-sm font-medium text-gray-700 mb-2">
                    Your name
                  </label>
                  <input
                    type="text"
                    id="contributorName"
                    name="contributorName"
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>

                <div>
                  <label for="contributorEmail" class="block text-sm font-medium text-gray-700 mb-2">
                    Your email
                  </label>
                  <input
                    type="email"
                    id="contributorEmail"
                    name="contributorEmail"
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>
              </div>

              <div class="mt-6">
                <div class="flex items-start">
                  <input
                    type="checkbox"
                    id="consent"
                    data-error-required="Confirm that the information is accurate and you give permission to publish it."
                    name="consent"
                    required
                    class="mt-1 h-4 w-4 text-slate-600 focus:ring-slate-500 border-gray-300 rounded"
                  />
                  <label for="consent" class="ml-2 block text-sm text-gray-700">
                    I confirm this information is accurate and I give permission for it to be published on Dzaleka Online Services.
                  </label>
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="flex justify-center">
              <button
                type="submit"
                id="submitButton"
                class="min-h-[44px] bg-primary-900 text-white px-8 py-3 rounded font-semibold hover:bg-primary-800 transition-colors focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 disabled:opacity-50"
              >
                <span id="submitText">Submit artwork</span>
                <span id="submitSpinner" class="hidden">
                  <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </span>
              </button>
            </div>

          </form>
        </div>
      </div>
    </section>

  <script>
    import { initRecordSubmission } from '../../utils/recordSubmission';
    initRecordSubmission(document.getElementById('submitForm') as HTMLFormElement, 'artwork');
  </script>
</MainLayout>
