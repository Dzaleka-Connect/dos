---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

export async function getStaticPaths() {
  let artworks = [];
  try {
    artworks = Object.values(import.meta.glob('../../content/artworks/*.md', { eager: true }));
  } catch (error) {
    console.error('Error loading artworks:', error);
    artworks = [];
  }

  artworks.sort((a, b) => {
    if (a.frontmatter.featured && !b.frontmatter.featured) return -1;
    if (!a.frontmatter.featured && b.frontmatter.featured) return 1;
    return a.frontmatter.title.localeCompare(b.frontmatter.title);
  });

  const itemsPerPage = 9;
  const totalPages = Math.ceil(artworks.length / itemsPerPage);

  return Array.from({ length: totalPages }, (_, index) => ({
    params: { page: String(index + 1) }
  }));
}

const { page } = Astro.params;
const currentPage = parseInt(page) || 1;
const itemsPerPage = 9;

let artworks = [];
try {
  artworks = Object.values(import.meta.glob('../../content/artworks/*.md', { eager: true }));
} catch (error) {
  console.error('Error loading artworks:', error);
  artworks = [];
}

let spotlightArtists = [];
try {
  const allArtists = Object.values(import.meta.glob('../../content/artists/*.md', { eager: true }));
  spotlightArtists = allArtists.filter((artist) => artist.frontmatter.spotlight).slice(0, 6);
} catch (error) {
  console.error('Error loading artist spotlight:', error);
  spotlightArtists = [];
}

artworks.sort((a, b) => {
  if (a.frontmatter.featured && !b.frontmatter.featured) return -1;
  if (!a.frontmatter.featured && b.frontmatter.featured) return 1;
  return a.frontmatter.title.localeCompare(b.frontmatter.title);
});

const totalItems = artworks.length;
const totalPages = Math.ceil(totalItems / itemsPerPage);
const startIndex = (currentPage - 1) * itemsPerPage;
const endIndex = startIndex + itemsPerPage;
const currentArtworks = artworks.slice(startIndex, endIndex);

const pagination = {
  currentPage,
  totalPages,
  totalItems,
  hasNextPage: currentPage < totalPages,
  hasPrevPage: currentPage > 1,
  nextPage: currentPage + 1,
  prevPage: currentPage - 1,
  startItem: startIndex + 1,
  endItem: Math.min(endIndex, totalItems)
};

const title = currentPage === 1 ? 'Dzaleka Public Art Catalogue' : `Dzaleka Public Art Catalogue - Page ${currentPage}`;
const description = 'Explore artworks, artists, and public visual culture documented across Dzaleka Refugee Camp.';

const summaryStats = [
  { label: 'Documented artworks', value: totalItems },
  { label: 'Current page', value: currentPage },
  { label: 'Spotlight artists', value: spotlightArtists.length }
];

const getPageHref = (pageNumber) => pageNumber === 1 ? '/public-art-catalogue' : `/public-art-catalogue/${pageNumber}`;
---

<MainLayout title={title} description={description} canonical="https://services.dzaleka.com/public-art-catalogue">
  {/* Schema.org ItemList Structured Data */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Dzaleka Public Art Catalogue",
    "description": description,
    "url": "https://services.dzaleka.com/public-art-catalogue",
    "numberOfItems": totalItems,
    "itemListElement": currentArtworks.map((artwork, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": artwork.frontmatter.title,
      "url": `https://services.dzaleka.com/public-art-catalogue/${artwork.file.split('/').pop().replace('.md', '')}`
    }))
  })} />
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-8">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Public Art Catalogue' }
          ]}
        />
      </div>

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(260px,0.9fr)] lg:items-start">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-sky-700 mb-2">Community Arts Archive</p>
          <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">Public Art Catalogue</h1>
          <p class="mt-4 text-base leading-7 text-slate-600 sm:text-lg">
            Browse public artworks and visual culture documented across Dzaleka, along with artist profiles and related context.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/public-art-catalogue/submit" class="inline-flex items-center rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-800 transition-colors shadow-sm">
              Submit Artwork
            </a>
            <a href="/public-art-catalogue/about" class="inline-flex items-center rounded-lg border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
              About the Catalogue
            </a>
          </div>
        </div>

        <div class="rounded-lg border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-lg font-semibold text-slate-900">Independent archive</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">
            This is an independent catalogue documenting artworks and artists in Dzaleka. It is not an official institutional archive.
          </p>
          <div class="mt-5 grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
            {summaryStats.map((stat) => (
              <div class="rounded-lg border border-slate-200 bg-white px-4 py-4">
                <div class="text-sm text-slate-500">{stat.label}</div>
                <div class="mt-1 text-2xl font-semibold text-slate-900">{stat.value}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Listings</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900">Artworks on this page</h2>
        </div>
        <p class="text-sm text-slate-500">
          Showing {pagination.startItem} to {pagination.endItem} of {pagination.totalItems}
        </p>
      </div>

      {currentArtworks.length > 0 ? (
        <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {currentArtworks.map((artwork) => {
            const slug = artwork.file.split('/').pop().replace('.md', '');
            return (
              <article class="rounded-lg border border-slate-200 bg-white group">
                <a href={`/public-art-catalogue/${slug}`} class="aspect-[4/3] overflow-hidden border-b border-slate-200 bg-slate-100 block">
                  {artwork.frontmatter.image ? (
                    <img src={artwork.frontmatter.image} alt={artwork.frontmatter.title} class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300" />
                  ) : (
                    <div class="flex h-full items-center justify-center text-slate-400">
                      <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z" />
                      </svg>
                    </div>
                  )}
                </a>

                <div class="p-5">
                  <div class="flex flex-wrap items-center gap-2">
                    {artwork.frontmatter.category && (
                      <span class="rounded-md border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-700">
                        {artwork.frontmatter.category}
                      </span>
                    )}
                    {artwork.frontmatter.featured && (
                      <span class="rounded-md border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700">
                        Featured
                      </span>
                    )}
                  </div>

                  <a href={`/public-art-catalogue/${slug}`} class="block mt-4">
                    <h3 class="text-lg font-semibold text-slate-900 group-hover:text-sky-700 transition-colors">{artwork.frontmatter.title}</h3>
                  </a>
                  {artwork.frontmatter.artistName && (
                    <p class="mt-2 text-sm text-slate-500">by {artwork.frontmatter.artistName}</p>
                  )}
                  <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-600">
                    {artwork.frontmatter.description || 'Description not yet available.'}
                  </p>

                  <div class="mt-5">
                    <a href={`/public-art-catalogue/${slug}`} class="inline-flex items-center text-sm font-medium text-slate-700 hover:text-sky-700 transition-colors">
                      View artwork Details &rarr;
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="mt-6 rounded-lg border border-slate-200 bg-white p-8 text-center">
          <h3 class="text-lg font-semibold text-slate-900">No artworks yet</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Be the first to add an artwork to the catalogue.
          </p>
        </div>
      )}
    </section>

    {totalPages > 1 && (
      <section class="mt-10 rounded-lg border border-slate-200 bg-white p-5">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-2">
            {pagination.hasPrevPage ? (
              <a href={getPageHref(pagination.prevPage)} class="inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">
                Previous
              </a>
            ) : (
              <span class="inline-flex items-center rounded-lg border border-slate-200 px-4 py-2 text-sm text-slate-400">Previous</span>
            )}

            <div class="flex items-center gap-1">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
                pageNum === currentPage ? (
                  <span class="inline-flex items-center rounded-lg border border-slate-900 bg-slate-900 px-3 py-2 text-sm font-medium text-white">
                    {pageNum}
                  </span>
                ) : (
                  <a href={getPageHref(pageNum)} class="inline-flex items-center rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">
                    {pageNum}
                  </a>
                )
              ))}
            </div>

            {pagination.hasNextPage ? (
              <a href={getPageHref(pagination.nextPage)} class="inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">
                Next
              </a>
            ) : (
              <span class="inline-flex items-center rounded-lg border border-slate-200 px-4 py-2 text-sm text-slate-400">Next</span>
            )}
          </div>
        </div>
      </section>
    )}

    <section class="mt-10">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Artist spotlight</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900">Selected artist profiles</h2>
        </div>
        <a href="/public-art-catalogue/visual-arts-community" class="text-sm font-medium text-slate-700 hover:text-slate-900">
          View the visual arts community
        </a>
      </div>

      {spotlightArtists.length > 0 ? (
        <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {spotlightArtists.map((artist) => (
            <article class="rounded-lg border border-slate-200 bg-white p-5">
              <div class="flex items-start gap-4">
                <div class="h-16 w-16 overflow-hidden rounded-lg bg-slate-100">
                  {artist.frontmatter.image ? (
                    <img src={artist.frontmatter.image} alt={artist.frontmatter.artistName} class="h-full w-full object-cover" />
                  ) : (
                    <div class="flex h-full items-center justify-center text-slate-400">
                      <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                    </div>
                  )}
                </div>
                <div class="min-w-0 flex-1">
                  <h3 class="text-lg font-semibold text-slate-900">{artist.frontmatter.artistName}</h3>
                  <p class="mt-1 text-sm text-slate-500">{artist.frontmatter.medium}</p>
                  <p class="mt-3 line-clamp-2 text-sm leading-6 text-slate-600">{artist.frontmatter.bio}</p>
                  <div class="mt-4">
                    <a
                      href={`/public-art-catalogue/artist/${artist.file.split('/').pop().replace('.md', '')}`}
                      class="text-sm font-medium text-slate-700 hover:text-slate-900"
                    >
                      View profile
                    </a>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-6 rounded-lg border border-slate-200 bg-white p-8 text-center">
          <h3 class="text-lg font-semibold text-slate-900">No spotlight artists yet</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Artist spotlight profiles will appear here when available.
          </p>
        </div>
      )}
    </section>

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-semibold text-slate-900">Submit artwork</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          Add a public artwork to the catalogue with location, history, and artist details.
        </p>
        <a href="/public-art-catalogue/submit" class="mt-5 inline-block text-sm font-medium text-slate-700 hover:text-slate-900">
          Submit now
        </a>
      </div>

      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-semibold text-slate-900">Report an issue</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          Send corrections or flag problems with an artwork listing.
        </p>
        <a href="/public-art-catalogue/report-issue" class="mt-5 inline-block text-sm font-medium text-slate-700 hover:text-slate-900">
          Report now
        </a>
      </div>
    </section>
  </div>
</MainLayout>

<style>
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
