---
export async function getStaticPaths() {
  const artworks = Object.values(import.meta.glob('../../content/artworks/*.md', { eager: true }));
  return Array.from({ length: Math.max(1, Math.ceil(artworks.length / 9)) }, (_, i) => ({ params: { page: String(i + 1) } }));
}
const currentPage = Number(Astro.params.page);
return Astro.redirect(currentPage === 1 ? '/public-art-catalogue' : `/public-art-catalogue?page=${currentPage}`, 301);
---
