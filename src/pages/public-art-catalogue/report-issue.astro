---
import MainLayout from '../../layouts/MainLayout.astro';
import FormHeader from '../../components/ui/FormHeader.astro';

const title = "Report an artwork issue | Dzaleka Online Services";
const description = "Report issues, damage, or maintenance needs for public artworks in the Dzaleka Online Services.";
---

<MainLayout title={title} description={description}>
    <FormHeader title="Report an artwork issue" description="Report damage, missing details or access concerns. Include the artwork’s location and a photograph if it helps explain the issue." parent="Public Art Catalogue" href="/public-art-catalogue" />

    <!-- Form Section -->
    <section class="py-10 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded border border-slate-200 p-5 sm:p-8">
          <form id="reportForm" action="https://formspree.io/f/xqaaajae" method="POST" class="submission-form space-y-8">
            <!-- Artwork Information -->
            <div>
              <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-slate-100 text-slate-600 border border-slate-200 flex items-center justify-center text-sm">1</span>
                Artwork Information
              </h2>

              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="artworkTitle" class="block text-sm font-medium text-gray-700 mb-2">
                    Artwork title
                  </label>
                  <input
                    type="text"
                    id="artworkTitle"
                    name="artworkTitle"
                    required
                    class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-shadow bg-gray-50 focus:bg-white"
                  />
                </div>

                <div>
                  <label for="artistName" class="block text-sm font-medium text-gray-700 mb-2">
                    Artist name <span class="font-normal text-slate-600">(optional)</span></label>
                  <input
                    type="text"
                    id="artistName"
                    name="artistName"
                    class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-shadow bg-gray-50 focus:bg-white"
                  />
                </div>
              </div>

              <div class="mt-6">
                <label for="artworkLocation" class="block text-sm font-medium text-gray-700 mb-2">
                  Artwork location
                </label>
                <p id="artworkLocation-hint" class="mb-1 text-sm text-slate-600">Describe the specific location of the artwork</p>
                <input aria-describedby="artworkLocation-hint"
                  type="text"
                  id="artworkLocation"
                  name="artworkLocation"
                  required
                  class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-shadow bg-gray-50 focus:bg-white"
                />
              </div>
            </div>

            <hr class="border-gray-100" />

            <!-- Issue Details -->
            <div>
              <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-slate-100 text-slate-600 border border-slate-200 flex items-center justify-center text-sm">2</span>
                Issue Details
              </h2>

              <div class="space-y-6">
                <div>
                  <fieldset>
                    <legend class="text-sm font-medium text-gray-700 mb-2">Type of issue</legend>
                    <div class="mt-2 space-y-2">
                      <div class="flex items-start gap-3">
                        <input type="radio" id="issueType-1" name="issueType" value="damage" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="issueType-1" class="text-sm text-gray-700">Physical damage</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="issueType-2" name="issueType" value="vandalism" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="issueType-2" class="text-sm text-gray-700">Vandalism</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="issueType-3" name="issueType" value="weather" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="issueType-3" class="text-sm text-gray-700">Weather damage</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="issueType-4" name="issueType" value="fading" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="issueType-4" class="text-sm text-gray-700">Paint fading</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="issueType-5" name="issueType" value="structural" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="issueType-5" class="text-sm text-gray-700">Structural issues</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="issueType-6" name="issueType" value="safety" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="issueType-6" class="text-sm text-gray-700">Safety hazard</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="issueType-7" name="issueType" value="maintenance" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="issueType-7" class="text-sm text-gray-700">Maintenance needed</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="issueType-8" name="issueType" value="other" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="issueType-8" class="text-sm text-gray-700">Other</label>
                      </div>
                    </div>
                  </fieldset>
                </div>

                <div>
                  <label for="issueDescription" class="block text-sm font-medium text-gray-700 mb-2">
                    Detailed description
                  </label>
                  <p id="issueDescription-hint" class="mb-1 text-sm text-slate-600">Provide a detailed description of the issue, including the extent of damage, when you first noticed it, and any other relevant details</p>
                  <textarea aria-describedby="issueDescription-hint"
                    id="issueDescription"
                    name="issueDescription"
                    required
                    rows="6"
                    class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-shadow bg-gray-50 focus:bg-white resize-none"
                  ></textarea>
                </div>

                <div>
                  <fieldset>
                    <legend class="text-sm font-medium text-gray-700 mb-2">Urgency level</legend>
                    <div class="mt-2 space-y-2">
                      <div class="flex items-start gap-3">
                        <input type="radio" id="urgency-1" name="urgency" value="low" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="urgency-1" class="text-sm text-gray-700">Low: minor cosmetic issues</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="urgency-2" name="urgency" value="medium" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="urgency-2" class="text-sm text-gray-700">Medium: noticeable damage, needs attention</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="urgency-3" name="urgency" value="high" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="urgency-3" class="text-sm text-gray-700">High: significant damage, urgent attention needed</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="urgency-4" name="urgency" value="critical" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="urgency-4" class="text-sm text-gray-700">Critical: safety hazard or severe damage</label>
                      </div>
                    </div>
                  </fieldset>
                </div>
              </div>
            </div>

            <hr class="border-gray-100" />

            <!-- Photos -->
            <div>
              <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-slate-100 text-slate-600 border border-slate-200 flex items-center justify-center text-sm">3</span>
                Photos of the Issue
              </h2>

              <div>
                <label for="photos" class="block text-sm font-medium text-gray-700 mb-2">
                  Upload photos
                </label>
                <div class="border-2 border-dashed border-slate-200 bg-slate-50/50 rounded p-5 sm:p-8 text-center hover:bg-slate-50 transition-colors">
                  <svg class="mx-auto h-12 w-12 text-slate-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                    <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <div class="mt-4">
                    <label for="photo-upload" class="mb-2 block text-sm font-medium text-slate-700">Select photographs <span class="font-normal text-slate-600">(optional)</span></label>
                    <input id="photo-upload" name="photos" type="file" multiple accept="image/*" class="block w-full" aria-describedby="photoUploadStatus" />
                  </div>
                  <p class="mt-2 text-sm text-gray-500">
                    Upload photos showing the damage or issue (optional but helpful)
                  </p>
                  <p id="photoUploadStatus" role="status" class="text-sm mt-2 font-medium"></p>
                </div>
              </div>
              <!-- Hidden field for uploaded photo URLs -->
              <input type="hidden" name="photoUrls" id="photoUrlsInput" />
            </div>

            <hr class="border-gray-100" />

            <!-- Contact Information -->
            <div>
              <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-slate-100 text-slate-600 border border-slate-200 flex items-center justify-center text-sm">4</span>
                Your Contact Information
              </h2>

              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="reporterName" class="block text-sm font-medium text-gray-700 mb-2">
                    Your name
                  </label>
                  <input
                    type="text"
                    id="reporterName"
                    name="reporterName"
                    required
                    class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-shadow bg-gray-50 focus:bg-white"
                  />
                </div>

                <div>
                  <label for="reporterEmail" class="block text-sm font-medium text-gray-700 mb-2">
                    Your email
                  </label>
                  <input
                    type="email"
                    id="reporterEmail"
                    name="reporterEmail"
                    required
                    class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-shadow bg-gray-50 focus:bg-white"
                  />
                </div>
              </div>

              <div class="mt-6">
                <label for="reporterPhone" class="block text-sm font-medium text-gray-700 mb-2">
                  Phone number <span class="font-normal text-slate-600">(optional)</span></label>
                <input
                  type="tel"
                  id="reporterPhone"
                  name="reporterPhone"
                  class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-shadow bg-gray-50 focus:bg-white"
                />
              </div>
            </div>

            <hr class="border-gray-100" />

            <!-- Additional Information -->
            <div>
              <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-slate-100 text-slate-600 border border-slate-200 flex items-center justify-center text-sm">5</span>
                Additional Information
              </h2>

              <div class="space-y-6">
                <div>
                  <label for="suggestions" class="block text-sm font-medium text-gray-700 mb-2">
                    Suggestions for resolution <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="suggestions-hint" class="mb-1 text-sm text-slate-600">Any suggestions for how this issue could be resolved or prevented in the future</p>
                  <textarea aria-describedby="suggestions-hint"
                    id="suggestions"
                    name="suggestions"
                    rows="4"
                    class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-shadow bg-gray-50 focus:bg-white resize-none"
                  ></textarea>
                </div>

                <div>
                  <label for="additionalInfo" class="block text-sm font-medium text-gray-700 mb-2">
                    Additional information <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="additionalInfo-hint" class="mb-1 text-sm text-slate-600">Any other relevant information that might help us understand or address the issue</p>
                  <textarea aria-describedby="additionalInfo-hint"
                    id="additionalInfo"
                    name="additionalInfo"
                    rows="3"
                    class="w-full px-4 py-3 border border-gray-200 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent transition-shadow bg-gray-50 focus:bg-white resize-none"
                  ></textarea>
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="flex justify-center pt-4">
              <button
                type="submit"
                id="submitButton"
                class="min-h-[44px] w-full sm:w-auto px-8 py-4 bg-primary-900 text-white rounded font-semibold hover:bg-primary-800 transition-colors focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                <span id="submitText">Report an artwork issue</span>
                <span id="submitSpinner" class="hidden">
                  <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </span>
              </button>
            </div>

            <!-- Success Message -->
            <div id="successMessage" role="status" tabindex="-1" class="hidden mt-4 rounded bg-green-50 p-4 border border-green-100">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-green-800">Issue reported. We'll review it and take appropriate action.</p>
                </div>
              </div>
            </div>

            <!-- Error Message -->
            <div id="errorMessage" role="alert" tabindex="-1" class="hidden mt-4 rounded bg-red-50 p-4 border border-red-100">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-red-800">Error reporting issue. Try again.</p>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </section>

  <script>
    import { prefillRecordForm } from '../../utils/recordForm';
    const form = document.getElementById('reportForm') as HTMLFormElement;
    const submitButton = document.getElementById('submitButton') as HTMLButtonElement;
    const submitText = document.getElementById('submitText') as HTMLElement;
    const submitSpinner = document.getElementById('submitSpinner') as HTMLElement;
    const successMessage = document.getElementById('successMessage') as HTMLElement;
    const errorMessage = document.getElementById('errorMessage') as HTMLElement;
    const photoInput = document.getElementById('photo-upload') as HTMLInputElement;
    const photoUrlsInput = document.getElementById('photoUrlsInput') as HTMLInputElement;
    const photoUploadStatus = document.getElementById('photoUploadStatus') as HTMLElement;

    async function uploadToCloudinary(file: File, statusElement: HTMLElement) {
      statusElement.textContent = 'Uploading...';
      statusElement.classList.remove('text-red-500', 'text-green-500');

      try {
        const formData = new FormData();
        formData.append('file', file);
        formData.append('upload_preset', 'dzaleka_events');

        const response = await fetch(
          'https://api.cloudinary.com/v1_1/dcvwslmow/upload',
          {
            method: 'POST',
            body: formData
          }
        );

        const data = await response.json();

        if (data.secure_url) {
          statusElement.textContent = 'Upload complete.';
          statusElement.classList.add('text-green-500');
          return data.secure_url;
        } else {
          throw new Error('Upload failed');
        }
      } catch (error) {
        console.error('Upload error:', error);
        statusElement.textContent = 'Upload failed. Try again.';
        statusElement.classList.add('text-red-500');
        return null;
      }
    }

    // Add file upload handler
    photoInput.addEventListener('change', async () => {
      const files = photoInput.files;
      if (files) {
        const urls = [];
        for (let i = 0; i < files.length; i++) {
          const url = await uploadToCloudinary(files[i], photoUploadStatus);
          if (url) urls.push(url);
        }
        photoUrlsInput.value = JSON.stringify(urls);
      }
    });

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Show loading state
        submitButton.disabled = true;
        submitText.classList.add('hidden');
        submitSpinner.classList.remove('hidden');
        successMessage.classList.add('hidden');
        errorMessage.classList.add('hidden');

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: {
              'Accept': 'application/json'
            }
          });

          const data = await response.json();

          if (response.ok) {
            // Show success message
            form.reset();
            successMessage.classList.remove('hidden');
            successMessage.focus();
          } else {
            throw new Error(data.error || 'Error reporting issue');
          }
        } catch (error) {
          // Show error message
          console.error('Submission error:', error);
          errorMessage.classList.remove('hidden');
          errorMessage.focus();
        } finally {
          // Reset button state
          submitButton.disabled = false;
          submitText.classList.remove('hidden');
          submitSpinner.classList.add('hidden');
        }
      });
    }

    if (form) prefillRecordForm(form, new URLSearchParams(window.location.search), ['artworkTitle', 'artistName', 'artworkLocation']);
  </script>
</MainLayout>
