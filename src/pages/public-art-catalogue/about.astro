---
import Layout from '../../layouts/Layout.astro';
import MainLayout from '../../layouts/MainLayout.astro';

const title = "About Dzaleka Online Services";
const description = "Learn about the independent digital collection that showcases and preserves public artworks in Dzaleka Refugee Camp.";
---

<MainLayout title={title} description={description}>
  <Layout>
    <!-- Hero Section -->
    <div class="relative bg-gradient-to-br from-purple-900 via-pink-900 to-red-900 text-white">
      <div class="absolute inset-0 bg-black/60"></div>
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
        <div class="mb-6">
          <span class="inline-flex items-center px-3 py-1 bg-white/10 backdrop-blur-sm rounded-full text-sm text-white/90">
            About This Project
          </span>
        </div>
        
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold mb-6 leading-tight">
          About Dzaleka<br/>
          <span class="text-pink-300">Public Art Catalogue</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-gray-200 max-w-3xl mx-auto mb-10 leading-relaxed">
          An independent digital collection celebrating creativity and cultural expression in Dzaleka Refugee Camp
        </p>
      </div>
    </div>

    <!-- About Section -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-purple-50 rounded-xl p-8 mb-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">About This Project</h2>
          <p class="text-gray-700 mb-6 leading-relaxed">
            The Dzaleka Online Services is an <strong>independent digital collection</strong> showcasing artworks around Dzaleka Refugee Camp. 
            It is <strong>not connected to camp management</strong>. The catalogue documents murals, sculptures, installations, and other public artworks, 
            telling the story of each piece and its creator.
          </p>
          <p class="text-gray-700 leading-relaxed">
            Every listing includes photos, location details, the history of the work, and its cultural meaning.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <!-- Recognition for Artists - Portrait Style -->
          <div class="relative bg-gradient-to-br from-purple-50 to-violet-100 rounded-2xl p-8 overflow-hidden group hover:shadow-xl transition-all duration-300">
            <div class="absolute top-0 right-0 w-24 h-24 bg-purple-200 rounded-full -mr-12 -mt-12 opacity-50 group-hover:scale-110 transition-transform"></div>
            <div class="relative z-10">
              <div class="w-16 h-16 bg-purple-600 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-purple-900 mb-4">Recognition for Artists</h3>
              <p class="text-purple-800 leading-relaxed">
                The catalogue honours the creative work of people in Dzaleka, regardless of official recognition.
              </p>
            </div>
          </div>

          <!-- Uncovering Stories - Eye Style -->
          <div class="relative bg-gradient-to-br from-pink-50 to-rose-100 rounded-2xl p-8 overflow-hidden group hover:shadow-xl transition-all duration-300">
            <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width="40" height="40" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23F472B6" fill-opacity="0.1"%3E%3Ccircle cx="20" cy="20" r="1"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-60"></div>
            <div class="relative z-10">
              <div class="w-16 h-16 bg-pink-600 rounded-full flex items-center justify-center mb-6 group-hover:scale-110 transition-transform">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-pink-900 mb-4">Uncovering Stories</h3>
              <p class="text-pink-800 leading-relaxed">
                Public art often reflects community experiences and aspirations; this project makes those stories visible.
              </p>
            </div>
          </div>

          <!-- Inspiring Creativity - Lightning Style -->
          <div class="relative bg-gradient-to-br from-red-50 to-orange-100 rounded-2xl p-8 overflow-hidden group hover:shadow-xl transition-all duration-300">
            <div class="absolute top-0 right-0 w-32 h-32 bg-red-200 rounded-full -mr-16 -mt-16 opacity-30 group-hover:scale-110 transition-transform"></div>
            <div class="absolute bottom-0 left-0 w-20 h-20 bg-orange-300 rounded-full -ml-10 -mb-10 opacity-40 group-hover:scale-110 transition-transform"></div>
            <div class="relative z-10">
              <div class="w-16 h-16 bg-gradient-to-br from-red-500 to-orange-600 rounded-lg flex items-center justify-center mb-6 group-hover:rotate-12 transition-transform">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-red-900 mb-4">Inspiring Creativity</h3>
              <p class="text-red-800 leading-relaxed">
                By showcasing public art, others may be encouraged to create and share their own work.
              </p>
            </div>
          </div>

          <!-- Long-term Record - Document Style -->
          <div class="relative bg-gradient-to-br from-indigo-50 to-blue-100 rounded-2xl p-8 overflow-hidden group hover:shadow-xl transition-all duration-300">
            <div class="absolute top-4 right-4 w-16 h-20 bg-indigo-300 rounded-sm transform rotate-12 opacity-30 group-hover:rotate-0 transition-transform"></div>
            <div class="absolute top-6 right-6 w-12 h-16 bg-indigo-400 rounded-sm transform rotate-6 opacity-40 group-hover:rotate-0 transition-transform"></div>
            <div class="relative z-10">
              <div class="w-16 h-16 bg-indigo-600 rounded-2xl flex items-center justify-center mb-6 transform -rotate-6 group-hover:rotate-0 transition-transform">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-indigo-900 mb-4">Long-term Record</h3>
              <p class="text-indigo-800 leading-relaxed">
                Even if a piece disappears or fades, its image and story remain in the catalogue.
              </p>
            </div>
          </div>
        </div>

        <!-- Global Access - World Style -->
        <div class="relative bg-gradient-to-br from-yellow-50 to-amber-100 rounded-2xl p-8 overflow-hidden group hover:shadow-xl transition-all duration-300">
          <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23F59E0B" fill-opacity="0.1"%3E%3Ccircle cx="30" cy="30" r="1"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-40"></div>
          <div class="relative z-10 text-center">
            <div class="w-20 h-20 bg-gradient-to-br from-yellow-500 to-amber-600 rounded-full flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform">
              <svg class="w-10 h-10 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-yellow-900 mb-4">Global Access</h3>
            <p class="text-yellow-800 leading-relaxed max-w-2xl mx-auto">
              Sharing online connects Dzaleka's creative voices with people everywhere.
            </p>
          </div>
        </div>

        <!-- Navigation -->
        <div class="mt-12 text-center">
          <a href="/public-art-catalogue" class="inline-flex items-center bg-purple-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-purple-700 transition-colors">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Back to Art Catalogue
          </a>
        </div>
      </div>
    </section>
  </Layout>
</MainLayout>
