---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

const title = "Visual Arts Community | Dzaleka Public Art & Visual Culture";
const description = "Meet the talented visual artists from Dzaleka Refugee Camp who are part of the Dzaleka Art Project, contributing to the vibrant artistic community.";

// Artists from Dzaleka Art Project website
const visualArtists = [
  { name: "Kakozi Fariala", role: "Visual Artist", id: "kakozi-fariala" },
  { name: "Nyanduhuro Jacqueline", role: "Visual Artist", id: "nyanduhuro-jacqueline" },
  { name: "Paulin Engambee", role: "Visual Artist", id: "paulin-engambee" },
  { name: "Wabangwebangwe Francois", role: "Visual Artist", id: "wabangwebangwe-francois" },
  { name: "Richesse Kabamba", role: "Visual Artist", id: "richesse-kabamba" },
  { name: "Xavera Nyirazaninka", role: "Visual Artist", id: "xavera-nyirazaninka" },
  { name: "Serge Kasongo", role: "Team Leader for Visual Arts", id: "serge-kasongo" },
  { name: "Paul Kabobya", role: "Visual Artist", id: "paul-kabobya" },
  { name: "Niyitegeka Consilie", role: "Visual Artist", id: "niyitegeka-consilie" },
  { name: "Riziki Nyembo", role: "Visual Artist", id: "riziki-nyembo" },
  { name: "Kiputa Ninda", role: "Visual Artist", id: "kiputa-ninda" },
  { name: "Kabarinda Ernest", role: "Visual Artist", id: "kabarinda-ernest" },
  { name: "Imani Kiza", role: "Visual Artist", id: "imani-kiza" },
  { name: "Frank Liamba", role: "Visual Artist", id: "frank-liamba" },
  { name: "Boanerges Jean-Luc", role: "Visual Artist", id: "boanerges-jean-luc" },
  { name: "Annuarite Kat", role: "Visual Artist", id: "annuarite-kat" },
  { name: "Ibila Kililo Joseph", role: "Visual Artist", id: "ibila-kililo-joseph" },
  { name: "Jonathan Kizazi", role: "Visual Artist", id: "jonathan-kizazi" },
  { name: "Muniyo Shuti Clementine", role: "Visual Artist", id: "muniyo-shuti-clementine" },
  { name: "Mwanbyake Sanginga Musole", role: "Visual Artist", id: "mwanbyake-sanginga-musole" },
  { name: "Aksanti Murhebwa", role: "Visual Artist", id: "aksanti-murhebwa" },
  { name: "Nelly", role: "Visual Artist", id: "nelly" },
  { name: "Misago Merida", role: "Visual Artist", id: "misago-merida" },
  { name: "Philippe Mputu", role: "Visual Artist", id: "philippe-mputu" }
];
---

<MainLayout title={title} description={description}>
    <section class="border-b border-slate-200 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="mb-8">
          <Breadcrumb
            items={[
              { label: 'Home', href: '/' },
              { label: 'Public Art Catalogue', href: '/public-art-catalogue' },
              { label: 'Visual Arts Community' }
            ]}
          />
        </div>
      </div>
    </section>

    <div class="relative bg-white">
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold mb-6 leading-tight text-gray-900">
          Visual Arts<br/>
          <span class="text-slate-700">Community</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-gray-600 max-w-3xl mx-auto mb-10 leading-relaxed">
          Meet the talented visual artists from Dzaleka Refugee Camp who are part of the Dzaleka Art Project
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#artists" class="inline-flex items-center px-6 py-3 bg-gray-900 text-white font-semibold rounded-lg hover:bg-gray-800 transition-colors">
            Meet the Artists
          </a>
          <a href="https://www.dzalekaartproject.com/visualarts.html" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-6 py-3 bg-white text-gray-700 font-semibold rounded-lg border border-gray-200 hover:bg-gray-50 transition-colors">
            Visit Dzaleka Art Project
          </a>
        </div>
      </div>
    </div>

    <!-- About Section -->
    <section class="py-16 bg-white">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Authentic Stories of Resilience & Creativity</h2>
          <p class="text-lg text-gray-600 max-w-3xl mx-auto">
            Discover the powerful narratives behind the art, shaped by experiences of displacement, resilience, and hope.
          </p>
        </div>
          
        <div class="grid md:grid-cols-2 gap-12 mb-16">
          <div class="space-y-8">
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 w-12 h-12 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-center">
                <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2">War & Displacement Experiences</h3>
                <p class="text-gray-600 leading-relaxed">
                  Artists like Serge Kasongo and Annuarite Kat use their art to process and share their experiences of war and forced displacement, turning trauma into powerful visual narratives.
                </p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 w-12 h-12 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-center">
                <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2">Family Tragedies & Resilience</h3>
                <p class="text-gray-600 leading-relaxed">
                  Stories of loss and survival, like Niyitegeka Consilie who cares for nine children, show incredible resilience in the face of tragedy, using art as a means of support and healing.
                </p>
              </div>
            </div>
          </div>
          
          <div class="space-y-8">
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 w-12 h-12 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-center">
                <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2">Artistic Development Paths</h3>
                <p class="text-gray-600 leading-relaxed">
                  From self-taught prodigies to those trained in community clubs, each artist has a unique journey. Many now teach others, passing on their skills to the next generation.
                </p>
              </div>
            </div>
            
            <div class="flex items-start space-x-4">
              <div class="flex-shrink-0 w-12 h-12 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-center">
                <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2">Community Contributions</h3>
                <p class="text-gray-600 leading-relaxed">
                  Artists run businesses serving the community, mentor young talent, and organize exhibitions that bring people together, fostering a sense of belonging and shared culture.
                </p>
              </div>
            </div>
          </div>
        </div>
        
        <div class="bg-gray-50 rounded-2xl p-8 border border-gray-100">
          <h3 class="text-xl font-bold text-gray-900 mb-6 text-center">Business Challenges & Successes</h3>
          <div class="grid md:grid-cols-3 gap-6 text-center">
            <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
              <div class="text-lg font-bold text-red-600 mb-2">Challenges</div>
              <p class="text-sm text-gray-600">Limited materials, low market prices, and restricted mobility affect sustainability.</p>
            </div>
            <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
              <div class="text-lg font-bold text-green-600 mb-2">Successes</div>
              <p class="text-sm text-gray-600">Top artists participate in international exhibitions and earn significant income.</p>
            </div>
            <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
              <div class="text-lg font-bold text-slate-600 mb-2">Innovation</div>
              <p class="text-sm text-gray-600">Using found materials and creating community-based art initiatives.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Artists Grid -->
    <section id="artists" class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Meet the Visual Artists</h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">Each artist has a unique story of survival, resilience, and creative expression.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {visualArtists.map((artist) => {
            const artistImagePath = `/images/artists/${artist.id}.jpg`;
            const hasImage = true; // This will be true when you add the images
            
            return (
              <div class="bg-white rounded-xl border border-slate-200 p-6 hover:border-slate-300 transition-colors group">
                <div class="text-center">
                  <div class="w-24 h-24 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4 border border-slate-200 overflow-hidden">
                    {hasImage ? (
                      <img 
                        src={artistImagePath} 
                        alt={`${artist.name} - ${artist.role}`}
                        class="w-full h-full object-cover rounded-full"
                        loading="lazy"
                        onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                      />
                    ) : null}
                    <svg class="w-10 h-10 text-slate-300" style={hasImage ? "display:none" : ""} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                  </div>
                  <h3 class="text-lg font-bold text-gray-900 mb-1 group-hover:text-slate-700 transition-colors">
                    {artist.name}
                  </h3>
                  <p class="text-sm text-slate-600 font-medium mb-4">{artist.role}</p>
                  <a href={`/public-art-catalogue/artist/${artist.id}`} class="inline-flex items-center text-slate-700 hover:text-slate-900 font-medium text-sm transition-colors">
                    View Profile
                    <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Dzaleka Art Project Reference -->
    <section class="py-16 bg-white border-t border-gray-100">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Dzaleka Art Project</h2>
        <p class="text-gray-600 mb-8 leading-relaxed max-w-2xl mx-auto">
          This visual arts community is part of the Dzaleka Art Project, an initiative that supports and promotes 
          artistic expression within the refugee camp.
        </p>
        <a 
          href="https://www.dzalekaartproject.com/visualarts.html" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center px-8 py-4 bg-gray-900 text-white font-semibold rounded-lg hover:bg-gray-800 transition-colors"
        >
          Visit Dzaleka Art Project
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </section>
</MainLayout>
