---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import CollectionHeader from '../../components/ui/CollectionHeader.astro';
import SearchableDirectory from '../../components/ui/SearchableDirectory.astro';
import CultureNav from '../../components/culture/CultureNav.astro';
const artists = (await getCollection('artists')).sort((a, b) => a.data.artistName.localeCompare(b.data.artistName));
---
<MainLayout title="Visual artists in Dzaleka | Dzaleka Online Services" description="Meet Dzaleka’s visual artists, explore their practices and read their biographies." canonical="https://services.dzaleka.com/public-art-catalogue/visual-arts-community">
  <CollectionHeader title="Visual arts community" description="Meet the artists working in painting, drawing, sculpture and other visual arts in Dzaleka. Explore their practices, work and stories in their own profiles." />
  <CultureNav current="/public-art-catalogue/visual-arts-community" />
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <SearchableDirectory id="artists" title="Artist directory" noun="artists" items={artists.map(artist => ({ title: artist.data.artistName, href: `/public-art-catalogue/artist/${artist.id}`, image: artist.data.image, meta: artist.data.medium }))} />
    <aside class="mt-12 border-t border-slate-200 pt-6"><h2 class="text-primary-900">Explore their work</h2><p class="mt-3 max-w-3xl text-base leading-7 text-slate-700">Find photographed murals in the <a href="/public-art-catalogue" class="text-primary-800 underline underline-offset-4">Public Art Catalogue</a>. For more artist documentation, visit the <a href="https://www.dzalekaartproject.com/visualarts.html" class="text-primary-800 underline underline-offset-4">Dzaleka Art Project</a>.</p></aside>
  </div>
</MainLayout>
