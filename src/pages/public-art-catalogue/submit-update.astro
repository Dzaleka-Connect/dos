---
import MainLayout from '../../layouts/MainLayout.astro';
import FormHeader from '../../components/ui/FormHeader.astro';

const title = "Update an artwork record | Dzaleka Online Services";
const description = "Submit updates, corrections, or additional information for public artworks in the Dzaleka Online Services.";
---

<MainLayout title={title} description={description}>
    <FormHeader title="Update an artwork record" description="Identify the artwork, describe the correction and include a source or context that supports the change." parent="Public Art Catalogue" href="/public-art-catalogue" />

    <!-- Form Section -->
    <section class="py-10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded border border-slate-200 p-5 sm:p-8">
          <form id="updateForm" action="https://formspree.io/f/xqaaajae" method="POST" class="submission-form space-y-8">
            <!-- Artwork Information -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Artwork information</h2>

              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="artworkTitle" class="block text-sm font-medium text-gray-700 mb-2">
                    Artwork title
                  </label>
                  <input
                    type="text"
                    id="artworkTitle"
                    name="artworkTitle"
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>

                <div>
                  <label for="artistName" class="block text-sm font-medium text-gray-700 mb-2">
                    Artist name <span class="font-normal text-slate-600">(optional)</span></label>
                  <input
                    type="text"
                    id="artistName"
                    name="artistName"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>
              </div>

              <div class="mt-6">
                <label for="artworkLocation" class="block text-sm font-medium text-gray-700 mb-2">
                  Artwork location
                </label>
                <p id="artworkLocation-hint" class="mb-1 text-sm text-slate-600">Describe the specific location of the artwork</p>
                <input aria-describedby="artworkLocation-hint"
                  type="text"
                  id="artworkLocation"
                  name="artworkLocation"
                  required
                  class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                />
              </div>
            </div>

            <!-- Update Type -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Type of update</h2>

              <div class="space-y-4">
                <div>
                  <fieldset>
                    <legend class="text-sm font-medium text-gray-700 mb-2">What type of update are you submitting?</legend>
                    <div class="mt-2 space-y-2">
                      <div class="flex items-start gap-3">
                        <input type="radio" id="updateType-1" name="updateType" value="correction" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="updateType-1" class="text-sm text-gray-700">Correction to existing information</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="updateType-2" name="updateType" value="additional" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="updateType-2" class="text-sm text-gray-700">Additional information</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="updateType-3" name="updateType" value="status" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="updateType-3" class="text-sm text-gray-700">Status change (removed, relocated)</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="updateType-4" name="updateType" value="restoration" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="updateType-4" class="text-sm text-gray-700">Restoration or conservation work</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="updateType-5" name="updateType" value="new_photos" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="updateType-5" class="text-sm text-gray-700">New or better photos</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="updateType-6" name="updateType" value="artist_info" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="updateType-6" class="text-sm text-gray-700">Artist information update</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="updateType-7" name="updateType" value="other" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="updateType-7" class="text-sm text-gray-700">Other</label>
                      </div>
                    </div>
                  </fieldset>
                </div>

                <div>
                  <label for="updateDescription" class="block text-sm font-medium text-gray-700 mb-2">
                    Detailed description of update
                  </label>
                  <p id="updateDescription-hint" class="mb-1 text-sm text-slate-600">Provide a detailed description of the update, correction, or additional information you're submitting</p>
                  <textarea aria-describedby="updateDescription-hint"
                    id="updateDescription"
                    name="updateDescription"
                    required
                    rows="6"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>
              </div>
            </div>

            <!-- Specific Updates -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Specific information to update</h2>

              <div class="space-y-6">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-3">
                    Which information needs to be updated? (check all that apply)
                  </label>
                  <div class="space-y-2">
                    <div class="flex items-center">
                      <input type="checkbox" id="updateTitle" name="updateFields" value="title" class="h-4 w-4 text-slate-600 focus:ring-slate-500 border-gray-300 rounded">
                      <label for="updateTitle" class="ml-2 text-sm text-gray-700">Artwork title</label>
                    </div>
                    <div class="flex items-center">
                      <input type="checkbox" id="updateArtist" name="updateFields" value="artist" class="h-4 w-4 text-slate-600 focus:ring-slate-500 border-gray-300 rounded">
                      <label for="updateArtist" class="ml-2 text-sm text-gray-700">Artist information</label>
                    </div>
                    <div class="flex items-center">
                      <input type="checkbox" id="updateLocation" name="updateFields" value="location" class="h-4 w-4 text-slate-600 focus:ring-slate-500 border-gray-300 rounded">
                      <label for="updateLocation" class="ml-2 text-sm text-gray-700">Location</label>
                    </div>
                    <div class="flex items-center">
                      <input type="checkbox" id="updateDescriptionOption" name="updateFields" value="description" class="h-4 w-4 text-slate-600 focus:ring-slate-500 border-gray-300 rounded">
                      <label for="updateDescriptionOption" class="ml-2 text-sm text-gray-700">Description</label>
                    </div>
                    <div class="flex items-center">
                      <input type="checkbox" id="updateHistory" name="updateFields" value="history" class="h-4 w-4 text-slate-600 focus:ring-slate-500 border-gray-300 rounded">
                      <label for="updateHistory" class="ml-2 text-sm text-gray-700">History</label>
                    </div>
                    <div class="flex items-center">
                      <input type="checkbox" id="updatePhotos" name="updateFields" value="photos" class="h-4 w-4 text-slate-600 focus:ring-slate-500 border-gray-300 rounded">
                      <label for="updatePhotos" class="ml-2 text-sm text-gray-700">Photos</label>
                    </div>
                    <div class="flex items-center">
                      <input type="checkbox" id="updateStatus" name="updateFields" value="status" class="h-4 w-4 text-slate-600 focus:ring-slate-500 border-gray-300 rounded">
                      <label for="updateStatus" class="ml-2 text-sm text-gray-700">Current status</label>
                    </div>
                  </div>
                </div>

                <div>
                  <label for="correctedInfo" class="block text-sm font-medium text-gray-700 mb-2">
                    Corrected or additional information <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="correctedInfo-hint" class="mb-1 text-sm text-slate-600">Provide the corrected information or additional details that should be added to the catalogue</p>
                  <textarea aria-describedby="correctedInfo-hint"
                    id="correctedInfo"
                    name="correctedInfo"
                    rows="6"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>
              </div>
            </div>

            <!-- Photos -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">New photos (if applicable)</h2>

              <div>
                <label for="photos" class="block text-sm font-medium text-gray-700 mb-2">
                  Upload new photos
                </label>
                <div class="border-2 border-dashed border-gray-300 rounded p-6 text-center">
                  <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                    <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <div class="mt-4">
                    <label for="photo-upload" class="mb-2 block text-sm font-medium text-slate-700">Select photographs <span class="font-normal text-slate-600">(optional)</span></label>
                    <input id="photo-upload" name="photos" type="file" multiple accept="image/*" class="block w-full" aria-describedby="photoUploadStatus" />
                  </div>
                  <p class="mt-2 text-sm text-gray-600">
                    Upload new or better photos of the artwork (optional)
                  </p>
                  <p id="photoUploadStatus" role="status" class="text-sm mt-2"></p>
                </div>
              </div>
              <!-- Hidden field for uploaded photo URLs -->
              <input type="hidden" name="photoUrls" id="photoUrlsInput" />
            </div>

            <!-- Contact Information -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Your contact information</h2>

              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="contributorName" class="block text-sm font-medium text-gray-700 mb-2">
                    Your name
                  </label>
                  <input
                    type="text"
                    id="contributorName"
                    name="contributorName"
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>

                <div>
                  <label for="contributorEmail" class="block text-sm font-medium text-gray-700 mb-2">
                    Your email
                  </label>
                  <input
                    type="email"
                    id="contributorEmail"
                    name="contributorEmail"
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>
              </div>

              <div class="mt-6">
                <label for="contributorPhone" class="block text-sm font-medium text-gray-700 mb-2">
                  Phone number <span class="font-normal text-slate-600">(optional)</span></label>
                <input
                  type="tel"
                  id="contributorPhone"
                  name="contributorPhone"
                  class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                />
              </div>
            </div>

            <!-- Additional Information -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Additional information</h2>

              <div class="space-y-6">
                <div>
                  <label for="sourceInfo" class="block text-sm font-medium text-gray-700 mb-2">
                    Source of information <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="sourceInfo-hint" class="mb-1 text-sm text-slate-600">How did you obtain this information? (for example, personal knowledge, documents, interviews)</p>
                  <textarea aria-describedby="sourceInfo-hint"
                    id="sourceInfo"
                    name="sourceInfo"
                    rows="3"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>

                <div>
                  <label for="additionalNotes" class="block text-sm font-medium text-gray-700 mb-2">
                    Additional notes <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="additionalNotes-hint" class="mb-1 text-sm text-slate-600">Any other relevant information or context</p>
                  <textarea aria-describedby="additionalNotes-hint"
                    id="additionalNotes"
                    name="additionalNotes"
                    rows="3"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="flex justify-center">
              <button
                type="submit"
                id="submitButton"
                class="min-h-[44px] bg-primary-900 text-white px-8 py-3 rounded font-semibold hover:bg-primary-800 transition-colors focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 disabled:opacity-50"
              >
                <span id="submitText">Update an artwork record</span>
                <span id="submitSpinner" class="hidden">
                  <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </span>
              </button>
            </div>

            <!-- Success Message -->
            <div id="successMessage" role="status" tabindex="-1" class="hidden mt-4 rounded bg-green-50 p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-green-800">Update submitted. We'll review it and update the catalogue.</p>
                </div>
              </div>
            </div>

            <!-- Error Message -->
            <div id="errorMessage" role="alert" tabindex="-1" class="hidden mt-4 rounded bg-red-50 p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-red-800">Error submitting update. Try again.</p>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </section>

  <script>
    import { prefillRecordForm } from '../../utils/recordForm';
    const form = document.getElementById('updateForm') as HTMLFormElement;
    const submitButton = document.getElementById('submitButton') as HTMLButtonElement;
    const submitText = document.getElementById('submitText') as HTMLElement;
    const submitSpinner = document.getElementById('submitSpinner') as HTMLElement;
    const successMessage = document.getElementById('successMessage') as HTMLElement;
    const errorMessage = document.getElementById('errorMessage') as HTMLElement;
    const photoInput = document.getElementById('photo-upload') as HTMLInputElement;
    const photoUrlsInput = document.getElementById('photoUrlsInput') as HTMLInputElement;
    const photoUploadStatus = document.getElementById('photoUploadStatus') as HTMLElement;

    async function uploadToCloudinary(file: File, statusElement: HTMLElement) {
      statusElement.textContent = 'Uploading...';
      statusElement.classList.remove('text-red-500', 'text-green-500');

      try {
        const formData = new FormData();
        formData.append('file', file);
        formData.append('upload_preset', 'dzaleka_events');

        const response = await fetch(
          'https://api.cloudinary.com/v1_1/dcvwslmow/upload',
          {
            method: 'POST',
            body: formData
          }
        );

        const data = await response.json();

        if (data.secure_url) {
          statusElement.textContent = 'Upload complete.';
          statusElement.classList.add('text-green-500');
          return data.secure_url;
        } else {
          throw new Error('Upload failed');
        }
      } catch (error) {
        console.error('Upload error:', error);
        statusElement.textContent = 'Upload failed. Try again.';
        statusElement.classList.add('text-red-500');
        return null;
      }
    }

    // Add file upload handler
    photoInput.addEventListener('change', async () => {
      const files = photoInput.files;
      if (files) {
        const urls = [];
        for (let i = 0; i < files.length; i++) {
          const url = await uploadToCloudinary(files[i], photoUploadStatus);
          if (url) urls.push(url);
        }
        photoUrlsInput.value = JSON.stringify(urls);
      }
    });

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Show loading state
        submitButton.disabled = true;
        submitText.classList.add('hidden');
        submitSpinner.classList.remove('hidden');
        successMessage.classList.add('hidden');
        errorMessage.classList.add('hidden');

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: {
              'Accept': 'application/json'
            }
          });

          const data = await response.json();

          if (response.ok) {
            // Show success message
            form.reset();
            successMessage.classList.remove('hidden');
            successMessage.focus();
          } else {
            throw new Error(data.error || 'Error submitting update');
          }
        } catch (error) {
          // Show error message
          console.error('Submission error:', error);
          errorMessage.classList.remove('hidden');
          errorMessage.focus();
        } finally {
          // Reset button state
          submitButton.disabled = false;
          submitText.classList.remove('hidden');
          submitSpinner.classList.add('hidden');
        }
      });
    }

    if (form) prefillRecordForm(form, new URLSearchParams(window.location.search), ['artworkTitle', 'artistName', 'artworkLocation']);
  </script>
</MainLayout>
