---
import MainLayout from '../../layouts/MainLayout.astro';

const seo = {
  title: "License & Usage Policy - Dzaleka Public Art Catalogue",
  description: "Learn about the licensing terms and usage policies for the Dzaleka Public Art Catalogue content and artwork documentation.",
  type: "website",
  canonical: "https://services.dzaleka.com/public-art-catalogue/license",
  openGraph: {
    title: "License & Usage Policy - Dzaleka Public Art Catalogue",
    description: "Learn about the licensing terms and usage policies for the Dzaleka Public Art Catalogue content and artwork documentation.",
    type: "website",
    site_name: "Dzaleka Public Art Catalogue",
    locale: "en_US",
    url: "https://services.dzaleka.com/public-art-catalogue/license"
  }
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
>
  <div class="min-h-screen bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Back Button -->
      <div class="mb-6">
        <button 
          onclick="history.back()"
          class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back</span>
        </button>
      </div>

      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">License & Usage Policy</h1>
        <p class="text-xl text-gray-600">
          Understanding how you can use and share content from the Dzaleka Public Art Catalogue
        </p>
      </div>

      <!-- Content -->
      <div class="bg-white rounded-xl shadow-sm p-8 space-y-8">
        
        <!-- Overview -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Overview</h2>
          <p class="text-gray-700 leading-relaxed">
            The Dzaleka Public Art Catalogue is an independent documentation project that aims to preserve and share information about public artworks in and around Dzaleka Refugee Camp. This license and usage policy outlines how you can use, share, and contribute to this project.
          </p>
        </section>

        <!-- Creative Commons License -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Creative Commons License</h2>
          <div class="bg-purple-50 border border-purple-200 rounded-lg p-6 mb-6">
            <div class="flex items-center gap-4 mb-4">
              <svg class="w-12 h-12 text-purple-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
              <div>
                <h3 class="text-lg font-semibold text-purple-900">CC BY-NC-SA 4.0</h3>
                <p class="text-purple-700">Attribution-NonCommercial-ShareAlike 4.0 International</p>
              </div>
            </div>
            <p class="text-purple-800">
              This work is licensed under a Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International License.
            </p>
          </div>
          
          <div class="grid md:grid-cols-3 gap-6">
            <div class="text-center p-4 border border-gray-200 rounded-lg">
              <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Attribution</h4>
              <p class="text-sm text-gray-600">You must give appropriate credit to the Dzaleka Public Art Catalogue and contributors.</p>
            </div>
            
            <div class="text-center p-4 border border-gray-200 rounded-lg">
              <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
                </svg>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Non-Commercial</h4>
              <p class="text-sm text-gray-600">You may not use the material for commercial purposes without permission.</p>
            </div>
            
            <div class="text-center p-4 border border-gray-200 rounded-lg">
              <div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z" />
                </svg>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Share Alike</h4>
              <p class="text-sm text-gray-600">If you remix or build upon the material, you must distribute under the same license.</p>
            </div>
          </div>
        </section>

        <!-- Permitted Uses -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Permitted Uses</h2>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <h3 class="font-semibold text-gray-900">Educational Purposes</h3>
                <p class="text-gray-600">Use in classrooms, research papers, academic presentations, and educational materials.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <h3 class="font-semibold text-gray-900">Personal Use</h3>
                <p class="text-gray-600">Personal blogs, social media sharing, and non-commercial personal projects.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <h3 class="font-semibold text-gray-900">Community Documentation</h3>
                <p class="text-gray-600">Community projects, cultural preservation efforts, and heritage documentation.</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <h3 class="font-semibold text-gray-900">News and Journalism</h3>
                <p class="text-gray-600">News articles, documentaries, and journalistic coverage of refugee communities.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Attribution Requirements -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Attribution Requirements</h2>
          <p class="text-gray-700 mb-4">
            When using content from the Dzaleka Public Art Catalogue, you must provide proper attribution. Include the following information:
          </p>
          <div class="bg-gray-50 rounded-lg p-4 mb-4">
            <h3 class="font-semibold text-gray-900 mb-2">Required Attribution Format:</h3>
            <div class="bg-white rounded border p-3 font-mono text-sm">
              <p>Artwork: [Artwork Title] by [Artist Name]</p>
              <p>Source: Dzaleka Public Art Catalogue</p>
              <p>URL: https://services.dzaleka.com/public-art-catalogue/[artwork-slug]</p>
              <p>License: CC BY-NC-SA 4.0</p>
            </div>
          </div>
          <p class="text-gray-700">
            For digital use, include a link to the original artwork page. For print use, include the URL in your references or bibliography.
          </p>
        </section>

        <!-- Commercial Use Policy -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Commercial Use Policy</h2>
          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-yellow-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
              </svg>
              <div>
                <h3 class="font-semibold text-yellow-900 mb-2">Commercial Use Requires Permission</h3>
                <p class="text-yellow-800">
                  Commercial use of content from the Dzaleka Public Art Catalogue requires explicit permission. This includes:
                </p>
                <ul class="list-disc list-inside mt-2 text-yellow-800 space-y-1">
                  <li>Commercial publications and books</li>
                  <li>Advertising and marketing materials</li>
                  <li>Commercial merchandise and products</li>
                  <li>Paid exhibitions and events</li>
                  <li>Commercial websites and applications</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- Content Ownership -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Content Ownership</h2>
          <div class="space-y-4">
            <p class="text-gray-700">
              The Dzaleka Public Art Catalogue respects the rights of artists and content creators. While we document and share information about public artworks, we acknowledge that:
            </p>
            <ul class="list-disc list-inside text-gray-700 space-y-2">
              <li>Artists retain rights to their original artworks</li>
              <li>Photographers retain rights to their photographs</li>
              <li>Contributors retain rights to their written content</li>
              <li>This license applies to the catalogue's documentation and organization of content</li>
            </ul>
          </div>
        </section>

        <!-- Contact for Permissions -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Contact for Permissions</h2>
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
            <h3 class="font-semibold text-blue-900 mb-2">Commercial Use Inquiries</h3>
            <p class="text-blue-800 mb-4">
              For commercial use permissions or questions about licensing, please contact us:
            </p>
            <div class="space-y-2">
              <p class="text-blue-800">
                <strong>Email:</strong> 
                <a href="mailto:info@dzaleka.com" class="underline hover:text-blue-900">info@dzaleka.com</a>
              </p>
              <p class="text-blue-800">
                <strong>Subject:</strong> "Commercial Use Permission - Public Art Catalogue"
              </p>
            </div>
            <p class="text-blue-800 mt-4">
              Please include details about your intended use, the specific content you wish to use, and your contact information.
            </p>
          </div>
        </section>

        <!-- License Updates -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">License Updates</h2>
          <p class="text-gray-700">
            This license and usage policy may be updated periodically. The current version will always be available on this page. 
            Continued use of content after policy changes constitutes acceptance of the updated terms.
          </p>
        </section>

        <!-- Footer -->
        <div class="border-t pt-6 mt-8">
          <p class="text-sm text-gray-500 text-center">
            Last updated: January 2025 | Dzaleka Public Art Catalogue
          </p>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
