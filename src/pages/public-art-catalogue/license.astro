---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

const title = 'License and usage policy - Dzaleka Online Services';
const description =
  'Learn how material from the Public Art Catalogue can be used, shared, and credited.';
const lastUpdated = new Date().toLocaleDateString('en-AU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<MainLayout title={title} description={description} canonical="https://services.dzaleka.com/public-art-catalogue/license">
  <section class="border-b border-slate-200 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="mb-8">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Public Art Catalogue', href: '/public-art-catalogue' },
            { label: 'License and usage policy' }
          ]}
        />
      </div>

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(260px,0.9fr)] lg:items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Policy</p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            License and usage policy
          </h1>
          <p class="mt-4 text-lg leading-8 text-slate-600">
            This page explains how artwork records, catalogue text, and related documentation may
            be reused, credited, and adapted.
          </p>
        </div>

        <div class="rounded-lg border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-lg font-semibold text-slate-900">At a glance</h2>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-600">
            <li>The catalogue is intended for non-commercial learning, documentation, and sharing.</li>
            <li>Artwork and artist records should always be credited clearly.</li>
            <li>Commercial reuse needs permission before publication or sale.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="bg-slate-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-6">
      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Overview</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          The Public Art Catalogue documents artworks, artists, and community context connected to
          Dzaleka. The aim is to support visibility, preservation, and responsible public access.
        </p>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Creative Commons license</h2>
        <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-6">
          <h3 class="text-lg font-semibold text-slate-900">CC BY-NC-SA 4.0</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Attribution-NonCommercial-ShareAlike 4.0 International.
          </p>
          <p class="mt-3 text-sm leading-6 text-slate-600">
            You may share and adapt catalogue material for non-commercial purposes when attribution
            is included and derivative work is published under the same license.
          </p>
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-3">
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Attribution</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              Credit the catalogue and the artist or contributor when identified.
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Non-commercial</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              Material cannot be used for commercial products, campaigns, or merchandise without permission.
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Share alike</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              Adapted catalogue content must remain under the same license terms.
            </p>
          </div>
        </div>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Permitted uses</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="font-medium text-slate-900">Education and research</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Classroom materials, teaching, academic work, and independent research.
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="font-medium text-slate-900">Community documentation</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Cultural heritage initiatives, local archiving, and public history projects.
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="font-medium text-slate-900">Personal use</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Personal reference, learning, or non-commercial sharing with proper credit.
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="font-medium text-slate-900">Journalistic coverage</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Non-commercial reporting, commentary, and documentary use with attribution.
            </p>
          </div>
        </div>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Attribution requirements</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          Attribution should identify the artwork, the artist when known, and the catalogue page.
        </p>
        <div class="mt-6 space-y-4">
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-4 font-mono text-sm leading-6 text-slate-700">
            "[Artwork title]" by [Artist name]. Source: Dzaleka Online Services Public Art Catalogue.
            Licensed under CC BY-NC-SA 4.0.
          </div>
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-4 font-mono text-sm leading-6 text-slate-700">
            https://services.dzaleka.com/public-art-catalogue/[artwork-slug]
          </div>
        </div>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Commercial use</h2>
        <div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-6">
          <h3 class="text-lg font-semibold text-amber-900">Permission required</h3>
          <p class="mt-3 text-sm leading-6 text-amber-800">
            Commercial publications, paid exhibitions, branded campaigns, merchandise, commercial
            apps, and other revenue-generating uses require advance approval.
          </p>
        </div>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Ownership and rights</h2>
        <div class="mt-6 space-y-5 text-sm leading-6 text-slate-600">
          <div>
            <h3 class="font-medium text-slate-900">Artist and contributor rights</h3>
            <p class="mt-2">
              Artists and contributors retain rights in their original work while allowing the
              catalogue to document and present it.
            </p>
          </div>
          <div>
            <h3 class="font-medium text-slate-900">Images and documentation</h3>
            <p class="mt-2">
              Photographs, scans, and supporting media may have additional restrictions based on
              the creator or source.
            </p>
          </div>
          <div>
            <h3 class="font-medium text-slate-900">Third-party material</h3>
            <p class="mt-2">
              Any third-party content included in the catalogue remains subject to its original terms.
            </p>
          </div>
        </div>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Contact and permissions</h2>
        <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-6">
          <p class="text-sm leading-6 text-slate-600">
            For commercial use requests, licensing questions, or permissions beyond this policy, contact:
          </p>
          <div class="mt-4 space-y-2 text-sm leading-6 text-slate-700">
            <p>
              <span class="font-medium text-slate-900">Email:</span>
              <a href="mailto:dzalekaconnect@gmail.com" class="text-slate-700 underline hover:text-slate-900">
                dzalekaconnect@gmail.com
              </a>
            </p>
            <p>
              <span class="font-medium text-slate-900">Website:</span>
              <a href="https://services.dzaleka.com" class="text-slate-700 underline hover:text-slate-900">
                services.dzaleka.com
              </a>
            </p>
          </div>
        </div>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Policy updates</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          This policy may be revised as the catalogue develops. Continued use of the material means
          you accept the current published version.
        </p>
        <p class="mt-4 text-sm text-slate-500">Last updated: {lastUpdated}</p>
      </section>
    </div>
  </div>
</MainLayout>
