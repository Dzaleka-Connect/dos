---
import RecordPrintLayout from '../../../layouts/RecordPrintLayout.astro';
import RecordFacts from '../../../components/records/RecordFacts.astro';
import RecordResources from '../../../components/records/RecordResources.astro';
import { recordImages, formatRecordDate, recordCoordinates } from '../../../utils/recordMedia';

export async function getStaticPaths() {
  const records = Object.values(import.meta.glob('../../../content/artworks/*.md', { eager: true }));
  return records.map(record => ({ params: { slug: record.file.split('/').pop().replace('.md', '') }, props: { artwork: record } }));
}
const { artwork } = Astro.props;
const { frontmatter, Content } = artwork;
const slug = artwork.file.split('/').pop().replace('.md', '');
const images = recordImages(frontmatter.image, frontmatter.additionalImages || [], frontmatter.detailImages || [], frontmatter.processImages || []);
const coordinates = recordCoordinates(frontmatter.latitude, frontmatter.longitude);
const facts = [
  { label: 'Artist or contributors', value: frontmatter.artistName },
  { label: 'Category', value: frontmatter.category },
  { label: 'Area', value: frontmatter.campZone },
  { label: 'Location', value: frontmatter.location },
  { label: 'Materials', value: frontmatter.materialsUsed },
  { label: 'Text on the artwork', value: frontmatter.artSignage },
  { label: 'Date installed', value: formatRecordDate(frontmatter.dateInstalled) },
  { label: 'Coordinates', value: coordinates ? `${coordinates.lat}, ${coordinates.lng}` : undefined },
];
const sections = [
  { title: 'History', content: frontmatter.history },
  { title: 'Cultural significance', content: frontmatter.culturalSignificance },
  { title: 'Artist biography', content: frontmatter.artistBiography },
  { title: 'Other works', content: frontmatter.otherWorks },
  { title: 'Maintenance notes', content: frontmatter.maintenanceNotes },
  { title: 'Community responses', content: frontmatter.communityReactions },
].filter(section => section.content);
---
<RecordPrintLayout title={frontmatter.title} description={frontmatter.description} collection="Public Art Catalogue" href={`/public-art-catalogue/${slug}`}>
  <RecordFacts facts={facts} />
  {images.map((src, index) => <figure><img src={src} alt={`${frontmatter.title} — image ${index + 1}`} /><figcaption>{frontmatter.title} · Image {index + 1}{frontmatter.artistName && ` · Artwork: ${frontmatter.artistName}`}</figcaption></figure>)}
  <article><Content /></article>
  {sections.map(section => <section><h2>{section.title}</h2><p>{section.content}</p></section>)}
  <RecordResources resources={frontmatter.educationalResources} />
  <p>Review the <a href="/public-art-catalogue/license">record licence and usage policy</a> before reusing this material.</p>
</RecordPrintLayout>
