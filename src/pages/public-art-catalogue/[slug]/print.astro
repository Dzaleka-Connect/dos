---
import Layout from '../../../layouts/Layout.astro';
import MainLayout from '../../../layouts/MainLayout.astro';

// Generate static paths for all artworks
export async function getStaticPaths() {
  let artworks = [];
  try {
    artworks = await Astro.glob('../../../content/artworks/*.md');
  } catch (error) {
    console.error('Error loading artworks:', error);
    artworks = [];
  }
  
  return artworks.map((artwork) => {
    const slug = artwork.file.split('/').pop().replace('.md', '');
    return {
      params: { slug },
      props: { artwork }
    };
  });
}

const { artwork } = Astro.props;
const { frontmatter, Content } = artwork;

// Create SEO metadata
const seo = {
  title: `${frontmatter.title} | Print Version | Dzaleka Public Art Catalogue`,
  description: frontmatter.description || `Print version of ${frontmatter.title} by ${frontmatter.artistName} in Dzaleka Refugee Camp`,
  type: "article",
  canonical: `https://services.dzaleka.com/public-art-catalogue/${artwork.file.split('/').pop().replace('.md', '')}/print`,
  openGraph: {
    title: `${frontmatter.title} | Print Version | Dzaleka Public Art Catalogue`,
    description: frontmatter.description || `Print version of ${frontmatter.title} by ${frontmatter.artistName} in Dzaleka Refugee Camp`,
    type: "article",
    site_name: "Dzaleka Public Art Catalogue",
    locale: "en_US",
    url: `https://services.dzaleka.com/public-art-catalogue/${artwork.file.split('/').pop().replace('.md', '')}/print`
  }
};

// Prepare images array (main image + additional images)
const images = [
  frontmatter.image,
  ...(frontmatter.additionalImages || []),
  ...(frontmatter.detailImages || []),
  ...(frontmatter.processImages || [])
].filter(Boolean);
---

<!-- Print-only layout - no navigation or site elements -->
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
</head>
<body>
  <div class="print-container">
    <!-- Print Header -->
    <div class="print-header">
      <div class="print-logo">
        <h1 class="print-title">Dzaleka Public Art Catalogue</h1>
        <p class="print-subtitle">Community Art Documentation Project</p>
      </div>
      <div class="print-meta">
        <p><strong>Artwork:</strong> {frontmatter.title}</p>
        <p><strong>Artist:</strong> {frontmatter.artistName || 'Unknown'}</p>
        <p><strong>Generated:</strong> {new Date().toLocaleDateString()}</p>
        <p><strong>URL:</strong> https://services.dzaleka.com/public-art-catalogue/{artwork.file.split('/').pop().replace('.md', '')}</p>
      </div>
    </div>

    <!-- Artwork Content -->
    <div class="print-content">
      <h1 class="artwork-title">{frontmatter.title}</h1>
      
      {frontmatter.artistName && (
        <p class="artwork-artist"><strong>Artist:</strong> {frontmatter.artistName}</p>
      )}
      
      {frontmatter.category && (
        <p class="artwork-category"><strong>Category:</strong> {frontmatter.category}</p>
      )}
      
      {frontmatter.campZone && (
        <p class="artwork-location"><strong>Location:</strong> {frontmatter.campZone}</p>
      )}
      
      {frontmatter.dateInstalled && (
        <p class="artwork-installed"><strong>Installed:</strong> {new Date(frontmatter.dateInstalled).toLocaleDateString()}</p>
      )}
      
      {frontmatter.materialsUsed && (
        <p class="artwork-materials"><strong>Materials:</strong> {frontmatter.materialsUsed}</p>
      )}

      {frontmatter.description && (
        <div class="artwork-description">
          <h2>Description</h2>
          <p>{frontmatter.description}</p>
        </div>
      )}

      {frontmatter.history && (
        <div class="artwork-history">
          <h2>A Brief History</h2>
          <p>{frontmatter.history}</p>
        </div>
      )}

      {frontmatter.culturalSignificance && (
        <div class="artwork-significance">
          <h2>Cultural Significance</h2>
          <p>{frontmatter.culturalSignificance}</p>
        </div>
      )}

      {frontmatter.artistBiography && (
        <div class="artist-bio">
          <h2>Artist Biography</h2>
          <p>{frontmatter.artistBiography}</p>
        </div>
      )}

      {frontmatter.otherWorks && (
        <div class="other-works">
          <h2>Other Notable Works</h2>
          <p>{frontmatter.otherWorks}</p>
        </div>
      )}

      {frontmatter.artSignage && (
        <div class="art-signage">
          <h2>Art Signage</h2>
          <p>{frontmatter.artSignage}</p>
        </div>
      )}

      {frontmatter.maintenanceNotes && (
        <div class="maintenance-notes">
          <h2>Maintenance Notes</h2>
          <p>{frontmatter.maintenanceNotes}</p>
        </div>
      )}

      {frontmatter.communityReactions && (
        <div class="community-reactions">
          <h2>Community Reactions</h2>
          <p>{frontmatter.communityReactions}</p>
        </div>
      )}

      <!-- Images Section -->
      {images.length > 0 && (
        <div class="artwork-images">
          <h2>Images</h2>
          <div class="image-grid">
            {images.map((image, index) => (
              <div class="image-item">
                <img src={image} alt={`${frontmatter.title} - Image ${index + 1}`} />
                <p class="image-caption">Image {index + 1}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Content -->
      <div class="artwork-content">
        <Content />
      </div>
    </div>

    <!-- Print Footer -->
    <div class="print-footer">
      <p>This document was generated from the Dzaleka Public Art Catalogue</p>
      <p>For more information, visit: https://services.dzaleka.com/public-art-catalogue</p>
      <p>© {new Date().getFullYear()} Dzaleka Digital Heritage Project</p>
    </div>
  </div>
</body>
</html>

<style>
  /* Print-specific styles */
  @media print {
    body {
      margin: 0;
      padding: 0;
      background: white;
      color: black;
      font-family: 'Times New Roman', serif;
      font-size: 12pt;
      line-height: 1.4;
    }

    .print-container {
      max-width: none;
      margin: 0;
      padding: 20px;
    }

    .print-header {
      border-bottom: 2px solid #000;
      padding-bottom: 20px;
      margin-bottom: 30px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .print-title {
      font-size: 24pt;
      font-weight: bold;
      margin: 0;
      color: #1f2937;
    }

    .print-subtitle {
      font-size: 14pt;
      margin: 5px 0 0 0;
      color: #6b7280;
    }

    .print-meta {
      text-align: right;
      font-size: 10pt;
    }

    .print-meta p {
      margin: 2px 0;
    }

    .artwork-title {
      font-size: 20pt;
      font-weight: bold;
      margin: 0 0 20px 0;
      color: #1f2937;
    }

    .artwork-artist,
    .artwork-category,
    .artwork-location,
    .artwork-installed,
    .artwork-materials {
      margin: 5px 0;
      font-size: 11pt;
    }

    .artwork-description,
    .artwork-history,
    .artwork-significance,
    .artist-bio,
    .other-works,
    .art-signage,
    .maintenance-notes,
    .community-reactions {
      margin: 20px 0;
    }

    .artwork-description h2,
    .artwork-history h2,
    .artwork-significance h2,
    .artist-bio h2,
    .other-works h2,
    .art-signage h2,
    .maintenance-notes h2,
    .community-reactions h2 {
      font-size: 14pt;
      font-weight: bold;
      margin: 0 0 10px 0;
      color: #1f2937;
      border-bottom: 1px solid #d1d5db;
      padding-bottom: 5px;
    }

    .artwork-images {
      margin: 30px 0;
    }

    .artwork-images h2 {
      font-size: 14pt;
      font-weight: bold;
      margin: 0 0 15px 0;
      color: #1f2937;
    }

    .image-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-top: 15px;
    }

    .image-item {
      text-align: center;
    }

    .image-item img {
      max-width: 100%;
      height: auto;
      border: 1px solid #d1d5db;
      margin-bottom: 5px;
    }

    .image-caption {
      font-size: 9pt;
      color: #6b7280;
      margin: 0;
    }

    .artwork-content {
      margin: 30px 0;
    }

    .artwork-content h1,
    .artwork-content h2,
    .artwork-content h3 {
      color: #1f2937;
      margin-top: 20px;
      margin-bottom: 10px;
    }

    .artwork-content p {
      margin: 10px 0;
      text-align: justify;
    }

    .resource-link {
      word-break: break-all;
      font-family: monospace;
      font-size: 10pt;
      color: #000;
      background: #f8f9fa;
      padding: 8px;
      border: 1px solid #dee2e6;
      border-radius: 4px;
    }

    .print-footer {
      border-top: 2px solid #000;
      padding-top: 20px;
      margin-top: 40px;
      text-align: center;
      font-size: 9pt;
      color: #6b7280;
    }

    .print-footer p {
      margin: 5px 0;
    }

    /* Hide non-print elements */
    .no-print {
      display: none !important;
    }

    /* Page breaks */
    .artwork-images,
    .artwork-content {
      page-break-inside: avoid;
    }

    h1, h2 {
      page-break-after: avoid;
    }
  }

  /* Screen styles (for preview) */
  @media screen {
    .print-container {
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
      background: white;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
