---
import Layout from '../../../layouts/Layout.astro';
import MainLayout from '../../../layouts/MainLayout.astro';

// Generate static paths for all artist profiles
export async function getStaticPaths() {
  let artists = [];
  try {
    artists = await Astro.glob('../../../content/artists/*.md');
    console.log('Found artists:', artists.length);
    artists.forEach(artist => {
      console.log('Artist file:', artist.file);
    });
  } catch (error) {
    console.error('Error loading artists:', error);
    artists = [];
  }
  
  return artists.map((artist) => {
    const slug = artist.file.split('/').pop().replace('.md', '');
    console.log('Generated slug:', slug, 'for file:', artist.file);
    return {
      params: { slug },
      props: { artist }
    };
  });
}

const { artist } = Astro.props;
const { frontmatter, Content } = artist;

// Debug logging
console.log('Artist props:', { 
  artistName: frontmatter.artistName, 
  slug: frontmatter.slug,
  hasContent: !!Content,
  file: artist.file 
});

// Get related artworks by this artist
const allArtworks = await Astro.glob('../../../content/artworks/*.md');
const relatedArtworks = allArtworks
  .filter(artwork => 
    artwork.file !== artist.file && // Exclude current artist profile
    artwork.frontmatter.artistName === frontmatter.artistName // Match by artist name
  )
  .slice(0, 3); // Limit to 3 related artworks

// Create SEO metadata
const seo = {
  title: `${frontmatter.artistName} | Artist Profile | Dzaleka Online Services`,
  description: frontmatter.bio || `Learn about ${frontmatter.artistName}, a talented artist in Dzaleka Refugee Camp`,
  image: frontmatter.image,
  type: "profile",
  canonical: `https://services.dzaleka.com/public-art-catalogue/artist/${frontmatter.slug}`,
  openGraph: {
    title: `${frontmatter.artistName} | Artist Profile`,
    description: frontmatter.bio || `Learn about ${frontmatter.artistName}, a talented artist in Dzaleka Refugee Camp`,
    type: "profile",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/public-art-catalogue/artist/${frontmatter.slug}`,
    image: {
      url: frontmatter.image,
      width: 1200,
      height: 630,
      alt: frontmatter.artistName,
      type: "image/jpeg"
    }
  }
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  image={seo.image} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
>
  <div class="min-h-screen bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Back Button -->
      <div class="mb-8">
        <a 
          href="/public-art-catalogue/visual-arts-community" 
          class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back to Visual Arts Community</span>
        </a>
      </div>

      <!-- Artist Header -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 mb-8">
        <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
          <!-- Artist Image -->
          <div class="flex-shrink-0">
            {frontmatter.image ? (
              <img src={frontmatter.image} alt={frontmatter.artistName} class="w-32 h-32 rounded-full object-cover border-4 border-gray-100" />
            ) : (
              <div class="w-32 h-32 rounded-full bg-gray-200 flex items-center justify-center">
                <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
            )}
          </div>

          <!-- Artist Info -->
          <div class="flex-1 text-center md:text-left">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">
              {frontmatter.artistName}
            </h1>
            <p class="text-lg text-gray-600 mb-4">
              {frontmatter.medium}
            </p>
            <p class="text-gray-700 leading-relaxed mb-4">
              {frontmatter.bio}
            </p>
            
            <!-- Artist Tags -->
            <div class="flex flex-wrap justify-center md:justify-start gap-2">
              {frontmatter.age && (
                <span class="inline-flex items-center px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm">
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  {frontmatter.age} years old
                </span>
              )}

              <span class="inline-flex items-center px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {frontmatter.nationality}
              </span>
              {frontmatter.spotlight && (
                <span class="inline-flex items-center px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-sm">
                  <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                  Spotlight Artist
                </span>
              )}
            </div>
          </div>
        </div>
      </div>

      <!-- Main Content -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Artistic Journey -->
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Artistic Journey</h2>
            
            {Content ? (
              <div class="prose prose-gray max-w-none">
                <Content />
              </div>
            ) : (
              <div class="space-y-4 text-gray-700">
                <p class="leading-relaxed">{frontmatter.artisticJourney}</p>
                
                <div class="grid md:grid-cols-2 gap-6 mt-6">
                  <div class="bg-gray-50 p-4 rounded-lg">
                    <h3 class="text-lg font-semibold text-gray-900 mb-3">Notable Works</h3>
                    <ul class="space-y-2">
                      {frontmatter.notableWorks && frontmatter.notableWorks.map((work) => (
                        <li class="flex items-start space-x-2">
                          <span class="text-blue-600 mt-1">•</span>
                          <span>{work}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  
                  <div class="bg-gray-50 p-4 rounded-lg">
                    <h3 class="text-lg font-semibold text-gray-900 mb-3">Achievements</h3>
                    <ul class="space-y-2">
                      {frontmatter.achievements && frontmatter.achievements.map((achievement) => (
                        <li class="flex items-start space-x-2">
                          <svg class="w-4 h-4 text-yellow-500 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                          </svg>
                          <span>{achievement}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            )}
          </div>

          <!-- Specialties -->
          {frontmatter.specialties && frontmatter.specialties.length > 0 && (
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
              <h2 class="text-2xl font-bold text-gray-900 mb-4">Specialties</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                {frontmatter.specialties.map((specialty) => (
                  <div class="flex items-center p-3 bg-gray-50 rounded-lg">
                    <div class="w-2 h-2 bg-blue-500 rounded-full mr-3"></div>
                    <span class="font-medium text-gray-800">{specialty}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Related Artworks -->
          {relatedArtworks.length > 0 && (
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
              <h2 class="text-2xl font-bold text-gray-900 mb-4">Artworks by {frontmatter.artistName}</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {relatedArtworks.map((artwork) => (
                  <a 
                    href={`/public-art-catalogue/${artwork.file.split('/').pop().replace('.md', '')}`}
                    class="group block bg-gray-50 rounded-lg overflow-hidden hover:bg-gray-100 transition-colors"
                  >
                    <div class="aspect-w-4 aspect-h-3 bg-gray-200">
                      {artwork.frontmatter.image ? (
                        <img src={artwork.frontmatter.image} alt={artwork.frontmatter.title} class="w-full h-full object-cover" />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center">
                          <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z" />
                          </svg>
                        </div>
                      )}
                    </div>
                    <div class="p-3">
                      <h3 class="text-sm font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
                        {artwork.frontmatter.title}
                      </h3>
                      <p class="text-xs text-gray-600 mt-1">{artwork.frontmatter.category}</p>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- Contact Card -->
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h3 class="text-lg font-bold text-gray-900 mb-4">Get in Touch</h3>
            <div class="space-y-4">
              {frontmatter.whatsapp && (
                <div class="flex items-center space-x-2">
                  <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
                  </svg>
                  <span class="text-gray-600">{frontmatter.whatsapp}</span>
                </div>
              )}
              {frontmatter.phone && (
                <div class="flex items-center space-x-2">
                  <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span class="text-gray-600">{frontmatter.phone}</span>
                </div>
              )}
              {frontmatter.email && (
                <div class="flex items-center space-x-2">
                  <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <span class="text-gray-600">{frontmatter.email}</span>
                </div>
              )}
              {frontmatter.contactInfo && !frontmatter.whatsapp && !frontmatter.phone && !frontmatter.email && (
                <p class="text-gray-600">{frontmatter.contactInfo}</p>
              )}
              <a 
                href="/contact"
                class="w-full inline-flex items-center justify-center px-4 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors"
              >
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
                Contact Artist
              </a>
            </div>
          </div>

          <!-- Action Card -->
          <div class="bg-blue-50 rounded-lg border border-blue-200 p-6">
            <h3 class="text-lg font-bold text-gray-900 mb-4">Join the Community</h3>
            <p class="text-gray-600 mb-4">
              Share your own artwork and become part of Dzaleka's creative community.
            </p>
            <a 
              href="/public-art-catalogue/submit"
              class="w-full inline-flex items-center justify-center px-4 py-2 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors"
            >
              Submit Your Artwork
            </a>
          </div>

          <!-- Artist Info -->
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h3 class="text-lg font-bold text-gray-900 mb-4">Artist Information</h3>
            <div class="space-y-3">
              {frontmatter.age && (
                <div class="flex justify-between">
                  <span class="text-gray-600">Age</span>
                  <span class="font-medium text-gray-900">{frontmatter.age} years old</span>
                </div>
              )}
              {frontmatter.birthYear && (
                <div class="flex justify-between">
                  <span class="text-gray-600">Birth Year</span>
                  <span class="font-medium text-gray-900">{frontmatter.birthYear}</span>
                </div>
              )}
              <div class="flex justify-between">
                <span class="text-gray-600">Medium</span>
                <span class="font-medium text-gray-900">{frontmatter.medium}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-600">Location</span>
                <span class="font-medium text-gray-900">{frontmatter.location}</span>
              </div>

              <div class="flex justify-between">
                <span class="text-gray-600">Nationality</span>
                <span class="font-medium text-gray-900">{frontmatter.nationality}</span>
              </div>
              {frontmatter.biographyAuthor && (
                <div class="flex justify-between">
                  <span class="text-gray-600">Biography by</span>
                  <span class="font-medium text-gray-900">{frontmatter.biographyAuthor}</span>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
