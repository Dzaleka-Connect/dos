---
import MainLayout from '../../../layouts/MainLayout.astro';
import CreativeProfile from '../../../components/culture/CreativeProfile.astro';
import RelatedRecords from '../../../components/records/RelatedRecords.astro';
import { getCollection, render } from 'astro:content';
import { recordImageUrl } from '../../../utils/recordMedia';
export async function getStaticPaths() {
  return (await getCollection('artists')).map(artist => ({ params: { slug: artist.id }, props: { artist } }));
}
const { artist } = Astro.props;
const { Content } = await render(artist);
const data = artist.data;
const canonical = `https://services.dzaleka.com/public-art-catalogue/artist/${artist.id}`;
const image = recordImageUrl(data.image);
const facts = [
  { label: 'Practice', value: data.creativeArt || data.medium },
  { label: 'Location recorded in this profile', value: data.location },
  { label: 'Nationality', value: data.nationality },
  { label: 'Birth year', value: data.birthYearActual || data.birthYear },
  { label: 'Birth date', value: data.birthDate },
  { label: 'Age recorded in this biography', value: data.age },
  { label: 'Interview date', value: data.interviewDate },
  { label: 'Biography by', value: data.biographyAuthor },
];
const phoneDigits = (value: string) => {
  const digits = value.replace(/\D/g, '');
  return /^0\d{9}$/.test(digits) ? `265${digits.slice(1)}` : digits;
};
const contacts = [
  ...(data.whatsapp ? [{ label: 'WhatsApp', value: data.whatsapp, href: `https://wa.me/${phoneDigits(data.whatsapp)}` }] : []),
  ...(data.phone ? [{ label: 'Phone', value: data.phone, href: `tel:${`+${phoneDigits(data.phone)}`}` }] : []),
  ...(data.email ? [{ label: 'Email', value: data.email, href: `mailto:${data.email}` }] : []),
];
const socialLinks = [
  { label: 'Instagram', href: data.instagram }, { label: 'Facebook', href: data.facebook },
  { label: 'YouTube', href: data.youtube }, { label: 'X / Twitter', href: data.twitter }, { label: 'TikTok', href: data.tiktok },
].filter(link => link.href);
const relatedArtworks = (await getCollection('artworks')).filter(artwork => artwork.data.artistName === data.artistName).map(artwork => ({ title: artwork.data.title, href: `/public-art-catalogue/${artwork.id}`, image: artwork.data.image, meta: artwork.data.category }));
const additionalSections = [
  { title: 'Notable works', items: data.notableWorks }, { title: 'Achievements', items: data.achievements },
].filter(section => section.items?.length && !new RegExp(`^#{1,6}\\s+${section.title}`, 'im').test(artist.body || ''));
---
<MainLayout title={`${data.artistName} | Visual artists | Dzaleka Online Services`} description={data.description || data.bio} image={image} canonical={canonical} type="profile"
  schema={{ '@context': 'https://schema.org', '@type': 'Person', name: data.artistName, description: data.bio, url: canonical, image: image ? new URL(image, canonical).href : undefined, jobTitle: 'Artist', knowsAbout: data.specialties }}>
  <CreativeProfile title={data.artistName} description={data.description || data.bio} image={image} parent="Visual artists" href="/public-art-catalogue/visual-arts-community" kind={data.medium || 'Visual artist'} facts={facts}>
    {artist.body?.trim() ? <Content /> : <><p>{data.bio}</p>{data.artisticJourney && <p>{data.artisticJourney}</p>}</>}
    <div slot="details" class="space-y-6">
      {(contacts.length > 0 || socialLinks.length > 0 || data.contactInfo) && <section class="border-t border-slate-200 pt-5"><h2 class="mb-3 text-xl text-primary-900">Published contacts</h2>
        {contacts.map(contact => <div><p class="text-xs text-slate-600">{contact.label}</p><a href={contact.href} class="inline-flex min-h-[44px] items-center break-all text-sm text-primary-800 underline underline-offset-4">{contact.value}</a></div>)}
        {contacts.length === 0 && data.contactInfo && <p class="text-sm leading-6 text-slate-700">{data.contactInfo}</p>}
        {socialLinks.length > 0 && <ul>{socialLinks.map(link => <li>{/^https?:\/\//i.test(link.href) ? <a href={link.href} class="inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">{link.label} ↗</a> : <p class="py-2 text-sm leading-6 text-slate-700 [overflow-wrap:anywhere]"><span class="text-slate-500">{link.label}: </span>{link.href}</p>}</li>)}</ul>}
      </section>}
      {data.specialties?.length > 0 && <section class="border-t border-slate-200 pt-5"><h2 class="mb-3 text-xl text-primary-900">Areas of practice</h2><ul class="list-disc space-y-2 pl-4 text-sm leading-6 text-slate-700">{data.specialties.map(specialty => <li>{specialty}</li>)}</ul></section>}
      {additionalSections.length > 0 && <details class="border-t border-slate-200 pt-2"><summary class="min-h-[44px] cursor-pointer py-3 text-sm text-primary-800">Works and achievements</summary>{additionalSections.map(section => <section class="mt-4"><h2 class="text-base text-primary-900">{section.title}</h2><ul class="mt-3 list-disc space-y-2 pl-4 text-sm leading-6 text-slate-700">{section.items.map(item => <li>{item}</li>)}</ul></section>)}</details>}
    </div>
    <div slot="after" class="mt-10 border-t border-slate-200 pt-6">
      {relatedArtworks.length > 0 && <RelatedRecords title={`Artworks by ${data.artistName}`} items={relatedArtworks} contain />}
      <p class="mt-4 text-sm leading-6 text-slate-600">For corrections or help reaching an artist, <a href="/contact" class="text-primary-800 underline underline-offset-4">contact the catalogue team</a>.</p>
      <a href="/public-art-catalogue/visual-arts-community" class="mt-3 inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">← All visual artists</a>
    </div>
  </CreativeProfile>
</MainLayout>
