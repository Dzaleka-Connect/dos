---
import MainLayout from '../../layouts/MainLayout.astro';
import RecordGallery from '../../components/records/RecordGallery.astro';
import RecordFacts from '../../components/records/RecordFacts.astro';
import RecordTools from '../../components/records/RecordTools.astro';
import RecordResources from '../../components/records/RecordResources.astro';
import RelatedRecords from '../../components/records/RelatedRecords.astro';
import { recordImages, formatRecordDate, sameRecordValue } from '../../utils/recordMedia';
import '../../styles/records.css';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

// Generate static paths for all artworks
export async function getStaticPaths() {
  let artworks = [];
  try {
    artworks = Object.values(import.meta.glob('../../content/artworks/*.md', { eager: true }));
  } catch (error) {
    console.error('Error loading artworks:', error);
    artworks = [];
  }

  return artworks.map((artwork) => {
    const slug = artwork.file.split('/').pop().replace('.md', '');
    return {
      params: { slug },
      props: { artwork }
    };
  });
}

const { artwork } = Astro.props;
const { frontmatter, Content } = artwork;
const siteUrl = "https://services.dzaleka.com";
const toAbsoluteUrl = (value?: string) => {
  if (!value) return `${siteUrl}/images/dzaleka-hero.jpeg`;
  return value.startsWith('http') ? value : `${siteUrl}${value}`;
};

// Get related artworks based on category and location
const allArtworks = Object.values(import.meta.glob('../../content/artworks/*.md', { eager: true }));
const relatedArtworks = allArtworks
  .filter(a =>
    a.file !== artwork.file && // Exclude current artwork
    (
      // Match by category
      sameRecordValue(a.frontmatter.category, frontmatter.category) ||
      // Match by location
      sameRecordValue(a.frontmatter.campZone, frontmatter.campZone) ||
      // Match by artist
      sameRecordValue(a.frontmatter.artistName, frontmatter.artistName)
    )
  )
  .slice(0, 3); // Limit to 3 related artworks

// Create SEO metadata
const seo = {
  title: `${frontmatter.title} | Dzaleka Online Services`,
  description: frontmatter.description || `Public art record for ${frontmatter.title} in Dzaleka Refugee Camp`,
  image: frontmatter.image,
  type: "article",
  canonical: `https://services.dzaleka.com/public-art-catalogue/${artwork.file.split('/').pop().replace('.md', '')}`,
  openGraph: {
    title: `${frontmatter.title} | Dzaleka Online Services`,
    description: frontmatter.description || `Public art record for ${frontmatter.title} in Dzaleka Refugee Camp`,
    type: "article",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/public-art-catalogue/${artwork.file.split('/').pop().replace('.md', '')}`,
    image: {
      url: toAbsoluteUrl(frontmatter.image),
      width: 1200,
      height: 630,
      alt: frontmatter.title,
      type: "image/jpeg"
    }
  }
};

const images = recordImages(frontmatter.image, frontmatter.additionalImages || [], frontmatter.detailImages || [], frontmatter.processImages || []);
const artworkUrl = `https://services.dzaleka.com/public-art-catalogue/${artwork.file.split('/').pop().replace('.md', '')}`;
const artworkStructuredData = {
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  "name": frontmatter.title,
  "description": frontmatter.description || `Public art record for ${frontmatter.title} in Dzaleka Refugee Camp`,
  "url": artworkUrl,
  "artMedium": frontmatter.medium,
  "genre": frontmatter.category,
  "creator": {
    "@type": "Person",
    "name": frontmatter.artistName
  },
  "image": {
    "@type": "ImageObject",
    "url": toAbsoluteUrl(frontmatter.image),
    "caption": frontmatter.title,
    "creator": {
      "@type": "Person",
      "name": frontmatter.artistName
    },
    "creditText": `Artwork by ${frontmatter.artistName}`,
    "license": "https://services.dzaleka.com/public-art-catalogue/license",
    "acquireLicensePage": "https://services.dzaleka.com/contact"
  },
  "locationCreated": frontmatter.campZone ? {
    "@type": "Place",
    "name": frontmatter.campZone
  } : undefined
};
const slug = artwork.file.split('/').pop().replace('.md', '');
const params = new URLSearchParams({ artworkTitle: frontmatter.title, artistName: frontmatter.artistName || '', artworkLocation: frontmatter.location || frontmatter.campZone || '' });
const facts = [
  { label: 'Artist or contributors', value: frontmatter.artistName },
  { label: 'Category', value: frontmatter.category },
  { label: 'Date installed', value: formatRecordDate(frontmatter.dateInstalled) },
  { label: 'Area', value: frontmatter.campZone },
  { label: 'Location', value: frontmatter.location },
  { label: 'Materials', value: frontmatter.materialsUsed || frontmatter.medium },
  { label: 'Text on the artwork', value: frontmatter.artSignage },
];
const sections = [
  { title: 'History', content: frontmatter.history },
  { title: 'Cultural significance', content: frontmatter.culturalSignificance },
  { title: 'Artist biography', content: frontmatter.artistBiography },
  { title: 'Other works', content: frontmatter.otherWorks },
  { title: 'Maintenance notes', content: frontmatter.maintenanceNotes },
  { title: 'Community responses', content: frontmatter.communityReactions },
].filter(section => section.content);
---
<MainLayout title={seo.title} description={seo.description} image={seo.image} type={seo.type} canonical={seo.canonical} openGraph={seo.openGraph}>
  <script type="application/ld+json" set:html={JSON.stringify(artworkStructuredData)} />
  <div class="record-detail bg-white">
    <header class="border-b border-slate-200 bg-slate-50"><div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Public Art Catalogue', href: '/public-art-catalogue' }, { label: frontmatter.title }]} />
      <div class="mt-5 max-w-4xl"><p class="text-sm font-medium text-slate-600">{frontmatter.category}</p><h1 class="mt-2 text-primary-900">{frontmatter.title}</h1>{frontmatter.description && <p class="mt-4 text-base leading-7 text-slate-700">{frontmatter.description}</p>}<p class="mt-4 text-base text-slate-700">{frontmatter.artistName === 'Unknown' ? 'Artist not identified in this record' : frontmatter.artistName}</p></div>
    </div></header>
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-10">
        <div class="min-w-0 space-y-8">
          {images.length > 0 ? <RecordGallery images={images} title={frontmatter.title} credit={frontmatter.artistName && frontmatter.artistName !== 'Unknown' ? `Artwork: ${frontmatter.artistName}` : undefined} /> : <p class="rounded-lg border border-slate-200 bg-slate-50 p-5 text-base text-slate-700">No image has been added to this artwork record.</p>}
          <article class="record-prose prose prose-slate max-w-none"><Content /></article>
          {sections.map(section => <section class="record-section"><h2 class="text-primary-900">{section.title}</h2><p class="text-base leading-7 text-slate-700">{section.content}</p></section>)}
          <RecordResources resources={frontmatter.educationalResources} />
        </div>
        <aside class="min-w-0 space-y-8" aria-label="Artwork record information">
          <section class="record-meta"><h2 class="text-primary-900">Artwork information</h2><RecordFacts facts={facts} /></section>
          <section class="record-section"><h2 class="text-primary-900">Using these images</h2><p class="text-sm leading-6 text-slate-700">Check the catalogue’s image and artwork usage policy before reproducing this work.</p><a href="/public-art-catalogue/license" class="mt-3 inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">Art licence and usage policy →</a></section>
          <RecordTools title={frontmatter.title} url={seo.canonical} printHref={`/public-art-catalogue/${slug}/print`} updateHref={`/public-art-catalogue/submit-update?${params}`} reportHref={`/public-art-catalogue/report-issue?${params}`} />
          <p class="border-t border-slate-200 pt-5 text-sm leading-6 text-slate-600">Know of another artwork? <a href="/public-art-catalogue/submit" class="text-primary-800 underline underline-offset-4">Contribute to the catalogue</a>.</p>
        </aside>
      </div>
      <div class="mt-12"><RelatedRecords title="More public art" contain items={relatedArtworks.map(record => ({ title: record.frontmatter.title, href: `/public-art-catalogue/${record.file.split('/').pop().replace('.md', '')}`, image: record.frontmatter.image, meta: record.frontmatter.artistName }))} /></div>
    </div>
  </div>
</MainLayout>
