---
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import { OverviewSection } from "../components/data/sections/OverviewSection";
import { EventsSection } from "../components/data/sections/EventsSection";
import { StakeholdersSection } from "../components/data/sections/StakeholdersSection";
import { EconomicSection } from "../components/data/sections/EconomicSection";
import { HealthcareSection } from "../components/data/sections/HealthcareSection";
import { DemographicsSection } from "../components/data/sections/DemographicsSection";
import { TimelineSection } from "../components/data/sections/TimelineSection";
import { PopulationChart } from "../components/data/PopulationChart";

const pageTitle = "Dzaleka data and statistics";
const seo = {
  title: pageTitle,
  description:
    "Published population figures, demographic charts and historical context for Dzaleka. Check the reporting period and source shown with each section.",
  type: "website",
  canonical: "https://services.dzaleka.com/data",
  keywords:
    "Dzaleka refugee camp, Malawi refugee statistics, refugee demographics, humanitarian data",
  openGraph: {
    title: pageTitle,
    description:
      "Population data, demographics, and context for Dzaleka Refugee Camp in Dowa District, Malawi.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/data",
    images: [
      {
        url: "https://services.dzaleka.com/images/dzaleka-hero.jpeg",
        width: 1200,
        height: 630,
        alt: "Dzaleka Refugee Camp",
      },
    ],
  },
  twitter: {
    card: "summary_large_image",
    site: "@dzalekaconnect",
    creator: "@dzalekaconnect",
    title: pageTitle,
    description:
      "Population data, demographics, and context for Dzaleka Refugee Camp in Dowa District, Malawi.",
    image: "https://services.dzaleka.com/images/dzaleka-hero.jpeg",
  },
};

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: "Dzaleka Camp Data",
    description:
      "Statistical data about Dzaleka Refugee Camp including population, demographics, and services.",
    url: "https://services.dzaleka.com/data",
    keywords: ["refugee statistics", "demographics", "humanitarian data"],
    creator: {
      "@type": "Organization",
      name: "Dzaleka Online Services",
      url: "https://services.dzaleka.com",
    },
    spatialCoverage: {
      "@type": "Place",
      name: "Dzaleka Refugee Camp",
      address: {
        "@type": "PostalAddress",
        addressCountry: "Malawi",
        addressRegion: "Dowa District",
      },
      geo: {
        "@type": "GeoCoordinates",
        latitude: -13.7047,
        longitude: 33.9245,
      },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://services.dzaleka.com",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Data",
        item: "https://services.dzaleka.com/data",
      },
    ],
  },
];

const quickNavItems = [
  { href: "#overview", label: "Overview" },
  { href: "#timeline", label: "Timeline" },
  { href: "#historical", label: "History" },
  { href: "#legal", label: "Legal" },
  { href: "#demographics", label: "Demographics" },
  { href: "#housing-infrastructure", label: "Housing" },
  { href: "#events", label: "Events" },
  { href: "#stakeholders", label: "Stakeholders" },
  { href: "#economic", label: "Economic" },
  { href: "#healthcare", label: "Healthcare" },
  { href: "#additional-demographics", label: "More Demographics" },
  { href: "#current-challenges", label: "Challenges" },
  { href: "#funding-unhcr", label: "Funding" },
];
---

<MainLayout
  title={seo.title}
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  keywords={seo.keywords}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  {structuredData.map((data) => (
    <script
      type="application/ld+json"
      slot="head"
      set:html={JSON.stringify(data)}
    />
  ))}
  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <Breadcrumb
        items={[
          { label: "Home", href: "/" },
          { label: "Open data", href: "/open-data-platform" },
          { label: "Data and statistics" },
        ]}
      />
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-primary-700">
            Dzaleka in context
          </p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            Data and statistics
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-600">
            Population figures, services and historical background, with charts
            and links to the published sources.
          </p>
          <p class="mt-4 max-w-2xl border-l-4 border-primary-700 pl-4 text-sm leading-6 text-slate-600">
            This page includes reports from 2024 and 2025. Check each section’s
            reporting period before using a figure.
          </p>
          <a
            href="https://data.unhcr.org/en/country/mwi"
            class="mt-4 inline-flex min-h-[44px] items-center font-medium text-primary-800 underline underline-offset-4"
          >
            Latest reports from UNHCR Malawi ↗
          </a>
        </div>
        <figure>
          <img
            src="/images/dzaleka-hero.jpeg"
            alt="View across Dzaleka"
            width="640"
            height="400"
            class="aspect-[8/5] w-full rounded object-cover"
          />
          <figcaption class="mt-2 text-xs text-slate-500">
            Dzaleka, Dowa District, Malawi
          </figcaption>
        </figure>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <details class="mb-8 rounded border border-slate-200 p-4 xl:hidden">
      <summary class="cursor-pointer font-semibold text-primary-800">
        Browse data sections
      </summary>
      <ul class="mt-3 grid gap-1 sm:grid-cols-2">
        {quickNavItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </details>

    <div class="grid grid-cols-1 gap-10 xl:grid-cols-[minmax(0,1fr)_240px]">
      <!-- Main Column -->
      <div class="space-y-0">
        <!-- Overview -->
        <section id="overview" class="scroll-mt-28 pb-10">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Overview</h2>
          <OverviewSection client:visible />
        </section>

        <!-- Timeline -->
        <section
          id="timeline"
          class="scroll-mt-28 border-t border-gray-200 py-10"
        >
          <div class="mb-6">
            <h2 class="text-2xl font-bold text-gray-900">Camp History</h2>
            <p class="mt-1 text-sm text-gray-500">
              From political prison to Malawi's primary refugee settlement,
              1994–present.
            </p>
          </div>
          <TimelineSection client:visible />
        </section>

        <!-- Historical Background -->
        <section
          id="historical"
          class="scroll-mt-28 border-t border-gray-200 py-10"
        >
          <h2 class="text-2xl font-bold text-gray-900 mb-6">
            Historical Background
          </h2>

          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-4">
              Malawi's History of Hosting Refugees
            </h3>
            <ul class="space-y-2 text-gray-600 list-none pl-0">
              <li class="flex items-start gap-3">
                <span class="block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                <span>
                  Luwani Camp opened in 1977 for Mozambican refugees, closed in
                  2007
                </span>
              </li>
              <li class="flex items-start gap-3">
                <span class="block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                <span>
                  Dzaleka Camp, originally a political prison, repurposed in
                  1994 for refugees from Rwanda and Burundi
                </span>
              </li>
              <li class="flex items-start gap-3">
                <span class="block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                <span>
                  Malawi hosted over one million Mozambican refugees during the
                  1980s and early 1990s
                </span>
              </li>
              <li class="flex items-start gap-3">
                <span class="block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                <span>
                  Malawi ratified the UN Refugee Convention and enacted the
                  Refugee Act in 1989
                </span>
              </li>
              <li class="flex items-start gap-3">
                <span class="block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                <span>
                  Dzaleka's population has grown from 10,000-12,000 to over
                  60,000 by 2024
                </span>
              </li>
              <li class="flex items-start gap-3">
                <span class="block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                <span>
                  Malawi has also experienced refugee outflows in the 1960s and
                  1970s due to political persecution
                </span>
              </li>
            </ul>
            <p class="mt-4 text-sm text-gray-400">
              Source:{" "}
              <a
                href="https://inuaadvocacy.org/2024/12/malawi-refugee-guide/"
                target="_blank"
                rel="noopener noreferrer"
                class="underline hover:text-gray-600"
              >
                Inua Advocacy
              </a>
            </p>
          </div>

          <!-- Population Growth -->
          <div class="mt-10">
            <h3 class="text-lg font-semibold text-gray-900 mb-6">
              Population Growth
            </h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <div class="border border-gray-200 rounded p-4 text-center">
                <div class="text-2xl font-bold text-gray-900">150</div>
                <div class="text-sm font-medium text-gray-600 mt-1">1995</div>
                <div class="text-xs text-gray-400">Initial refugees</div>
              </div>
              <div class="border border-gray-200 rounded p-4 text-center">
                <div class="text-2xl font-bold text-gray-900">5,000</div>
                <div class="text-sm font-medium text-gray-600 mt-1">2007</div>
                <div class="text-xs text-gray-400">Before Luwani closure</div>
              </div>
              <div class="border border-gray-200 rounded p-4 text-center">
                <div class="text-2xl font-bold text-gray-900">8,800</div>
                <div class="text-sm font-medium text-gray-600 mt-1">2007</div>
                <div class="text-xs text-gray-400">After Luwani closure</div>
              </div>
              <div class="border-2 border-gray-900 rounded p-4 text-center bg-gray-50">
                <div class="text-2xl font-bold text-gray-900">55,425</div>
                <div class="text-sm font-bold text-gray-700 mt-1">2024</div>
                <div class="text-xs text-gray-500">August 2024</div>
              </div>
            </div>
          </div>

          <!-- Name Origin -->
          <div class="mt-10">
            <h3 class="text-lg font-semibold text-gray-900 mb-3">
              The Name "Dzaleka"
            </h3>
            <p class="text-gray-600 leading-relaxed">
              From the Chichewa phrase "N'dzaleka," meaning "I will never do it
              again." The name carries the weight of the site's history as a
              political prison and the hope that such suffering won't be
              repeated.
            </p>
          </div>

          <!-- Documents & Testimonies -->
          <div class="mt-10">
            <h3 class="text-lg font-semibold text-gray-900 mb-6">
              Documents & Testimonies
            </h3>
            <div class="space-y-8">
              <div class="border-l-2 border-gray-300 pl-6">
                <div class="text-sm font-mono text-gray-400 mb-2">1976</div>
                <h4 class="font-semibold text-gray-900 mb-2">
                  State Department Cable
                </h4>
                <blockquote class="text-gray-600 italic leading-relaxed">
                  "In the Dzaleka detention camp near Dowa, north of Lilongwe,
                  there are now over 3,000 male witnesses who have been
                  incarcerated for a two-year period."
                </blockquote>
                <p class="mt-2 text-xs text-gray-400">Cable 1976-135342</p>
              </div>

              <div class="border-l-2 border-gray-300 pl-6">
                <div class="text-sm font-mono text-gray-400 mb-2">1995</div>
                <h4 class="font-semibold text-gray-900 mb-2">
                  Joseph Ndereyimana
                </h4>
                <blockquote class="text-gray-600 italic leading-relaxed">
                  "On 23rd December 1995, we were taken to the Dzaleka Refugee
                  Centre, outside Dowa. We were feeling happy in the hope that
                  we might meet up with people we knew, and even hear news of
                  our families whom we had left behind in Kashusha."
                </blockquote>
                <p class="mt-2 text-xs text-gray-400">
                  "Walk this way: the journey of a Rwandan refugee" (1999)
                </p>
              </div>

              <div class="border-l-2 border-gray-300 pl-6">
                <div class="text-sm font-mono text-gray-400 mb-2">2007</div>
                <h4 class="font-semibold text-gray-900 mb-2">
                  State Department Cable
                </h4>
                <blockquote class="text-gray-600 italic leading-relaxed">
                  "The Dzaleka camp covers 201 hectares and UNHCR estimates it
                  can hold a maximum of 9300 people. Once all refugees are
                  relocated it will have a population approaching 8800 people
                  and continues to get a steady stream of new refugees from the
                  Congo."
                </blockquote>
                <p class="mt-2 text-xs text-gray-400">Cable 07LILONGWE803</p>
              </div>
            </div>
          </div>

          <!-- Cultural Achievements -->
          <div class="mt-10">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">
              Cultural Achievements
            </h3>
            <div class="grid md:grid-cols-2 gap-6">
              <div class="border border-gray-200 rounded p-5">
                <h4 class="font-semibold text-gray-900 mb-2">
                  Tumaini Festival
                </h4>
                <p class="text-sm text-gray-600 mb-2">
                  Founded by Congolese refugee Trésor Nzengu Mpauni, this annual
                  arts and cultural event has reached an estimated 40 million
                  people worldwide.
                </p>
                <span class="text-xs text-gray-400">Established 2014</span>
              </div>
              <div class="border border-gray-200 rounded p-5">
                <h4 class="font-semibold text-gray-900 mb-2">
                  Community Organizations
                </h4>
                <p class="text-sm text-gray-600 mb-2">
                  Refugee-led organizations including There is Hope, RELON
                  Malawi, and cultural groups publish work and represent
                  community priorities.
                </p>
                <span class="text-xs text-gray-400">Ongoing</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Legal Framework -->
        <section id="legal" class="scroll-mt-28 border-t border-gray-200 py-10">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Legal Framework</h2>

          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-3">
              Refugee Act of 1989
            </h3>
            <p class="text-gray-600 mb-6">
              The Refugee Act of 1989 establishes the legal framework for the
              reception, admission, and treatment of refugees in Malawi. While
              it aligns with key international refugee laws, it has faced
              criticism for being outdated and insufficient in addressing
              current refugee needs.
            </p>

            <h3 class="text-lg font-semibold text-gray-900 mb-3">
              Reservations to the 1951 UN Refugee Convention
            </h3>
            <p class="text-gray-600 mb-3">
              Malawi's reservations limit certain rights:
            </p>
            <ul class="space-y-2 text-gray-600 list-none pl-0">
              <li class="flex items-start gap-3">
                <span class="block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                <span>
                  <strong>Freedom of Movement:</strong> Refugees must reside in
                  designated camps
                </span>
              </li>
              <li class="flex items-start gap-3">
                <span class="block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                <span>
                  <strong>Employment:</strong> Restrictions on work outside
                  camps
                </span>
              </li>
              <li class="flex items-start gap-3">
                <span class="block w-1.5 h-1.5 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                <span>
                  <strong>Public Relief and Assistance:</strong> Limited access
                  to social services
                </span>
              </li>
            </ul>
            <p class="text-gray-600 mt-4">
              These reservations significantly impact refugees' ability to
              achieve self-sufficiency and integrate into Malawian society.
            </p>
            <p class="mt-4 text-sm text-gray-400">
              Source:{" "}
              <a
                href="https://inuaadvocacy.org/2024/12/malawi-refugee-guide/"
                target="_blank"
                rel="noopener noreferrer"
                class="underline hover:text-gray-600"
              >
                Inua Advocacy
              </a>
            </p>
          </div>
        </section>

        <!-- Demographics -->
        <section
          id="demographics"
          class="scroll-mt-28 border-t border-gray-200 py-10"
        >
          <div class="mb-6">
            <h2 class="text-2xl font-bold text-gray-900">Demographics</h2>
            <p class="mt-1 text-sm text-gray-500">
              UNHCR data as of 31 March 2025
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-6 mb-8">
            <div class="border border-gray-200 rounded p-5">
              <h3 class="font-semibold text-gray-900 mb-4">
                Population by Origin
              </h3>
              <table class="w-full text-sm">
                <tbody>
                  <tr class="border-b border-gray-100">
                    <td class="py-2 text-gray-600">Total Population</td>
                    <td class="py-2 text-right font-bold text-gray-900">
                      57,438
                    </td>
                  </tr>
                  <tr class="border-b border-gray-100">
                    <td class="py-2 text-gray-600">DR Congo</td>
                    <td class="py-2 text-right font-bold text-gray-900">
                      37,245
                    </td>
                  </tr>
                  <tr class="border-b border-gray-100">
                    <td class="py-2 text-gray-600">Burundi</td>
                    <td class="py-2 text-right font-bold text-gray-900">
                      12,604
                    </td>
                  </tr>
                  <tr class="border-b border-gray-100">
                    <td class="py-2 text-gray-600">Rwanda</td>
                    <td class="py-2 text-right font-bold text-gray-900">
                      7,135
                    </td>
                  </tr>
                  <tr class="border-b border-gray-100">
                    <td class="py-2 text-gray-600">Mozambique</td>
                    <td class="py-2 text-right font-bold text-gray-900">35</td>
                  </tr>
                  <tr>
                    <td class="py-2 text-gray-600">Others</td>
                    <td class="py-2 text-right font-bold text-gray-900">
                      ~419
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="border border-gray-200 rounded p-5">
              <h3 class="font-semibold text-gray-900 mb-4">Capacity</h3>
              <table class="w-full text-sm">
                <tbody>
                  <tr class="border-b border-gray-100">
                    <td class="py-2 text-gray-600">Design capacity</td>
                    <td class="py-2 text-right font-bold text-gray-900">
                      10,000–12,000
                    </td>
                  </tr>
                  <tr class="border-b border-gray-100">
                    <td class="py-2 text-gray-600">Current population</td>
                    <td class="py-2 text-right font-bold text-gray-900">
                      57,438
                    </td>
                  </tr>
                  <tr>
                    <td class="py-2 text-gray-600">Over capacity by</td>
                    <td class="py-2 text-right font-bold text-red-700">
                      ~478%
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-6 mb-8">
            <div class="border border-gray-200 rounded p-5">
              <h3 class="font-semibold text-gray-900 mb-3">
                Displacement Context
              </h3>
              <ul class="space-y-2 text-sm text-gray-600 list-none pl-0">
                <li class="flex items-start gap-2">
                  <span class="block w-1 h-1 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                  <span>
                    <strong>DRC:</strong> Majority of population, ongoing
                    displacement due to conflicts
                  </span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="block w-1 h-1 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                  <span>
                    <strong>Burundi:</strong> Significant population, political
                    instability concerns
                  </span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="block w-1 h-1 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                  <span>
                    <strong>Rwanda:</strong> Long-term residents since 1994
                    genocide
                  </span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="block w-1 h-1 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                  <span>
                    <strong>Others:</strong> Smaller populations from Somalia,
                    Ethiopia, Mozambique
                  </span>
                </li>
              </ul>
            </div>

            <div class="border border-gray-200 rounded p-5">
              <h3 class="font-semibold text-gray-900 mb-3">
                Community Development
              </h3>
              <ul class="space-y-2 text-sm text-gray-600 list-none pl-0">
                <li class="flex items-start gap-2">
                  <span class="block w-1 h-1 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                  <span>
                    <strong>Tumaini Festival:</strong> Annual arts event
                    reaching 40M+ people
                  </span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="block w-1 h-1 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                  <span>
                    <strong>Refugee-led organizations:</strong> There is Hope,
                    RELON Malawi
                  </span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="block w-1 h-1 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                  <span>
                    <strong>Educational institutions:</strong> Schools and
                    training centers
                  </span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="block w-1 h-1 rounded-full bg-gray-400 mt-2 shrink-0"></span>
                  <span>
                    <strong>Cultural preservation:</strong> Traditional arts and
                    music
                  </span>
                </li>
              </ul>
            </div>
          </div>

          <PopulationChart client:visible />
        </section>

        <!-- Housing & Infrastructure -->
        <section
          id="housing-infrastructure"
          class="scroll-mt-28 border-t border-gray-200 py-10"
        >
          <h2 class="text-2xl font-bold text-gray-900 mb-6">
            Housing & Infrastructure
          </h2>

          <div class="grid md:grid-cols-2 gap-6 mb-6">
            <div class="border border-gray-200 rounded p-5">
              <h3 class="font-semibold text-gray-900 mb-2">
                Housing conditions
              </h3>
              <p class="text-sm text-gray-600">
                Dzaleka remains highly congested, resulting in poor living
                conditions and inadequate infrastructure due to limited space
                and resources.
              </p>
            </div>
            <div class="border border-gray-200 rounded p-5">
              <h3 class="font-semibold text-gray-900 mb-2">
                2023: 8,047 Units Built
              </h3>
              <p class="text-sm text-gray-600">
