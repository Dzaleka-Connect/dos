---
import MainLayout from '../layouts/MainLayout.astro';
import { OverviewSection } from '../components/data/sections/OverviewSection';
import { EventsSection } from '../components/data/sections/EventsSection';
import { StakeholdersSection } from '../components/data/sections/StakeholdersSection';
import { EconomicSection } from '../components/data/sections/EconomicSection';
import { HealthcareSection } from '../components/data/sections/HealthcareSection';
import { DemographicsSection } from '../components/data/sections/DemographicsSection';
import { TimelineSection } from '../components/data/sections/TimelineSection';
import { NewsWidget } from '../components/data/NewsWidget';
import { EmergencyAlerts } from '../components/data/EmergencyAlerts';
import { ResourcesWidget } from '../components/data/ResourcesWidget';
import { FinanceWidget } from '../components/data/FinanceWidget';
import { PopulationChart } from '../components/data/PopulationChart';

// Enhanced SEO metadata
const pageTitle = "Dzaleka Camp Data Hub | Statistics & Demographics";
const seo = {
  title: pageTitle,
  description: "Access real-time population data, demographics, and economic insights for Dzaleka Refugee Camp. View 57,000+ resident statistics, healthcare metrics, educational data, and community development indicators from Malawi's largest refugee settlement.",
  type: "website",
  canonical: "https://services.dzaleka.com/data",
  keywords: "Dzaleka refugee camp, Malawi refugee statistics, refugee demographics, humanitarian data, camp population, refugee services",
  openGraph: {
    title: pageTitle,
    description: "Access real-time population data, demographics, and economic insights for Dzaleka Refugee Camp. View 57,000+ resident statistics, healthcare metrics, educational data, and community development indicators from Malawi's largest refugee settlement.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/data",
    images: [
      {
        url: "https://services.dzaleka.com/images/dzaleka-hero.jpeg",
        width: 1200,
        height: 630,
        alt: "Dzaleka Refugee Camp Aerial View"
      }
    ]
  },
  twitter: {
    card: "summary_large_image",
    site: "@dzalekaconnect",
    creator: "@dzalekaconnect",
    title: pageTitle,
    description: "Access real-time population data, demographics, and economic insights for Dzaleka Refugee Camp. View 57,000+ resident statistics, healthcare metrics, educational data, and community development indicators from Malawi's largest refugee settlement.",
    image: "https://services.dzaleka.com/images/dzaleka-hero.jpeg"
  }
};

// Enhanced structured data
const structuredData = [
  // Dataset Schema
  {
    "@context": "https://schema.org",
    "@type": "Dataset",
    "name": "Dzaleka Camp Data Hub",
    "description": "Comprehensive statistical data about Dzaleka Refugee Camp including population demographics, economic impact, and services.",
    "url": "https://services.dzaleka.com/data",
    "keywords": ["refugee statistics", "demographics", "humanitarian data", "camp population", "refugee services"],
    "creator": {
      "@type": "Organization",
      "name": "Dzaleka Online Services",
      "url": "https://services.dzaleka.com"
    },
    "dateModified": new Date().toISOString(),
    "variableMeasured": [
      {
        "@type": "PropertyValue",
        "name": "Total Population",
        "value": "55,425",
        "unitText": "Refugees"
      },
      {
        "@type": "PropertyValue",
        "name": "DRC Refugees",
        "value": "35,952",
        "unitText": "Refugees"
      },
      {
        "@type": "PropertyValue",
        "name": "Funding Gap",
        "value": "79",
        "unitText": "Percent"
      }
    ],
    "distribution": {
      "@type": "DataDownload",
      "encodingFormat": "HTML",
      "contentUrl": "https://services.dzaleka.com/data"
    },
    "temporalCoverage": "2025",
    "spatialCoverage": {
      "@type": "Place",
      "name": "Dzaleka Refugee Camp",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "Malawi",
        "addressRegion": "Dowa District"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -13.7047,
        "longitude": 33.9245
      }
    }
  },
  // Organization Schema
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Dzaleka Online Services",
    "url": "https://services.dzaleka.com",
    "logo": "https://services.dzaleka.com/images/dzaleka-digital-heritage.png",
    "sameAs": [
      "https://x.com/Dzalekaconnect",
      "https://facebook.com/dzalekaonline"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+265-xxx-xxxx",
      "contactType": "customer service",
      "availableLanguage": ["English", "French", "Swahili"]
    }
  },
  // Breadcrumb Schema
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://services.dzaleka.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Data Hub",
        "item": "https://services.dzaleka.com/data"
      }
    ]
  }
];

const languages = [
  { code: 'en', name: 'English' },
  { code: 'fr', name: 'Français' },
  { code: 'sw', name: 'Kiswahili' }
];
---

<MainLayout 
  title={seo.title}
  description={seo.description} 
  type={seo.type} 
  canonical={seo.canonical}
  keywords={seo.keywords}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  {/* Enhanced Meta Tags */}
  <link rel="alternate" hreflang="en" href="https://services.dzaleka.com/data" />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Dzaleka Online Services" />
  <meta name="revisit-after" content="7 days" />
  <meta name="geo.region" content="MW-DO" />
  <meta name="geo.placename" content="Dzaleka Refugee Camp" />
  <meta name="geo.position" content="-13.7047;33.9245" />
  <meta name="ICBM" content="-13.7047, 33.9245" />

  {/* Structured Data */}
  {structuredData.map(data => (
    <script type="application/ld+json" set:html={JSON.stringify(data)} />
  ))}
  
  <!-- Hero Section -->
  <div class="relative">
    {/* Hero Image */}
    <div class="absolute inset-0">
      <img
        src="/images/dzaleka-hero.jpeg"
        alt="Dzaleka Refugee Camp"
        class="w-full h-full object-cover"
      />
      {/* Dark Overlay */}
      <div class="absolute inset-0 bg-black/60"></div>
    </div>

    {/* Content Overlay */}
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="text-center">
        <h1 class="text-4xl font-bold text-white sm:text-5xl md:text-6xl">
          <span class="block">Dzaleka Camp</span>
          <span class="block text-primary-200">Data & Statistics</span>
        </h1>
        <p class="mt-3 max-w-md mx-auto text-base text-gray-100 sm:text-lg md:mt-5 md:text-xl md:max-w-3xl">
          Comprehensive data insights into Dzaleka Refugee Camp's population, resources, and operations.
        </p>
      </div>

      {/* Stats */}
      <div class="mt-16">
        <dl class="rounded-lg bg-white/10 backdrop-blur-lg shadow-lg sm:grid sm:grid-cols-4">
          <div class="flex flex-col border-b border-gray-100/10 p-6 text-center sm:border-0 sm:border-r">
            <dt class="order-2 mt-2 text-lg font-medium leading-6 text-gray-100">Total Refugees</dt>
            <dd class="order-1 text-5xl font-bold text-white">55,425</dd>
          </div>
          <div class="flex flex-col border-t border-b border-gray-100/10 p-6 text-center sm:border-0 sm:border-l sm:border-r">
            <dt class="order-2 mt-2 text-lg font-medium leading-6 text-gray-100">DRC Refugees</dt>
            <dd class="order-1 text-5xl font-bold text-white">35,952</dd>
          </div>
          <div class="flex flex-col border-t border-b border-gray-100/10 p-6 text-center sm:border-0 sm:border-l sm:border-r">
            <dt class="order-2 mt-2 text-lg font-medium leading-6 text-gray-100">Funding Gap</dt>
            <dd class="order-1 text-5xl font-bold text-white">79%</dd>
          </div>
          <div class="flex flex-col border-t border-gray-100/10 p-6 text-center sm:border-0 sm:border-l">
            <dt class="order-2 mt-2 text-lg font-medium leading-6 text-gray-100">UNHCR Staff</dt>
            <dd class="order-1 text-5xl font-bold text-white">66</dd>
          </div>
        </dl>
        <div class="text-center mt-4 text-sm text-gray-300">
          <p>Sources: 
            <a href="https://www.unhcr.org/sites/default/files/2024-11/Fact%20Sheet_Malawi_August%202024.pdf" class="underline hover:text-white" target="_blank" rel="noopener noreferrer">UNHCR Malawi Fact Sheet (Aug 2024)</a>
          </p>
          <p class="mt-2 text-xs">Latest data as of August 2024</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <main class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {/* Quick Navigation */}
    <nav class="bg-white rounded-xl shadow-sm p-4 border border-gray-100 mb-8 sticky top-4 z-10">
      <div class="flex overflow-x-auto pb-2 -mx-4 px-4 scrollbar-hide">
        <div class="flex gap-2 min-w-max">
          <a href="#overview" class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 whitespace-nowrap">Overview</a>
          <a href="#timeline" class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 whitespace-nowrap">Timeline</a>
          <a href="#historical" class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 whitespace-nowrap">History</a>
          <a href="#legal" class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 whitespace-nowrap">Legal</a>
          <a href="#demographics" class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 whitespace-nowrap">Demographics</a>
          <a href="#housing-infrastructure" class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 whitespace-nowrap">Housing</a>
          <a href="#events" class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 whitespace-nowrap">Events</a>
          <a href="#stakeholders" class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 whitespace-nowrap">Stakeholders</a>
          <a href="#economic" class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 whitespace-nowrap">Economic</a>
          <a href="#healthcare" class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 whitespace-nowrap">Healthcare</a>
          <a href="#additional-demographics" class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 whitespace-nowrap">More Demographics</a>
          <a href="#funding-unhcr" class="px-4 py-2 rounded-lg text-sm font-medium bg-gray-50 text-gray-600 hover:bg-gray-100 whitespace-nowrap">Funding</a>
        </div>
      </div>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {/* Main Content Column */}
      <div class="lg:col-span-2">
        {/* First Section: Overview & Demographics */}
        <div id="overview" class="bg-white rounded-xl shadow-sm p-8 border border-gray-100">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Camp Overview</h2>
          <OverviewSection client:load />
        </div>

        {/* Timeline Section */}
        <div id="timeline" class="bg-white rounded-xl shadow-sm p-8 border border-gray-100 mt-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Camp History</h2>
          <TimelineSection client:load />
        </div>

        {/* Historical Background Section */}
        <div id="historical" class="bg-white rounded-xl shadow-sm p-8 border border-gray-100 mt-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Historical Background</h2>
          <div class="prose max-w-none">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Malawi's History of Hosting Refugees</h3>
            <ul class="space-y-3 text-gray-600">
              <li class="flex items-start">
                <span class="flex-shrink-0 w-2 h-2 mt-2 rounded-full bg-primary-500 mr-3"></span>
                <span>Luwani Camp opened in 1977 for Mozambican refugees, closed in 2007</span>
              </li>
              <li class="flex items-start">
                <span class="flex-shrink-0 w-2 h-2 mt-2 rounded-full bg-primary-500 mr-3"></span>
                <span>Dzaleka Camp, originally a political prison, repurposed in 1994 for refugees from Rwanda and Burundi</span>
              </li>
              <li class="flex items-start">
                <span class="flex-shrink-0 w-2 h-2 mt-2 rounded-full bg-primary-500 mr-3"></span>
                <span>Malawi hosted over one million Mozambican refugees during the 1980s and early 1990s</span>
              </li>
              <li class="flex items-start">
                <span class="flex-shrink-0 w-2 h-2 mt-2 rounded-full bg-primary-500 mr-3"></span>
                <span>Malawi ratified the UN Refugee Convention and enacted the Refugee Act in 1989</span>
              </li>
              <li class="flex items-start">
                <span class="flex-shrink-0 w-2 h-2 mt-2 rounded-full bg-primary-500 mr-3"></span>
                <span>Dzaleka's population has grown from 10,000-12,000 to over 60,000 by 2024</span>
              </li>
              <li class="flex items-start">
                <span class="flex-shrink-0 w-2 h-2 mt-2 rounded-full bg-primary-500 mr-3"></span>
                <span>Malawi has also experienced refugee outflows in the 1960s and 1970s due to political persecution</span>
              </li>
            </ul>
            <div class="mt-6 pt-4 border-t border-gray-100">
              <p class="text-sm text-gray-500 italic">
                Source: <a href="https://inuaadvocacy.org/2024/12/malawi-refugee-guide/" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700">Inua Advocacy</a>
              </p>
            </div>
          </div>
        </div>

        {/* Legal Framework Section */}
        <div id="legal" class="bg-white rounded-xl shadow-sm p-8 border border-gray-100 mt-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Legal Framework</h2>
          <div class="prose max-w-none">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Understanding the Laws Governing Refugees in Malawi</h3>
            
            <div class="mb-6">
              <h4 class="text-md font-medium text-gray-900 mb-3">Refugee Act of 1989</h4>
              <p class="text-gray-600">
                The Refugee Act of 1989 establishes the legal framework for the reception, admission, and treatment of refugees in Malawi. While it aligns with key international refugee laws, it has faced criticism for being outdated and insufficient in addressing current refugee needs.
              </p>
            </div>

            <div>
              <h4 class="text-md font-medium text-gray-900 mb-3">Reservations to the 1951 UN Refugee Convention</h4>
              <p class="text-gray-600 mb-4">Malawi's reservations limit certain rights of refugees, including:</p>
              <ul class="space-y-3 text-gray-600">
                <li class="flex items-start">
                  <span class="flex-shrink-0 w-2 h-2 mt-2 rounded-full bg-primary-500 mr-3"></span>
                  <span><strong>Freedom of Movement:</strong> Refugees must reside in designated camps</span>
                </li>
                <li class="flex items-start">
                  <span class="flex-shrink-0 w-2 h-2 mt-2 rounded-full bg-primary-500 mr-3"></span>
                  <span><strong>Employment:</strong> Restrictions on work outside camps</span>
                </li>
                <li class="flex items-start">
                  <span class="flex-shrink-0 w-2 h-2 mt-2 rounded-full bg-primary-500 mr-3"></span>
                  <span><strong>Public Relief and Assistance:</strong> Limited access to social services</span>
                </li>
              </ul>
              <p class="text-gray-600 mt-4">
                These reservations significantly impact refugees' ability to achieve self-sufficiency and integrate into Malawian society.
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-gray-100">
              <p class="text-sm text-gray-500 italic">
                Source: <a href="https://inuaadvocacy.org/2024/12/malawi-refugee-guide/" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700">Inua Advocacy</a>
              </p>
            </div>
          </div>
        </div>

        <div id="demographics" class="bg-white rounded-xl shadow-sm p-8 border border-gray-100 mt-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Demographics</h2>
          
          {/* Updated Population Statistics */}
          <div class="grid md:grid-cols-2 gap-8 mb-8">
            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-6 border border-blue-200">
              <h3 class="text-lg font-semibold text-gray-900 mb-4">Current Population (August 2024)</h3>
              <div class="space-y-3">
                <div class="flex justify-between items-center">
                  <span class="text-gray-600">Total Registered:</span>
                  <span class="font-bold text-lg text-blue-600">55,425</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-600">New Arrivals:</span>
                  <span class="font-bold text-blue-600">304</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-600">In Situ:</span>
                  <span class="font-bold text-blue-600">12</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-600">New-born Babies:</span>
                  <span class="font-bold text-blue-600">147</span>
                </div>
              </div>
            </div>

            <div class="bg-gradient-to-br from-orange-50 to-red-50 rounded-xl p-6 border border-orange-200">
              <h3 class="text-lg font-semibold text-gray-900 mb-4">Camp Capacity Issues</h3>
              <div class="space-y-3">
                <div class="flex justify-between items-center">
                  <span class="text-gray-600">Original Design Capacity:</span>
                  <span class="font-bold text-orange-600">10,000-12,000</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-600">Current Population:</span>
                  <span class="font-bold text-red-600">55,425</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-600">Monthly New Arrivals:</span>
                  <span class="font-bold text-orange-600">~200</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-600">Monthly New Births:</span>
                  <span class="font-bold text-orange-600">~150</span>
                </div>
              </div>
            </div>
          </div>

          {/* Population by Country of Origin */}
          <div class="bg-white rounded-xl p-6 border border-gray-200 mb-8">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Population by Country of Origin</h3>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
              <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-700">DRC</span>
                <span class="font-bold text-blue-600">35,952</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-700">Burundi</span>
                <span class="font-bold text-blue-600">12,113</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-700">Rwanda</span>
                <span class="font-bold text-blue-600">6,960</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-700">Somalia</span>
                <span class="font-bold text-blue-600">161</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-700">Ethiopia</span>
                <span class="font-bold text-blue-600">164</span>
              </div>
              <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
                <span class="text-gray-700">Others</span>
                <span class="font-bold text-blue-600">75</span>
              </div>
            </div>
            <div class="mt-4 text-center">
              <span class="text-lg font-bold text-gray-900">TOTAL: 55,425</span>
            </div>
          </div>

          <PopulationChart client:load />
        </div>

        {/* Housing & Infrastructure Section */}
        <div id="housing-infrastructure" class="bg-white rounded-xl shadow-sm p-8 border border-gray-100 mt-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Housing & Infrastructure Development</h2>
          
          <div class="grid md:grid-cols-2 gap-8 mb-8">
            <!-- Current Challenges -->
            <div class="bg-gradient-to-br from-orange-50 to-red-50 rounded-xl p-6 border border-orange-200">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">Current Challenges</h3>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                Dzaleka refugee camp remains highly congested, resulting in poor living conditions and inadequate infrastructure due to limited space and resources.
              </p>
            </div>

            <!-- 2023 Progress -->
            <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-6 border border-green-200">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">2023 Achievements</h3>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                To improve housing conditions, a total of <strong>8,047 housing units</strong> were constructed in 2023, significantly enhancing living standards for camp residents.
              </p>
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-8 mb-8">
            <!-- 2024 Progress -->
            <div class="bg-gradient-to-br from-blue-50 to-cyan-50 rounded-xl p-6 border border-blue-200">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">2024 Developments</h3>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
