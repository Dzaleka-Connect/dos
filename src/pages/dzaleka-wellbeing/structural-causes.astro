    color: #fff; transition: background 0.15s;
  }
  .wbs-crisis-btn:hover { background: #b91c1c; }

  .wbs-section { margin-top: 3rem; }
  .wbs-h2 { font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem; }
  .wbs-p { font-size: 0.9375rem; line-height: 1.85; color: #334155; margin-bottom: 1rem; }
