    padding: 1rem 1.25rem; margin-bottom: 0.5rem; background: #fff;
    border: 1px solid #e2e8f0; border-radius: 12px; font-size: 0.9375rem;
    line-height: 1.7; color: #334155;
  }

  .wbs-quote {
    border-left: 3px solid #cbd5e1; padding: 1.25rem 1.5rem; margin: 1.5rem 0;
    background: #fff; border-radius: 0 12px 12px 0;
    font-size: 0.9375rem; line-height: 1.8; color: #334155; font-style: italic;
  }
  .wbs-quote cite {
    display: block; margin-top: 0.75rem; font-size: 0.8125rem; font-style: normal;
    color: #64748b; font-weight: 600;
  }

  .wbs-ref {
    padding: 1.25rem; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
    font-size: 0.875rem; line-height: 1.7; color: #334155;
  }
  .wbs-ref-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #94a3b8; margin-bottom: 4px; }

  .wbs-nav-link {
    display: inline-flex; align-items: center; border-radius: 8px; border: 1px solid #e2e8f0;
    background: #fff; padding: 10px 20px; font-size: 14px; font-weight: 600; color: #334155;
