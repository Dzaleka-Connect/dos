---
import MainLayout from '../layouts/MainLayout.astro';
import Faq from '../components/Faq.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

const supportCategories = [
  {
    title: 'Forms and submissions',
    description: 'Help with service listings, updates, applications, and content submissions'
  },
  {
    title: 'Site access',
    description: 'Report broken links, loading problems, search issues, or missing pages'
  },
  {
    title: 'Corrections',
    description: 'Send updates for services, resources, events, photos, or public records'
  },
  {
    title: 'Finding the right route',
    description: 'Ask where to start when your question does not fit one page'
  }
];

const quickLinks = [
  {
    title: 'Resources',
    description: 'Reports, legal materials, guides, and public documents',
    href: '/resources'
  },
  {
    title: 'Applications',
    description: 'Internal support forms and request pathways',
    href: '/applications'
  },
  {
    title: 'Photo Archive',
    description: 'Browse or submit photo records',
    href: '/photos'
  },
  {
    title: 'Contact Us',
    description: 'Get in touch with our team',
    href: '/contact'
  }
];
---

<MainLayout title="Support">
  <div>
    <!-- Hero Section -->
    <div class="bg-slate-900 text-white">
      <div class="container mx-auto px-4 pt-8 pb-16">
        <!-- Breadcrumb -->
        <div class="mb-8">
          <Breadcrumb
            light={true}
            items={[
              { label: 'Home', href: '/' },
              { label: 'Support' }
            ]}
          />
        </div>

        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-3xl font-bold mb-4 sm:text-4xl">Support and site help</h1>
          <p class="text-lg text-white sm:text-xl">
            Report a problem, ask for a correction, or get routed to the right page
          </p>
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 py-12">
      <div class="max-w-5xl mx-auto">
        <!-- Support Categories -->
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 mb-16">
          {supportCategories.map(category => (
            <div class="min-w-0 rounded border border-gray-100 bg-white p-6 transition-shadow duration-200">
              <h2 class="text-xl font-bold text-gray-900 mb-2 break-words">{category.title}</h2>
              <p class="text-gray-600 break-words">{category.description}</p>
            </div>
          ))}
        </div>

        <!-- Quick Links -->
        <div class="mb-16">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">Quick links</h2>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
            {quickLinks.map(link => (
              <a
                href={link.href}
                class="group block min-w-0 rounded bg-gray-50 p-6 transition-colors hover:bg-gray-100"
              >
                <h3 class="font-semibold text-gray-900 group-hover:text-primary-600 mb-1 break-words">
                  {link.title}
                </h3>
                <p class="text-sm text-gray-600 break-words">{link.description}</p>
              </a>
            ))}
          </div>
        </div>

        <!-- FAQ Section -->
        <section class="mb-16">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">Frequently asked questions</h2>
          <Faq />
        </section>

        <!-- Support Form -->
        <section class="bg-white rounded p-6 sm:p-8 border border-gray-100">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Get more help</h2>
          <p class="text-gray-600 mb-8">
            Send a clear message with the page, service, or issue you are asking about. If the situation is urgent, use <a href="/get-help-now" class="font-medium text-primary-700 underline">Get help now</a> first.
          </p>

          <form id="supportForm" action="https://formspree.io/f/xqaaajae" method="POST" class="submission-form space-y-6">
            <div class="grid gap-6 md:grid-cols-2">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700">Name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                />
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                />
              </div>
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-gray-700">Subject</label>
              <input
                type="text"
                id="subject"
                name="subject"
                required
                class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
              />
            </div>

            <div>
              <fieldset>
                <legend class="text-sm font-medium text-gray-700">Category <span class="font-normal text-slate-600">(optional)</span></legend>
                <div class="mt-2 space-y-2">
                  <div class="flex items-start gap-3">
                    <input type="radio" id="category-1" name="category" value="general" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                    <label for="category-1" class="text-sm text-gray-700">General inquiry</label>
                  </div>
                  <div class="flex items-start gap-3">
                    <input type="radio" id="category-2" name="category" value="technical" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                    <label for="category-2" class="text-sm text-gray-700">Technical issue</label>
                  </div>
                  <div class="flex items-start gap-3">
                    <input type="radio" id="category-3" name="category" value="application" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                    <label for="category-3" class="text-sm text-gray-700">Application help</label>
                  </div>
                  <div class="flex items-start gap-3">
                    <input type="radio" id="category-4" name="category" value="content" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                    <label for="category-4" class="text-sm text-gray-700">Content submission</label>
                  </div>
                  <div class="flex items-start gap-3">
                    <input type="radio" id="category-5" name="category" value="feedback" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                    <label for="category-5" class="text-sm text-gray-700">Feedback</label>
                  </div>
                </div>
              </fieldset>
            </div>

            <div>
              <fieldset>
                <legend class="text-sm font-medium text-gray-700">Priority level <span class="font-normal text-slate-600">(optional)</span></legend>
                <div class="mt-2 space-y-2">
                  <div class="flex items-start gap-3">
                    <input type="radio" id="priority-1" name="priority" value="low" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                    <label for="priority-1" class="text-sm text-gray-700">Low: general question</label>
                  </div>
                  <div class="flex items-start gap-3">
                    <input type="radio" id="priority-2" name="priority" value="medium" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                    <label for="priority-2" class="text-sm text-gray-700">Medium: need assistance</label>
                  </div>
                  <div class="flex items-start gap-3">
                    <input type="radio" id="priority-3" name="priority" value="high" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                    <label for="priority-3" class="text-sm text-gray-700">High: urgent issue</label>
                  </div>
                </div>
              </fieldset>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700">Message</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
              ></textarea>
            </div>

            <div>
              <button
                type="submit"
                id="submitButton"
                class="min-h-[44px] inline-flex w-full items-center justify-center px-6 py-3 border border-transparent rounded text-base font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 sm:w-auto"
              >
                <span id="submitText">Send Message</span>
                <svg
                  id="submitSpinner"
                  class="hidden animate-spin ml-3 h-5 w-5 text-white"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"
                  ></circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                  ></path>
                </svg>
              </button>
            </div>
          </form>
        </section>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  const form = document.getElementById('supportForm') as HTMLFormElement;
  const submitButton = document.getElementById('submitButton') as HTMLButtonElement;
  const submitText = document.getElementById('submitText') as HTMLElement;
  const submitSpinner = document.getElementById('submitSpinner') as HTMLElement;

  if (form && submitButton && submitText && submitSpinner) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Disable button and show spinner
      submitButton.disabled = true;
      submitText.textContent = 'Sending...';
      submitSpinner.classList.remove('hidden');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          // Show success message
          form.reset();
          if (window.showToast) {
            window.showToast('Message sent. We\'ll get back to you soon.', 'success');
          }
          submitText.textContent = 'Send Message';
        } else {
          throw new Error('Network response was not ok.');
        }
      } catch (error) {
        // Show error message
        if (window.showToast) {
          window.showToast('Failed to send message. Try again.', 'error');
        }
        console.error('Error:', error);
      } finally {
        // Re-enable button and hide spinner
        submitButton.disabled = false;
        submitSpinner.classList.add('hidden');
        submitText.textContent = 'Send Message';
      }
    });
  }
</script>
