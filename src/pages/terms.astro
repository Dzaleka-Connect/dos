---
import MainLayout from '../layouts/MainLayout.astro';

// SEO metadata
const seo = {
  description: "Read the terms and conditions for using Dzaleka Online Services. Learn about content guidelines, user submissions, privacy protection, intellectual property rights, and service usage policies for our refugee community platform.",
  type: "website",
  canonical: "https://services.dzaleka.com/terms",
  openGraph: {
    description: "Read the terms and conditions for using Dzaleka Online Services. Learn about content guidelines, user submissions, privacy protection, intellectual property rights, and service usage policies for our refugee community platform.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/terms"
  },
  twitter: {
    card: "summary",
    description: "Read the terms and conditions for using Dzaleka Online Services. Learn about content guidelines, user submissions, privacy protection, intellectual property rights, and service usage policies for our refugee community platform."
  }
};
---

<MainLayout
  title="Terms and Conditions"
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <div class="min-h-screen bg-gray-50">
    {/* Hero Section */}
    <div class="border-b border-gray-200 bg-white py-12 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
          <div class="inline-flex items-center space-x-2 bg-slate-100 border border-slate-200 rounded-full px-4 py-2 mb-6">
            <svg class="w-4 h-4 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span class="text-sm font-medium text-slate-700">Legal Information</span>
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900">
            Terms and Conditions
          </h1>
          <p class="text-lg text-gray-600">
            Read these terms carefully before using our services
          </p>
        </div>
      </div>
    </div>

    {/* Content Section */}
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="bg-white rounded border border-gray-200 p-5 sm:p-8">
        <div class="prose prose-lg max-w-none">
          <h2>1. Acceptance of Terms</h2>
          <p>
            By accessing and using the Dzaleka Online Services platform ("Service"), you accept and agree to be bound by these Terms and Conditions. This platform is an independent community-driven initiative and <strong>is not an official agency</strong>. It does not replace the services, legal counsel, or official channels of the United Nations High Commissioner for Refugees (UNHCR), the World Food Programme (WFP), or the Government of Malawi. We cannot guarantee aid, resettlement, or official status updates. If you disagree with any part of these terms, you may not access the Service.
          </p>

          <h2>2. Zero-Tolerance for Exploitation & Harassment</h2>
          <p>
            The safety, dignity, and unity of the Dzaleka community are paramount. We strictly enforce a zero-tolerance policy against:
          </p>
          <ul>
            <li>Using the platform for any form of exploitation, abuse, or human trafficking.</li>
            <li>Harassment, bullying, extortion, or intimidation of any community member.</li>
            <li>Hate speech or inciting violence or ethnic, national, or religious tension. Dzaleka is a diverse community representing multiple nationalities, and mutual respect is strictly required.</li>
          </ul>

          <h2>3. Misinformation Regarding Aid & Camp Services</h2>
          <p>
            Spreading false information in a refugee camp environment can cause serious harm and panic. You are strictly prohibited from publishing or sharing unverified or false information regarding:
          </p>
          <ul>
            <li>UNHCR resettlement processes, interviews, or eligibility.</li>
            <li>Food rations, cash distribution, or WFP and partner operations.</li>
            <li>Government of Malawi encampment policies, security actions, or legal rights.</li>
          </ul>

          <h2>4. Content Guidelines & Cultural Sensitivity</h2>
          <p>
            When submitting content to our Service, you agree to:
          </p>
          <ul>
            <li>Ensure all information shared is factual and well-intentioned.</li>
            <li>Respect the copyright and intellectual property rights of creators within and outside the camp.</li>
            <li>Never publish personal, sensitive, or identifying information about vulnerable individuals without their explicit, informed consent.</li>
            <li>Maintain respect for all nationalities, tribes, and religious affiliations present in the camp.</li>
          </ul>

          <h2>5. User Submissions</h2>
          <p>
            By submitting content to our Service, you:
          </p>
          <ul>
            <li>Grant us permission to display and share your content within the community.</li>
            <li>Confirm you have the explicit right to share the content.</li>
            <li>Accept that content may be reviewed before publishing.</li>
            <li>Understand content may be immediately removed without warning if it violates our safety or misinformation guidelines.</li>
          </ul>

          <h2>6. Privacy and Data Protection</h2>
          <p>
            We are committed to protecting your privacy in line with humanitarian "Do No Harm" principles. Refer to our <a href="/privacy" class="text-primary-600 hover:text-primary-700 underline">Privacy Policy</a> for detailed information on how we allow anonymity, pseudonyms, and strictly control third-party data sharing.
          </p>

          <h2>7. Intellectual Property</h2>
          <p>
            The Service and its original content (excluding user-submitted content) are protected by copyright and other intellectual property laws. Our logo, website design, and content created by our team may not be used without permission.
          </p>

          <h2>8. Resource Usage</h2>
          <p>
            Resources available through our Service:
          </p>
          <ul>
            <li>May be used for personal, educational, and community-uplifting purposes.</li>
            <li>Must be properly attributed when shared.</li>
            <li>Cannot be modified without permission or used to misrepresent the original creator.</li>
          </ul>

          <h2>9. Disclaimer</h2>
          <p>
            The Service is provided "as is" without warranties of any kind. We do not guarantee:
          </p>
          <ul>
            <li>Continuous, uninterrupted access to the Service.</li>
            <li>Complete accuracy of all user-submitted content or listings.</li>
            <li>Preservation of all submitted content.</li>
          </ul>

          <h2>10. Changes to Terms</h2>
          <p>
            We reserve the right to modify these terms at any time. Changes essential to the physical security or safety of the platform will be effective immediately. Your continued use of the Service constitutes acceptance of the modified terms.
          </p>

          <h2>11. Contact Information</h2>
          <p>
            For questions about these terms or to report a dangerous violation, contact us at:
          </p>
          <ul>
            <li>Email: info@mail.dzaleka.com</li>
            <li>Address: Dzaleka Refugee Camp, Dowa, Malawi</li>
          </ul>
        </div>

        <div class="mt-12 text-center">
          <a
            href="/"
            class="min-h-[44px] inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
          >
            Return to Homepage
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  /* Custom styles for prose content */
  .prose h2 {
    @apply text-2xl font-bold text-gray-900 mt-8 mb-4;
  }
  .prose h3 {
    @apply text-xl font-semibold text-gray-900 mt-6 mb-3;
  }
  .prose p {
    @apply text-gray-700 leading-relaxed mb-4;
  }
  .prose ul {
    @apply text-gray-700 mb-6 list-disc list-inside space-y-2;
  }
</style>
