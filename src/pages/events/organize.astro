---
import MainLayout from '../../layouts/MainLayout.astro';

const pageTitle = "Organize an Event - Dzaleka Online Services";
const pageDescription = "Create and organize events in the Dzaleka Refugee Camp community. Submit your event details to share with the community.";
const pageKeywords = "event organization, Dzaleka events, community events, refugee camp events, event submission";
const canonical = "https://services.dzaleka.com/events/organize";

// SEO metadata
const seo = {
  title: pageTitle,
  description: pageDescription,
  keywords: pageKeywords,
  type: "website",
  canonical: canonical,
  openGraph: {
    title: pageTitle,
    description: pageDescription,
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: canonical
  },
  twitter: {
    card: "summary_large_image",
    title: pageTitle,
    description: pageDescription
  }
};

// Breadcrumb structured data
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://services.dzaleka.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Events",
      "item": "https://services.dzaleka.com/events"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Organize Event",
      "item": "https://services.dzaleka.com/events/organize"
    }
  ]
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  keywords={seo.keywords}
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-gray-50 border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center space-x-4 py-3">
        <a href="/" class="text-gray-500 hover:text-gray-700 text-sm">
          Home
        </a>
        <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <a href="/events" class="text-gray-500 hover:text-gray-700 text-sm">
          Events
        </a>
        <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
        <span class="text-gray-900 text-sm font-medium">Organize Event</span>
      </div>
    </div>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />

  <div class="bg-white">
    <div class="max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:py-20 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <div class="w-16 h-16 bg-primary-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
        </div>
        <h1 class="text-4xl font-extrabold text-gray-900 sm:text-5xl sm:tracking-tight lg:text-6xl">
          Organize an Event
        </h1>
        <p class="mt-4 text-xl text-gray-500">
          Share your events with the Dzaleka community
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-4">
          <div class="bg-primary-50 rounded-full px-4 py-2 text-sm text-primary-700">
            Free to submit
          </div>
          <div class="bg-primary-50 rounded-full px-4 py-2 text-sm text-primary-700">
            Quick approval
          </div>
          <div class="bg-primary-50 rounded-full px-4 py-2 text-sm text-primary-700">
            Community reach
          </div>
        </div>
      </div>

      <!-- Combined Welcome & Benefits Section -->
      <div class="max-w-4xl mx-auto mb-12">
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl p-6 border border-blue-200">
          <div class="text-center mb-6">
            <h2 class="text-xl font-bold text-gray-900 mb-3">Share Your Event with the Community</h2>
            <p class="text-gray-600">We welcome cultural, educational, community, arts, sports, and business events</p>
          </div>
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Event Types -->
            <div>
              <h3 class="font-semibold text-gray-900 mb-4 text-center lg:text-left">Event Types We Welcome</h3>
                             <div class="grid grid-cols-2 gap-3">
                 <div class="bg-white rounded-lg p-3 shadow-sm border border-blue-100">
                   <div class="flex items-center">
                     <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2m-9 0h10m-10 0a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V6a2 2 0 00-2-2"></path>
                     </svg>
                     <span class="font-medium text-gray-900 text-sm">Cultural</span>
                   </div>
                 </div>
                 <div class="bg-white rounded-lg p-3 shadow-sm border border-blue-100">
                   <div class="flex items-center">
                     <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                     </svg>
                     <span class="font-medium text-gray-900 text-sm">Educational</span>
                   </div>
                 </div>
                 <div class="bg-white rounded-lg p-3 shadow-sm border border-blue-100">
                   <div class="flex items-center">
                     <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                     </svg>
                     <span class="font-medium text-gray-900 text-sm">Community</span>
                   </div>
                 </div>
                 <div class="bg-white rounded-lg p-3 shadow-sm border border-blue-100">
                   <div class="flex items-center">
                     <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                     </svg>
                     <span class="font-medium text-gray-900 text-sm">Arts</span>
                   </div>
                 </div>
                 <div class="bg-white rounded-lg p-3 shadow-sm border border-blue-100">
                   <div class="flex items-center">
                     <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                     </svg>
                     <span class="font-medium text-gray-900 text-sm">Sports</span>
                   </div>
                 </div>
                 <div class="bg-white rounded-lg p-3 shadow-sm border border-blue-100">
                   <div class="flex items-center">
                     <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                     </svg>
                     <span class="font-medium text-gray-900 text-sm">Business</span>
                   </div>
                 </div>
               </div>
            </div>

            <!-- Benefits -->
            <div>
              <h3 class="font-semibold text-gray-900 mb-4 text-center lg:text-left">Why Submit Your Event?</h3>
                             <div class="space-y-3">
                 <div class="flex items-start">
                   <div class="w-8 h-8 bg-primary-100 rounded-full flex items-center justify-center mr-3 flex-shrink-0">
                     <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                     </svg>
                   </div>
                   <div>
                     <h4 class="font-medium text-gray-900 text-sm">Community Reach</h4>
                     <p class="text-xs text-gray-600">Visible to thousands in Dzaleka</p>
                   </div>
                 </div>
                 <div class="flex items-start">
                   <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center mr-3 flex-shrink-0">
                     <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                     </svg>
                   </div>
                   <div>
                     <h4 class="font-medium text-gray-900 text-sm">Quick Approval</h4>
                     <p class="text-xs text-gray-600">24-48 hour review process</p>
                   </div>
                 </div>
                 <div class="flex items-start">
                   <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center mr-3 flex-shrink-0">
                     <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                       <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                     </svg>
                   </div>
                   <div>
                     <h4 class="font-medium text-gray-900 text-sm">Free Promotion</h4>
                     <p class="text-xs text-gray-600">No cost to submit or promote</p>
                   </div>
                 </div>
               </div>
            </div>
          </div>

          <div class="mt-6 text-center">
            <div class="inline-flex items-center px-4 py-2 bg-primary-100 text-primary-800 rounded-full text-sm font-medium">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              Community-focused and non-commercial events only
            </div>
          </div>
        </div>
      </div>

      <div class="mt-12">
        <form id="eventForm" action="https://formspree.io/f/xqaaajae" method="POST" class="space-y-8">
          <!-- Add hidden field for form name -->
          <input type="hidden" name="_subject" value="New Event Submission" />
          <input type="hidden" name="imageUrl" id="imageUrlInput" />
          
          <div class="space-y-8 divide-y divide-gray-200">
            <div class="space-y-6 sm:space-y-5">
              <div>
                <h3 class="text-lg leading-6 font-medium text-gray-900">
                  Event Details
                </h3>
                <p class="mt-1 max-w-2xl text-sm text-gray-500">
                  Provide information about your event
                </p>
              </div>

              <div class="space-y-6 sm:space-y-5">
                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="title" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Event Title
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <input
                      type="text"
                      name="title"
                      id="title"
                      required
                      class="block w-full shadow-sm focus:ring-primary-500 focus:border-primary-500 sm:text-sm border-gray-300 rounded-md"
                    />
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="description" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Description
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <textarea
                      id="description"
                      name="description"
                      rows="4"
                      required
                      class="block w-full shadow-sm focus:ring-primary-500 focus:border-primary-500 sm:text-sm border-gray-300 rounded-md"
                    ></textarea>
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="category" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Category
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <select
                      id="category"
                      name="category"
                      required
                      class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-primary-500 focus:border-primary-500 sm:text-sm rounded-md"
                    >
                      <option value="">Select a category</option>
                      <option value="Live Performance">Live Performance</option>
                      <option value="Zoom Meeting">Zoom Meeting</option>
                      <option value="Bootcamp / Workshop">Bootcamp / Workshop</option>
                      <option value="Seminar">Seminar</option>
                      <option value="Festival">Festival</option>
                      <option value="Youth Conference">Youth Conference</option>
                      <option value="Cultural Event">Cultural Event</option>
                      <option value="Tree Planting">Tree Planting</option>
                      <option value="Advocacy">Advocacy</option>
                      <option value="Film Screening">Film Screening</option>
                      <option value="Webinar">Webinar</option>
                      <option value="Dance Competition">Dance Competition</option>
                      <option value="Film Festival">Film Festival</option>
                      <option value="Community Meeting">Community Meeting</option>
                      <option value="Training">Training</option>
                      <option value="Other">Other</option>
                    </select>
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="date" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Start Date & Time
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <input
                      type="datetime-local"
                      name="date"
                      id="date"
                      required
                      min={new Date().toISOString().slice(0, 16)}
                      class="block w-full shadow-sm focus:ring-primary-500 focus:border-primary-500 sm:text-sm border-gray-300 rounded-md"
                    />
                    <p class="mt-1 text-sm text-gray-500">Please select a future date and time</p>
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="endDate" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    End Date & Time (optional)
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <input
                      type="datetime-local"
                      name="endDate"
                      id="endDate"
                      min={new Date().toISOString().slice(0, 16)}
                      class="block w-full shadow-sm focus:ring-primary-500 focus:border-primary-500 sm:text-sm border-gray-300 rounded-md"
                    />
                    <p class="mt-1 text-sm text-gray-500">Leave empty if same as start date</p>
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="location" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Location
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <input
                      type="text"
                      name="location"
                      id="location"
                      required
                      class="block w-full shadow-sm focus:ring-primary-500 focus:border-primary-500 sm:text-sm border-gray-300 rounded-md"
                    />
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="capacity" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Capacity (optional)
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <input
                      type="number"
                      name="capacity"
                      id="capacity"
                      min="1"
                      class="block w-full shadow-sm focus:ring-primary-500 focus:border-primary-500 sm:text-sm border-gray-300 rounded-md"
                    />
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="registrationRequired" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Registration Required
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <div class="flex items-center space-x-6">
                      <label class="flex items-center">
                        <input
                          type="radio"
                          name="registrationRequired"
                          value="yes"
                          class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300"
                        />
                        <span class="ml-2 text-sm text-gray-700">Yes</span>
                      </label>
                      <label class="flex items-center">
                        <input
                          type="radio"
                          name="registrationRequired"
                          value="no"
                          checked
                          class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300"
                        />
                        <span class="ml-2 text-sm text-gray-700">No</span>
                      </label>
                    </div>
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start" id="registrationUrlField" style="display: none;">
                  <label for="registrationUrl" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Registration URL
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <input
                      type="url"
                      name="registrationUrl"
                      id="registrationUrl"
                      placeholder="https://example.com/register"
                      class="block w-full shadow-sm focus:ring-primary-500 focus:border-primary-500 sm:text-sm border-gray-300 rounded-md"
                    />
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start" id="registrationDeadlineField" style="display: none;">
                  <label for="registrationDeadline" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Registration Deadline
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <input
                      type="datetime-local"
                      name="registrationDeadline"
                      id="registrationDeadline"
                      min={new Date().toISOString().slice(0, 16)}
                      class="block w-full shadow-sm focus:ring-primary-500 focus:border-primary-500 sm:text-sm border-gray-300 rounded-md"
                    />
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="image" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Event Image
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <input
                      type="file"
                      name="image"
                      id="image"
                      accept="image/*"
                      class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-medium file:bg-primary-50 file:text-primary-700 hover:file:bg-primary-100"
                    />
                    <p id="uploadStatus" class="mt-2 text-sm text-gray-500"></p>
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="tags" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Tags (optional)
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <input
                      type="text"
                      name="tags"
                      id="tags"
                      placeholder="refugee, community, education, culture"
                      class="block w-full shadow-sm focus:ring-primary-500 focus:border-primary-500 sm:text-sm border-gray-300 rounded-md"
                    />
                    <p class="mt-1 text-sm text-gray-500">Separate tags with commas</p>
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="featured" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Featured Event
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <div class="flex items-center">
                      <input
                        type="checkbox"
                        name="featured"
                        id="featured"
                        class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded"
                      />
                      <label for="featured" class="ml-2 text-sm text-gray-700">
                        Mark as featured event (will be highlighted on the site)
                      </label>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="pt-8 space-y-6 sm:pt-10 sm:space-y-5">
              <div>
                <h3 class="text-lg leading-6 font-medium text-gray-900">
                  Organizer Information
                </h3>
                <p class="mt-1 max-w-2xl text-sm text-gray-500">
                  Your contact information for event coordination
                </p>
              </div>

              <div class="space-y-6 sm:space-y-5">
                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="organizerName" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Name
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <input
                      type="text"
                      name="organizerName"
                      id="organizerName"
                      required
                      class="block w-full shadow-sm focus:ring-primary-500 focus:border-primary-500 sm:text-sm border-gray-300 rounded-md"
                    />
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="organizerEmail" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Email
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <input
                      type="email"
                      name="organizerEmail"
                      id="organizerEmail"
                      required
                      class="block w-full shadow-sm focus:ring-primary-500 focus:border-primary-500 sm:text-sm border-gray-300 rounded-md"
                    />
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="organizerPhone" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    Phone (optional)
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <input
                      type="tel"
                      name="organizerPhone"
                      id="organizerPhone"
                      class="block w-full shadow-sm focus:ring-primary-500 focus:border-primary-500 sm:text-sm border-gray-300 rounded-md"
                    />
                  </div>
                </div>

                <div class="sm:grid sm:grid-cols-3 sm:gap-4 sm:items-start">
                  <label for="organizerWhatsApp" class="block text-sm font-medium text-gray-700 sm:mt-px sm:pt-2">
                    WhatsApp (optional)
                  </label>
                  <div class="mt-1 sm:mt-0 sm:col-span-2">
                    <input
                      type="tel"
                      name="organizerWhatsApp"
                      id="organizerWhatsApp"
                      placeholder="+265-999-999-999"
                      class="block w-full shadow-sm focus:ring-primary-500 focus:border-primary-500 sm:text-sm border-gray-300 rounded-md"
                    />
                    <p class="mt-1 text-sm text-gray-500">Include country code (e.g., +265 for Malawi)</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Add success redirect -->
          <input type="hidden" name="_next" value="/events" />

          <div class="pt-5">
            <div class="flex justify-end">
              <button
                type="button"
                id="cancelButton"
                class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
              >
                Cancel
              </button>
              <button
                type="submit"
                id="submitButton"
                class="ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
              >
                <span id="submitText">New Event</span>
                <span id="submitSpinner" class="hidden ml-2">Submitting...</span>
              </button>
            </div>
          </div>
        </form>

        <!-- Privacy Policy and Terms Notice -->
        <div class="mt-6 p-4 bg-gray-50 rounded-lg">
          <p class="text-xs text-gray-600 text-center">
            By submitting this event, you agree to our{' '}
            <a href="/privacy" class="text-primary-600 hover:text-primary-700 underline">Privacy Policy</a>
            {' '}and{' '}
            <a href="/terms" class="text-primary-600 hover:text-primary-700 underline">Terms of Service</a>
            . Your event will be subject to review and approval before publication.
          </p>
        </div>

        <!-- Success Message -->
        <div id="successMessage" class="hidden mt-4 rounded-md bg-green-50 p-4">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-green-800">
                Event submitted successfully!
              </h3>
              <div class="mt-2 text-sm text-green-700">
                <p>Thank you for submitting your event. We'll review it and get back to you within 24-48 hours.</p>
              </div>
              <div class="mt-4">
                <div class="-mx-2 -my-1.5 flex">
                  <button
                    type="button"
                    onclick="window.location.href='/events'"
                    class="bg-green-50 px-2 py-1.5 rounded-md text-sm font-medium text-green-800 hover:bg-green-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-green-50 focus:ring-green-600"
                  >
                    View All Events
                  </button>
                  <button
                    type="button"
                    onclick="window.location.href='/events/organize'"
                    class="ml-3 bg-green-50 px-2 py-1.5 rounded-md text-sm font-medium text-green-800 hover:bg-green-100 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-green-50 focus:ring-green-600"
                  >
                    Submit Another Event
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Error Message -->
        <div id="errorMessage" class="hidden mt-4 rounded-md bg-red-50 p-4">
          <div class="flex">
            <div class="ml-3">
              <p class="text-sm font-medium text-red-800">
                Error creating event. Please try again.
              </p>
            </div>
                      </div>
          </div>
        </div>
      </div>


    </div>
  </MainLayout>

<script>
  const form = document.getElementById('eventForm') as HTMLFormElement;
  const imageInput = document.getElementById('image') as HTMLInputElement;
  const imageUrlInput = document.getElementById('imageUrlInput') as HTMLInputElement;
  const uploadStatus = document.getElementById('uploadStatus') as HTMLParagraphElement;
  const submitButton = document.getElementById('submitButton') as HTMLButtonElement;
  const submitText = document.getElementById('submitText') as HTMLElement;
  const submitSpinner = document.getElementById('submitSpinner') as HTMLElement;
  const successMessage = document.getElementById('successMessage') as HTMLElement;
  const errorMessage = document.getElementById('errorMessage') as HTMLElement;
  const cancelButton = document.getElementById('cancelButton') as HTMLButtonElement;
  const registrationRequiredRadios = document.querySelectorAll('input[name="registrationRequired"]') as NodeListOf<HTMLInputElement>;
  const registrationUrlField = document.getElementById('registrationUrlField') as HTMLDivElement;
  const registrationDeadlineField = document.getElementById('registrationDeadlineField') as HTMLDivElement;

  // Handle registration required radio buttons
  registrationRequiredRadios.forEach(radio => {
    radio.addEventListener('change', (e) => {
      const isRequired = (e.target as HTMLInputElement).value === 'yes';
      registrationUrlField.style.display = isRequired ? 'grid' : 'none';
      registrationDeadlineField.style.display = isRequired ? 'grid' : 'none';
      
      // Clear fields when hiding
      if (!isRequired) {
        (document.getElementById('registrationUrl') as HTMLInputElement).value = '';
        (document.getElementById('registrationDeadline') as HTMLInputElement).value = '';
      }
    });
  });

  imageInput.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    // Disable submit button while uploading
    submitButton.disabled = true;
    uploadStatus.textContent = 'Uploading image...';

    try {
      // Create FormData for image upload
      const formData = new FormData();
      formData.append('file', file);
      formData.append('upload_preset', 'dzaleka_events');

      // Upload to Cloudinary
      const response = await fetch(
        `https://api.cloudinary.com/v1_1/dcvwslmow/image/upload`,
        {
          method: 'POST',
          body: formData
        }
      );

      const data = await response.json();
      
      if (data.secure_url) {
        imageUrlInput.value = data.secure_url;
        uploadStatus.textContent = 'Image uploaded successfully!';
        uploadStatus.classList.remove('text-red-500');
        uploadStatus.classList.add('text-green-500');
      } else {
        throw new Error('Upload failed');
      }
    } catch (error) {
      console.error('Upload error:', error);
      uploadStatus.textContent = 'Failed to upload image. Please try again.';
      uploadStatus.classList.remove('text-green-500');
      uploadStatus.classList.add('text-red-500');
    } finally {
      // Re-enable submit button
      submitButton.disabled = false;
    }
  });

  // Form validation and submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    // Check if image is still uploading
    if (!imageUrlInput.value && imageInput.files?.length) {
      alert('Please wait for the image to finish uploading.');
      return;
    }
    
    // Validate start date
    const dateInput = document.getElementById('date') as HTMLInputElement;
    const endDateInput = document.getElementById('endDate') as HTMLInputElement;
    const selectedDate = new Date(dateInput.value);
    const selectedEndDate = endDateInput.value ? new Date(endDateInput.value) : null;
    const now = new Date();
    
    if (selectedDate <= now) {
      alert('Please select a future date and time for your event.');
      dateInput.focus();
      return;
    }
    
    // Validate end date if provided
    if (selectedEndDate && selectedEndDate <= selectedDate) {
      alert('End date must be after the start date.');
      endDateInput.focus();
      return;
    }
    
    // Show loading state
    submitButton.disabled = true;
    submitText.classList.add('hidden');
    submitSpinner.classList.remove('hidden');
    
    try {
      // Submit the form using FormData
      const formData = new FormData(form);
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json',
        },
      });
      
      if (response.ok) {
        // Show success message
        successMessage.classList.remove('hidden');
        errorMessage.classList.add('hidden');
        
        // Reset form
        form.reset();
        
        // Scroll to success message
        successMessage.scrollIntoView({ behavior: 'smooth' });
      } else {
        throw new Error('Submission failed');
      }
    } catch (error) {
      console.error('Submission error:', error);
      // Show error message
      errorMessage.classList.remove('hidden');
      successMessage.classList.add('hidden');
    } finally {
      // Reset button state
      submitButton.disabled = false;
      submitText.classList.remove('hidden');
      submitSpinner.classList.add('hidden');
    }
  });

  cancelButton.addEventListener('click', () => {
    window.location.href = '/events';
  });
</script>
