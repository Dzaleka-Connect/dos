---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import Badge from '../../components/ui/Badge.astro';
import EventGrid from '../../components/events/EventGrid.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

export const prerender = false;

const events = await getCollection('events');

// Function to determine if an event is upcoming
function isUpcoming(date: Date) {
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const eventDate = new Date(date);
  eventDate.setHours(0, 0, 0, 0);
  return eventDate >= today;
}

// Function to check if event is TBA
function isTBA(title: string) {
  return title.toLowerCase().includes('tba');
}

// Filter and sort upcoming events
const allUpcomingEvents = events
  .filter(event => isUpcoming(event.data.date))
  .map(event => ({
    ...event,
    data: { 
      ...event.data, 
      status: 'upcoming',
      isTBA: isTBA(event.data.title)
    }
  }))
  .sort((a, b) => {
    // Sort TBA events to the end
    if (a.data.isTBA && !b.data.isTBA) return 1;
    if (!a.data.isTBA && b.data.isTBA) return -1;
    return new Date(a.data.date).getTime() - new Date(b.data.date).getTime();
  });

// Filter and sort past events
const allPastEvents = events
  .filter(event => !isUpcoming(event.data.date))
  .map(event => ({
    ...event,
    data: { 
      ...event.data, 
      status: 'past',
      isTBA: isTBA(event.data.title)
    }
  }))
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

// Get first 4 events of each type
const upcomingEvents = allUpcomingEvents.slice(0, 4);
const pastEvents = allPastEvents.slice(0, 4);

// Create SEO metadata
const seo = {
  title: "What’s On in Dzaleka Refugee Camp",
  description: "Discover events and activities in Dzaleka Refugee Camp — cultural festivals, education programs, and more happening this week and beyond.",
  type: "website",
  canonical: "https://services.dzaleka.com/events",
  openGraph: {
    title: "What’s On in Dzaleka Refugee Camp",
    description: "Discover events and activities in Dzaleka Refugee Camp — cultural festivals, education programs, and more happening this week and beyond.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/events"
  },
  twitter: {
    card: "summary_large_image",
    title: "What’s On in Dzaleka Refugee Camp",
    description: "Discover events and activities in Dzaleka Refugee Camp — cultural festivals, education programs, and more happening this week and beyond."
  }
};

// Create structured data for events
const eventsStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Cultural Events at Dzaleka",
  "description": "Discover events and activities in Dzaleka Refugee Camp — cultural festivals, education programs, and more happening this week and beyond.",
  "url": "https://services.dzaleka.com/events",
  "itemListElement": [
    ...upcomingEvents.map((event, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Event",
        "name": event.data.title,
        "description": event.data.description,
        "image": event.data.image.startsWith('http') ? event.data.image : `https://services.dzaleka.com${event.data.image}`,
        "startDate": event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date,
        "endDate": event.data.endDate ? (event.data.endDate instanceof Date ? event.data.endDate.toISOString() : event.data.endDate) : (event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date),
        "eventStatus": event.data.isTBA ? "https://schema.org/EventPostponed" : "https://schema.org/EventScheduled",
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "location": {
          "@type": "Place",
          "name": "Dzaleka Refugee Camp",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Dowa District",
            "addressLocality": "Dzaleka",
            "addressRegion": "Central Region",
            "postalCode": "",
            "addressCountry": "MW"
          }
        },
        "organizer": {
          "@type": "Organization",
          "name": event.data.organizer || "Dzaleka Online Services",
          "url": event.data.organizerUrl || "https://services.dzaleka.com"
        },
        "performer": {
          "@type": "Organization",
          "name": event.data.organizer || "Dzaleka Online Services"
        },
        "offers": {
          "@type": "Offer",
          "url": event.data.registration?.url || `https://services.dzaleka.com/events/${event.id}`,
          "price": "0",
          "priceCurrency": "MWK",
          "availability": "https://schema.org/InStock"
        },
        "url": `https://services.dzaleka.com/events/${event.id}`
      }
    })),
    ...pastEvents.map((event, index) => ({
      "@type": "ListItem",
      "position": upcomingEvents.length + index + 1,
      "item": {
        "@type": "Event",
        "name": event.data.title,
        "description": event.data.description,
        "image": event.data.image.startsWith('http') ? event.data.image : `https://services.dzaleka.com${event.data.image}`,
        "startDate": event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date,
        "endDate": event.data.endDate ? (event.data.endDate instanceof Date ? event.data.endDate.toISOString() : event.data.endDate) : (event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date),
        "eventStatus": "https://schema.org/EventCompleted",
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "location": {
          "@type": "Place",
          "name": "Dzaleka Refugee Camp",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Dowa District",
            "addressLocality": "Dzaleka",
            "addressRegion": "Central Region",
            "postalCode": "",
            "addressCountry": "MW"
          }
        },
        "organizer": {
          "@type": "Organization",
          "name": event.data.organizer || "Dzaleka Online Services",
          "url": event.data.organizerUrl || "https://services.dzaleka.com"
        },
        "performer": {
          "@type": "Organization",
          "name": event.data.organizer || "Dzaleka Online Services"
        },
        "offers": {
          "@type": "Offer",
          "url": event.data.registration?.url || `https://services.dzaleka.com/events/${event.id}`,
          "price": "0",
          "priceCurrency": "MWK",
          "availability": "https://schema.org/InStock"
        },
        "url": `https://services.dzaleka.com/events/${event.id}`
      }
    }))
  ]
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(eventsStructuredData)} />

  <main class="min-h-screen">
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-br from-primary-50 to-white border-b-2 border-primary-200 mb-12 overflow-hidden">
      <!-- Subtle African Pattern Background -->
      <div class="absolute inset-0 opacity-[0.03]">
        <div class="absolute inset-0 pattern-mudcloth"></div>
      </div>

      <div class="relative container mx-auto px-4 pt-8 pb-16">
        <!-- Breadcrumb Navigation -->
        <div class="mb-8">
          <Breadcrumb items={[
            { label: 'Home', href: '/' },
            { label: 'Events' }
          ]} />
        </div>

        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-block mb-6">
            <span class="px-4 py-1.5 bg-primary-100 text-primary-700 rounded-full text-sm font-medium border border-primary-200">
              Community Events
            </span>
          </div>

          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            What's On in Dzaleka
          </h1>
          <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
            Cultural festivals, performances, webinars, workshops, and community gatherings — discover the vibrant spirit of our community
          </p>
          <a
            href="/events/organize"
            class="inline-flex items-center px-6 py-3 border border-transparent rounded-lg text-base font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors shadow-md"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            Submit Your Event
          </a>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 py-12">
      <!-- Upcoming Events -->
    <section class="mb-20">
      <div class="mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-center">Upcoming Events</h2>
        <p class="text-lg text-gray-600 text-center">Discover what's happening next in our community</p>
      </div>

      {allUpcomingEvents.length > 0 ? (
        <div>
          <EventGrid events={upcomingEvents} />
          {allUpcomingEvents.length > 4 && (
            <div class="mt-12 text-center">
              <a
                href="/events/upcoming/1"
                class="group inline-flex items-center text-white bg-primary-600 hover:bg-primary-700 font-semibold px-8 py-4 rounded-lg shadow-md transition-colors"
              >
                Explore All Upcoming Events ({allUpcomingEvents.length})
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-3 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          )}
        </div>
      ) : (
        <div class="text-center bg-white p-12 rounded-xl border border-gray-200">
          <p class="text-gray-700 text-lg leading-relaxed max-w-2xl mx-auto">
            There's always something happening in Dzaleka Refugee Camp. If you're organizing an event, workshop, or community gathering, share it with us and we'll help spread the word.
          </p>
        </div>
      )}
    </section>

    <!-- Past Events -->
    <section class="bg-gray-50 py-16 -mx-4 px-4">
      <div class="max-w-6xl mx-auto">
        <div class="mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-center">Past Events</h2>
          <p class="text-lg text-gray-600 text-center">Relive the memories of our previous community gatherings</p>
        </div>
        {allPastEvents.length > 0 ? (
          <div>
            <EventGrid events={pastEvents} />
            {allPastEvents.length > 4 && (
              <div class="mt-12 text-center">
                <a
                  href="/events/past/1"
                  class="group inline-flex items-center text-primary-600 border-2 border-primary-600 hover:bg-primary-600 hover:text-white font-semibold px-8 py-4 rounded-lg shadow-md bg-white transition-colors"
                >
                  View All Past Events ({allPastEvents.length})
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-3 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            )}
          </div>
        ) : (
          <div class="text-center bg-white p-12 rounded-xl border border-gray-200">
            <p class="text-gray-700 text-lg">No past events to display yet.</p>
          </div>
        )}
      </div>
    </section>
    </div>
  </main>
</MainLayout>