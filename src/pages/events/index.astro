---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import Badge from '../../components/ui/Badge.astro';
import EventGrid from '../../components/events/EventGrid.astro';

const events = await getCollection('events');

// Function to determine if an event is upcoming
function isUpcoming(date: Date) {
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const eventDate = new Date(date);
  eventDate.setHours(0, 0, 0, 0);
  return eventDate >= today;
}

// Function to check if event is TBA
function isTBA(title: string) {
  return title.toLowerCase().includes('tba');
}

// Filter and sort upcoming events
const allUpcomingEvents = events
  .filter(event => isUpcoming(event.data.date))
  .map(event => ({
    ...event,
    data: { 
      ...event.data, 
      status: 'upcoming',
      isTBA: isTBA(event.data.title)
    }
  }))
  .sort((a, b) => {
    // Sort TBA events to the end
    if (a.data.isTBA && !b.data.isTBA) return 1;
    if (!a.data.isTBA && b.data.isTBA) return -1;
    return new Date(a.data.date).getTime() - new Date(b.data.date).getTime();
  });

// Filter and sort past events
const allPastEvents = events
  .filter(event => !isUpcoming(event.data.date))
  .map(event => ({
    ...event,
    data: { 
      ...event.data, 
      status: 'past',
      isTBA: isTBA(event.data.title)
    }
  }))
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

// Get first 4 events of each type
const upcomingEvents = allUpcomingEvents.slice(0, 4);
const pastEvents = allPastEvents.slice(0, 4);

// Create SEO metadata
const seo = {
  title: "What’s On in Dzaleka Refugee Camp",
  description: "Discover events and activities in Dzaleka Refugee Camp — cultural festivals, education programs, and more happening this week and beyond.",
  type: "website",
  canonical: "https://services.dzaleka.com/events",
  openGraph: {
    title: "What’s On in Dzaleka Refugee Camp",
    description: "Discover events and activities in Dzaleka Refugee Camp — cultural festivals, education programs, and more happening this week and beyond.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/events"
  },
  twitter: {
    card: "summary_large_image",
    title: "What’s On in Dzaleka Refugee Camp",
    description: "Discover events and activities in Dzaleka Refugee Camp — cultural festivals, education programs, and more happening this week and beyond."
  }
};

// Create structured data for events
const eventsStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Cultural Events at Dzaleka",
  "description": "Discover events and activities in Dzaleka Refugee Camp — cultural festivals, education programs, and more happening this week and beyond.",
  "url": "https://services.dzaleka.com/events",
  "itemListElement": [
    ...upcomingEvents.map((event, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Event",
        "name": event.data.title,
        "description": event.data.description,
        "image": event.data.image.startsWith('http') ? event.data.image : `https://services.dzaleka.com${event.data.image}`,
        "startDate": event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date,
        "endDate": event.data.endDate ? (event.data.endDate instanceof Date ? event.data.endDate.toISOString() : event.data.endDate) : (event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date),
        "eventStatus": event.data.isTBA ? "https://schema.org/EventPostponed" : "https://schema.org/EventScheduled",
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "location": {
          "@type": "Place",
          "name": "Dzaleka Refugee Camp",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Dowa District",
            "addressLocality": "Dzaleka",
            "addressRegion": "Central Region",
            "postalCode": "",
            "addressCountry": "MW"
          }
        },
        "organizer": {
          "@type": "Organization",
          "name": event.data.organizer || "Dzaleka Online Services",
          "url": event.data.organizerUrl || "https://services.dzaleka.com"
        },
        "performer": {
          "@type": "Organization",
          "name": event.data.organizer || "Dzaleka Online Services"
        },
        "offers": {
          "@type": "Offer",
          "url": event.data.registration?.url || `https://services.dzaleka.com/events/${event.slug}`,
          "price": "0",
          "priceCurrency": "MWK",
          "availability": "https://schema.org/InStock"
        },
        "url": `https://services.dzaleka.com/events/${event.slug}`
      }
    })),
    ...pastEvents.map((event, index) => ({
      "@type": "ListItem",
      "position": upcomingEvents.length + index + 1,
      "item": {
        "@type": "Event",
        "name": event.data.title,
        "description": event.data.description,
        "image": event.data.image.startsWith('http') ? event.data.image : `https://services.dzaleka.com${event.data.image}`,
        "startDate": event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date,
        "endDate": event.data.endDate ? (event.data.endDate instanceof Date ? event.data.endDate.toISOString() : event.data.endDate) : (event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date),
        "eventStatus": "https://schema.org/EventCompleted",
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "location": {
          "@type": "Place",
          "name": "Dzaleka Refugee Camp",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Dowa District",
            "addressLocality": "Dzaleka",
            "addressRegion": "Central Region",
            "postalCode": "",
            "addressCountry": "MW"
          }
        },
        "organizer": {
          "@type": "Organization",
          "name": event.data.organizer || "Dzaleka Online Services",
          "url": event.data.organizerUrl || "https://services.dzaleka.com"
        },
        "performer": {
          "@type": "Organization",
          "name": event.data.organizer || "Dzaleka Online Services"
        },
        "offers": {
          "@type": "Offer",
          "url": event.data.registration?.url || `https://services.dzaleka.com/events/${event.slug}`,
          "price": "0",
          "priceCurrency": "MWK",
          "availability": "https://schema.org/InStock"
        },
        "url": `https://services.dzaleka.com/events/${event.slug}`
      }
    }))
  ]
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(eventsStructuredData)} />
  
  <main class="container mx-auto px-4 py-8">
    <!-- Hero Section -->
    <div class="relative bg-gradient-to-br from-primary-600 to-primary-800 rounded-2xl overflow-hidden mb-12">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="relative px-6 py-12 md:py-16 text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
          What’s On
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto">
          Explore the current and upcoming events in Dzaleka Refugee Camp — from cultural festivals and performances to webinars, workshops, and community gatherings.
        </p>
      </div>
    </div>

    <!-- Upcoming Events -->
    <section class="mb-16">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-2">Upcoming Events</h2>
          <p class="text-gray-600">Discover what's happening next in our community</p>
        </div>
        <div class="flex items-center gap-4">
          <a
            href="/events/organize"
            class="group inline-flex items-center gap-2 px-6 py-3 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700 hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
            Submit an Event
          </a>
        </div>
      </div>

      {allUpcomingEvents.length > 0 ? (
        <div>
          <EventGrid events={upcomingEvents} />
          {allUpcomingEvents.length > 4 && (
            <div class="mt-8 text-center">
              <a 
                href="/events/upcoming/1" 
                class="group inline-flex items-center text-primary-600 hover:text-primary-700 font-medium px-6 py-3 bg-primary-50 rounded-lg hover:bg-primary-100 transition-all duration-200"
              >
                View All Upcoming Events ({allUpcomingEvents.length})
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          )}
        </div>
      ) : (
        <p class="text-gray-600 text-center">There’s always something on in Dzaleka Refugee Camp. If you’re a local business or community group and would like to post your event or story on our website, click a button, fill out the details, and once approved, it will appear in our event listing.</p>
      )}
    </section>

    <!-- Past Events -->
    <section>
      <div class="mb-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-2">Past Events</h2>
        <p class="text-gray-600">Relive the memories of our previous community gatherings</p>
      </div>
      {allPastEvents.length > 0 ? (
        <div>
          <EventGrid events={pastEvents} />
          {allPastEvents.length > 4 && (
            <div class="mt-8 text-center">
              <a 
                href="/events/past/1" 
                class="group inline-flex items-center text-primary-600 hover:text-primary-700 font-medium px-6 py-3 bg-primary-50 rounded-lg hover:bg-primary-100 transition-all duration-200"
              >
                View All Past Events ({allPastEvents.length})
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          )}
        </div>
      ) : (
        <p class="text-gray-600 text-center">No past events to display.</p>
      )}
    </section>
  </main>
</MainLayout>