---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import Badge from '../../components/ui/Badge.astro';
import EventGrid from '../../components/events/EventGrid.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

export const prerender = false;

const events = await getCollection('events');

// Function to determine if an event is upcoming
function isUpcoming(date: Date) {
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const eventDate = new Date(date);
  eventDate.setHours(0, 0, 0, 0);
  return eventDate >= today;
}

// Function to check if event is TBA
function isEventTBA(event: any) {
  return Boolean(event.data.isTBA) || event.data.title.toLowerCase().includes('tba');
}

// Filter and sort upcoming events
const allUpcomingEvents = events
  .filter(event => isEventTBA(event) || isUpcoming(event.data.date))
  .map(event => ({
    ...event,
    data: {
      ...event.data,
      status: 'upcoming',
      isTBA: isEventTBA(event)
    }
  }))
  .sort((a, b) => {
    // Sort TBA events to the end
    if (a.data.isTBA && !b.data.isTBA) return 1;
    if (!a.data.isTBA && b.data.isTBA) return -1;
    return new Date(a.data.date).getTime() - new Date(b.data.date).getTime();
  });

// Filter and sort past events
const allPastEvents = events
  .filter(event => !isEventTBA(event) && !isUpcoming(event.data.date))
  .map(event => ({
    ...event,
    data: {
      ...event.data,
      status: 'past',
      isTBA: false
    }
  }))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Get first 4 events of each type
const upcomingEvents = allUpcomingEvents.slice(0, 4);
const pastEvents = allPastEvents.slice(0, 4);
const todayIso = new Date().toISOString().split('T')[0];

// Create SEO metadata
const seo = {
  title: "What’s On in Dzaleka Refugee Camp",
  description: "Discover events and activities in Dzaleka Refugee Camp — cultural festivals, education programs, and more happening this week and beyond.",
  type: "website",
  canonical: "https://services.dzaleka.com/events",
  openGraph: {
    title: "What’s On in Dzaleka Refugee Camp",
    description: "Discover events and activities in Dzaleka Refugee Camp — cultural festivals, education programs, and more happening this week and beyond.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/events"
  },
  twitter: {
    card: "summary_large_image",
    title: "What’s On in Dzaleka Refugee Camp",
    description: "Discover events and activities in Dzaleka Refugee Camp — cultural festivals, education programs, and more happening this week and beyond."
  }
};

// Create structured data for events
const eventsStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Cultural Events at Dzaleka",
  "description": "Discover events and activities in Dzaleka Refugee Camp — cultural festivals, education programs, and more happening this week and beyond.",
  "url": "https://services.dzaleka.com/events",
  "itemListElement": [
    ...upcomingEvents.map((event, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Event",
        "name": event.data.title,
        "description": event.data.description,
        "image": event.data.image.startsWith('http') ? event.data.image : `https://services.dzaleka.com${event.data.image}`,
        "startDate": event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date,
        "endDate": event.data.endDate ? (event.data.endDate instanceof Date ? event.data.endDate.toISOString() : event.data.endDate) : (event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date),
        "eventStatus": event.data.isTBA ? "https://schema.org/EventPostponed" : "https://schema.org/EventScheduled",
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "location": {
          "@type": "Place",
          "name": "Dzaleka Refugee Camp",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Dzaleka Refugee Camp",
            "addressLocality": "Dzaleka",
            "addressRegion": "Central Region",
            "postalCode": "DZ001",
            "addressCountry": "MW"
          }
        },
        "organizer": {
          "@type": "Organization",
          "name": event.data.organizer || "Dzaleka Online Services",
          "url": event.data.organizerUrl || "https://services.dzaleka.com"
        },
        "performer": {
          "@type": "PerformingGroup",
          "name": event.data.organizer || "Dzaleka Online Services"
        },
        "offers": {
          "@type": "Offer",
          "url": event.data.registration?.url || `https://services.dzaleka.com/events/${event.id}`,
          "price": "0",
          "priceCurrency": "MWK",
          "validFrom": todayIso,
          "availability": "https://schema.org/InStock"
        },
        "url": `https://services.dzaleka.com/events/${event.id}`
      }
    })),
    ...pastEvents.map((event, index) => ({
      "@type": "ListItem",
      "position": upcomingEvents.length + index + 1,
      "item": {
        "@type": "Event",
        "name": event.data.title,
        "description": event.data.description,
        "image": event.data.image.startsWith('http') ? event.data.image : `https://services.dzaleka.com${event.data.image}`,
        "startDate": event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date,
        "endDate": event.data.endDate ? (event.data.endDate instanceof Date ? event.data.endDate.toISOString() : event.data.endDate) : (event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date),
        "eventStatus": "https://schema.org/EventCompleted",
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "location": {
          "@type": "Place",
          "name": "Dzaleka Refugee Camp",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Dzaleka Refugee Camp",
            "addressLocality": "Dzaleka",
            "addressRegion": "Central Region",
            "postalCode": "DZ001",
            "addressCountry": "MW"
          }
        },
        "organizer": {
          "@type": "Organization",
          "name": event.data.organizer || "Dzaleka Online Services",
          "url": event.data.organizerUrl || "https://services.dzaleka.com"
        },
        "performer": {
          "@type": "PerformingGroup",
          "name": event.data.organizer || "Dzaleka Online Services"
        },
        "offers": {
          "@type": "Offer",
          "url": event.data.registration?.url || `https://services.dzaleka.com/events/${event.id}`,
          "price": "0",
          "priceCurrency": "MWK",
          "availability": "https://schema.org/InStock"
        },
        "url": `https://services.dzaleka.com/events/${event.id}`
      }
    }))
  ]
};
---

<MainLayout
  title={seo.title}
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(eventsStructuredData)} />

  <div class="min-h-screen">
    <section class="border-b border-gray-200 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
        <div class="max-w-3xl">
          <div class="mb-6">
            <Breadcrumb items={[
              { label: 'Home', href: '/' },
              { label: 'Events' }
            ]} />
          </div>

          <h1 class="text-4xl font-semibold text-slate-900 sm:text-5xl mb-4">
            What's On in Dzaleka
          </h1>
          <p class="text-sm leading-6 text-slate-600 mb-8 max-w-2xl">
            Cultural festivals, performances, webinars, workshops, and community gatherings in and beyond Dzaleka.
          </p>

          <a
            href="/events/organize"
            class="min-h-[44px] inline-flex items-center px-4 py-2 border border-slate-300 text-sm font-medium rounded text-slate-700 bg-white hover:bg-slate-50 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-slate-500" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 01-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            Submit Your Event
          </a>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 py-12">
      <!-- Upcoming Events -->
    <section class="mb-20">
      <div class="mb-10 max-w-2xl">
        <h2 class="text-3xl font-semibold text-gray-900 mb-3">Upcoming events</h2>
        <p class="text-lg text-gray-600">Dates, venues, organizers, and registration links where available.</p>
      </div>

      {allUpcomingEvents.length > 0 ? (
        <div>
          <EventGrid events={upcomingEvents} />
          {allUpcomingEvents.length > 4 && (
            <div class="mt-12 text-center">
              <a
                href="/events/upcoming/1"
                class="min-h-[44px] inline-flex items-center text-gray-900 bg-white border border-gray-300 hover:bg-gray-50 font-medium px-6 py-3 rounded transition-colors text-sm"
              >
                Explore All Upcoming Events ({allUpcomingEvents.length})
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          )}
        </div>
      ) : (
        <div class="rounded border border-gray-200 bg-white p-5 sm:p-8">
          <p class="text-lg font-semibold text-gray-900">No upcoming events listed right now.</p>
          <p class="mt-2 text-gray-600">
            Check the <a href="/events/past/1" class="font-semibold text-gray-900 underline underline-offset-2 hover:text-gray-600">past events archive</a>, or
            <a href="/events/organize" class="font-semibold text-gray-900 underline underline-offset-2 hover:text-gray-600">submit your event</a> if you're organizing something.
          </p>
        </div>
      )}
    </section>

    <!-- Past Events -->
    <section class="bg-gray-50 py-16 -mx-4 px-4">
      <div class="max-w-6xl mx-auto">
        <div class="mb-10 max-w-2xl">
          <h2 class="text-3xl font-semibold text-gray-900 mb-3">Past events</h2>
          <p class="text-lg text-gray-600">Recent gatherings, talks, festivals, performances, and community meetings.</p>
        </div>
        {allPastEvents.length > 0 ? (
          <div>
            <EventGrid events={pastEvents} />
            {allPastEvents.length > 4 && (
              <div class="mt-12 text-center">
                <a
                  href="/events/past/1"
                  class="min-h-[44px] inline-flex items-center text-gray-600 border border-gray-300 hover:bg-gray-50 font-medium px-6 py-3 rounded bg-white transition-colors text-sm"
                >
                  View All Past Events ({allPastEvents.length})
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            )}
          </div>
        ) : (
          <div class="text-center bg-white p-5 sm:p-8 rounded border border-gray-200">
            <p class="text-gray-700 text-lg">No past events to display yet.</p>
          </div>
        )}
      </div>
    </section>
    </div>
  </div>
</MainLayout>
