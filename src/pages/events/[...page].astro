---
import MainLayout from '../../layouts/MainLayout.astro';
import EventGrid from '../../components/events/EventGrid.astro';
import EventPagination from '../../components/events/EventPagination.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allEvents = await getCollection('events');
  const itemsPerPage = 6;
  const totalPages = Math.ceil(allEvents.length / itemsPerPage);
  
  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: (i + 2).toString() }, // Start from page 2
  }));
}

const { page } = Astro.params;
const currentPage = parseInt(page);

// Get all events
const allEvents = await getCollection('events');

// Sort events by status and date
const sortedEvents = allEvents.sort((a, b) => {
  if (a.data.status !== b.data.status) {
    return a.data.status === 'upcoming' ? -1 : 1;
  }
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

// Pagination
const itemsPerPage = 6;
const totalItems = sortedEvents.length;
const totalPages = Math.max(1, Math.ceil(totalItems / itemsPerPage));
const validCurrentPage = Math.max(1, Math.min(currentPage, totalPages));
const startIndex = (validCurrentPage - 1) * itemsPerPage;
const endIndex = Math.min(startIndex + itemsPerPage, totalItems);
const paginatedEvents = sortedEvents.slice(startIndex, endIndex);

// Redirect if page is invalid
if (currentPage < 2) {
  return Astro.redirect('/events');
}

// Create SEO metadata
const seo = {
  title: `Events - Page ${validCurrentPage} | Dzaleka Online Services`,
  description: `Browse upcoming and past events at Dzaleka Online Services. Page ${validCurrentPage} of ${totalPages}.`,
  type: "website",
  canonical: `https://services.dzaleka.com/events/${validCurrentPage > 1 ? validCurrentPage : ''}`,
  openGraph: {
    title: `Events - Page ${validCurrentPage} | Dzaleka Online Services`,
    description: `Browse upcoming and past events at Dzaleka Online Services. Page ${validCurrentPage} of ${totalPages}.`,
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/events/${validCurrentPage > 1 ? validCurrentPage : ''}`
  },
  twitter: {
    card: "summary",
    title: `Events - Page ${validCurrentPage} | Dzaleka Online Services`,
    description: `Browse upcoming and past events at Dzaleka Online Services. Page ${validCurrentPage} of ${totalPages}.`
  }
};

// Create structured data for events list
const eventsStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": paginatedEvents.map((event, index) => ({
    "@type": "ListItem",
    "position": startIndex + index + 1,
    "item": {
      "@type": "Event",
      "name": event.data.title,
      "description": event.data.description,
      "image": event.data.image.startsWith('http') ? event.data.image : `https://services.dzaleka.com${event.data.image}`,
      "startDate": event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date,
      "endDate": event.data.endDate ? (event.data.endDate instanceof Date ? event.data.endDate.toISOString() : event.data.endDate) : (event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date),
      "eventStatus": event.data.status === 'upcoming' ? "https://schema.org/EventScheduled" : "https://schema.org/EventCompleted",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "location": {
        "@type": "Place",
        "name": "Dzaleka Refugee Camp",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Dowa District",
          "addressLocality": "Dzaleka",
          "addressRegion": "Central Region",
          "postalCode": "",
          "addressCountry": "MW"
        }
      },
      "organizer": {
        "@type": "Organization",
        "name": event.data.organizer || "Dzaleka Online Services",
        "url": event.data.organizerUrl || "https://services.dzaleka.com"
      },
      "performer": {
        "@type": "Organization",
        "name": event.data.organizer || "Dzaleka Online Services"
      },
      "offers": {
        "@type": "Offer",
        "url": event.data.registration?.url || `https://services.dzaleka.com/events/${event.slug}`,
        "price": "0",
        "priceCurrency": "MWK",
        "availability": "https://schema.org/InStock"
      },
      "url": `https://services.dzaleka.com/events/${event.slug}`
    }
  }))
};

// Create pagination structured data
const paginationStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": `Events - Page ${validCurrentPage} | Dzaleka Online Services`,
  "description": `Browse upcoming and past events at Dzaleka Online Services. Page ${validCurrentPage} of ${totalPages}.`,
  "url": `https://services.dzaleka.com/events/${validCurrentPage > 1 ? validCurrentPage : ''}`,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://services.dzaleka.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Events",
        "item": "https://services.dzaleka.com/events"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": `Page ${validCurrentPage}`,
        "item": `https://services.dzaleka.com/events/${validCurrentPage > 1 ? validCurrentPage : ''}`
      }
    ]
  },
  "mainEntity": eventsStructuredData
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(paginationStructuredData)} />

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-primary-50 to-white border-b-2 border-primary-200 mb-12 overflow-hidden">
    <!-- Subtle African Pattern Background -->
    <div class="absolute inset-0 opacity-[0.03]">
      <div class="absolute inset-0 pattern-mudcloth"></div>
    </div>

    <div class="relative container mx-auto px-4 py-16">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-block mb-6">
          <span class="px-4 py-1.5 bg-primary-100 text-primary-700 rounded-full text-sm font-medium border border-primary-200">
            Community Events
          </span>
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">What's On in Dzaleka</h1>
        <p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
          Cultural festivals, performances, webinars, workshops, and community gatherings — discover the vibrant spirit of our community
        </p>

        <a
          href="/events/organize"
          class="inline-flex items-center px-6 py-3 border border-transparent rounded-lg text-base font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors shadow-md"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
          Submit Your Event
        </a>
      </div>
    </div>
  </section>

  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-900 mb-2">
        All Events
      </h2>
      <p class="text-gray-600">
        Showing {startIndex + 1}-{endIndex} of {totalItems} events
      </p>
    </div>

    {totalItems > 0 ? (
      <EventGrid events={paginatedEvents} />
    ) : (
      <div class="text-center py-8">
        <p class="text-gray-500">No events found.</p>
      </div>
    )}
    
    {totalPages > 1 && (
      <EventPagination 
        currentPage={validCurrentPage}
        totalPages={totalPages}
        baseUrl="/events/[page]"
      />
    )}
  </main>
</MainLayout>