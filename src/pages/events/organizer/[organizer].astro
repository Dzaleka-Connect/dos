---
import { getCollection } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';
import CollectionHeader from '../../../components/ui/CollectionHeader.astro';
import EventGrid from '../../../components/events/EventGrid.astro';
import { formatDateInCAT } from '../../../utils/eventDate';

export const prerender = false;

const { organizer: organizerSlug } = Astro.params;

if (!organizerSlug) {
  return Astro.redirect('/events');
}

const allEvents = await getCollection('events');

// Find the organizer name that matches the slug
const organizerName = [...new Set(allEvents.map(e => e.data.organizer).filter(Boolean))]
  .find(name => name.toLowerCase().replace(/\s+/g, '-') === organizerSlug);

if (!organizerName) {
  return Astro.redirect('/404');
}

const organizer = organizerName;
const events = allEvents.filter(event => event.data.organizer === organizer);

// Classify calendar days in Malawi, including events that span several days.
const today = formatDateInCAT(new Date(), 'yyyy-MM-dd');
const isUpcoming = (event: typeof events[number]) => event.data.isTBA || formatDateInCAT(event.data.endDate || event.data.date, 'yyyy-MM-dd') >= today;

// Filter and sort events
const upcomingEvents = events
  .filter(event => isUpcoming(event))
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

const pastEvents = events
  .filter(event => !isUpcoming(event))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Collect contact information from all events
const contactInfo = events
  .map(event => event.data.contact)
  .filter(Boolean)
  .reduce((acc, contact) => {
    if (contact?.email && !acc.email) acc.email = contact.email;
    if (contact?.phone && !acc.phone) acc.phone = contact.phone;
    if (contact?.whatsapp && !acc.whatsapp) acc.whatsapp = contact.whatsapp;
    return acc;
  }, {} as { email?: string; phone?: string; whatsapp?: string });

// Create SEO metadata
const seo = {
  title: `Events by ${organizer} - Dzaleka Online Services`,
  description: `Discover all events organized by ${organizer} in Dzaleka Refugee Camp. From upcoming events to past gatherings, explore the community impact.`,
  type: "website",
  canonical: `https://services.dzaleka.com/events/organizer/${organizer.toLowerCase().replace(/\s+/g, '-')}`,
  openGraph: {
    title: `Events by ${organizer}`,
    description: `Discover all events organized by ${organizer} in Dzaleka Refugee Camp.`,
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/events/organizer/${organizer.toLowerCase().replace(/\s+/g, '-')}`
  },
  twitter: {
    card: "summary_large_image",
    title: `Events by ${organizer}`,
    description: `Discover all events organized by ${organizer} in Dzaleka Refugee Camp.`
  }
};
---

<MainLayout title={seo.title} description={seo.description} canonical={seo.canonical} openGraph={seo.openGraph}>
  <CollectionHeader title={`Events by ${organizer}`} description={`Browse upcoming events and past gatherings organised by ${organizer}.`} breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Events', href: '/events' }, { label: organizer }]}>
    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-700"><span>{upcomingEvents.length} upcoming</span><span>{pastEvents.length} past events</span></div>
    {(contactInfo.email || contactInfo.phone || contactInfo.whatsapp) && <div class="mt-3 flex flex-wrap gap-x-6">{contactInfo.email && <a href={`mailto:${contactInfo.email}`} class="inline-flex min-h-[44px] items-center break-all text-sm text-primary-800 underline underline-offset-4">{contactInfo.email}</a>}{contactInfo.phone && <a href={`tel:${contactInfo.phone.replace(/[^+\d]/g, '')}`} class="inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">{contactInfo.phone}</a>}{contactInfo.whatsapp && <a href={`https://wa.me/${contactInfo.whatsapp.replace(/\D/g, '')}`} class="inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">WhatsApp</a>}</div>}
  </CollectionHeader>
  <div class="mx-auto max-w-7xl space-y-10 px-4 py-8 sm:px-6 lg:px-8">
    <section><h2 class="mb-6 text-primary-900">Upcoming events</h2>{upcomingEvents.length ? <EventGrid events={upcomingEvents} showStatus={false} /> : <p class="rounded border border-slate-200 bg-slate-50 p-6 text-base leading-7 text-slate-700">No upcoming events are currently listed for {organizer}. <a href="/events" class="text-primary-800 underline underline-offset-4">Browse all events</a>.</p>}</section>
    {pastEvents.length > 0 && <section class="border-t border-slate-200 pt-8"><h2 class="mb-6 text-primary-900">Past events</h2><EventGrid events={pastEvents} showStatus={false} /></section>}
  </div>
</MainLayout>
