---
import { getCollection } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';
import { format } from 'date-fns';
import Badge from '../../../components/ui/Badge.astro';

export const prerender = false;

const { organizer: organizerSlug } = Astro.params;

if (!organizerSlug) {
  return Astro.redirect('/events');
}

const allEvents = await getCollection('events');

// Find the organizer name that matches the slug
const organizerName = [...new Set(allEvents.map(e => e.data.organizer).filter(Boolean))]
  .find(name => name.toLowerCase().replace(/\s+/g, '-') === organizerSlug);

if (!organizerName) {
  return Astro.redirect('/404');
}

const organizer = organizerName;
const events = allEvents.filter(event => event.data.organizer === organizer);

// Function to format location
function formatLocation(location: any) {
  if (typeof location === 'string') return location;
  return location.venue && location.city ? `${location.venue}, ${location.city}` : location.venue || location.city || 'Location TBA';
}

// Function to format date in CAT timezone (UTC+2)
function formatDateInCAT(date: Date, formatString: string) {
  try {
    // Create a new date object and add 2 hours for CAT timezone
    const catDate = new Date(date.getTime() + (2 * 60 * 60 * 1000));
    return format(catDate, formatString);
  } catch (error) {
    // Fallback to original date if conversion fails
    return format(date, formatString);
  }
}

// Function to determine if an event is upcoming
function isUpcoming(date: Date) {
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const eventDate = new Date(date);
  eventDate.setHours(0, 0, 0, 0);
  return eventDate >= today;
}

// Filter and sort events
const upcomingEvents = events
  .filter(event => isUpcoming(event.data.date))
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

const pastEvents = events
  .filter(event => !isUpcoming(event.data.date))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Collect contact information from all events
const contactInfo = events
  .map(event => event.data.contact)
  .filter(Boolean)
  .reduce((acc, contact) => {
    if (contact?.email && !acc.email) acc.email = contact.email;
    if (contact?.phone && !acc.phone) acc.phone = contact.phone;
    if (contact?.whatsapp && !acc.whatsapp) acc.whatsapp = contact.whatsapp;
    return acc;
  }, {} as { email?: string; phone?: string; whatsapp?: string });

// Create SEO metadata
const seo = {
  title: `Events by ${organizer} - Dzaleka Online Services`,
  description: `Discover all events organized by ${organizer} in Dzaleka Refugee Camp. From upcoming events to past gatherings, explore the community impact.`,
  type: "website",
  canonical: `https://services.dzaleka.com/events/organizer/${organizer.toLowerCase().replace(/\s+/g, '-')}`,
  openGraph: {
    title: `Events by ${organizer}`,
    description: `Discover all events organized by ${organizer} in Dzaleka Refugee Camp.`,
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/events/organizer/${organizer.toLowerCase().replace(/\s+/g, '-')}`
  },
  twitter: {
    card: "summary_large_image",
    title: `Events by ${organizer}`,
    description: `Discover all events organized by ${organizer} in Dzaleka Refugee Camp.`
  }
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <main class="container mx-auto px-4 py-8">
    <!-- Back Button -->
    <div class="mb-6">
      <a 
        href="/events" 
        class="group inline-flex items-center text-gray-600 hover:text-primary-600 transition-all duration-200 font-medium"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Events
      </a>
    </div>

    <!-- Hero Section -->
    <div class="relative bg-gradient-to-br from-primary-600 via-primary-700 to-primary-800 rounded-2xl overflow-hidden mb-12">
      {/* Background Pattern */}
      <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'0.4\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2H6zM6 34v-4H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');">
        </div>
      </div>
      
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="relative px-6 py-12 md:py-20 text-center">
        <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
          Events by {organizer}
        </h1>
        <p class="text-lg md:text-xl text-white/90 max-w-3xl mx-auto leading-relaxed">
          Discover all events organized by {organizer} in Dzaleka Refugee Camp
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <div class="bg-white/20 rounded-lg px-6 py-2 text-white">
            <span class="font-medium">{upcomingEvents.length}</span> upcoming events
          </div>
          <div class="bg-white/20 rounded-lg px-6 py-2 text-white">
            <span class="font-medium">{pastEvents.length}</span> past events
          </div>
        </div>
        
        {/* Contact Icons */}
        {(contactInfo.email || contactInfo.phone || contactInfo.whatsapp) && (
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            {contactInfo.email && (
              <a 
                href={`mailto:${contactInfo.email}`}
                class="group bg-white/20 rounded-lg p-3 text-white hover:bg-white/30 transition-colors duration-200"
                title="Send Email"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </a>
            )}
            {contactInfo.phone && (
              <a 
                href={`tel:${contactInfo.phone}`}
                class="group bg-white/20 rounded-lg p-3 text-white hover:bg-white/30 transition-colors duration-200"
                title="Call Phone"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </a>
            )}
            {contactInfo.whatsapp && (
              <a 
                href={`https://wa.me/${contactInfo.whatsapp}`}
                target="_blank"
                rel="noopener noreferrer"
                class="group bg-white/20 rounded-lg p-3 text-white hover:bg-white/30 transition-colors duration-200"
                title="Send WhatsApp Message"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2ZM12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.04 20.16C10.56 20.16 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67ZM8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7 8.5 7 9.71C7 10.93 7.89 12.1 8 12.27C8.14 12.44 9.76 14.94 12.25 16C12.84 16.27 13.3 16.42 13.66 16.53C14.25 16.72 14.79 16.69 15.22 16.63C15.7 16.56 16.68 16.03 16.89 15.45C17.1 14.87 17.1 14.38 17.04 14.27C16.97 14.17 16.81 14.11 16.56 14C16.31 13.86 15.09 13.26 14.87 13.18C14.64 13.1 14.5 13.06 14.31 13.3C14.15 13.55 13.67 14.11 13.53 14.27C13.38 14.44 13.24 14.46 13 14.34C12.74 14.21 11.94 13.95 11 13.11C10.26 12.45 9.77 11.64 9.62 11.39C9.5 11.15 9.61 11 9.73 10.89C9.84 10.78 10 10.6 10.1 10.45C10.23 10.31 10.27 10.2 10.35 10.04C10.43 9.87 10.39 9.73 10.33 9.61C10.27 9.5 9.77 8.26 9.56 7.77C9.36 7.29 9.16 7.35 9 7.34C8.86 7.34 8.7 7.33 8.53 7.33Z"/>
                </svg>
              </a>
            )}
          </div>
        )}
      </div>
      
    </div>



    <!-- Upcoming Events -->
    {upcomingEvents.length > 0 && (
      <section class="mb-16">
        <div class="mb-8">
          <h2 class="text-3xl font-bold text-gray-900 mb-2">Upcoming Events</h2>
          <p class="text-gray-600">Events happening soon by {organizer}</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {upcomingEvents.map(event => (
            <a 
              href={`/events/${event.id}`}
              class="group block transition-colors duration-200"
            >
              <article class="bg-white rounded-xl shadow-sm transition-colors duration-200 overflow-hidden flex flex-col h-full border border-gray-200 hover:border-gray-300 relative">
                <div class="aspect-w-16 aspect-h-9 relative overflow-hidden">
                  <img 
                    src={event.data.image} 
                    alt={event.data.title}
                    class="w-full h-full object-cover"
                  />
                  {/* Category badge */}
                  <div class="absolute bottom-3 right-3 z-10">
                    <span class="px-3 py-1 rounded-full text-xs font-medium shadow-sm bg-white border border-gray-200 text-blue-700">
                      {event.data.category}
                    </span>
                  </div>
                </div>
                
                <div class="p-6 relative">
                  <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                      <time datetime={event.data.date.toISOString()} class="text-sm block flex items-center text-gray-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        {formatDateInCAT(event.data.date, 'MMM d, yyyy')}
                      </time>
                      {/* Status indicator */}
                      <span class="px-2 py-1 rounded-full text-xs font-medium capitalize bg-blue-100 text-blue-800 border border-blue-200">
                        upcoming
                      </span>
                    </div>
                  </div>
                  <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-primary-600 transition-colors line-clamp-2">{event.data.title}</h3>
                  <p class="text-gray-600 text-sm mb-4 line-clamp-2 leading-relaxed">{event.data.description}</p>
                  
                  <div class="flex justify-end">
                    <span class="text-sm font-medium text-primary-600 group-hover:text-primary-700 transition-colors flex items-center">
                      Learn More 
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Past Events -->
    {pastEvents.length > 0 && (
      <section>
        <div class="mb-8">
          <h2 class="text-3xl font-bold text-gray-900 mb-2">Past Events</h2>
          <p class="text-gray-600">Previous events organized by {organizer}</p>
        </div>
        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {pastEvents.map(event => (
            <a 
              href={`/events/${event.id}`}
              class="group block transition-colors duration-200"
            >
              <article class="bg-white rounded-xl shadow-sm transition-colors duration-200 overflow-hidden flex flex-col h-full border border-gray-200 hover:border-gray-300 relative">
                <div class="aspect-w-16 aspect-h-9 relative overflow-hidden">
                  <img 
                    src={event.data.image} 
                    alt={event.data.title}
                    class="w-full h-full object-cover"
                  />
                  {/* Category badge */}
                  <div class="absolute bottom-3 right-3 z-10">
                    <span class="px-3 py-1 rounded-full text-xs font-medium shadow-sm bg-white border border-gray-200 text-green-700">
                      {event.data.category}
                    </span>
                  </div>
                </div>
                
                <div class="p-6 relative">
                  <div class="flex items-center justify-between mb-3">
                    <div class="flex items-center gap-3">
                      <time datetime={event.data.date.toISOString()} class="text-sm block flex items-center text-gray-500">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                        {formatDateInCAT(event.data.date, 'MMM d, yyyy')}
                      </time>
                      {/* Status indicator */}
                      <span class="px-2 py-1 rounded-full text-xs font-medium capitalize bg-gray-100 text-gray-800 border border-gray-200">
                        past
                      </span>
                    </div>
                  </div>
                  <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-primary-600 transition-colors line-clamp-2">{event.data.title}</h3>
                  <p class="text-gray-600 text-sm mb-4 line-clamp-2 leading-relaxed">{event.data.description}</p>
                  
                  <div class="flex justify-end">
                    <span class="text-sm font-medium text-primary-600 group-hover:text-primary-700 transition-colors flex items-center">
                      Learn More 
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- No Events Message -->
    {events.length === 0 && (
      <div class="text-center py-16">
        <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-3">No Events Found</h3>
        <p class="text-gray-600 mb-6">No events have been organized by {organizer} yet.</p>
        <a 
          href="/events" 
          class="inline-flex items-center px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors"
        >
          Browse All Events
        </a>
      </div>
    )}
  </main>
</MainLayout>
