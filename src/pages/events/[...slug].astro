                      WhatsApp
                    </a>
                  </div>
                )}
              </div>
            </div>
          )}

          <!-- Description -->
          <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            {entry.data.description}
          </p>

          <!-- Panelists Section -->
          {entry.data.panelists && entry.data.panelists.length > 0 && (
            <div class="mb-12">
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Meet Our Panelists</h2>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {entry.data.panelists.map((panelist, index) => (
                  <div 
                    class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow cursor-pointer panelist-card"
                    data-panelist-index={index}
