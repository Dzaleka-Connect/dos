---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { format } from 'date-fns';
import Badge from '../../components/ui/Badge.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

import EventGrid from '../../components/events/EventGrid.astro';
import EventPagination from '../../components/events/EventPagination.astro';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

// Check if the slug is a page number
const pageNum = parseInt(slug);
const isPage = !isNaN(pageNum) && pageNum > 0;

// Shared data
const allEvents = await getCollection('events');
let entry = null;
let Content = null;
let paginatedEvents = [];
let totalPages = 0;
let validCurrentPage = 1;
let startIndex = 0;
let endIndex = 0;
let totalItems = 0;

if (isPage) {
  // --- PAGINATION LOGIC ---
  const currentPage = pageNum;
  
  // Recalculate status dynamically
  const today = new Date();
  today.setHours(0, 0, 0, 0);

  const eventsWithStatus = allEvents.map(event => {
    const eventDate = new Date(event.data.date);
    eventDate.setHours(0, 0, 0, 0);
    const isUpcoming = eventDate >= today || (event.data.isTBA || event.data.title.toLowerCase().includes('tba'));
    
    return {
      ...event,
      data: {
        ...event.data,
        status: isUpcoming ? 'upcoming' : 'past'
      }
    };
  });

  // Sort events by status and date
  const sortedEvents = eventsWithStatus.sort((a, b) => {
    if (a.data.status !== b.data.status) {
      return a.data.status === 'upcoming' ? -1 : 1;
    }
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  });

  // Pagination
  const itemsPerPage = 6;
  totalItems = sortedEvents.length;
  totalPages = Math.max(1, Math.ceil(totalItems / itemsPerPage));

  // Redirect if page is invalid
  if (currentPage > totalPages && totalPages > 0) {
    return Astro.redirect('/events');
  }

  validCurrentPage = currentPage;
  startIndex = (validCurrentPage - 1) * itemsPerPage;
  endIndex = Math.min(startIndex + itemsPerPage, totalItems);
  paginatedEvents = sortedEvents.slice(startIndex, endIndex);

} else {
  // --- EVENT DETAILS LOGIC ---
  entry = allEvents.find(e => e.id === slug);

  if (!entry) {
    return Astro.redirect('/404');
  }

  const renderResult = await render(entry);
  Content = renderResult.Content;

  // Calculate status dynamically
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const eventDate = new Date(entry.data.date);
  eventDate.setHours(0, 0, 0, 0);
  const isUpcoming = eventDate >= today || (entry.data.isTBA || entry.data.title.toLowerCase().includes('tba'));

  // Override status for display logic
  entry.data.status = isUpcoming ? 'upcoming' : 'past';
}

// Get related events (only for event details)
const relatedEvents = !isPage && entry ? allEvents
  .filter(event => 
    event.id !== entry.id && 
    (event.data.organizer === entry.data.organizer || 
     event.data.category === entry.data.category)
  )
  .slice(0, 3) : [];

// Function to format location
function formatLocation(location: any) {
  if (typeof location === 'string') return location;
  return location.venue && location.city ? `${location.venue}, ${location.city}` : location.venue || location.city || 'Location TBA';
}

// Function to format date in CAT timezone (UTC+2)
function formatDateInCAT(date: Date, formatString: string) {
  try {
    // Create a new date object and add 2 hours for CAT timezone
    const catDate = new Date(date.getTime() + (2 * 60 * 60 * 1000));
    return format(catDate, formatString);
  } catch (error) {
    // Fallback to original date if conversion fails
    return format(date, formatString);
  }
}

// Format date for structured data
// Format date for structured data (only if entry exists)
const formattedDate = entry ? format(entry.data.date, 'yyyy-MM-dd') : '';
const formattedTime = entry ? format(entry.data.date, 'HH:mm') : '';

// Create structured data
let structuredData = {};

if (isPage) {
  const eventsStructuredData = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": paginatedEvents.map((event, index) => ({
      "@type": "ListItem",
      "position": startIndex + index + 1,
      "item": {
        "@type": "Event",
        "name": event.data.title,
        "description": event.data.description,
        "image": event.data.image.startsWith('http') ? event.data.image : `https://services.dzaleka.com${event.data.image}`,
        "startDate": event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date,
        "endDate": event.data.endDate ? (event.data.endDate instanceof Date ? event.data.endDate.toISOString() : event.data.endDate) : (event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date),
        "eventStatus": event.data.status === 'upcoming' ? "https://schema.org/EventScheduled" : "https://schema.org/EventCompleted",
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "location": {
          "@type": "Place",
          "name": "Dzaleka Refugee Camp",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Dowa District",
            "addressLocality": "Dzaleka",
            "addressRegion": "Central Region",
            "postalCode": "",
            "addressCountry": "MW"
          }
        },
        "organizer": {
          "@type": "Organization",
          "name": event.data.organizer || "Dzaleka Online Services",
          "url": event.data.organizerUrl || "https://services.dzaleka.com"
        },
        "offers": {
          "@type": "Offer",
          "url": event.data.registration?.url || `https://services.dzaleka.com/events/${event.id}`,
          "price": "0",
          "priceCurrency": "MWK",
          "availability": "https://schema.org/InStock"
        },
        "url": `https://services.dzaleka.com/events/${event.id}`
      }
    }))
  };

  structuredData = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": `Events - Page ${validCurrentPage} | Dzaleka Online Services`,
    "description": `Browse upcoming and past events at Dzaleka Online Services. Page ${validCurrentPage} of ${totalPages}.`,
    "url": `https://services.dzaleka.com/events/${validCurrentPage > 1 ? validCurrentPage : ''}`,
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://services.dzaleka.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Events",
          "item": "https://services.dzaleka.com/events"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `Page ${validCurrentPage}`,
          "item": `https://services.dzaleka.com/events/${validCurrentPage > 1 ? validCurrentPage : ''}`
        }
      ]
    },
    "mainEntity": eventsStructuredData
  };
} else {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "Event",
    "name": entry.data.title,
    "description": entry.data.description,
    "image": entry.data.image.startsWith('http') ? entry.data.image : `https://services.dzaleka.com${entry.data.image}`,
    "startDate": entry.data.date instanceof Date ? entry.data.date.toISOString() : entry.data.date,
    "endDate": entry.data.endDate ? (entry.data.endDate instanceof Date ? entry.data.endDate.toISOString() : entry.data.endDate) : (entry.data.date instanceof Date ? entry.data.date.toISOString() : entry.data.date),
    "eventStatus": entry.data.status === 'upcoming' ? "https://schema.org/EventScheduled" : "https://schema.org/EventCompleted",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "location": {
      "@type": "Place",
      "name": formatLocation(entry.data.location),
      "address": {
        "@type": "PostalAddress",
        "addressLocality": typeof entry.data.location === 'string' ? entry.data.location : entry.data.location.city || 'Dzaleka',
        "addressRegion": "Dowa",
        "addressCountry": "Malawi"
      }
    },
    "organizer": {
      "@type": "Organization",
      "name": entry.data.organizer || "Dzaleka Online Services",
      "url": entry.data.organizerUrl || "https://services.dzaleka.com"
    },
    "performer": {
      "@type": "Organization",
      "name": entry.data.organizer || "Dzaleka Online Services"
    },
    "offers": {
      "@type": "Offer",
      "url": entry.data.registration?.url || `https://services.dzaleka.com/events/${entry.id}`,
      "price": "0",
      "priceCurrency": "MWK",
      "availability": "https://schema.org/InStock"
    }
  };
}

// Create SEO metadata
const seo = isPage ? {
  title: `Events - Page ${validCurrentPage} | Dzaleka Online Services`,
  description: `Browse upcoming and past events at Dzaleka Online Services. Page ${validCurrentPage} of ${totalPages}.`,
  type: "website",
  canonical: `https://services.dzaleka.com/events/${validCurrentPage > 1 ? validCurrentPage : ''}`,
  openGraph: {
    title: `Events - Page ${validCurrentPage} | Dzaleka Online Services`,
    description: `Browse upcoming and past events at Dzaleka Online Services. Page ${validCurrentPage} of ${totalPages}.`,
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/events/${validCurrentPage > 1 ? validCurrentPage : ''}`
  },
  twitter: {
    card: "summary",
    title: `Events - Page ${validCurrentPage} | Dzaleka Online Services`,
    description: `Browse upcoming and past events at Dzaleka Online Services. Page ${validCurrentPage} of ${totalPages}.`
  }
} : {
  title: `${entry.data.title}`,
  description: entry.data.description,
  type: "event",
  canonical: `https://services.dzaleka.com/events/${entry.id}`,
  openGraph: {
    title: `${entry.data.title}`,
    description: entry.data.description,
    type: "event",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/events/${entry.id}`,
    image: {
      url: entry.data.image.startsWith('http') ? entry.data.image : `https://services.dzaleka.com${entry.data.image}`,
      width: 1200,
      height: 630,
      alt: entry.data.title,
      type: "image/jpeg"
    },
    event: {
      startTime: `${formattedDate}T${formattedTime}`,
      endTime: `${formattedDate}T${formattedTime}`,
      location: formatLocation(entry.data.location),
      organizer: entry.data.organizer || "Dzaleka Online Services"
    }
  },
  twitter: {
    card: "summary_large_image",
    title: `${entry.data.title}`,
    description: entry.data.description,
    image: entry.data.image.startsWith('http') ? entry.data.image : `https://services.dzaleka.com${entry.data.image}`,
    creator: entry.data.organizer ? `@${entry.data.organizer.replace(/\s+/g, '')}` : "@DzalekaConnect"
  }
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  image={seo.image} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  {isPage ? (
    <>
      <main class="min-h-screen">
        <!-- Hero Section -->
        <div class="relative border-b border-gray-200 overflow-hidden bg-gray-900 mb-12">
          <div class="absolute inset-0 z-0">
            <img src="/images/dzaleka-hero.jpeg" alt="Dzaleka Events Hub" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gray-900/60"></div>
          </div>

          <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
            <div class="max-w-3xl mx-auto text-center">
              <div class="mb-6 flex justify-center">
                <Breadcrumb items={[
                  { label: 'Home', href: '/' },
                  { label: 'Events', href: '/events' },
                  { label: `Page ${validCurrentPage}` }
                ]} light={true} />
              </div>

              <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 tracking-tight leading-tight">
                What's On in Dzaleka
              </h1>
              <p class="text-xl text-gray-200 mb-10 max-w-2xl mx-auto leading-relaxed">
                Cultural festivals, performances, webinars, workshops, and community gatherings — discover the vibrant spirit of our community
              </p>

              <div class="mt-8 flex justify-center gap-4">
                <a
                  href="/events/organize"
                  class="inline-flex items-center px-6 py-3 border border-transparent text-sm font-medium rounded-lg text-gray-900 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-200 transition-colors shadow-sm"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 01-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                  </svg>
                  Submit Your Event
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="container mx-auto px-4 py-12">
          <!-- All Events -->
          <section class="mb-20">
            <div class="mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-center">All Events</h2>
              <p class="text-lg text-gray-600 text-center">Showing page {validCurrentPage} of {totalPages} ({totalItems} total events)</p>
            </div>

            <EventGrid events={paginatedEvents} />
            
            <div class="mt-12">
              <EventPagination 
                currentPage={validCurrentPage}
                totalPages={totalPages}
                baseUrl="/events"
              />
            </div>
          </section>
        </div>
      </main>
    </>
  ) : (
    <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      {/* Breadcrumb Navigation */}
      <div class="mb-6">
        <div class="flex items-center text-sm overflow-x-auto whitespace-nowrap">
          <a href="/" class="text-gray-500 hover:text-primary-600 transition-colors">Home</a>
          <svg class="w-4 h-4 mx-2 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <a href="/events" class="text-gray-500 hover:text-primary-600 transition-colors">Events</a>
          <svg class="w-4 h-4 mx-2 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-gray-900 font-medium truncate">{entry.data.title}</span>
        </div>
      </div>

      <div class="bg-white rounded-xl shadow-sm overflow-hidden">
        <!-- Hero Image -->
        <div class="relative">
          <img
            src={entry.data.image}
            alt={entry.data.title}
            class="w-full h-[60vh] object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
            <div class="absolute bottom-0 p-8">
              <Badge variant="blue" size="md" class="animate-fade-in">{entry.data.category}</Badge>
              <h1 class="text-4xl md:text-5xl font-bold text-white mt-4 drop-shadow-lg">
                {entry.data.title}
              </h1>
            </div>
          </div>
        </div>

        <!-- Content -->
        <div class="p-8">
          <!-- Event Info -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8 pb-8 border-b">
            <div class="flex items-center gap-3 text-gray-600 hover:text-primary-600 transition-colors group">
              <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center group-hover:bg-primary-200 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide">Date</p>
                <time datetime={entry.data.date.toISOString()} class="text-sm font-medium">
                  {formatDateInCAT(entry.data.date, 'MMMM d')} - {formatDateInCAT(entry.data.endDate, 'MMMM d, yyyy')}
                </time>
              </div>
            </div>
            <div class="flex items-center gap-3 text-gray-600 hover:text-primary-600 transition-colors group">
              <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center group-hover:bg-primary-200 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide">Time</p>
                <time datetime={entry.data.date.toISOString()} class="text-sm font-medium">
                  {formatDateInCAT(entry.data.date, 'h:mm a')} - {formatDateInCAT(entry.data.endDate, 'h:mm a')}
                </time>
              </div>
            </div>
            <div class="flex items-center gap-3 text-gray-600 hover:text-primary-600 transition-colors group">
              <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center group-hover:bg-primary-200 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide">Location</p>
                <span class="text-sm font-medium">{formatLocation(entry.data.location)}</span>
              </div>
            </div>
            {entry.data.organizer && (
              <a 
                href={`/events/organizer/${entry.data.organizer.toLowerCase().replace(/\s+/g, '-')}`}
                class="flex items-center gap-3 text-gray-600 hover:text-primary-600 transition-colors group"
              >
                <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center group-hover:bg-primary-200 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-gray-500 uppercase tracking-wide">Organizer</p>
                  <span class="text-sm font-medium group-hover:text-primary-600 transition-colors">{entry.data.organizer}</span>
                </div>
              </a>
            )}
          </div>

          <!-- Contact Information -->
          {entry.data.contact && (
            <div class="bg-gray-50 rounded-lg p-6 mb-8 hover:bg-gray-100 transition-colors">
              <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-600" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                </svg>
                Contact Information
              </h2>
              <div class="space-y-3">
                {entry.data.contact.email && (
                  <div class="flex items-center gap-2 group">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500 group-hover:text-primary-600 transition-colors" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                      <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                    </svg>
                    <a href={`mailto:${entry.data.contact.email}`} class="text-primary-600 hover:text-primary-700 transition-colors">
                      {entry.data.contact.email}
                    </a>
                  </div>
                )}
                {entry.data.contact.phone && (
                  <div class="flex items-center gap-2 group">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500 group-hover:text-primary-600 transition-colors" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                    </svg>
                    <a href={`tel:${entry.data.contact.phone}`} class="text-primary-600 hover:text-primary-700 transition-colors">
                      {entry.data.contact.phone}
                    </a>
                  </div>
                )}
                {entry.data.contact.whatsapp && (
                  <div class="flex items-center gap-2 group">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500 group-hover:text-primary-600 transition-colors" viewBox="0 0 24 24" fill="currentColor">
