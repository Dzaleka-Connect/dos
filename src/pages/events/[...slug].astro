---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { format } from 'date-fns';
import Button from '../../components/ui/Button.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

import EventGrid from '../../components/events/EventGrid.astro';
import EventPagination from '../../components/events/EventPagination.astro';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/404');
}

// Check if the slug is a page number
const pageNum = parseInt(slug);
const isPage = !isNaN(pageNum) && pageNum > 0;

// Shared data
const allEvents = await getCollection('events');
let entry = null;
let Content = null;
let paginatedEvents = [];
let totalPages = 0;
let validCurrentPage = 1;
let startIndex = 0;
let endIndex = 0;
let totalItems = 0;

if (isPage) {
  // --- PAGINATION LOGIC ---
  const currentPage = pageNum;

  // Recalculate status dynamically
  const today = new Date();
  today.setHours(0, 0, 0, 0);

  const eventsWithStatus = allEvents.map(event => {
    const eventDate = new Date(event.data.date);
    eventDate.setHours(0, 0, 0, 0);
    const isUpcoming = eventDate >= today || (event.data.isTBA || event.data.title.toLowerCase().includes('tba'));

    return {
      ...event,
      data: {
        ...event.data,
        status: isUpcoming ? 'upcoming' : 'past'
      }
    };
  });

  // Sort events by status and date
  const sortedEvents = eventsWithStatus.sort((a, b) => {
    if (a.data.status !== b.data.status) {
      return a.data.status === 'upcoming' ? -1 : 1;
    }
    return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
  });

  // Pagination
  const itemsPerPage = 6;
  totalItems = sortedEvents.length;
  totalPages = Math.max(1, Math.ceil(totalItems / itemsPerPage));

  // Redirect if page is invalid
  if (currentPage > totalPages && totalPages > 0) {
    return Astro.redirect('/events');
  }

  validCurrentPage = currentPage;
  startIndex = (validCurrentPage - 1) * itemsPerPage;
  endIndex = Math.min(startIndex + itemsPerPage, totalItems);
  paginatedEvents = sortedEvents.slice(startIndex, endIndex);

} else {
  // --- EVENT DETAILS LOGIC ---
  entry = allEvents.find(e => e.id === slug);

  if (!entry) {
    return Astro.redirect('/404');
  }

  const renderResult = await render(entry);
  Content = renderResult.Content;

  // Calculate status dynamically
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const eventDate = new Date(entry.data.date);
  eventDate.setHours(0, 0, 0, 0);
  const isUpcoming = eventDate >= today || (entry.data.isTBA || entry.data.title.toLowerCase().includes('tba'));

  // Override status for display logic
  entry.data.status = isUpcoming ? 'upcoming' : 'past';
}

// Get related events (only for event details)
const relatedEvents = !isPage && entry ? allEvents
  .filter(event =>
    event.id !== entry.id &&
    (event.data.organizer === entry.data.organizer ||
     event.data.category === entry.data.category)
  )
  .slice(0, 3) : [];

// Function to format location
function formatLocation(location: any) {
  if (typeof location === 'string') return location;
  return location.venue && location.city ? `${location.venue}, ${location.city}` : location.venue || location.city || 'Location TBA';
}

// Function to format date in CAT timezone (UTC+2)
function formatDateInCAT(date: Date, formatString: string) {
  try {
    // Create a new date object and add 2 hours for CAT timezone
    const catDate = new Date(date.getTime() + (2 * 60 * 60 * 1000));
    return format(catDate, formatString);
  } catch (error) {
    // Fallback to original date if conversion fails
    return format(date, formatString);
  }
}

// Format date for structured data
// Format date for structured data (only if entry exists)
const formattedDate = entry ? format(entry.data.date, 'yyyy-MM-dd') : '';
const formattedTime = entry ? format(entry.data.date, 'HH:mm') : '';
const todayIso = new Date().toISOString().split('T')[0];

// Create structured data
let structuredData = {};

if (isPage) {
  const eventsStructuredData = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": paginatedEvents.map((event, index) => ({
      "@type": "ListItem",
      "position": startIndex + index + 1,
      "item": {
        "@type": "Event",
        "name": event.data.title,
        "description": event.data.description,
        "image": event.data.image.startsWith('http') ? event.data.image : `https://services.dzaleka.com${event.data.image}`,
        "startDate": event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date,
        "endDate": event.data.endDate ? (event.data.endDate instanceof Date ? event.data.endDate.toISOString() : event.data.endDate) : (event.data.date instanceof Date ? event.data.date.toISOString() : event.data.date),
        "eventStatus": event.data.status === 'upcoming' ? "https://schema.org/EventScheduled" : "https://schema.org/EventCompleted",
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "location": {
          "@type": "Place",
          "name": "Dzaleka Refugee Camp",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Dzaleka Refugee Camp",
            "addressLocality": "Dzaleka",
            "addressRegion": "Central Region",
            "postalCode": "DZ001",
            "addressCountry": "MW"
          }
        },
        "organizer": {
          "@type": "Organization",
          "name": event.data.organizer || "Dzaleka Online Services",
          "url": event.data.organizerUrl || "https://services.dzaleka.com"
        },
        "performer": {
          "@type": "PerformingGroup",
          "name": event.data.organizer || "Dzaleka Online Services"
        },
        "offers": {
          "@type": "Offer",
          "url": event.data.registration?.url || `https://services.dzaleka.com/events/${event.id}`,
          "price": "0",
          "priceCurrency": "MWK",
          ...(event.data.status === 'upcoming' && { "validFrom": todayIso }),
          "availability": "https://schema.org/InStock"
        },
        "url": `https://services.dzaleka.com/events/${event.id}`
      }
    }))
  };

  structuredData = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": `Events - Page ${validCurrentPage} | Dzaleka Online Services`,
    "description": `Browse upcoming and past events at Dzaleka Online Services. Page ${validCurrentPage} of ${totalPages}.`,
    "url": `https://services.dzaleka.com/events/${validCurrentPage > 1 ? validCurrentPage : ''}`,
    "breadcrumb": {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://services.dzaleka.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Events",
          "item": "https://services.dzaleka.com/events"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `Page ${validCurrentPage}`,
          "item": `https://services.dzaleka.com/events/${validCurrentPage > 1 ? validCurrentPage : ''}`
        }
      ]
    },
    "mainEntity": eventsStructuredData
  };
} else {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "Event",
    "name": entry.data.title,
    "description": entry.data.description,
    "image": entry.data.image.startsWith('http') ? entry.data.image : `https://services.dzaleka.com${entry.data.image}`,
    "startDate": entry.data.date instanceof Date ? entry.data.date.toISOString() : entry.data.date,
    "endDate": entry.data.endDate ? (entry.data.endDate instanceof Date ? entry.data.endDate.toISOString() : entry.data.endDate) : (entry.data.date instanceof Date ? entry.data.date.toISOString() : entry.data.date),
    "eventStatus": entry.data.status === 'upcoming' ? "https://schema.org/EventScheduled" : "https://schema.org/EventCompleted",
    "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
    "location": {
      "@type": "Place",
      "name": formatLocation(entry.data.location),
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Dzaleka Refugee Camp",
        "addressLocality": typeof entry.data.location === 'string' ? entry.data.location : entry.data.location.city || 'Dzaleka',
        "addressRegion": "Dowa",
        "postalCode": "DZ001",
        "addressCountry": "Malawi"
      }
    },
    "organizer": {
      "@type": "Organization",
      "name": entry.data.organizer || "Dzaleka Online Services",
      "url": entry.data.organizerUrl || "https://services.dzaleka.com"
    },
    "performer": {
      "@type": "PerformingGroup",
      "name": entry.data.organizer || "Dzaleka Online Services"
    },
    "offers": {
      "@type": "Offer",
      "url": entry.data.registration?.url || `https://services.dzaleka.com/events/${entry.id}`,
      "price": "0",
      "priceCurrency": "MWK",
      ...(entry.data.status === 'upcoming' && { "validFrom": todayIso }),
      "availability": "https://schema.org/InStock"
    }
  };
}

// Create SEO metadata
const seo = isPage ? {
  title: `Events - Page ${validCurrentPage} | Dzaleka Online Services`,
  description: `Browse upcoming and past events at Dzaleka Online Services. Page ${validCurrentPage} of ${totalPages}.`,
  type: "website",
  canonical: `https://services.dzaleka.com/events/${validCurrentPage > 1 ? validCurrentPage : ''}`,
  openGraph: {
    title: `Events - Page ${validCurrentPage} | Dzaleka Online Services`,
    description: `Browse upcoming and past events at Dzaleka Online Services. Page ${validCurrentPage} of ${totalPages}.`,
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/events/${validCurrentPage > 1 ? validCurrentPage : ''}`
  },
  twitter: {
    card: "summary",
    title: `Events - Page ${validCurrentPage} | Dzaleka Online Services`,
    description: `Browse upcoming and past events at Dzaleka Online Services. Page ${validCurrentPage} of ${totalPages}.`
  }
} : {
  title: `${entry.data.title}`,
  description: entry.data.description,
  type: "event",
  canonical: `https://services.dzaleka.com/events/${entry.id}`,
  openGraph: {
    title: `${entry.data.title}`,
    description: entry.data.description,
    type: "event",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/events/${entry.id}`,
    image: {
      url: entry.data.image.startsWith('http') ? entry.data.image : `https://services.dzaleka.com${entry.data.image}`,
      width: 1200,
      height: 630,
      alt: entry.data.title,
      type: "image/jpeg"
    },
    event: {
      startTime: `${formattedDate}T${formattedTime}`,
      endTime: `${formattedDate}T${formattedTime}`,
      location: formatLocation(entry.data.location),
      organizer: entry.data.organizer || "Dzaleka Online Services"
    }
  },
  twitter: {
    card: "summary_large_image",
    title: `${entry.data.title}`,
    description: entry.data.description,
    image: entry.data.image.startsWith('http') ? entry.data.image : `https://services.dzaleka.com${entry.data.image}`,
    creator: entry.data.organizer ? `@${entry.data.organizer.replace(/\s+/g, '')}` : "@DzalekaConnect"
  }
};
---

<MainLayout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  type={seo.type}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  {isPage ? (
    <>
      <section class="border-b border-slate-200 bg-slate-50">
        <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
          <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Events', href: '/events' }, { label: `Page ${validCurrentPage}` }]} />
          <h1 class="mt-6 text-slate-900">Events in Dzaleka</h1>
          <p class="mt-4 max-w-2xl text-base text-slate-600">Cultural festivals, performances, workshops, and community gatherings.</p>
          <div class="mt-6"><Button href="/events/organize" variant="secondary">Submit an event</Button></div>
        </div>
      </section>
      <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        <h2 class="text-slate-900">All events</h2>
        <p class="mb-6 mt-2 text-slate-600">Showing {startIndex + 1}–{endIndex} of {totalItems} events</p>
        <EventGrid events={paginatedEvents} />
        <EventPagination currentPage={validCurrentPage} totalPages={totalPages} baseUrl="/events/[page]" />
      </section>
    </>
  ) : (
    <>
      <section class="border-b border-slate-200 bg-slate-50">
        <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
          <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Events', href: '/events' }, { label: entry.data.title }]} />
          <p class="mt-6 text-sm font-medium text-primary-800">{entry.data.category}</p>
          <h1 class="mt-2 max-w-4xl text-slate-900">{entry.data.title}</h1>
          <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">{entry.data.description}</p>
        </div>
      </section>
      <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
        <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-12">
          <article class="order-2 min-w-0 lg:order-1">
            {entry.data.image && <img onerror="this.onerror=null; this.src='/images/unavailable-image.svg'; this.alt='Image unavailable';" src={entry.data.image} alt={entry.data.title} class="mb-8 aspect-video w-full rounded object-cover" />}
            <div class="prose max-w-none prose-headings:text-slate-900 prose-a:text-primary-800"><Content /></div>
            {entry.data.panelists?.length > 0 && (
              <section class="mt-10 border-t border-slate-200 pt-8" aria-labelledby="panelists-heading">
                <h2 id="panelists-heading">Speakers and panelists</h2>
                <div class="mt-6 divide-y divide-slate-200">
                  {entry.data.panelists.map(panelist => (
                    <div class="py-5 first:pt-0">
                      <div class="flex items-start gap-4">
                        {panelist.image && <img onerror="this.onerror=null; this.src='/images/unavailable-image.svg'; this.alt='Image unavailable';" src={panelist.image.startsWith('http') ? panelist.image : `/images/${panelist.image}`} alt="" class="h-16 w-16 shrink-0 rounded-full object-cover" loading="lazy" />}
                        <div class="min-w-0">
                          <h3 class="text-lg text-slate-900">{panelist.name}</h3>
                          {panelist.role && <p class="mt-1 text-slate-700">{panelist.role}</p>}
                          {panelist.organization && <p class="mt-1 text-slate-600">{panelist.organization}</p>}
                          {panelist.bio && <details class="mt-3"><summary class="min-h-[44px] cursor-pointer py-2 font-medium text-primary-800 underline underline-offset-4">About {panelist.name}</summary><p class="mt-2 whitespace-pre-line leading-7 text-slate-700">{panelist.bio}</p></details>}
                          {panelist.socialMedia && <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1">{Object.entries(panelist.socialMedia).filter(([, url]) => url).map(([label, url]) => <a href={String(url)} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">{label === 'linkedin' ? 'LinkedIn' : label.charAt(0).toUpperCase() + label.slice(1)}</a>)}</div>}
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            )}
          </article>
          <aside class="order-1 min-w-0 space-y-8 lg:order-2 lg:sticky lg:top-44" aria-label="Event information">
            <section class="border-t-4 border-primary-800 bg-slate-50 p-5 sm:p-6">
              <h2>Event details</h2>
              <dl class="mt-5 space-y-4">
                <div><dt class="font-semibold text-slate-900">Date</dt><dd class="mt-1 text-slate-700">{entry.data.isTBA ? 'To be announced' : <time datetime={entry.data.date.toISOString()}>{formatDateInCAT(entry.data.date, 'MMMM d, yyyy')}{entry.data.endDate && formatDateInCAT(entry.data.date, 'yyyy-MM-dd') !== formatDateInCAT(entry.data.endDate, 'yyyy-MM-dd') && ` – ${formatDateInCAT(entry.data.endDate, 'MMMM d, yyyy')}`}</time>}</dd></div>
                {!entry.data.isTBA && <div><dt class="font-semibold text-slate-900">Time (CAT, UTC+2)</dt><dd class="mt-1 text-slate-700">{formatDateInCAT(entry.data.date, 'h:mm a')}{entry.data.endDate && ` – ${formatDateInCAT(entry.data.endDate, 'h:mm a')}`}</dd></div>}
                <div><dt class="font-semibold text-slate-900">Location</dt><dd class="mt-1 text-slate-700">{formatLocation(entry.data.location)}</dd></div>
                {entry.data.organizer && <div><dt class="font-semibold text-slate-900">Organizer</dt><dd class="mt-1"><a class="text-primary-800 underline underline-offset-4" href={`/events/organizer/${entry.data.organizer.toLowerCase().replace(/\s+/g, '-')}`}>{entry.data.organizer}</a></dd></div>}
              </dl>
              <div class="mt-6 border-t border-slate-200 pt-5">
                {entry.data.status === 'past' ? <><p class="mb-4 text-slate-700">This event has already taken place.</p><Button href="/events" variant="secondary">Browse upcoming events</Button></> : (entry.data.registration?.url || entry.data.registrationLink) ? <Button href={entry.data.registration?.url || entry.data.registrationLink} target="_blank" rel="noopener noreferrer">Register for this event</Button> : <p class="text-slate-700">{entry.data.registration?.required ? 'Contact the organizer to register.' : 'No registration required.'}</p>}
                {entry.data.gallery && entry.data.status === 'past' && <a href={entry.data.gallery} class="mt-4 inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">View the photo gallery</a>}
              </div>
            </section>
            {entry.data.contact && <section><h2>Contact the organizer</h2><div class="mt-4 space-y-3 break-words">
              {entry.data.contact.email && <p><a href={`mailto:${entry.data.contact.email}`} class="text-primary-800 underline underline-offset-4 [overflow-wrap:anywhere]">{entry.data.contact.email}</a></p>}
              {entry.data.contact.phone && <p><a href={`tel:${entry.data.contact.phone}`} class="text-primary-800 underline underline-offset-4">{entry.data.contact.phone}</a></p>}
              {entry.data.contact.whatsapp && <p><a href={`https://wa.me/${entry.data.contact.whatsapp}`} target="_blank" rel="noopener noreferrer" class="text-primary-800 underline underline-offset-4">WhatsApp</a></p>}
            </div></section>}
          </aside>
        </div>
        {relatedEvents.length > 0 && <section class="mt-12 border-t border-slate-200 pt-8"><h2 class="mb-6">Related events</h2><EventGrid events={relatedEvents} /></section>}
      </div>
    </>
  )}
</MainLayout>
