---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { format } from 'date-fns';
import Badge from '../../components/ui/Badge.astro';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Get related events (same organizer or category)
const allEvents = await getCollection('events');
const relatedEvents = allEvents
  .filter(event => 
    event.slug !== entry.slug && 
    (event.data.organizer === entry.data.organizer || 
     event.data.category === entry.data.category)
  )
  .slice(0, 3);

// Function to format location
function formatLocation(location: any) {
  if (typeof location === 'string') return location;
  return location.venue && location.city ? `${location.venue}, ${location.city}` : location.venue || location.city || 'Location TBA';
}

// Function to format date in CAT timezone (UTC+2)
function formatDateInCAT(date: Date, formatString: string) {
  try {
    // Create a new date object and add 2 hours for CAT timezone
    const catDate = new Date(date.getTime() + (2 * 60 * 60 * 1000));
    return format(catDate, formatString);
  } catch (error) {
    // Fallback to original date if conversion fails
    return format(date, formatString);
  }
}

// Format date for structured data
const formattedDate = format(entry.data.date, 'yyyy-MM-dd');
const formattedTime = format(entry.data.date, 'HH:mm');

// Create structured data for event
const eventStructuredData = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": entry.data.title,
  "description": entry.data.description,
  "image": entry.data.image.startsWith('http') ? entry.data.image : `https://services.dzaleka.com${entry.data.image}`,
  "startDate": entry.data.date instanceof Date ? entry.data.date.toISOString() : entry.data.date,
  "endDate": entry.data.endDate ? (entry.data.endDate instanceof Date ? entry.data.endDate.toISOString() : entry.data.endDate) : (entry.data.date instanceof Date ? entry.data.date.toISOString() : entry.data.date),
  "eventStatus": entry.data.status === 'upcoming' ? "https://schema.org/EventScheduled" : "https://schema.org/EventCompleted",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": formatLocation(entry.data.location),
    "address": {
      "@type": "PostalAddress",
      "addressLocality": typeof entry.data.location === 'string' ? entry.data.location : entry.data.location.city || 'Dzaleka',
      "addressRegion": "Dowa",
      "addressCountry": "Malawi"
    }
  },
  "organizer": {
    "@type": "Organization",
    "name": entry.data.organizer || "Dzaleka Online Services",
    "url": entry.data.organizerUrl || "https://services.dzaleka.com"
  },
  "performer": {
    "@type": "Organization",
    "name": entry.data.organizer || "Dzaleka Online Services"
  },
  "offers": {
    "@type": "Offer",
    "url": entry.data.registration?.url || `https://services.dzaleka.com/events/${entry.slug}`,
    "price": "0",
    "priceCurrency": "MWK",
    "availability": "https://schema.org/InStock"
  }
};

// Create SEO metadata
const seo = {
  title: `${entry.data.title}`,
  description: entry.data.description,
  type: "event",
  canonical: `https://services.dzaleka.com/events/${entry.slug}`,
  openGraph: {
    title: `${entry.data.title}`,
    description: entry.data.description,
    type: "event",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/events/${entry.slug}`,
    image: {
      url: entry.data.image.startsWith('http') ? entry.data.image : `https://services.dzaleka.com${entry.data.image}`,
      width: 1200,
      height: 630,
      alt: entry.data.title,
      type: "image/jpeg"
    },
    event: {
      startTime: `${formattedDate}T${formattedTime}`,
      endTime: `${formattedDate}T${formattedTime}`,
      location: formatLocation(entry.data.location),
      organizer: entry.data.organizer || "Dzaleka Online Services"
    }
  },
  twitter: {
    card: "summary_large_image",
    title: `${entry.data.title}`,
    description: entry.data.description,
    image: entry.data.image.startsWith('http') ? entry.data.image : `https://services.dzaleka.com${entry.data.image}`,
    creator: entry.data.organizer ? `@${entry.data.organizer.replace(/\s+/g, '')}` : "@DzalekaConnect"
  }
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  image={seo.image} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(eventStructuredData)} />
  
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      {/* Back Button */}
      <div class="mb-6">
        <a 
          href="/events" 
          class="group inline-flex items-center text-gray-600 hover:text-primary-600 transition-all duration-200 font-medium"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Events
        </a>
      </div>

      <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        <!-- Hero Image -->
        <div class="relative">
          <img 
            src={entry.data.image} 
            alt={entry.data.title}
            class="w-full h-[60vh] object-cover transition-transform duration-700 hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent">
            <div class="absolute bottom-0 p-8">
              <Badge variant="blue" size="md" class="animate-fade-in">{entry.data.category}</Badge>
              <h1 class="text-4xl md:text-5xl font-bold text-white mt-4 drop-shadow-lg">
                {entry.data.title}
              </h1>
            </div>
          </div>
        </div>

        <!-- Content -->
        <div class="p-8">
          <!-- Event Info -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8 pb-8 border-b">
            <div class="flex items-center gap-3 text-gray-600 hover:text-primary-600 transition-colors group">
              <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center group-hover:bg-primary-200 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide">Date</p>
                <time datetime={entry.data.date.toISOString()} class="text-sm font-medium">
                  {formatDateInCAT(entry.data.date, 'MMMM d')} - {formatDateInCAT(entry.data.endDate, 'MMMM d, yyyy')}
                </time>
              </div>
            </div>
            <div class="flex items-center gap-3 text-gray-600 hover:text-primary-600 transition-colors group">
              <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center group-hover:bg-primary-200 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide">Time</p>
                <time datetime={entry.data.date.toISOString()} class="text-sm font-medium">
                  {formatDateInCAT(entry.data.date, 'h:mm a')} - {formatDateInCAT(entry.data.endDate, 'h:mm a')}
                </time>
              </div>
            </div>
            <div class="flex items-center gap-3 text-gray-600 hover:text-primary-600 transition-colors group">
              <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center group-hover:bg-primary-200 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 uppercase tracking-wide">Location</p>
                <span class="text-sm font-medium">{formatLocation(entry.data.location)}</span>
              </div>
            </div>
            {entry.data.organizer && (
              <a 
                href={`/events/organizer/${entry.data.organizer.toLowerCase().replace(/\s+/g, '-')}`}
                class="flex items-center gap-3 text-gray-600 hover:text-primary-600 transition-colors group"
              >
                <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center group-hover:bg-primary-200 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
                <div>
                  <p class="text-xs text-gray-500 uppercase tracking-wide">Organizer</p>
                  <span class="text-sm font-medium group-hover:text-primary-600 transition-colors">{entry.data.organizer}</span>
                </div>
              </a>
            )}
          </div>

          <!-- Contact Information -->
          {entry.data.contact && (
            <div class="bg-gray-50 rounded-lg p-6 mb-8 hover:bg-gray-100 transition-colors">
              <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary-600" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                </svg>
                Contact Information
              </h2>
              <div class="space-y-3">
                {entry.data.contact.email && (
                  <div class="flex items-center gap-2 group">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500 group-hover:text-primary-600 transition-colors" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z" />
                      <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z" />
                    </svg>
                    <a href={`mailto:${entry.data.contact.email}`} class="text-primary-600 hover:text-primary-700 transition-colors">
                      {entry.data.contact.email}
                    </a>
                  </div>
                )}
                {entry.data.contact.phone && (
                  <div class="flex items-center gap-2 group">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500 group-hover:text-primary-600 transition-colors" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                    </svg>
                    <a href={`tel:${entry.data.contact.phone}`} class="text-primary-600 hover:text-primary-700 transition-colors">
                      {entry.data.contact.phone}
                    </a>
                  </div>
                )}
                {entry.data.contact.whatsapp && (
                  <div class="flex items-center gap-2 group">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-gray-500 group-hover:text-primary-600 transition-colors" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2ZM12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.16 12.04 20.16C10.56 20.16 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.8 7.37 7.5 3.67 12.05 3.67ZM8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7 8.5 7 9.71C7 10.93 7.89 12.1 8 12.27C8.14 12.44 9.76 14.94 12.25 16C12.84 16.27 13.3 16.42 13.66 16.53C14.25 16.72 14.79 16.69 15.22 16.63C15.7 16.56 16.68 16.03 16.89 15.45C17.1 14.87 17.1 14.38 17.04 14.27C16.97 14.17 16.81 14.11 16.56 14C16.31 13.86 15.09 13.26 14.87 13.18C14.64 13.1 14.5 13.06 14.31 13.3C14.15 13.55 13.67 14.11 13.53 14.27C13.38 14.44 13.24 14.46 13 14.34C12.74 14.21 11.94 13.95 11 13.11C10.26 12.45 9.77 11.64 9.62 11.39C9.5 11.15 9.61 11 9.73 10.89C9.84 10.78 10 10.6 10.1 10.45C10.23 10.31 10.27 10.2 10.35 10.04C10.43 9.87 10.39 9.73 10.33 9.61C10.27 9.5 9.77 8.26 9.56 7.77C9.36 7.29 9.16 7.35 9 7.34C8.86 7.34 8.7 7.33 8.53 7.33Z" />
                    </svg>
                    <a href={`https://wa.me/${entry.data.contact.whatsapp}`} target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:text-primary-700 transition-colors">
                      WhatsApp
                    </a>
                  </div>
                )}
              </div>
            </div>
          )}

          <!-- Description -->
          <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            {entry.data.description}
          </p>

          <!-- Event Content -->
          <div class="prose prose-lg max-w-none mb-12 prose-headings:text-gray-900 prose-a:text-primary-600 hover:prose-a:text-primary-700">
            <Content />
          </div>

          <!-- Registration Section -->
          {entry.data.status === 'upcoming' && (
            <div class="flex flex-col items-center bg-gradient-to-br from-primary-50 to-primary-100 rounded-xl p-8 hover:shadow-lg transition-shadow">
              <h2 class="text-2xl font-bold text-gray-900 mb-4">Ready to Join?</h2>
              {entry.data.registration?.required ? (
                <>
                  <p class="text-gray-600 text-center mb-6">
                    Registration is required for this event. Click below to secure your spot!
                  </p>
                  <a
                    href={entry.data.registration.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-all hover:scale-105"
                  >
                    Register Now
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </a>
                </>
              ) : (
                <p class="text-gray-600 text-center">
                  No registration required. Just show up at the event!
                </p>
              )}
            </div>
          )}

          {entry.data.status === 'past' && (
            <div class="flex flex-col items-center bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl p-8 hover:shadow-lg transition-shadow">
              <h2 class="text-2xl font-bold text-gray-900 mb-4">Event Completed</h2>
              <p class="text-gray-600 text-center">
                This event has already taken place. Check out our other upcoming events!
              </p>
              <a
                href="/events"
                class="inline-flex items-center px-6 py-3 mt-6 text-base font-medium rounded-md text-primary-600 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-all hover:scale-105 shadow-sm"
              >
                View Upcoming Events
              </a>
            </div>
          )}

          <!-- Action Buttons -->
          <div class="mt-8 flex flex-wrap gap-4">
            {entry.data.registrationLink && entry.data.status === 'upcoming' && (
              <a
                href={entry.data.registrationLink}
                class="inline-flex items-center px-6 py-3 bg-primary-600 text-white rounded-xl hover:bg-primary-700 transition-all hover:scale-105"
              >
                Register Now
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
            )}
            {entry.data.gallery && entry.data.status === 'past' && (
              <a
                href={entry.data.gallery}
                class="inline-flex items-center px-6 py-3 bg-primary-100 text-primary-700 rounded-xl hover:bg-primary-200 transition-all hover:scale-105"
              >
                View Photo Gallery
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M4 5a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V7a2 2 0 00-2-2h-1.586a1 1 0 01-.707-.293l-1.121-1.121A2 2 0 0011.172 3H8.828a2 2 0 00-1.414.586L6.293 4.707A1 1 0 015.586 5H4zm6 9a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    {/* Related Events Section */}
    {relatedEvents.length > 0 && (
      <section class="bg-gray-50 py-16 mt-16">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-4">
                Related Events
              </h2>
              <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                Discover more events from the same organizer or in the same category
              </p>
              {entry.data.organizer && (
                <div class="mt-6">
                  <a 
                    href={`/events/organizer/${entry.data.organizer.toLowerCase().replace(/\s+/g, '-')}`}
                    class="inline-flex items-center px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors font-medium"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    View All Events by {entry.data.organizer}
                  </a>
                </div>
              )}
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {relatedEvents.map(related => (
                <a 
                  href={`/events/${related.slug}`}
                  class="group block transform hover:scale-[1.02] transition-all duration-300"
                >
                  <article class="bg-white rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col h-full border border-gray-100 relative">
                    {/* Gradient overlay on hover */}
                    <div class="absolute inset-0 bg-gradient-to-br from-primary-50/0 to-primary-50/0 group-hover:from-primary-50/20 group-hover:to-primary-50/10 transition-all duration-300"></div>
                    
                    <div class="aspect-w-16 aspect-h-9 relative overflow-hidden">
                      <img 
                        src={related.data.image} 
                        alt={related.data.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                      />
                      {/* Category badge */}
                      <div class="absolute bottom-3 right-3 z-10">
                        <span class="px-3 py-1 rounded-full text-xs font-medium shadow-sm bg-white/90 backdrop-blur-sm border border-white/20" class:list={{
                          'text-blue-700': related.data.status === 'upcoming',
                          'text-green-700': related.data.status === 'past'
                        }}>
                          {related.data.category}
                        </span>
                      </div>
                    </div>
                    
                    <div class="p-6 relative">
                      <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-3">
                          <time datetime={related.data.date.toISOString()} class:list={[
                            'text-sm block flex items-center',
                            related.data.isTBA ? 'text-yellow-600 font-medium' : 'text-gray-500'
                          ]}>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            {related.data.isTBA ? '📅 Date TBA' : formatDateInCAT(related.data.date, 'MMM d, yyyy')}
                          </time>
                          {/* Status indicator */}
                          <span class="px-2 py-1 rounded-full text-xs font-medium capitalize" class:list={{
                            'bg-blue-100 text-blue-800 border border-blue-200': related.data.status === 'upcoming',
                            'bg-gray-100 text-gray-800 border border-gray-200': related.data.status === 'past'
                          }}>
                            {related.data.status}
                          </span>
                        </div>
                      </div>
                      <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-primary-600 transition-colors line-clamp-2">{related.data.title}</h3>
                      <p class="text-gray-600 text-sm mb-4 line-clamp-2 leading-relaxed">{related.data.description}</p>
                      
                      <div class="flex justify-end">
                        <span class="text-sm font-medium text-primary-600 group-hover:text-primary-700 transition-colors flex items-center">
                          Learn More 
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                          </svg>
                        </span>
                      </div>
                    </div>
                  </article>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}
  </main>
</MainLayout>