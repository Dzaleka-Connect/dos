                      )}
                      <div class="flex-1 min-w-0">
                        <h3 class="text-lg font-semibold text-gray-900 mb-1">{panelist.name}</h3>
                        {panelist.role && (
                          <p class="text-sm text-primary-600 font-medium mb-2">{panelist.role}</p>
                        )}
                        {panelist.organization && (
                          <p class="text-sm text-gray-600 mb-2">{panelist.organization}</p>
                        )}
                        {panelist.bio && (
                          <div class="mb-3">
                            <p class="text-sm text-gray-600 line-clamp-3">{panelist.bio}</p>
                            {panelist.bio.length > 150 && (
                              <button class="text-primary-600 text-xs font-medium mt-2 hover:text-primary-700 transition-colors">
                                Read more...
                              </button>
                            )}
                          </div>
                        )}
                        {panelist.socialMedia && (
                          <div class="flex space-x-2" onclick="event.stopPropagation();">
                            {panelist.socialMedia.twitter && (
                              <a 
                                href={panelist.socialMedia.twitter}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-gray-400 hover:text-blue-500 transition-colors"
                                aria-label={`${panelist.name}'s Twitter`}
                              >
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                                </svg>
                              </a>
                            )}
                            {panelist.socialMedia.instagram && (
                              <a 
                                href={panelist.socialMedia.instagram}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-gray-400 hover:text-pink-500 transition-colors"
                                aria-label={`${panelist.name}'s Instagram`}
                              >
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                </svg>
                              </a>
                            )}
                            {panelist.socialMedia.linkedin && (
                              <a 
                                href={panelist.socialMedia.linkedin}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-gray-400 hover:text-blue-700 transition-colors"
                                aria-label={`${panelist.name}'s LinkedIn`}
                              >
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                </svg>
                              </a>
                            )}
                            {panelist.socialMedia.website && (
                              <a 
                                href={panelist.socialMedia.website}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-gray-400 hover:text-primary-600 transition-colors"
                                aria-label={`${panelist.name}'s Website`}
                              >
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                  <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.11 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/>
                                </svg>
                              </a>
                            )}
                          </div>
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Panelist Modal -->
          <div id="panelistModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden flex items-center justify-center p-4">
            <div class="bg-white rounded-lg max-w-2xl w-full max-h-[90vh] overflow-y-auto">
              <div class="p-6">
                <div class="flex justify-between items-start mb-4">
                  <h3 class="text-xl font-bold text-gray-900" id="modalPanelistName"></h3>
                  <button 
                    id="closePanelistModal"
                    class="text-gray-400 hover:text-gray-600 transition-colors"
                  >
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </button>
                </div>
                <div id="modalPanelistContent"></div>
              </div>
            </div>
          </div>

          <!-- Event Content -->
          <div class="prose prose-lg max-w-none mb-12 prose-headings:text-gray-900 prose-a:text-primary-600 hover:prose-a:text-primary-700">
            <Content />
          </div>

          <!-- Registration Section -->
          {entry.data.status === 'upcoming' && (
            <div class="flex flex-col items-center bg-gradient-to-br from-primary-50 to-primary-100 rounded-xl p-8 hover:shadow-lg transition-shadow">
              <h2 class="text-2xl font-bold text-gray-900 mb-4">Ready to Join?</h2>
              {entry.data.registration?.required ? (
                <>
                  <p class="text-gray-600 text-center mb-6">
                    Registration is required for this event. Click below to secure your spot!
                  </p>
                  <a
                    href={entry.data.registration.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-900 transition-colors"
                  >
                    Register Now
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                  </a>
                </>
              ) : (
                <p class="text-gray-600 text-center">
                  No registration required. Just show up at the event!
                </p>
              )}
            </div>
          )}

          {entry.data.status === 'past' && (
            <div class="flex flex-col items-center bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl p-8 hover:shadow-lg transition-shadow">
              <h2 class="text-2xl font-bold text-gray-900 mb-4">Event Completed</h2>
              <p class="text-gray-600 text-center">
                This event has already taken place. Check out our other upcoming events!
              </p>
              <a
                href="/events"
                class="inline-flex items-center px-6 py-3 mt-6 text-base font-medium rounded-md text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-200 transition-colors shadow-sm"
              >
                View Upcoming Events
              </a>
            </div>
          )}

          <!-- Action Buttons -->
          <div class="mt-8 flex flex-wrap gap-4">
            {entry.data.registrationLink && entry.data.status === 'upcoming' && (
              <a
                href={entry.data.registrationLink}
                class="inline-flex items-center px-6 py-3 bg-gray-900 text-white rounded-xl hover:bg-gray-800 transition-colors"
              >
                Register Now
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
            )}
            {entry.data.gallery && entry.data.status === 'past' && (
              <a
                href={entry.data.gallery}
                class="inline-flex items-center px-6 py-3 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200 transition-colors"
              >
                View Photo Gallery
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M4 5a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V7a2 2 0 00-2-2h-1.586a1 1 0 01-.707-.293l-1.121-1.121A2 2 0 0011.172 3H8.828a2 2 0 00-1.414.586L6.293 4.707A1 1 0 015.586 5H4zm6 9a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    {/* Related Events Section */}
    {relatedEvents.length > 0 && (
      <section class="bg-gray-50 py-16 mt-16">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto">
            <div class="text-center mb-12">
              <h2 class="text-3xl font-bold text-gray-900 mb-4">
                Related Events
              </h2>
              <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                Discover more events from the same organizer or in the same category
              </p>
              {entry.data.organizer && (
                <div class="mt-6">
                  <a 
                    href={`/events/organizer/${entry.data.organizer.toLowerCase().replace(/\s+/g, '-')}`}
                    class="inline-flex items-center px-6 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors font-medium border border-transparent"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    View All Events by {entry.data.organizer}
                  </a>
                </div>
              )}
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {relatedEvents.map(related => (
                <a
                  href={`/events/${related.id}`}
                  class="group block"
                >
                  <article class="bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-200 overflow-hidden flex flex-col h-full border border-gray-100">
                    <div class="aspect-w-16 aspect-h-9 relative overflow-hidden">
                      <img
                        src={related.data.image}
                        alt={related.data.title}
                        class="w-full h-full object-cover"
                      />
                      {/* Category badge */}
                      <div class="absolute bottom-3 right-3 z-10">
                        <span class="px-3 py-1 rounded-full text-xs font-medium shadow-sm bg-white/90 backdrop-blur-sm border border-gray-200" class:list={{
                          'text-gray-900': related.data.status === 'upcoming',
                          'text-gray-600': related.data.status === 'past'
                        }}>
                          {related.data.category}
                        </span>
                      </div>
                    </div>
                    
                    <div class="p-6 relative">
                      <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-3">
                          <time datetime={related.data.date.toISOString()} class:list={[
                            'text-sm block flex items-center',
                            related.data.isTBA ? 'text-yellow-600 font-medium' : 'text-gray-500'
                          ]}>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            {related.data.isTBA ? 'Date TBA' : formatDateInCAT(related.data.date, 'MMM d, yyyy')}
                          </time>
                          {/* Status indicator */}
                          <span class="px-2 py-1 rounded-full text-xs font-medium capitalize" class:list={{
                            'bg-gray-100 text-gray-800 border border-gray-200': related.data.status === 'upcoming',
                            'bg-gray-50 text-gray-600 border border-gray-100': related.data.status === 'past'
                          }}>
                            {related.data.status}
                          </span>
                        </div>
                      </div>
                      <h3 class="text-lg font-bold text-gray-900 mb-3 group-hover:text-primary-600 transition-colors line-clamp-2">{related.data.title}</h3>
                      <p class="text-gray-600 text-sm mb-4 line-clamp-2 leading-relaxed">{related.data.description}</p>
                      
                      <div class="flex justify-end">
                        <span class="text-sm font-medium text-primary-600 group-hover:text-primary-700 transition-colors flex items-center">
                          Learn More 
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                          </svg>
                        </span>
                      </div>
                    </div>
                  </article>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}
  </main>
  )}

  {!isPage && (
  <script define:vars={{ panelists: entry.data.panelists }}>
    // Panelist modal functionality
    function openPanelistModal(index) {
      const panelist = panelists[index];
      const modal = document.getElementById('panelistModal');
      const modalName = document.getElementById('modalPanelistName');
      const modalContent = document.getElementById('modalPanelistContent');
      
      modalName.textContent = panelist.name;
      
      let contentHTML = `
        <div class="space-y-4">
          <div class="flex items-start space-x-4">
            ${panelist.image ? `
              <div class="flex-shrink-0">
                <img 
                  src="${panelist.image.startsWith('http') ? panelist.image : '/images/' + panelist.image}"
                  alt="${panelist.name}"
                  class="w-20 h-20 rounded-full object-cover"
                  loading="lazy"
                />
              </div>
            ` : ''}
            <div class="flex-1">
              ${panelist.role ? `<p class="text-lg text-primary-600 font-medium mb-1">${panelist.role}</p>` : ''}
              ${panelist.organization ? `<p class="text-gray-600 mb-2">${panelist.organization}</p>` : ''}
            </div>
          </div>
          
          ${panelist.bio ? `
            <div>
              <h4 class="text-lg font-semibold text-gray-900 mb-2">Biography</h4>
              <p class="text-gray-600 leading-relaxed">${panelist.bio}</p>
            </div>
          ` : ''}
          
          ${panelist.socialMedia ? `
            <div>
              <h4 class="text-lg font-semibold text-gray-900 mb-2">Connect</h4>
              <div class="flex space-x-3">
                ${panelist.socialMedia.twitter ? `
                  <a 
                    href="${panelist.socialMedia.twitter}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center px-3 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors"
                  >
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                    </svg>
                    Twitter
                  </a>
                ` : ''}
                ${panelist.socialMedia.instagram ? `
                  <a 
                    href="${panelist.socialMedia.instagram}"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center px-3 py-2 bg-pink-500 text-white rounded-lg hover:bg-pink-600 transition-colors"
                  >
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
