---
import MainLayout from '../../../layouts/MainLayout.astro';
---

<MainLayout title="Course Submitted | Dzaleka E-Learning">
  <main class="min-h-screen bg-gray-50 flex items-center justify-center py-12">
    <div class="max-w-md w-full mx-auto px-4 text-center">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 md:p-10">
        <div class="w-20 h-20 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-6 ring-8 ring-green-50/50">
          <svg class="w-10 h-10 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-gray-900 mb-3">Course Submitted!</h1>
        <p class="text-gray-600 mb-8 leading-relaxed">
          Thank you for sharing your knowledge. Your course has been submitted for review and will be published once approved.
        </p>
        
        <div class="space-y-4">
          <a href="/e-learning/courses" class="block w-full bg-slate-900 text-white py-3.5 px-6 rounded-lg font-semibold hover:bg-slate-800 transition-colors shadow-sm">
            Browse Courses
          </a>
          <a href="/e-learning/courses/submit" class="block w-full bg-white text-gray-700 border border-gray-200 py-3.5 px-6 rounded-xl font-semibold hover:bg-gray-50 hover:text-slate-700 transition-colors">
            Submit Another Course
          </a>
        </div>
        
        <p class="text-xs text-gray-400 mt-8">
          You'll receive an email confirmation shortly.
        </p>
      </div>
    </div>
  </main>
</MainLayout>
