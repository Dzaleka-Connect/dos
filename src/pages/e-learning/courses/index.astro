---
import MainLayout from '../../../layouts/MainLayout.astro';
import CollectionHeader from '../../../components/ui/CollectionHeader.astro';
import CourseCard from '../../../components/learning/CourseCard.astro';
import { getCollection } from 'astro:content';

const courses = (await getCollection('courses')).filter(course => course.data.status === 'published').sort((a, b) => Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured)) || b.data.datePublished.getTime() - a.data.datePublished.getTime());
const categories = [...new Set(courses.map(course => course.data.category))].sort();
const levels = ['beginner', 'intermediate', 'advanced'].filter(level => courses.some(course => course.data.level === level));
const description = 'Browse courses by subject or level, or search for a topic.';
---
<MainLayout title="Courses" description={description}>
  <CollectionHeader title="Courses" description={description} breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'E-learning', href: '/e-learning' }, { label: 'Courses' }]} action={{ label: 'Submit a course', href: '/e-learning/courses/submit' }} />
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8" data-course-directory data-directory-noun="courses" aria-labelledby="course-results-heading">
    <form data-directory-form hidden class="rounded border border-slate-200 bg-slate-50 p-4 sm:p-5" role="search" aria-label="Courses">
      <div class="grid items-end gap-4 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_auto]">
        <div class="min-w-0"><label for="course-search" class="mb-2 block text-sm font-semibold text-slate-900">Search courses</label><input type="search" id="course-search" class="min-h-[44px] w-full rounded border-slate-400" placeholder="Course or topic" /></div>
        <div><label for="course-category" class="mb-2 block text-sm font-semibold text-slate-900">Subject</label><select id="course-category" data-directory-filter="category" class="min-h-[44px] w-full rounded border-slate-400 capitalize"><option value="">All subjects</option>{categories.map(category => <option value={category}>{category.replaceAll('-', ' ')}</option>)}</select></div>
        <div><label for="course-level" class="mb-2 block text-sm font-semibold text-slate-900">Level</label><select id="course-level" data-directory-filter="level" class="min-h-[44px] w-full rounded border-slate-400 capitalize"><option value="">All levels</option>{levels.map(level => <option value={level}>{level}</option>)}</select></div>
        <button type="button" data-directory-clear class="min-h-[44px] px-3 text-sm text-primary-800 underline underline-offset-4">Clear filters</button>
      </div>
    </form>
    <div class="my-6 flex flex-wrap items-baseline justify-between gap-2"><h2 id="course-results-heading" class="text-xl text-primary-900">Course catalogue</h2><p data-directory-count role="status" class="text-sm text-slate-600">{courses.length} courses</p></div>
    <ul class="grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3">{courses.map(course => <li class="min-w-0" data-search-item={[course.data.title, course.data.description, course.data.author, ...(course.data.tags || [])].join(' ')} data-category={course.data.category} data-level={course.data.level}><CourseCard course={course} /></li>)}</ul>
    <p data-directory-empty hidden class="border-t border-slate-200 py-8 text-slate-700">No courses match these filters. Try another topic or clear the filters.</p>
    {courses.length === 0 && <p class="text-slate-700">No courses have been published yet.</p>}
  </section>
</MainLayout>
<script>
  import { initDirectorySearch } from '../../../utils/directorySearch';
  document.querySelectorAll<HTMLElement>('[data-course-directory]').forEach(initDirectorySearch);
</script>
