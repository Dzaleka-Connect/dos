---
import MainLayout from '../../../layouts/MainLayout.astro';
import CollectionHeader from '../../../components/ui/CollectionHeader.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.filter(course => course.data.status === 'published').map(course => ({ params: { slug: course.id }, props: { course } }));
}
const { course } = Astro.props;
const { Content, headings } = await render(course);
const sections = headings.filter(heading => heading.depth === 2);
const date = course.data.lastUpdated || course.data.datePublished;
---
<MainLayout title={course.data.title} description={course.data.description} image={course.data.thumbnail}>
  <CollectionHeader title={course.data.title} description={course.data.description} breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'E-learning', href: '/e-learning' }, { label: 'Courses', href: '/e-learning/courses' }, { label: course.data.title }]}>
    <dl class="flex flex-wrap gap-x-8 gap-y-4 text-sm">
      <div><dt class="text-slate-500">Subject</dt><dd class="mt-1 capitalize text-slate-800">{course.data.category.replaceAll('-', ' ')}</dd></div>
      <div><dt class="text-slate-500">Level</dt><dd class="mt-1 capitalize text-slate-800">{course.data.level}</dd></div>
      <div><dt class="text-slate-500">Duration</dt><dd class="mt-1 text-slate-800">{course.data.duration}</dd></div>
      <div><dt class="text-slate-500">By</dt><dd class="mt-1 text-slate-800">{course.data.author}</dd></div>
      <div><dt class="text-slate-500">{course.data.lastUpdated ? 'Updated' : 'Published'}</dt><dd class="mt-1 text-slate-800"><time datetime={date.toISOString()}>{date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Africa/Blantyre' })}</time></dd></div>
    </dl>
  </CollectionHeader>
  <div class="mx-auto grid max-w-7xl items-start gap-8 px-4 py-8 sm:px-6 lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-12 lg:px-8">
    <aside class="min-w-0 lg:sticky lg:top-48 lg:max-h-[calc(100vh-14rem)] lg:overflow-y-auto">
      {sections.length > 0 && <details open data-course-contents class="border-y border-slate-200 py-3"><summary class="cursor-pointer py-2 font-semibold text-primary-900">On this page</summary><nav aria-label="Course sections" class="mt-2"><ul>{sections.map(section => <li><a href={`#${section.slug}`} class="block py-2 text-sm leading-6 text-primary-800 underline underline-offset-4">{section.text}</a></li>)}</ul></nav></details>}
      {course.data.externalLink && <a href={course.data.externalLink} class="mt-5 inline-flex min-h-[44px] items-center rounded bg-primary-900 px-5 py-3 text-sm font-medium text-white hover:bg-primary-800">Open external course <span class="ml-2" aria-hidden="true">↗</span></a>}
    </aside>
    <article class="min-w-0 max-w-prose">
      {course.data.videoUrl && <div class="mb-8 aspect-video overflow-hidden rounded bg-slate-100"><iframe src={course.data.videoUrl} title={`${course.data.title} video`} class="h-full w-full" loading="lazy" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe></div>}
      <div class="course-content prose prose-slate max-w-none prose-a:text-primary-800"><Content /></div>
      <p class="mt-8 border-t border-slate-200 pt-6"><a href="/e-learning/courses" class="inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">Browse all courses</a></p>
    </article>
  </div>
</MainLayout>
<script>
  const contents = document.querySelector<HTMLDetailsElement>('[data-course-contents]');
  if (contents) contents.open = window.matchMedia('(min-width: 1024px)').matches;
</script>
<style>
  .course-content :global(:first-child) { margin-top: 0; }
  .course-content :global(h2), .course-content :global(h3) { scroll-margin-top: 12rem; }
  .course-content :global(table) { display: block; max-width: 100%; overflow-x: auto; }
  .course-content :global(pre) { max-width: 100%; overflow-x: auto; }
  .course-content :global(a) { overflow-wrap: anywhere; }
</style>
