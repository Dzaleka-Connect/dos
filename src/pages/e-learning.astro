---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allCourses = await getCollection('courses');
const featuredCourses = allCourses
  .filter(course => course.data.status === 'published' && course.data.featured)
  .sort((a, b) => new Date(b.data.datePublished).getTime() - new Date(a.data.datePublished).getTime())
  .slice(0, 3);

const levelColors = {
  beginner: 'bg-green-100 text-green-700',
  intermediate: 'bg-amber-100 text-amber-700',
  advanced: 'bg-red-100 text-red-700',
};

// Create SEO metadata
const seo = {
  description: "Access free online courses and skill development programs. Learn technology, business, languages, and professional skills through community-created courses and local initiatives in Dzaleka.",
  type: "website",
  canonical: "https://services.dzaleka.com/e-learning",
  openGraph: {
    description: "Access free online courses and skill development programs. Learn technology, business, languages, and professional skills through community-created courses and local initiatives in Dzaleka.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/e-learning"
  },
  twitter: {
    card: "summary",
    description: "Access free online courses and skill development programs. Learn technology, business, languages, and professional skills through community-created courses and local initiatives in Dzaleka."
  }
};

// Create structured data for the e-learning platform
const eLearningStructuredData = {
  "@context": "https://schema.org",
  "@type": "EducationalOrganization",
  "name": "Dzaleka E-Learning Platform",
  "description": "Access quality education and skill development opportunities through our community courses and local learning initiatives.",
  "url": "https://services.dzaleka.com/e-learning",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://services.dzaleka.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "E-Learning",
        "item": "https://services.dzaleka.com/e-learning"
      }
    ]
  }
};
---

<MainLayout
  title="E-Learning Platform"
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(eLearningStructuredData)} />

  <main class="min-h-screen bg-gradient-to-b from-gray-50 to-white overflow-hidden">
    <!-- Hero Section -->
    <div class="relative min-h-[500px] flex items-center justify-center text-white overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0">
        <img
          src="https://alumni.creighton.edu/sites/default/files/externals/3a5e5345aed5539144d93eb04350baaa.jpg"
          alt="E-Learning at Dzaleka"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      {/* Content */}
      <div class="relative container mx-auto px-4 py-20 text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 max-w-4xl mx-auto leading-tight">
          E-Learning Platform
        </h1>
        <p class="text-xl md:text-2xl text-white/90 mb-12 max-w-2xl mx-auto">
          Access quality education and skill development through community courses and local initiatives
        </p>

        {/* Quick Links */}
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/e-learning/courses"
            class="px-6 py-3 bg-white text-slate-700 hover:bg-slate-50 rounded-lg font-medium transition-colors duration-200"
          >
            Browse Courses
          </a>
          <a
            href="/e-learning/courses/submit"
            class="px-6 py-3 border border-white/30 hover:bg-white/10 rounded-lg text-white/90 hover:text-white transition-colors duration-200"
          >
            Submit a Course
          </a>
          <a
            href="#featured-initiatives"
            class="px-6 py-3 border border-white/30 hover:bg-white/10 rounded-lg text-white/90 hover:text-white transition-colors duration-200"
          >
            Local Initiatives
          </a>
        </div>
      </div>
    </div>


    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Why Choose Us Section -->
      <div class="mb-20">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Learn from our community</h2>
          <p class="text-lg text-gray-600 max-w-3xl mx-auto">Access courses created by educators and experts in our community. Learn technology, business, languages, and more at your own pace.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm text-center transition-colors duration-200 hover:border-gray-300">
            <div class="w-12 h-12 bg-slate-100 rounded-xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5m0 0l9-5-9-5-9 5 9 5m0 0v6" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Community Courses</h3>
            <p class="text-gray-600">Free courses created by local educators covering various topics and skills</p>
          </div>

          <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm text-center transition-colors duration-200 hover:border-gray-300">
            <div class="w-12 h-12 bg-slate-100 rounded-xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Skill Development</h3>
            <p class="text-gray-600">Practical skills in IT, business, and digital technologies through structured learning</p>
          </div>

          <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm text-center transition-colors duration-200 hover:border-gray-300">
            <div class="w-12 h-12 bg-slate-100 rounded-xl flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Share Your Knowledge</h3>
            <p class="text-gray-600">Create and submit your own courses to help others in the community learn</p>
          </div>
        </div>

      </div>

      <!-- Featured Courses Section -->
      {featuredCourses.length > 0 && (
        <div class="mb-20">
          <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4">
            <div class="text-left">
              <h2 class="text-3xl font-bold text-gray-900 mb-4">Featured Courses</h2>
              <p class="text-lg text-gray-600 max-w-2xl">Courses selected from the learning catalogue.</p>
            </div>
            <a href="/e-learning/courses" class="group inline-flex items-center font-semibold text-slate-700 hover:text-slate-700 transition-colors">
              View All Courses
              <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {featuredCourses.map((course) => (
              <a
                href={`/e-learning/courses/${course.id}`}
                class="course-card flex flex-col bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden transition-colors duration-200 group hover:border-gray-300"
              >
                <div class="aspect-video bg-gray-100 relative overflow-hidden">
                  {course.data.thumbnail ? (
                    <img src={course.data.thumbnail} alt={course.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-slate-50 transition-colors">
                      <svg class="w-16 h-16 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                      </svg>
                    </div>
                  )}
                  <span class="absolute top-4 right-4 bg-white text-amber-600 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm border border-amber-100 flex items-center gap-1">
                    <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                    Featured
                  </span>
                </div>
                <div class="p-6 flex-1 flex flex-col">
                  <div class="flex items-center gap-3 mb-4">
                    <span class={`text-xs font-semibold px-2.5 py-1 rounded-md uppercase tracking-wide ${levelColors[course.data.level || 'beginner']}`}>
                      {course.data.level || 'Beginner'}
                    </span>
                    <span class="text-xs font-medium text-gray-500 bg-gray-100 px-2.5 py-1 rounded-md capitalize">
                      {course.data.category.replace('-', ' ')}
                    </span>
                  </div>
                  <h3 class="font-bold text-gray-900 text-xl mb-3 group-hover:text-slate-700 transition-colors line-clamp-2">
                    {course.data.title}
                  </h3>
                  <p class="text-sm text-gray-600 mb-6 line-clamp-2 leading-relaxed">
                    {course.data.description}
                  </p>
                  <div class="mt-auto pt-4 border-t border-gray-50 flex items-center justify-between text-sm text-gray-500">
                    <div class="flex items-center gap-2">
                      <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-700 font-bold text-xs">
                        {course.data.author.charAt(0)}
                      </div>
                      <span class="font-medium">{course.data.author}</span>
                    </div>
                    <span class="flex items-center bg-gray-50 px-2 py-1 rounded text-xs font-medium">
                      <svg class="w-3.5 h-3.5 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      {course.data.duration}
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Featured Local Initiatives -->
      <div id="featured-initiatives" class="mb-20">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Featured local initiatives</h2>
          <p class="text-lg text-gray-600 max-w-3xl mx-auto">Local organizations offering education and skills training in Dzaleka.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Adai Circle -->
          <a href="https://adaicircle.com/" target="_blank" rel="noopener noreferrer"
             class="group relative bg-white rounded-xl shadow-sm border border-gray-200 transition-colors duration-200 hover:border-gray-300 overflow-hidden flex flex-col">
            <div class="relative h-64 overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"></div>
              <img src="https://raisely-images.imgix.net/dzaleka-fundraising/uploads/f-01-x-2-h-wa-aw-dij-7-jpeg-9bf1fc.jpeg?fm=jpg&fit=max&w=700&auto=format&q=62&dpr=2"
                   alt="Adai Circle"
                   class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute top-4 right-4 bg-white rounded-full px-3 py-1 text-sm font-medium text-slate-700 z-20 border border-gray-200 shadow-sm">
                Digital Skills
              </div>
            </div>
            <div class="p-6 flex-grow bg-white">
              <div class="flex items-center mb-4">
                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRgkKzgZs6hr3fBf5KrBw2LEKRnaGgxLmJ6Lg&s" alt="Adai Circle Logo" class="w-8 h-8 rounded-full mr-3" />
                <h3 class="text-xl font-semibold text-gray-900 group-hover:text-slate-700 transition-colors">Adai Circle</h3>
              </div>
              <p class="text-gray-600 mb-4">Training in artificial intelligence, machine learning, and data science.</p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="px-3 py-1 bg-slate-50 text-slate-700 rounded-full text-sm">AI & ML</span>
                <span class="px-3 py-1 bg-slate-50 text-slate-700 rounded-full text-sm">Data Science</span>
              </div>
              <div class="flex items-center text-slate-700 font-medium group-hover:text-slate-700 mt-auto">
                Explore Programs
                <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </a>

          <!-- Jesuit Worldwide Learning -->
          <a href="https://www.jwl.org/" target="_blank" rel="noopener noreferrer"
             class="group relative bg-white rounded-xl shadow-sm border border-gray-200 transition-colors duration-200 hover:border-gray-300 overflow-hidden flex flex-col">
            <div class="relative h-64 overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"></div>
              <img src="https://images.squarespace-cdn.com/content/v1/55cb874ce4b05b9a72d3fb90/1487807079219-80GH93UA212UQABP99VK/MALAWI+-+DZALEKA+-+TRESOR+IN+THE+COMPUTER+ROOM+OF+JRS+COMPOUND+-+PHOTO+BY+GIULIO+D%27ERCOLE+-+3390.jpg?format=1500w"
                   alt="Jesuit Worldwide Learning"
                   class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute top-4 right-4 bg-white rounded-full px-3 py-1 text-sm font-medium text-slate-700 z-20 border border-gray-200 shadow-sm">
                Higher Education
              </div>
            </div>
            <div class="p-6 flex-grow bg-white">
              <div class="flex items-center mb-4">
                <img src="https://www.jwl.org/static/images/favicon/favicon-96x96.png" alt="JWL Logo" class="w-8 h-8 rounded-full mr-3" />
                <h3 class="text-xl font-semibold text-gray-900 group-hover:text-slate-700 transition-colors">Jesuit Worldwide Learning</h3>
              </div>
              <p class="text-gray-600 mb-4">Higher education opportunities for refugees and marginalized communities, providing recognized certificates and diplomas.</p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="px-3 py-1 bg-slate-50 text-slate-700 rounded-full text-sm">Diplomas</span>
                <span class="px-3 py-1 bg-slate-50 text-slate-700 rounded-full text-sm">Certificates</span>
              </div>
              <div class="flex items-center text-slate-700 font-medium group-hover:text-slate-700 mt-auto">
                Explore Programs
                <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </a>

          <!-- Takenolab -->
          <a href="https://takenolab.com/" target="_blank" rel="noopener noreferrer"
             class="group relative bg-white rounded-xl shadow-sm border border-gray-200 transition-colors duration-200 hover:border-gray-300 overflow-hidden flex flex-col">
            <div class="relative h-64 overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"></div>
              <img src="https://takenolab.com/images/tknlb27.jpeg"
                   alt="Takenolab"
                   class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute top-4 right-4 bg-white rounded-full px-3 py-1 text-sm font-medium text-slate-700 z-20 border border-gray-200 shadow-sm">
                Programming Skills
              </div>
            </div>
            <div class="p-6 flex-grow bg-white">
              <div class="flex items-center mb-4">
                <img src="https://takenolab.com/images/logo.png" alt="Takenolab Logo" class="w-8 h-8 rounded-full mr-3" />
                <h3 class="text-xl font-semibold text-gray-900 group-hover:text-slate-700 transition-colors">Takenolab</h3>
              </div>
              <p class="text-gray-600 mb-4">Supporting refugee entrepreneurs and innovation initiatives through hands-on training in programming and digital skills.</p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="px-3 py-1 bg-slate-50 text-slate-700 rounded-full text-sm">Programming</span>
                <span class="px-3 py-1 bg-slate-50 text-slate-700 rounded-full text-sm">Digital Skills</span>
              </div>
              <div class="flex items-center text-slate-700 font-medium group-hover:text-slate-700 mt-auto">
                Explore Programs
                <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </a>

          <!-- ATE-Hub -->
          <a href="https://www.atehub.org/" target="_blank" rel="noopener noreferrer"
             class="group relative bg-white rounded-xl shadow-sm border border-gray-200 transition-colors duration-200 hover:border-gray-300 overflow-hidden flex flex-col">
            <div class="relative h-64 overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"></div>
              <img src="https://images.cdn-files-a.com/uploads/6638854/2000_6421401c0a743.jpg"
                   alt="ATE-Hub"
                   class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute top-4 right-4 bg-white rounded-full px-3 py-1 text-sm font-medium text-slate-700 z-20 border border-gray-200 shadow-sm">
                Tech Education
              </div>
            </div>
            <div class="p-6 flex-grow bg-white">
              <div class="flex items-center mb-4">
                <img src="https://images.cdn-files-a.com/uploads/6638854/400_64d9d5333a0ad.png?aspect_ratio=1:1&width=48&format=png" alt="ATE-Hub Logo" class="w-8 h-8 rounded-full mr-3" />
                <h3 class="text-xl font-semibold text-gray-900 group-hover:text-slate-700 transition-colors">ATE-Hub</h3>
              </div>
              <p class="text-gray-600 mb-4">Technology education and digital literacy programmes for refugee communities.</p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="px-3 py-1 bg-slate-50 text-slate-700 rounded-full text-sm">Digital Literacy</span>
                <span class="px-3 py-1 bg-slate-50 text-slate-700 rounded-full text-sm">Tech Skills</span>
              </div>
              <div class="flex items-center text-slate-700 font-medium group-hover:text-slate-700 mt-auto">
                Explore Programs
                <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </a>
        </div>
      </div>

      <!-- Global Learning Resources -->
      <div class="mb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Global learning resources</h2>
          <p class="text-lg text-gray-600 max-w-3xl mx-auto">Free online courses and learning platforms that work well from Dzaleka</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- UNHCR Opportunities -->
          <a href="https://services.unhcr.org/opportunities/search" target="_blank" rel="noopener noreferrer"
             class="group bg-white rounded-xl border border-gray-200 p-6 shadow-sm transition-colors duration-200 hover:border-gray-300">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                <svg class="w-6 h-6 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900 ml-4 group-hover:text-slate-700 transition-colors">UNHCR Opportunities</h3>
            </div>
            <p class="text-gray-600">Find scholarships, training programs, and educational opportunities specifically for refugees.</p>
          </a>

          <!-- Coursera -->
          <a href="https://www.coursera.org/courses?query=free" target="_blank" rel="noopener noreferrer"
             class="group bg-white rounded-xl border border-gray-200 p-6 shadow-sm transition-colors duration-200 hover:border-gray-300">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                <svg class="w-6 h-6 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
