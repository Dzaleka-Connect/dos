---
import MainLayout from '../layouts/MainLayout.astro';
import CollectionHeader from '../components/ui/CollectionHeader.astro';
import CourseCard from '../components/learning/CourseCard.astro';
import ServiceLogo from '../components/services/ServiceLogo.astro';
import { getCollection } from 'astro:content';

const courses = (await getCollection('courses')).filter(course => course.data.status === 'published');
const featuredCourses = [...courses].sort((a, b) => Number(Boolean(b.data.featured)) - Number(Boolean(a.data.featured)) || b.data.datePublished.getTime() - a.data.datePublished.getTime()).slice(0, 3);
const services = await getCollection('services');
const initiatives = [
  { id: 'adai-circle', description: 'Artificial intelligence, machine learning and data science.' },
  { id: 'jesuit-worldwide-learning', description: 'Higher education programmes for refugees and other underserved communities.' },
  { id: 'takenolab', description: 'Programming and digital skills training.' },
  { id: 'ate-hub', description: 'Technology education and digital literacy.' },
].map(initiative => ({ ...initiative, service: services.find(service => service.id === initiative.id) }));
const resources = [
  { title: 'UNHCR Opportunities', description: 'Scholarships, training and education opportunities for refugees.', href: 'https://services.unhcr.org/opportunities/search' },
  { title: 'Coursera', description: 'Online courses from universities and other education providers.', href: 'https://www.coursera.org/courses?query=free' },
  { title: 'edX', description: 'University courses in science, technology, humanities and other subjects.', href: 'https://www.edx.org/courses?q=free+online+courses' },
  { title: 'Khan Academy', description: 'Lessons and practice exercises in maths and other subjects.', href: 'https://www.khanacademy.org' },
];
const description = 'Courses in business, technology and life skills, with learning organizations in Dzaleka.';
---
<MainLayout title="E-learning" description={description}>
  <CollectionHeader title="E-learning" description={description} action={{ label: 'Browse all courses', href: '/e-learning/courses' }}>
    <nav aria-label="Learning" class="flex flex-wrap gap-x-6 gap-y-2 text-sm"><a href="#featured-initiatives" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Learning in Dzaleka</a><a href="#online-resources" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Online resources</a><a href="/e-learning/courses/submit" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Submit a course</a></nav>
  </CollectionHeader>
  <div class="mx-auto max-w-7xl space-y-12 px-4 py-8 sm:px-6 lg:px-8">
    <section aria-labelledby="courses-heading">
      <h2 id="courses-heading" class="mb-6 text-primary-900">Courses</h2>
      {featuredCourses.length ? <ul class="grid gap-8 md:grid-cols-3">{featuredCourses.map(course => <li class="min-w-0"><CourseCard course={course} /></li>)}</ul> : <p class="text-slate-600">No courses have been published yet.</p>}
    </section>
    <section id="featured-initiatives" aria-labelledby="initiatives-heading" class="scroll-mt-48 border-t border-slate-200 pt-8">
      <h2 id="initiatives-heading" class="text-primary-900">Learning in Dzaleka</h2>
      <ul class="mt-2 grid gap-x-10 md:grid-cols-2">{initiatives.map(({ service, description }) => service && <li class="flex gap-4 border-b border-slate-200 py-6"><ServiceLogo title={service.data.title} logo={service.data.logo} /><div class="min-w-0"><h3 class="text-lg"><a href={`/services/${service.id}`} class="text-primary-800 underline underline-offset-4">{service.data.title}</a></h3><p class="mt-2 text-sm leading-6 text-slate-700">{description}</p></div></li>)}</ul>
    </section>
    <section id="online-resources" aria-labelledby="resources-heading" class="scroll-mt-48 border-t border-slate-200 pt-8">
      <h2 id="resources-heading" class="text-primary-900">Online resources</h2>
      <ul class="mt-6 grid gap-x-10 gap-y-6 md:grid-cols-2">{resources.map(resource => <li><h3 class="text-lg"><a href={resource.href} class="text-primary-800 underline underline-offset-4">{resource.title} <span aria-hidden="true">↗</span></a></h3><p class="mt-2 text-sm leading-6 text-slate-700">{resource.description}</p></li>)}</ul>
    </section>
  </div>
</MainLayout>
