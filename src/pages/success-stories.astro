---
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import { getCollection } from "astro:content";
const entries = await getCollection("encyclopedia");
const findEntries = (ids: string[]) =>
  ids.flatMap((id) => entries.filter((entry) => entry.id === id));
const people = findEntries([
  "innocent-magambi",
  "menes-la-plume",
  "remy-gakwaya",
]);
const groups = findEntries([
  "salama-africa",
  "amahoro-burundian-drummers",
  "fountain-of-hope-africa",
]);
const description =
  "Meet people and organisations connected to Dzaleka through education, advocacy, music and dance. Read their stories and sourced encyclopedia profiles.";
const canonical = "https://services.dzaleka.com/success-stories";
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Success stories",
  description,
  url: canonical,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: [...people, ...groups].map((entry, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: entry.data.title,
      url: `https://services.dzaleka.com/encyclopedia/${entry.id}`,
    })),
  },
};
---

<MainLayout
  title="Success stories"
  description={description}
  canonical={canonical}
  image="https://services.dzaleka.com/images/profiles/menes-la-plume.jpg"
  schema={schema}
>
  <section class="bg-primary-900 text-white">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
      <Breadcrumb
        light
        items={[{ label: "Home", href: "/" }, { label: "Success stories" }]}
      />
      <p class="text-sm font-semibold uppercase tracking-widest text-primary-200">
        People and their work
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
        Success stories from Dzaleka
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-primary-50">
        Meet the people behind community organisations, festivals and places to
        learn.
      </p>
    </div>
  </section>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section aria-labelledby="people-heading">
      <h2 id="people-heading" class="text-2xl font-bold text-slate-900">
        Advocacy, arts and education
      </h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {people.map((person) => (
          <article class="overflow-hidden rounded border border-slate-200 bg-white">
            <a
              href={`/encyclopedia/${person.id}`}
              class="block aspect-[4/3] bg-slate-100"
              tabindex="-1"
              aria-hidden="true"
            >
              {person.data.image && (
                <img
                  src={person.data.image}
                  alt=""
                  width="640"
                  height="480"
                  class="h-full w-full object-contain"
                />
              )}
            </a>
            <div class="p-6">
              <h3 class="text-2xl font-bold">
                <a
                  href={`/encyclopedia/${person.id}`}
                  class="text-primary-800 underline decoration-primary-200 underline-offset-4 hover:decoration-primary-700"
                >
                  {person.data.title}
                </a>
              </h3>
              <p class="mt-3 leading-7 text-slate-600">{person.data.summary}</p>
              <p class="mt-5 text-sm text-slate-500">
                Profile and sources in the encyclopedia
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="mt-12 grid gap-8 border-t border-slate-200 pt-8 lg:grid-cols-[260px_minmax(0,1fr)]">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">
          Community organisations
        </h2>
        <p class="mt-3 leading-7 text-slate-600">
          Groups working in performance, learning and community support.
        </p>
      </div>
      <div class="divide-y divide-slate-200">
        {groups.map((group) => (
          <article class="flex items-start gap-5 py-5 first:pt-0">
            {group.data.image && (
              <img
                src={group.data.image}
                alt=""
                loading="lazy"
                width="120"
                height="120"
                class="hidden h-28 w-28 shrink-0 rounded bg-slate-100 object-cover sm:block"
              />
            )}
            <div>
              <h3 class="text-xl font-semibold">
                <a
                  href={`/encyclopedia/${group.id}`}
                  class="text-primary-800 underline underline-offset-4"
                >
                  {group.data.title}
                </a>
              </h3>
              <p class="mt-2 leading-7 text-slate-600">{group.data.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
    <aside class="mt-10 flex flex-wrap items-center justify-between gap-5 border-l-4 border-primary-700 bg-slate-50 p-6">
      <div>
        <h2 class="text-xl font-semibold text-slate-900">
          More personal stories
        </h2>
        <p class="mt-2 text-slate-600">
          Photography, business, study and everyday life in Dzaleka.
        </p>
      </div>
      <a
        href="/inspirational-stories"
        class="inline-flex min-h-[44px] items-center rounded bg-primary-900 px-5 py-3 font-semibold text-white hover:bg-primary-800"
      >
        Browse personal stories →
      </a>
    </aside>
  </div>
</MainLayout>
