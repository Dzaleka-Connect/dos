---
import MainLayout from '../layouts/MainLayout.astro';

const title = 'Success Stories | Dzaleka Online Services';
const description =
  'Examples of achievement, creativity, and community leadership connected to Dzaleka.';

const featuredStories = [
  {
    name: 'Innocent Magambi',
    summary:
      'Founded There is Hope and later Inua Advocacy, helping expand health, advocacy, and support services for refugees and host communities.',
    highlights: ['Founded There is Hope', 'Supported health outreach', 'Built advocacy networks'],
  },
  {
    name: 'Menes la Plume',
    summary:
      'Used poetry, music, and festival organising to create visibility for refugee artists and strengthen cultural exchange through Tumaini Festival.',
    highlights: ['Founded Tumaini Festival', 'Promoted arts and culture', 'Expanded local tourism visibility'],
  },
  {
    name: 'Remy Gakwaya',
    summary:
      'Helped grow technology learning and refugee-led coordination through TakenoLAB and RELON Malawi.',
    highlights: ['Built digital learning spaces', 'Supported refugee-led organisations', 'Expanded tech opportunities'],
  },
];

const moreStories = [
  {
    title: 'Mirash Films',
    description:
      'Award-winning film work from Dzaleka has shown how local storytelling can travel across Malawi and beyond.',
  },
  {
    title: 'Salama Africa',
    description:
      'Dance and performance continue to open doors for collaboration, cultural preservation, and paid creative work.',
  },
  {
    title: 'Amahoro Burundian Drummers',
    description:
      'Years of performance work have turned cultural practice into a strong public-facing community asset.',
  },
  {
    title: 'Fountain of Hope',
    description:
      'Education and income-generation work has helped demonstrate what inclusive community development can look like in practice.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Success Stories',
  description,
  url: 'https://services.dzaleka.com/success-stories',
  about: {
    '@type': 'Organization',
    name: 'Dzaleka Online Services',
    description: 'A platform highlighting activity, services, and community achievements connected to Dzaleka.',
  },
};
---

<MainLayout
  title={title}
  description={description}
  canonical="https://services.dzaleka.com/success-stories"
  openGraph={{
    title,
    description,
    type: 'website',
    site_name: 'Dzaleka Online Services',
    locale: 'en_US',
    url: 'https://services.dzaleka.com/success-stories',
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="bg-gray-50">
    <section class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <nav class="mb-4 text-sm text-gray-500">
          <a href="/" class="hover:text-primary-700">Home</a>
          <span class="mx-2">/</span>
          <span class="text-gray-900">Success stories</span>
        </nav>

        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary-700">Community stories</p>
          <h1 class="mt-3 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">Success stories from Dzaleka</h1>
          <p class="mt-4 text-lg leading-8 text-gray-600">
            These examples show the range of work, leadership, and creativity emerging from the community. Some are individual stories. Others reflect organisations, artists, and businesses building longer-term impact.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="grid gap-6 lg:grid-cols-3">
          {featuredStories.map((story) => (
            <article class="rounded border border-gray-200 bg-white p-6">
              <h2 class="text-xl font-semibold text-gray-900">{story.name}</h2>
              <p class="mt-3 text-sm leading-6 text-gray-600">{story.summary}</p>
              <ul class="mt-4 space-y-2 text-sm text-gray-700">
                {story.highlights.map((highlight) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-1 h-1.5 w-1.5 rounded-full bg-primary-600"></span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-gray-200 bg-gray-50">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
          <div>
            <h2 class="text-2xl font-semibold text-gray-900">More examples</h2>
            <div class="mt-6 grid gap-4">
              {moreStories.map((story) => (
                <article class="rounded border border-gray-200 bg-white p-5">
                  <h3 class="text-lg font-semibold text-gray-900">{story.title}</h3>
                  <p class="mt-2 text-sm leading-6 text-gray-600">{story.description}</p>
                </article>
              ))}
            </div>
          </div>

          <aside class="rounded border border-gray-200 bg-white p-6">
            <h2 class="text-lg font-semibold text-gray-900">Keep exploring</h2>
            <p class="mt-3 text-sm leading-6 text-gray-600">
              For more current stories and individual profiles, use the sections below.
            </p>
            <ul class="mt-5 space-y-3 text-sm">
              <li><a href="/inspirational-stories" class="text-primary-700 hover:text-primary-800">Inspirational stories</a></li>
              <li><a href="/news" class="text-primary-700 hover:text-primary-800">Latest news</a></li>
              <li><a href="/public-art-catalogue" class="text-primary-700 hover:text-primary-800">Public art catalogue</a></li>
              <li><a href="/skills-exchange" class="text-primary-700 hover:text-primary-800">Skills exchange</a></li>
              <li><a href="/marketplace" class="text-primary-700 hover:text-primary-800">Marketplace</a></li>
            </ul>
          </aside>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
