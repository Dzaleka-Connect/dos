---
import MainLayout from '../layouts/MainLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

const contactInfo = {
  email: 'dzalekaconnect@gmail.com',
  address: 'Dzaleka Refugee Camp, Dowa District, Malawi',
  socialMedia: [
    { name: 'Facebook', url: 'https://facebook.com/dzalekaonline', icon: 'facebook' },
    { name: 'Twitter', url: 'https://twitter.com/dzalekaconnect', icon: 'twitter' },
    { name: 'Instagram', url: 'https://instagram.com/dzalekaonline', icon: 'instagram' }
  ]
};

// SEO metadata
const seo = {
  description: "Contact Dzaleka Online Services for support, questions, or collaboration. Reach our team via email, social media, or contact form. Get assistance with services, resources, and community programs in Malawi's largest refugee camp.",
  type: "website",
  canonical: "https://services.dzaleka.com/contact",
  openGraph: {
    description: "Contact Dzaleka Online Services for support, questions, or collaboration. Reach our team via email, social media, or contact form. Get assistance with services, resources, and community programs in Malawi's largest refugee camp.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/contact"
  },
  twitter: {
    card: "summary",
    description: "Contact Dzaleka Online Services for support, questions, or collaboration. Reach our team via email, social media, or contact form. Get assistance with services, resources, and community programs in Malawi's largest refugee camp."
  }
};
---

<MainLayout 
  title="Contact Us"
  description={seo.description} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <main class="min-h-screen">
    <!-- Hero Section -->
    <div class="border-b border-slate-200 bg-white">
      <div class="max-w-7xl mx-auto px-4 py-16 sm:py-24 sm:px-6 lg:px-8">
        <div class="mb-8">
          <Breadcrumb items={[
            { label: 'Home', href: '/' },
            { label: 'Contact Us' }
          ]} />
        </div>
        <div class="text-center">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-gray-900 mb-6 tracking-tight">
            Get in Touch
          </h1>
          <p class="text-xl sm:text-2xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
            Have questions, need support, or want to collaborate? We're here to help connect our community
          </p>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-16 sm:px-6 lg:px-8">

      <div class="grid gap-8 md:grid-cols-2 max-w-5xl mx-auto">
        <!-- Contact Information -->
        <div class="bg-white rounded-xl p-8 border border-slate-200 hover:border-slate-300 transition-colors">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">Contact Information</h2>

          <div class="space-y-8">
            <div class="flex items-start">
              <div class="flex-shrink-0">
                <div class="flex items-center justify-center h-12 w-12 rounded-lg bg-slate-50 text-slate-600 border border-slate-200">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <p class="text-lg font-medium text-gray-900">Email</p>
                <a href={`mailto:${contactInfo.email}`} class="mt-1 text-gray-600 hover:text-slate-900 transition-colors block">
                  {contactInfo.email}
                </a>
              </div>
            </div>

            <div class="flex items-start">
              <div class="flex-shrink-0">
                <div class="flex items-center justify-center h-12 w-12 rounded-lg bg-slate-50 text-slate-600 border border-slate-200">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
              </div>
              <div class="ml-4">
                <p class="text-lg font-medium text-gray-900">Address</p>
                <p class="mt-1 text-gray-600">{contactInfo.address}</p>
              </div>
            </div>
          </div>

          <!-- Social Media -->
          <div class="mt-10 pt-8 border-t border-gray-100">
            <h3 class="text-lg font-bold text-gray-900 mb-6">Connect With Us</h3>
            <div class="flex space-x-4">
              {contactInfo.socialMedia.map(social => (
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-12 h-12 bg-gray-50 rounded-lg flex items-center justify-center text-gray-400 hover:bg-slate-700 hover:text-white transition-colors"
                >
                  <span class="sr-only">{social.name}</span>
                  <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                    {social.icon === 'facebook' && (
                      <path d="M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4z" />
                    )}
                    {social.icon === 'twitter' && (
                      <path d="M23.954 4.569c-.885.389-1.83.654-2.825.775 1.014-.611 1.794-1.574 2.163-2.723-.951.555-2.005.959-3.127 1.184-.896-.959-2.173-1.559-3.591-1.559-2.717 0-4.92 2.203-4.92 4.917 0 .39.045.765.127 1.124C7.691 8.094 4.066 6.13 1.64 3.161c-.427.722-.666 1.561-.666 2.475 0 1.71.87 3.213 2.188 4.096-.807-.026-1.566-.248-2.228-.616v.061c0 2.385 1.693 4.374 3.946 4.827-.413.111-.849.171-1.296.171-.314 0-.615-.03-.916-.086.631 1.953 2.445 3.377 4.604 3.417-1.68 1.319-3.809 2.105-6.102 2.105-.39 0-.779-.023-1.17-.067 2.189 1.394 4.768 2.209 7.557 2.209 9.054 0 13.999-7.496 13.999-13.986 0-.209 0-.42-.015-.63.961-.689 1.8-1.56 2.46-2.548l-.047-.02z" />
                    )}
                    {social.icon === 'instagram' && (
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                    )}
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="bg-white rounded-xl p-8 border border-slate-200 hover:border-slate-300 transition-colors">
          <h2 class="text-2xl font-bold text-gray-900 mb-8">Send a Message</h2>
          <ContactForm />
        </div>
      </div>
    </div>
  </main>
</MainLayout>