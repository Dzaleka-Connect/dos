---
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import { getCollection } from "astro:content";
import {
  toolsLibrary,
  templatePath,
  toolsBreadcrumb,
  toolsImage,
} from "../utils/startupTemplates";

const templates = (await getCollection("startup-templates")).sort(
  (a, b) => a.data.order - b.data.order,
);
const actionPlan = templates.find(
  (template) => template.id === "one-page-business-action-plan",
);
const topics: Record<string, string> = {
  "marketing-plan-template": "Reach customers",
  "one-page-business-action-plan": "Set priorities",
  "cash-flow-forecast-template": "Plan your money",
  "risk-and-crisis-plan-template": "Prepare for disruption",
  "new-customer-engagement-letter-template": "Agree on the work",
  "simple-business-plan-guide": "Plan a business",
};
const digitalTools = [
  {
    title: "Dzaleka Digital File Profiling",
    description: "A macOS app for inspecting file formats, metadata and duplicate files.",
    href: "https://github.com/Dzaleka-Connect/Dzaleka-Digital-File-Profiling",
    category: "Digital archives",
  },
  {
    title: "Dzaleka Metadata Standard",
    description:
      "Describe and validate heritage records using shared metadata fields.",
    href: "https://github.com/Dzaleka-Connect/Dzaleka-Metadata-Standard",
    category: "Collection records",
  },
  {
    title: "Dzaleka API Skills",
    description:
      "Agent skills for finding services, events, jobs and other Dzaleka site data.",
    href: "https://github.com/Dzaleka-Connect/dzaleka-api-skills",
    category: "Developers",
  },
];
const submissionForms = [
  {
    title: "Register a service",
    description: "Add an organisation or community service to the directory.",
    href: "/services/register",
  },
  {
    title: "Post a job",
    description: "List a vacancy on the job board.",
    href: "/jobs/post",
  },
  {
    title: "Submit an opportunity",
    description: "Send a grant, programme or open call for review.",
    href: "/grants-and-programs/submit",
  },
  {
    title: "Submit a resource",
    description: "Share a report, guide, study or public document.",
    href: "/resources/submit",
  },
  {
    title: "Submit a site record",
    description: "Record a community place or local landmark.",
    href: "/site-register/submit",
  },
  {
    title: "Submit public art",
    description: "Add an artwork to the public art catalogue.",
    href: "/public-art-catalogue/submit",
  },
];
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: toolsLibrary.title,
  description: toolsLibrary.description,
  url: toolsLibrary.canonical,
  breadcrumb: toolsBreadcrumb(),
  mainEntity: {
    "@type": "ItemList",
    name: "Business templates",
    numberOfItems: templates.length,
    itemListElement: templates.map((template, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: template.data.title,
      url: new URL(templatePath(template.id), toolsLibrary.canonical).href,
    })),
  },
};
---

<MainLayout
  title={toolsLibrary.title}
  description={toolsLibrary.description}
  canonical={toolsLibrary.canonical}
  image={toolsImage}
  schema={schema}
>
  <div class="tools-library bg-white">
    <section class="bg-primary-900 text-white">
      <div class="mx-auto max-w-7xl px-4 py-7 sm:px-6 lg:px-8 lg:py-9">
        <Breadcrumb
          light
          items={[{ label: "Home", href: "/" }, { label: toolsLibrary.title }]}
        />
        <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-16">
          <div>
            <p class="text-sm font-semibold uppercase tracking-widest text-primary-200">
              For work and community projects
            </p>
            <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
              Tools and templates
            </h1>
            <p class="mt-4 max-w-2xl text-lg leading-8 text-primary-50">
              Plan a business, work with Dzaleka data or contribute to the site.
              Choose a worksheet, digital tool or submission form.
            </p>
            <a
              href="#business-startup-templates"
              class="mt-6 inline-flex min-h-[44px] items-center gap-3 rounded bg-white px-5 py-3 font-semibold text-primary-900 hover:bg-primary-50"
            >
              Browse business templates <span aria-hidden="true">↓</span>
            </a>
          </div>
          {actionPlan && (
            <aside
              class="hidden rounded border-t-4 border-primary-300 bg-white p-6 text-slate-900 shadow-sm lg:block"
              aria-label="Featured worksheet"
            >
              <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">
                Start with a short plan
              </p>
              <h2 class="mt-2 text-xl font-bold">
                <a
                  href={templatePath(actionPlan.id)}
                  class="text-primary-800 underline decoration-primary-300 underline-offset-4 hover:decoration-primary-800"
                >
                  {actionPlan.data.shortTitle}
                </a>
              </h2>
              <ol class="mt-4 divide-y divide-slate-200 text-sm text-slate-600">
                {actionPlan.data.sections.slice(0, 3).map((section, index) => (
                  <li class="flex gap-3 py-2.5">
                    <span
                      class="font-semibold text-primary-700"
                      aria-hidden="true"
                    >
                      {index + 1}.
                    </span>
                    {section.title}
                  </li>
                ))}
              </ol>
              <p class="mt-3 border-t border-slate-200 pt-3 text-xs text-slate-500">
                Fill in online · Download · Print
              </p>
            </aside>
          )}
        </div>
      </div>
    </section>

    <nav
      aria-label="Tools and templates sections"
      class="border-b border-slate-200 bg-slate-50"
    >
      <div class="mx-auto flex max-w-7xl flex-wrap gap-x-8 gap-y-1 px-4 py-2 sm:px-6 lg:px-8">
        <a
          href="#business-startup-templates"
          class="inline-flex min-h-[44px] items-center font-medium text-primary-800 underline underline-offset-4"
        >
          Business templates
        </a>
        <a
          href="#featured-tools"
          class="inline-flex min-h-[44px] items-center font-medium text-primary-800 underline underline-offset-4"
        >
          Digital tools
        </a>
        <a
          href="#platform-templates"
          class="inline-flex min-h-[44px] items-center font-medium text-primary-800 underline underline-offset-4"
        >
          Submission forms
        </a>
      </div>
    </nav>

    <section
      id="business-startup-templates"
      aria-labelledby="templates-heading"
      class="mx-auto max-w-7xl scroll-mt-28 px-4 py-10 sm:px-6 lg:px-8 lg:py-12"
    >
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2
            id="templates-heading"
            class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
          >
            Business templates
          </h2>
          <p class="mt-2 max-w-2xl leading-7 text-slate-600">
            Worksheets for small businesses in Dzaleka. Add your notes online,
            download a text copy or print a blank worksheet.
          </p>
        </div>
        <p class="text-sm text-slate-500">
          {templates.length} templates · No account needed
        </p>
      </div>
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {templates.map((template) => (
          <article class="template-card flex flex-col rounded border border-slate-200 border-t-[3px] border-t-primary-700 bg-white p-6 transition-colors hover:border-primary-500">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
              {topics[template.id]}
            </p>
            <h3 class="mt-3 text-xl font-bold leading-7">
              <a
                href={templatePath(template.id)}
                class="text-primary-800 underline decoration-primary-200 underline-offset-4 hover:decoration-primary-800"
              >
                {template.data.shortTitle}
              </a>
            </h3>
            <p class="mb-5 mt-3 leading-7 text-slate-600">
              {template.data.description.split(". ")[0]}.
            </p>
            <p class="mt-auto flex items-center justify-between border-t border-slate-200 pt-4 text-sm text-slate-500">
              <span>{template.data.sections.length} sections · Worksheet</span>
              <span class="text-primary-700" aria-hidden="true">
                →
              </span>
            </p>
          </article>
        ))}
      </div>
    </section>

    <section
      id="featured-tools"
      aria-labelledby="digital-heading"
      class="scroll-mt-28 border-y border-slate-200 bg-slate-50"
    >
      <div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[260px_minmax(0,1fr)] lg:gap-12 lg:px-8 lg:py-12">
        <div>
          <h2
            id="digital-heading"
            class="text-2xl font-bold tracking-tight text-slate-900"
          >
            Digital tools
          </h2>
          <p class="mt-3 leading-7 text-slate-600">
            Code and documentation for developers and people managing digital
            collections.
          </p>
          <p class="mt-4 text-sm text-slate-500">
            These links open GitHub repositories.
          </p>
        </div>
        <div class="divide-y divide-slate-200 border-y border-slate-200">
          {digitalTools.map((tool) => (
            <article class="py-5 first:pt-5">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                {tool.category}
              </p>
              <h3 class="mt-1 text-lg font-semibold">
                <a
                  href={tool.href}
                  class="text-primary-800 underline underline-offset-4 hover:text-primary-600"
                >
                  {tool.title}
                  <span aria-hidden="true" class="ml-2">
                    ↗
                  </span>
                </a>
              </h3>
              <p class="mt-2 leading-6 text-slate-600">{tool.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section
      id="platform-templates"
      aria-labelledby="forms-heading"
      class="mx-auto max-w-7xl scroll-mt-28 px-4 py-10 sm:px-6 lg:px-8 lg:py-12"
    >
      <h2
        id="forms-heading"
        class="text-2xl font-bold tracking-tight text-slate-900"
      >
        Submission forms
      </h2>
      <p class="mt-2 leading-7 text-slate-600">
        Send a listing or record to Dzaleka Online Services.
      </p>
      <div class="mt-6 grid gap-x-10 md:grid-cols-2 lg:grid-cols-3">
        {submissionForms.map((form) => (
          <article class="border-t border-slate-200 py-5">
            <h3 class="font-semibold">
              <a
                href={form.href}
                class="inline-flex min-h-[32px] items-center gap-3 text-primary-800 underline underline-offset-4 hover:text-primary-600"
              >
                {form.title}
                <span aria-hidden="true">→</span>
              </a>
            </h3>
            <p class="mt-1 text-sm leading-6 text-slate-600">
              {form.description}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section
      id="guides-and-reference"
      aria-labelledby="references-heading"
      class="border-t border-slate-200 bg-slate-50"
    >
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <h2
          id="references-heading"
          class="text-lg font-semibold text-slate-900"
        >
          Documentation and data
        </h2>
        <ul class="mt-3 flex flex-wrap gap-x-8 gap-y-2">
          {[
            ["API documentation", "/api-docs"],
            ["Site documentation", "/docs"],
            ["Open data", "/open-data-platform"],
            ["Reports and guides", "/resources"],
          ].map(([title, href]) => (
            <li>
              <a
                href={href}
                class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4 hover:text-primary-600"
              >
                {title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</MainLayout>

<style>
  .tools-library :is(a, button):focus-visible {
    outline: 3px solid #0284c7;
    outline-offset: 4px;
  }
  .tools-library section:first-child a:focus-visible {
    outline-color: white;
  }
</style>
