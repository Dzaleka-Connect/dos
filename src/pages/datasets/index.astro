---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import { getDatasetCatalog, getDatasetStats, getDatasetThemes } from '../../data/datasets';

const datasets = await getDatasetCatalog();
const featuredDatasets = datasets.filter((dataset) => dataset.featured).slice(0, 3);
const themes = getDatasetThemes(datasets);
const stats = getDatasetStats(datasets);

const pageTitle = 'Datasets - Dzaleka Open Data Catalog';
const seo = {
  title: pageTitle,
  description: 'Browse public datasets, curated research pages, and open reference feeds from Dzaleka Online Services.',
  canonical: 'https://services.dzaleka.com/datasets',
  type: 'website',
  openGraph: {
    title: pageTitle,
    description: 'Browse public datasets, curated research pages, and open reference feeds from Dzaleka Online Services.',
    type: 'website',
    site_name: 'Dzaleka Online Services',
    locale: 'en_US',
    url: 'https://services.dzaleka.com/datasets',
  },
  twitter: {
    card: 'summary_large_image',
    title: pageTitle,
    description: 'Public datasets, curated research pages, and open reference feeds from Dzaleka Online Services.',
  },
};
---

<MainLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  type={seo.type}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <section class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Open data platform', href: '/open-data-platform' },
            { label: 'Datasets' },
          ]}
        />

        <div class="mt-6">
          <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
            Datasets
          </h1>
          <p class="mt-3 max-w-2xl text-base leading-7 text-gray-600">
            {stats.totalDatasets} public datasets across {stats.themes} themes — browse, search, or connect via the API.
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-3">
            <Button href="/api-docs" variant="primary" size="md">API docs</Button>
            <Button href="/open-data-platform" variant="outline" size="md">About the platform</Button>
            <Button href="/data" variant="ghost" size="md" className="border border-gray-200 bg-white hover:bg-gray-50">
              Data hub
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured -->
    {featuredDatasets.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div>
          <span class="text-slate-700 font-semibold text-sm uppercase tracking-wider">Featured</span>
          <h2 class="mt-2 text-2xl font-bold tracking-tight text-gray-900">Highlighted datasets</h2>
        </div>

        <div class="mt-8 grid gap-6 lg:grid-cols-3">
          {featuredDatasets.map((dataset) => (
            <article class="bg-white rounded-xl border border-gray-200 hover:border-slate-400 transition-colors duration-300 overflow-hidden">
              <div class="p-6">
                <div class="flex items-center justify-between gap-3 mb-4">
                  <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
                    {dataset.theme}
                  </span>
                  <span class="text-sm text-gray-500">{dataset.lastUpdatedDisplay}</span>
                </div>
                <h3 class="text-lg font-bold text-gray-900 mb-2">
                  <a href={`/datasets/${dataset.slug}`} class="hover:text-primary-700">
                    {dataset.title}
                  </a>
                </h3>
                <p class="text-sm leading-6 text-gray-600 mb-4">{dataset.summary}</p>
                <div class="flex items-center gap-4 text-sm text-gray-500 mb-4">
                  <span>{dataset.recordDisplay} {dataset.recordLabel.toLowerCase()}</span>
                  <span>·</span>
                  <span>{dataset.distributionCount} resources</span>
                </div>
                <div class="flex flex-wrap gap-2 mb-5">
                  {dataset.tags.slice(0, 3).map((tag) => (
                    <span class="rounded-full border border-gray-200 px-2.5 py-0.5 text-xs text-gray-500">{tag}</span>
                  ))}
                </div>
                <a
                  href={`/datasets/${dataset.slug}`}
                  class="inline-flex items-center text-sm font-medium text-slate-700 hover:text-slate-900"
                >
                  View dataset →
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- All datasets -->
    <section class="border-t border-gray-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h2 class="text-2xl font-bold tracking-tight text-gray-900">All datasets</h2>
            <p class="mt-2 text-base text-gray-600">
              Filter by theme or search across titles, summaries, and tags.
            </p>
          </div>

          <div class="w-full sm:w-72">
            <label for="dataset-search" class="sr-only">Search datasets</label>
            <div class="relative">
              <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                id="dataset-search"
                type="search"
                placeholder="Search datasets..."
                class="w-full rounded-lg border border-gray-300 pl-10 pr-4 py-2.5 text-sm text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-100"
                data-dataset-search
              />
            </div>
            <p class="mt-2 text-sm text-gray-500" data-results-count>{datasets.length} datasets</p>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          <button
            type="button"
            data-theme-filter="All"
            aria-pressed="true"
            class="inline-flex items-center rounded-full bg-gray-900 px-3.5 py-1.5 text-sm font-medium text-white"
          >
            All
          </button>
          {themes.map((theme) => (
            <button
              type="button"
              data-theme-filter={theme}
              aria-pressed="false"
              class="inline-flex items-center rounded-full border border-gray-300 bg-white px-3.5 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50"
            >
              {theme}
            </button>
          ))}
        </div>

        <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3" data-dataset-grid>
          {datasets.map((dataset) => (
            <article
              class="group flex h-full flex-col rounded-xl border border-gray-200 bg-white p-5 transition hover:border-gray-400"
              data-dataset-card
              data-theme={dataset.theme}
              data-search={dataset.searchText}
            >
              <div class="flex items-center justify-between gap-3 mb-3">
                <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700">
                  {dataset.theme}
                </span>
                <span class="text-xs text-gray-400">{dataset.lastUpdatedDisplay}</span>
              </div>

              <h3 class="text-base font-bold text-gray-900 mb-2">
                <a href={`/datasets/${dataset.slug}`} class="hover:text-primary-700">
                  {dataset.title}
                </a>
              </h3>
              <p class="text-sm leading-6 text-gray-600 mb-3 line-clamp-2">{dataset.summary}</p>

              <div class="flex items-center gap-3 text-xs text-gray-500 mb-3">
                <span>{dataset.recordDisplay} {dataset.recordLabel.toLowerCase()}</span>
                <span>·</span>
                <span>{dataset.distributionCount} resources</span>
                <span>·</span>
                <span>{dataset.publisher}</span>
              </div>

              <div class="flex flex-wrap gap-1.5 mb-4">
                {dataset.tags.slice(0, 3).map((tag) => (
                  <span class="rounded-full border border-gray-200 px-2.5 py-0.5 text-xs text-gray-500">
                    {tag}
                  </span>
                ))}
              </div>

              <div class="mt-auto flex items-center justify-between">
                <a
                  href={`/datasets/${dataset.slug}`}
                  class="inline-flex items-center text-sm font-medium text-slate-700 group-hover:text-slate-900"
                >
                  View dataset →
                </a>
                <span class="text-xs text-gray-400">{dataset.coverage}</span>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-10 rounded-xl border border-dashed border-gray-300 bg-gray-50 px-6 py-8 text-center" data-empty-state hidden>
          <h3 class="text-lg font-semibold text-gray-900">No datasets match this filter</h3>
          <p class="mt-2 text-sm text-gray-600">
            Try a broader search term or switch back to all themes.
          </p>
        </div>

        <!-- Pagination -->
        <div class="mt-8 flex items-center justify-between border-t border-gray-200 px-4 py-3 sm:px-6" data-pagination-container hidden>
          <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
            <div>
              <p class="text-sm text-gray-700">
                Showing <span class="font-medium" data-page-start>1</span> to <span class="font-medium" data-page-end>10</span> of <span class="font-medium" data-page-total>20</span> results
              </p>
            </div>
            <div>
              <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                <button
                  type="button"
                  data-page-prev
                  class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <span class="sr-only">Previous</span>
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
                  </svg>
                </button>
                <div id="pageNumbers" class="flex items-center space-x-1 px-2"></div>
                <button
                  type="button"
                  data-page-next
                  class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0 disabled:opacity-50 disabled:cursor-not-allowed"
                >
                  <span class="sr-only">Next</span>
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                  </svg>
                </button>
              </nav>
            </div>
          </div>
          <div class="flex flex-1 justify-between sm:hidden">
            <button type="button" data-mobile-prev class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
            <button type="button" data-mobile-next class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    function initDatasetPagination() {
      const searchInput = document.querySelector('[data-dataset-search]') as HTMLInputElement;
      const filterButtons = Array.from(document.querySelectorAll('[data-theme-filter]')) as HTMLButtonElement[];
      const cards = Array.from(document.querySelectorAll('[data-dataset-card]')) as HTMLElement[];
      const resultsCount = document.querySelector('[data-results-count]');
      const emptyState = document.querySelector('[data-empty-state]') as HTMLElement;
      
      // Pagination elements
      const paginationContainer = document.querySelector('[data-pagination-container]') as HTMLElement;
      const btnPrev = document.querySelector('[data-page-prev]') as HTMLButtonElement;
      const btnNext = document.querySelector('[data-page-next]') as HTMLButtonElement;
      const btnMobilePrev = document.querySelector('[data-mobile-prev]') as HTMLButtonElement;
      const btnMobileNext = document.querySelector('[data-mobile-next]') as HTMLButtonElement;
      const pageNumbers = document.getElementById('pageNumbers');
      const textCurrent = document.querySelector('[data-page-current]');
      const textStart = document.querySelector('[data-page-start]');
      const textEnd = document.querySelector('[data-page-end]');
      const textTotal = document.querySelector('[data-page-total]');

      let activeTheme = 'All';
      let currentPage = 1;
      const itemsPerPage = 6;
      let filteredCards: HTMLElement[] = [];

      function updateButtonStyles() {
        filterButtons.forEach((button) => {
          const isActive = button.dataset.themeFilter === activeTheme;
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          button.className = isActive
            ? 'inline-flex items-center rounded-full bg-gray-900 px-3.5 py-1.5 text-sm font-medium text-white'
            : 'inline-flex items-center rounded-full border border-gray-300 bg-white px-3.5 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50';
        });
      }

      function hideCard(card: HTMLElement) {
        card.setAttribute('hidden', '');
        card.classList.add('hidden');
        card.style.display = 'none';
      }

      function showCard(card: HTMLElement) {
        card.removeAttribute('hidden');
        card.classList.remove('hidden');
        card.style.display = 'flex';
      }

      function applyFilters() {
        const query = (searchInput?.value || '').trim().toLowerCase();
        filteredCards = [];

        cards.forEach((card) => {
          const matchesTheme = activeTheme === 'All' || card.dataset.theme === activeTheme;
          const matchesSearch = !query || (card.dataset.search || '').includes(query);
          const shouldShow = matchesTheme && matchesSearch;

          if (shouldShow) {
            filteredCards.push(card);
          } else {
            hideCard(card);
          }
        });

        currentPage = 1;
        updatePagination();
      }

      function renderPageNumbers(totalPages: number) {
        if (!pageNumbers) return;
        pageNumbers.innerHTML = '';

        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = String(i);
          btn.className = i === currentPage
            ? 'relative inline-flex items-center px-3 py-1.5 text-xs font-bold text-white bg-slate-900 rounded-md focus:z-20'
            : 'relative inline-flex items-center px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-100 rounded-md focus:z-20';
          btn.addEventListener('click', () => goToPage(i));
          pageNumbers.appendChild(btn);
        }
      }

      function updatePagination() {
        const totalItems = filteredCards.length;
        const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;
        
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = Math.min(startIndex + itemsPerPage, totalItems);

        // Show/hide appropriate cards for the current page
        filteredCards.forEach((card, index) => {
          const shouldShow = index >= startIndex && index < endIndex;
          if (shouldShow) {
            showCard(card);
          } else {
            hideCard(card);
          }
        });

        // Update Header counts
        if (resultsCount) {
          resultsCount.textContent = `${totalItems} dataset${totalItems === 1 ? '' : 's'}`;
        }

        // Handle Empty State
        if (emptyState) {
          if (totalItems === 0) {
            emptyState.removeAttribute('hidden');
            emptyState.style.display = 'block';
          } else {
            emptyState.setAttribute('hidden', '');
            emptyState.style.display = 'none';
          }
        }

        // Update Pagination UI
        if (paginationContainer) {
          if (totalPages <= 1) {
            paginationContainer.setAttribute('hidden', '');
            paginationContainer.style.display = 'none';
          } else {
            paginationContainer.removeAttribute('hidden');
            paginationContainer.style.display = 'flex';
          }
          
          if (textStart) textStart.textContent = String(totalItems === 0 ? 0 : startIndex + 1);
          if (textEnd) textEnd.textContent = String(endIndex);
          if (textTotal) textTotal.textContent = String(totalItems);
          if (textCurrent) textCurrent.textContent = String(currentPage);

          renderPageNumbers(totalPages);

          const isFirstPage = currentPage === 1;
          const isLastPage = currentPage === totalPages;

          if (btnPrev) btnPrev.disabled = isFirstPage;
          if (btnNext) btnNext.disabled = isLastPage;
          if (btnMobilePrev) btnMobilePrev.disabled = isFirstPage;
          if (btnMobileNext) btnMobileNext.disabled = isLastPage;
        }
      }

      function goToPage(page: number) {
        currentPage = page;
        updatePagination();
        document.querySelector('[data-dataset-grid]')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          activeTheme = button.dataset.themeFilter || 'All';
          updateButtonStyles();
          applyFilters();
        });
      });

      searchInput?.addEventListener('input', applyFilters);

      [btnPrev, btnMobilePrev].forEach(btn => {
        btn?.addEventListener('click', () => goToPage(currentPage - 1));
      });

      [btnNext, btnMobileNext].forEach(btn => {
        btn?.addEventListener('click', () => goToPage(currentPage + 1));
      });

      updateButtonStyles();
      applyFilters();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDatasetPagination);
    } else {
      initDatasetPagination();
    }
  </script>
</MainLayout>
