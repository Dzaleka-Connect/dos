---
import MainLayout from '../layouts/MainLayout.astro';
import { submissionConfirmations } from '../data/submissionConfirmations';
const confirmation = submissionConfirmations.default;
---
<MainLayout title={confirmation.title} description="Submission confirmation and next steps." robots="noindex, follow" showFeedback={false}>
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:py-16">
    <div class="border-t-4 border-green-700 bg-green-50 p-6 sm:p-8">
      <p class="mb-3 text-sm font-semibold text-green-800">Dzaleka Online Services</p>
      <h1 id="thank-you-title" class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{confirmation.title}</h1>
      <p id="thank-you-message" class="mt-4 text-lg leading-7 text-slate-700">{confirmation.message}</p>
    </div>
    <section class="mt-8" aria-labelledby="next-steps-heading">
      <h2 id="next-steps-heading" class="text-xl font-bold text-slate-900">What happens next</h2>
      <ul id="next-steps-list" class="mt-4 list-disc space-y-3 pl-5 text-slate-700">{confirmation.nextSteps.map(step => <li>{step}</li>)}</ul>
      <p class="mt-5 text-slate-700">For questions or corrections, <a href="/help-desk" class="text-primary-800 underline underline-offset-4">contact the help desk</a>.</p>
    </section>
    <a id="thank-you-cta" href={confirmation.cta.href} class="mt-8 inline-flex min-h-[44px] items-center rounded bg-primary-900 px-5 py-3 font-semibold text-white hover:bg-primary-800">{confirmation.cta.text}</a>
  </div>
</MainLayout>
<script>
  import { submissionConfirmation } from '../data/submissionConfirmations';
  const confirmation = submissionConfirmation(new URLSearchParams(window.location.search).get('type'));
  document.title = `${confirmation.title} | Dzaleka Online Services`;
  document.getElementById('thank-you-title')!.textContent = confirmation.title;
  document.getElementById('thank-you-message')!.textContent = confirmation.message;
  const steps = document.getElementById('next-steps-list')!;
  steps.replaceChildren(...confirmation.nextSteps.map(step => {
    const item = document.createElement('li');
    item.textContent = step;
    return item;
  }));
  const link = document.getElementById('thank-you-cta') as HTMLAnchorElement;
  link.href = confirmation.cta.href;
  link.textContent = confirmation.cta.text;
</script>
