---
import MainLayout from '../../layouts/MainLayout.astro';
import { updates } from '../../data/updates';
import { format } from 'date-fns';

export async function getStaticPaths() {
    const itemsPerPage = 5;
    const totalPages = Math.ceil(updates.length / itemsPerPage);

    return Array.from({ length: totalPages }, (_, i) => {
        const page = i + 1;
        const start = i * itemsPerPage;
        const end = start + itemsPerPage;
        return {
            params: { page: page.toString() },
            props: {
                page,
                totalPages,
                currentUpdates: updates.slice(start, end)
            }
        };
    });
}

const { page, totalPages, currentUpdates } = Astro.props;
const pageNum = parseInt(page, 10);

if (isNaN(pageNum) || pageNum < 1 || pageNum > totalPages) {
    return Astro.redirect('/updates/1');
}

const getTypeStyle = (type: string) => {
    switch (type) {
        case 'feature':
            return {
                label: 'Feature',
                badge: 'bg-blue-50 text-blue-700'
            };
        case 'improvement':
            return {
                label: 'Improvement',
                badge: 'bg-emerald-50 text-emerald-700'
            };
        case 'data':
            return {
                label: 'Data refresh',
                badge: 'bg-amber-50 text-amber-800'
            };
        case 'announcement':
            return {
                label: 'Announcement',
                badge: 'bg-slate-100 text-slate-700'
            };
        default:
            return {
                label: 'Update',
                badge: 'bg-gray-100 text-gray-700'
            };
    }
};

const getPaginationRange = (current: number, total: number) => {
    const delta = 2;
    const range = [];
    const rangeWithDots = [];
    let previous;

    range.push(1);

    if (total <= 1) return range;

    for (let i = current - delta; i <= current + delta; i++) {
        if (i < total && i > 1) {
            range.push(i);
        }
    }

    range.push(total);

    for (const item of range) {
        if (previous) {
            if (item - previous === 2) {
                rangeWithDots.push(previous + 1);
            } else if (item - previous !== 1) {
                rangeWithDots.push('...');
            }
        }

        rangeWithDots.push(item);
        previous = item;
    }

    return rangeWithDots;
};

const paginationRange = getPaginationRange(pageNum, totalPages);
---

<MainLayout title={`Updates - Page ${pageNum} | Dzaleka Online Services`}>
    <main class="min-h-screen bg-gray-50">
        <section class="border-b border-gray-200 bg-white">
            <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary-700">Updates</p>
                <h1 class="mt-3 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">
                    Site changes, editorial work, and new tools
                </h1>
                <p class="mt-4 max-w-3xl text-lg leading-8 text-gray-600">
                    A running log of what actually changed across Dzaleka Online Services, from new routes and platform tools to data refreshes and editorial tasks.
                </p>
            </div>
        </section>

        <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
            <div class="overflow-hidden rounded-xl border border-gray-200 bg-white">
                {currentUpdates.map((update, index) => {
                    const style = getTypeStyle(update.type);
                    const globalIndex = (pageNum - 1) * 5 + index;

                    return (
                        <article class="border-b border-gray-200 last:border-b-0">
                            <div class="flex flex-col gap-4 px-5 py-6 sm:px-6 sm:py-7 md:flex-row md:items-start md:justify-between md:gap-8">
                                <div class="max-w-3xl">
                                    <div class="flex flex-wrap items-center gap-3 text-sm">
                                        <span class={`rounded-full px-3 py-1 font-medium ${style.badge}`}>
                                            {style.label}
                                        </span>
                                        <time class="text-gray-500">
                                            {format(new Date(update.date), 'MMMM d, yyyy')}
                                        </time>
                                    </div>

                                    <h2 class="mt-4 text-xl font-semibold tracking-tight text-gray-900">
                                        <a href={`/updates/view/${globalIndex}`} class="hover:text-primary-700">
                                            {update.title}
                                        </a>
                                    </h2>

                                    <p class="mt-3 max-w-2xl text-base leading-7 text-gray-600">
                                        {update.description}
                                    </p>

                                    {update.link && update.linkText && (
                                        <p class="mt-4 text-sm text-gray-500">
                                            Related page:{' '}
                                            <a href={update.link} class="font-medium text-primary-700 hover:text-primary-800 hover:underline">
                                                {update.linkText}
                                            </a>
                                        </p>
                                    )}
                                </div>

                                <div class="md:pt-1">
                                    <a
                                        href={`/updates/view/${globalIndex}`}
                                        class="inline-flex items-center gap-2 text-sm font-semibold text-primary-700"
                                    >
                                        Read note
                                        <span aria-hidden="true">→</span>
                                    </a>
                                </div>
                            </div>
                        </article>
                    );
                })}
            </div>

            {totalPages > 1 && (
                <nav class="mt-10 flex items-center justify-center" aria-label="Updates pagination">
                    <div class="flex items-center gap-2">
                        {pageNum > 1 && (
                            <a
                                href={`/updates/${pageNum - 1}`}
                                class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 transition hover:border-gray-400 hover:bg-gray-50"
                            >
                                Previous
                            </a>
                        )}

                        {paginationRange.map((item) => (
                            item === '...'
                                ? <span class="px-2 py-2 text-sm text-gray-400">...</span>
                                : <a
                                    href={`/updates/${item}`}
                                    class:list={[
                                        'inline-flex min-w-[2.5rem] items-center justify-center rounded-lg border px-3 py-2 text-sm font-medium transition',
                                        item === pageNum
                                            ? 'border-primary-700 bg-primary-700 text-white'
                                            : 'border-gray-300 bg-white text-gray-700 hover:border-gray-400 hover:bg-gray-50'
                                    ]}
                                    aria-current={item === pageNum ? 'page' : undefined}
                                >
                                    {item}
                                </a>
                        ))}

                        {pageNum < totalPages && (
                            <a
                                href={`/updates/${pageNum + 1}`}
                                class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 transition hover:border-gray-400 hover:bg-gray-50"
                            >
                                Next
                            </a>
                        )}
                    </div>
                </nav>
            )}
        </section>
    </main>
</MainLayout>
