---
import MainLayout from '../../../layouts/MainLayout.astro';
import { updates } from '../../../data/updates';
import { format } from 'date-fns';

export async function getStaticPaths() {
    return updates.map((update, index) => ({
        params: { id: index.toString() },
        props: { update }
    }));
}

const { update } = Astro.props;

if (!update) {
    return Astro.redirect('/404');
}

const getTypeStyle = (type: string) => {
    switch (type) {
        case 'feature':
            return {
                label: 'Feature',
                badge: 'bg-blue-50 text-blue-700'
            };
        case 'improvement':
            return {
                label: 'Improvement',
                badge: 'bg-emerald-50 text-emerald-700'
            };
        case 'data':
            return {
                label: 'Data refresh',
                badge: 'bg-amber-50 text-amber-800'
            };
        case 'announcement':
            return {
                label: 'Announcement',
                badge: 'bg-slate-100 text-slate-700'
            };
        default:
            return {
                label: 'Update',
                badge: 'bg-gray-100 text-gray-700'
            };
    }
};

const style = getTypeStyle(update.type);
const paragraphs = update.text.split('\n\n').filter(Boolean);
---

<MainLayout title={`${update.title} | Dzaleka Online Services`}>
    <div class="min-h-screen bg-gray-50">
        <section class="border-b border-gray-200 bg-white">
            <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
                <nav class="text-sm text-gray-500">
                    <a href="/" class="hover:text-primary-700">Home</a>
                    <span class="mx-2">/</span>
                    <a href="/updates/1" class="hover:text-primary-700">Updates</a>
                    <span class="mx-2">/</span>
                    <span class="text-gray-900">{update.title}</span>
                </nav>

                <div class="mt-6 flex flex-wrap items-center gap-3 text-sm">
                    <span class={`rounded-full px-3 py-1 font-medium ${style.badge}`}>
                        {style.label}
                    </span>
                    <time class="text-gray-500">
                        {format(new Date(update.date), 'MMMM d, yyyy')}
                    </time>
                </div>

                <h1 class="mt-4 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">
                    {update.title}
                </h1>
                <p class="mt-4 max-w-3xl text-lg leading-8 text-gray-600">
                    {update.description}
                </p>
            </div>
        </section>

        <article class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
            <div class="rounded border border-gray-200 bg-white px-5 py-6 sm:px-8 sm:py-8">
                <div class="prose max-w-none prose-p:text-gray-700 prose-p:leading-8">
                    {paragraphs.map((paragraph) => (
                        <p>{paragraph}</p>
                    ))}
                </div>

                {update.link && update.linkText && (
                    <div class="mt-8 border-t border-gray-200 pt-6">
                        <a
                            href={update.link}
                            class="inline-flex items-center gap-2 text-sm font-semibold text-primary-700 hover:text-primary-800"
                        >
                            {update.linkText}
                            <span aria-hidden="true">→</span>
                        </a>
                    </div>
                )}
            </div>

            <div class="mt-8">
                <a
                    href="/updates/1"
                    class="inline-flex items-center gap-2 text-sm font-semibold text-gray-700 hover:text-primary-700"
                >
                    <span aria-hidden="true">←</span>
                    Back to updates
                </a>
            </div>
        </article>
    </div>
</MainLayout>
