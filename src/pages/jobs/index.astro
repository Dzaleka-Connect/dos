---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import JobCard from '../../components/jobs/JobCard.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { isJobExpired } from '../../utils/dateHelpers';
// Get URL parameters
const currentSort = Astro.url.searchParams.get('sort') || 'recent';

// Get all jobs
const allJobs = await getCollection('jobs');

// Filter active jobs (not expired and status is open)
const activeJobs = allJobs.filter(job =>
  job.data.status === 'open' && !isJobExpired(job.data.deadline)
);

// Get featured jobs
const featuredJobs = allJobs.filter(job =>
  job.data.featured && !isJobExpired(job.data.deadline) && job.data.status === 'open'
);

// Sort jobs
let paginatedJobs = [...allJobs];
paginatedJobs = paginatedJobs.sort((a, b) => {
  if (currentSort === 'recent') {
    return new Date(b.data.posted).getTime() - new Date(a.data.posted).getTime();
  } else {
    return new Date(a.data.deadline).getTime() - new Date(b.data.deadline).getTime();
  }
});

// Pagination
const jobsPerPage = 6;
const currentPage = Number(Astro.params.page) || 1;
const start = (currentPage - 1) * jobsPerPage;
const end = start + jobsPerPage;
paginatedJobs = paginatedJobs.slice(start, end);
const totalPages = Math.ceil(allJobs.length / jobsPerPage);

// Generate pagination URLs
function getPaginationUrl(page: number) {
  const basePath = '/jobs';
  const queryParams = new URLSearchParams();

  if (currentSort && currentSort !== 'recent') queryParams.set('sort', currentSort);

  const queryString = queryParams.toString();

  if (page === 1) {
    return `${basePath}${queryString ? `?${queryString}` : ''}`;
  }

  return `${basePath}/${page}${queryString ? `?${queryString}` : ''}`;
}

function getStructuredAddress(location: string) {
  const normalized = location.toLowerCase();
  const isDzalekaBased = normalized.includes('dzaleka') || normalized.includes('dowa');

  return {
    "@type": "PostalAddress",
    "streetAddress": isDzalekaBased ? "Dzaleka Refugee Camp" : location,
    "addressLocality": isDzalekaBased ? "Dzaleka" : "Malawi",
    "addressRegion": isDzalekaBased ? "Dowa" : "Malawi",
    "postalCode": isDzalekaBased ? "DZ001" : "00000",
    "addressCountry": "Malawi"
  };
}

// Create SEO metadata
const seo = {
  description: "Browse job opportunities and career resources for refugees in Dzaleka Refugee Camp. Find employment listings, training programs, and connect with employers seeking refugee talent. Support sustainable employment solutions in Malawi's largest refugee community.",
  type: "website",
  canonical: "https://services.dzaleka.com/jobs",
  openGraph: {
    description: "Browse job opportunities and career resources for refugees in Dzaleka Refugee Camp. Find employment listings, training programs, and connect with employers seeking refugee talent. Support sustainable employment solutions in Malawi's largest refugee community.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/jobs"
  },
  twitter: {
    card: "summary_large_image",
    description: "Browse job opportunities and career resources for refugees in Dzaleka Refugee Camp. Find employment listings, training programs, and connect with employers seeking refugee talent. Support sustainable employment solutions in Malawi's largest refugee community."
  }
};

// Create structured data for jobs listing
const jobsStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Job Opportunities",
  "description": "Find job opportunities and career resources for refugees in Dzaleka.",
  "url": "https://services.dzaleka.com/jobs",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://services.dzaleka.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Jobs",
        "item": "https://services.dzaleka.com/jobs"
      }
    ]
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": paginatedJobs.map((job, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "JobPosting",
        "title": job.data.title,
        "description": job.data.description,
        "datePosted": job.data.posted,
        "validThrough": job.data.deadline,
        "employmentType": job.data.type,
        "hiringOrganization": {
          "@type": "Organization",
          "name": job.data.organization
        },
        "jobLocation": {
          "@type": "Place",
          "address": getStructuredAddress(job.data.location)
        },
        "url": `https://services.dzaleka.com/jobs/${job.id}`
      }
    }))
  }
};
---

<MainLayout
  title="Community Job Board"
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(jobsStructuredData)} />

  <!-- Hero Section -->
  <div class="relative overflow-hidden border-b border-gray-200 bg-gray-900 mb-12">
    <div class="absolute inset-0 z-0">
      <img src="/images/dzaleka-hero.jpeg" alt="Dzaleka Community Job Board" class="h-full w-full object-cover" />
      <div class="absolute inset-0 bg-gray-900/65"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="max-w-3xl mx-auto text-center">
        <div class="mb-6 flex justify-center">
          <Breadcrumb items={[
            { label: 'Home', href: '/' },
            { label: 'Jobs' }
          ]} light={true} />
        </div>

        <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 tracking-tight leading-tight">
          Community Job Board
        </h1>
        <p class="text-xl text-gray-200 mb-10 max-w-2xl mx-auto leading-relaxed">
          Browse current opportunities, share vacancies, and connect Dzaleka community members with meaningful work.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#jobs-list"
            class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-sm font-medium rounded-lg text-gray-900 bg-white hover:bg-gray-50 transition-colors shadow-sm"
          >
            Browse opportunities
          </a>
          <a
            href="/jobs/post"
            class="inline-flex items-center justify-center px-6 py-3 bg-transparent text-white border border-white/30 rounded-lg hover:bg-white/10 transition-colors font-medium shadow-sm text-sm"
          >
            <svg class="mr-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 01-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            Post a job
          </a>
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-sm text-gray-100">
          <span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-4 py-1.5 font-medium">
            {activeJobs.length} active opportunities
          </span>
          <span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-4 py-1.5 font-medium">
            {featuredJobs.length} featured listings
          </span>
          <span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-4 py-1.5 font-medium">
            Sorted by {currentSort === 'deadline' ? 'deadline' : 'most recent'}
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div id="jobs-list" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 scroll-mt-24">
    <!-- Filters and Stats Row -->
    <div class="flex flex-col sm:flex-row justify-between items-center mb-8 gap-4">
      <h2 class="text-xl font-bold text-gray-900">
        {activeJobs.length} Active Opportunities
      </h2>
      
      <div class="flex items-center gap-3">
        <label for="sort-select" class="text-sm font-medium text-gray-700">Sort by:</label>
        <select
          id="sort-select"
          class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-slate-500 focus:border-slate-500 sm:text-sm rounded-lg"
          onchange="window.location.href = this.value === 'recent' ? '/jobs' : '/jobs?sort=' + this.value"
        >
          <option value="recent" selected={currentSort === 'recent'}>Most Recent</option>
          <option value="deadline" selected={currentSort === 'deadline'}>Deadline</option>
        </select>
      </div>
    </div>

    <div class="space-y-8">
      <!-- Featured Jobs -->
      {featuredJobs.length > 0 && (
        <div class="space-y-4">
          <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">Featured</h3>
          <div class="grid gap-6">
            {featuredJobs.map(job => (
              <JobCard
                job={job}
                featured={true}
                isExpired={isJobExpired(job.data.deadline)}
              />
            ))}
          </div>
        </div>
      )}

      <!-- All Jobs -->
      <div class="space-y-4">
        {featuredJobs.length > 0 && <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider">All Jobs</h3>}
        
        {paginatedJobs.length > 0 ? (
          <div class="grid gap-6">
            {paginatedJobs.map(job => (
              <JobCard
                job={job}
                isExpired={isJobExpired(job.data.deadline)}
              />
            ))}
          </div>
        ) : (
          <div class="text-center py-16 bg-gray-50 border-y border-dashed border-gray-200">
            <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <h3 class="text-lg font-medium text-gray-900 mb-1">No jobs found</h3>
            <p class="text-gray-500">Check back later for new opportunities</p>
          </div>
        )}
      </div>

      {/* Pagination */}
      {totalPages > 1 && (
        <nav class="mt-12 flex items-center justify-center border-t border-gray-200 pt-8" aria-label="Pagination">
          <div class="flex gap-2">
            <a
              href={currentPage > 1 ? getPaginationUrl(currentPage - 1) : '#'}
              class={`inline-flex items-center px-4 py-2 text-sm font-medium border border-gray-200 transition-colors ${
                currentPage === 1
                  ? 'text-gray-400 cursor-not-allowed'
                  : 'text-gray-700 hover:bg-gray-50'
              }`}
              aria-disabled={currentPage === 1}
            >
              Previous
            </a>

            {Array.from({ length: totalPages }, (_, i) => i + 1).map(page => (
              <a
                href={getPaginationUrl(page)}
                class={`inline-flex items-center px-4 py-2 text-sm font-medium border border-gray-200 transition-colors ${
                  currentPage === page
                    ? 'bg-gray-900 text-white'
                    : 'text-gray-700 hover:bg-gray-50'
                }`}
                aria-current={currentPage === page ? 'page' : undefined}
              >
                {page}
              </a>
            ))}

            <a
              href={currentPage < totalPages ? getPaginationUrl(currentPage + 1) : '#'}
              class={`inline-flex items-center px-4 py-2 text-sm font-medium border border-gray-200 transition-colors ${
                currentPage === totalPages
                  ? 'text-gray-400 cursor-not-allowed'
                  : 'text-gray-700 hover:bg-gray-50'
              }`}
              aria-disabled={currentPage === totalPages}
            >
              Next
            </a>
          </div>
        </nav>
      )}
    </div>
  </div>
</MainLayout>
