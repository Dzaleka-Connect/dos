---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../utils/dateHelpers';

export async function getStaticPaths() {
  const jobs = await getCollection('jobs');
  return jobs.map(job => ({
    params: { slug: job.id },
    props: { job }
  }));
}

const { job } = Astro.props;
const { Content } = await render(job);

// Check if job is closed
const currentDate = new Date();
const isExpired = new Date(job.data.deadline) < currentDate;
const isClosed = job.data.status === 'closed' || isExpired;

// Get related jobs
const allJobs = await getCollection('jobs');
const relatedJobs = allJobs
  .filter(j => 
    j.id !== job.id && 
    !isClosed &&
    (j.data.category === job.data.category || j.data.type === job.data.type)
  )
  .slice(0, 3);

// Create SEO metadata
const seo = {
  description: `${job.data.title} at ${job.data.organization} - ${job.data.description?.substring(0, 150)}...`,
  type: "article",
  canonical: `https://services.dzaleka.com/jobs/${job.id}`,
  openGraph: {
    title: `${job.data.title}`,
    description: `${job.data.title} at ${job.data.organization} - ${job.data.description?.substring(0, 150)}...`,
    type: "article",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/jobs/${job.id}`
  },
  twitter: {
    card: "summary_large_image",
    title: `${job.data.title} | Dzaleka Online Services`,
    description: `${job.data.title} at ${job.data.organization} - ${job.data.description?.substring(0, 150)}...`
  }
};

const parsedSalary = job.data.salary?.replace(/[^0-9.]/g, '');

// Create structured data for the job posting
const jobStructuredData = {
  "@context": "https://schema.org",
  "@type": "JobPosting",
  "title": job.data.title,
  "description": job.data.description,
  "datePosted": job.data.posted,
  "validThrough": job.data.deadline,
  "employmentType": job.data.type,
  "hiringOrganization": {
    "@type": "Organization",
    "name": job.data.organization
  },
  "jobLocation": {
    "@type": "Place",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": job.data.location.includes("Dzaleka") ? "Dzaleka Refugee Camp" : job.data.location,
      "addressLocality": "Dzaleka",
      "addressRegion": "Dowa",
      "postalCode": "DZ001",
      "addressCountry": "Malawi"
    }
  },
  "applicationRequirements": job.data.skills?.join(", "),
  "baseSalary": parsedSalary ? {
    "@type": "MonetaryAmount",
    "currency": "MWK",
    "value": {
      "@type": "QuantitativeValue",
      "value": parsedSalary,
      "unitText": "MONTH"
    }
  } : undefined,
  "url": `https://services.dzaleka.com/jobs/${job.id}`
};

// Create breadcrumb structured data
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://services.dzaleka.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Jobs",
      "item": "https://services.dzaleka.com/jobs"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": job.data.title,
      "item": `https://services.dzaleka.com/jobs/${job.id}`
    }
  ]
};
---

<MainLayout 
  title={job.data.title}
  description={seo.description} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(jobStructuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  
  <!-- Hero Section -->
  <div class="relative overflow-hidden bg-primary-50 border-b border-primary-100">
    <div class="absolute inset-0 opacity-[0.03]">
      <div class="absolute inset-0 pattern-mudcloth"></div>
    </div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 py-12 sm:py-16 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <div class="flex items-center justify-center mb-8">
          <a 
            href="/jobs" 
            class="inline-flex items-center text-sm font-medium text-primary-600 hover:text-primary-700 transition-colors"
          >
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to Jobs
          </a>
        </div>
        
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4 tracking-tight">{job.data.title}</h1>
        <p class="text-xl text-gray-600 mb-8">{job.data.organization}</p>
        
        {isClosed ? (
          <div class="inline-flex items-center px-4 py-2 rounded-lg bg-gray-100 text-gray-600 border border-gray-200">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m0 0v2m0-2h2m-2 0H8m13 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            This position is no longer accepting applications
          </div>
        ) : (
          <div class="flex flex-wrap justify-center gap-4">
            <a 
              href={`mailto:${job.data.contact.email}?subject=Application for ${job.data.title}`}
              class="inline-flex items-center px-8 py-3 border border-transparent rounded-xl text-base font-medium text-white bg-primary-600 hover:bg-primary-700 shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5"
            >
              Apply Now
            </a>
            {job.data.contact.website && (
              <a 
                href={job.data.contact.website}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center px-8 py-3 border border-gray-300 rounded-xl text-base font-medium text-gray-700 bg-white hover:bg-gray-50 shadow-sm transition-colors"
              >
                Visit Website
              </a>
            )}
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Job Content -->
  <div class="max-w-7xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Sidebar -->
      <div class="lg:col-span-1 lg:order-2 space-y-8">
        <!-- Job Overview -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="p-6">
            <h3 class="text-lg font-bold text-gray-900 mb-6 border-b border-gray-100 pb-4">Job Overview</h3>
            <dl class="space-y-5">
              <div>
                <dt class="text-sm font-medium text-gray-500 mb-1">Status</dt>
                <dd>
                  <span class:list={[
                    'inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium',
                    isClosed 
                      ? 'bg-gray-100 text-gray-800'
                      : 'bg-green-100 text-green-800'
                  ]}>
                    {isClosed ? 'Closed' : 'Open'}
                  </span>
                </dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500 mb-1">Location</dt>
                <dd class="text-sm text-gray-900 font-medium">{job.data.location}</dd>
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-1">Job Type</dt>
                  <dd>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 capitalize">
                      {job.data.type}
                    </span>
                  </dd>
                </div>
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-1">Category</dt>
                  <dd>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700 capitalize">
                      {job.data.category}
                    </span>
                  </dd>
                </div>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500 mb-1">Posted</dt>
                <dd class="text-sm text-gray-900">{formatDate(job.data.posted)}</dd>
              </div>
              <div>
                <dt class="text-sm font-medium text-gray-500 mb-1">Deadline</dt>
                <dd class:list={[
                  'text-sm font-medium',
                  isExpired ? 'text-red-600' : 'text-gray-900'
                ]}>
                  {formatDate(job.data.deadline)}
                  {isExpired && ' (Expired)'}
                </dd>
              </div>
              {job.data.skills && (
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-2">Required Skills</dt>
                  <dd>
                    <div class="flex flex-wrap gap-2">
                      {job.data.skills.map(skill => (
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary-50 text-primary-700 border border-primary-100">
                          {skill}
                        </span>
                      ))}
                    </div>
                  </dd>
                </div>
              )}
            </dl>
          </div>
        </div>

        <!-- Contact Information -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="p-6">
            <h3 class="text-lg font-bold text-gray-900 mb-6 border-b border-gray-100 pb-4">Contact Information</h3>
            <dl class="space-y-4">
              <div>
                <dt class="text-sm font-medium text-gray-500 mb-1">Email</dt>
                <dd class="text-sm">
                  <a href={`mailto:${job.data.contact.email}`} class="text-primary-600 hover:text-primary-700 font-medium break-all">
                    {job.data.contact.email}
                  </a>
                </dd>
              </div>
              {job.data.contact.phone && (
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-1">Phone</dt>
                  <dd class="text-sm">
                    <a href={`tel:${job.data.contact.phone}`} class="text-primary-600 hover:text-primary-700 font-medium">
                      {job.data.contact.phone}
                    </a>
                  </dd>
                </div>
              )}
              {job.data.contact.website && (
                <div>
                  <dt class="text-sm font-medium text-gray-500 mb-1">Website</dt>
                  <dd class="text-sm">
                    <a 
                      href={job.data.contact.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary-600 hover:text-primary-700 font-medium break-all"
                    >
                      {new URL(job.data.contact.website).hostname}
                    </a>
                  </dd>
                </div>
              )}
            </dl>
          </div>
        </div>

        <!-- How to Apply -->
        {!isClosed && (
          <div class="bg-primary-50 rounded-xl border border-primary-100 overflow-hidden">
            <div class="p-6">
              <h3 class="text-lg font-bold text-gray-900 mb-4">How to Apply</h3>
              <div class="text-sm text-gray-600 space-y-4">
                {job.data.title === "Social Media Content Creator" && (
                  <>
                    <p>Send the following to <span class="font-medium text-gray-900">{job.data.contact.email}</span> by {formatDate(job.data.deadline)}:</p>
                    <ul class="list-disc list-inside space-y-1 pl-1">
                      <li>30-60 second reel on refugees in Malawi</li>
                      <li>Your portfolio</li>
                      <li>Proposed fee structure</li>
                    </ul>
                  </>
                )}
                {job.data.title === "Programs Manager" && (
                  <>
                    <p>Submit your application to <span class="font-medium text-gray-900">{job.data.contact.email}</span> by {formatDate(job.data.deadline)}:</p>
                    <ul class="list-disc list-inside space-y-1 pl-1">
                      <li>Cover letter</li>
                      <li>CV (not more than two pages)</li>
                    </ul>
                    <p class="text-xs italic mt-2 text-gray-500">This position is open to Malawian nationals only.</p>
                  </>
                )}
                {job.data.title === "Language Exchange Program" && (
                  <p>For more information contact Emily from Refugee Outreach Collective at <span class="font-medium text-gray-900">{job.data.contact.email}</span></p>
                )}
                {!["Social Media Content Creator", "Programs Manager", "Language Exchange Program"].includes(job.data.title) && (
                  <p>To apply, please send your application to <span class="font-medium text-gray-900">{job.data.contact.email}</span></p>
                )}
                <a 
                  href={`mailto:${job.data.contact.email}?subject=Application for ${job.data.title}`}
                  class="mt-6 block w-full text-center px-4 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-700 font-medium hover:bg-gray-50 hover:text-primary-600 transition-colors shadow-sm"
                >
                  Send Application
                </a>
              </div>
            </div>
          </div>
        )}
      </div>

      <!-- Main Content -->
      <div class="lg:col-span-2 lg:order-1">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="p-8">
            <!-- Job Description -->
            <div class="prose prose-lg prose-blue max-w-none text-gray-600">
              <Content />
            </div>
          </div>
        </div>

        <!-- Related Jobs -->
        {relatedJobs.length > 0 && (
          <div class="mt-12">
            <h2 class="text-xl font-bold text-gray-900 mb-6">Similar Opportunities</h2>
            <div class="grid gap-6 sm:grid-cols-2">
              {relatedJobs.map(relatedJob => (
                <a 
                  href={`/jobs/${relatedJob.id}`}
                  class="group block bg-white p-6 rounded-xl shadow-sm border border-gray-100 hover:border-primary-200 hover:shadow-md transition-all duration-200"
                >
                  <h3 class="text-lg font-bold text-gray-900 group-hover:text-primary-600 transition-colors mb-2">{relatedJob.data.title}</h3>
                  <p class="text-sm text-gray-500 mb-4">{relatedJob.data.organization}</p>
                  <div class="flex items-center text-sm text-gray-400">
                    <span class="bg-gray-50 text-gray-600 px-2 py-1 rounded text-xs font-medium">{relatedJob.data.type}</span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</MainLayout>
