---
import { getContent } from '../../lib/content';
import { getEntry } from '@dos/news';
import { jobsPage, jobsSort } from '../../lib/jobs-pages';
import JobDetail from '../../components/jobs/JobDetail.astro';
import JobsListing from '../../components/jobs/JobsListing.astro';

// Built as static pages while jobs are Markdown; rendered on request once they are live in the CMS.
export async function getStaticPaths() {
  const jobs = await getContent('jobs');
  return jobs.map(job => ({
    params: { slug: job.id },
    props: { job }
  }));
}

const slug = Astro.params.slug || '';
let job = Astro.props.job;
let page = null;
let isPreview = false;
let allJobs: any[] = [];
const sort = Astro.isPrerendered ? 'recent' : jobsSort(Astro.url.searchParams.get('sort'));
if (!job && /^\d+$/.test(slug)) {
  // On request, /jobs/2 reaches this route before the listing route.
  allJobs = await getContent('jobs');
  page = jobsPage(allJobs, Number(slug), sort);
  if (!page) return new Response('Page not found', { status: 404 });
} else {
  if (!job) {
    const result = await getEntry('jobs', slug);
    job = result.entry;
    isPreview = result.isPreview;
  }
  if (!job) return new Response('Job not found', { status: 404 });
}
if (isPreview) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}
---
{page ? <JobsListing page={page} allJobs={allJobs} sort={sort} /> : <JobDetail job={job} isPreview={isPreview} />}
