---
import { getContent } from '../../lib/content';
import { jobsPage, jobsPageSize, sortJobsForListing } from '../../lib/jobs-pages';
import JobsListing from '../../components/jobs/JobsListing.astro';

// Built as static pages while jobs are Markdown; rendered on request once they are live in the CMS.
export async function getStaticPaths({ paginate }) {
  return paginate(sortJobsForListing(await getContent('jobs')), { pageSize: jobsPageSize });
}

const allJobs = await getContent('jobs');
const page = Astro.props.page ?? jobsPage(allJobs, Astro.params.page ? Number(Astro.params.page) : 1);
if (!page) return new Response('Page not found', { status: 404 });
---
<JobsListing page={page} allJobs={allJobs} />
