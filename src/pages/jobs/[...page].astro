---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import JobCard from '../../components/jobs/JobCard.astro';
import { isJobExpired } from '../../utils/dateHelpers';

export async function getStaticPaths({ paginate }) {
  const allJobs = await getCollection('jobs');
  
  // Sort jobs based on URL parameter
  const sortedJobs = [...allJobs].sort((a, b) => {
    return new Date(b.data.posted).getTime() - new Date(a.data.posted).getTime();
  });
  
  return paginate(sortedJobs, { pageSize: 6 });
}

const { page } = Astro.props;
const currentSort = Astro.url.searchParams.get('sort') || 'recent';

// Get all jobs for count
const allJobs = await getCollection('jobs');
const activeJobs = allJobs.filter(job => 
  job.data.status === 'open' && !isJobExpired(job.data.deadline)
);

// Sort jobs
let sortedJobs = [...page.data];
sortedJobs = sortedJobs.sort((a, b) => {
  if (currentSort === 'recent') {
    return new Date(b.data.posted).getTime() - new Date(a.data.posted).getTime();
  } else {
    return new Date(a.data.deadline).getTime() - new Date(b.data.deadline).getTime();
  }
});

// Generate pagination URLs
function getPaginationUrl(pageNum: number) {
  const basePath = '/jobs';
  const queryParams = new URLSearchParams();
  
  if (currentSort && currentSort !== 'recent') {
    queryParams.set('sort', currentSort);
  }
  
  const queryString = queryParams.toString();
  
  if (pageNum === 1) {
    return `${basePath}${queryString ? `?${queryString}` : ''}`;
  }
  
  return `${basePath}/${pageNum}${queryString ? `?${queryString}` : ''}`;
}
---

<MainLayout title="Community Job Board">
  <!-- Hero Section -->
  <div class="relative overflow-hidden bg-slate-50">
    <div class="absolute inset-0 opacity-[0.03]">
      <div class="absolute inset-0 pattern-mudcloth"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto text-center pt-12 pb-16 px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-6 tracking-tight">
        Community Job Board
      </h1>
      <p class="text-lg sm:text-xl text-gray-600 mb-8 max-w-2xl mx-auto leading-relaxed">
        Discover meaningful work and build your career within the Dzaleka community
      </p>
      
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="/jobs/post"
          class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-xl text-white bg-gray-900 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500 transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
        >
          <svg class="-ml-1 mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
          Post a Job
        </a>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Filters and Stats Row -->
    <div class="flex flex-col sm:flex-row justify-between items-center mb-8 gap-4">
      <h2 class="text-xl font-bold text-gray-900">
        {activeJobs.length} Active Opportunities
      </h2>
      
      <div class="flex items-center gap-3">
        <label for="sort-select" class="text-sm font-medium text-gray-700">Sort by:</label>
        <select
          id="sort-select"
          class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-slate-500 focus:border-slate-500 sm:text-sm rounded-lg"
          onchange="window.location.href = this.value === 'recent' ? '/jobs' : '/jobs?sort=' + this.value"
        >
          <option value="recent" selected={currentSort === 'recent'}>Most Recent</option>
          <option value="deadline" selected={currentSort === 'deadline'}>Deadline</option>
        </select>
      </div>
    </div>

    <div class="space-y-8">
      <!-- Jobs List -->
      <div class="space-y-4">
        <div class="grid gap-6">
          {sortedJobs.map(job => (
            <JobCard 
              job={job}
              isExpired={isJobExpired(job.data.deadline)}
            />
          ))}
        </div>

        {sortedJobs.length === 0 && (
          <div class="text-center py-16 bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
            <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <h3 class="text-lg font-medium text-gray-900 mb-1">No jobs found</h3>
            <p class="text-gray-500">Check back later for new opportunities</p>
          </div>
        )}
      </div>

      {/* Pagination */}
      {page.lastPage > 1 && (
        <nav class="mt-12 flex items-center justify-center border-t border-gray-200 pt-8" aria-label="Pagination">
          <div class="flex gap-2">
            <a
              href={page.url.prev ? getPaginationUrl(page.currentPage - 1) : '#'}
              class={`inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg transition-colors ${
                !page.url.prev
                  ? 'text-gray-400 cursor-not-allowed'
                  : 'text-gray-700 hover:bg-gray-50'
              }`}
              aria-disabled={!page.url.prev}
            >
              Previous
            </a>

            {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(pageNum => (
              <a
                href={getPaginationUrl(pageNum)}
                class={`inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg transition-colors ${
                  page.currentPage === pageNum
                    ? 'bg-gray-900 text-white'
                    : 'text-gray-700 hover:bg-gray-50'
                }`}
                aria-current={page.currentPage === pageNum ? 'page' : undefined}
              >
                {pageNum}
              </a>
            ))}

            <a
              href={page.url.next ? getPaginationUrl(page.currentPage + 1) : '#'}
              class={`inline-flex items-center px-4 py-2 text-sm font-medium rounded-lg transition-colors ${
                !page.url.next
                  ? 'text-gray-400 cursor-not-allowed'
                  : 'text-gray-700 hover:bg-gray-50'
              }`}
              aria-disabled={!page.url.next}
            >
              Next
            </a>
          </div>
        </nav>
      )}
    </div>
  </div>
</MainLayout>
