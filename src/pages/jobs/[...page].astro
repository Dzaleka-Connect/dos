---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import JobCard from '../../components/jobs/JobCard.astro';
import { isJobExpired } from '../../utils/dateHelpers';

export async function getStaticPaths({ paginate }) {
  const allJobs = await getCollection('jobs');
  
  // Open listings first, closed after, each by most recent
  const isOpen = (job: any) => job.data.status === 'open' && !isJobExpired(job.data.deadline);
  const sortedJobs = [...allJobs].sort((a, b) => {
    if (isOpen(a) !== isOpen(b)) return isOpen(a) ? -1 : 1;
    return new Date(b.data.posted).getTime() - new Date(a.data.posted).getTime();
  });
  
  return paginate(sortedJobs, { pageSize: 6 });
}

const { page } = Astro.props;
const currentSort = Astro.url.searchParams.get('sort') || 'recent';

// Get all jobs for count
const allJobs = await getCollection('jobs');
const activeJobs = allJobs.filter(job => 
  job.data.status === 'open' && !isJobExpired(job.data.deadline)
);

// Sort jobs
let sortedJobs = [...page.data];
sortedJobs = sortedJobs.sort((a, b) => {
  if (currentSort === 'recent') {
    return new Date(b.data.posted).getTime() - new Date(a.data.posted).getTime();
  } else {
    const dateA = a.data.deadline ? new Date(a.data.deadline).getTime() : Infinity;
    const dateB = b.data.deadline ? new Date(b.data.deadline).getTime() : Infinity;
    return dateA - dateB;
  }
});

// Generate pagination URLs
function getPaginationUrl(pageNum: number) {
  const basePath = '/jobs';
  const queryParams = new URLSearchParams();
  
  if (currentSort && currentSort !== 'recent') {
    queryParams.set('sort', currentSort);
  }
  
  const queryString = queryParams.toString();
  
  if (pageNum === 1) {
    return `${basePath}${queryString ? `?${queryString}` : ''}`;
  }
  
  return `${basePath}/${pageNum}${queryString ? `?${queryString}` : ''}`;
}
---

<MainLayout title="Community Job Board">
  <!-- Header Section -->
  <section class="border-b border-gray-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8">
      <div class="mb-6 flex flex-wrap items-center gap-2 text-sm font-medium text-slate-500">
        <a href="/" class="hover:text-slate-900">Home</a>
        <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span class="text-slate-900">Jobs</span>
      </div>

      <div class="mt-6 flex flex-col md:flex-row md:items-start md:justify-between gap-6">
        <div class="max-w-2xl">
          <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
            Community Job Board
          </h1>
          <p class="mt-3 text-lg leading-8 text-gray-600">
            Browse current opportunities, share vacancies, and connect Dzaleka community members with meaningful work.
          </p>
        </div>

        <div class="shrink-0">
          <a
            href="/jobs/post"
            class="inline-flex items-center justify-center rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-800"
          >
            Post a job
          </a>
        </div>
      </div>
      
      <div class="mt-8 flex flex-wrap items-center gap-3 text-sm text-gray-600">
        <span class="inline-flex items-center rounded-full bg-slate-100 px-3 py-1 font-medium text-slate-800">
          {activeJobs.length} active opportunities
        </span>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Filters and Stats Row -->
    <div class="flex flex-col sm:flex-row justify-between items-center mb-8 gap-4 border-b border-gray-200 pb-4">
      <h2 class="text-xl font-bold text-gray-900">
        Job listings
        <span class="ml-2 text-sm font-medium text-gray-500">{activeJobs.length} active {activeJobs.length === 1 ? 'opportunity' : 'opportunities'}</span>
      </h2>
      
      <div class="flex items-center gap-3">
        <label for="sort-select" class="text-sm font-medium text-gray-700">Sort by:</label>
        <select
          id="sort-select"
          class="block w-48 pl-3 pr-10 py-2 text-sm border-gray-300 focus:outline-none focus:ring-slate-500 focus:border-slate-500 rounded-lg"
          onchange="window.location.href = this.value === 'recent' ? '/jobs' : '/jobs?sort=' + this.value"
        >
          <option value="recent" selected={currentSort === 'recent'}>Most Recent</option>
          <option value="deadline" selected={currentSort === 'deadline'}>Deadline</option>
        </select>
      </div>
    </div>

    <div class="space-y-8">
      <!-- Jobs List -->
      <div class="space-y-4">
        <div class="flex flex-col gap-4">
          {sortedJobs.map(job => (
            <JobCard 
              job={job}
              isExpired={isJobExpired(job.data.deadline)}
            />
          ))}
        </div>

        {sortedJobs.length === 0 && (
          <div class="text-center py-16 bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
            <svg class="mx-auto h-12 w-12 text-gray-400 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <h3 class="text-lg font-medium text-gray-900 mb-1">No jobs found</h3>
            <p class="text-gray-500">Check back later for new opportunities</p>
          </div>
        )}
      </div>

      {/* Pagination */}
      {page.lastPage > 1 && (
        <div class="mt-12 flex items-center justify-between border-t border-gray-200 px-4 py-6 sm:px-0">
          <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
            <div>
              <p class="text-sm text-gray-700">
                Showing <span class="font-medium">{page.start + 1}</span> to <span class="font-medium">{page.end + 1}</span> of{' '}
                <span class="font-medium">{page.total}</span> results
              </p>
            </div>
            <div>
              <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                <a
                  href={page.url.prev ? getPaginationUrl(page.currentPage - 1) : '#'}
                  class={`relative inline-flex items-center rounded-l-md px-2 py-2 ring-1 ring-inset ring-gray-300 focus:z-20 focus:outline-offset-0 ${
                    !page.url.prev ? 'text-gray-300 cursor-not-allowed pointer-events-none' : 'text-gray-400 hover:bg-gray-50'
                  }`}
                  aria-disabled={!page.url.prev}
                >
                  <span class="sr-only">Previous</span>
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
                  </svg>
                </a>
                
                {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(pageNum => (
                  <a
                    href={getPaginationUrl(pageNum)}
                    class={`relative inline-flex items-center px-4 py-2 text-sm font-semibold ring-1 ring-inset ring-gray-300 focus:z-20 focus:outline-offset-0 ${
                      page.currentPage === pageNum
                        ? 'z-10 bg-gray-900 text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900'
                        : 'text-gray-900 hover:bg-gray-50'
                    }`}
                    aria-current={page.currentPage === pageNum ? 'page' : undefined}
                  >
                    {pageNum}
                  </a>
                ))}

                <a
                  href={page.url.next ? getPaginationUrl(page.currentPage + 1) : '#'}
                  class={`relative inline-flex items-center rounded-r-md px-2 py-2 ring-1 ring-inset ring-gray-300 focus:z-20 focus:outline-offset-0 ${
                    !page.url.next ? 'text-gray-300 cursor-not-allowed pointer-events-none' : 'text-gray-400 hover:bg-gray-50'
                  }`}
                  aria-disabled={!page.url.next}
                >
                  <span class="sr-only">Next</span>
                  <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                  </svg>
                </a>
              </nav>
            </div>
          </div>
          <div class="flex flex-1 justify-between sm:hidden">
            <a
              href={page.url.prev ? getPaginationUrl(page.currentPage - 1) : '#'}
              class={`relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 ${!page.url.prev ? 'pointer-events-none opacity-50' : ''}`}
            >
              Previous
            </a>
            <a
              href={page.url.next ? getPaginationUrl(page.currentPage + 1) : '#'}
              class={`relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 ${!page.url.next ? 'pointer-events-none opacity-50' : ''}`}
            >
              Next
            </a>
          </div>
        </div>
      )}
    </div>
  </div>
</MainLayout>
