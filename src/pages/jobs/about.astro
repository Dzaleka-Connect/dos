---
import MainLayout from '../../layouts/MainLayout.astro';

// Create SEO metadata
const seo = {
  description: "About the Dzaleka Community Job Board: what it lists, who can post, and how to report a job that is not as advertised.",
  type: "website",
  canonical: "https://services.dzaleka.com/jobs/about",
  openGraph: {
    description: "About the Dzaleka Community Job Board: what it lists, who can post, and how to report a job that is not as advertised.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/jobs/about"
  },
  twitter: {
    card: "summary",
    description: "About the Dzaleka Community Job Board: what it lists, who can post, and how to report a job that is not as advertised."
  }
};

// Create structured data for the about page
const aboutStructuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Community Job Board",
  "description": "About the Dzaleka Community Job Board and how it works.",
  "url": "https://services.dzaleka.com/jobs/about",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://services.dzaleka.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Jobs",
        "item": "https://services.dzaleka.com/jobs"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "About",
        "item": "https://services.dzaleka.com/jobs/about"
      }
    ]
  },
  "mainEntity": {
    "@type": "Organization",
    "name": "Dzaleka Community Job Board",
    "description": "A platform connecting refugees in Dzaleka with employment opportunities.",
    "url": "https://services.dzaleka.com/jobs",
    "sameAs": [
      "https://services.dzaleka.com"
    ]
  }
};
---

<MainLayout
  title="About Community Job Board"
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutStructuredData)} />

  <div class="min-h-screen bg-white">
    <div class="bg-white py-4 px-4 sm:px-6 lg:px-8 border-b">
      <div class="max-w-7xl mx-auto">
        <a href="/jobs" class="inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700">
          <svg class="mr-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M7.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
          Back to Jobs
        </a>
      </div>
    </div>
    <!-- Header -->
    <div class="bg-gray-900 py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl font-bold text-white mb-4">About Community Job Board</h1>
        <p class="text-xl text-white/90">
          Jobs, training and volunteer roles for people living in and around Dzaleka
        </p>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <!-- Mission & Vision -->
      <div class="space-y-12 mb-16">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Our mission</h2>
          <p class="text-lg text-gray-600">
            To help people in Dzaleka find paid work, training and volunteer roles, and to help
            organisations reach the people they want to hire.
          </p>
        </div>

        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Our vision</h2>
          <p class="text-lg text-gray-600">
            Anyone in Dzaleka who is looking for work can see the openings in one place, in plain language,
            with a clear way to apply.
          </p>
        </div>
      </div>

      <!-- What We Do -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">What we do</h2>
        <div class="grid gap-8 md:grid-cols-2">
          <div class="bg-gray-50 p-5 sm:p-8 rounded">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">For job seekers</h3>
            <ul class="space-y-4">
              <li class="flex items-center">
                <svg class="w-5 h-5 text-slate-700 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Browse current openings</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-slate-700 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Find skills training</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-slate-700 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Find vocational courses</span>
              </li>
            </ul>
          </div>

          <div class="bg-gray-50 p-5 sm:p-8 rounded">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">For organisations</h3>
            <ul class="space-y-4">
              <li class="flex items-center">
                <svg class="w-5 h-5 text-slate-700 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Post a job</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-slate-700 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Reach people with the skills you need</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-slate-700 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Share training and internships</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Notice -->
      <div class="bg-amber-50 p-5 sm:p-8 rounded">
        <h2 class="text-xl font-semibold text-amber-800 mb-4">Report a problem with a job</h2>
        <p class="text-amber-700">
          This page provides information as a courtesy to those seeking community service opportunities.
          If you find that a position posted on this site is not as advertised, notify the
          Dzaleka Online Service team at
          <a href="mailto:dzalekaconnect@gmail.com" class="text-amber-800 underline">dzalekaconnect@gmail.com</a>.
        </p>
      </div>

      <!-- CTA -->
      <div class="mt-16 text-center">
        <div class="space-x-4">
          <a href="/jobs" class="min-h-[44px] inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded text-white bg-primary-900 hover:bg-primary-800">
            Browse Jobs
          </a>
          <a href="/jobs/post" class="min-h-[44px] inline-flex items-center px-6 py-3 border border-gray-900 text-base font-medium rounded text-slate-700 hover:bg-slate-50">
            Post a Job
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
