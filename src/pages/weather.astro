<style>
  /* Base styles */
  .prose {
    max-width: 65ch;
    margin: 0 auto;
  }

  /* Weather update styles */
  #weather-update {
    @apply transition-all duration-300;
  }

  #weather-update.loading {
    @apply opacity-75;
  }

  /* Responsive improvements */
  @media (max-width: 640px) {
    .weather-grid {
      @apply grid-cols-1 gap-4;
    }
    
    .weather-table {
      @apply text-sm;
    }
    
    .weather-table th,
    .weather-table td {
      @apply px-2 py-2;
    }
  }
</style>

<script>
  // Update weather function
  async function updateWeather() {
    const weatherUpdate = document.getElementById('weather-update');
    weatherUpdate.classList.add('loading');
    
    try {
      const [weatherResponse, alertsResponse] = await Promise.all([
        fetch('/api/weather'),
        fetch('/api/weather-alerts')
      ]);
      
      const weatherData = await weatherResponse.json();
      const alertsData = await alertsResponse.json();
      
      // Update values
      const updateValue = (id, value) => {
        const element = document.getElementById(id);
        if (element) {
          element.textContent = value || 'Unknown';
        }
      };

      // Update weather values
      updateValue('current-temp', weatherData.forecast.current.temperature);
      updateValue('max-temp', weatherData.forecast.current.maxTemp);
      updateValue('min-temp', weatherData.forecast.current.minTemperature);
      updateValue('current-wind', weatherData.forecast.current.windSpeed);
      updateValue('wind-direction', weatherData.forecast.current.windDirection);
      updateValue('current-rainfall', weatherData.forecast.current.rainfall);
      updateValue('rainfall-24h', weatherData.forecast.current.rainfall);
      updateValue('rainfall-prob', weatherData.forecast.current.rainfall > 0 ? 'High' : 'Low');
      updateValue('weather-condition', weatherData.forecast.current.condition || 'Unknown');
      updateValue('last-updated', new Date(weatherData.lastUpdated).toLocaleTimeString());

      // Update alerts
      const alertsContainer = document.querySelector('.weather-alerts');
      if (alertsContainer) {
        if (alertsData.length > 0) {
          const alertsHTML = alertsData.slice(0, 2).map(alert => `
            <div class="p-3 rounded-lg border alert-item ${
              alert.type === 'severe' ? 'bg-red-500/20 border-red-500' :
              alert.type === 'warning' ? 'bg-yellow-500/20 border-yellow-500' :
              'bg-blue-500/20 border-blue-500'
            }">
              <div class="flex items-start space-x-3">
                <div class="flex-shrink-0">
                  ${alert.type === 'severe' ? 
                    '<i class="fas fa-exclamation-triangle text-red-400"></i>' :
                    alert.type === 'warning' ? 
                    '<i class="fas fa-exclamation-circle text-yellow-400"></i>' :
                    '<i class="fas fa-info-circle text-blue-400"></i>'
                  }
                </div>
                <div class="flex-1">
                  <h4 class="text-white text-sm font-semibold mb-1">${alert.title}</h4>
                  <p class="text-white/80 text-xs">${alert.description}</p>
                </div>
              </div>
            </div>
          `).join('');
          
          alertsContainer.innerHTML = alertsHTML;
        } else {
          alertsContainer.innerHTML = `
            <div class="p-3 rounded-lg border border-blue-500/20 bg-blue-500/10">
              <div class="flex items-center space-x-3">
                <i class="fas fa-check-circle text-blue-400"></i>
                <p class="text-white text-sm">No active weather alerts at this time.</p>
              </div>
            </div>
          `;
        }
      }
    } catch (error) {
      console.error('Error updating weather:', error);
    } finally {
      weatherUpdate.classList.remove('loading');
    }
  }

  // Update weather every 5 minutes
  setInterval(updateWeather, 5 * 60 * 1000);

  // Initial update after 5 minutes
  setTimeout(updateWeather, 5 * 60 * 1000);
</script> 