                <div key={index} 
                     class={`p-4 rounded-xl backdrop-blur-sm border transition-all duration-300 alert-item ${
                       alert.type === 'severe' ? 'bg-red-500/20 border-red-500' :
                       alert.type === 'warning' ? 'bg-yellow-500/20 border-yellow-500' :
