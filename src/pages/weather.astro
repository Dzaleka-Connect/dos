// Fetch real-time weather data
const fetchWeatherData = async () => {
  try {
    // Fetch daily forecast for Dowa district with full URL
    const response = await fetch('https://www.metmalawi.gov.mw/weather/daily-table/dowa/', {
      headers: {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
      }
    });
    const html = await response.text();
    
    // Extract location and date information
    const locationRegex = /<h2[^>]*>([^<]+)<\/h2>/;
    const locationMatch = html.match(locationRegex);
    const location = locationMatch ? locationMatch[1].trim() : 'Dowa';
    
    // Extract date information
    const dateRegex = /<h5[^>]*>([^<]+)<\/h5>/;
    const dateMatch = html.match(dateRegex);
    const date = dateMatch ? dateMatch[1].trim() : new Date().toLocaleDateString();
    
    // Extract the first day's forecast table
    const tableRegex = /<table[^>]*>([\s\S]*?)<\/table>/;
    const tableMatch = html.match(tableRegex);
    
    if (!tableMatch) {
      throw new Error('Weather data table not found');
    }

    // Extract rows from the table
    const rowRegex = /<tr[^>]*>([\s\S]*?)<\/tr>/g;
    const rows = tableMatch[1].match(rowRegex) || [];
    
    // Skip header row and get first data row
    const firstDataRow = rows[1];
    if (!firstDataRow) {
      throw new Error('Weather data not available');
    }

    // Extract cell data
    const cellRegex = /<td[^>]*>([\s\S]*?)<\/td>/g;
    const cells = firstDataRow.match(cellRegex) || [];
    
    // Clean cell content
    const cleanCell = (cell) => {
      return cell
        .replace(/<[^>]*>/g, '') // Remove HTML tags
        .replace(/&nbsp;/g, ' ') // Replace &nbsp; with space
        .replace(/\s+/g, ' ') // Replace multiple spaces with single space
        .replace(/°C/g, '') // Remove °C
        .replace(/km\/h/g, '') // Remove km/h
        .replace(/mm/g, '') // Remove mm
        .replace(/°/g, '') // Remove degree symbol
        .trim();
    };

    // Extract weather condition from image src
    const getWeatherCondition = (cell) => {
      // Try to get from image src
      const imgRegex = /<img[^>]*src="[^"]*\/([^"]+)"[^>]*>/;
      const imgMatch = cell.match(imgRegex);
      if (imgMatch) {
        const imgName = imgMatch[1].toLowerCase();
        // Map image names to conditions
        const conditionMap = {
          'clearsky': 'Clear Sky',
          'partly_cloudy': 'Partly Cloudy',
          'cloudy': 'Cloudy',
          'overcast': 'Overcast',
          'rain': 'Rain',
          'light_rain': 'Light Rain',
          'heavy_rain': 'Heavy Rain',
          'drizzle': 'Drizzle',
          'showers': 'Showers',
          'fair': 'Fair',
          'fog': 'Fog',
          'mist': 'Mist',
          'haze': 'Haze',
          'thunderstorm': 'Thunderstorm',
          'thunder': 'Thunder',
          'lightning': 'Lightning',
          'snow': 'Snow',
          'light_snow': 'Light Snow',
          'heavy_snow': 'Heavy Snow',
          'windy': 'Windy',
          'strong_wind': 'Strong Wind',
          'breeze': 'Breeze',
          'dust': 'Dust',
          'sand': 'Sand'
        };
        
        // Find matching condition
        for (const [key, value] of Object.entries(conditionMap)) {
          if (imgName.includes(key)) {
            return value;
          }
        }
      }

      // If no image match, try to get from text content
      const textContent = cleanCell(cell);
      if (textContent && textContent !== '') {
        return textContent;
      }

      return 'Unknown';
    };

    const currentWeather = {
      time: cleanCell(cells[0] || ''),
      condition: getWeatherCondition(cells[1] || ''),
      maxTemp: cleanCell(cells[2] || '0'),
      minTemp: cleanCell(cells[3] || '0'),
      rainfall: cleanCell(cells[4] || '0'),
      windSpeed: cleanCell(cells[5] || '0'),
      windDirection: cleanCell(cells[6] || '0')
    };

    return {
      location,
      date,
      forecast: {
        current: {
          temperature: currentWeather.maxTemp,
          minTemperature: currentWeather.minTemp,
          maxTemp: currentWeather.maxTemp,
          condition: currentWeather.condition,
          time: currentWeather.time,
          rainfall: currentWeather.rainfall,
          windSpeed: currentWeather.windSpeed,
          windDirection: currentWeather.windDirection
        },
        hourly: []
      },
      lastUpdated: new Date().toISOString()
    };
  } catch (error) {
    console.error('Error fetching weather data:', error);
    // Return fallback data
    return {
      location: 'Dowa',
      date: new Date().toLocaleDateString(),
      forecast: {
        current: {
          temperature: '21.3',
          minTemperature: '15.3',
          maxTemp: '25.3',
          condition: 'Clear Sky',
          time: new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }),
          rainfall: '0',
          windSpeed: '10',
          windDirection: '180'
        },
        hourly: []
      },
      lastUpdated: new Date().toISOString()
    };
  }
};

// Update function to fetch weather alerts from RSS feed
const fetchWeatherAlerts = async () => {
  try {
    const response = await fetch('https://www.metmalawi.gov.mw/api/cap/rss.xml', {
      headers: {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36'
      }
    });
    const xml = await response.text();
    
    // Parse XML content
    const alerts = [];
    const itemRegex = /<item>([\s\S]*?)<\/item>/g;
    let match;
    
    while ((match = itemRegex.exec(xml)) !== null) {
      const itemContent = match[1];
      
      // Extract item details
      const title = itemContent.match(/<title>(.*?)<\/title>/)?.[1]?.trim() || '';
      const description = itemContent.match(/<description>(.*?)<\/description>/)?.[1]?.trim() || '';
      const pubDate = itemContent.match(/<pubDate>(.*?)<\/pubDate>/)?.[1]?.trim() || '';
      const link = itemContent.match(/<link>(.*?)<\/link>/)?.[1]?.trim() || '';
      
      // Determine alert type and severity
      let type = 'info';
      let severity = 'normal';
      
      if (title.toLowerCase().includes('flood') || description.toLowerCase().includes('flood')) {
        type = 'severe';
        severity = 'high';
      } else if (title.toLowerCase().includes('wind') || description.toLowerCase().includes('wind') ||
                 title.toLowerCase().includes('storm') || description.toLowerCase().includes('storm')) {
        type = 'warning';
        severity = 'medium';
      }
      
      alerts.push({
        type,
        severity,
        title,
        description,
        link,
        timestamp: new Date(pubDate).toISOString()
      });
    }
    
    return alerts;
  } catch (error) {
    console.error('Error fetching weather alerts:', error);
    return [];
  }
};

