---
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import MainLayout from '../layouts/MainLayout.astro';
import {
  monthlyClimateData,
  practicalGuidance,
  seasonalSections,
} from '../data/weather';

const pageTitle = 'Dzaleka Weather & Climate | Dowa District Guide';
const description =
  'Dzaleka weather: Dowa district forecasts, Malawi weather advisories, rainfall and a local seasonal climate guide.';
const canonical = 'https://services.dzaleka.com/weather';

const currentMonth = new Date().getMonth();
const currentMonthClimate = monthlyClimateData[currentMonth];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description,
  url: canonical,
  about: {
    '@type': 'Place',
    name: 'Dzaleka Refugee Camp',
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'Malawi',
      addressRegion: 'Dowa District',
    },
  },
};

---

<MainLayout title={pageTitle} description={description} canonical={canonical} schema={schema}>
  <div class="bg-white">
    <header class="border-b border-slate-200 bg-primary-50">
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Weather' }]} />
        <p class="mt-5 text-sm font-semibold text-primary-800">Dowa District · Malawi</p>
        <h1 class="mt-2 text-primary-900">Dzaleka weather</h1>
        <p class="mt-3 max-w-2xl text-base leading-7 text-slate-700">Check the district forecast, weather advisories and the seasonal outlook for Dzaleka.</p>
        <nav aria-label="Weather sections" class="mt-6 flex flex-wrap gap-x-7 gap-y-2 border-t border-primary-200 pt-3">
          {[['#forecast', 'District forecast'], ['#advisories', 'Weather advisories'], ['#climate', 'Climate & rainfall'], ['#planning', 'Planning your day']].map(([href, label]) => <a href={href} class="inline-flex min-h-[44px] items-center text-sm font-semibold text-primary-900 underline underline-offset-4">{label}</a>)}
        </nav>
      </div>
    </header>

    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <section id="advisories" aria-labelledby="advisories-heading" class="mb-8 rounded-lg border border-amber-200 bg-amber-50 p-5 sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-3"><h2 id="advisories-heading" class="text-slate-900">Weather advisories</h2><a href="https://www.metmalawi.gov.mw/" class="inline-flex min-h-[44px] items-center text-sm font-semibold text-primary-800 underline underline-offset-4">Check MET Malawi →</a></div>
        <p id="alerts-status" class="mt-2 text-sm leading-6 text-slate-700">Official advisories have not loaded. Check MET Malawi for current warnings. Seasonal guidance is available below.</p>
        <div id="weather-alerts" class="mt-3 space-y-3"></div>
      </section>

      <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(280px,1fr)]">
        <section id="forecast" aria-labelledby="forecast-heading" class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
          <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-200 px-5 py-5 sm:px-7">
            <div><h2 id="forecast-heading" class="text-primary-900">District forecast</h2><p id="weather-location" class="mt-1 text-sm text-slate-600">Dowa District, including Dzaleka</p></div>
            <button id="weather-refresh" type="button" class="inline-flex min-h-[44px] items-center gap-2 rounded border border-slate-400 bg-white px-4 py-2 text-sm font-semibold text-primary-900 hover:bg-slate-50 disabled:opacity-60"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M6 7a7 7 0 0 1 12-1l2 6M4 12l2 6a7 7 0 0 0 12-1"/></svg><span>Refresh forecast</span></button>
          </div>
          <div class="p-5 sm:p-7">
            <p id="weather-status-pill" role="status" class="text-sm font-semibold text-slate-600">Checking forecast availability…</p>
            <div id="weather-unavailable" class="mt-5 rounded-lg border border-slate-200 bg-slate-50 p-5">
              <h3 class="text-lg font-semibold text-primary-900">Forecast data is not available yet</h3>
              <p class="mt-2 text-sm leading-6 text-slate-700">The latest district forecast will appear here when it loads. You can also check the <a href="https://www.metmalawi.gov.mw/weather/daily-table/dowa/" class="text-primary-800 underline underline-offset-4">Dowa forecast on MET Malawi</a>.</p>
            </div>
            <div id="weather-live" class="hidden mt-6">
              <div class="flex flex-wrap items-end justify-between gap-6">
                <div><p class="text-sm text-slate-600">Forecast maximum</p><p class="mt-2 text-6xl font-semibold tracking-tight text-primary-900"><span id="max-temp">—</span><span class="text-3xl">°C</span></p><p class="mt-2 text-base text-slate-700">Minimum <span id="min-temp" class="font-semibold">—</span>°C</p></div>
                <div class="max-w-xs"><p id="weather-condition" class="text-xl font-semibold text-slate-900"></p><p class="mt-2 text-sm text-slate-600"><span id="weather-date"></span><span class="mx-2">·</span><span id="weather-time"></span></p></div>
              </div>
              <dl class="mt-7 grid grid-cols-2 gap-5 border-t border-slate-200 pt-5">
                <div><dt class="flex items-center gap-2 text-sm text-slate-600"><svg class="h-5 w-5 text-primary-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 2S5 10 5 15a7 7 0 0 0 14 0c0-5-7-13-7-13Z"/></svg>Forecast rainfall</dt><dd class="mt-2 text-lg font-semibold text-primary-900"><span id="current-rainfall">—</span> mm</dd></div>
                <div><dt class="flex items-center gap-2 text-sm text-slate-600"><svg class="h-5 w-5 text-primary-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M3 8h12a3 3 0 1 0-3-3M2 12h17a3 3 0 1 1-3 3M5 16h5a3 3 0 1 1-3 3"/></svg>Forecast wind</dt><dd class="mt-2 text-lg font-semibold text-primary-900"><span id="current-wind">—</span> km/h <span id="wind-direction" class="text-sm font-normal"></span></dd></div>
              </dl>
            </div>
            <p id="weather-source-note" class="mt-5 text-sm leading-6 text-slate-600">Monthly climate figures are shown separately from the forecast.</p>
            <p id="weather-updated-at" class="mt-2 text-sm text-slate-600"></p>
            <noscript><p class="mt-4 text-sm text-slate-700">Enable JavaScript to load the latest forecast here, or follow the MET Malawi links.</p></noscript>
          </div>
        </section>

        <aside class="rounded-xl border border-primary-200 bg-primary-50 p-5 sm:p-7" aria-labelledby="season-heading">
          <div class="flex items-start justify-between gap-3"><div><p class="text-sm font-semibold text-primary-800">Local climate guide</p><h2 id="season-heading" class="mt-2 text-primary-900">{currentMonthClimate.month} in Dzaleka</h2></div><svg class="h-12 w-12 shrink-0 text-primary-700" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="24" cy="24" r="10"/><path d="M24 2v7m0 30v7M2 24h7m30 0h7M8 8l5 5m22 22 5 5M8 40l5-5m22-22 5-5"/></svg></div>
          <p class="mt-4 text-base leading-7 text-slate-700">{currentMonthClimate.notes}</p>
          <dl class="mt-6 grid grid-cols-2 gap-4 border-y border-primary-200 py-5">
            <div><dt class="text-sm text-slate-600">Typical high / low</dt><dd class="mt-2 text-xl font-semibold text-primary-900">{currentMonthClimate.high}° / {currentMonthClimate.low}°C</dd></div>
            <div><dt class="text-sm text-slate-600">Monthly rainfall</dt><dd class="mt-2 text-xl font-semibold text-primary-900">{currentMonthClimate.rainfall} mm</dd></div>
          </dl>
          <p class="mt-4 text-sm leading-6 text-slate-600">Seasonal reference values, not a forecast for today.</p>
          <a href="#climate" class="mt-4 inline-flex min-h-[44px] items-center text-sm font-semibold text-primary-900 underline underline-offset-4">Explore the climate guide →</a>
        </aside>
      </div>

      <section id="weather-hourly-wrap" class="hidden mt-8 rounded-xl border border-slate-200 bg-white p-5 sm:p-7" aria-labelledby="periods-heading">
        <h2 id="periods-heading" class="text-primary-900">District forecast periods</h2><p class="mt-2 text-sm text-slate-600">Reporting periods supplied by MET Malawi. Times are as published for Malawi.</p>
        <div class="mt-5 overflow-x-auto" tabindex="0" role="region" aria-label="Scrollable district forecast table"><table class="w-full min-w-[640px] text-left text-sm"><thead class="border-y border-slate-200 bg-slate-50"><tr>{['Period', 'Conditions', 'High / low', 'Rainfall', 'Wind'].map(label => <th scope="col" class="px-4 py-3 font-semibold text-slate-700">{label}</th>)}</tr></thead><tbody id="weather-hourly" class="divide-y divide-slate-200"></tbody></table></div>
      </section>
    </div>

    <section id="climate" class="border-t border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Climate guide</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">Seasonal patterns and monthly averages</h2>
          <p class="mt-4 text-base leading-7 text-slate-600">
            Use these seasonal notes and monthly averages for planning travel, shelter conditions, outdoor events,
            water storage, and crop or market activity. They remain useful even when live observations are delayed.
          </p>
        </div>

        <div class="mt-10 grid gap-10 lg:grid-cols-2">
          {seasonalSections.map((section) => (
            <article class="border-t border-slate-300 pt-5">
              <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">{section.range}</p>
              <h3 class="mt-3 text-2xl font-semibold text-slate-900">{section.title}</h3>
              <p class="mt-3 text-base leading-7 text-slate-600">{section.summary}</p>
              <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-700">
                {section.points.map((point) => (
                  <li class="flex gap-3">
                    <span class="mt-2 h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>

        <div class="mt-12 border-t border-slate-300 pt-6">
          <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Monthly climate snapshot</p>
            <h3 class="mt-3 text-2xl font-semibold text-slate-900">Typical temperature and rainfall by month</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              These reference values are useful when the live feed is unavailable or when planning travel, shelter conditions, outdoor events, and storage around longer seasonal trends.
            </p>
          </div>

          <figure class="mt-6 rounded-lg border border-slate-200 bg-white p-4 sm:p-6" aria-labelledby="rainfall-caption">
            <figcaption id="rainfall-caption" class="mb-4 text-sm font-semibold text-primary-900">Rainfall through the year · monthly climate guide, mm</figcaption>
            <div class="overflow-x-auto"><svg viewBox="0 0 720 220" class="min-w-[560px] w-full" role="img" aria-label="Monthly rainfall is highest in January and lowest from June to August. Values are listed in the table below.">
              <line x1="18" y1="185" x2="705" y2="185" stroke="#cbd5e1" />
              {monthlyClimateData.map((row, index) => <g><rect x={28 + index * 57} y={185 - row.rainfall * 0.6} width="32" height={row.rainfall * 0.6} rx="2" fill={index === currentMonth ? '#0c4a6e' : '#7dd3fc'} /><text x={44 + index * 57} y={175 - row.rainfall * 0.6} text-anchor="middle" font-size="12" fill="#475569">{row.rainfall}</text><text x={44 + index * 57} y="208" text-anchor="middle" font-size="12" fill="#334155">{row.month.slice(0,3)}</text></g>)}
            </svg></div>
          </figure>
          <div class="mt-6 overflow-x-auto">
            <table class="min-w-full border-separate border-spacing-0">
              <thead>
                <tr>
                  <th class="border-b border-slate-300 px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Month</th>
                  <th class="border-b border-slate-300 px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">High</th>
                  <th class="border-b border-slate-300 px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Low</th>
                  <th class="border-b border-slate-300 px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Rain</th>
                  <th class="border-b border-slate-300 px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Humidity</th>
                  <th class="border-b border-slate-300 px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Notes</th>
                </tr>
              </thead>
              <tbody>
                {monthlyClimateData.map((row, index) => (
                  <tr class={index === currentMonth ? 'bg-white' : ''}>
                    <td class="border-b border-slate-200 px-4 py-4 text-sm font-medium text-slate-900">{row.month}</td>
                    <td class="border-b border-slate-200 px-4 py-4 text-sm text-slate-700">{row.high}°C</td>
                    <td class="border-b border-slate-200 px-4 py-4 text-sm text-slate-700">{row.low}°C</td>
                    <td class="border-b border-slate-200 px-4 py-4 text-sm text-slate-700">{row.rainfall} mm</td>
                    <td class="border-b border-slate-200 px-4 py-4 text-sm text-slate-700">{row.humidity}</td>
                    <td class="border-b border-slate-200 px-4 py-4 text-sm text-slate-600">{row.notes}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section id="planning" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(280px,0.9fr)]">
        <article class="border-t border-slate-300 pt-5">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Planning guide</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">What the weather means on the ground</h2>

          <div class="mt-8 grid gap-8 md:grid-cols-2">
            {practicalGuidance.map((group) => (
              <div>
                <h3 class="text-lg font-semibold text-slate-900">{group.title}</h3>
                <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-700">
                  {group.items.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </article>

        <aside class="border-t border-slate-300 pt-5">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Data sources</p>
          <h2 class="mt-3 text-2xl font-semibold text-slate-900">Where the page gets its data</h2>
          <p class="mt-4 text-sm leading-6 text-slate-600">
            Forecasts and advisories are supplied by MET Malawi. Forecast availability and the time of the latest check are shown above. The seasonal guide is separate from current forecasts and warnings.
          </p>

          <div class="mt-6 space-y-4 text-sm leading-6 text-slate-700">
            <p>
              <span class="font-medium text-slate-900">Forecast source:</span>{' '}
              <a
                href="https://www.metmalawi.gov.mw/weather/daily-table/dowa/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary-700 hover:text-primary-800 hover:underline"
              >
                Dowa district daily weather table
              </a>
            </p>
            <p>
              <span class="font-medium text-slate-900">Alert source:</span>{' '}
              <a
                href="https://www.metmalawi.gov.mw/api/cap/rss.xml"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary-700 hover:text-primary-800 hover:underline"
              >
                CAP RSS feed from MET Malawi
              </a>
            </p>
            <p>
              <span class="font-medium text-slate-900">Climate guide:</span> Local seasonal guidance based on typical Dzaleka and Dowa climate patterns.
            </p>
          </div>
        </aside>
      </div>
    </section>
  </div>
</MainLayout>

<script>
  import { weatherView } from '../utils/weatherView';
  const byId = (id: string) => document.getElementById(id)!;
  const refreshButton = byId('weather-refresh') as HTMLButtonElement;
  const setText = (id: string, text: string) => { byId(id).textContent = text; };
  const value = (entry: unknown) => entry === null || entry === undefined || entry === '' ? '—' : String(entry);
  function renderWeather(data) {
    const view = weatherView(data);
    byId('weather-live').classList.toggle('hidden', !view.available);
    byId('weather-unavailable').classList.toggle('hidden', view.available);
    setText('weather-status-pill', view.available ? 'District forecast available' : 'Forecast currently unavailable');
    setText('weather-source-note', view.available ? 'Source: MET Malawi district forecast. This is a forecast, rather than a current observation at Dzaleka.' : 'Check MET Malawi for the latest district forecast. The climate guide remains available below.');
    if (!view.available) { byId('weather-hourly-wrap').classList.add('hidden'); return; }
    const current = data.forecast.current;
    setText('weather-location', data.location || 'Dowa District');
    for (const [id, field] of [['max-temp', 'maxTemp'], ['min-temp', 'minTemperature'], ['current-rainfall', 'rainfall'], ['current-wind', 'windSpeed'], ['wind-direction', 'windDirection'], ['weather-condition', 'condition'], ['weather-time', 'time']]) setText(id, value(current[field]));
    setText('weather-date', value(data.date));
    const table = byId('weather-hourly'); table.replaceChildren();
    for (const item of view.periods) {
      const row = document.createElement('tr');
      for (const [index, content] of [value(item.time), value(item.condition), `${value(item.maxTemp)}° / ${value(item.minTemperature)}°C`, `${value(item.rainfall)} mm`, `${value(item.windSpeed)} km/h ${value(item.windDirection)}`].entries()) {
        const cell = document.createElement(index === 0 ? 'th' : 'td'); cell.className = 'px-4 py-4 text-slate-700'; if (index === 0) cell.setAttribute('scope', 'row'); cell.textContent = content; row.append(cell);
      }
      table.append(row);
    }
    byId('weather-hourly-wrap').classList.toggle('hidden', view.periods.length === 0);
  }
  function renderAlerts(data) {
    const container = byId('weather-alerts'); container.replaceChildren();
    const alerts = Array.isArray(data) ? data.filter(alert => !alert.fallback) : [];
    setText('alerts-status', alerts.length ? 'MET Malawi advisories. Read each notice for affected areas and dates.' : 'Current official advisories could not be confirmed here. Check MET Malawi for warnings affecting your area.');
    for (const alert of alerts.slice(0, 4)) {
      const article = document.createElement('article'); article.className = 'border-l-4 border-amber-600 bg-white p-4';
      const heading = document.createElement('h3'); heading.className = 'text-base font-semibold text-slate-900'; heading.textContent = alert.title;
      const description = document.createElement('p'); description.className = 'mt-2 text-sm leading-6 text-slate-700'; description.textContent = alert.description;
      article.append(heading, description); container.append(article);
    }
  }
  let refreshing = false;
  async function refreshWeather() {
    if (refreshing) return;
    refreshing = true; refreshButton.disabled = true; refreshButton.querySelector('span')!.textContent = 'Refreshing…';
    const getJson = async (url: string) => { const response = await fetch(url, { signal: AbortSignal.timeout(15000) }); if (!response.ok) throw new Error('Unavailable'); return response.json(); };
    const [weather, alerts] = await Promise.allSettled([getJson('/api/weather'), getJson('/api/weather-alerts')]);
    if (weather.status === 'fulfilled') renderWeather(weather.value);
    else { renderWeather(null); setText('weather-status-pill', 'Forecast could not be refreshed. Try again.'); }
    renderAlerts(alerts.status === 'fulfilled' ? alerts.value : []);
    setText('weather-updated-at', `Last checked ${new Date().toLocaleString('en-GB', { timeZone: 'Africa/Blantyre', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })} CAT`);
    refreshing = false; refreshButton.disabled = false; refreshButton.querySelector('span')!.textContent = 'Refresh forecast';
  }
  refreshButton.addEventListener('click', refreshWeather);
  refreshWeather();
  setInterval(refreshWeather, 15 * 60 * 1000);
</script>
