<script>
  // Update weather function
  async function updateWeather() {
    const weatherUpdate = document.getElementById('weather-update');
    weatherUpdate.classList.add('loading');
    
    try {
      const [weatherResponse, alertsResponse] = await Promise.all([
        fetch('/api/weather'),
        fetch('/api/weather-alerts')
      ]);
      
      const weatherData = await weatherResponse.json();
      const alertsData = await alertsResponse.json();
      
      // Update values with animation
      const updateValue = (id, value) => {
        const element = document.getElementById(id);
        if (element) {
          element.style.opacity = '0';
          setTimeout(() => {
            element.textContent = value || 'Unknown';
            element.style.opacity = '1';
          }, 200);
        }
      };

      // Update other values
      updateValue('current-temp', weatherData.forecast.current.temperature);
      updateValue('max-temp', weatherData.forecast.current.maxTemp);
      updateValue('min-temp', weatherData.forecast.current.minTemperature);
      updateValue('current-wind', weatherData.forecast.current.windSpeed);
      updateValue('wind-direction', weatherData.forecast.current.windDirection);
      updateValue('current-rainfall', weatherData.forecast.current.rainfall);
      updateValue('rainfall-24h', weatherData.forecast.current.rainfall);
      updateValue('rainfall-prob', weatherData.forecast.current.rainfall > 0 ? 'High' : 'Low');
      updateValue('weather-condition', weatherData.forecast.current.condition || 'Unknown');
      updateValue('last-updated', new Date(weatherData.lastUpdated).toLocaleTimeString());

      // Update alerts
      const alertsContainer = document.querySelector('.weather-alerts');
      if (alertsContainer) {
        if (alertsData.length > 0) {
          const alertsHTML = alertsData.map(alert => `
            <div class="p-4 rounded-xl backdrop-blur-sm border transition-all duration-300 alert-item ${
              alert.type === 'severe' ? 'bg-red-500/20 border-red-500' :
              alert.type === 'warning' ? 'bg-yellow-500/20 border-yellow-500' :
              'bg-blue-500/20 border-blue-500'
            }">
              <div class="flex items-start space-x-3">
                <div class="flex-shrink-0">
                  ${alert.type === 'severe' ? 
                    '<i class="fas fa-exclamation-triangle text-red-400 text-xl"></i>' :
                    alert.type === 'warning' ? 
                    '<i class="fas fa-exclamation-circle text-yellow-400 text-xl"></i>' :
                    '<i class="fas fa-info-circle text-blue-400 text-xl"></i>'
                  }
                </div>
                <div class="flex-1">
                  <h4 class="text-white text-base font-semibold mb-1">${alert.title}</h4>
                  <p class="text-white/80 text-sm">${alert.description}</p>
                  <div class="flex items-center justify-between mt-2">
                    <p class="text-white/60 text-xs">
                      Issued: ${new Date(alert.timestamp).toLocaleString()}
                    </p>
                    <a href="${alert.link}" 
                       target="_blank" 
                       rel="noopener noreferrer"
                       class="text-white/80 hover:text-white text-xs flex items-center">
                      View Details
                      <i class="fas fa-external-link-alt ml-1"></i>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          `).join('');
          
          alertsContainer.innerHTML = alertsHTML;
          
          // Add show more button if needed
          if (alertsData.length > 3) {
            const showMoreButton = document.createElement('button');
            showMoreButton.onclick = toggleAlerts;
            showMoreButton.className = 'w-full py-2 px-4 bg-white/10 hover:bg-white/20 text-white rounded-lg transition-all duration-300 backdrop-blur-sm border border-white/10 flex items-center justify-center space-x-2';
            showMoreButton.innerHTML = `Show ${alertsData.length - 3} More Alerts <i class="fas fa-chevron-down text-sm"></i>`;
            alertsContainer.appendChild(showMoreButton);
          }
        } else {
          alertsContainer.innerHTML = `
            <div class="p-4 rounded-xl backdrop-blur-sm border border-blue-500/20 bg-blue-500/10">
              <div class="flex items-center space-x-3">
                <i class="fas fa-check-circle text-blue-400 text-xl"></i>
                <p class="text-white text-sm font-medium">No active weather alerts at this time.</p>
              </div>
            </div>
          `;
        }
      }
      
      showToast('Weather data and alerts updated successfully', 'success');
    } catch (error) {
      console.error('Error updating weather:', error);
      showToast('Failed to update weather data', 'error');
    } finally {
      weatherUpdate.classList.remove('loading');
    }
  }

  // Update weather every 5 minutes
  setInterval(updateWeather, 5 * 60 * 1000);

  // Initial update after 5 minutes
  setTimeout(updateWeather, 5 * 60 * 1000);

  // Add smooth scroll behavior
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      document.querySelector(this.getAttribute('href')).scrollIntoView({
        behavior: 'smooth'
      });
    });
  });

  // Expandable sections
  function initExpandableSections() {
    document.querySelectorAll('.expandable-header').forEach(header => {
      header.addEventListener('click', () => {
        const section = header.nextElementSibling;
        const icon = header.querySelector('.expandable-icon');
        
        section.classList.toggle('collapsed');
        section.classList.toggle('expanded');
        icon.classList.toggle('expanded');
        
        // Save state
        const isExpanded = section.classList.contains('expanded');
        localStorage.setItem(`section-${header.id}`, isExpanded);
      });
    });

    // Restore saved states
    document.querySelectorAll('.expandable-header').forEach(header => {
      const savedState = localStorage.getItem(`section-${header.id}`);
      if (savedState === 'true') {
        const section = header.nextElementSibling;
        const icon = header.querySelector('.expandable-icon');
        section.classList.add('expanded');
        icon.classList.add('expanded');
      }
    });
  }

  // Toast notifications
  function showToast(message, type = 'info') {
    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    toast.textContent = message;
    document.body.appendChild(toast);

    // Show toast
    setTimeout(() => toast.classList.add('show'), 100);

    // Hide and remove toast
    setTimeout(() => {
      toast.classList.remove('show');
      toast.classList.add('hide');
      setTimeout(() => toast.remove(), 300);
    }, 3000);
  }

  // Mobile navigation
  function initMobileNav() {
    const nav = document.createElement('nav');
    nav.className = 'mobile-nav';
    nav.innerHTML = `
      <div class="flex justify-around w-full">
        <button class="mobile-nav-item" data-section="current-weather">
          <span class="text-2xl">🌤️</span>
          <span class="text-xs">Current</span>
        </button>
        <button class="mobile-nav-item" data-section="hourly-forecast">
          <span class="text-2xl">📅</span>
          <span class="text-xs">Forecast</span>
        </button>
        <button class="mobile-nav-item" data-section="resources">
          <span class="text-2xl">📚</span>
          <span class="text-xs">Resources</span>
        </button>
      </div>
    `;
    document.body.appendChild(nav);

    // Handle navigation
    nav.querySelectorAll('.mobile-nav-item').forEach(item => {
      item.addEventListener('click', () => {
        const section = document.getElementById(item.dataset.section);
        if (section) {
          section.scrollIntoView({ behavior: 'smooth' });
          showToast(`Navigating to ${item.querySelector('span:last-child').textContent}`, 'info');
        }
      });
    });
  }

  // Initialize all features
  document.addEventListener('DOMContentLoaded', () => {
    initExpandableSections();
    initMobileNav();
  });

  // Add ripple effect to buttons
  document.querySelectorAll('button, .interactive-element').forEach(element => {
    element.classList.add('ripple');
  });

  // Function to toggle visibility of additional alerts
  function toggleAlerts() {
    const alertsContainer = document.querySelector('.weather-alerts');
    const showMoreButton = alertsContainer.querySelector('button');
    const allAlerts = alertsContainer.querySelectorAll('.alert-item');
    const isExpanded = showMoreButton.textContent.includes('Less');
    
    if (isExpanded) {
      // Collapse: Hide alerts after the first 3
      allAlerts.forEach((alert, index) => {
        if (index >= 3) {
          alert.style.display = 'none';
        }
      });
      showMoreButton.innerHTML = `Show ${allAlerts.length - 3} More Alerts <i class="fas fa-chevron-down text-sm"></i>`;
    } else {
      // Expand: Show all alerts
      allAlerts.forEach(alert => {
        alert.style.display = 'block';
      });
      showMoreButton.innerHTML = 'Show Less <i class="fas fa-chevron-up text-sm"></i>';
    }
  }

  // Initialize alerts visibility on page load
  document.addEventListener('DOMContentLoaded', () => {
    const alertsContainer = document.querySelector('.weather-alerts');
    if (alertsContainer) {
      const allAlerts = alertsContainer.querySelectorAll('.alert-item');
      // Hide alerts after the first 3 initially
      allAlerts.forEach((alert, index) => {
        if (index >= 3) {
          alert.style.display = 'none';
        }
      });
    }
  });
</script> 