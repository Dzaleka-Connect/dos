---
import MainLayout from '../layouts/MainLayout.astro';
import {
  getSeasonalFallbackAlerts,
  getSeasonalFallbackWeather,
  monthlyClimateData,
  practicalGuidance,
  seasonalSections,
} from '../data/weather';

const pageTitle = 'Dzaleka Weather & Climate | Dowa District Guide';
const description =
  'Weather and climate guidance for Dzaleka Refugee Camp, including seasonal patterns, monthly rainfall, dry-season cold nights, and a resilient live weather panel with fallback data.';
const canonical = 'https://services.dzaleka.com/weather';

const initialWeather = getSeasonalFallbackWeather();
const initialAlerts = getSeasonalFallbackAlerts();
const currentMonth = new Date().getMonth();
const currentMonthClimate = monthlyClimateData[currentMonth];
const isWetSeason = currentMonth >= 10 || currentMonth <= 3;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description,
  url: canonical,
  about: {
    '@type': 'Place',
    name: 'Dzaleka Refugee Camp',
    address: {
      '@type': 'PostalAddress',
      addressCountry: 'Malawi',
      addressRegion: 'Dowa District',
    },
  },
};

const seasonalFocus = isWetSeason
  ? {
      title: 'Rain, drainage, and standing water',
      text:
        'This period usually brings heavier rain, muddy ground, and greater flood risk in lower areas. Shelter drainage, bedding storage, and mosquito exposure matter more at this time of year.',
    }
  : {
      title: 'Cold nights, dust, and water storage',
      text:
        'Dry-season afternoons are usually manageable, but nights can turn cold quickly. Dust, stored water, and warm bedding become more important practical concerns.',
    };
---

<MainLayout title={pageTitle} description={description} canonical={canonical} schema={schema}>
  <main class="bg-white">
    <section class="border-b border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(300px,0.85fr)] lg:items-start">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Weather and climate</p>
            <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
              Weather and climate for Dzaleka
            </h1>
            <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">
              Current district observations appear first when available. If the live feed is delayed or unavailable,
              the page falls back to local seasonal guidance and monthly climate averages so the essentials stay in view.
            </p>

            <section class="mt-8 rounded-2xl border border-slate-200 bg-white px-6 py-6 shadow-sm sm:px-7">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-3">
                  <span
                    id="weather-status-pill"
                    class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-sm font-medium text-amber-900"
                  >
                    Seasonal fallback
                  </span>
                  <span class="text-sm text-slate-500" id="weather-updated-at">
                    Updated {new Date(initialWeather.lastUpdated).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                  </span>
                </div>

                <button
                  id="weather-refresh"
                  type="button"
                  class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-50"
                >
                  Refresh live feed
                </button>
              </div>

              <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(240px,0.8fr)] lg:items-end">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Current conditions</p>
                  <div class="mt-3 flex flex-wrap items-end gap-x-4 gap-y-2">
                    <p class="text-6xl font-semibold tracking-tight text-slate-900">
                      <span id="current-temp">{initialWeather.forecast.current.temperature}</span>
                      <span class="text-2xl font-medium text-slate-500"> C</span>
                    </p>
                    <p id="weather-condition" class="pb-2 text-2xl font-semibold text-slate-900">
                      {initialWeather.forecast.current.condition}
                    </p>
                  </div>
                  <p class="mt-2 text-sm text-slate-600">
                    Observation time: <span id="weather-condition-time">{initialWeather.forecast.current.time}</span>
                  </p>
                </div>

                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
                  <div class="border-t border-slate-200 pt-3">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Source</p>
                    <p id="weather-source-label" class="mt-2 text-lg font-semibold text-slate-900">
                      {initialWeather.sourceLabel}
                    </p>
                  </div>
                  <div class="border-t border-slate-200 pt-3">
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Location</p>
                    <p id="weather-location" class="mt-2 text-base font-medium text-slate-900">
                      {initialWeather.location}
                    </p>
                  </div>
                </div>
              </div>

              <div class="mt-8 grid gap-x-6 gap-y-4 border-t border-slate-200 pt-6 sm:grid-cols-2 lg:grid-cols-4">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Temperature range</p>
                  <p class="mt-2 text-sm text-slate-700">
                    Max <span id="max-temp" class="font-semibold text-slate-900">{initialWeather.forecast.current.maxTemp}</span> C
                    <span class="mx-2 text-slate-300">/</span>
                    Min <span id="min-temp" class="font-semibold text-slate-900">{initialWeather.forecast.current.minTemperature}</span> C
                  </p>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Wind</p>
                  <p class="mt-2 text-sm text-slate-700">
                    <span id="current-wind" class="font-semibold text-slate-900">{initialWeather.forecast.current.windSpeed}</span> km/h
                    <span class="mx-2 text-slate-300">/</span>
                    <span id="wind-direction">{initialWeather.forecast.current.windDirection}</span>
                  </p>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Rainfall</p>
                  <p class="mt-2 text-sm text-slate-700">
                    <span id="current-rainfall" class="font-semibold text-slate-900">{initialWeather.forecast.current.rainfall}</span> mm
                  </p>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Report date</p>
                  <p class="mt-2 text-sm text-slate-700">
                    <span id="weather-date">{initialWeather.date}</span>
                    <span class="mx-2 text-slate-300">/</span>
                    <span id="weather-time">{initialWeather.forecast.current.time}</span>
                  </p>
                </div>
              </div>

              <p id="weather-source-note" class="mt-6 max-w-3xl text-sm leading-6 text-slate-600">
                {initialWeather.sourceNote}
              </p>

              <div
                id="weather-hourly-wrap"
                class:list={[
                  'mt-8 border-t border-slate-200 pt-6',
                  initialWeather.forecast.hourly.length === 0 && 'hidden',
                ]}
              >
                <div class="flex items-center justify-between gap-3">
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Recent district readings</p>
                    <p class="mt-1 text-sm text-slate-600">A quick view across the latest reporting intervals.</p>
                  </div>
                </div>

                <div id="weather-hourly" class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
                  {initialWeather.forecast.hourly.slice(0, 4).map((item) => (
                    <article class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-4">
                      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">{item.time}</p>
                      <p class="mt-2 text-lg font-semibold text-slate-900">{item.condition}</p>
                      <p class="mt-2 text-sm text-slate-700">
                        {item.maxTemp || item.minTemperature} C
                        <span class="mx-2 text-slate-300">/</span>
                        {item.windSpeed} km/h
                      </p>
                    </article>
                  ))}
                </div>
              </div>
            </section>
          </div>

          <aside class="border-t border-slate-300 pt-5 lg:pt-1">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Seasonal conditions</p>
            <h2 class="mt-3 text-2xl font-semibold text-slate-900">{seasonalFocus.title}</h2>
            <p class="mt-4 text-base leading-7 text-slate-600">{seasonalFocus.text}</p>

            <dl class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
              <div class="border-t border-slate-200 pt-4">
                <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">This month</dt>
                <dd class="mt-2 text-lg font-semibold text-slate-900">{currentMonthClimate.month}</dd>
                <dd class="mt-1 text-sm text-slate-600">
                  {currentMonthClimate.high} C high / {currentMonthClimate.low} C low
                </dd>
              </div>
              <div class="border-t border-slate-200 pt-4">
                <dt class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">Typical rainfall</dt>
                <dd class="mt-2 text-lg font-semibold text-slate-900">{currentMonthClimate.rainfall} mm</dd>
                <dd class="mt-1 text-sm text-slate-600">{currentMonthClimate.notes}</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Warnings and advisories</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">Current watch for Dzaleka</h2>
        <p class="mt-3 text-base leading-7 text-slate-600">
          Check this section first during heavy rain, strong wind, thunderstorms, or cold-season overnight drops.
          Local movement, shelter drainage, and outdoor work can change quickly.
        </p>
      </div>

      <div id="weather-alerts" class="mt-8 space-y-3">
        {initialAlerts.map((alert) => (
          <article
            class:list={[
              'border-l-4 bg-white px-4 py-4 shadow-sm',
              alert.type === 'severe' && 'border-red-500',
              alert.type === 'warning' && 'border-amber-500',
              alert.type === 'info' && 'border-sky-500',
            ]}
          >
            <p class="text-sm font-semibold text-slate-900">{alert.title}</p>
            <p class="mt-2 max-w-4xl text-sm leading-6 text-slate-700">{alert.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="border-t border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Climate guide</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">Seasonal patterns and monthly averages</h2>
          <p class="mt-4 text-base leading-7 text-slate-600">
            Use these seasonal notes and monthly averages for planning travel, shelter conditions, outdoor events,
            water storage, and crop or market activity. They remain useful even when live observations are delayed.
          </p>
        </div>

        <div class="mt-10 grid gap-10 lg:grid-cols-2">
          {seasonalSections.map((section) => (
            <article class="border-t border-slate-300 pt-5">
              <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">{section.range}</p>
              <h3 class="mt-3 text-2xl font-semibold text-slate-900">{section.title}</h3>
              <p class="mt-3 text-base leading-7 text-slate-600">{section.summary}</p>
              <ul class="mt-5 space-y-3 text-sm leading-6 text-slate-700">
                {section.points.map((point) => (
                  <li class="flex gap-3">
                    <span class="mt-2 h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>

        <div class="mt-12 border-t border-slate-300 pt-6">
          <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Monthly climate snapshot</p>
            <h3 class="mt-3 text-2xl font-semibold text-slate-900">Typical temperature and rainfall by month</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              These reference values are useful when the live feed is unavailable or when planning travel, shelter conditions, outdoor events, and storage around longer seasonal trends.
            </p>
          </div>

          <div class="mt-6 overflow-x-auto">
            <table class="min-w-full border-separate border-spacing-0">
              <thead>
                <tr>
                  <th class="border-b border-slate-300 px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Month</th>
                  <th class="border-b border-slate-300 px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">High</th>
                  <th class="border-b border-slate-300 px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Low</th>
                  <th class="border-b border-slate-300 px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Rain</th>
                  <th class="border-b border-slate-300 px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Humidity</th>
                  <th class="border-b border-slate-300 px-4 py-3 text-left text-xs font-semibold uppercase tracking-[0.16em] text-slate-500">Notes</th>
                </tr>
              </thead>
              <tbody>
                {monthlyClimateData.map((row, index) => (
                  <tr class={index === currentMonth ? 'bg-white' : ''}>
                    <td class="border-b border-slate-200 px-4 py-4 text-sm font-medium text-slate-900">{row.month}</td>
                    <td class="border-b border-slate-200 px-4 py-4 text-sm text-slate-700">{row.high} C</td>
                    <td class="border-b border-slate-200 px-4 py-4 text-sm text-slate-700">{row.low} C</td>
                    <td class="border-b border-slate-200 px-4 py-4 text-sm text-slate-700">{row.rainfall} mm</td>
                    <td class="border-b border-slate-200 px-4 py-4 text-sm text-slate-700">{row.humidity}</td>
                    <td class="border-b border-slate-200 px-4 py-4 text-sm text-slate-600">{row.notes}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(280px,0.9fr)]">
        <article class="border-t border-slate-300 pt-5">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Planning guide</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">What the weather means on the ground</h2>

          <div class="mt-8 grid gap-8 md:grid-cols-2">
            {practicalGuidance.map((group) => (
              <div>
                <h3 class="text-lg font-semibold text-slate-900">{group.title}</h3>
                <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-700">
                  {group.items.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-1.5 w-1.5 rounded-full bg-slate-400"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </article>

        <aside class="border-t border-slate-300 pt-5">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Data sources</p>
          <h2 class="mt-3 text-2xl font-semibold text-slate-900">Where the page gets its data</h2>
          <p class="mt-4 text-sm leading-6 text-slate-600">
            Live conditions and alerts come from public Malawi Meteorological Department endpoints. Those services sometimes fail, block requests, or time out, so this page falls back to local seasonal guidance instead of leaving the weather section blank.
          </p>

          <div class="mt-6 space-y-4 text-sm leading-6 text-slate-700">
            <p>
              <span class="font-medium text-slate-900">Live source:</span>{' '}
              <a
                href="https://www.metmalawi.gov.mw/weather/daily-table/dowa/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary-700 hover:text-primary-800 hover:underline"
              >
                Dowa district daily weather table
              </a>
            </p>
            <p>
              <span class="font-medium text-slate-900">Alert source:</span>{' '}
              <a
                href="https://www.metmalawi.gov.mw/api/cap/rss.xml"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary-700 hover:text-primary-800 hover:underline"
              >
                CAP RSS feed from MET Malawi
              </a>
            </p>
            <p>
              <span class="font-medium text-slate-900">Fallback mode:</span> Local seasonal guidance based on typical Dzaleka and Dowa climate patterns.
            </p>
          </div>
        </aside>
      </div>
    </section>
  </main>
</MainLayout>

<script>
  const refreshButton = document.getElementById('weather-refresh');
  const statusPill = document.getElementById('weather-status-pill');
  const sourceLabel = document.getElementById('weather-source-label');
  const sourceNote = document.getElementById('weather-source-note');
  const locationEl = document.getElementById('weather-location');
  const dateEl = document.getElementById('weather-date');
  const timeEl = document.getElementById('weather-time');
  const updatedAtEl = document.getElementById('weather-updated-at');
  const currentTempEl = document.getElementById('current-temp');
  const maxTempEl = document.getElementById('max-temp');
  const minTempEl = document.getElementById('min-temp');
  const currentWindEl = document.getElementById('current-wind');
  const windDirectionEl = document.getElementById('wind-direction');
  const currentRainfallEl = document.getElementById('current-rainfall');
  const weatherConditionEl = document.getElementById('weather-condition');
  const weatherConditionTimeEl = document.getElementById('weather-condition-time');
  const alertsContainer = document.getElementById('weather-alerts');
  const hourlyWrap = document.getElementById('weather-hourly-wrap');
  const hourlyContainer = document.getElementById('weather-hourly');

  function escapeHtml(value) {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function setStatus(isStale, label) {
    if (!statusPill) return;

    statusPill.textContent = label;
    statusPill.className = isStale
      ? 'inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-sm font-medium text-amber-900'
      : 'inline-flex items-center rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-800';
  }

  function renderWeather(data) {
    setStatus(Boolean(data.stale), data.stale ? 'Seasonal fallback' : 'Live feed available');

    if (sourceLabel) sourceLabel.textContent = data.sourceLabel || 'Weather source';
    if (sourceNote) sourceNote.textContent = data.sourceNote || '';
    if (locationEl) locationEl.textContent = data.location || '';
    if (dateEl) dateEl.textContent = data.date || '';
    if (timeEl) timeEl.textContent = data.forecast?.current?.time || '';

    if (updatedAtEl) {
      updatedAtEl.textContent = `Updated ${new Date(data.lastUpdated).toLocaleTimeString([], {
        hour: '2-digit',
        minute: '2-digit',
      })}`;
    }

    if (currentTempEl) currentTempEl.textContent = data.forecast?.current?.temperature || '';
    if (maxTempEl) maxTempEl.textContent = data.forecast?.current?.maxTemp || '';
    if (minTempEl) minTempEl.textContent = data.forecast?.current?.minTemperature || '';
    if (currentWindEl) currentWindEl.textContent = data.forecast?.current?.windSpeed || '';
    if (windDirectionEl) windDirectionEl.textContent = data.forecast?.current?.windDirection || '';
    if (currentRainfallEl) currentRainfallEl.textContent = data.forecast?.current?.rainfall || '';
    if (weatherConditionEl) weatherConditionEl.textContent = data.forecast?.current?.condition || '';
    if (weatherConditionTimeEl) weatherConditionTimeEl.textContent = data.forecast?.current?.time || '';

    renderHourly(data.forecast?.hourly || []);
  }

  function renderAlerts(alerts) {
    if (!alertsContainer || !Array.isArray(alerts) || alerts.length === 0) return;

    alertsContainer.innerHTML = alerts
      .slice(0, 4)
      .map((alert) => {
        const tone =
          alert.type === 'severe'
            ? 'border-red-500'
            : alert.type === 'warning'
              ? 'border-amber-500'
              : 'border-sky-500';

        return `
          <article class="border-l-4 bg-white px-4 py-4 shadow-sm ${tone}">
            <p class="text-sm font-semibold text-slate-900">${escapeHtml(alert.title)}</p>
            <p class="mt-2 max-w-4xl text-sm leading-6 text-slate-700">${escapeHtml(alert.description)}</p>
          </article>
        `;
      })
      .join('');
  }

  function renderHourly(hourly) {
    if (!hourlyWrap || !hourlyContainer) return;

    if (!Array.isArray(hourly) || hourly.length === 0) {
      hourlyWrap.classList.add('hidden');
      hourlyContainer.innerHTML = '';
      return;
    }

    hourlyWrap.classList.remove('hidden');
    hourlyContainer.innerHTML = hourly
      .slice(0, 4)
      .map((item) => {
        const temp = item.maxTemp || item.minTemperature || '';
        return `
          <article class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-4">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">${escapeHtml(item.time || '')}</p>
            <p class="mt-2 text-lg font-semibold text-slate-900">${escapeHtml(item.condition || '')}</p>
            <p class="mt-2 text-sm text-slate-700">
              ${escapeHtml(temp)} C
              <span class="mx-2 text-slate-300">/</span>
              ${escapeHtml(item.windSpeed || '')} km/h
            </p>
          </article>
        `;
      })
      .join('');
  }

  async function refreshWeather() {
    if (refreshButton instanceof HTMLButtonElement) {
      refreshButton.disabled = true;
      refreshButton.textContent = 'Refreshing...';
    }

    try {
      const [weatherResponse, alertsResponse] = await Promise.all([
        fetch('/api/weather'),
        fetch('/api/weather-alerts'),
      ]);

      if (!weatherResponse.ok || !alertsResponse.ok) {
        throw new Error('Weather refresh failed');
      }

      const weather = await weatherResponse.json();
      const alerts = await alertsResponse.json();

      renderWeather(weather);
      renderAlerts(alerts);
    } catch (error) {
      console.error('Error refreshing weather page:', error);
    } finally {
      if (refreshButton instanceof HTMLButtonElement) {
        refreshButton.disabled = false;
        refreshButton.textContent = 'Refresh live feed';
      }
    }
  }

  refreshButton?.addEventListener('click', refreshWeather);
  refreshWeather();
  setInterval(refreshWeather, 15 * 60 * 1000);
</script>
