---
import MainLayout from '../layouts/MainLayout.astro';

const seo = {
  title: "Support Our Work",
  description: "Support Dzaleka Online Services in preserving and promoting cultural heritage through digital technologies. Your contribution helps document history and amplify voices within Dzaleka Refugee Camp.",
  canonicalURL: new URL(Astro.url.pathname, Astro.site),
  openGraph: {
    basic: {
      title: "Support Our Work - Dzaleka Online Services",
      type: "article",
      image: "https://images.pexels.com/photos/2678468/pexels-photo-2678468.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2",
    },
    optional: {
      description: "Help preserve Dzaleka's cultural heritage through digital technologies. Support our mission to document history and amplify refugee voices.",
      siteName: "Dzaleka Online Services",
    },
    image: {
      alt: "Support Dzaleka Online Services - Preserving Cultural Heritage",
    },
  },
  twitter: {
    card: "summary_large_image",
    site: "@dzalekaconnect",
    creator: "@dzalekaconnect",
    title: "Support Our Work - Dzaleka Online Services",
    description: "Help preserve Dzaleka's cultural heritage through digital technologies. Support our mission to document history and amplify refugee voices.",
    image: "https://images.pexels.com/photos/2678468/pexels-photo-2678468.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2",
    imageAlt: "Support Dzaleka Online Services - Preserving Cultural Heritage",
  },
  robots: {
    index: true,
    follow: true,
  },
};
---

<MainLayout title={seo.title} description={seo.description}>
  <head>
    <meta property="og:image" content="https://images.pexels.com/photos/2678468/pexels-photo-2678468.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" />
    <meta property="og:image:alt" content="Support Dzaleka Online Services - Preserving Cultural Heritage" />
    <meta name="twitter:image" content="https://images.pexels.com/photos/2678468/pexels-photo-2678468.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2" />
  </head>

  <!-- Hero Section with Image -->
  <div class="relative">
    <!-- Hero Image -->
    <div class="absolute inset-0">
      <img 
        src="/images/dzaleka-hero.jpeg" 
        alt="Dzaleka Cultural Heritage" 
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-black bg-opacity-50"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative min-h-[50vh] flex items-center">
      <div class="container mx-auto px-4 py-12">
        <div class="max-w-3xl">
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
            Support Our Work
          </h1>
          <p class="text-lg md:text-xl text-white mb-6">
            Help us preserve and promote Dzaleka's cultural heritage through digital technologies
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a 
              href="https://fundraise.dzaleka.com/dzaleka-online-services" 
              class="inline-flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
            >
              Donate Now
            </a>
            <a 
              href="#ways-to-support" 
              class="inline-flex items-center justify-center px-8 py-3 border-2 border-white text-base font-medium rounded-md text-white bg-transparent hover:bg-white hover:text-primary-600 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-white"
            >
              Learn More
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main class="min-h-screen bg-gray-50">
    <div class="container mx-auto px-4 py-8">
      <div class="max-w-4xl mx-auto">
        <!-- Introduction -->
        <section class="bg-white rounded-xl shadow-sm p-6 mb-8">
          <div class="prose prose-lg">
            <p class="text-lg text-gray-700">
              Digital technologies have created vast opportunities for preserving and promoting cultural heritage — and Dzaleka Online Services is harnessing these tools to tell our stories, document our history, and amplify the voices within Dzaleka Refugee Camp.
            </p>
            <p class="text-lg text-gray-700">
              We need your support to fully explore and utilise these opportunities.
            </p>
          </div>
        </section>

        <!-- Impact Areas -->
        <section id="ways-to-support" class="bg-white rounded-xl shadow-sm p-6 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Your Impact</h2>
          <div class="grid md:grid-cols-2 gap-6">
            <div class="bg-gray-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-4">Your financial gift will go towards:</h3>
              <ul class="space-y-3">
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>Digitisation of photos, documents, and oral histories</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>Innovation in digital archiving and storytelling</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>Research that centres refugee experiences and narratives</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>Capacity building for local youth and content creators</span>
                </li>
              </ul>
            </div>
            <div class="bg-gray-50 rounded-lg p-6">
              <h3 class="text-xl font-semibold text-gray-900 mb-4">With your support, we can:</h3>
              <ul class="space-y-3">
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>Improve public access to cultural records and digital archives</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>Preserve and restore historical materials</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>Boost cultural vibrancy and build creative economies</span>
                </li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Donation Options -->
        <section class="bg-white rounded-xl shadow-sm p-6 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Ways to Support</h2>
          
          <!-- Online Donation -->
          <div class="mb-8">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Donate Online</h3>
            <p class="text-gray-700 mb-4">Support our work with a one-off, monthly, or annual donation.</p>
            <a href="https://fundraise.dzaleka.com/dzaleka-online-services" 
               class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
              Donate To Dzaleka Online Services
            </a>
          </div>

          <!-- Grants & Institutional Giving -->
          <div class="mb-8">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Grants & Institutional Giving</h3>
            <p class="text-gray-700 mb-4">
              Institutional giving plays a key role in expanding our impact. If you're part of a foundation, NGO, or funder interested in digital heritage, refugee storytelling, or African-led innovation — we'd love to connect.
            </p>
            <p class="text-gray-700 mb-4">
              Reach us at: <a href="mailto:dzalekaconnnect@gmail.com" class="text-primary-600 hover:text-primary-700">dzalekaconnnect@gmail.com</a>
            </p>
            <p class="text-sm text-gray-600">We are committed to transparency and only accept funding aligned with our values.</p>
          </div>

          <!-- In-Kind Donations -->
          <div class="mb-8">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">In-Kind Donations</h3>
            <p class="text-gray-700 mb-4">We also welcome in-kind support, including but not limited to:</p>
            <ul class="list-disc pl-6 mb-4 text-gray-700">
              <li>Technical equipment (laptops, cameras, scanners, hard drives)</li>
              <li>Archival storage materials</li>
              <li>Books, stationery, or event space</li>
            </ul>
            <p class="text-gray-700">
              Have something to offer? Email <a href="mailto:dzalekaconnnect@gmail.com" class="text-primary-600 hover:text-primary-700">dzalekaconnnect@gmail.com</a>
            </p>
          </div>

          <!-- Mobile Money & Bank Transfer -->
          <div>
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Airtel Money / TNM Mpamba / Direct Transfer</h3>
            <p class="text-gray-700 mb-4">Prefer to donate through mobile money or bank transfer?</p>
            <p class="text-gray-700">
              Contact us for details: <a href="mailto:dzalekaconnnect@gmail.com" class="text-primary-600 hover:text-primary-700">dzalekaconnnect@gmail.com</a>
            </p>
          </div>
        </section>

        <!-- Privacy Notice -->
        <section class="bg-white rounded-xl shadow-sm p-6">
          <div class="prose prose-lg">
            <p class="text-gray-700">
              We take donor privacy seriously and carefully safeguard all data shared during the donation process. Please refer to our <a href="/privacy" class="text-primary-600 hover:text-primary-700">Privacy Policy</a> to learn more.
            </p>
          </div>
        </section>
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .prose a {
    @apply text-primary-600 hover:text-primary-700;
  }
  .prose ul {
    @apply list-disc pl-6 mb-4;
  }
  .prose li {
    @apply text-gray-700;
  }
</style> 