---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

const title = 'Support Dzaleka Online Services';
const description = 'Donate equipment, funds, or professional support for Dzaleka Online Services and its public information and cultural archive work.';
---

<MainLayout
  title={`${title} - Dzaleka Online Services`}
  description={description}
  canonical="https://services.dzaleka.com/support-our-work"
  openGraph={{
    title,
    description,
    type: 'website',
    image: {
      url: 'https://services.dzaleka.com/images/dzaleka-hero.jpeg',
      alt: 'Community activity in Dzaleka'
    },
    site_name: 'Dzaleka Online Services',
    locale: 'en_US',
    url: 'https://services.dzaleka.com/support-our-work'
  }}
  twitter={{
    card: 'summary_large_image',
    title,
    description,
    image: 'https://services.dzaleka.com/images/dzaleka-hero.jpeg'
  }}
>
  <main class="min-h-screen bg-white">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
        <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Support our work' }]} />
        <div class="mt-8 max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-widest text-slate-500">Support</p>
          <h1 class="mt-3 text-4xl font-bold text-slate-900 sm:text-5xl">Support Dzaleka Online Services</h1>
          <p class="mt-5 text-lg leading-8 text-slate-600 sm:text-xl">
            Help maintain public service information, document community history, and give local contributors the equipment and support needed to publish their work.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="https://pay.dzaleka.com/pay/f981ad2a-ee56-4084-a1d6-4efd6d20a653"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-500 px-5 py-3 font-semibold text-white hover:bg-emerald-600"
            >
              <img src="/images/dzalekapay-mark-light.svg" alt="" aria-hidden="true" class="h-5 w-5" />
              Pay with DzalekaPay
            </a>
            <a
              href="mailto:dzalekaconnect@gmail.com?subject=Support%20Dzaleka%20Online%20Services"
              class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-3 font-semibold text-slate-700 hover:bg-slate-50"
            >
              Contact the team
            </a>
          </div>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_18rem]">
        <div class="space-y-12">
          <section>
            <h2 class="text-2xl font-bold text-slate-900">What support pays for</h2>
            <p class="mt-4 max-w-3xl leading-7 text-slate-600">
              Dzaleka Online Services is a community-maintained website. Contributions cover the practical work required to collect, check, publish, and preserve information.
            </p>
            <ul class="mt-6 divide-y divide-slate-200 border-y border-slate-200">
              <li class="py-4">
                <h3 class="font-semibold text-slate-900">Public information</h3>
                <p class="mt-1 text-slate-600">Updating service listings, urgent contacts, jobs, events, resources, and guidance pages.</p>
              </li>
              <li class="py-4">
                <h3 class="font-semibold text-slate-900">Digitisation and archiving</h3>
                <p class="mt-1 text-slate-600">Scanning photographs and documents, recording oral histories, and maintaining structured cultural records.</p>
              </li>
              <li class="py-4">
                <h3 class="font-semibold text-slate-900">Contributor equipment</h3>
                <p class="mt-1 text-slate-600">Cameras, recorders, storage, connectivity, and basic tools used by local writers and documentarians.</p>
              </li>
              <li class="py-4">
                <h3 class="font-semibold text-slate-900">Publishing and maintenance</h3>
                <p class="mt-1 text-slate-600">Hosting, accessibility work, security, backups, and improvements to submission and correction workflows.</p>
              </li>
            </ul>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-slate-900">Other ways to contribute</h2>
            <div class="mt-6 space-y-8">
              <div>
                <h3 class="text-lg font-semibold text-slate-900">Equipment and materials</h3>
                <p class="mt-2 leading-7 text-slate-600">
                  Useful donations include working laptops, cameras, audio recorders, scanners, hard drives, archival storage materials, books, and stationery. Contact us before sending equipment so we can confirm what is currently needed.
                </p>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-slate-900">Institutional funding</h3>
                <p class="mt-2 leading-7 text-slate-600">
                  We welcome conversations with funders working in public-interest technology, community information, refugee-led media, archives, research, or cultural documentation.
                </p>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-slate-900">Professional support</h3>
                <p class="mt-2 leading-7 text-slate-600">
                  Researchers, archivists, designers, developers, editors, translators, and accessibility specialists can offer time for a defined piece of work.
                </p>
              </div>
            </div>
          </section>

          <section class="border-t border-slate-200 pt-8">
            <h2 class="text-2xl font-bold text-slate-900">Contact</h2>
            <p class="mt-3 leading-7 text-slate-600">
              Support the work through <a href="https://pay.dzaleka.com/pay/f981ad2a-ee56-4084-a1d6-4efd6d20a653" target="_blank" rel="noopener noreferrer" class="font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800">DzalekaPay</a>, or email <a href="mailto:dzalekaconnect@gmail.com" class="font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800">dzalekaconnect@gmail.com</a> about equipment, professional support, or institutional funding.
            </p>
          </section>
        </div>

        <aside class="h-fit rounded-xl border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-lg font-semibold text-slate-900">Donor privacy</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">
            We use donor information only to process contributions, maintain records, and respond to enquiries. Read the <a href="/privacy" class="font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800">privacy policy</a> for details.
          </p>
        </aside>
      </div>
    </div>
  </main>
</MainLayout>
