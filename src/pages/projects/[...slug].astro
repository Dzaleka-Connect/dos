---
import MainLayout from '../../layouts/MainLayout.astro';
import CollectionHeader from '../../components/ui/CollectionHeader.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({ params: { slug: project.id }, props: { project, projects } }));
}
const { project, projects } = Astro.props;
const { Content } = await render(project);
const url = `https://services.dzaleka.com/projects/${project.id}`;
const address = [project.data.location?.address, project.data.location?.city].filter(Boolean).join(', ');
const facts = [
  { label: 'Category', value: project.data.category },
  { label: 'Location', value: address },
  { label: 'Submission year', value: project.data.mitSolve?.submissionYear },
  { label: 'Challenge', value: project.data.mitSolve?.solutionCategory },
  { label: 'Submission status', value: project.data.status },
];
---
<MainLayout title={project.data.title} description={project.data.description}>
  <CollectionHeader title={project.data.title} description={project.data.description || ''} breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Projects', href: '/projects' }, { label: project.data.title }]} />
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <article class="min-w-0 max-w-prose prose prose-slate prose-a:text-primary-800 project-content"><Content /></article>
      <aside class="min-w-0 space-y-7 border-t-2 border-primary-900 pt-5" aria-labelledby="project-details">
        <div><h2 id="project-details" class="text-xl text-primary-900">Submission details</h2>
          <dl class="mt-4 space-y-4 text-sm leading-6">{facts.filter(fact => fact.value).map(fact => <div><dt class="font-semibold text-slate-900">{fact.label}</dt><dd class="mt-1 text-slate-700">{fact.value}</dd></div>)}</dl>
          {project.data.mitSolve?.solutionUrl && <a href={project.data.mitSolve.solutionUrl} class="mt-5 inline-flex min-h-[44px] items-center rounded bg-primary-900 px-5 py-3 text-sm font-medium text-white hover:bg-primary-800">View submission on MIT Solve <span class="ml-2" aria-hidden="true">↗</span></a>}
          {project.data.lastUpdated && <p class="mt-4 text-sm text-slate-500">Listing updated <time datetime={project.data.lastUpdated.toISOString()}>{project.data.lastUpdated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Africa/Blantyre' })}</time></p>}
        </div>
        {project.data.programs?.length > 0 && <section class="border-t border-slate-200 pt-5"><h2 class="text-lg text-primary-900">Programs</h2><ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-slate-700">{project.data.programs.map(program => <li>{program}</li>)}</ul></section>}
        {project.data.impact?.length > 0 && <section class="border-t border-slate-200 pt-5"><h2 class="text-lg text-primary-900">Reported impact</h2><ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-slate-700">{project.data.impact.map(impact => <li>{impact}</li>)}</ul></section>}
        <details class="border-t border-slate-200 pt-3"><summary class="cursor-pointer py-2 text-sm font-medium text-primary-800">Share this project</summary><ul class="mt-2 flex flex-wrap gap-x-5 text-sm">{[
          { label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}` },
          { label: 'X', href: `https://twitter.com/intent/tweet?text=${encodeURIComponent(project.data.title)}&url=${encodeURIComponent(url)}` },
          { label: 'WhatsApp', href: `https://wa.me/?text=${encodeURIComponent(`${project.data.title} ${url}`)}` },
        ].map(link => <li><a href={link.href} class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">{link.label}</a></li>)}</ul></details>
      </aside>
    </div>
    <section class="mt-12 border-t border-slate-200 pt-8" aria-labelledby="more-projects"><h2 id="more-projects" class="text-primary-900">Other projects</h2><ul class="mt-4 grid gap-6 md:grid-cols-3">{projects.filter(other => other.id !== project.id).map(other => <li class="min-w-0"><p class="text-sm text-slate-600">{other.data.category}</p><h3 class="mt-2 text-lg"><a href={`/projects/${other.id}`} class="text-primary-800 underline underline-offset-4">{other.data.title}</a></h3></li>)}</ul></section>
  </div>
</MainLayout>
<style>
  .project-content :global(:first-child) { margin-top: 0; }
  .project-content :global(a) { overflow-wrap: anywhere; }
  .project-content :global(table) { display: block; max-width: 100%; overflow-x: auto; }
</style>
