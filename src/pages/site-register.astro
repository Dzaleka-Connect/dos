---
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";

const title = "Dzaleka site register";
const description =
  "A community-led record documenting cultural, historical, and natural heritage sites in the Dzaleka community.";

const allSites = Object.values(
  import.meta.glob("../content/sites/*.md", { eager: true }),
);

// Sort: featured first, then alphabetical
allSites.sort((a, b) => {
  if (a.frontmatter.featured && !b.frontmatter.featured) return -1;
  if (!a.frontmatter.featured && b.frontmatter.featured) return 1;
  return a.frontmatter.title.localeCompare(b.frontmatter.title);
});

// Extract unique categories + compute stats
const categories = [
  ...new Set(allSites.map((s) => s.frontmatter.category).filter(Boolean)),
].sort();
const categoryStats = {};
categories.forEach((cat) => {
  categoryStats[cat] = allSites.filter(
    (s) => s.frontmatter.category === cat,
  ).length;
});
const atRiskCount = allSites.filter(
  (s) =>
    s.frontmatter.condition === "poor" || s.frontmatter.condition === "ruins",
).length;
---

<MainLayout
  title={title}
  description={description}
  canonical="https://services.dzaleka.com/site-register"
  image="https://services.dzaleka.com/images/dzaleka-hero.jpeg"
>
  {/* Schema.org ItemList Structured Data */}
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: "Dzaleka site register",
      description: description,
      url: "https://services.dzaleka.com/site-register",
      numberOfItems: allSites.length,
      itemListElement: allSites.map((s, idx) => ({
        "@type": "ListItem",
        position: idx + 1,
        name: s.frontmatter.title,
        url: `https://services.dzaleka.com/site-register/${s.file.split("/").pop().replace(".md", "")}`,
      })),
    })}
  />
  <section class="bg-primary-900 text-white">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <Breadcrumb
        light
        items={[{ label: "Home", href: "/" }, { label: "Site register" }]}
      />
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_300px] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-primary-200">
            Community places and heritage
          </p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
            Dzaleka site register
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-primary-50">
            A community record of cultural, historical, educational and natural
            places in Dzaleka and surrounding communities.
          </p>
          <div class="mt-5 flex flex-wrap gap-3">
            <a
              href="/map"
              class="inline-flex min-h-[44px] items-center rounded bg-white px-5 py-3 font-semibold text-primary-900 hover:bg-primary-50"
            >
              Explore the map →
            </a>
            <a
              href="/site-register/submit"
              class="inline-flex min-h-[44px] items-center rounded border border-primary-300 px-5 py-3 font-medium text-white hover:bg-primary-800"
            >
              Submit a site
            </a>
          </div>
        </div>
        <aside class="hidden border-l border-primary-600 pl-6 lg:block">
          <h2 class="text-lg font-semibold">About these records</h2>
          <p class="mt-2 text-sm leading-7 text-primary-50">
            Find photographs, descriptions, locations and source notes on each
            site’s page.
          </p>
          <a
            href="/site-register/about"
            class="mt-3 inline-flex min-h-[44px] items-center text-sm font-medium text-white underline underline-offset-4"
          >
            How the register works →
          </a>
        </aside>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-3 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
        <span class="font-medium text-slate-900">
          {allSites.length} site records
        </span>
        {atRiskCount > 0 && (
          <>
            <span class="hidden sm:inline text-slate-300">|</span>
            <span class="text-red-600 font-medium">{atRiskCount} at risk</span>
          </>
        )}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section
      aria-label="Filter site records"
      class="mb-8 grid items-end gap-4 sm:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_240px_190px_auto]"
    >
      <div class="sm:col-span-2 lg:col-span-1">
        <label
          for="site-search"
          class="block text-sm font-semibold text-slate-900"
        >
          Search sites
        </label>
        <input
          type="search"
          id="site-search"
          placeholder="Name, location or keyword"
          class="mt-2 min-h-[44px] w-full rounded border border-slate-400 bg-white px-3 py-3 text-base text-slate-900 focus:border-primary-700 focus:ring-2 focus:ring-primary-600"
        />
      </div>
      <div>
        <label
          for="category-select"
          class="block text-sm font-semibold text-slate-900"
        >
          Category
        </label>
        <select
          id="category-select"
          class="mt-2 min-h-[44px] w-full rounded border border-slate-400 bg-white px-3 py-3 text-sm text-slate-700"
        >
          <option value="">All categories</option>
          {categories.map((cat) => (
            <option value={cat}>
              {cat} ({categoryStats[cat]})
            </option>
          ))}
        </select>
      </div>
      <div>
        <label
          for="sort-select"
          class="block text-sm font-semibold text-slate-900"
        >
          Sort by
        </label>
        <select
          id="sort-select"
          class="mt-2 min-h-[44px] w-full rounded border border-slate-400 bg-white px-3 py-3 text-sm text-slate-700"
        >
          <option value="featured">Featured</option>
          <option value="name">Name</option>
          <option value="year">Year established</option>
          <option value="category">Category</option>
        </select>
      </div>
      <button
        id="clear-filters"
        class="hidden min-h-[44px] text-left text-sm font-medium text-primary-800 underline underline-offset-4"
      >
        Clear filters
      </button>
    </section>

    <!-- Results header -->
    <!-- The site cards below are h3. This h2 gives them a section to sit under
         so the page outline does not jump from h1 straight to h3. It is hidden
         because the visible heading for this list is the page h1. -->
    <h2 class="sr-only">Registered sites</h2>
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between mb-6">
      <p id="results-summary" role="status" class="text-sm text-slate-600">
        {allSites.length} site records
      </p>
    </div>

    <!-- Sites Grid — all sites rendered, filtered via JS -->
    <div id="sites-grid" class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {allSites.map((site) => {
        const slug = site.file.split("/").pop().replace(".md", "");
        const isAtRisk =
          site.frontmatter.condition === "poor" ||
          site.frontmatter.condition === "ruins";
        return (
          <article
            class="site-card flex flex-col rounded border border-slate-200 bg-white overflow-hidden transition-shadow"
            data-title={site.frontmatter.title?.toLowerCase() || ""}
            data-description={site.frontmatter.description?.toLowerCase() || ""}
            data-category={site.frontmatter.category || ""}
            data-zone={site.frontmatter.campZone?.toLowerCase() || ""}
            data-alt-names={
              site.frontmatter.alternativeNames?.toLowerCase() || ""
            }
            data-year={site.frontmatter.yearEstablished || ""}
            data-featured={site.frontmatter.featured ? "1" : "0"}
          >
            <a
              href={`/site-register/${slug}`}
              class="aspect-[4/3] overflow-hidden border-b border-slate-200 bg-slate-100 block relative"
            >
              {site.frontmatter.image ? (
                <img
                  src={site.frontmatter.image}
                  alt={site.frontmatter.title}
                  class="h-full w-full object-cover"
                  loading="lazy"
                />
              ) : (
                <div class="flex h-full items-center justify-center text-slate-400">
                  <svg
                    class="h-12 w-12"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="1.8"
                      d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                    />
                  </svg>
                </div>
              )}
              {site.frontmatter.featured && (
                <div
                  class="absolute top-3 right-3 rounded-full bg-slate-900 text-white p-1.5 shadow-sm"
                  title="Featured Heritage Site"
                >
                  <svg
                    class="w-3.5 h-3.5"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                  >
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                </div>
              )}
              {isAtRisk && (
                <div class="absolute top-3 left-3 rounded bg-red-600 text-white px-2 py-0.5 text-xs font-semibold shadow-sm">
                  At Risk
                </div>
              )}
            </a>

            <div class="p-5 flex flex-col flex-grow">
              <div class="flex flex-wrap items-center gap-2 mb-3">
                {site.frontmatter.category && (
                  <span class="rounded border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700">
                    {site.frontmatter.category}
                  </span>
                )}
                {site.frontmatter.yearEstablished && (
                  <span class="text-xs text-slate-500">
                    Est. {site.frontmatter.yearEstablished}
                  </span>
                )}
                {site.frontmatter.referenceId && (
                  <span class="rounded border border-slate-200 px-2.5 py-1 text-xs font-mono text-slate-400">
                    {site.frontmatter.referenceId}
                  </span>
                )}
              </div>

              <a href={`/site-register/${slug}`}>
                <h3 class="text-lg font-semibold text-slate-900">
                  {site.frontmatter.title}
                </h3>
              </a>

              {site.frontmatter.campZone && (
                <p class="mt-1.5 text-sm text-slate-500 flex items-center">
                  <svg
                    class="w-3.5 h-3.5 mr-1.5 flex-shrink-0"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                  </svg>
                  {site.frontmatter.campZone}
                </p>
              )}

              <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-600 flex-grow">
                {site.frontmatter.description ||
                  "Description not yet available."}
              </p>

              <div class="mt-5 pt-4 border-t border-slate-100">
                <a
                  href={`/site-register/${slug}`}
                  class="text-sm font-medium text-slate-900 hover:text-slate-700"
                >
                  View site details &rarr;
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Empty state (hidden by default) -->
    <div
      id="empty-state"
      class="hidden rounded border border-slate-200 bg-white p-5 sm:p-8 text-center"
    >
      <h3 class="text-lg font-semibold text-slate-900">No sites found</h3>
      <p id="empty-message" class="mt-2 text-sm leading-6 text-slate-600"></p>
      <button
        id="empty-clear"
        class="min-h-[44px] mt-4 text-sm font-medium text-slate-900 hover:text-slate-700"
      >
        Clear all filters &rarr;
      </button>
    </div>

    <!-- Pagination -->
    <nav
      id="pagination"
      aria-label="Site results pages"
      class="mt-10 rounded border border-slate-200 bg-white p-5"
    >
      <div
        class="flex flex-wrap items-center gap-2"
        id="pagination-controls"
      ></div>
    </nav>

    <section class="mt-16 grid gap-5 lg:grid-cols-2">
      <div class="rounded border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-semibold text-slate-900">Nominate a site</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          Share information about a place that should be documented in the
          register. Help preserve community memory.
        </p>
        <a
          href="/site-register/submit"
          class="mt-5 inline-block text-sm font-medium text-slate-900 hover:text-slate-700"
        >
          Start nomination &rarr;
        </a>
      </div>
      <div class="rounded border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-semibold text-slate-900">Report an issue</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          Send corrections or flag problems with an existing site listing to
          help keep the archive accurate.
        </p>
        <a
          href="/site-register/report-issue"
          class="mt-5 inline-block text-sm font-medium text-slate-900 hover:text-slate-700"
        >
          Report now &rarr;
        </a>
      </div>
    </section>
  </div>
</MainLayout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  const ITEMS_PER_PAGE = 6;
  let currentPage = Math.max(
    1,
    Number.parseInt(
      new URLSearchParams(window.location.search).get("page") || "1",
      10,
    ) || 1,
  );
  let activeCategory = "";
  let searchQuery = "";
  let sortBy = "featured";

  const allCards = Array.from(document.querySelectorAll(".site-card"));
  const grid = document.getElementById("sites-grid");
  const emptyState = document.getElementById("empty-state");
  const emptyMessage = document.getElementById("empty-message");
  const emptyClear = document.getElementById("empty-clear");
  const resultsSummary = document.getElementById("results-summary");
  const paginationNav = document.getElementById("pagination");
  const paginationControls = document.getElementById("pagination-controls");
  const searchInput = document.getElementById(
    "site-search",
  ) as HTMLInputElement;
  const categorySelect = document.getElementById(
    "category-select",
  ) as HTMLSelectElement;
  const sortSelect = document.getElementById(
    "sort-select",
  ) as HTMLSelectElement;
  const clearBtn = document.getElementById("clear-filters");

  function getFilteredCards() {
    return allCards.filter((card) => {
      const title = card.getAttribute("data-title") || "";
      const desc = card.getAttribute("data-description") || "";
      const zone = card.getAttribute("data-zone") || "";
      const altNames = card.getAttribute("data-alt-names") || "";
      const category = card.getAttribute("data-category") || "";

      // Category filter
      if (activeCategory && category !== activeCategory) return false;

      // Search filter
      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        if (
          !title.includes(q) &&
          !desc.includes(q) &&
          !zone.includes(q) &&
          !altNames.includes(q) &&
          !category.toLowerCase().includes(q)
        ) {
          return false;
        }
      }

      return true;
    });
  }

  function sortCards(cards: Element[]) {
    return [...cards].sort((a, b) => {
      if (sortBy === "name") {
        return (a.getAttribute("data-title") || "").localeCompare(
          b.getAttribute("data-title") || "",
        );
      }
      if (sortBy === "year") {
        const ya = parseInt(a.getAttribute("data-year") || "9999");
        const yb = parseInt(b.getAttribute("data-year") || "9999");
        return ya - yb;
      }
      if (sortBy === "category") {
        return (a.getAttribute("data-category") || "").localeCompare(
          b.getAttribute("data-category") || "",
        );
      }
      // Default: featured first
      const fa = a.getAttribute("data-featured") === "1" ? 0 : 1;
      const fb = b.getAttribute("data-featured") === "1" ? 0 : 1;
      if (fa !== fb) return fa - fb;
      return (a.getAttribute("data-title") || "").localeCompare(
        b.getAttribute("data-title") || "",
      );
    });
  }

  function render() {
    const filtered = sortCards(getFilteredCards());
    const totalPages = Math.max(1, Math.ceil(filtered.length / ITEMS_PER_PAGE));
    if (currentPage > totalPages) currentPage = totalPages;

    const start = (currentPage - 1) * ITEMS_PER_PAGE;
    const end = start + ITEMS_PER_PAGE;
    const visible = filtered.slice(start, end);

    // Hide all cards, show only visible
    allCards.forEach((c) => ((c as HTMLElement).style.display = "none"));
    visible.forEach((c) => ((c as HTMLElement).style.display = "flex"));
    grid?.append(...visible);

    // Empty state
    if (filtered.length === 0) {
      emptyState!.classList.remove("hidden");
      grid!.classList.add("hidden");
      emptyMessage!.textContent = searchQuery
        ? `No sites match "${searchQuery}". Try a different search term.`
        : "No sites match the current filters.";
    } else {
      emptyState!.classList.add("hidden");
      grid!.classList.remove("hidden");
    }

    // Results summary
    if (filtered.length > 0) {
      let text = `Showing ${start + 1}–${Math.min(end, filtered.length)} of ${filtered.length} sites`;
      if (activeCategory) text += ` in ${activeCategory}`;
      if (searchQuery) text = `Results for "${searchQuery}" · ${text}`;
      resultsSummary!.textContent = text;
    } else {
      resultsSummary!.textContent = "";
    }

    // Sync category select
    if (categorySelect && categorySelect.value !== activeCategory) {
      categorySelect.value = activeCategory;
    }

    // Clear button visibility
    if (searchQuery || activeCategory || sortBy !== "featured") {
      clearBtn!.classList.remove("hidden");
    } else {
      clearBtn!.classList.add("hidden");
    }

    // Pagination
    if (totalPages <= 1) {
      paginationNav!.classList.add("hidden");
    } else {
      paginationNav!.classList.remove("hidden");
      let html = "";

      // Previous
      if (currentPage > 1) {
        html += `<button data-page="${currentPage - 1}" class="min-h-[44px] page-btn inline-flex items-center rounded border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">Previous</button>`;
      } else {
        html += `<span class="inline-flex items-center rounded border border-slate-200 px-4 py-2 text-sm text-slate-400">Previous</span>`;
      }

      // Page numbers
      html += '<div class="flex flex-wrap items-center gap-1">';
      for (let i = 1; i <= totalPages; i++) {
        if (i === currentPage) {
          html += `<span aria-current="page" class="inline-flex min-h-[44px] items-center rounded border border-slate-900 bg-slate-900 px-3 py-2 text-sm font-medium text-white">${i}</span>`;
        } else {
          html += `<button data-page="${i}" class="min-h-[44px] page-btn inline-flex items-center rounded border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">${i}</button>`;
        }
      }
      html += "</div>";

      // Next
      if (currentPage < totalPages) {
        html += `<button data-page="${currentPage + 1}" class="min-h-[44px] page-btn inline-flex items-center rounded border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">Next</button>`;
      } else {
        html += `<span class="inline-flex items-center rounded border border-slate-200 px-4 py-2 text-sm text-slate-400">Next</span>`;
      }

      paginationControls!.innerHTML = html;

      // Attach page click handlers
      paginationControls!.querySelectorAll(".page-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          currentPage = parseInt(btn.getAttribute("data-page") || "1");
          render();
          window.scrollTo({ top: grid!.offsetTop - 80, behavior: "smooth" });
        });
      });
    }
  }

  // Event listeners
  let searchTimeout: ReturnType<typeof setTimeout>;
  searchInput?.addEventListener("input", () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      searchQuery = searchInput.value.trim();
      currentPage = 1;
      render();
    }, 250);
  });

  sortSelect?.addEventListener("change", () => {
    sortBy = sortSelect.value;
    currentPage = 1;
    render();
  });

  categorySelect?.addEventListener("change", () => {
    activeCategory = categorySelect.value;
    currentPage = 1;
    render();
  });

  clearBtn?.addEventListener("click", () => {
    searchQuery = "";
    activeCategory = "";
    sortBy = "featured";
    currentPage = 1;
    searchInput!.value = "";
    sortSelect!.value = "featured";
    categorySelect!.value = "";
    render();
  });

  emptyClear?.addEventListener("click", () => {
    searchQuery = "";
    activeCategory = "";
    sortBy = "featured";
    currentPage = 1;
    searchInput!.value = "";
    sortSelect!.value = "featured";
    categorySelect!.value = "";
    render();
  });

  // Initial render
  render();
</script>
