---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { formatDate } from '../utils/dateHelpers';

const title = "Dzaleka Heritage Site Register | Dzaleka Online Services";
const description = "A community-led record documenting cultural, historical, and natural heritage sites in the Dzaleka community.";

// Load all site content and related updates at build time
let allSites = [];
let latestNews = [];
let latestEvents = [];
let latestResources = [];

try {
  allSites = Object.values(import.meta.glob('../content/sites/*.md', { eager: true }));
  
  const news = Object.values(import.meta.glob('../content/news/*.md', { eager: true }));
  latestNews = news.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf()).slice(0, 3);
  
  const events = Object.values(import.meta.glob('../content/events/*.md', { eager: true }));
  latestEvents = events.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf()).slice(0, 3);
  
  const resources = Object.values(import.meta.glob('../content/resources/*.md', { eager: true }));
  latestResources = resources.sort((a, b) => {
    const dateA = new Date(a.frontmatter.date || a.frontmatter.lastUpdated || 0).valueOf();
    const dateB = new Date(b.frontmatter.date || b.frontmatter.lastUpdated || 0).valueOf();
    return dateB - dateA;
  }).slice(0, 3);
} catch (error) {
  console.error('Error loading content:', error);
  allSites = [];
}

// Sort: featured first, then alphabetical
allSites.sort((a, b) => {
  if (a.frontmatter.featured && !b.frontmatter.featured) return -1;
  if (!a.frontmatter.featured && b.frontmatter.featured) return 1;
  return a.frontmatter.title.localeCompare(b.frontmatter.title);
});

// Extract unique categories + compute stats
const categories = [...new Set(allSites.map(s => s.frontmatter.category).filter(Boolean))].sort();
const categoryStats = {};
categories.forEach(cat => {
  categoryStats[cat] = allSites.filter(s => s.frontmatter.category === cat).length;
});
const atRiskCount = allSites.filter(s => s.frontmatter.condition === 'poor' || s.frontmatter.condition === 'ruins').length;
---

<MainLayout title={title} description={description} canonical="https://services.dzaleka.com/site-register">
  {/* Schema.org ItemList Structured Data */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Dzaleka Heritage Site Register",
    "description": description,
    "url": "https://services.dzaleka.com/site-register",
    "numberOfItems": allSites.length,
    "itemListElement": allSites.map((s, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": s.frontmatter.title,
      "url": `https://services.dzaleka.com/site-register/${s.file.split('/').pop().replace('.md', '')}`
    }))
  })} />
  <!-- Header -->
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="mb-4">
        <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Site Register' }]} />
      </div>
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-sky-700 mb-2">
          Heritage Register & Inscriptions
        </p>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
          Dzaleka Heritage Site Register
        </h1>
        <p class="mt-4 text-base leading-7 text-slate-600 sm:text-lg">
          A community-led record documenting cultural, historical, educational, and natural heritage sites within Dzaleka Refugee Camp and surrounding Dowa host communities.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href="/explore" class="inline-flex items-center rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-slate-800 transition-colors shadow-sm">
            Explore GIS Map &rarr;
          </a>
          <a href="/site-register/submit" class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 transition-colors">
            Submit a Site
          </a>
        </div>
        <div class="mt-4 flex items-center gap-4 text-xs text-slate-500">
          <a href="/site-register/about" class="hover:text-slate-900 hover:underline">
            About the Register
          </a>
          <span>&bull;</span>
          <a href="/site-register/license" class="hover:text-slate-900 hover:underline">
            License & Usage Policy
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-3 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
        <span class="font-medium text-slate-900">{allSites.length} properties inscribed</span>
        {atRiskCount > 0 && (
          <>
            <span class="hidden sm:inline text-slate-300">|</span>
            <span class="text-red-600 font-medium">{atRiskCount} at risk</span>
          </>
        )}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">

    <!-- Search + Sort Controls -->
    <section class="mb-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="relative flex-grow max-w-md">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="site-search"
            placeholder="Search sites by name, location, or category..."
            class="w-full rounded-lg border border-slate-300 bg-white pl-10 pr-4 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
          />
        </div>

        <div class="flex items-center gap-3">
          <label for="category-select" class="text-sm text-slate-500 whitespace-nowrap hidden sm:inline">Category</label>
          <select
            id="category-select"
            class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
          >
            <option value="">All Categories</option>
            {categories.map(cat => (
              <option value={cat}>{cat} ({categoryStats[cat]})</option>
            ))}
          </select>

          <label for="sort-select" class="text-sm text-slate-500 whitespace-nowrap hidden sm:inline">Sort by</label>
          <select
            id="sort-select"
            class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700 focus:border-slate-500 focus:outline-none focus:ring-1 focus:ring-slate-500"
          >
            <option value="featured">Featured</option>
            <option value="name">Name</option>
            <option value="year">Year Established</option>
            <option value="category">Category</option>
          </select>

          <button id="clear-filters" class="hidden text-sm text-slate-500 hover:text-slate-700 whitespace-nowrap">
            Clear filters
          </button>
        </div>
      </div>
    </section>

    <!-- Results header -->
    <!-- The site cards below are h3. This h2 gives them a section to sit under
         so the page outline does not jump from h1 straight to h3. It is hidden
         because the visible heading for this list is the page h1. -->
    <h2 class="sr-only">Registered sites</h2>
    <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between mb-6">
      <p id="results-summary" class="text-sm text-slate-500"></p>
    </div>

    <!-- Sites Grid — all sites rendered, filtered via JS -->
    <div id="sites-grid" class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {allSites.map((site) => {
        const slug = site.file.split('/').pop().replace('.md', '');
        const isAtRisk = site.frontmatter.condition === 'poor' || site.frontmatter.condition === 'ruins';
        return (
          <article
            class="site-card flex flex-col rounded-lg border border-slate-200 bg-white overflow-hidden hover:shadow-md transition-shadow"
            data-title={site.frontmatter.title?.toLowerCase() || ''}
            data-description={site.frontmatter.description?.toLowerCase() || ''}
            data-category={site.frontmatter.category || ''}
            data-zone={site.frontmatter.campZone?.toLowerCase() || ''}
            data-alt-names={site.frontmatter.alternativeNames?.toLowerCase() || ''}
            data-year={site.frontmatter.yearEstablished || ''}
            data-featured={site.frontmatter.featured ? '1' : '0'}
          >
            <a href={`/site-register/${slug}`} class="aspect-[4/3] overflow-hidden border-b border-slate-200 bg-slate-100 block relative">
              {site.frontmatter.image ? (
                <img src={site.frontmatter.image} alt={site.frontmatter.title} class="h-full w-full object-cover" loading="lazy" />
              ) : (
                <div class="flex h-full items-center justify-center text-slate-400">
                  <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </div>
              )}
              {site.frontmatter.featured && (
                <div class="absolute top-3 right-3 rounded-full bg-slate-900 text-white p-1.5 shadow-sm" title="Featured Heritage Site">
                  <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                </div>
              )}
              {isAtRisk && (
                <div class="absolute top-3 left-3 rounded-md bg-red-600 text-white px-2 py-0.5 text-xs font-semibold shadow-sm">
                  At Risk
                </div>
              )}
            </a>

            <div class="p-5 flex flex-col flex-grow">
              <div class="flex flex-wrap items-center gap-2 mb-3">
                {site.frontmatter.category && (
                  <span class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700">
                    {site.frontmatter.category}
                  </span>
                )}
                {site.frontmatter.yearEstablished && (
                  <span class="text-xs text-slate-500">Est. {site.frontmatter.yearEstablished}</span>
                )}
                {site.frontmatter.referenceId && (
                  <span class="rounded-md border border-slate-200 px-2.5 py-1 text-xs font-mono text-slate-400">
                    {site.frontmatter.referenceId}
                  </span>
                )}
              </div>

              <a href={`/site-register/${slug}`}>
                <h3 class="text-lg font-semibold text-slate-900">{site.frontmatter.title}</h3>
              </a>

              {site.frontmatter.campZone && (
                <p class="mt-1.5 text-sm text-slate-500 flex items-center">
                  <svg class="w-3.5 h-3.5 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  {site.frontmatter.campZone}
                </p>
              )}

              <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-600 flex-grow">
                {site.frontmatter.description || 'Description not yet available.'}
              </p>

              <div class="mt-5 pt-4 border-t border-slate-100">
                <a href={`/site-register/${slug}`} class="text-sm font-medium text-slate-900 hover:text-slate-700">
                  View site details &rarr;
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Empty state (hidden by default) -->
    <div id="empty-state" class="hidden rounded-lg border border-slate-200 bg-white p-8 text-center">
      <h3 class="text-lg font-semibold text-slate-900">No sites found</h3>
      <p id="empty-message" class="mt-2 text-sm leading-6 text-slate-600"></p>
      <button id="empty-clear" class="mt-4 text-sm font-medium text-slate-900 hover:text-slate-700">
        Clear all filters &rarr;
      </button>
    </div>

    <!-- Pagination -->
    <nav id="pagination" class="mt-10 rounded-lg border border-slate-200 bg-white p-5">
      <div class="flex items-center gap-2" id="pagination-controls"></div>
    </nav>

    <!-- Latest Updates Section -->
    <section class="mt-16 pt-10 border-t border-slate-200">
      <div class="mb-8">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Latest Updates</h2>
        <p class="mt-2 text-sm text-slate-600">News, events, and publications related to the Dzaleka community.</p>
      </div>
      
      <div class="grid gap-8 lg:grid-cols-3">
        <!-- News -->
        <div>
          <h3 class="text-lg font-semibold text-slate-900 mb-4 flex items-center justify-between">
            News
            <a href="/news" class="text-sm font-medium text-slate-500 hover:text-slate-900">View all &rarr;</a>
          </h3>
          <div class="space-y-4">
            {latestNews.map((item) => {
              const slug = item.file.split('/').pop().replace('.md', '');
              return (
                <a href={`/news/${slug}`} class="group block border-l-2 border-slate-200 pl-4 hover:border-slate-900 transition-colors">
                  <p class="text-xs text-slate-500 mb-1">{formatDate(item.frontmatter.date)}</p>
                  <h4 class="text-sm font-medium text-slate-900 group-hover:underline decoration-1 underline-offset-2">{item.frontmatter.title}</h4>
                </a>
              );
            })}
          </div>
        </div>

        <!-- Events -->
        <div>
          <h3 class="text-lg font-semibold text-slate-900 mb-4 flex items-center justify-between">
            Events
            <a href="/events" class="text-sm font-medium text-slate-500 hover:text-slate-900">View all &rarr;</a>
          </h3>
          <div class="space-y-4">
            {latestEvents.map((item) => {
              const slug = item.file.split('/').pop().replace('.md', '');
              return (
                <a href={`/events/${slug}`} class="group block border-l-2 border-slate-200 pl-4 hover:border-slate-900 transition-colors">
                  <p class="text-xs text-slate-500 mb-1">{formatDate(item.frontmatter.date)}</p>
                  <h4 class="text-sm font-medium text-slate-900 group-hover:underline decoration-1 underline-offset-2">{item.frontmatter.title}</h4>
                </a>
              );
            })}
          </div>
        </div>

        <!-- Publications -->
        <div>
          <h3 class="text-lg font-semibold text-slate-900 mb-4 flex items-center justify-between">
            Publications
            <a href="/resources" class="text-sm font-medium text-slate-500 hover:text-slate-900">View all &rarr;</a>
          </h3>
          <div class="space-y-4">
            {latestResources.map((item) => {
              const slug = item.file.split('/').pop().replace('.md', '');
              return (
                <a href={`/resources/${slug}`} class="group block border-l-2 border-slate-200 pl-4 hover:border-slate-900 transition-colors">
                  <p class="text-xs text-slate-500 mb-1">{item.frontmatter.category || 'Resource'}</p>
                  <h4 class="text-sm font-medium text-slate-900 group-hover:underline decoration-1 underline-offset-2">{item.frontmatter.title}</h4>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <section class="mt-16 grid gap-5 lg:grid-cols-2">
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-semibold text-slate-900">Nominate a site</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          Share information about a place that should be documented in the register. Help preserve community memory.
        </p>
        <a href="/site-register/submit" class="mt-5 inline-block text-sm font-medium text-slate-900 hover:text-slate-700">
          Start nomination &rarr;
        </a>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-semibold text-slate-900">Report an issue</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          Send corrections or flag problems with an existing site listing to help keep the archive accurate.
        </p>
        <a href="/site-register/report-issue" class="mt-5 inline-block text-sm font-medium text-slate-900 hover:text-slate-700">
          Report now &rarr;
        </a>
      </div>
    </section>
  </div>
</MainLayout>

<style>
.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>

<script>
  const ITEMS_PER_PAGE = 6;
  let currentPage = 1;
  let activeCategory = '';
  let searchQuery = '';
  let sortBy = 'featured';

  const allCards = Array.from(document.querySelectorAll('.site-card'));
  const grid = document.getElementById('sites-grid');
  const emptyState = document.getElementById('empty-state');
  const emptyMessage = document.getElementById('empty-message');
  const emptyClear = document.getElementById('empty-clear');
  const resultsSummary = document.getElementById('results-summary');
  const paginationNav = document.getElementById('pagination');
  const paginationControls = document.getElementById('pagination-controls');
  const searchInput = document.getElementById('site-search') as HTMLInputElement;
  const categorySelect = document.getElementById('category-select') as HTMLSelectElement;
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement;
  const clearBtn = document.getElementById('clear-filters');

  function getFilteredCards() {
    return allCards.filter(card => {
      const title = card.getAttribute('data-title') || '';
      const desc = card.getAttribute('data-description') || '';
      const zone = card.getAttribute('data-zone') || '';
      const altNames = card.getAttribute('data-alt-names') || '';
      const category = card.getAttribute('data-category') || '';

      // Category filter
      if (activeCategory && category !== activeCategory) return false;

      // Search filter
      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        if (!title.includes(q) && !desc.includes(q) && !zone.includes(q) && !altNames.includes(q) && !category.toLowerCase().includes(q)) {
          return false;
        }
      }

      return true;
    });
  }

  function sortCards(cards: Element[]) {
    return [...cards].sort((a, b) => {
      if (sortBy === 'name') {
        return (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '');
      }
      if (sortBy === 'year') {
        const ya = parseInt(a.getAttribute('data-year') || '9999');
        const yb = parseInt(b.getAttribute('data-year') || '9999');
        return ya - yb;
      }
      if (sortBy === 'category') {
        return (a.getAttribute('data-category') || '').localeCompare(b.getAttribute('data-category') || '');
      }
      // Default: featured first
      const fa = a.getAttribute('data-featured') === '1' ? 0 : 1;
      const fb = b.getAttribute('data-featured') === '1' ? 0 : 1;
      if (fa !== fb) return fa - fb;
      return (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '');
    });
  }

  function render() {
    const filtered = sortCards(getFilteredCards());
    const totalPages = Math.max(1, Math.ceil(filtered.length / ITEMS_PER_PAGE));
    if (currentPage > totalPages) currentPage = totalPages;

    const start = (currentPage - 1) * ITEMS_PER_PAGE;
    const end = start + ITEMS_PER_PAGE;
    const visible = filtered.slice(start, end);

    // Hide all cards, show only visible
    allCards.forEach(c => (c as HTMLElement).style.display = 'none');
    visible.forEach(c => (c as HTMLElement).style.display = 'flex');

    // Empty state
    if (filtered.length === 0) {
      emptyState!.classList.remove('hidden');
      grid!.classList.add('hidden');
      emptyMessage!.textContent = searchQuery
        ? `No sites match "${searchQuery}". Try a different search term.`
        : 'No sites match the current filters.';
    } else {
      emptyState!.classList.add('hidden');
      grid!.classList.remove('hidden');
    }

    // Results summary
    if (filtered.length > 0) {
      let text = `Showing ${start + 1}–${Math.min(end, filtered.length)} of ${filtered.length} sites`;
      if (activeCategory) text += ` in ${activeCategory}`;
      if (searchQuery) text = `Results for "${searchQuery}" · ${text}`;
      resultsSummary!.textContent = text;
    } else {
      resultsSummary!.textContent = '';
    }

    // Sync category select
    if (categorySelect && categorySelect.value !== activeCategory) {
      categorySelect.value = activeCategory;
    }

    // Clear button visibility
    if (searchQuery || activeCategory || sortBy !== 'featured') {
      clearBtn!.classList.remove('hidden');
    } else {
      clearBtn!.classList.add('hidden');
    }

    // Pagination
    if (totalPages <= 1) {
      paginationNav!.classList.add('hidden');
    } else {
      paginationNav!.classList.remove('hidden');
      let html = '';

      // Previous
      if (currentPage > 1) {
        html += `<button data-page="${currentPage - 1}" class="page-btn inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">Previous</button>`;
      } else {
        html += `<span class="inline-flex items-center rounded-lg border border-slate-200 px-4 py-2 text-sm text-slate-400">Previous</span>`;
      }

      // Page numbers
      html += '<div class="flex items-center gap-1">';
      for (let i = 1; i <= totalPages; i++) {
        if (i === currentPage) {
          html += `<span class="inline-flex items-center rounded-lg border border-slate-900 bg-slate-900 px-3 py-2 text-sm font-medium text-white">${i}</span>`;
        } else {
          html += `<button data-page="${i}" class="page-btn inline-flex items-center rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">${i}</button>`;
        }
      }
      html += '</div>';

      // Next
      if (currentPage < totalPages) {
        html += `<button data-page="${currentPage + 1}" class="page-btn inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">Next</button>`;
      } else {
        html += `<span class="inline-flex items-center rounded-lg border border-slate-200 px-4 py-2 text-sm text-slate-400">Next</span>`;
      }

      paginationControls!.innerHTML = html;

      // Attach page click handlers
      paginationControls!.querySelectorAll('.page-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          currentPage = parseInt(btn.getAttribute('data-page') || '1');
          render();
          window.scrollTo({ top: grid!.offsetTop - 80, behavior: 'smooth' });
        });
      });
    }
  }

  // Event listeners
  let searchTimeout: ReturnType<typeof setTimeout>;
  searchInput?.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      searchQuery = searchInput.value.trim();
      currentPage = 1;
      render();
    }, 250);
  });

  sortSelect?.addEventListener('change', () => {
    sortBy = sortSelect.value;
    currentPage = 1;
    render();
  });

  categorySelect?.addEventListener('change', () => {
    activeCategory = categorySelect.value;
    currentPage = 1;
    render();
  });

  clearBtn?.addEventListener('click', () => {
    searchQuery = '';
    activeCategory = '';
    sortBy = 'featured';
    currentPage = 1;
    searchInput!.value = '';
    sortSelect!.value = 'featured';
    categorySelect!.value = '';
    render();
  });

  emptyClear?.addEventListener('click', () => {
    searchQuery = '';
    activeCategory = '';
    sortBy = 'featured';
    currentPage = 1;
    searchInput!.value = '';
    sortSelect!.value = 'featured';
    categorySelect!.value = '';
    render();
  });

  // Initial render
  render();
</script>
