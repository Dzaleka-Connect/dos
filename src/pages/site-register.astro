---
import Layout from '../layouts/Layout.astro';
import MainLayout from '../layouts/MainLayout.astro';

const title = "Dzaleka Online Services";
const description = "Explore important cultural, historical, and community locations in and around Dzaleka Refugee Camp. Discover the rich heritage and significance of these sites through detailed documentation, photos, and stories.";

// Pagination settings
const itemsPerPage = 9; // Show 9 items per page (3x3 grid)
const currentPage = 1; // Default to first page

// Dynamically import all site content
let sites = [];
try {
  sites = await Astro.glob('../content/sites/*.md');
} catch (error) {
  console.error('Error loading sites:', error);
  sites = [];
}

// Sort sites by featured status and title
sites.sort((a, b) => {
  if (a.frontmatter.featured && !b.frontmatter.featured) return -1;
  if (!a.frontmatter.featured && b.frontmatter.featured) return 1;
  return a.frontmatter.title.localeCompare(b.frontmatter.title);
});

// Calculate pagination
const totalItems = sites.length;
const totalPages = Math.ceil(totalItems / itemsPerPage);
const startIndex = (currentPage - 1) * itemsPerPage;
const endIndex = startIndex + itemsPerPage;
const currentSites = sites.slice(startIndex, endIndex);

// Generate pagination info
const pagination = {
  currentPage,
  totalPages,
  totalItems,
  hasNextPage: currentPage < totalPages,
  hasPrevPage: currentPage > 1,
  nextPage: currentPage + 1,
  prevPage: currentPage - 1,
  startItem: startIndex + 1,
  endItem: Math.min(endIndex, totalItems)
};
---

<MainLayout title={title} description={description}>
  <Layout>
    <!-- Hero Section -->
    <section class="border-b border-gray-200 bg-white mb-12">
      <div class="container mx-auto px-4 py-12 lg:py-16">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-block mb-6">
            <span class="px-4 py-1.5 bg-slate-100 text-slate-700 rounded-full text-sm font-medium border border-slate-200">
              Cultural Heritage
            </span>
          </div>

          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Dzaleka Site Register
          </h1>
          <p class="text-xl text-gray-600 mb-8 max-w-3xl mx-auto leading-relaxed">
            Discover and explore the cultural, historical, and community locations that shape the identity of Dzaleka Refugee Camp
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="#sites" class="inline-flex items-center px-6 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors font-medium">
              Explore Sites
            </a>
            <a href="/site-register/submit" class="inline-flex items-center px-6 py-3 border-2 border-gray-900 text-gray-900 bg-white rounded-lg hover:bg-slate-50 transition-colors font-medium">
              Submit a Site
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Sites Section -->
    <section id="sites" class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8">
          <h2 class="text-3xl font-bold text-gray-900 mb-3">Featured Sites</h2>
          <p class="text-lg text-gray-600">Explore significant locations in Dzaleka</p>
        </div>

        <!-- Dynamic site listings -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {currentSites.length > 0 ? (
            currentSites.map((site) => (
              <div class="bg-white rounded-lg shadow-sm overflow-hidden hover:shadow-md transition-all duration-200 border border-gray-100 hover:border-slate-300 flex flex-col">
                <div class="relative h-48 bg-gray-100">
                  {site.frontmatter.image ? (
                    <img src={site.frontmatter.image} alt={site.frontmatter.title} class="w-full h-full object-cover" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                      </svg>
                    </div>
                  )}
                  <div class="absolute top-3 left-3">
                    <span class="bg-slate-700 text-white px-3 py-1 rounded-full text-xs font-semibold">
                      {site.frontmatter.category}
                    </span>
                  </div>
                  {site.frontmatter.featured && (
                    <div class="absolute top-3 right-3">
                      <span class="bg-yellow-500 text-white px-2 py-1 rounded-full text-xs font-semibold">
                        Featured
                      </span>
                    </div>
                  )}
                </div>
                <div class="p-5 flex-grow flex flex-col">
                  <h3 class="text-lg font-bold text-gray-900 mb-2">
                    {site.frontmatter.title}
                  </h3>
                  <div class="flex items-center text-sm text-gray-500 mb-3">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>{site.frontmatter.campZone}</span>
                  </div>
                  <p class="text-gray-600 mb-4 line-clamp-3 text-sm flex-grow">
                    {site.frontmatter.description || 'Discover the cultural and historical significance of this important site in Dzaleka...'}
                  </p>
                  <a href={`/site-register/${site.file.split('/').pop().replace('.md', '')}`} class="inline-flex items-center justify-center px-4 py-2 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors text-sm font-medium mt-auto">
                    View Details
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                </div>
              </div>
            ))
          ) : (
            <div class="col-span-full text-center py-16">
              <div class="max-w-md mx-auto">
                <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                  <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">No Sites Yet</h3>
                <p class="text-gray-600 mb-6">Be the first to submit a cultural, historical, or community site!</p>
                <a href="/site-register/submit" class="inline-flex items-center bg-gray-900 text-white px-6 py-3 rounded-lg font-semibold hover:bg-gray-800 transition-colors">
                  Submit First Site
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                </a>
              </div>
            </div>
          )}
        </div>

        {/* Pagination Controls */}
        {totalPages > 1 && (
          <div class="mt-12">
            <div class="flex items-center justify-between">
              <div class="text-sm text-gray-600">
                Showing {pagination.startItem} to {pagination.endItem} of {pagination.totalItems} sites
              </div>
              
              <div class="flex items-center space-x-2">
                {pagination.hasPrevPage ? (
                  <a href={`/site-register?page=${pagination.prevPage}`} class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Previous
                  </a>
                ) : (
                  <button disabled class="inline-flex items-center px-4 py-2 border border-gray-200 rounded-lg text-sm font-medium text-gray-400 bg-gray-50 cursor-not-allowed">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Previous
                  </button>
                )}
                
                <div class="flex items-center space-x-1">
                  {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
                    pageNum === currentPage ? (
                      <span class="inline-flex items-center px-3 py-2 border-2 border-slate-700 rounded-lg text-sm font-medium text-slate-700 bg-slate-50">
                        {pageNum}
                      </span>
                    ) : (
                      <a href={`/site-register?page=${pageNum}`} class="inline-flex items-center px-3 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                        {pageNum}
                      </a>
                    )
                  ))}
                </div>
                
                {pagination.hasNextPage ? (
                  <a href={`/site-register?page=${pagination.nextPage}`} class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                    Next
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                ) : (
                  <button disabled class="inline-flex items-center px-4 py-2 border border-gray-200 rounded-lg text-sm font-medium text-gray-400 bg-gray-50 cursor-not-allowed">
                    Next
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </button>
                )}
              </div>
            </div>
          </div>
        )}
      </div>
    </section>

    <!-- Footer CTA -->
    <section class="py-12 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-3">Help Document Dzaleka's Heritage</h2>
        <p class="text-gray-600 mb-6">Share information about cultural, historical, or community sites</p>
        <a href="/site-register/submit" class="inline-flex items-center justify-center px-8 py-3 bg-gray-900 text-white font-semibold rounded-lg hover:bg-gray-800 transition-colors">
          Submit a New Site
        </a>
      </div>
    </section>
  </Layout>
</MainLayout>
