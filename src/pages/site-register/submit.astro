---
import MainLayout from '../../layouts/MainLayout.astro';
import FormHeader from '../../components/ui/FormHeader.astro';

const title = "Submit a Site - Dzaleka Online Services";
const description = "Submit information about a cultural, historical, or community site in Dzaleka Refugee Camp for inclusion in our digital register.";
---

<MainLayout title={title} description={description}>
    <FormHeader title="Submit a site" description="Document a cultural, historical or community place. Include its name, location, significance and any photographs or sources you can provide." parent="Site Register" href="/site-register" />

    <!-- Form Section -->
    <section class="py-10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded border border-slate-200 p-5 sm:p-8">
          <form id="submitForm" action="https://formspree.io/f/xqaaajae" method="POST" class="submission-form space-y-8">
            <!-- Basic Information -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Basic information</h2>

              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="siteName" class="block text-sm font-medium text-gray-700 mb-2">
                    Site/location name
                  </label>
                  <input
                    type="text"
                    id="siteName"
                    name="siteName"
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>

                <div>
                  <label for="alternativeNames" class="block text-sm font-medium text-gray-700 mb-2">
                    Alternative/local names <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="alternativeNames-hint" class="mb-1 text-sm text-slate-600">Any other names the site is known by</p>
                  <input aria-describedby="alternativeNames-hint"
                    type="text"
                    id="alternativeNames"
                    name="alternativeNames"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>
              </div>

              <div class="mt-6">
                <label for="yearEstablished" class="block text-sm font-medium text-gray-700 mb-2">
                  Year established <span class="font-normal text-slate-600">(optional)</span></label>
                <p id="yearEstablished-hint" class="mb-1 text-sm text-slate-600">For example, 1994</p>
                <input aria-describedby="yearEstablished-hint"
                  type="number"
                  id="yearEstablished"
                  name="yearEstablished"
                  min="1900"
                  max={new Date().getFullYear()}
                  class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                />
              </div>
            </div>

            <!-- Description -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Description</h2>

              <div class="space-y-6">
                <div>
                  <label for="siteDescription" class="block text-sm font-medium text-gray-700 mb-2">
                    Site description
                  </label>
                  <p id="siteDescription-hint" class="mb-1 text-sm text-slate-600">Provide a detailed description of the physical features, surroundings, and current use of the site</p>
                  <textarea aria-describedby="siteDescription-hint"
                    id="siteDescription"
                    name="siteDescription"
                    required
                    rows="6"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>

                <div>
                  <label for="significance" class="block text-sm font-medium text-gray-700 mb-2">
                    Statement of significance
                  </label>
                  <p id="significance-hint" class="mb-1 text-sm text-slate-600">Explain why this site matters historically, culturally, or socially to the Dzaleka community</p>
                  <textarea aria-describedby="significance-hint"
                    id="significance"
                    name="significance"
                    required
                    rows="6"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>

                <div>
                  <label for="associatedEvents" class="block text-sm font-medium text-gray-700 mb-2">
                    Associated events <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="associatedEvents-hint" class="mb-1 text-sm text-slate-600">Describe any important events, ceremonies, or activities that have taken place at this site</p>
                  <textarea aria-describedby="associatedEvents-hint"
                    id="associatedEvents"
                    name="associatedEvents"
                    rows="4"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>
              </div>
            </div>

            <!-- Location & Status -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Location & status</h2>

              <div>
                <label for="campZone" class="block text-sm font-medium text-gray-700 mb-2">
                  Camp zone location <span class="font-normal text-slate-600">(optional)</span></label>
                <p id="campZone-hint" class="mb-1 text-sm text-slate-600">For example, Zone A, Block 3, near the market</p>
                <input aria-describedby="campZone-hint"
                  type="text"
                  id="campZone"
                  name="campZone"
                  class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                />
              </div>

              <div class="mt-6">
                <fieldset>
                  <legend class="text-sm font-medium text-gray-700 mb-2">Legal status</legend>
                  <div class="mt-2 space-y-2">
                    <div class="flex items-start gap-3">
                      <input type="radio" id="legalStatus-1" name="legalStatus" value="public" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="legalStatus-1" class="text-sm text-gray-700">Public</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="legalStatus-2" name="legalStatus" value="private" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="legalStatus-2" class="text-sm text-gray-700">Private</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="legalStatus-3" name="legalStatus" value="protected" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="legalStatus-3" class="text-sm text-gray-700">Protected</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="legalStatus-4" name="legalStatus" value="restricted" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="legalStatus-4" class="text-sm text-gray-700">Restricted</label>
                    </div>
                  </div>
                </fieldset>
              </div>
            </div>

            <!-- Condition & Heritage Value -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Condition & heritage value</h2>

              <div class="space-y-6">
                <div>
                  <fieldset>
                    <legend class="text-sm font-medium text-gray-700 mb-2">Current condition</legend>
                    <div class="mt-2 space-y-2">
                      <div class="flex items-start gap-3">
                        <input type="radio" id="condition-1" name="condition" value="excellent" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="condition-1" class="text-sm text-gray-700">Excellent</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="condition-2" name="condition" value="good" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="condition-2" class="text-sm text-gray-700">Good</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="condition-3" name="condition" value="fair" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="condition-3" class="text-sm text-gray-700">Fair</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="condition-4" name="condition" value="poor" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="condition-4" class="text-sm text-gray-700">Poor</label>
                      </div>
                      <div class="flex items-start gap-3">
                        <input type="radio" id="condition-5" name="condition" value="ruins" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                        <label for="condition-5" class="text-sm text-gray-700">Ruins</label>
                      </div>
                    </div>
                  </fieldset>
                </div>

                <div>
                  <label for="integrity" class="block text-sm font-medium text-gray-700 mb-2">
                    Integrity <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="integrity-hint" class="mb-1 text-sm text-slate-600">How intact is the site? Describe any parts that have been lost or damaged over time</p>
                  <textarea aria-describedby="integrity-hint"
                    id="integrity"
                    name="integrity"
                    rows="3"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>

                <div>
                  <label for="authenticity" class="block text-sm font-medium text-gray-700 mb-2">
                    Authenticity <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="authenticity-hint" class="mb-1 text-sm text-slate-600">Does it maintain its original materials, character, and cultural use?</p>
                  <textarea aria-describedby="authenticity-hint"
                    id="authenticity"
                    name="authenticity"
                    rows="3"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>

                <div>
                  <label for="preservationNeeds" class="block text-sm font-medium text-gray-700 mb-2">
                    Preservation needs <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="preservationNeeds-hint" class="mb-1 text-sm text-slate-600">Describe any immediate or long-term preservation efforts required</p>
                  <textarea aria-describedby="preservationNeeds-hint"
                    id="preservationNeeds"
                    name="preservationNeeds"
                    rows="3"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  ></textarea>
                </div>

                <div>
                  <label for="linkedResources" class="block text-sm font-medium text-gray-700 mb-2">
                    Linked resources <span class="font-normal text-slate-600">(optional)</span></label>
                  <p id="linkedResources-hint" class="mb-1 text-sm text-slate-600">URL to articles, reports, videos, or other relevant resources</p>
                  <input aria-describedby="linkedResources-hint"
                    type="url"
                    id="linkedResources"
                    name="linkedResources"
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>
              </div>
            </div>

            <!-- Photos -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Photos</h2>

              <div>
                <p class="block text-sm font-medium text-gray-700 mb-2">
                  Upload photos
                </p>
                <div class="border-2 border-dashed border-gray-300 rounded p-6 text-center">
                  <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                    <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <div class="mt-4">
                    <label for="photo-upload" class="mb-2 block text-sm font-medium text-slate-700">Select photographs</label>
                    <input id="photo-upload" data-error-required="Choose at least one photograph." name="photos" type="file" multiple accept="image/*" class="block w-full" aria-describedby="photoUploadStatus" required />
                  </div>
                  <p class="mt-2 text-sm text-gray-600">
                    Upload multiple photos showing different angles and features of the site
                  </p>
                  <p id="photoUploadStatus" role="status" class="text-sm mt-2"></p>
                </div>
              </div>
              <!-- Hidden field for uploaded photo URLs -->
              <input type="hidden" name="photoUrls" id="photoUrlsInput" />
            </div>

            <!-- Contributor Information -->
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-6">Contributor information</h2>

              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="contributorName" class="block text-sm font-medium text-gray-700 mb-2">
                    Your name
                  </label>
                  <input
                    type="text"
                    id="contributorName"
                    name="contributorName"
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>

                <div>
                  <label for="contributorEmail" class="block text-sm font-medium text-gray-700 mb-2">
                    Your email
                  </label>
                  <input
                    type="email"
                    id="contributorEmail"
                    name="contributorEmail"
                    required
                    class="w-full px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-transparent"
                  />
                </div>
              </div>

              <div class="mt-6">
                <div class="flex items-start">
                  <input
                    type="checkbox"
                    id="consent"
                    data-error-required="Confirm that the information is accurate and you give permission to publish it."
                    name="consent"
                    required
                    class="mt-1 h-4 w-4 text-slate-600 focus:ring-slate-500 border-gray-300 rounded"
                  />
                  <label for="consent" class="ml-2 block text-sm text-gray-700">
                    I confirm this information is accurate and I give permission for it to be published on Dzaleka Online Services.
                  </label>
                </div>
              </div>
            </div>

            <!-- Submit Button -->
            <div class="flex justify-center">
              <button
                type="submit"
                id="submitButton"
                class="min-h-[44px] bg-primary-900 text-white px-8 py-3 rounded font-semibold hover:bg-primary-800 transition-colors focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 disabled:opacity-50"
              >
                <span id="submitText">Submit site</span>
                <span id="submitSpinner" class="hidden">
                  <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                </span>
              </button>
            </div>

          </form>
        </div>
      </div>
    </section>

  <script>
    import { initRecordSubmission } from '../../utils/recordSubmission';
    initRecordSubmission(document.getElementById('submitForm') as HTMLFormElement, 'site');
  </script>
</MainLayout>
