---
import Layout from '../../layouts/Layout.astro';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  // Dynamically import all site content
  let sites = [];
  try {
    sites = await Astro.glob('../../content/sites/*.md');
  } catch (error) {
    console.error('Error loading sites:', error);
    sites = [];
  }

  // Sort sites by featured status and title
  sites.sort((a, b) => {
    if (a.frontmatter.featured && !b.frontmatter.featured) return -1;
    if (!a.frontmatter.featured && b.frontmatter.featured) return 1;
    return a.frontmatter.title.localeCompare(b.frontmatter.title);
  });

  // Pagination settings
  const itemsPerPage = 9;
  const totalPages = Math.ceil(sites.length / itemsPerPage);

  // Generate paths for all pages
  const paths = [];
  for (let page = 1; page <= totalPages; page++) {
    paths.push({ params: { page: page.toString() } });
  }

  return paths;
}

const { page } = Astro.params;
const currentPage = parseInt(page) || 1;

const title = `Dzaleka Online Services - Page ${currentPage}`;
const description = "Explore important cultural, historical, and community locations in and around Dzaleka Refugee Camp. Discover the rich heritage and significance of these sites through detailed documentation, photos, and stories.";

// Pagination settings
const itemsPerPage = 9;

// Dynamically import all site content
let sites = [];
try {
  sites = await Astro.glob('../../content/sites/*.md');
} catch (error) {
  console.error('Error loading sites:', error);
  sites = [];
}

// Sort sites by featured status and title
sites.sort((a, b) => {
  if (a.frontmatter.featured && !b.frontmatter.featured) return -1;
  if (!a.frontmatter.featured && b.frontmatter.featured) return 1;
  return a.frontmatter.title.localeCompare(b.frontmatter.title);
});

// Calculate pagination
const totalItems = sites.length;
const totalPages = Math.ceil(totalItems / itemsPerPage);
const startIndex = (currentPage - 1) * itemsPerPage;
const endIndex = startIndex + itemsPerPage;
const currentSites = sites.slice(startIndex, endIndex);

// Generate pagination info
const pagination = {
  currentPage,
  totalPages,
  totalItems,
  hasNextPage: currentPage < totalPages,
  hasPrevPage: currentPage > 1,
  nextPage: currentPage + 1,
  prevPage: currentPage - 1,
  startItem: startIndex + 1,
  endItem: Math.min(endIndex, totalItems)
};
---

<MainLayout title={title} description={description}>
  <Layout>
    <!-- Hero Section -->
    <div class="relative bg-gradient-to-br from-blue-900 via-indigo-900 to-purple-900 text-white">
      <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('/images/dzaleka-hero.jpeg');"></div>
      <div class="absolute inset-0 bg-black/60"></div>
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
        <div class="mb-6">
          <span class="inline-flex items-center px-3 py-1 bg-white/10 backdrop-blur-sm rounded-full text-sm text-white/90">
            Independent Community Project
          </span>
        </div>
        
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold mb-6 leading-tight">
          Dzaleka Digital<br/>
          <span class="text-blue-300">Site Register</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-gray-200 max-w-3xl mx-auto mb-10 leading-relaxed">
          Discover and explore the cultural, historical, and community locations that shape the identity of Dzaleka Refugee Camp
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#sites" class="inline-flex items-center px-6 py-3 bg-white text-blue-900 font-semibold rounded-lg hover:bg-gray-100 transition-colors">
            Explore Sites
          </a>
          <a href="/site-register/submit" class="inline-flex items-center px-6 py-3 border-2 border-white/30 text-white font-semibold rounded-lg hover:bg-white/10 transition-colors">
            Submit a Site
          </a>
        </div>
      </div>
    </div>

    <!-- Quick Info Section -->
    <section class="py-12 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-blue-50 rounded-xl p-8 text-center">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Independent Community Project</h2>
          <p class="text-gray-700 mb-6 leading-relaxed max-w-2xl mx-auto">
            The Dzaleka Online Services is an independent online record of important places in and around Dzaleka Refugee Camp. 
            It is not managed or endorsed by camp authorities, but exists to preserve and document cultural heritage.
          </p>
          <a href="/site-register/about" class="inline-flex items-center bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors">
            Learn More About This Project
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Featured Sites Section -->
    <section id="sites" class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Featured Sites</h2>
          <p class="text-lg text-gray-600">Explore some of the most significant locations in Dzaleka</p>
        </div>

        <!-- Dynamic site listings -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {currentSites.length > 0 ? (
            currentSites.map((site) => (
              <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300 group">
                <div class="relative h-56 bg-gradient-to-br from-blue-50 to-indigo-100">
                  {site.frontmatter.image ? (
                    <img src={site.frontmatter.image} alt={site.frontmatter.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <svg class="w-16 h-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                      </svg>
                    </div>
                  )}
                  <div class="absolute top-4 left-4">
                    <span class="bg-blue-600 text-white px-3 py-1 rounded-full text-xs font-medium">
                      {site.frontmatter.category}
                    </span>
                  </div>
                  {site.frontmatter.featured && (
                    <div class="absolute top-4 right-4">
                      <span class="bg-yellow-500 text-white px-2 py-1 rounded-full text-xs font-medium">
                        Featured
                      </span>
                    </div>
                  )}
                </div>
                <div class="p-6">
                  <div class="flex items-start justify-between mb-3">
                    <h3 class="text-xl font-bold text-gray-900 group-hover:text-blue-600 transition-colors">
                      {site.frontmatter.title}
                    </h3>
                  </div>
                  <p class="text-gray-600 mb-4 line-clamp-3 leading-relaxed">
                    {site.frontmatter.description || 'Brief description of the site and its significance...'}
                  </p>
                  <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                    <div class="flex items-center space-x-2 text-sm text-gray-500">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      <span>{site.frontmatter.campZone}</span>
                    </div>
                    <a href={`/site-register/${site.file.split('/').pop().replace('.md', '')}`} class="inline-flex items-center text-blue-600 hover:text-blue-700 font-semibold group-hover:translate-x-1 transition-transform">
                      Learn More
                      <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            ))
          ) : (
            <div class="col-span-full text-center py-16">
              <div class="max-w-md mx-auto">
                <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
                  <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">No Sites Yet</h3>
                <p class="text-gray-600 mb-6">Be the first to submit a cultural, historical, or community site to our register!</p>
                <a href="/site-register/submit" class="inline-flex items-center bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors">
                  Submit First Site
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                </a>
              </div>
            </div>
          )}
        </div>

        {/* Pagination Controls */}
        {totalPages > 1 && (
          <div class="mt-12">
            <div class="flex items-center justify-between">
              {/* Results info */}
              <div class="text-sm text-gray-600">
                Showing {pagination.startItem} to {pagination.endItem} of {pagination.totalItems} sites
              </div>
              
              {/* Pagination buttons */}
              <div class="flex items-center space-x-2">
                {/* Previous button */}
                {pagination.hasPrevPage ? (
                  <a href={pagination.prevPage === 1 ? "/site-register" : `/site-register/${pagination.prevPage}`} class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Previous
                  </a>
                ) : (
                  <button disabled class="inline-flex items-center px-4 py-2 border border-gray-200 rounded-lg text-sm font-medium text-gray-400 bg-gray-50 cursor-not-allowed">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Previous
                  </button>
                )}
                
                {/* Page numbers */}
                <div class="flex items-center space-x-1">
                  {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
                    pageNum === currentPage ? (
                      <span class="inline-flex items-center px-3 py-2 border border-blue-500 rounded-lg text-sm font-medium text-blue-600 bg-blue-50">
                        {pageNum}
                      </span>
                    ) : (
                      <a href={pageNum === 1 ? "/site-register" : `/site-register/${pageNum}`} class="inline-flex items-center px-3 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                        {pageNum}
                      </a>
                    )
                  ))}
                </div>
                
                {/* Next button */}
                {pagination.hasNextPage ? (
                  <a href={`/site-register/${pagination.nextPage}`} class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                    Next
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                ) : (
                  <button disabled class="inline-flex items-center px-4 py-2 border border-gray-200 rounded-lg text-sm font-medium text-gray-400 bg-gray-50 cursor-not-allowed">
                    Next
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                  </button>
                )}
              </div>
            </div>
          </div>
        )}

        <div class="text-center mt-12">
          <a href="/site-register/submit" class="inline-flex items-center justify-center px-8 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors">
            Submit a New Site
          </a>
        </div>
      </div>
    </section>

    <!-- How to Contribute Section -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">How to Contribute</h2>
          <p class="text-lg text-gray-600">Help us document and preserve Dzaleka's important sites</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Submit a Site</h3>
            <p class="text-gray-600 mb-4">Share information about a cultural, historical, or community site that should be documented in our register.</p>
            <a href="/site-register/submit" class="text-blue-600 hover:text-blue-700 font-medium">Submit Now →</a>
          </div>

          <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Photo Guidelines</h3>
            <p class="text-gray-600 mb-4">Tips for taking good photos: clear lighting, wide shots showing context, and detail shots of important features.</p>
            <a href="/photo-guidelines" class="text-blue-600 hover:text-blue-700 font-medium">View Guidelines →</a>
          </div>
        </div>
      </div>
    </section>
  </Layout>
</MainLayout>
