---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

export async function getStaticPaths() {
  let sites = [];
  try {
    sites = await Astro.glob('../../content/sites/*.md');
  } catch (error) {
    console.error('Error loading sites:', error);
    sites = [];
  }

  sites.sort((a, b) => {
    if (a.frontmatter.featured && !b.frontmatter.featured) return -1;
    if (!a.frontmatter.featured && b.frontmatter.featured) return 1;
    return a.frontmatter.title.localeCompare(b.frontmatter.title);
  });

  const itemsPerPage = 9;
  const totalPages = Math.ceil(sites.length / itemsPerPage);

  return Array.from({ length: totalPages }, (_, index) => ({
    params: { page: String(index + 1) }
  }));
}

const { page } = Astro.params;
const currentPage = parseInt(page) || 1;
const itemsPerPage = 9;

let sites = [];
try {
  sites = await Astro.glob('../../content/sites/*.md');
} catch (error) {
  console.error('Error loading sites:', error);
  sites = [];
}

sites.sort((a, b) => {
  if (a.frontmatter.featured && !b.frontmatter.featured) return -1;
  if (!a.frontmatter.featured && b.frontmatter.featured) return 1;
  return a.frontmatter.title.localeCompare(b.frontmatter.title);
});

const totalItems = sites.length;
const totalPages = Math.ceil(totalItems / itemsPerPage);
const startIndex = (currentPage - 1) * itemsPerPage;
const endIndex = startIndex + itemsPerPage;
const currentSites = sites.slice(startIndex, endIndex);

const pagination = {
  currentPage,
  totalPages,
  totalItems,
  hasNextPage: currentPage < totalPages,
  hasPrevPage: currentPage > 1,
  nextPage: currentPage + 1,
  prevPage: currentPage - 1,
  startItem: startIndex + 1,
  endItem: Math.min(endIndex, totalItems)
};

const title = currentPage === 1 ? 'Dzaleka Site Register' : `Dzaleka Site Register - Page ${currentPage}`;
const description = 'Explore cultural, historical, and community locations documented across Dzaleka Refugee Camp.';

const summaryStats = [
  { label: 'Documented sites', value: totalItems },
  { label: 'Current page', value: currentPage },
  { label: 'Featured on this page', value: currentSites.filter((site) => site.frontmatter.featured).length }
];

const getPageHref = (pageNumber) => pageNumber === 1 ? '/site-register' : `/site-register/${pageNumber}`;
---

<MainLayout title={title} description={description}>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-8">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Site Register' }
          ]}
        />
      </div>

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(260px,0.9fr)] lg:items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Community places</p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Dzaleka Site Register</h1>
          <p class="mt-4 text-lg leading-8 text-slate-600">
            Browse important cultural, historical, and community locations documented by the community.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/site-register/submit" class="inline-flex items-center rounded-lg bg-gray-900 px-5 py-3 text-sm font-medium text-white hover:bg-gray-800">
              Submit a site
            </a>
            <a href="/site-register/about" class="inline-flex items-center rounded-lg border border-slate-300 px-5 py-3 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">
              About the register
            </a>
          </div>
        </div>

        <div class="rounded-lg border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-lg font-semibold text-slate-900">Independent project</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">
            This is an independent public record of places that matter to the Dzaleka community. It is not an official authority list.
          </p>
          <div class="mt-5 grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
            {summaryStats.map((stat) => (
              <div class="rounded-lg border border-slate-200 bg-white px-4 py-4">
                <div class="text-sm text-slate-500">{stat.label}</div>
                <div class="mt-1 text-2xl font-semibold text-slate-900">{stat.value}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Listings</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900">Sites on this page</h2>
        </div>
        <p class="text-sm text-slate-500">
          Showing {pagination.startItem} to {pagination.endItem} of {pagination.totalItems}
        </p>
      </div>

      {currentSites.length > 0 ? (
        <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {currentSites.map((site) => {
            const slug = site.file.split('/').pop().replace('.md', '');
            return (
              <article class="rounded-lg border border-slate-200 bg-white">
                <div class="aspect-[4/3] overflow-hidden border-b border-slate-200 bg-slate-100">
                  {site.frontmatter.image ? (
                    <img src={site.frontmatter.image} alt={site.frontmatter.title} class="h-full w-full object-cover" />
                  ) : (
                    <div class="flex h-full items-center justify-center text-slate-400">
                      <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5" />
                      </svg>
                    </div>
                  )}
                </div>

                <div class="p-5">
                  <div class="flex flex-wrap items-center gap-2">
                    {site.frontmatter.category && (
                      <span class="rounded-md border border-slate-200 px-2.5 py-1 text-xs font-medium text-slate-700">
                        {site.frontmatter.category}
                      </span>
                    )}
                    {site.frontmatter.featured && (
                      <span class="rounded-md border border-amber-200 bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700">
                        Featured
                      </span>
                    )}
                  </div>

                  <h3 class="mt-4 text-lg font-semibold text-slate-900">{site.frontmatter.title}</h3>
                  {site.frontmatter.campZone && (
                    <p class="mt-2 text-sm text-slate-500">{site.frontmatter.campZone}</p>
                  )}
                  <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-600">
                    {site.frontmatter.description || 'Description not yet available.'}
                  </p>

                  <div class="mt-5">
                    <a href={`/site-register/${slug}`} class="text-sm font-medium text-slate-700 hover:text-slate-900">
                      View site
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="mt-6 rounded-lg border border-slate-200 bg-white p-8 text-center">
          <h3 class="text-lg font-semibold text-slate-900">No sites yet</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Be the first to document a cultural, historical, or community site.
          </p>
        </div>
      )}
    </section>

    {totalPages > 1 && (
      <section class="mt-10 rounded-lg border border-slate-200 bg-white p-5">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-2">
            {pagination.hasPrevPage ? (
              <a href={getPageHref(pagination.prevPage)} class="inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">
                Previous
              </a>
            ) : (
              <span class="inline-flex items-center rounded-lg border border-slate-200 px-4 py-2 text-sm text-slate-400">Previous</span>
            )}

            <div class="flex items-center gap-1">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
                pageNum === currentPage ? (
                  <span class="inline-flex items-center rounded-lg border border-slate-900 bg-slate-900 px-3 py-2 text-sm font-medium text-white">
                    {pageNum}
                  </span>
                ) : (
                  <a href={getPageHref(pageNum)} class="inline-flex items-center rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">
                    {pageNum}
                  </a>
                )
              ))}
            </div>

            {pagination.hasNextPage ? (
              <a href={getPageHref(pagination.nextPage)} class="inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">
                Next
              </a>
            ) : (
              <span class="inline-flex items-center rounded-lg border border-slate-200 px-4 py-2 text-sm text-slate-400">Next</span>
            )}
          </div>
        </div>
      </section>
    )}

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-semibold text-slate-900">Submit a site</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          Share information about a place that should be documented in the register.
        </p>
        <a href="/site-register/submit" class="mt-5 inline-block text-sm font-medium text-slate-700 hover:text-slate-900">
          Submit now
        </a>
      </div>

      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-semibold text-slate-900">Report an issue</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          Send corrections or flag problems with an existing site listing.
        </p>
        <a href="/site-register/report-issue" class="mt-5 inline-block text-sm font-medium text-slate-700 hover:text-slate-900">
          Report now
        </a>
      </div>
    </section>
  </div>
</MainLayout>

<style>
.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
