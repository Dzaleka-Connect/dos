---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { getPaginationData } from '../../utils/pagination';

export async function getStaticPaths() {
  let sites = [];
  try {
    sites = await Astro.glob('../../content/sites/*.md');
  } catch (error) {
    console.error('Error loading sites:', error);
    sites = [];
  }

  sites.sort((a, b) => {
    if (a.frontmatter.featured && !b.frontmatter.featured) return -1;
    if (!a.frontmatter.featured && b.frontmatter.featured) return 1;
    return a.frontmatter.title.localeCompare(b.frontmatter.title);
  });

  const itemsPerPage = 6;
  const totalPages = Math.ceil(sites.length / itemsPerPage);

  return Array.from({ length: totalPages }, (_, index) => ({
    params: { page: String(index + 1) }
  }));
}

const { page } = Astro.params;
const currentPage = parseInt(page) || 1;
const itemsPerPage = 6;

let sites = [];
try {
  sites = await Astro.glob('../../content/sites/*.md');
} catch (error) {
  console.error('Error loading sites:', error);
  sites = [];
}

sites.sort((a, b) => {
  if (a.frontmatter.featured && !b.frontmatter.featured) return -1;
  if (!a.frontmatter.featured && b.frontmatter.featured) return 1;
  return a.frontmatter.title.localeCompare(b.frontmatter.title);
});

const totalItems = sites.length;
const { totalPages, startIndex, endIndex, hasNextPage, hasPrevPage } =
  getPaginationData(currentPage, totalItems, itemsPerPage);
const currentSites = sites.slice(startIndex, endIndex);

const pagination = {
  currentPage,
  totalPages,
  totalItems,
  hasNextPage,
  hasPrevPage,
  nextPage: currentPage + 1,
  prevPage: currentPage - 1,
  startItem: startIndex + 1,
  endItem: endIndex
};

const title = currentPage === 1 ? 'Dzaleka Heritage Site Register' : `Dzaleka Heritage Site Register - Page ${currentPage}`;
const description = 'The official record of cultural, historical, and natural heritage sites within the Dzaleka community.';

const getPageHref = (pageNumber) => pageNumber === 1 ? '/site-register' : `/site-register/${pageNumber}`;

---

<MainLayout title={title} description={description}>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-6">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Site Register', href: '/site-register' },
            { label: `Page ${currentPage}` }
          ]}
        />
      </div>

      <div class="max-w-2xl">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Dzaleka Site Register</h1>
        <p class="mt-4 text-base leading-7 text-slate-600">
          Browse important cultural, historical, and community locations documented by the community.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/site-register/submit" class="inline-flex items-center rounded-lg bg-gray-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-gray-800 transition-colors">
            Submit a site
          </a>
          <a href="/site-register/about" class="inline-flex items-center rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900 transition-colors">
            About the register
          </a>
          <a href="/site-register/license" class="inline-flex items-center rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900 transition-colors">
            License & usage
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section>
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Listings</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900">Sites on this page</h2>
        </div>
        <p class="text-sm text-slate-500">
          Showing {pagination.startItem} to {pagination.endItem} of {pagination.totalItems}
        </p>
      </div>

      <!-- Sites Grid -->
      {currentSites.length > 0 ? (
        <div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {currentSites.map((site) => {
            const slug = site.file.split('/').pop().replace('.md', '');
            return (
              <article class="flex flex-col rounded-lg border border-slate-200 bg-white overflow-hidden hover:shadow-md transition-shadow">
                <a href={`/site-register/${slug}`} class="aspect-[4/3] overflow-hidden border-b border-slate-200 bg-slate-100 block relative">
                  {site.frontmatter.image ? (
                    <img src={site.frontmatter.image} alt={site.frontmatter.title} class="h-full w-full object-cover" />
                  ) : (
                    <div class="flex h-full items-center justify-center text-slate-400">
                      <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                      </svg>
                    </div>
                  )}
                  {site.frontmatter.featured && (
                    <div class="absolute top-3 right-3 rounded-full bg-slate-900 text-white p-1.5 shadow-sm" title="Featured Heritage Site">
                      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    </div>
                  )}
                </a>

                <div class="p-5 flex flex-col flex-grow">
                  <div class="flex flex-wrap items-center gap-2 mb-3">
                    {site.frontmatter.category && (
                      <span class="rounded-md border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-700">
                        {site.frontmatter.category}
                      </span>
                    )}
                    {site.frontmatter.referenceId && (
                      <span class="rounded-md border border-slate-200 px-2.5 py-1 text-xs font-mono text-slate-500">
                        {site.frontmatter.referenceId}
                      </span>
                    )}
                  </div>

                  <a href={`/site-register/${slug}`}>
                    <h3 class="text-lg font-semibold text-slate-900 group-hover:text-slate-700">{site.frontmatter.title}</h3>
                  </a>
                  
                  {site.frontmatter.campZone && (
                    <p class="mt-1.5 text-sm text-slate-500 flex items-center">
                      <svg class="w-3.5 h-3.5 mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      {site.frontmatter.campZone}
                    </p>
                  )}
                  
                  <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-600 flex-grow">
                    {site.frontmatter.description || 'Description not yet available.'}
                  </p>

                  <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
                    <a href={`/site-register/${slug}`} class="text-sm font-medium text-slate-900 hover:text-slate-700">
                      View site details &rarr;
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="mt-6 rounded-lg border border-slate-200 bg-white p-8 text-center">
          <h3 class="text-lg font-semibold text-slate-900">No sites yet</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Be the first to document a cultural, historical, or community site.
          </p>
        </div>
      )}
    </section>

    <!-- Pagination Controls -->
    {totalPages > 1 && (
      <section class="mt-10 rounded-lg border border-slate-200 bg-white p-5">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-2">
            {pagination.hasPrevPage ? (
              <a href={getPageHref(pagination.prevPage)} class="inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">
                Previous
              </a>
            ) : (
              <span class="inline-flex items-center rounded-lg border border-slate-200 px-4 py-2 text-sm text-slate-400">Previous</span>
            )}

            <div class="flex items-center gap-1">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
                pageNum === currentPage ? (
                  <span class="inline-flex items-center rounded-lg border border-slate-900 bg-slate-900 px-3 py-2 text-sm font-medium text-white">
                    {pageNum}
                  </span>
                ) : (
                  <a href={getPageHref(pageNum)} class="inline-flex items-center rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">
                    {pageNum}
                  </a>
                )
              ))}
            </div>

            {pagination.hasNextPage ? (
              <a href={getPageHref(pagination.nextPage)} class="inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">
                Next
              </a>
            ) : (
              <span class="inline-flex items-center rounded-lg border border-slate-200 px-4 py-2 text-sm text-slate-400">Next</span>
            )}
          </div>
        </div>
      </section>
    )}

    <section class="mt-10 grid gap-5 lg:grid-cols-2">
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-semibold text-slate-900">Nominate a site</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          Share information about a place that should be documented in the register. Help preserve community memory.
        </p>
        <a href="/site-register/submit" class="mt-5 inline-block text-sm font-medium text-slate-900 hover:text-slate-700">
          Start nomination &rarr;
        </a>
      </div>

      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-semibold text-slate-900">Report an issue</h2>
        <p class="mt-3 text-sm leading-6 text-slate-600">
          Send corrections or flag problems with an existing site listing to help keep the archive accurate.
        </p>
        <a href="/site-register/report-issue" class="mt-5 inline-block text-sm font-medium text-slate-900 hover:text-slate-700">
          Report now &rarr;
        </a>
      </div>
    </section>
  </div>
</MainLayout>

<style>
.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
