---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

const title = 'License and usage policy - Dzaleka Online Services';
const description =
  'Learn how material from the Site Register can be used, shared, and credited.';
const lastUpdated = new Date().toLocaleDateString('en-AU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<MainLayout title={title} description={description} canonical="https://services.dzaleka.com/site-register/license">
  <section class="border-b border-slate-200 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="mb-8">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Site Register', href: '/site-register' },
            { label: 'License and usage policy' }
          ]}
        />
      </div>

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(260px,0.9fr)] lg:items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Policy</p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            License and usage policy
          </h1>
          <p class="mt-4 text-lg leading-8 text-slate-600">
            This page explains how information from the Site Register may be reused, credited,
            adapted, and shared.
          </p>
        </div>

        <div class="rounded-lg border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-lg font-semibold text-slate-900">At a glance</h2>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-600">
            <li>Most register content is shared under a Creative Commons non-commercial license.</li>
            <li>Attribution is required whenever content is reused.</li>
            <li>Commercial use requires written permission before publication.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="bg-slate-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-6">
      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Overview</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          The Site Register documents places, histories, and community knowledge connected to
          Dzaleka. The goal is to support preservation, access, and responsible reuse while
          respecting contributors and the communities represented in the register.
        </p>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Creative Commons license</h2>
        <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-6">
          <h3 class="text-lg font-semibold text-slate-900">CC BY-NC-SA 4.0</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Attribution-NonCommercial-ShareAlike 4.0 International.
          </p>
          <p class="mt-3 text-sm leading-6 text-slate-600">
            You may copy, share, and adapt the material for non-commercial purposes as long as
            you credit the source and distribute derivatives under the same license.
          </p>
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-3">
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Attribution</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              Credit Dzaleka Online Services and, where available, the named contributor.
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Non-commercial</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              Do not use this material in commercial products or services without permission.
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Share alike</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              If you adapt the content, publish the new work under the same license.
            </p>
          </div>
        </div>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Permitted uses</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="font-medium text-slate-900">Education and research</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Teaching materials, academic work, historical research, and cultural documentation.
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="font-medium text-slate-900">Community projects</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Community archives, exhibitions, heritage interpretation, and local awareness work.
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="font-medium text-slate-900">Personal reference</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Personal study, family history, and non-commercial reference use.
            </p>
          </div>
          <div class="rounded-lg border border-slate-200 p-5">
            <h3 class="font-medium text-slate-900">Preservation work</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Projects that protect, catalogue, or document important places and histories.
            </p>
          </div>
        </div>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Attribution requirements</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          Reuse should make the source clear and link back to the original page when possible.
        </p>
        <div class="mt-6 space-y-4">
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-4 font-mono text-sm leading-6 text-slate-700">
            "Dzaleka Online Services" by Dzaleka Digital Heritage Project. Licensed under CC BY-NC-SA 4.0.
            Source: https://services.dzaleka.com/site-register
          </div>
          <div class="rounded-lg border border-slate-200 bg-slate-50 p-4 font-mono text-sm leading-6 text-slate-700">
            "[Site name]" from Dzaleka Online Services. Licensed under CC BY-NC-SA 4.0.
            Source: https://services.dzaleka.com/site-register/[site-slug]
          </div>
        </div>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Commercial use</h2>
        <div class="mt-6 rounded-lg border border-amber-200 bg-amber-50 p-6">
          <h3 class="text-lg font-semibold text-amber-900">Permission required</h3>
          <p class="mt-3 text-sm leading-6 text-amber-800">
            Commercial publications, paid products, branded campaigns, revenue-generating websites,
            and merchandise require written approval before use.
          </p>
        </div>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Content ownership and rights</h2>
        <div class="mt-6 space-y-5 text-sm leading-6 text-slate-600">
          <div>
            <h3 class="font-medium text-slate-900">Community contributions</h3>
            <p class="mt-2">
              Contributors retain rights to their original material while allowing the project to
              preserve and share it.
            </p>
          </div>
          <div>
            <h3 class="font-medium text-slate-900">Images and media</h3>
            <p class="mt-2">
              Some photographs or media may have additional conditions. Always check any credits
              or notes attached to individual items.
            </p>
          </div>
          <div>
            <h3 class="font-medium text-slate-900">Third-party material</h3>
            <p class="mt-2">
              Where third-party material is included, the original creator’s terms still apply.
            </p>
          </div>
        </div>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Contact and permissions</h2>
        <div class="mt-6 rounded-lg border border-slate-200 bg-slate-50 p-6">
          <p class="text-sm leading-6 text-slate-600">
            For commercial use requests, special permissions, or questions about reuse, contact:
          </p>
          <div class="mt-4 space-y-2 text-sm leading-6 text-slate-700">
            <p>
              <span class="font-medium text-slate-900">Email:</span>
              <a href="mailto:dzalekaconnect@gmail.com" class="text-slate-700 underline hover:text-slate-900">
                dzalekaconnect@gmail.com
              </a>
            </p>
            <p>
              <span class="font-medium text-slate-900">Website:</span>
              <a href="https://services.dzaleka.com" class="text-slate-700 underline hover:text-slate-900">
                services.dzaleka.com
              </a>
            </p>
          </div>
        </div>
      </section>

      <section class="rounded-lg border border-slate-200 bg-white p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Policy updates</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          This policy may be updated as the register grows. Continued use of the content means you
          accept the current published version.
        </p>
        <p class="mt-4 text-sm text-slate-500">Last updated: {lastUpdated}</p>
      </section>
    </div>
  </div>
</MainLayout>
