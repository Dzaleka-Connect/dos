---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

const title = 'License and usage policy - Dzaleka Online Services';
const description =
  'Learn how material from the Site Register can be used, shared, and credited.';
const lastUpdated = new Date().toLocaleDateString('en-AU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<MainLayout title={title} description={description} canonical="https://services.dzaleka.com/site-register/license">
  <section class="border-b border-slate-200 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="mb-8">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Site Register', href: '/site-register' },
            { label: 'License and usage policy' }
          ]}
        />
      </div>

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(260px,0.9fr)] lg:items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Policy</p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            License and usage policy
          </h1>
          <p class="mt-4 text-lg leading-8 text-slate-600">
            This document outlines the official guidelines for the reproduction, distribution, and adaptation of archival materials, data, and metadata from the Dzaleka Heritage Site Register.
          </p>
        </div>

        <div class="rounded border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-lg font-semibold text-slate-900">At a glance</h2>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-600">
            <li>Most register content is shared under a Creative Commons non-commercial license.</li>
            <li>Attribution is required whenever content is reused.</li>
            <li>Commercial use requires written permission before publication.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="bg-slate-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-6">
      <section class="rounded border border-slate-200 bg-white p-5 sm:p-8">
        <h2 class="text-2xl font-semibold text-slate-900">1. Archival Objectives and Data Access</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          The Dzaleka Heritage Site Register serves as an authoritative, community-led database documenting sites of outstanding historical, cultural, and natural significance. Our primary objective is to facilitate the safeguarding and dissemination of local heritage while strictly respecting the intellectual and moral rights of our contributors and the community at large.
        </p>
      </section>

      <section class="rounded border border-slate-200 bg-white p-5 sm:p-8">
        <h2 class="text-2xl font-semibold text-slate-900">2. Licensing Framework</h2>
        <div class="mt-6 rounded border border-slate-200 bg-slate-50 p-6">
          <h3 class="text-lg font-semibold text-slate-900">Creative Commons (CC BY-NC-SA 4.0)</h3>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Attribution-NonCommercial-ShareAlike 4.0 International.
          </p>
          <p class="mt-3 text-sm leading-6 text-slate-600">
            In the spirit of open access and educational dissemination, the majority of the Register's textual metadata and documentation is licensed under CC BY-NC-SA 4.0. Users are authorized to reproduce, distribute, and adapt these materials exclusively for non-commercial purposes, provided that proper attribution is given and derivative works are distributed under identical terms.
          </p>
        </div>

        <div class="mt-6 grid gap-4 md:grid-cols-3">
          <div class="rounded border border-slate-200 p-5">
            <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Attribution</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              Credit Dzaleka Online Services and, where available, the named contributor.
            </p>
          </div>
          <div class="rounded border border-slate-200 p-5">
            <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Non-commercial</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              Do not use this material in commercial products or services without permission.
            </p>
          </div>
          <div class="rounded border border-slate-200 p-5">
            <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Share alike</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              If you adapt the content, publish the new work under the same license.
            </p>
          </div>
        </div>
      </section>

      <section class="rounded border border-slate-200 bg-white p-5 sm:p-8">
        <h2 class="text-2xl font-semibold text-slate-900">3. Authorized Applications</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <div class="rounded border border-slate-200 p-5">
            <h3 class="font-medium text-slate-900">Academic & educational usage</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Integration into pedagogical materials, academic dissertations, historical analyses, and formal cultural documentation.
            </p>
          </div>
          <div class="rounded border border-slate-200 p-5">
            <h3 class="font-medium text-slate-900">Community & NGO initiatives</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Utilization in community archives, humanitarian reports, public exhibitions, and local heritage interpretation projects.
            </p>
          </div>
          <div class="rounded border border-slate-200 p-5">
            <h3 class="font-medium text-slate-900">Personal Reference</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Consultation for independent study, genealogical research, and non-commercial reference.
            </p>
          </div>
          <div class="rounded border border-slate-200 p-5">
            <h3 class="font-medium text-slate-900">Safeguarding & Conservation</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Technical utilization in projects aimed at the protection, cataloguing, and physical conservation of inscribed sites.
            </p>
          </div>
        </div>
      </section>

      <section class="rounded border border-slate-200 bg-white p-5 sm:p-8">
        <h2 class="text-2xl font-semibold text-slate-900">4. Citation Standards</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          Any reproduction of the Register's contents must explicitly acknowledge the source and include a direct hyperlink to the original digital record.
        </p>
        <div class="mt-6 space-y-4">
          <div class="rounded border border-slate-200 bg-slate-50 p-4 font-mono text-sm leading-6 text-slate-700">
            "Dzaleka Online Services" by Dzaleka Digital Heritage Project. Licensed under CC BY-NC-SA 4.0.
            Source: https://services.dzaleka.com/site-register
          </div>
          <div class="rounded border border-slate-200 bg-slate-50 p-4 font-mono text-sm leading-6 text-slate-700">
            "[Site name]" from Dzaleka Online Services. Licensed under CC BY-NC-SA 4.0.
            Source: https://services.dzaleka.com/site-register/[site-slug]
          </div>
        </div>
      </section>

      <section class="rounded border border-slate-200 bg-white p-5 sm:p-8">
        <h2 class="text-2xl font-semibold text-slate-900">5. Restrictions on Commercial Exploitation</h2>
        <div class="mt-6 rounded border border-amber-200 bg-amber-50 p-6">
          <h3 class="text-lg font-semibold text-amber-900">Prior authorization required</h3>
          <p class="mt-3 text-sm leading-6 text-amber-800">
            The integration of this archive's data into commercial publications, monetization schemes, branded campaigns, or any revenue-generating ventures is strictly prohibited without explicit, written authorization from the governing administrative body.
          </p>
        </div>
      </section>

      <section class="rounded border border-slate-200 bg-white p-5 sm:p-8">
        <h2 class="text-2xl font-semibold text-slate-900">6. Intellectual Property & Digital Rights</h2>
        <div class="mt-6 space-y-5 text-sm leading-6 text-slate-600">
          <div>
            <h3 class="font-medium text-slate-900">Community Submissions</h3>
            <p class="mt-2">
              Individual contributors and local historians retain full moral and copyright ownership of their original materials, granting the Dzaleka Heritage Site Register a perpetual, non-exclusive license for archiving and public dissemination.
            </p>
          </div>
          <div>
            <h3 class="font-medium text-slate-900">Photographic & media assets</h3>
            <p class="mt-2">
              Photographic documentation may be subject to independent copyright restrictions. Users must verify the specific licensing terms attached to individual media assets prior to reproduction.
            </p>
          </div>
          <div>
            <h3 class="font-medium text-slate-900">Third-Party Documentation</h3>
            <p class="mt-2">
              Whenever external reports, analyses, or historical records are referenced, the original author's or institution's licensing terms shall remain in full effect.
            </p>
          </div>
        </div>
      </section>

      <section class="rounded border border-slate-200 bg-white p-5 sm:p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Contact and permissions</h2>
        <div class="mt-6 rounded border border-slate-200 bg-slate-50 p-6">
          <p class="text-sm leading-6 text-slate-600">
            For commercial use requests, special permissions, or questions about reuse, contact:
          </p>
          <div class="mt-4 space-y-2 text-sm leading-6 text-slate-700">
            <p>
              <span class="font-medium text-slate-900">Email:</span>
              <a href="mailto:dzalekaconnect@gmail.com" class="text-slate-700 underline hover:text-slate-900">
                dzalekaconnect@gmail.com
              </a>
            </p>
            <p>
              <span class="font-medium text-slate-900">Website:</span>
              <a href="https://services.dzaleka.com" class="text-slate-700 underline hover:text-slate-900">
                services.dzaleka.com
              </a>
            </p>
          </div>
        </div>
      </section>

      <section class="rounded border border-slate-200 bg-white p-5 sm:p-8">
        <h2 class="text-2xl font-semibold text-slate-900">Policy updates</h2>
        <p class="mt-4 text-base leading-7 text-slate-600">
          This policy may be updated as the register grows. Continued use of the content means you
          accept the current published version.
        </p>
        <p class="mt-4 text-sm text-slate-500">Last updated: {lastUpdated}</p>
      </section>
    </div>
  </div>
</MainLayout>
