---
import MainLayout from '../../layouts/MainLayout.astro';

const seo = {
  title: "License & Usage Policy - Dzaleka Digital Site Register",
  description: "Learn about the licensing terms and usage policies for the Dzaleka Digital Site Register content and heritage documentation.",
  type: "website",
  canonical: "https://services.dzaleka.com/site-register/license",
  openGraph: {
    title: "License & Usage Policy - Dzaleka Digital Site Register",
    description: "Learn about the licensing terms and usage policies for the Dzaleka Digital Site Register content and heritage documentation.",
    type: "website",
    site_name: "Dzaleka Digital Site Register",
    locale: "en_US",
    url: "https://services.dzaleka.com/site-register/license"
  }
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
>
  <div class="min-h-screen bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Back Button -->
      <div class="mb-6">
        <button 
          onclick="history.back()"
          class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back</span>
        </button>
      </div>

      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">License & Usage Policy</h1>
        <p class="text-xl text-gray-600">
          Understanding how you can use and share content from the Dzaleka Digital Site Register
        </p>
      </div>

      <!-- Content -->
      <div class="bg-white rounded-xl shadow-sm p-8 space-y-8">
        
        <!-- Overview -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Overview</h2>
          <p class="text-gray-700 leading-relaxed">
            The Dzaleka Digital Site Register is an independent documentation project that aims to preserve and share information about important cultural, historical, and community locations in and around Dzaleka Refugee Camp. This license and usage policy outlines how you can use, share, and contribute to this project.
          </p>
        </section>

        <!-- Creative Commons License -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Creative Commons License</h2>
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 mb-6">
            <div class="flex items-center gap-4 mb-4">
              <svg class="w-12 h-12 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
              <div>
                <h3 class="text-lg font-semibold text-blue-900">CC BY-NC-SA 4.0</h3>
                <p class="text-blue-700">Attribution-NonCommercial-ShareAlike 4.0 International</p>
              </div>
            </div>
            <p class="text-blue-800">
              This work is licensed under a Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International License.
            </p>
          </div>
          
          <div class="grid md:grid-cols-3 gap-6">
            <div class="text-center p-4 border border-gray-200 rounded-lg">
              <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Attribution</h4>
              <p class="text-sm text-gray-600">You must give appropriate credit to the Dzaleka Digital Site Register and contributors.</p>
            </div>
            
            <div class="text-center p-4 border border-gray-200 rounded-lg">
              <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
                </svg>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Non-Commercial</h4>
              <p class="text-sm text-gray-600">You may not use the material for commercial purposes without permission.</p>
            </div>
            
            <div class="text-center p-4 border border-gray-200 rounded-lg">
              <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z" />
                </svg>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Share Alike</h4>
              <p class="text-sm text-gray-600">If you remix or build upon the material, you must distribute under the same license.</p>
            </div>
          </div>
        </section>

        <!-- Permitted Uses -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Permitted Uses</h2>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <h4 class="font-semibold text-gray-900">Educational Purposes</h4>
                <p class="text-gray-700">Use in academic research, teaching, and educational materials.</p>
              </div>
            </div>
            
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <h4 class="font-semibold text-gray-900">Documentation & Preservation</h4>
                <p class="text-gray-700">Use for cultural heritage documentation and preservation efforts.</p>
              </div>
            </div>
            
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <h4 class="font-semibold text-gray-900">Community Projects</h4>
                <p class="text-gray-700">Use in community development and cultural projects.</p>
              </div>
            </div>
            
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <div>
                <h4 class="font-semibold text-gray-900">Personal Reference</h4>
                <p class="text-gray-700">Use for personal study and reference purposes.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- Attribution Requirements -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Attribution Requirements</h2>
          <p class="text-gray-700 mb-4">
            When using content from the Dzaleka Digital Site Register, you must provide proper attribution in the following format:
          </p>
          
          <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 font-mono text-sm">
            <p class="text-gray-800">
              "Dzaleka Digital Site Register" by Dzaleka Digital Heritage Project is licensed under CC BY-NC-SA 4.0. 
              Available at: https://services.dzaleka.com/site-register
            </p>
          </div>
          
          <p class="text-gray-700 mt-4">
            For specific sites, include the site name and URL:
          </p>
          
          <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 font-mono text-sm">
            <p class="text-gray-800">
              "[Site Name]" from Dzaleka Digital Site Register by Dzaleka Digital Heritage Project is licensed under CC BY-NC-SA 4.0. 
              Available at: https://services.dzaleka.com/site-register/[site-slug]
            </p>
          </div>
        </section>

        <!-- Commercial Use -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Commercial Use</h2>
          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
            <div class="flex items-start gap-3">
              <svg class="w-6 h-6 text-yellow-600 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
              </svg>
              <div>
                <h3 class="text-lg font-semibold text-yellow-900 mb-2">Commercial Use Requires Permission</h3>
                <p class="text-yellow-800 mb-4">
                  Commercial use of content from the Dzaleka Digital Site Register requires explicit written permission from the project administrators.
                </p>
                <p class="text-yellow-800">
                  This includes but is not limited to: commercial publications, for-profit educational materials, commercial websites, merchandise, and any use that generates revenue.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Content Ownership -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Content Ownership & Rights</h2>
          <div class="space-y-4">
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">Community Contributions</h4>
              <p class="text-gray-700">
                Content in the Site Register is contributed by community members, researchers, and volunteers. Contributors retain rights to their original content while granting the project license to share and preserve it.
              </p>
            </div>
            
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">Photographs & Media</h4>
              <p class="text-gray-700">
                Photographs and media files may have different licensing terms. Please check individual image credits and contact photographers directly for commercial use permissions.
              </p>
            </div>
            
            <div>
              <h4 class="font-semibold text-gray-900 mb-2">Third-Party Content</h4>
              <p class="text-gray-700">
                Some content may be sourced from third parties with their own licensing terms. Such content is clearly marked and subject to the original creator's terms.
              </p>
            </div>
          </div>
        </section>

        <!-- Contact Information -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Contact & Permissions</h2>
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
            <h3 class="text-lg font-semibold text-blue-900 mb-3">Requesting Permissions</h3>
            <p class="text-blue-800 mb-4">
              For commercial use, special permissions, or questions about licensing, please contact us:
            </p>
            <div class="space-y-2">
              <p class="text-blue-800">
                <strong>Email:</strong> <a href="mailto:info@dzaleka.com" class="text-blue-600 hover:text-blue-800 underline">info@dzaleka.com</a>
              </p>
              <p class="text-blue-800">
                <strong>Website:</strong> <a href="https://services.dzaleka.com" class="text-blue-600 hover:text-blue-800 underline">https://services.dzaleka.com</a>
              </p>
            </div>
          </div>
        </section>

        <!-- Updates -->
        <section>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">License Updates</h2>
          <p class="text-gray-700">
            This license and usage policy may be updated periodically. The current version is always available on this page. Continued use of the content constitutes acceptance of any updates to this policy.
          </p>
          <p class="text-gray-700 mt-2">
            <strong>Last Updated:</strong> {new Date().toLocaleDateString()}
          </p>
        </section>

      </div>
    </div>
  </div>
</MainLayout>
