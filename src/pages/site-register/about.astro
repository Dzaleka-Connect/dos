---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

const title = 'About Dzaleka Site Register';
const description = 'Learn about the independent community project documenting cultural, historical, and community sites in Dzaleka.';

const principles = [
  {
    title: 'Independent documentation',
    description: 'The register exists as a public community record and is not an official authority list.'
  },
  {
    title: 'Community memory',
    description: 'It helps preserve stories, landmarks, and places that matter to people living in and connected to Dzaleka.'
  },
  {
    title: 'Public reference',
    description: 'Visitors, researchers, and journalists can use it to understand the significance of local places.'
  },
  {
    title: 'Care and preservation',
    description: 'Recording a site can help encourage attention, care, and future preservation efforts.'
  }
];
---

<MainLayout title={title} description={description}>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-8">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Site Register', href: '/site-register' },
            { label: 'About' }
          ]}
        />
      </div>

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(260px,0.9fr)] lg:items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">About the project</p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">About the Site Register</h1>
          <p class="mt-4 text-lg leading-8 text-slate-600">
            The Dzaleka Site Register is an independent public record of important places in and around Dzaleka Refugee Camp.
            It exists to document cultural, historical, and community sites so their meaning is easier to find and less likely
            to be lost.
          </p>
        </div>

        <div class="rounded-lg border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-lg font-semibold text-slate-900">What you will find</h2>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-600">
            <li>Descriptions of important sites and what they are used for.</li>
            <li>Location notes, images, and supporting background information.</li>
            <li>Community submissions, corrections, and updates over time.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <section class="rounded-lg border border-slate-200 bg-white p-6 sm:p-8">
      <h2 class="text-2xl font-semibold text-slate-900">Why the register exists</h2>
      <div class="mt-6 space-y-5 text-sm leading-7 text-slate-600 sm:text-base">
        <p>
          Many places in Dzaleka carry meaning that is not formally documented anywhere else. A school, memorial,
          gathering place, business, church, field, or cultural site may have a history that matters deeply to the
          community but is hard to access from outside the people who know it.
        </p>
        <p>
          This register creates a shared public record. It is intended to help preserve memory, support local knowledge,
          and make it easier for people to understand why a place matters.
        </p>
        <p>
          The project is independent. It does not replace official records or legal authority, but it gives the community
          a way to document sites from a public and cultural perspective.
        </p>
      </div>
    </section>

    <section class="mt-10 grid gap-4 sm:grid-cols-2">
      {principles.map((item) => (
        <div class="rounded-lg border border-slate-200 bg-white p-6">
          <h3 class="text-lg font-semibold text-slate-900">{item.title}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">{item.description}</p>
        </div>
      ))}
    </section>

    <section class="mt-10 rounded-lg border border-slate-200 bg-slate-50 p-6 sm:p-8">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
        <div>
          <h2 class="text-2xl font-semibold text-slate-900">Contribute to the register</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600 sm:text-base">
            You can help by submitting a site, suggesting an update, or reporting incorrect information.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href="/site-register/submit" class="inline-flex items-center justify-center rounded-lg bg-gray-900 px-5 py-3 text-sm font-medium text-white hover:bg-gray-800">
            Submit a site
          </a>
          <a href="/site-register" class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">
            Browse sites
          </a>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
