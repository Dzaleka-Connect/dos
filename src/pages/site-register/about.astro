---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

const title = 'About Dzaleka Heritage Site Register';
const description = 'Learn about the independent community project documenting cultural, historical, and living heritage sites in Dzaleka Refugee Camp.';

const principles = [
  {
    title: 'Independent Documentation',
    description: 'The register exists as a public, community-led record. It is not an official government or UN authority list, but rather a reflection of community memory.'
  },
  {
    title: 'Living Heritage',
    description: 'We document not only the past, but the present. Markets, gathering spaces, and cultural centers are recognized as vital living heritage.'
  },
  {
    title: 'Public Reference',
    description: 'Researchers, journalists, and visitors can use this archive to understand the profound historical and cultural significance of local places.'
  },
  {
    title: 'Care & Preservation',
    description: 'By recording a site, we elevate its visibility and encourage attention, care, and future preservation efforts from the community and partners.'
  }
];

const criteria = [
  {
    num: 'i',
    title: 'Historical Testimony',
    text: 'To bear a unique or exceptional testimony to the political history, displacement, or cultural traditions of the community.'
  },
  {
    num: 'ii',
    title: 'Collective Memory',
    text: 'To be directly or tangibly associated with living traditions, beliefs, and collective memories of outstanding significance.'
  },
  {
    num: 'iii',
    title: 'Human Settlement',
    text: 'To be an outstanding example of traditional settlement, land-use, or community resilience representing human interaction with the environment.'
  },
  {
    num: 'iv',
    title: 'Natural Significance',
    text: 'To contain areas of exceptional natural beauty, or vital ecological and communal importance for conservation and recreation.'
  }
];
---

<MainLayout title={title} description={description}>
  <section class="border-b border-slate-200 bg-white py-12">
    <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
      <div class="mb-6">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Site Register', href: '/site-register' },
            { label: 'About the Archive' }
          ]}
        />
      </div>

      <div class="max-w-3xl">
        <h1 class="text-4xl font-bold text-slate-900 mb-6">
          Mission & selection criteria
        </h1>
        
        <p class="text-lg text-slate-600 leading-relaxed">
          The Dzaleka Heritage Site Register seeks to encourage the identification, documentation, and safeguarding of cultural, historical, and natural heritage within the settlement considered to be of outstanding value to the community.
        </p>
      </div>
    </div>
  </section>

  <div class="min-h-screen bg-slate-50 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Main Narrative -->
        <div class="lg:col-span-8 space-y-10">
          <section class="bg-white p-8 border border-slate-200 rounded-lg shadow-sm prose prose-slate max-w-none">
            <h2 class="text-2xl font-semibold text-slate-900 mt-0">Safeguarding community heritage</h2>
            <p>
              Cultural and natural heritage are irreplaceable sources of identity and inspiration. Within Dzaleka, numerous sites—from gathering spaces and historical landmarks to cultural hubs—hold profound historical and social significance, yet remain formally undocumented.
            </p>
            <p>
              This independent register establishes a definitive, community-led archive. Its purpose is to catalyze local knowledge preservation and facilitate greater awareness of the settlement's architectural, cultural, and natural assets. By adhering to rigorous standards of documentation, the register ensures that sites of communal importance are recorded with the highest degree of integrity and authenticity.
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-semibold text-slate-900 mb-6">Selection Criteria</h2>
            <p class="text-slate-600 mb-6">
              To be inscribed on the Dzaleka Heritage Register, sites must be of outstanding communal value and meet at least one of the following criteria:
            </p>
            <div class="grid sm:grid-cols-2 gap-6">
              {criteria.map(c => (
                <div class="bg-white p-6 border border-slate-200 rounded-lg shadow-sm">
                  <div class="flex items-center gap-3 mb-3">
                    <div class="flex-shrink-0 w-8 h-8 bg-slate-100 rounded-full flex items-center justify-center font-bold text-slate-700 text-sm border border-slate-200">
                      {c.num}
                    </div>
                    <h3 class="text-lg font-semibold text-slate-900 m-0">{c.title}</h3>
                  </div>
                  <p class="text-slate-600 text-sm leading-relaxed">{c.text}</p>
                </div>
              ))}
            </div>
          </section>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-4 space-y-8">
          
          <div class="bg-slate-900 text-white p-8 rounded-lg shadow-md">
            <h2 class="text-xl font-semibold mb-6">Guiding Principles</h2>
            <div class="space-y-6">
              {principles.map((item) => (
                <div>
                  <h3 class="text-base font-semibold text-white mb-2">{item.title}</h3>
                  <p class="text-slate-300 text-sm leading-relaxed">{item.description}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="bg-white border border-slate-200 p-8 rounded-lg shadow-sm text-center">
            <h2 class="text-xl font-semibold text-slate-900 mb-4">Contribute to the Archive</h2>
            <p class="text-slate-600 mb-6 text-sm">
              The archive relies on the community to identify and document significant spaces. You can help by submitting a site, suggesting an update, or providing historical photographs.
            </p>
            <div class="space-y-3">
              <a href="/site-register/submit" class="block w-full items-center justify-center bg-slate-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-slate-800 rounded-md transition-colors">
                Nominate a Site
              </a>
              <a href="/site-register" class="block w-full items-center justify-center border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 rounded-md transition-colors">
                Browse the Register
              </a>
              <a href="/site-register/license" class="block w-full items-center justify-center border border-slate-300 bg-white px-5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50 rounded-md transition-colors">
                License Policy
              </a>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</MainLayout>
