---
import RecordPrintLayout from '../../../layouts/RecordPrintLayout.astro';
import RecordFacts from '../../../components/records/RecordFacts.astro';
import RecordResources from '../../../components/records/RecordResources.astro';
import { recordImages, formatRecordDate, recordCoordinates } from '../../../utils/recordMedia';

export async function getStaticPaths() {
  const records = Object.values(import.meta.glob('../../../content/sites/*.md', { eager: true }));
  return records.map(record => ({ params: { slug: record.file.split('/').pop().replace('.md', '') }, props: { site: record } }));
}
const { site } = Astro.props;
const { frontmatter, Content } = site;
const slug = site.file.split('/').pop().replace('.md', '');
const images = recordImages(frontmatter.image, frontmatter.additionalImages || []);
const coordinates = recordCoordinates(frontmatter.latitude, frontmatter.longitude);
const facts = [
  { label: 'Record number', value: frontmatter.referenceId },
  { label: 'Category', value: frontmatter.category },
  { label: 'Area', value: frontmatter.campZone },
  { label: 'Location', value: frontmatter.specificLocation },
  { label: 'Also known as', value: frontmatter.alternativeNames },
  { label: 'Established', value: frontmatter.yearEstablished },
  { label: 'Status or ownership', value: frontmatter.legalStatus },
  { label: 'Recorded condition', value: frontmatter.condition },
  { label: 'Date documented', value: formatRecordDate(frontmatter.inscriptionDate) },
  { label: 'Coordinates', value: coordinates ? `${coordinates.lat}, ${coordinates.lng}` : undefined },
];
const sections = [
  { title: 'Integrity', content: frontmatter.integrity },
  { title: 'Authenticity', content: frontmatter.authenticity },
  { title: 'Preservation needs', content: frontmatter.preservationNeeds },
  { title: 'Associated events', content: frontmatter.associatedEvents },
].filter(section => section.content);
const before = recordImages(frontmatter.beforeImages || []);
const after = recordImages(frontmatter.afterImages || []);
---
<RecordPrintLayout title={frontmatter.title} description={frontmatter.description} collection="Site Register" href={`/site-register/${slug}`}>
  <RecordFacts facts={facts} />
  {images.map((src, index) => <figure><img src={src} alt={`${frontmatter.title} — image ${index + 1}`} /><figcaption>{frontmatter.title} · Image {index + 1}</figcaption></figure>)}
  <article><Content /></article>
  {sections.map(section => <section><h2>{section.title}</h2><p>{section.content}</p></section>)}
  {frontmatter.significanceCriteria?.length > 0 && <section><h2>Heritage significance</h2><ul>{frontmatter.significanceCriteria.map(criterion => <li>{criterion}</li>)}</ul></section>}
  {(before.length > 0 || after.length > 0) && <section><h2>Before and after photographs</h2>{before.map(src => <figure><img src={src} alt={`${frontmatter.title} — before`} /><figcaption>Before</figcaption></figure>)}{after.map(src => <figure><img src={src} alt={`${frontmatter.title} — after`} /><figcaption>After</figcaption></figure>)}</section>}
  <RecordResources resources={frontmatter.educationalResources} />
  <p>Review the <a href="/site-register/license">record licence and usage policy</a> before reusing this material.</p>
</RecordPrintLayout>
