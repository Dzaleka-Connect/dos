---
import Layout from '../../../layouts/Layout.astro';
import MainLayout from '../../../layouts/MainLayout.astro';

// Generate static paths for all sites
export async function getStaticPaths() {
  let sites = [];
  try {
    sites = await Astro.glob('../../../content/sites/*.md');
  } catch (error) {
    console.error('Error loading sites:', error);
    sites = [];
  }
  
  return sites.map((site) => {
    const slug = site.file.split('/').pop().replace('.md', '');
    return {
      params: { slug },
      props: { site }
    };
  });
}

const { site } = Astro.props;
const { frontmatter, Content } = site;

// Create SEO metadata
const seo = {
  title: `${frontmatter.title} | Print Version | Dzaleka Digital Site Register`,
  description: frontmatter.description || `Print version of ${frontmatter.title} in Dzaleka Refugee Camp`,
  type: "article",
  canonical: `https://services.dzaleka.com/site-register/${site.file.split('/').pop().replace('.md', '')}/print`,
  openGraph: {
    title: `${frontmatter.title} | Print Version | Dzaleka Digital Site Register`,
    description: frontmatter.description || `Print version of ${frontmatter.title} in Dzaleka Refugee Camp`,
    type: "article",
    site_name: "Dzaleka Digital Site Register",
    locale: "en_US",
    url: `https://services.dzaleka.com/site-register/${site.file.split('/').pop().replace('.md', '')}/print`
  }
};

// Prepare images array (main image + additional images)
const images = [
  frontmatter.image,
  ...(frontmatter.additionalImages || []),
  ...(frontmatter.beforeImages || []),
  ...(frontmatter.afterImages || [])
].filter(Boolean);
---

<!-- Print-only layout - no navigation or site elements -->
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{seo.title}</title>
  <meta name="description" content={seo.description} />
</head>
<body>
  <div class="print-container">
    <!-- Print Header -->
    <div class="print-header">
      <div class="print-logo">
        <h1 class="print-title">Dzaleka Digital Site Register</h1>
        <p class="print-subtitle">Heritage Documentation Project</p>
      </div>
      <div class="print-meta">
        <p><strong>Site:</strong> {frontmatter.title}</p>
        <p><strong>Generated:</strong> {new Date().toLocaleDateString()}</p>
        <p><strong>URL:</strong> https://services.dzaleka.com/site-register/{site.file.split('/').pop().replace('.md', '')}</p>
      </div>
    </div>

    <!-- Site Content -->
    <div class="print-content">
      <h1 class="site-title">{frontmatter.title}</h1>
      
      {frontmatter.category && (
        <p class="site-category"><strong>Category:</strong> {frontmatter.category}</p>
      )}
      
      {frontmatter.campZone && (
        <p class="site-location"><strong>Location:</strong> {frontmatter.campZone}</p>
      )}
      
      {frontmatter.yearEstablished && (
        <p class="site-established"><strong>Established:</strong> {frontmatter.yearEstablished}</p>
      )}
      
      {frontmatter.legalStatus && (
        <p class="site-status"><strong>Legal Status:</strong> {frontmatter.legalStatus}</p>
      )}

      {frontmatter.description && (
        <div class="site-description">
          <h2>Description</h2>
          <p>{frontmatter.description}</p>
        </div>
      )}

      {frontmatter.significance && (
        <div class="site-significance">
          <h2>Statement of Significance</h2>
          <p>{frontmatter.significance}</p>
        </div>
      )}

      {frontmatter.history && (
        <div class="site-history">
          <h2>History & Background</h2>
          <p>{frontmatter.history}</p>
        </div>
      )}

      {frontmatter.associatedEvents && (
        <div class="site-events">
          <h2>Associated Events</h2>
          <p>{frontmatter.associatedEvents}</p>
        </div>
      )}

      {frontmatter.condition && (
        <div class="site-condition">
          <h2>Condition & Preservation</h2>
          <p>{frontmatter.condition}</p>
        </div>
      )}

      {frontmatter.linkedResources && (
        <div class="site-resources">
          <h2>Related Resources</h2>
          <p class="resource-link">{frontmatter.linkedResources}</p>
        </div>
      )}

      <!-- Images Section -->
      {images.length > 0 && (
        <div class="site-images">
          <h2>Images</h2>
          <div class="image-grid">
            {images.map((image, index) => (
              <div class="image-item">
                <img src={image} alt={`${frontmatter.title} - Image ${index + 1}`} />
                <p class="image-caption">Image {index + 1}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Content -->
      <div class="site-content">
        <Content />
      </div>
    </div>

    <!-- Print Footer -->
    <div class="print-footer">
      <p>This document was generated from the Dzaleka Digital Site Register</p>
      <p>For more information, visit: https://services.dzaleka.com/site-register</p>
      <p>© {new Date().getFullYear()} Dzaleka Digital Heritage Project</p>
    </div>
  </div>
</body>
</html>

<style>
  /* Print-specific styles */
  @media print {
    body {
      margin: 0;
      padding: 0;
      background: white;
      color: black;
      font-family: 'Times New Roman', serif;
      font-size: 12pt;
      line-height: 1.4;
    }

    .print-container {
      max-width: none;
      margin: 0;
      padding: 20px;
    }

    .print-header {
      border-bottom: 2px solid #000;
      padding-bottom: 20px;
      margin-bottom: 30px;
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .print-title {
      font-size: 24pt;
      font-weight: bold;
      margin: 0;
      color: #1f2937;
    }

    .print-subtitle {
      font-size: 14pt;
      margin: 5px 0 0 0;
      color: #6b7280;
    }

    .print-meta {
      text-align: right;
      font-size: 10pt;
    }

    .print-meta p {
      margin: 2px 0;
    }

    .site-title {
      font-size: 20pt;
      font-weight: bold;
      margin: 0 0 20px 0;
      color: #1f2937;
    }

    .site-category,
    .site-location,
    .site-established,
    .site-status {
      margin: 5px 0;
      font-size: 11pt;
    }

    .site-description,
    .site-significance,
    .site-history,
    .site-events,
    .site-condition,
    .site-resources {
      margin: 20px 0;
    }

    .site-description h2,
    .site-significance h2,
    .site-history h2,
    .site-events h2,
    .site-condition h2,
    .site-resources h2 {
      font-size: 14pt;
      font-weight: bold;
      margin: 0 0 10px 0;
      color: #1f2937;
      border-bottom: 1px solid #d1d5db;
      padding-bottom: 5px;
    }

    .site-images {
      margin: 30px 0;
    }

    .site-images h2 {
      font-size: 14pt;
      font-weight: bold;
      margin: 0 0 15px 0;
      color: #1f2937;
    }

    .image-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-top: 15px;
    }

    .image-item {
      text-align: center;
    }

    .image-item img {
      max-width: 100%;
      height: auto;
      border: 1px solid #d1d5db;
      margin-bottom: 5px;
    }

    .image-caption {
      font-size: 9pt;
      color: #6b7280;
      margin: 0;
    }

    .site-content {
      margin: 30px 0;
    }

    .site-content h1,
    .site-content h2,
    .site-content h3 {
      color: #1f2937;
      margin-top: 20px;
      margin-bottom: 10px;
    }

    .site-content p {
      margin: 10px 0;
      text-align: justify;
    }

    .resource-link {
      word-break: break-all;
      font-family: monospace;
      font-size: 10pt;
      color: #000;
      background: #f8f9fa;
      padding: 8px;
      border: 1px solid #dee2e6;
      border-radius: 4px;
    }

    .print-footer {
      border-top: 2px solid #000;
      padding-top: 20px;
      margin-top: 40px;
      text-align: center;
      font-size: 9pt;
      color: #6b7280;
    }

    .print-footer p {
      margin: 5px 0;
    }

    /* Hide non-print elements */
    .no-print {
      display: none !important;
    }

    /* Page breaks */
    .site-images,
    .site-content {
      page-break-inside: avoid;
    }

    h1, h2 {
      page-break-after: avoid;
    }
  }

  /* Screen styles (for preview) */
  @media screen {
    .print-container {
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
      background: white;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
