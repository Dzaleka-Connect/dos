---
import MainLayout from '../../layouts/MainLayout.astro';
import FormHeader from '../../components/ui/FormHeader.astro';

const seo = {
  title: "Update a site record | Dzaleka Online Services",
  description: "Submit updates, corrections, or additional information about heritage sites in Dzaleka Refugee Camp. Help us maintain accurate and comprehensive records.",
  type: "website",
  canonical: "https://services.dzaleka.com/site-register/submit-update",
  openGraph: {
    title: "Update a site record | Dzaleka Online Services",
    description: "Submit updates, corrections, or additional information about heritage sites in Dzaleka Refugee Camp.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/site-register/submit-update"
  }
};
---

<MainLayout
  title={seo.title}
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
>
  <FormHeader title="Update a site record" description="Name the site, explain what should change and include a source or note supporting your correction." parent="Site Register" href="/site-register" />

  <div class="min-h-screen bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="bg-white rounded border border-slate-200 p-5 sm:p-8">
        <form id="updateForm" action="https://formspree.io/f/xqaaajae" method="POST" class="submission-form space-y-6">
          <!-- Site Information -->
          <div>
            <label for="site-name" class="block text-sm font-medium text-gray-700 mb-2">
              Site name
            </label>
            <input
              type="text"
              id="site-name"
              name="siteName"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
            />
          </div>

          <!-- Update Type -->
          <div>
            <fieldset>
              <legend class="text-sm font-medium text-gray-700 mb-2">Type of update</legend>
              <div class="mt-2 space-y-2">
                <div class="flex items-start gap-3">
                  <input type="radio" id="update-type-1" name="updateType" value="correction" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="update-type-1" class="text-sm text-gray-700">Correction to existing information</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="update-type-2" name="updateType" value="addition" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="update-type-2" class="text-sm text-gray-700">Additional information</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="update-type-3" name="updateType" value="historical" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="update-type-3" class="text-sm text-gray-700">Historical information</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="update-type-4" name="updateType" value="contact" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="update-type-4" class="text-sm text-gray-700">Contact information update</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="update-type-5" name="updateType" value="status" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="update-type-5" class="text-sm text-gray-700">Status or condition update</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="update-type-6" name="updateType" value="other" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="update-type-6" class="text-sm text-gray-700">Other</label>
                </div>
              </div>
            </fieldset>
          </div>

          <!-- Field Being Updated -->
          <div>
            <fieldset>
              <legend class="text-sm font-medium text-gray-700 mb-2">Field being updated <span class="font-normal text-slate-600">(optional)</span></legend>
              <div class="mt-2 space-y-2">
                <div class="flex items-start gap-3">
                  <input type="radio" id="field-updated-1" name="fieldUpdated" value="name" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="field-updated-1" class="text-sm text-gray-700">Site name</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="field-updated-2" name="fieldUpdated" value="description" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="field-updated-2" class="text-sm text-gray-700">Description</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="field-updated-3" name="fieldUpdated" value="location" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="field-updated-3" class="text-sm text-gray-700">Location</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="field-updated-4" name="fieldUpdated" value="history" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="field-updated-4" class="text-sm text-gray-700">History</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="field-updated-5" name="fieldUpdated" value="condition" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="field-updated-5" class="text-sm text-gray-700">Condition</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="field-updated-6" name="fieldUpdated" value="contact" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="field-updated-6" class="text-sm text-gray-700">Contact information</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="field-updated-7" name="fieldUpdated" value="multiple" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="field-updated-7" class="text-sm text-gray-700">Multiple fields</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="field-updated-8" name="fieldUpdated" value="other" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="field-updated-8" class="text-sm text-gray-700">Other</label>
                </div>
              </div>
            </fieldset>
          </div>

          <!-- Current Information -->
          <div>
            <label for="current-info" class="block text-sm font-medium text-gray-700 mb-2">
              Current information (if correcting) <span class="font-normal text-slate-600">(optional)</span></label>
            <p id="current-info-hint" class="mb-1 text-sm text-slate-600">Provide the current/incorrect information that needs to be updated</p>
            <textarea aria-describedby="current-info-hint"
              id="current-info"
              name="currentInfo"
              rows="3"
              class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
            ></textarea>
          </div>

          <!-- Updated Information -->
          <div>
            <label for="updated-info" class="block text-sm font-medium text-gray-700 mb-2">
              Updated/correct information
            </label>
            <p id="updated-info-hint" class="mb-1 text-sm text-slate-600">Provide the corrected or new information</p>
            <textarea aria-describedby="updated-info-hint"
              id="updated-info"
              name="updatedInfo"
              rows="4"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
            ></textarea>
          </div>

          <!-- Source of Information -->
          <div>
            <label for="source" class="block text-sm font-medium text-gray-700 mb-2">
              Source of information <span class="font-normal text-slate-600">(optional)</span></label>
            <p id="source-hint" class="mb-1 text-sm text-slate-600">How did you obtain this information? (for example, personal knowledge, documents, interviews)</p>
            <input aria-describedby="source-hint"
              type="text"
              id="source"
              name="source"
              class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
            />
          </div>

          <!-- Supporting Documents -->
          <div>
            <label for="documents" class="block text-sm font-medium text-gray-700 mb-2">
              Supporting documents (if available)
            </label>
            <input
              type="file"
              id="documents"
              name="documents"
              multiple
              accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"
              class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
            />
            <p class="text-sm text-gray-500 mt-1">
              Accepted formats: PDF, JPG, PNG, DOC, DOCX (max 5 files, 10MB each)
            </p>
          </div>

          <!-- Contact Information -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                Your name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                Email address
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
              />
            </div>
          </div>

          <!-- Phone Number -->
          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
              Phone number <span class="font-normal text-slate-600">(optional)</span></label>
            <p id="phone-hint" class="mb-1 text-sm text-slate-600">Start with the country code, +265</p>
            <input aria-describedby="phone-hint"
              type="tel"
              id="phone"
              name="phone"
              class="w-full px-3 py-2 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
            />
          </div>

          <!-- Relationship to Site -->
          <div>
            <fieldset>
              <legend class="text-sm font-medium text-gray-700 mb-2">Your relationship to the site <span class="font-normal text-slate-600">(optional)</span></legend>
              <div class="mt-2 space-y-2">
                <div class="flex items-start gap-3">
                  <input type="radio" id="relationship-1" name="relationship" value="resident" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="relationship-1" class="text-sm text-gray-700">Camp resident</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="relationship-2" name="relationship" value="visitor" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="relationship-2" class="text-sm text-gray-700">Visitor</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="relationship-3" name="relationship" value="researcher" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="relationship-3" class="text-sm text-gray-700">Researcher</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="relationship-4" name="relationship" value="staff" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="relationship-4" class="text-sm text-gray-700">Staff member</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="relationship-5" name="relationship" value="volunteer" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="relationship-5" class="text-sm text-gray-700">Volunteer</label>
                </div>
                <div class="flex items-start gap-3">
                  <input type="radio" id="relationship-6" name="relationship" value="other" class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                  <label for="relationship-6" class="text-sm text-gray-700">Other</label>
                </div>
              </div>
            </fieldset>
          </div>

          <!-- Submit Button -->
          <div class="flex justify-end">
            <button
              type="submit"
              id="submitButton"
              class="min-h-[44px] px-6 py-3 bg-primary-900 text-white rounded hover:bg-primary-800 focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors disabled:opacity-50"
            >
              <span id="submitText">Update a site record</span>
              <span id="submitSpinner" class="hidden">
                <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </span>
            </button>
          </div>

          <!-- Success Message -->
          <div id="successMessage" role="status" tabindex="-1" class="hidden mt-4 rounded bg-green-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm font-medium text-green-800">Update submitted. We'll review it within 2-3 business days.</p>
              </div>
            </div>
          </div>

          <!-- Error Message -->
          <div id="errorMessage" role="alert" tabindex="-1" class="hidden mt-4 rounded bg-red-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm font-medium text-red-800">Error submitting update. Try again.</p>
              </div>
            </div>
          </div>
        </form>
      </div>

      <!-- Additional Information -->
      <div class="mt-8 bg-slate-50 rounded border border-slate-200 p-6">
        <h2 class="text-lg font-semibold text-slate-900 mb-3">What happens next</h2>
        <ul class="space-y-2 text-slate-700">
          <li class="flex items-start">
            <svg class="w-5 h-5 text-slate-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>We'll review your update within 2-3 business days</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 text-slate-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>We may contact you for additional information or clarification</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 text-slate-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Approved updates will be published to the site register</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 text-slate-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>You'll receive confirmation when your update is published</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <script>
    import { prefillRecordForm } from '../../utils/recordForm';
    const form = document.getElementById('updateForm') as HTMLFormElement;
    const submitButton = document.getElementById('submitButton') as HTMLButtonElement;
    const submitText = document.getElementById('submitText') as HTMLElement;
    const submitSpinner = document.getElementById('submitSpinner') as HTMLElement;
    const successMessage = document.getElementById('successMessage') as HTMLElement;
    const errorMessage = document.getElementById('errorMessage') as HTMLElement;

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Show loading state
        submitButton.disabled = true;
        submitText.classList.add('hidden');
        submitSpinner.classList.remove('hidden');
        successMessage.classList.add('hidden');
        errorMessage.classList.add('hidden');

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: {
              'Accept': 'application/json'
            }
          });

          const data = await response.json();

          if (response.ok) {
            // Show success message
            form.reset();
            successMessage.classList.remove('hidden');
            successMessage.focus();
          } else {
            throw new Error(data.error || 'Error submitting update');
          }
        } catch (error) {
          // Show error message
          console.error('Submission error:', error);
          errorMessage.classList.remove('hidden');
          errorMessage.focus();
        } finally {
          // Reset button state
          submitButton.disabled = false;
          submitText.classList.remove('hidden');
          submitSpinner.classList.add('hidden');
        }
      });
    }

    if (form) prefillRecordForm(form, new URLSearchParams(window.location.search), ['siteName', 'location']);
  </script>
</MainLayout>
