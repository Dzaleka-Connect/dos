---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import PoetDirectory from '../../components/culture/PoetDirectory.astro';
export async function getStaticPaths() {
  const total = Math.ceil((await getCollection('poets')).length / 6);
  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({ params: { page: String(i + 2) } }));
}
const currentPage = Number(Astro.params.page);
---
<MainLayout title={`Poets from Dzaleka — page ${currentPage}`} description={`Browse page ${currentPage} of Dzaleka’s poet and spoken word directory.`} canonical={`https://services.dzaleka.com/poets/${currentPage}`}>
  <PoetDirectory currentPage={currentPage} />
</MainLayout>
