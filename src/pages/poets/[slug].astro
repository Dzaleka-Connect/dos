---
import MainLayout from '../../layouts/MainLayout.astro';
import CreativeProfile from '../../components/culture/CreativeProfile.astro';
import { getCollection, render } from 'astro:content';
import { recordImageUrl } from '../../utils/recordMedia';

export async function getStaticPaths() {
  return (await getCollection('poets')).map(poet => ({ params: { slug: poet.id }, props: { poet } }));
}
const { poet } = Astro.props;
const { Content } = await render(poet);
const data = poet.data;
const canonical = `https://services.dzaleka.com/poets/${poet.id}`;
const image = recordImageUrl(data.image);
const facts = [
  { label: 'Nationality', value: data.nationality },
  { label: 'Also known as', value: data.nickname },
  { label: 'Age recorded in this biography', value: data.age },
  { label: 'Birthplace', value: data.birthplace },
  { label: 'Arrived in Malawi', value: data.arrivedInMalawi },
  { label: 'Started writing', value: data.startedWriting || data.startedPoetry },
  { label: 'First performance', value: data.firstPerformance },
  { label: 'Poetry group', value: data.poetryGroup },
  { label: 'Volunteer work', value: data.volunteerWork },
  { label: 'Biography by', value: data.biographyAuthor },
];
---
<MainLayout title={`${data.title} | Poets from Dzaleka`} description={data.description} canonical={canonical} image={image} type="profile" schema={{ '@context': 'https://schema.org', '@type': 'Person', name: data.title, description: data.description, url: canonical, jobTitle: 'Poet', image: image ? new URL(image, canonical).href : undefined }}>
  <CreativeProfile title={data.title} description={data.description} image={image} photographer={data.photographer} parent="Poets" href="/poets" kind="Poetry and spoken word" facts={facts}>
    <div class="poet-writing"><Content /></div>
    {(data.email || data.whatsapp) && <section slot="details" class="border-t border-slate-200 pt-5">
      <h2 class="text-xl text-primary-900">Published contacts</h2>
      {data.email && <a href={`mailto:${data.email}`} class="mt-2 inline-flex min-h-[44px] items-center break-all text-sm text-primary-800 underline underline-offset-4">{data.email}</a>}
      {data.whatsapp && <a href={`https://wa.me/${data.whatsapp.replace(/\D/g, '')}`} class="block min-h-[44px] py-3 text-sm text-primary-800 underline underline-offset-4">WhatsApp</a>}
    </section>}
    <aside slot="after" class="mt-8 border-t border-slate-200 pt-6">
      <h2 class="text-primary-900">Poetry readings and enquiries</h2>
      <p class="mt-3 text-base leading-7 text-slate-700">For an enquiry about this profile or a poetry reading, <a href="/contact" class="text-primary-800 underline underline-offset-4">contact the directory team</a> and include {data.title}’s name.</p>
      <a href="/poets" class="mt-3 inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">Browse all poets →</a>
    </aside>
  </CreativeProfile>
</MainLayout>

<style>
  .poet-writing :global(h2[id^="featured-poem"] ~ p) { white-space: pre-line; }
</style>
