---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const pageTitle = 'Restaurants and Shops | Dzaleka Online Services';
const description =
  'Find restaurants, cafés, bakeries, shops, salons, and local businesses listed through the Dzaleka marketplace.';
const image = '/images/Dzaleka_Marketplace.jpeg';

const allStores = await getCollection('stores');
const activeStores = allStores
  .filter((store) => store.data.status === 'active')
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return new Date(b.data.dateJoined).getTime() - new Date(a.data.dateJoined).getTime();
  });

const storeTypes = [
  { value: 'all', label: 'All businesses', icon: '🏪' },
  { value: 'restaurant', label: 'Restaurants', icon: '🍽️' },
  { value: 'cafe', label: 'Cafes', icon: '☕' },
  { value: 'bakery', label: 'Bakeries', icon: '🥖' },
  { value: 'grocery', label: 'Groceries', icon: '🛒' },
  { value: 'retail', label: 'Retail', icon: '🛍️' },
  { value: 'salon', label: 'Salons', icon: '💇' },
  { value: 'workshop', label: 'Workshops', icon: '🔧' },
];

const typeIcons = {
  restaurant: '🍽️',
  cafe: '☕',
  bakery: '🥖',
  grocery: '🛒',
  retail: '🛍️',
  salon: '💇',
  workshop: '🔧',
  other: '🏪',
};
---

<MainLayout title={pageTitle} description={description} image={image} canonical="https://services.dzaleka.com/marketplace/stores">
  <main class="bg-gray-50">
    <section class="relative overflow-hidden bg-gray-900 py-16 sm:py-24">
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0 z-0">
        <img
          src={image}
          alt="Restaurants and Shops"
          class="h-full w-full object-cover opacity-30"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/90 to-gray-900/40"></div>
      </div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl">
          <nav class="mb-8 text-sm font-medium text-gray-400">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span class="mx-2">/</span>
            <a href="/marketplace" class="hover:text-white transition-colors">Marketplace</a>
            <span class="mx-2">/</span>
            <span class="text-white">Restaurants and shops</span>
          </nav>

          <span class="inline-block rounded-full border border-white/20 bg-white/10 px-4 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-white backdrop-blur-sm">
            Business Directory
          </span>
          <h1 class="mt-6 text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
            Restaurants and Shops
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-gray-300">
            Browse verified business profiles for local food, retail, and workshops. Direct access to menus, hours, and service details.
          </p>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="/marketplace/stores/register"
              class="inline-flex items-center rounded-xl bg-white px-6 py-3 text-sm font-bold text-gray-900 transition hover:bg-gray-100"
            >
              Register a business
            </a>
            <a
              href="/marketplace"
              class="inline-flex items-center rounded-xl border border-white/30 bg-white/5 px-6 py-3 text-sm font-bold text-white backdrop-blur-sm transition hover:bg-white/10 hover:border-white/50"
            >
              Back to marketplace
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="sticky top-0 z-10 border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-2 overflow-x-auto pb-1">
          {storeTypes.map((type) => (
            <button
              data-filter={type.value}
              class={`filter-btn whitespace-nowrap rounded-lg px-4 py-2 text-sm font-medium transition ${type.value === 'all' ? 'bg-primary-700 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}
            >
              <span class="mr-2">{type.icon}</span>
              {type.label}
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        {activeStores.length === 0 ? (
          <div class="rounded-xl border border-gray-200 bg-gray-50 px-6 py-12 text-center">
            <h2 class="text-xl font-semibold text-gray-900">No business profiles are published yet</h2>
            <p class="mt-2 text-sm text-gray-600">Register a shop, café, or local business to create the first profile.</p>
            <a
              href="/marketplace/stores/register"
              class="mt-5 inline-flex rounded-lg bg-primary-700 px-5 py-3 text-sm font-medium text-white hover:bg-primary-800"
            >
              Register a business
            </a>
          </div>
        ) : (
          <>
            <div id="storesGrid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {activeStores.map((store) => (
                <a
                  href={`/marketplace/stores/${store.id}`}
                  class="store-card overflow-hidden rounded-xl border border-gray-200 bg-white transition hover:border-primary-200 hover:shadow-sm"
                  data-type={store.data.type}
                >
                  <div class="aspect-[4/3] bg-gray-100">
                    {store.data.coverImage ? (
                      <img src={store.data.coverImage} alt={store.data.name} class="h-full w-full object-cover" />
                    ) : (
                      <div class="flex h-full items-center justify-center bg-gray-100 text-5xl">
                        {typeIcons[store.data.type]}
                      </div>
                    )}
                  </div>

                  <div class="p-5">
                    <div class="flex flex-wrap gap-2">
                      <span class="rounded-lg bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700 capitalize">
                        {store.data.type}
                      </span>
                      {store.data.featured && (
                        <span class="rounded-lg bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700">
                          Featured
                        </span>
                      )}
                    </div>

                    <h2 class="mt-3 text-lg font-semibold text-gray-900">{store.data.name}</h2>
                    <p class="mt-2 text-sm leading-6 text-gray-600 line-clamp-3">{store.data.description}</p>
                    <p class="mt-4 text-sm text-gray-500">{store.data.location.address}</p>
                  </div>
                </a>
              ))}
            </div>

            <div id="pagination" class="mt-8 flex items-center justify-center gap-2">
              <button id="prevPage" class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50">
                Previous
              </button>
              <span id="pageInfo" class="px-3 py-2 text-sm text-gray-600"></span>
              <button id="nextPage" class="rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50">
                Next
              </button>
            </div>
          </>
        )}
      </div>
    </section>

    <section class="border-t border-gray-200 bg-gray-50">
      <div class="mx-auto grid max-w-7xl gap-6 px-4 py-12 sm:px-6 lg:grid-cols-3 lg:px-8">
        <article class="rounded-xl border border-gray-200 bg-white p-5">
          <h2 class="text-lg font-semibold text-gray-900">What profiles can include</h2>
          <p class="mt-2 text-sm leading-6 text-gray-600">Business details, opening hours, menu items, payment methods, delivery options, and direct contact information.</p>
        </article>
        <article class="rounded-xl border border-gray-200 bg-white p-5">
          <h2 class="text-lg font-semibold text-gray-900">Who can register</h2>
          <p class="mt-2 text-sm leading-6 text-gray-600">Restaurants, cafés, bakeries, grocery shops, salons, repair workshops, retail businesses, and similar local services.</p>
        </article>
        <article class="rounded-xl border border-gray-200 bg-white p-5">
          <h2 class="text-lg font-semibold text-gray-900">Need a simple listing instead?</h2>
          <p class="mt-2 text-sm leading-6 text-gray-600">For a one-off product or service, use the general marketplace listing form instead of a full business profile.</p>
          <a href="/marketplace/submit" class="mt-4 inline-flex text-sm font-medium text-primary-700 hover:text-primary-800">Create a marketplace listing</a>
        </article>
      </div>
    </section>
  </main>
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const storeCards = Array.from(document.querySelectorAll('.store-card'));
    const prevBtn = document.getElementById('prevPage');
    const nextBtn = document.getElementById('nextPage');
    const pageInfo = document.getElementById('pageInfo');

    const itemsPerPage = 6;
    let currentPage = 1;
    let currentFilter = 'all';

    function getFilteredCards() {
      return storeCards.filter((card) => {
        if (currentFilter === 'all') return true;
        return card.dataset.type === currentFilter;
      });
    }

    function updatePagination() {
      const filteredCards = getFilteredCards();
      const totalPages = Math.ceil(filteredCards.length / itemsPerPage);

      storeCards.forEach((card) => {
        card.style.display = 'none';
      });

      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;
      filteredCards.slice(startIndex, endIndex).forEach((card) => {
        card.style.display = 'block';
      });

      pageInfo.textContent = `Page ${currentPage} of ${totalPages || 1}`;
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentFilter = btn.dataset.filter;
        currentPage = 1;

        filterBtns.forEach((button) => {
          button.classList.remove('bg-primary-700', 'text-white');
          button.classList.add('bg-gray-100', 'text-gray-700');
        });
        btn.classList.remove('bg-gray-100', 'text-gray-700');
        btn.classList.add('bg-primary-700', 'text-white');

        updatePagination();
      });
    });

    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        updatePagination();
      }
    });

    nextBtn.addEventListener('click', () => {
      const filteredCards = getFilteredCards();
      const totalPages = Math.ceil(filteredCards.length / itemsPerPage);
      if (currentPage < totalPages) {
        currentPage++;
        updatePagination();
      }
    });

    updatePagination();
  });
</script>
