---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const pageTitle = "Restaurants & Shops in Dzaleka | Food, Cafes & Local Stores";
const description = "Find the best restaurants, cafes, bakeries and shops in Dzaleka Refugee Camp. Browse menus, order food, and support local businesses in Malawi.";
const keywords = "Dzaleka restaurants, food in Dzaleka, cafes Dzaleka refugee camp, shops Malawi, local eateries, African cuisine Dzaleka";
const image = "/images/Dzaleka_Marketplace.jpeg";

const allStores = await getCollection('stores');
const activeStores = allStores
  .filter(store => store.data.status === 'active')
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return new Date(b.data.dateJoined).getTime() - new Date(a.data.dateJoined).getTime();
  });

const storeTypes = [
  { value: 'all', label: 'All', icon: '🏪' },
  { value: 'restaurant', label: 'Restaurants', icon: '🍽️' },
  { value: 'cafe', label: 'Cafes', icon: '☕' },
  { value: 'bakery', label: 'Bakeries', icon: '🥖' },
  { value: 'grocery', label: 'Grocery', icon: '🛒' },
  { value: 'retail', label: 'Retail', icon: '🛍️' },
  { value: 'salon', label: 'Salons', icon: '💇' },
  { value: 'workshop', label: 'Workshops', icon: '🔧' },
];

const typeIcons = {
  restaurant: '🍽️',
  cafe: '☕',
  bakery: '🥖',
  grocery: '🛒',
  retail: '🛍️',
  salon: '💇',
  workshop: '🔧',
  other: '🏪',
};
---

<MainLayout title={pageTitle} description={description} image={image}>
  <main class="min-h-screen bg-gray-50">
    <!-- Hero -->
    <section class="relative min-h-[400px] flex items-center justify-center text-white overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="/images/Dzaleka_Marketplace_Cover.jpeg"
          alt="Dzaleka Restaurants & Shops"
          class="w-full h-full object-cover animate-fade-in"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Restaurants & Shops</h1>
        <p class="text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Explore local eateries, browse menus, and shop from Dzaleka entrepreneurs
        </p>
        <a
          href="/marketplace/stores/register"
          class="inline-flex items-center bg-white text-orange-600 px-6 py-3 rounded-lg font-medium hover:bg-orange-50 transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Register Your Business
        </a>
      </div>
    </section>

    <!-- Filter Tabs -->
    <section class="py-6 bg-white border-b sticky top-0 z-10 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-2 overflow-x-auto pb-2">
          {storeTypes.map(type => (
            <button
              data-filter={type.value}
              class={`filter-btn flex items-center px-4 py-2 rounded-full font-medium whitespace-nowrap transition-colors ${type.value === 'all' ? 'bg-orange-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}`}
            >
              <span class="mr-2">{type.icon}</span>
              {type.label}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Stores Grid -->
    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {activeStores.length === 0 ? (
          <div class="text-center py-16">
            <div class="text-6xl mb-4">🏪</div>
            <h3 class="text-xl font-medium text-gray-900 mb-2">No stores yet</h3>
            <p class="text-gray-600 mb-6">Be the first to register your business!</p>
            <a href="/marketplace/stores/register" class="inline-flex items-center bg-orange-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-orange-700">
              Register Your Business
            </a>
          </div>
        ) : (
          <div id="storesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {activeStores.map((store) => (
              <a
                href={`/marketplace/stores/${store.id}`}
                class="store-card bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow"
                data-type={store.data.type}
              >
                <div class="h-48 bg-gray-100 relative">
                  <div class="absolute inset-0 overflow-hidden">
                    {store.data.coverImage ? (
                      <img src={store.data.coverImage} alt={store.data.name} class="w-full h-full object-cover object-center" />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-orange-100 to-red-100">
                        <span class="text-6xl">{typeIcons[store.data.type]}</span>
                      </div>
                    )}
                  </div>
                  {store.data.featured && (
                    <span class="absolute top-3 right-3 bg-yellow-400 text-yellow-900 text-xs font-bold px-2 py-1 rounded z-10">
                      Featured
                    </span>
                  )}
                  {store.data.logo && (
                    <div class="absolute -bottom-6 left-4 z-10">
                      <img src={store.data.logo} alt="" class="w-16 h-16 rounded-xl border-4 border-white shadow-md object-cover bg-white" />
                    </div>
                  )}
                </div>
                <div class={`p-4 ${store.data.logo ? 'pt-8' : ''}`}>
                  <div class="flex items-start justify-between mb-2">
                    <h3 class="font-bold text-gray-900 text-lg flex items-center gap-1">
                      {store.data.name}
                      <svg class="w-4 h-4 text-blue-500" viewBox="0 0 24 24" fill="currentColor">
                        <path fill-rule="evenodd" d="M8.603 3.799A4.49 4.49 0 0112 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 013.498 1.307 4.491 4.491 0 011.307 3.497A4.49 4.49 0 0121.75 12a4.49 4.49 0 01-1.549 3.397 4.491 4.491 0 01-1.307 3.498 4.491 4.491 0 01-3.497 1.307A4.49 4.49 0 0112 21.75a4.49 4.49 0 01-3.397-1.549 4.49 4.49 0 01-3.498-1.306 4.491 4.491 0 01-1.307-3.498A4.49 4.49 0 012.25 12c0-1.357.6-2.573 1.549-3.397a4.49 4.49 0 011.307-3.497 4.491 4.491 0 013.497-1.307zm7.007 6.387a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
                      </svg>
                    </h3>
                    <span class="text-sm bg-gray-100 px-2 py-1 rounded capitalize">{store.data.type}</span>
                  </div>
                  <p class="text-sm text-gray-600 mb-3 line-clamp-2">{store.data.description}</p>
                  <div class="flex items-center text-sm text-gray-500">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    {store.data.location.address}
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}

        <!-- Pagination -->
        <div id="pagination" class="flex justify-center items-center gap-2 mt-8">
          <button id="prevPage" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
            Previous
          </button>
          <span id="pageInfo" class="px-4 py-2 text-sm text-gray-600"></span>
          <button id="nextPage" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
            Next
          </button>
        </div>
      </div>
    </section>

    <!-- Why Register Section -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Why Register Your Business?</h2>
          <p class="text-gray-600 max-w-2xl mx-auto">Get your restaurant, cafe, or shop discovered by customers in Dzaleka and beyond</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center p-6">
            <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl">📋</span>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Showcase Your Menu</h3>
            <p class="text-gray-600">Display your full menu with prices, descriptions, and photos. Let customers know what you offer.</p>
          </div>
          <div class="text-center p-6">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl">📍</span>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Get Found Easily</h3>
            <p class="text-gray-600">Your business appears in search results. Customers can find your location and contact you directly.</p>
          </div>
          <div class="text-center p-6">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <span class="text-3xl">📱</span>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Direct Customer Contact</h3>
            <p class="text-gray-600">Receive orders via WhatsApp or phone. No middleman, no commission fees.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- What You Can List -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">What Businesses Can Register?</h2>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="bg-white rounded-lg p-6 text-center shadow-sm">
            <span class="text-4xl mb-3 block">🍽️</span>
            <h3 class="font-semibold text-gray-900">Restaurants</h3>
            <p class="text-sm text-gray-600 mt-1">Full meals & dining</p>
          </div>
          <div class="bg-white rounded-lg p-6 text-center shadow-sm">
            <span class="text-4xl mb-3 block">☕</span>
            <h3 class="font-semibold text-gray-900">Cafes</h3>
            <p class="text-sm text-gray-600 mt-1">Coffee & snacks</p>
          </div>
          <div class="bg-white rounded-lg p-6 text-center shadow-sm">
            <span class="text-4xl mb-3 block">🥖</span>
            <h3 class="font-semibold text-gray-900">Bakeries</h3>
            <p class="text-sm text-gray-600 mt-1">Fresh baked goods</p>
          </div>
          <div class="bg-white rounded-lg p-6 text-center shadow-sm">
            <span class="text-4xl mb-3 block">🛒</span>
            <h3 class="font-semibold text-gray-900">Grocery</h3>
            <p class="text-sm text-gray-600 mt-1">Food & supplies</p>
          </div>
          <div class="bg-white rounded-lg p-6 text-center shadow-sm">
            <span class="text-4xl mb-3 block">🛍️</span>
            <h3 class="font-semibold text-gray-900">Retail Shops</h3>
            <p class="text-sm text-gray-600 mt-1">Products & goods</p>
          </div>
          <div class="bg-white rounded-lg p-6 text-center shadow-sm">
            <span class="text-4xl mb-3 block">💇</span>
            <h3 class="font-semibold text-gray-900">Salons</h3>
            <p class="text-sm text-gray-600 mt-1">Hair & beauty</p>
          </div>
          <div class="bg-white rounded-lg p-6 text-center shadow-sm">
            <span class="text-4xl mb-3 block">🔧</span>
            <h3 class="font-semibold text-gray-900">Workshops</h3>
            <p class="text-sm text-gray-600 mt-1">Repairs & crafts</p>
          </div>
          <div class="bg-white rounded-lg p-6 text-center shadow-sm">
            <span class="text-4xl mb-3 block">🏪</span>
            <h3 class="font-semibold text-gray-900">Other</h3>
            <p class="text-sm text-gray-600 mt-1">Any local business</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-gradient-to-r from-orange-500 to-red-600">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Ready to Grow Your Business?</h2>
        <p class="text-orange-100 mb-8 text-lg">Register today and let customers discover your restaurant, cafe, or shop.</p>
        <a href="/marketplace/stores/register" class="inline-flex items-center bg-white text-orange-600 px-8 py-3 rounded-lg font-medium hover:bg-orange-50 transition-colors">
          Register Your Business
        </a>
      </div>
    </section>

    <!-- Back to Marketplace -->
    <section class="py-8 bg-white border-t">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <a href="/marketplace" class="text-orange-600 hover:text-orange-700 font-medium">
          ← Back to Marketplace
        </a>
      </div>
    </section>
  </main>
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const storeCards = Array.from(document.querySelectorAll('.store-card'));
    const prevBtn = document.getElementById('prevPage');
    const nextBtn = document.getElementById('nextPage');
    const pageInfo = document.getElementById('pageInfo');

    const itemsPerPage = 6;
    let currentPage = 1;
    let currentFilter = 'all';

    function getFilteredCards() {
      return storeCards.filter(card => {
        if (currentFilter === 'all') return true;
        return card.dataset.type === currentFilter;
      });
    }

    function updatePagination() {
      const filteredCards = getFilteredCards();
      const totalPages = Math.ceil(filteredCards.length / itemsPerPage);

      storeCards.forEach(card => card.style.display = 'none');

      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;
      filteredCards.slice(startIndex, endIndex).forEach(card => {
        card.style.display = 'block';
      });

      pageInfo.textContent = `Page ${currentPage} of ${totalPages || 1}`;
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        currentFilter = btn.dataset.filter;
        currentPage = 1;

        filterBtns.forEach(b => {
          b.classList.remove('bg-orange-600', 'text-white');
          b.classList.add('bg-gray-100', 'text-gray-700');
        });
        btn.classList.remove('bg-gray-100', 'text-gray-700');
        btn.classList.add('bg-orange-600', 'text-white');

        updatePagination();
      });
    });

    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        updatePagination();
      }
    });

    nextBtn.addEventListener('click', () => {
      const filteredCards = getFilteredCards();
      const totalPages = Math.ceil(filteredCards.length / itemsPerPage);
      if (currentPage < totalPages) {
        currentPage++;
        updatePagination();
      }
    });

    updatePagination();
  });
</script>
