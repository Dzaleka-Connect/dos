---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const stores = await getCollection('stores');
  return stores.map((store) => ({
    params: { slug: store.id },
    props: { store },
  }));
}

const { store } = Astro.props;
const { Content } = await render(store);

const typeLabels = {
  restaurant: 'Restaurant',
  cafe: 'Cafe',
  bakery: 'Bakery',
  grocery: 'Grocery store',
  retail: 'Retail shop',
  salon: 'Salon',
  workshop: 'Workshop',
  other: 'Business',
};

const schemaTypes = {
  restaurant: 'Restaurant',
  cafe: 'CafeOrCoffeeShop',
  bakery: 'Bakery',
  grocery: 'GroceryStore',
  retail: 'Store',
  salon: 'BeautySalon',
  workshop: 'LocalBusiness',
  other: 'LocalBusiness',
};

const dayOrder = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const sortedHours = store.data.hours?.sort((a, b) => dayOrder.indexOf(a.day) - dayOrder.indexOf(b.day));
const openingHoursSpec =
  sortedHours?.filter((hour) => !hour.closed).map((hour) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: hour.day,
    opens: hour.open,
    closes: hour.close,
  })) || [];

const storeUrl = `https://services.dzaleka.com/marketplace/stores/${store.id}`;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': schemaTypes[store.data.type] || 'LocalBusiness',
  name: store.data.name,
  description: store.data.description,
  image: store.data.coverImage || store.data.logo || '',
  url: storeUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: store.data.location.address,
    addressLocality: store.data.location.zone || 'Dzaleka',
    addressRegion: 'Dowa District',
    addressCountry: 'MW',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -13.6628274,
    longitude: 33.8704301,
  },
  ...(store.data.owner.phone && { telephone: store.data.owner.phone }),
  ...(store.data.owner.email && { email: store.data.owner.email }),
  ...(openingHoursSpec.length > 0 && { openingHoursSpecification: openingHoursSpec }),
  ...(store.data.paymentMethods?.length > 0 && { paymentAccepted: store.data.paymentMethods.join(', ') }),
  ...(store.data.logo && { logo: store.data.logo }),
  priceRange: '$$',
  currenciesAccepted: 'MWK',
};
---

<MainLayout
  title={`${store.data.name} | Marketplace`}
  description={store.data.description}
  image={store.data.coverImage || store.data.logo || '/images/Dzaleka_Marketplace.jpeg'}
  canonical={storeUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <div class="bg-gray-50">
    <section class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <nav class="mb-5 text-sm text-gray-500">
          <a href="/" class="hover:text-primary-700">Home</a>
          <span class="mx-2">/</span>
          <a href="/marketplace" class="hover:text-primary-700">Marketplace</a>
          <span class="mx-2">/</span>
          <a href="/marketplace/stores" class="hover:text-primary-700">Restaurants and shops</a>
          <span class="mx-2">/</span>
          <span class="text-gray-900">{store.data.name}</span>
        </nav>

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
          <div class="grid gap-6 md:grid-cols-[180px_minmax(0,1fr)]">
            <div class="overflow-hidden rounded border border-gray-200 bg-gray-100">
              {store.data.logo ? (
                <img src={store.data.logo} alt={store.data.name} class="h-full w-full object-cover" />
              ) : (
                <div class="flex aspect-square items-center justify-center text-5xl">🏪</div>
              )}
            </div>

            <div class="max-w-3xl">
              <div class="flex flex-wrap gap-2">
                <span class="rounded bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">
                  {typeLabels[store.data.type]}
                </span>
                {store.data.featured && (
                  <span class="rounded bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700">
                    Featured
                  </span>
                )}
              </div>

              <h1 class="mt-3 text-3xl font-semibold tracking-tight text-gray-900">{store.data.name}</h1>
              <p class="mt-4 text-lg leading-8 text-gray-600">{store.data.description}</p>

              <div class="mt-6 flex flex-wrap gap-2 text-sm text-gray-600">
                <span class="rounded bg-gray-100 px-3 py-1.5">{store.data.location.address}</span>
                {store.data.location.zone && (
                  <span class="rounded bg-gray-100 px-3 py-1.5">Zone: {store.data.location.zone}</span>
                )}
                {store.data.location.landmark && (
                  <span class="rounded bg-gray-100 px-3 py-1.5">Near {store.data.location.landmark}</span>
                )}
              </div>
            </div>
          </div>

          <aside class="rounded border border-gray-200 bg-gray-50 p-5">
            <h2 class="text-lg font-semibold text-gray-900">Contact business</h2>
            <div class="mt-4 space-y-3">
              {store.data.owner.phone && (
                <a href={`tel:${store.data.owner.phone}`} class="min-h-[44px] flex w-full items-center justify-center rounded bg-primary-700 px-4 py-3 font-medium text-white hover:bg-primary-800">
                  Call now
                </a>
              )}
              {store.data.owner.whatsapp && (
                <a
                  href={`https://wa.me/${store.data.owner.whatsapp.replace(/[^0-9]/g, '')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="min-h-[44px] flex w-full items-center justify-center rounded bg-green-600 px-4 py-3 font-medium text-white hover:bg-green-700"
                >
                  WhatsApp
                </a>
              )}
              {store.data.owner.email && (
                <a href={`mailto:${store.data.owner.email}`} class="min-h-[44px] flex w-full items-center justify-center rounded border border-gray-300 bg-white px-4 py-3 font-medium text-gray-700 hover:border-primary-300 hover:text-primary-700">
                  Email
                </a>
              )}
              <a
                href={`https://maps.google.com/?q=${encodeURIComponent(store.data.location.address)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="min-h-[44px] flex w-full items-center justify-center rounded border border-gray-300 bg-white px-4 py-3 font-medium text-gray-700 hover:border-primary-300 hover:text-primary-700"
              >
                Get directions
              </a>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_300px] lg:px-8">
        <div class="space-y-6">
          {store.data.menu && store.data.menu.length > 0 && (
            <section class="rounded border border-gray-200 bg-white p-6">
              <h2 class="text-xl font-semibold text-gray-900">Menu</h2>
              <div class="mt-6 space-y-8">
                {store.data.menu.map((category) => (
                  <div>
                    <h3 class="border-b border-gray-200 pb-2 text-lg font-semibold text-gray-800">{category.category}</h3>
                    <div class="mt-4 space-y-4">
                      {category.items.map((item) => (
                        <div class={`flex items-start justify-between gap-4 ${!item.available ? 'opacity-60' : ''}`}>
                          <div class="flex-1">
                            <div class="flex flex-wrap items-center gap-2">
                              <h4 class="font-medium text-gray-900">{item.name}</h4>
                              {item.popular && <span class="rounded-md bg-amber-50 px-2 py-0.5 text-xs text-amber-700">Popular</span>}
                              {!item.available && <span class="rounded-md bg-gray-100 px-2 py-0.5 text-xs text-gray-600">Unavailable</span>}
                            </div>
                            {item.description && <p class="mt-1 text-sm text-gray-600">{item.description}</p>}
                          </div>
                          <span class="whitespace-nowrap text-sm font-semibold text-primary-700">MWK {item.price}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          {store.data.services && store.data.services.length > 0 && (
            <section class="rounded border border-gray-200 bg-white p-6">
              <h2 class="text-xl font-semibold text-gray-900">Services</h2>
              <div class="mt-5 space-y-4">
                {store.data.services.map((service) => (
                  <div class="rounded bg-gray-50 p-4">
                    <div class="flex items-start justify-between gap-4">
                      <div class="flex-1">
                        <h3 class="font-medium text-gray-900">{service.name}</h3>
                        {service.description && <p class="mt-1 text-sm text-gray-600">{service.description}</p>}
                        {service.duration && <p class="mt-1 text-xs text-gray-500">Duration: {service.duration}</p>}
                      </div>
                      <span class="whitespace-nowrap text-sm font-semibold text-primary-700">MWK {service.price}</span>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          )}

          <section class="rounded border border-gray-200 bg-white p-6">
            <h2 class="text-xl font-semibold text-gray-900">About this business</h2>
            <div class="prose prose-gray mt-4 max-w-none">
              <Content />
            </div>
          </section>
        </div>

        <aside class="space-y-6">
          <section class="rounded border border-gray-200 bg-gray-50 p-5">
            <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-gray-700">Business hours</h2>
            {sortedHours && sortedHours.length > 0 ? (
              <div class="mt-4 space-y-2 text-sm">
                {sortedHours.map((hour) => (
                  <div class="flex justify-between gap-4">
                    <span class="text-gray-600">{hour.day}</span>
                    <span class={hour.closed ? 'text-red-600' : 'font-medium text-gray-900'}>
                      {hour.closed ? 'Closed' : `${hour.open} - ${hour.close}`}
                    </span>
                  </div>
                ))}
              </div>
            ) : (
              <p class="mt-4 text-sm text-gray-600">Hours have not been added yet.</p>
            )}
          </section>

          {(store.data.paymentMethods?.length > 0 || store.data.deliveryOptions?.length > 0) && (
            <section class="rounded border border-gray-200 bg-gray-50 p-5">
              {store.data.paymentMethods?.length > 0 && (
                <div>
                  <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-gray-700">Payment methods</h2>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {store.data.paymentMethods.map((method) => (
                      <span class="rounded-md border border-gray-200 bg-white px-2.5 py-1 text-sm text-gray-700">{method}</span>
                    ))}
                  </div>
                </div>
              )}

              {store.data.deliveryOptions?.length > 0 && (
                <div class={store.data.paymentMethods?.length > 0 ? 'mt-6' : ''}>
                  <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-gray-700">Delivery options</h2>
                  <div class="mt-4 flex flex-wrap gap-2">
                    {store.data.deliveryOptions.map((option) => (
                      <span class="rounded-md border border-gray-200 bg-white px-2.5 py-1 text-sm text-gray-700">{option}</span>
                    ))}
                  </div>
                </div>
              )}
            </section>
          )}

          <section class="rounded border border-gray-200 bg-gray-50 p-5">
            <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-gray-700">Owner details</h2>
            <div class="mt-4 space-y-2 text-sm text-gray-600">
              <p><span class="font-medium text-gray-900">Owner:</span> {store.data.owner.name}</p>
              {store.data.owner.phone && <p>{store.data.owner.phone}</p>}
              {store.data.owner.email && <p>{store.data.owner.email}</p>}
            </div>
          </section>
        </aside>
      </div>
    </section>
  </div>
</MainLayout>
