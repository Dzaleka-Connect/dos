---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const stores = await getCollection('stores');
  return stores.map(store => ({
    params: { slug: store.slug },
    props: { store },
  }));
}

const { store } = Astro.props;
const { Content } = await store.render();

const typeLabels = {
  restaurant: 'Restaurant',
  cafe: 'Cafe',
  bakery: 'Bakery',
  grocery: 'Grocery Store',
  retail: 'Retail Shop',
  salon: 'Salon',
  workshop: 'Workshop',
  other: 'Business',
};

const dayOrder = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const sortedHours = store.data.hours?.sort((a, b) => dayOrder.indexOf(a.day) - dayOrder.indexOf(b.day));
---

<MainLayout title={`${store.data.name} | Dzaleka Marketplace`} description={store.data.description} image={store.data.coverImage || store.data.logo || '/images/Dzaleka_Marketplace.jpeg'}>
  <main class="min-h-screen bg-gray-50">
    <!-- Cover Image -->
    <div class="h-64 md:h-80 bg-gradient-to-br from-orange-400 to-red-500 relative">
      {store.data.coverImage && (
        <img src={store.data.coverImage} alt={store.data.name} class="w-full h-full object-cover" />
      )}
      <div class="absolute inset-0 bg-black/30"></div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 -mt-20 relative z-10">
      <!-- Store Header -->
      <div class="bg-white rounded-xl shadow-lg p-6 mb-6">
        <div class="flex flex-col md:flex-row md:items-end gap-4">
          {store.data.logo ? (
            <img src={store.data.logo} alt="" class="w-24 h-24 rounded-xl border-4 border-white shadow-md object-cover bg-white" />
          ) : (
            <div class="w-24 h-24 rounded-xl border-4 border-white shadow-md bg-orange-100 flex items-center justify-center text-4xl">
              🏪
            </div>
          )}
          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <span class="text-sm bg-orange-100 text-orange-800 px-2 py-1 rounded font-medium">
                {typeLabels[store.data.type]}
              </span>
              {store.data.featured && (
                <span class="text-sm bg-yellow-100 text-yellow-800 px-2 py-1 rounded font-medium">Featured</span>
              )}
            </div>
            <h1 class="text-2xl md:text-3xl font-bold text-gray-900 flex items-center gap-2">
              {store.data.name}
              <svg class="w-6 h-6 text-blue-500" viewBox="0 0 24 24" fill="currentColor">
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </h1>
            <p class="text-gray-600 mt-1">{store.data.description}</p>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="flex flex-wrap gap-3 mt-6 pt-6 border-t">
          {store.data.owner.phone && (
            <a href={`tel:${store.data.owner.phone}`} class="inline-flex items-center bg-orange-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-orange-700">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              Call Now
            </a>
          )}
          {store.data.owner.whatsapp && (
            <a href={`https://wa.me/${store.data.owner.whatsapp.replace(/[^0-9]/g, '')}`} target="_blank" class="inline-flex items-center bg-green-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-green-700">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
              </svg>
              WhatsApp
            </a>
          )}
          <a href={`https://maps.google.com/?q=${encodeURIComponent(store.data.location.address)}`} target="_blank" class="inline-flex items-center bg-gray-100 text-gray-700 px-4 py-2 rounded-lg font-medium hover:bg-gray-200">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            </svg>
            Get Directions
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Menu -->
          {store.data.menu && store.data.menu.length > 0 && (
            <div class="bg-white rounded-xl shadow-sm p-6">
              <h2 class="text-xl font-bold text-gray-900 mb-6">Menu</h2>
              <div class="space-y-8">
                {store.data.menu.map(category => (
                  <div>
                    <h3 class="text-lg font-semibold text-gray-800 mb-4 pb-2 border-b">{category.category}</h3>
                    <div class="space-y-4">
                      {category.items.map(item => (
                        <div class={`flex justify-between items-start gap-4 ${!item.available ? 'opacity-50' : ''}`}>
                          <div class="flex-1">
                            <div class="flex items-center gap-2">
                              <h4 class="font-medium text-gray-900">{item.name}</h4>
                              {item.popular && <span class="text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded">Popular</span>}
                              {!item.available && <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded">Unavailable</span>}
                            </div>
                            {item.description && <p class="text-sm text-gray-600 mt-1">{item.description}</p>}
                          </div>
                          <span class="font-bold text-orange-600 whitespace-nowrap">MWK {item.price}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Services -->
          {store.data.services && store.data.services.length > 0 && (
            <div class="bg-white rounded-xl shadow-sm p-6">
              <h2 class="text-xl font-bold text-gray-900 mb-6">Services</h2>
              <div class="space-y-4">
                {store.data.services.map(service => (
                  <div class="flex justify-between items-start gap-4 p-4 bg-gray-50 rounded-lg">
                    <div class="flex-1">
                      <h4 class="font-medium text-gray-900">{service.name}</h4>
                      {service.description && <p class="text-sm text-gray-600 mt-1">{service.description}</p>}
                      {service.duration && <p class="text-xs text-gray-500 mt-1">Duration: {service.duration}</p>}
                    </div>
                    <span class="font-bold text-orange-600 whitespace-nowrap">MWK {service.price}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- About -->
          <div class="bg-white rounded-xl shadow-sm p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4">About</h2>
            <div class="prose prose-gray max-w-none">
              <Content />
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- Location & Hours -->
          <div class="bg-white rounded-xl shadow-sm p-6">
            <h3 class="font-bold text-gray-900 mb-4">Location</h3>
            <div class="space-y-2 text-gray-600">
              <p>{store.data.location.address}</p>
              {store.data.location.zone && <p class="text-sm">Zone: {store.data.location.zone}</p>}
              {store.data.location.landmark && <p class="text-sm">Near: {store.data.location.landmark}</p>}
            </div>

            {sortedHours && sortedHours.length > 0 && (
              <div class="mt-6 pt-6 border-t">
                <h3 class="font-bold text-gray-900 mb-4">Business Hours</h3>
                <div class="space-y-2 text-sm">
                  {sortedHours.map(h => (
                    <div class="flex justify-between">
                      <span class="text-gray-600">{h.day}</span>
                      <span class={h.closed ? 'text-red-600' : 'text-gray-900 font-medium'}>
                        {h.closed ? 'Closed' : `${h.open} - ${h.close}`}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Payment & Delivery -->
          {(store.data.paymentMethods?.length > 0 || store.data.deliveryOptions?.length > 0) && (
            <div class="bg-white rounded-xl shadow-sm p-6">
              {store.data.paymentMethods?.length > 0 && (
                <div class="mb-6">
                  <h3 class="font-bold text-gray-900 mb-3">Payment Methods</h3>
                  <div class="flex flex-wrap gap-2">
                    {store.data.paymentMethods.map(method => (
                      <span class="px-3 py-1 bg-gray-100 text-gray-700 text-sm rounded-full">{method}</span>
                    ))}
                  </div>
                </div>
              )}
              {store.data.deliveryOptions?.length > 0 && (
                <div>
                  <h3 class="font-bold text-gray-900 mb-3">Delivery Options</h3>
                  <div class="flex flex-wrap gap-2">
                    {store.data.deliveryOptions.map(option => (
                      <span class="px-3 py-1 bg-green-100 text-green-700 text-sm rounded-full">{option}</span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )}

          <!-- Contact -->
          <div class="bg-white rounded-xl shadow-sm p-6">
            <h3 class="font-bold text-gray-900 mb-4">Contact</h3>
            <div class="space-y-3">
              <p class="text-gray-600"><strong>Owner:</strong> {store.data.owner.name}</p>
              {store.data.owner.phone && (
                <p><a href={`tel:${store.data.owner.phone}`} class="text-orange-600 hover:underline">{store.data.owner.phone}</a></p>
              )}
              {store.data.owner.email && (
                <p><a href={`mailto:${store.data.owner.email}`} class="text-orange-600 hover:underline">{store.data.owner.email}</a></p>
              )}
            </div>

            {store.data.socialMedia && (
              <div class="mt-4 pt-4 border-t flex gap-3">
                {store.data.socialMedia.facebook && (
                  <a href={store.data.socialMedia.facebook} target="_blank" class="text-gray-400 hover:text-blue-600">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                  </a>
                )}
                {store.data.socialMedia.instagram && (
                  <a href={store.data.socialMedia.instagram} target="_blank" class="text-gray-400 hover:text-pink-600">
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  </a>
                )}
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- Back Link -->
      <div class="mt-8 pb-12">
        <a href="/marketplace/stores" class="text-orange-600 hover:text-orange-700 font-medium">
          ← Back to Stores
        </a>
      </div>
    </div>
  </main>
</MainLayout>
