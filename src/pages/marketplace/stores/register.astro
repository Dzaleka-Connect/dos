---
import MainLayout from '../../../layouts/MainLayout.astro';

const cloudName = import.meta.env.CLOUDINARY_CLOUD_NAME || 'dcvwslmow';
const uploadPreset = import.meta.env.PUBLIC_CLOUDINARY_UPLOAD_PRESET || 'dzaleka_unsigned';

const pageTitle = "Register Your Restaurant or Shop | Dzaleka Marketplace";
const description = "List your restaurant, cafe, bakery or shop on Dzaleka Marketplace. Create a menu, add business hours, and reach more customers in Malawi.";
const keywords = "register restaurant Dzaleka, list shop Malawi, cafe registration, food business Dzaleka, open shop refugee camp";
const image = "/images/Dzaleka_Marketplace.jpeg";

const businessTypes = [
  { value: 'restaurant', label: 'Restaurant', icon: '🍽️' },
  { value: 'cafe', label: 'Cafe', icon: '☕' },
  { value: 'bakery', label: 'Bakery', icon: '🥖' },
  { value: 'grocery', label: 'Grocery Store', icon: '🛒' },
  { value: 'retail', label: 'Retail Shop', icon: '🛍️' },
  { value: 'salon', label: 'Salon', icon: '💇' },
  { value: 'workshop', label: 'Workshop/Repair', icon: '🔧' },
  { value: 'other', label: 'Other', icon: '🏪' },
];

const days = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
---

<MainLayout title={pageTitle} description={description} image={image} canonical="https://services.dzaleka.com/marketplace/stores/register">
  <div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="mb-4 text-sm text-gray-500">
        <a href="/" class="hover:text-primary-700">Home</a>
        <span class="mx-2">/</span>
        <a href="/marketplace" class="hover:text-primary-700">Marketplace</a>
        <span class="mx-2">/</span>
        <a href="/marketplace/stores" class="hover:text-primary-700">Restaurants and shops</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900">Register a business</span>
      </nav>

      <div class="rounded border border-gray-200 bg-white p-6 sm:p-8">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary-700">Business profile</p>
          <h1 class="mt-3 text-3xl font-semibold tracking-tight text-gray-900">Register your restaurant or shop</h1>
          <p class="mt-4 text-base leading-7 text-gray-600">
            Use this form if you want a fuller business page with opening hours, menu items or services, payment methods, and location details.
          </p>
        </div>

        <div class="mt-6 rounded border border-gray-200 bg-gray-50 p-5">
          <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-gray-700">Before you start</h2>
          <ul class="mt-3 space-y-2 text-sm text-gray-600">
            <li>Prepare your business name, location details, and contact information.</li>
            <li>Add business hours if you want customers to know when you are open.</li>
            <li>Menu items and services are optional, but they help people understand what you offer.</li>
          </ul>
        </div>
      </div>

      <form id="storeForm" class="submission-form mt-6 bg-white rounded border border-gray-200 p-6 sm:p-8 space-y-8">
        <!-- Business Type -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-3">Business Type *</label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {businessTypes.map(type => (
              <label class="relative flex flex-col items-center p-3 border-2 rounded cursor-pointer hover:border-primary-300 transition-colors">
                <input type="radio" name="type" value={type.value} class="sr-only peer" required />
                <span class="text-2xl mb-1">{type.icon}</span>
                <span class="text-sm font-medium text-gray-700 peer-checked:text-primary-700">{type.label}</span>
                <div class="absolute inset-0 border-2 border-transparent peer-checked:border-primary-500 rounded pointer-events-none"></div>
              </label>
            ))}
          </div>
        </div>

        <!-- Business Name & Description -->
        <div class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Business Name *</label>
            <input type="text" id="name" name="name" required class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500 focus:border-primary-500" placeholder="For example, Mama Joy's Restaurant" />
          </div>
          <div>
            <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description *</label>
            <textarea id="description" name="description" rows="3" required class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500 focus:border-primary-500" placeholder="Tell customers about your business..."></textarea>
          </div>
        </div>

        <!-- Owner Information -->
        <div class="border-t pt-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Owner Information</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="ownerName" class="block text-sm font-medium text-gray-700 mb-1">Your Name *</label>
              <input type="text" id="ownerName" name="ownerName" required class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500" />
            </div>
            <div>
              <label for="ownerPhone" class="block text-sm font-medium text-gray-700 mb-1">Phone Number *</label>
              <input type="tel" id="ownerPhone" name="ownerPhone" required placeholder="+265..." class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500" />
            </div>
            <div>
              <label for="ownerWhatsapp" class="block text-sm font-medium text-gray-700 mb-1">WhatsApp</label>
              <input type="tel" id="ownerWhatsapp" name="ownerWhatsapp" placeholder="+265..." class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500" />
            </div>
            <div>
              <label for="ownerEmail" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
              <input type="email" id="ownerEmail" name="ownerEmail" class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500" />
            </div>
          </div>
        </div>

        <!-- Location -->
        <div class="border-t pt-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Location</h3>
          <div class="space-y-4">
            <div>
              <label for="address" class="block text-sm font-medium text-gray-700 mb-1">Address *</label>
              <input type="text" id="address" name="address" required placeholder="For example, Dzaleka Camp, Near Market" class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="zone" class="block text-sm font-medium text-gray-700 mb-1">Zone</label>
                <input type="text" id="zone" name="zone" placeholder="For example, Kawale" class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500" />
              </div>
              <div>
                <label for="landmark" class="block text-sm font-medium text-gray-700 mb-1">Nearby Landmark</label>
                <input type="text" id="landmark" name="landmark" placeholder="For example, Near the church" class="w-full px-4 py-2.5 border border-gray-300 rounded focus:ring-2 focus:ring-primary-500" />
              </div>
            </div>
          </div>
        </div>

        <!-- Business Hours -->
        <div class="border-t pt-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Business Hours</h3>
          <div class="space-y-3">
            {days.map(day => (
              <div class="grid min-w-0 grid-cols-[1fr_auto] items-center gap-3 border-b border-gray-100 pb-3 sm:grid-cols-[6rem_6rem_minmax(0,1fr)]">
                <span class="w-24 text-sm font-medium text-gray-700">{day}</span>
                <label class="flex items-center">
                  <input type="checkbox" name={`${day.toLowerCase()}_closed`} class="day-closed rounded border-gray-300" />
                  <span class="ml-2 text-sm text-gray-600">Closed</span>
                </label>
                <div class="col-span-2 grid min-w-0 grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2 sm:col-span-1">
                  <input type="time" name={`${day.toLowerCase()}_open`} aria-label={`${day} opening time`} class="day-time min-h-[44px] min-w-0 w-full px-2 py-1.5 border border-gray-300 rounded text-sm" value="08:00" />
                  <span class="text-gray-500">to</span>
                  <input type="time" name={`${day.toLowerCase()}_close`} aria-label={`${day} closing time`} class="day-time min-h-[44px] min-w-0 w-full px-2 py-1.5 border border-gray-300 rounded text-sm" value="18:00" />
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Menu Items (for restaurants/cafes) -->
        <div class="border-t pt-6" id="menuSection">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-medium text-gray-900">Menu Items</h3>
            <button type="button" id="addMenuItem" class="min-h-[44px] text-sm text-primary-700 hover:text-primary-800 font-medium">+ Add Item</button>
          </div>
          <div id="menuItems" class="space-y-4">
            <div class="menu-item p-4 bg-gray-50 rounded space-y-3">
              <div class="grid grid-cols-2 gap-3">
                <input type="text" name="menu_item_name[]" aria-label="Item name" placeholder="Item name" class="px-3 py-2 border border-gray-300 rounded text-sm" />
                <input type="text" name="menu_item_price[]" aria-label="Item price in MWK" placeholder="Price (MWK)" class="px-3 py-2 border border-gray-300 rounded text-sm" />
              </div>
              <input type="text" name="menu_item_desc[]" aria-label="Item description" placeholder="Description (optional)" class="w-full px-3 py-2 border border-gray-300 rounded text-sm" />
              <select name="menu_item_category[]" aria-label="Item category" class="w-full px-3 py-2 border border-gray-300 rounded text-sm">
                <option value="">Select category</option>
                <option value="Main Dishes">Main Dishes</option>
                <option value="Breakfast">Breakfast</option>
                <option value="Snacks">Snacks</option>
                <option value="Beverages">Beverages</option>
                <option value="Desserts">Desserts</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Payment & Delivery -->
        <div class="border-t pt-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Payment & Delivery</h3>
          <div class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Payment Methods</label>
              <div class="flex flex-wrap gap-3">
                <label class="flex items-center"><input type="checkbox" name="payment" value="Cash" class="rounded border-gray-300 text-primary-600" /><span class="ml-2 text-sm">Cash</span></label>
                <label class="flex items-center"><input type="checkbox" name="payment" value="Airtel Money" class="rounded border-gray-300 text-primary-600" /><span class="ml-2 text-sm">Airtel Money</span></label>
                <label class="flex items-center"><input type="checkbox" name="payment" value="TNM Mpamba" class="rounded border-gray-300 text-primary-600" /><span class="ml-2 text-sm">TNM Mpamba</span></label>
                <label class="flex items-center"><input type="checkbox" name="payment" value="Bank Transfer" class="rounded border-gray-300 text-primary-600" /><span class="ml-2 text-sm">Bank Transfer</span></label>
              </div>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Delivery Options</label>
              <div class="flex flex-wrap gap-3">
                <label class="flex items-center"><input type="checkbox" name="delivery" value="Dine-in" class="rounded border-gray-300 text-primary-600" /><span class="ml-2 text-sm">Dine-in</span></label>
                <label class="flex items-center"><input type="checkbox" name="delivery" value="Takeaway" class="rounded border-gray-300 text-primary-600" /><span class="ml-2 text-sm">Takeaway</span></label>
                <label class="flex items-center"><input type="checkbox" name="delivery" value="Delivery" class="rounded border-gray-300 text-primary-600" /><span class="ml-2 text-sm">Delivery</span></label>
              </div>
            </div>
          </div>
        </div>

        <!-- Images -->
        <div class="border-t pt-6">
          <h3 class="text-lg font-medium text-gray-900 mb-4">Images</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Logo</label>
              <div id="logoPreview" class="hidden mb-2">
                <img id="logoImg" src="" alt="Logo" class="w-20 h-20 object-cover rounded border" />
              </div>
              <button type="button" id="uploadLogoBtn" class="min-h-[44px] inline-flex items-center px-4 py-2 border border-gray-300 rounded text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                <svg class="w-5 h-5 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Upload Logo
              </button>
              <input type="hidden" id="logo" name="logo" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Cover Image</label>
              <div id="coverPreview" class="hidden mb-2">
                <img id="coverImg" src="" alt="Cover" class="w-full h-24 object-cover rounded border" />
              </div>
              <button type="button" id="uploadCoverBtn" class="min-h-[44px] inline-flex items-center px-4 py-2 border border-gray-300 rounded text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                <svg class="w-5 h-5 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                Upload Cover
              </button>
              <input type="hidden" id="coverImage" name="coverImage" />
            </div>
          </div>
        </div>

        <!-- Submit -->
        <div class="pt-4">
          <button type="submit" class="min-h-[44px] w-full bg-primary-900 text-white py-3 px-6 rounded font-medium hover:bg-primary-800 transition-colors">
            Register Business
          </button>
          <p class="mt-3 text-xs text-gray-500 text-center">Your business will be reviewed before being published.</p>
        </div>
      </form>
    </div>
  </div>
</MainLayout>

<script define:vars={{ cloudName, uploadPreset }}>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('storeForm');
    const addMenuBtn = document.getElementById('addMenuItem');
    const menuItems = document.getElementById('menuItems');

    // Cloudinary upload via API
    const setupUpload = (btnId, inputId, previewId, imgId, folder) => {
      const btn = document.getElementById(btnId);
      const input = document.getElementById(inputId);
      const preview = document.getElementById(previewId);
      const img = document.getElementById(imgId);

      if (!btn) return;

      const fileInput = document.createElement('input');
      fileInput.type = 'file';
      fileInput.accept = 'image/*';
      fileInput.style.display = 'none';
      document.body.appendChild(fileInput);

      btn.addEventListener('click', () => fileInput.click());

      fileInput.addEventListener('change', async () => {
        if (!fileInput.files?.[0]) return;

        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="animate-pulse">Uploading...</span>';

        try {
          const formData = new FormData();
          formData.append('file', fileInput.files[0]);
          formData.append('upload_preset', uploadPreset);
          formData.append('folder', folder);

          const response = await fetch(`https://api.cloudinary.com/v1_1/${cloudName}/image/upload`, {
            method: 'POST',
            body: formData
          });

          const data = await response.json();
          if (data.secure_url) {
            input.value = data.secure_url;
            img.src = data.secure_url;
            preview.classList.remove('hidden');
            btn.innerHTML = originalHtml.replace('Upload', 'Change');
          }
        } catch (error) {
          console.error('Upload error:', error);
          alert('Failed to upload image. Try again.');
          btn.innerHTML = originalHtml;
        }
        btn.disabled = false;
      });
    };

    setupUpload('uploadLogoBtn', 'logo', 'logoPreview', 'logoImg', 'stores/logos');
    setupUpload('uploadCoverBtn', 'coverImage', 'coverPreview', 'coverImg', 'stores/covers');

    // Add menu item
    addMenuBtn?.addEventListener('click', () => {
      const template = menuItems.querySelector('.menu-item').cloneNode(true);
      template.querySelectorAll('input, select').forEach(el => el.value = '');
      menuItems.appendChild(template);
    });

    // Handle form submission
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]');
      const originalText = submitBtn.textContent;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';

      try {
        const formData = new FormData(form);
        const days = ['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'];

        const hours = days.map(day => ({
          day: day.charAt(0).toUpperCase() + day.slice(1),
          open: formData.get(`${day}_open`) || '08:00',
          close: formData.get(`${day}_close`) || '18:00',
          closed: formData.get(`${day}_closed`) === 'on',
        }));

        // Build menu from form
        const menuItemNames = formData.getAll('menu_item_name[]');
        const menuItemPrices = formData.getAll('menu_item_price[]');
        const menuItemDescs = formData.getAll('menu_item_desc[]');
        const menuItemCats = formData.getAll('menu_item_category[]');

        const menuByCategory = {};
        menuItemNames.forEach((name, i) => {
          if (name && menuItemPrices[i]) {
            const cat = menuItemCats[i] || 'Other';
            if (!menuByCategory[cat]) menuByCategory[cat] = [];
            menuByCategory[cat].push({
              name,
              price: menuItemPrices[i],
              description: menuItemDescs[i] || '',
            });
          }
        });

        const menu = Object.entries(menuByCategory).map(([category, items]) => ({ category, items }));

        const data = {
          type: formData.get('type'),
          name: formData.get('name'),
          description: formData.get('description'),
          owner: {
            name: formData.get('ownerName'),
            phone: formData.get('ownerPhone'),
            whatsapp: formData.get('ownerWhatsapp'),
            email: formData.get('ownerEmail'),
          },
          location: {
            address: formData.get('address'),
            zone: formData.get('zone'),
            landmark: formData.get('landmark'),
          },
          hours,
          menu,
          paymentMethods: formData.getAll('payment'),
          deliveryOptions: formData.getAll('delivery'),
          logo: formData.get('logo'),
          coverImage: formData.get('coverImage'),
        };

        // Submit to Formspree first (backup storage)
        const formspreeResponse = await fetch('https://formspree.io/f/xqaaajae', {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' }
        });

        if (!formspreeResponse.ok) {
          console.error('Formspree error');
        }

        // Send email notification via Netlify function
        fetch('/.netlify/functions/submit-store', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        }).catch(err => console.error('Netlify function error:', err));

        window.location.href = '/marketplace/stores/success';
      } catch (error) {
        console.error('Error:', error);
        alert('There was an error. Try again.');
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  });
</script>
