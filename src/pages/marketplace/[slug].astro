---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const listings = await getCollection('marketplace');
  return listings.map((listing) => ({
    params: { slug: listing.id },
    props: { listing },
  }));
}

const { listing } = Astro.props;
const { Content } = await render(listing);

const priceDisplay =
  listing.data.priceType === 'free'
    ? 'Free'
    : listing.data.priceType === 'contact'
      ? 'Contact for price'
      : listing.data.price
        ? listing.data.price.includes('USD') || listing.data.price.includes('MWK')
          ? listing.data.price
          : `MWK ${listing.data.price}`
        : 'Contact for price';

const conditionDisplay = {
  new: 'New',
  used: 'Used',
  refurbished: 'Refurbished',
}[listing.data.condition] || null;

const isBook = listing.data.category === 'books-media';
const listingLabel = isBook ? 'Book' : listing.data.type === 'service' ? 'Service' : 'Product';
const schemaType = isBook ? 'Book' : listing.data.type === 'service' ? 'Service' : 'Product';
const listingUrl = `https://services.dzaleka.com/marketplace/${listing.id}`;
const isMarketplaceProduct = !isBook && listing.data.type === 'product';
const returnPolicyUrl = 'https://services.dzaleka.com/marketplace/returns';
const shippingPolicyUrl = 'https://services.dzaleka.com/marketplace/shipping';

const schemaData = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: listing.data.title,
  description: listing.data.description,
  image: listing.data.images || [],
  url: listingUrl,
  ...(isMarketplaceProduct && {
    brand: {
      '@type': 'Brand',
      name: listing.data.vendor.name,
    },
    sku: listing.id,
  }),
  ...(isBook && { author: { '@type': 'Person', name: listing.data.vendor.name } }),
  offers: {
    '@type': 'Offer',
    price: listing.data.price?.replace(/[^0-9.]/g, '') || '0',
    priceCurrency: listing.data.price?.includes('USD') ? 'USD' : 'MWK',
    availability: 'https://schema.org/InStock',
    seller: {
      '@type': 'Person',
      name: listing.data.vendor.name,
    },
    ...(isMarketplaceProduct && {
      hasMerchantReturnPolicy: {
        '@id': `${returnPolicyUrl}#policy`,
      },
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        hasShippingService: {
          '@id': `${shippingPolicyUrl}#policy`,
        },
      },
    }),
    ...(listing.data.condition && {
      itemCondition:
        listing.data.condition === 'new'
          ? 'https://schema.org/NewCondition'
          : listing.data.condition === 'used'
            ? 'https://schema.org/UsedCondition'
            : 'https://schema.org/RefurbishedCondition',
    }),
  },
  datePublished: listing.data.datePosted,
  ...(listing.data.vendor.location && {
    areaServed: {
      '@type': 'Place',
      name: listing.data.vendor.location,
    },
  }),
};
---

<MainLayout
  title={`${listing.data.title} | Marketplace`}
  description={listing.data.description}
  image={listing.data.images?.[0] || '/images/Dzaleka_Marketplace.jpeg'}
  canonical={listingUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <main class="bg-gray-50">
    <section class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <nav class="mb-5 text-sm text-gray-500">
          <a href="/" class="hover:text-primary-700">Home</a>
          <span class="mx-2">/</span>
          <a href="/marketplace" class="hover:text-primary-700">Marketplace</a>
          <span class="mx-2">/</span>
          <span class="text-gray-900">{listing.data.title}</span>
        </nav>

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_320px] lg:items-start">
          <div class="grid gap-6 md:grid-cols-[280px_minmax(0,1fr)]">
            <div class="overflow-hidden rounded-xl border border-gray-200 bg-gray-100">
              {listing.data.images?.[0] ? (
                <img
                  src={listing.data.images[0]}
                  alt={listing.data.title}
                  class={`h-full w-full object-center ${isBook ? 'object-contain p-6' : 'object-cover'}`}
                />
              ) : (
                <div class="flex aspect-[4/3] items-center justify-center text-gray-400">
                  <svg class="h-14 w-14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                </div>
              )}
            </div>

            <div class="max-w-2xl">
              <div class="flex flex-wrap gap-2">
                <span class="rounded-lg bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">{listingLabel}</span>
                {conditionDisplay && (
                  <span class="rounded-lg bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">{conditionDisplay}</span>
                )}
                {listing.data.featured && (
                  <span class="rounded-lg bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700">Featured</span>
                )}
              </div>

              <h1 class="mt-3 text-3xl font-semibold tracking-tight text-gray-900">{listing.data.title}</h1>
              <p class="mt-4 text-lg leading-8 text-gray-600">{listing.data.description}</p>

              <div class="mt-6 flex flex-wrap items-center gap-3">
                <span class="text-lg font-semibold text-primary-700">{priceDisplay}</span>
                {listing.data.vendor.location && (
                  <span class="rounded-lg bg-gray-100 px-3 py-1.5 text-sm text-gray-600">{listing.data.vendor.location}</span>
                )}
              </div>
            </div>
          </div>

          <aside class="rounded-xl border border-gray-200 bg-gray-50 p-5">
            <h2 class="text-lg font-semibold text-gray-900">Contact vendor</h2>
            <div class="mt-4 space-y-4 text-sm">
              <div>
                <p class="text-gray-500">Vendor</p>
                <p class="mt-1 font-medium text-gray-900">{listing.data.vendor.name}</p>
              </div>

              {listing.data.vendor.location && (
                <div>
                  <p class="text-gray-500">Location</p>
                  <p class="mt-1 text-gray-700">{listing.data.vendor.location}</p>
                </div>
              )}

              <div class="space-y-3 pt-2">
                {listing.data.vendor.phone && (
                  <a
                    href={`tel:${listing.data.vendor.phone}`}
                    class="flex w-full items-center justify-center rounded-lg bg-primary-700 px-4 py-3 font-medium text-white hover:bg-primary-800"
                  >
                    Call {listing.data.vendor.phone}
                  </a>
                )}

                {listing.data.vendor.whatsapp && (
                  <a
                    href={`https://wa.me/${listing.data.vendor.whatsapp.replace(/[^0-9]/g, '')}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex w-full items-center justify-center rounded-lg bg-green-600 px-4 py-3 font-medium text-white hover:bg-green-700"
                  >
                    WhatsApp
                  </a>
                )}

                {listing.data.vendor.email && (
                  <a
                    href={`mailto:${listing.data.vendor.email}`}
                    class="flex w-full items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-3 font-medium text-gray-700 hover:border-primary-300 hover:text-primary-700"
                  >
                    Email vendor
                  </a>
                )}

                {listing.data.externalLink && (
                  <a
                    href={listing.data.externalLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex w-full items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-3 font-medium text-gray-700 hover:border-primary-300 hover:text-primary-700"
                  >
                    Open external link
                  </a>
                )}
              </div>

              <p class="pt-2 text-xs text-gray-500">
                Posted on {new Date(listing.data.datePosted).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </p>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_300px] lg:px-8">
        <div class="space-y-6">
          <article class="rounded-xl border border-gray-200 bg-white p-6">
            <h2 class="text-xl font-semibold text-gray-900">Details</h2>
            <div class="prose prose-gray mt-4 max-w-none">
              <Content />
            </div>
          </article>

          {(listing.data.deliveryOptions?.length > 0 || listing.data.paymentMethods?.length > 0) && (
            <article class="rounded-xl border border-gray-200 bg-white p-6">
              <h2 class="text-xl font-semibold text-gray-900">Payment and delivery</h2>
              <div class="mt-5 grid gap-6 sm:grid-cols-2">
                {listing.data.deliveryOptions?.length > 0 && (
                  <div>
                    <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-gray-700">Delivery options</h3>
                    <ul class="mt-3 space-y-2 text-sm text-gray-600">
                      {listing.data.deliveryOptions.map((option) => (
                        <li>{option}</li>
                      ))}
                    </ul>
                  </div>
                )}

                {listing.data.paymentMethods?.length > 0 && (
                  <div>
                    <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-gray-700">Payment methods</h3>
                    <ul class="mt-3 space-y-2 text-sm text-gray-600">
                      {listing.data.paymentMethods.map((method) => (
                        <li>{method}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
              <div class="mt-6 border-t border-gray-200 pt-4 text-sm text-gray-600">
                <p>Delivery, pickup, and return terms depend on the vendor and the item.</p>
                <div class="mt-3 flex flex-wrap gap-4">
                  <a href="/marketplace/shipping" class="text-primary-700 hover:text-primary-800">Marketplace shipping guidance</a>
                  <a href="/marketplace/returns" class="text-primary-700 hover:text-primary-800">Marketplace returns guidance</a>
                </div>
              </div>
            </article>
          )}
        </div>

        <aside class="space-y-6">
          {listing.data.tags && listing.data.tags.length > 0 && (
            <section class="rounded-xl border border-gray-200 bg-gray-50 p-5">
              <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-gray-700">Tags</h2>
              <div class="mt-4 flex flex-wrap gap-2">
                {listing.data.tags.map((tag) => (
                  <span class="rounded-md border border-gray-200 bg-white px-2.5 py-1 text-sm text-gray-700">
                    {tag.replace(/-/g, ' ')}
                  </span>
                ))}
              </div>
            </section>
          )}

          <section class="rounded-xl border border-gray-200 bg-gray-50 p-5">
            <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-gray-700">Marketplace</h2>
            <ul class="mt-4 space-y-3 text-sm">
              <li><a href="/marketplace" class="text-primary-700 hover:text-primary-800">Back to all listings</a></li>
              <li><a href="/marketplace/submit" class="text-primary-700 hover:text-primary-800">Create a listing</a></li>
              <li><a href="/marketplace/stores" class="text-primary-700 hover:text-primary-800">Restaurants and shops</a></li>
            </ul>
          </section>
        </aside>
      </div>
    </section>
  </main>
</MainLayout>
