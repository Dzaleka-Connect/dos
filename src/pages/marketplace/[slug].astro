---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const listings = await getCollection('marketplace');
  return listings.map(listing => ({
    params: { slug: listing.id },
    props: { listing },
  }));
}

const { listing } = Astro.props;
const { Content } = await render(listing);

const priceDisplay = listing.data.priceType === 'free' ? 'Free' :
  listing.data.priceType === 'contact' ? 'Contact for price' :
  listing.data.price ? (listing.data.price.includes('USD') || listing.data.price.includes('MWK') ? listing.data.price : `MWK ${listing.data.price}`) : 'Contact for price';

const conditionDisplay = {
  new: 'New',
  used: 'Used',
  refurbished: 'Refurbished',
}[listing.data.condition] || null;

const isBook = listing.data.category === 'books-media';

// Schema.org Structured Data
const schemaType = isBook ? 'Book' : (listing.data.type === 'service' ? 'Service' : 'Product');

const schemaData = {
  "@context": "https://schema.org",
  "@type": schemaType,
  "name": listing.data.title,
  "description": listing.data.description,
  "image": listing.data.images || [],
  "url": `https://dzalekaonline.com/marketplace/${listing.id}`,
  ...(isBook && { "author": { "@type": "Person", "name": listing.data.vendor.name } }), // Assuming vendor is author for books here, or just seller
  "offers": {
    "@type": "Offer",
    "price": listing.data.price?.replace(/[^0-9.]/g, '') || "0",
    "priceCurrency": listing.data.price?.includes('USD') ? 'USD' : 'MWK',
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Person",
      "name": listing.data.vendor.name
    },
    ...(listing.data.condition && {
      "itemCondition": listing.data.condition === 'new' ? "https://schema.org/NewCondition" : 
                       listing.data.condition === 'used' ? "https://schema.org/UsedCondition" : 
                       "https://schema.org/RefurbishedCondition"
    })
  },
  "datePublished": listing.data.datePosted,
  ...(listing.data.vendor.location && {
    "areaServed": {
      "@type": "Place",
      "name": listing.data.vendor.location
    }
  })
};
---

<MainLayout title={`${listing.data.title} | Dzaleka Marketplace`} description={listing.data.description} image={listing.data.images?.[0] || '/images/Dzaleka_Marketplace.jpeg'}>
  <!-- Schema.org Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <main class="min-h-screen bg-gray-50 py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-6">
        <ol class="flex items-center space-x-2 text-sm text-gray-500">
          <li><a href="/marketplace" class="hover:text-blue-600">Marketplace</a></li>
          <li><span>/</span></li>
          <li class="text-gray-900">{listing.data.title}</li>
        </ol>
      </nav>

      {isBook ? (
        <!-- Book Layout -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
          <!-- Hero Section -->
          <div class="bg-gradient-to-r from-amber-50 to-orange-50 p-8 md:p-12">
            <div class="flex flex-col md:flex-row gap-8 items-start">
              <!-- Book Cover -->
              <div class="w-48 md:w-56 flex-shrink-0 mx-auto md:mx-0">
                {listing.data.images?.[0] ? (
                  <img
                    src={listing.data.images[0]}
                    alt={listing.data.title}
                    class="w-full h-auto rounded-lg shadow-xl"
                  />
                ) : (
                  <div class="aspect-[2/3] bg-gradient-to-br from-amber-200 to-orange-300 rounded-lg flex items-center justify-center shadow-xl">
                    <svg class="w-16 h-16 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                  </div>
                )}
              </div>

              <!-- Book Info -->
              <div class="flex-1 text-center md:text-left">
                <div class="flex items-center gap-2 justify-center md:justify-start mb-3">
                  <span class="px-3 py-1 text-xs font-semibold rounded-full bg-amber-200 text-amber-800">Book</span>
                  {listing.data.featured && (
                    <span class="px-3 py-1 text-xs font-semibold rounded-full bg-green-200 text-green-800">Featured</span>
                  )}
                </div>
                <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">{listing.data.title}</h1>
                <p class="text-lg text-gray-600 mb-4">by <span class="font-semibold">{listing.data.vendor.name}</span></p>
                <p class="text-gray-600 mb-6 max-w-xl">{listing.data.description}</p>

                <div class="flex flex-col sm:flex-row items-center gap-4">
                  <span class="text-3xl font-bold text-amber-600">{priceDisplay}</span>
                  <a
                    href={listing.data.externalLink || '#'}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center bg-amber-500 text-white px-8 py-3 rounded-full font-semibold hover:bg-amber-600 transition-colors shadow-lg"
                  >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                    Buy Now
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Content -->
          <div class="p-8 md:p-12">
            <div class="prose prose-lg prose-gray max-w-none">
              <Content />
            </div>

            {listing.data.tags && listing.data.tags.length > 0 && (
              <div class="mt-8 pt-6 border-t">
                <div class="flex flex-wrap gap-2">
                  {listing.data.tags.map(tag => (
                    <span class="px-3 py-1 bg-gray-100 text-gray-600 text-sm rounded-full capitalize">{tag.replace(/-/g, ' ')}</span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      ) : (
        <!-- Regular Product Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Main Content -->
          <div class="lg:col-span-2 space-y-6">
            <!-- Image -->
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
              <div class="aspect-video bg-gray-100">
                {listing.data.images?.[0] ? (
                  <img
                    src={listing.data.images[0]}
                    alt={listing.data.title}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-gray-400">
                    <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                )}
              </div>
            </div>

          <!-- Details -->
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
            <div class="flex items-start justify-between mb-4">
              <div>
                <span class={`inline-block px-3 py-1 text-sm font-medium rounded-full ${listing.data.type === 'product' ? 'bg-green-100 text-green-800' : 'bg-purple-100 text-purple-800'}`}>
                  {listing.data.type === 'product' ? 'Product' : 'Service'}
                </span>
                {conditionDisplay && (
                  <span class="inline-block ml-2 px-3 py-1 text-sm font-medium rounded-full bg-gray-100 text-gray-800">
                    {conditionDisplay}
                  </span>
                )}
              </div>
              <span class="text-2xl font-bold text-blue-600">{priceDisplay}</span>
            </div>

            <h1 class="text-2xl font-bold text-gray-900 mb-4">{listing.data.title}</h1>

            <div class="prose prose-gray max-w-none">
              <p class="text-gray-600">{listing.data.description}</p>
              <Content />
            </div>

            {listing.data.tags && listing.data.tags.length > 0 && (
              <div class="mt-6 pt-6 border-t">
                <div class="flex flex-wrap gap-2">
                  {listing.data.tags.map(tag => (
                    <span class="px-3 py-1 bg-gray-100 text-gray-600 text-sm rounded-full">{tag}</span>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Delivery & Payment -->
          {(listing.data.deliveryOptions?.length > 0 || listing.data.paymentMethods?.length > 0) && (
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
              <h2 class="text-lg font-semibold text-gray-900 mb-4">Delivery & Payment</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                {listing.data.deliveryOptions?.length > 0 && (
                  <div>
                    <h3 class="text-sm font-medium text-gray-500 mb-2">Delivery Options</h3>
                    <ul class="space-y-1">
                      {listing.data.deliveryOptions.map(option => (
                        <li class="flex items-center text-gray-700">
                          <svg class="w-4 h-4 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                          </svg>
                          {option}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {listing.data.paymentMethods?.length > 0 && (
                  <div>
                    <h3 class="text-sm font-medium text-gray-500 mb-2">Payment Methods</h3>
                    <ul class="space-y-1">
                      {listing.data.paymentMethods.map(method => (
                        <li class="flex items-center text-gray-700">
                          <svg class="w-4 h-4 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                          </svg>
                          {method}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar - Vendor Info -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 sticky top-24">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Contact Vendor</h2>

            <div class="space-y-4">
              <div>
                <p class="text-sm text-gray-500">Vendor</p>
                <p class="font-medium text-gray-900">{listing.data.vendor.name}</p>
              </div>

              {listing.data.vendor.location && (
                <div>
                  <p class="text-sm text-gray-500">Location</p>
                  <p class="text-gray-900">{listing.data.vendor.location}</p>
                </div>
              )}

              <div class="pt-4 space-y-3">
                {listing.data.vendor.phone && (
                  <a
                    href={`tel:${listing.data.vendor.phone}`}
                    class="flex items-center justify-center w-full bg-blue-600 text-white py-3 px-4 rounded-lg font-medium hover:bg-blue-700 transition-colors"
                  >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                    </svg>
                    Call {listing.data.vendor.phone}
                  </a>
                )}

                {listing.data.vendor.whatsapp && (
                  <a
                    href={`https://wa.me/${listing.data.vendor.whatsapp.replace(/[^0-9]/g, '')}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center w-full bg-green-600 text-white py-3 px-4 rounded-lg font-medium hover:bg-green-700 transition-colors"
                  >
                    <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
                    </svg>
                    WhatsApp
                  </a>
                )}

                {listing.data.vendor.email && (
                  <a
                    href={`mailto:${listing.data.vendor.email}`}
                    class="flex items-center justify-center w-full bg-gray-100 text-gray-700 py-3 px-4 rounded-lg font-medium hover:bg-gray-200 transition-colors"
                  >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    Email
                  </a>
                )}
              </div>
            </div>

            <p class="mt-6 text-xs text-gray-500 text-center">
              Posted on {new Date(listing.data.datePosted).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </p>
          </div>
        </div>
      </div>
      )}
    </div>
  </main>
</MainLayout>
