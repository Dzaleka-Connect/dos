---
import MainLayout from '../../layouts/MainLayout.astro';

const pageTitle = "Listing Submitted | Dzaleka Marketplace";
---

<MainLayout title={pageTitle} canonical="https://services.dzaleka.com/marketplace/success">
  <div class="min-h-screen bg-gray-50 flex items-center justify-center py-12">
    <div class="max-w-md mx-auto px-4 text-center">
      <div class="bg-white rounded border border-gray-200 p-5 sm:p-8">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-gray-900 mb-3">Listing submitted</h1>
        <p class="text-gray-600 mb-6">
          Thank you for submitting your listing to the Dzaleka Marketplace. Our team will review it and get it published soon.
        </p>
        <div class="space-y-3">
          <a
            href="/marketplace"
            class="block w-full bg-blue-600 text-white py-3 px-6 rounded font-medium hover:bg-blue-700 transition-colors"
          >
            Browse Marketplace
          </a>
          <a
            href="/marketplace/submit"
            class="block w-full bg-gray-100 text-gray-700 py-3 px-6 rounded font-medium hover:bg-gray-200 transition-colors"
          >
            Submit Another Listing
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
