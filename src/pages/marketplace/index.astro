---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const pageTitle = 'Marketplace | Dzaleka Online Services';
const description =
  'Browse products and services shared by vendors in and around Dzaleka, including crafts, food, repairs, learning, and local services.';
const image = '/images/Dzaleka_Marketplace.jpeg';

const allListings = await getCollection('marketplace');
const activeListings = allListings
  .filter((listing) => listing.data.status === 'active')
  .sort((a, b) => new Date(b.data.datePosted).getTime() - new Date(a.data.datePosted).getTime());

const products = activeListings.filter((listing) => listing.data.type === 'product');
const services = activeListings.filter((listing) => listing.data.type === 'service');

const categories = [
  { value: 'all', label: 'All categories' },
  { value: 'food-beverages', label: 'Food and beverages' },
  { value: 'clothing-fashion', label: 'Clothing and fashion' },
  { value: 'electronics', label: 'Electronics' },
  { value: 'home-garden', label: 'Home and garden' },
  { value: 'health-beauty', label: 'Health and beauty' },
  { value: 'arts-crafts', label: 'Arts and crafts' },
  { value: 'books-media', label: 'Books and media' },
  { value: 'education-tutoring', label: 'Education and tutoring' },
  { value: 'repair-maintenance', label: 'Repair and maintenance' },
  { value: 'professional-services', label: 'Professional services' },
  { value: 'other', label: 'Other' },
];

const quickStats = [
  { label: 'Active listings', value: activeListings.length },
  { label: 'Products', value: products.length },
  { label: 'Services', value: services.length },
];
---

<MainLayout title={pageTitle} description={description} image={image} canonical="https://services.dzaleka.com/marketplace">
  <div class="bg-gray-50">
    <section class="relative overflow-hidden bg-gray-900 py-16 sm:py-24">
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0 z-0">
        <img
          src={image}
          alt="Dzaleka Marketplace"
          class="h-full w-full object-cover opacity-30"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-gray-900/90 to-gray-900/40"></div>
      </div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl">
          <nav class="mb-8 text-sm font-medium text-gray-400">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <span class="mx-2">/</span>
            <span class="text-white">Marketplace</span>
          </nav>

          <span class="inline-block rounded border border-white/20 bg-white/10 px-4 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-white">
            Community Commerce
          </span>
          <h1 class="mt-6 text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">
            Dzaleka Marketplace
          </h1>
          <p class="mt-6 text-lg leading-relaxed text-gray-300">
            Supporting local entrepreneurs and creators. Browse products, services, and cultural treasures direct from Dzaleka.
          </p>

          <div class="mt-10 flex flex-wrap gap-4">
            <a
              href="/marketplace/submit"
              class="min-h-[44px] inline-flex items-center rounded bg-white px-6 py-3 text-sm font-bold text-gray-900 transition hover:bg-gray-100"
            >
              Add a listing
            </a>
            <a
              href="/marketplace/stores"
              class="min-h-[44px] inline-flex items-center rounded border border-white/30 bg-white/5 px-6 py-3 text-sm font-bold text-white transition hover:bg-white/10 hover:border-white/50"
            >
              View stores
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="sticky top-24 lg:top-44 z-10 border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
          <div class="flex flex-wrap items-center gap-2">
            <button
              data-filter="all"
              class="min-h-[44px] filter-btn rounded bg-primary-700 px-4 py-2 text-sm font-medium text-white"
            >
              All ({activeListings.length})
            </button>
            <button
              data-filter="product"
              class="min-h-[44px] filter-btn rounded bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-200"
            >
              Products ({products.length})
            </button>
            <button
              data-filter="service"
              class="min-h-[44px] filter-btn rounded bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-200"
            >
              Services ({services.length})
            </button>
          </div>

          <div class="w-full lg:w-72">
            <label for="categoryFilter" class="sr-only">Filter by category</label>
            <select
              id="categoryFilter"
              class="w-full rounded border border-gray-300 px-4 py-2 text-sm text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200"
            >
              {categories.map((cat) => (
                <option value={cat.value}>{cat.label}</option>
              ))}
            </select>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        {activeListings.length === 0 ? (
          <div class="rounded border border-gray-200 bg-gray-50 px-6 py-12 text-center">
            <h2 class="text-xl font-semibold text-gray-900">No listings are published yet</h2>
            <p class="mt-2 text-sm text-gray-600">Use the marketplace form to add the first product or service.</p>
            <a
              href="/marketplace/submit"
              class="mt-5 inline-flex rounded bg-primary-700 px-5 py-3 text-sm font-medium text-white hover:bg-primary-800"
            >
              Create a listing
            </a>
          </div>
        ) : (
          <>
            <div id="listingsGrid" class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
              {activeListings.map((listing) => {
                const isBook = listing.data.category === 'books-media';
                const listingTypeLabel = isBook ? 'Book' : listing.data.type === 'service' ? 'Service' : 'Product';
                const priceLabel =
                  listing.data.externalLink
                    ? 'Check seller price'
                    : listing.data.priceType === 'free'
                    ? 'Free'
                    : listing.data.priceType === 'contact'
                      ? 'Contact for price'
                      : listing.data.price
                        ? listing.data.price.includes('USD') || listing.data.price.includes('MWK')
                          ? listing.data.price
                          : `MWK ${listing.data.price}`
                        : 'Contact for price';

                return (
                  <a
                    href={`/marketplace/${listing.id}`}
                    class="listing-card overflow-hidden rounded border border-gray-200 bg-white transition hover:border-primary-200"
                    data-type={listing.data.type}
                    data-category={listing.data.category}
                  >
                    <div class="aspect-[4/3] bg-gray-100">
                      {listing.data.images?.[0] ? (
                        <img
                          src={listing.data.images[0]}
                          alt={listing.data.title}
                          class={`h-full w-full object-center ${isBook ? 'object-contain p-4' : 'object-cover'}`}
                        />
                      ) : (
                        <div class="flex h-full items-center justify-center text-gray-400">
                          <svg class="h-12 w-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                          </svg>
                        </div>
                      )}
                    </div>

                    <div class="p-5">
                      <div class="flex flex-wrap gap-2">
                        <span class="rounded bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">
                          {listingTypeLabel}
                        </span>
                        {listing.data.featured && (
                          <span class="rounded bg-amber-50 px-2.5 py-1 text-xs font-medium text-amber-700">
                            Featured
                          </span>
                        )}
                      </div>

                      <h2 class="mt-3 text-lg font-semibold text-gray-900">{listing.data.title}</h2>
                      <p class="mt-2 text-sm leading-6 text-gray-600 line-clamp-3">{listing.data.description}</p>

                      <div class="mt-4 flex items-center justify-between gap-3">
                        <span class="text-sm font-semibold text-primary-700">{priceLabel}</span>
                        <span class="text-sm font-medium text-gray-500">View details</span>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>

            <div id="pagination" class="mt-8 flex items-center justify-center gap-2">
              <button id="prevPage" class="min-h-[44px] rounded border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50">
                Previous
              </button>
              <span id="pageInfo" class="px-3 py-2 text-sm text-gray-600"></span>
              <button id="nextPage" class="min-h-[44px] rounded border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-50">
                Next
              </button>
            </div>
          </>
        )}
      </div>
    </section>

    <section class="border-t border-gray-200 bg-gray-50">
      <div class="mx-auto grid max-w-7xl gap-6 px-4 py-12 sm:px-6 lg:grid-cols-4 lg:px-8">
        <article class="rounded border border-gray-200 bg-white p-5">
          <h2 class="text-lg font-semibold text-gray-900">How listings work</h2>
          <p class="mt-2 text-sm leading-6 text-gray-600">
            Listings include a description, image, and vendor details. Local listings show a price when provided;
            external listings link to the seller's current price and terms.
          </p>
        </article>
        <article class="rounded border border-gray-200 bg-white p-5">
          <h2 class="text-lg font-semibold text-gray-900">What you can add</h2>
          <p class="mt-2 text-sm leading-6 text-gray-600">
            Products, services, books, crafts, repairs, tutoring, and other legitimate community-based offers.
          </p>
        </article>
        <article class="rounded border border-gray-200 bg-white p-5">
          <h2 class="text-lg font-semibold text-gray-900">Need a full business profile?</h2>
          <p class="mt-2 text-sm leading-6 text-gray-600">
            Restaurants, cafés, shops, and similar businesses can register a dedicated store profile.
          </p>
          <a href="/marketplace/stores/register" class="mt-4 inline-flex text-sm font-medium text-primary-700 hover:text-primary-800">
            Register a store
          </a>
        </article>
        <article class="rounded border border-gray-200 bg-white p-5">
          <h2 class="text-lg font-semibold text-gray-900">Need planning help?</h2>
          <p class="mt-2 text-sm leading-6 text-gray-600">
            Use simple startup templates for marketing, action planning, cash flow forecasting, and risk planning.
          </p>
          <a href="/tools-and-templates" class="mt-4 inline-flex text-sm font-medium text-primary-700 hover:text-primary-800">
            Open business tools
          </a>
        </article>
      </div>
    </section>
  </div>
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const categoryFilter = document.getElementById('categoryFilter');
    const listingCards = Array.from(document.querySelectorAll('.listing-card'));
    const prevBtn = document.getElementById('prevPage');
    const nextBtn = document.getElementById('nextPage');
    const pageInfo = document.getElementById('pageInfo');

    let activeType = 'all';
    let activeCategory = 'all';
    let currentPage = 1;
    const itemsPerPage = 8;

    function getFilteredCards() {
      return listingCards.filter((card) => {
        const cardType = card.dataset.type;
        const cardCategory = card.dataset.category;
        const typeMatch = activeType === 'all' || cardType === activeType;
        const categoryMatch = activeCategory === 'all' || cardCategory === activeCategory;
        return typeMatch && categoryMatch;
      });
    }

    function updatePagination() {
      const filteredCards = getFilteredCards();
      const totalPages = Math.ceil(filteredCards.length / itemsPerPage);

      listingCards.forEach((card) => {
        card.style.display = 'none';
      });

      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;
      filteredCards.slice(startIndex, endIndex).forEach((card) => {
        card.style.display = 'block';
      });

      pageInfo.textContent = `Page ${currentPage} of ${totalPages || 1}`;
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((button) => {
          button.classList.remove('bg-primary-700', 'text-white');
          button.classList.add('bg-gray-100', 'text-gray-700');
        });
        btn.classList.remove('bg-gray-100', 'text-gray-700');
        btn.classList.add('bg-primary-700', 'text-white');

        activeType = btn.dataset.filter;
        currentPage = 1;
        updatePagination();
      });
    });

    categoryFilter?.addEventListener('change', (event) => {
      activeCategory = event.target.value;
      currentPage = 1;
      updatePagination();
    });

    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        updatePagination();
      }
    });

    nextBtn?.addEventListener('click', () => {
      const filteredCards = getFilteredCards();
      const totalPages = Math.ceil(filteredCards.length / itemsPerPage);
      if (currentPage < totalPages) {
        currentPage++;
        updatePagination();
      }
    });

    updatePagination();
  });
</script>
