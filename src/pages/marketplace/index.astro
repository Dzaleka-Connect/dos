---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const pageTitle = "Dzaleka Marketplace | Buy & Sell Products in Dzaleka Refugee Camp";
const description = "Shop handmade crafts, clothing, electronics, and more from vendors in Dzaleka Refugee Camp, Malawi. Support local entrepreneurs and find unique products.";
const keywords = "Dzaleka marketplace, buy products Dzaleka, sell in Dzaleka, refugee camp marketplace, Malawi online shopping, handmade crafts Dzaleka";
const image = "/images/Dzaleka_Marketplace.jpeg";

// Get all active marketplace listings
const allListings = await getCollection('marketplace');
const activeListings = allListings
  .filter(listing => listing.data.status === 'active')
  .sort((a, b) => new Date(b.data.datePosted).getTime() - new Date(a.data.datePosted).getTime());

const featuredListings = activeListings.filter(l => l.data.featured);
const products = activeListings.filter(l => l.data.type === 'product');
const services = activeListings.filter(l => l.data.type === 'service');

const categories = [
  { value: 'all', label: 'All Categories' },
  { value: 'food-beverages', label: 'Food & Beverages' },
  { value: 'clothing-fashion', label: 'Clothing & Fashion' },
  { value: 'electronics', label: 'Electronics' },
  { value: 'home-garden', label: 'Home & Garden' },
  { value: 'health-beauty', label: 'Health & Beauty' },
  { value: 'arts-crafts', label: 'Arts & Crafts' },
  { value: 'books-media', label: 'Books & Media' },
  { value: 'education-tutoring', label: 'Education & Tutoring' },
  { value: 'repair-maintenance', label: 'Repair & Maintenance' },
  { value: 'professional-services', label: 'Professional Services' },
  { value: 'other', label: 'Other' },
];
---

<MainLayout title={pageTitle} description={description} image={image}>
  <main class="min-h-screen bg-gray-50">
    <!-- Hero Section -->
    <section class="relative min-h-[400px] flex items-center justify-center text-white overflow-hidden">
      <div class="absolute inset-0">
        <img
          src="/images/Dzaleka_Marketplace.jpeg"
          alt="Dzaleka Marketplace"
          class="w-full h-full object-cover animate-fade-in"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Dzaleka Marketplace</h1>
        <p class="text-xl text-white/90 max-w-2xl mx-auto mb-8">
          Discover products and services from talented vendors in our community
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/marketplace/submit"
            class="inline-flex items-center bg-white text-blue-600 px-6 py-3 rounded-lg font-medium hover:bg-blue-50 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            List Product/Service
          </a>
          <a
            href="/marketplace/stores"
            class="inline-flex items-center bg-orange-500 text-white px-6 py-3 rounded-lg font-medium hover:bg-orange-600 transition-colors"
          >
            <span class="mr-2">🍽️</span>
            Restaurants & Shops
          </a>
        </div>
      </div>
    </section>

    <!-- Filters -->
    <section class="py-3 sm:py-6 border-b bg-white sticky top-0 z-10 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-between gap-2 sm:gap-4">
          <div class="flex items-center gap-2 sm:gap-4">
            <button
              data-filter="all"
              class="filter-btn px-3 sm:px-4 py-1.5 sm:py-2 text-sm rounded-lg font-medium bg-blue-600 text-white"
            >
              All ({activeListings.length})
            </button>
            <button
              data-filter="product"
              class="filter-btn px-3 sm:px-4 py-1.5 sm:py-2 text-sm rounded-lg font-medium bg-gray-100 text-gray-700 hover:bg-gray-200"
            >
              Products ({products.length})
            </button>
            <button
              data-filter="service"
              class="filter-btn px-3 sm:px-4 py-1.5 sm:py-2 text-sm rounded-lg font-medium bg-gray-100 text-gray-700 hover:bg-gray-200"
            >
              Services ({services.length})
            </button>
          </div>
          <select
            id="categoryFilter"
            class="px-3 sm:px-4 py-1.5 sm:py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
          >
            {categories.map(cat => (
              <option value={cat.value}>{cat.label}</option>
            ))}
          </select>
        </div>
      </div>
    </section>

    <!-- Listings Grid -->
    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {activeListings.length === 0 ? (
          <div class="text-center py-16">
            <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
            </svg>
            <h3 class="text-xl font-medium text-gray-900 mb-2">No listings yet</h3>
            <p class="text-gray-600 mb-6">Be the first to list your product or service!</p>
            <a href="/marketplace/submit" class="inline-flex items-center bg-blue-600 text-white px-6 py-3 rounded-lg font-medium hover:bg-blue-700">
              Create a Listing
            </a>
          </div>
        ) : (
          <div id="listingsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">
            {activeListings.map((listing) => {
              const isBook = listing.data.category === 'books-media';
              return (
                <a
                  href={`/marketplace/${listing.id}`}
                  class="listing-card bg-white rounded-lg sm:rounded-xl shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow"
                  data-type={listing.data.type}
                  data-category={listing.data.category}
                >
                  <div class="h-48 sm:h-48 bg-gray-100 relative overflow-hidden">
                    {listing.data.images?.[0] ? (
                      <img
                        src={listing.data.images[0]}
                        alt={listing.data.title}
                        class={`w-full h-full object-center ${isBook ? 'object-contain p-4' : 'object-cover'}`}
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-gray-400">
                        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                      </div>
                    )}
                    <span class={`absolute top-2 left-2 px-2 py-1 text-xs font-medium rounded ${isBook ? 'bg-amber-100 text-amber-800' : listing.data.type === 'product' ? 'bg-green-100 text-green-800' : 'bg-purple-100 text-purple-800'}`}>
                      {isBook ? 'Book' : listing.data.type === 'product' ? 'Product' : 'Service'}
                    </span>
                    {listing.data.featured && (
                      <span class="absolute top-2 right-2 px-2 py-1 text-xs font-medium rounded bg-yellow-100 text-yellow-800">
                        Featured
                      </span>
                    )}
                  </div>
                  <div class="p-4">
                    <h3 class="font-semibold text-gray-900 mb-1 line-clamp-2">{listing.data.title}</h3>
                    <p class="text-sm text-gray-600 mb-3 line-clamp-2">{listing.data.description}</p>
                    <div class="flex items-center justify-between">
                      <span class={`font-bold ${isBook ? 'text-amber-600' : 'text-blue-600'}`}>
                        {listing.data.priceType === 'free' ? 'Free' :
                         listing.data.priceType === 'contact' ? 'Contact for price' :
                         listing.data.price ? (listing.data.price.includes('USD') || listing.data.price.includes('MWK') ? listing.data.price : `MWK ${listing.data.price}`) : 'Contact for price'}
                      </span>
                      <span class={`px-3 py-1 text-xs font-medium rounded-full ${isBook ? 'bg-amber-500 text-white' : 'bg-blue-500 text-white'}`}>
                        {isBook ? 'Buy' : 'View'}
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        )}

        <!-- Pagination -->
        <div id="pagination" class="flex justify-center items-center gap-2 mt-8">
          <button id="prevPage" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
            Previous
          </button>
          <span id="pageInfo" class="px-4 py-2 text-sm text-gray-600"></span>
          <button id="nextPage" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
            Next
          </button>
        </div>
      </div>
    </section>

    <!-- Why Sell Section -->
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Why Sell on Dzaleka Marketplace?</h2>
          <p class="text-gray-600 max-w-2xl mx-auto">Join hundreds of entrepreneurs in our community and grow your business</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center p-6">
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Reach More Customers</h3>
            <p class="text-gray-600">Connect with buyers across Dzaleka and beyond. Your products visible to thousands of visitors.</p>
          </div>
          <div class="text-center p-6">
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">100% Free to List</h3>
            <p class="text-gray-600">No fees, no commissions. Keep all your earnings and grow your business at your own pace.</p>
          </div>
          <div class="text-center p-6">
            <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Easy to Get Started</h3>
            <p class="text-gray-600">List your product in minutes. Add photos, set your price, and start receiving inquiries.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">How It Works</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
          <div class="relative">
            <div class="bg-white rounded-lg p-6 text-center shadow-sm">
              <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold">1</div>
              <h3 class="font-semibold text-gray-900 mb-2">Create a Listing</h3>
              <p class="text-sm text-gray-600">Fill out the form with your product or service details</p>
            </div>
          </div>
          <div class="relative">
            <div class="bg-white rounded-lg p-6 text-center shadow-sm">
              <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold">2</div>
              <h3 class="font-semibold text-gray-900 mb-2">Add Photos</h3>
              <p class="text-sm text-gray-600">Upload clear images to showcase what you're selling</p>
            </div>
          </div>
          <div class="relative">
            <div class="bg-white rounded-lg p-6 text-center shadow-sm">
              <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold">3</div>
              <h3 class="font-semibold text-gray-900 mb-2">Get Discovered</h3>
              <p class="text-sm text-gray-600">Your listing goes live and buyers can find you</p>
            </div>
          </div>
          <div class="relative">
            <div class="bg-white rounded-lg p-6 text-center shadow-sm">
              <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold">4</div>
              <h3 class="font-semibold text-gray-900 mb-2">Make Sales</h3>
              <p class="text-sm text-gray-600">Connect with customers via WhatsApp or phone</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 bg-blue-600">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Ready to Start Selling?</h2>
        <p class="text-blue-100 mb-8 text-lg">Join our growing community of entrepreneurs and share your products with the world.</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/marketplace/submit" class="inline-flex items-center bg-white text-blue-600 px-8 py-3 rounded-lg font-medium hover:bg-blue-50 transition-colors">
            List Your Product
          </a>
          <a href="/marketplace/stores/register" class="inline-flex items-center bg-orange-500 text-white px-8 py-3 rounded-lg font-medium hover:bg-orange-600 transition-colors">
            Register Your Shop
          </a>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const categoryFilter = document.getElementById('categoryFilter');
    const listingCards = Array.from(document.querySelectorAll('.listing-card'));
    const prevBtn = document.getElementById('prevPage');
    const nextBtn = document.getElementById('nextPage');
    const pageInfo = document.getElementById('pageInfo');

    let activeType = 'all';
    let activeCategory = 'all';
    let currentPage = 1;
    const itemsPerPage = 6;

    function getFilteredCards() {
      return listingCards.filter(card => {
        const cardType = card.dataset.type;
        const cardCategory = card.dataset.category;
        const typeMatch = activeType === 'all' || cardType === activeType;
        const categoryMatch = activeCategory === 'all' || cardCategory === activeCategory;
        return typeMatch && categoryMatch;
      });
    }

    function updatePagination() {
      const filteredCards = getFilteredCards();
      const totalPages = Math.ceil(filteredCards.length / itemsPerPage);

      // Hide all cards first
      listingCards.forEach(card => card.style.display = 'none');

      // Show only cards for current page
      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;
      filteredCards.slice(startIndex, endIndex).forEach(card => {
        card.style.display = 'block';
      });

      // Update page info
      pageInfo.textContent = `Page ${currentPage} of ${totalPages || 1}`;

      // Update button states
      prevBtn.disabled = currentPage <= 1;
      nextBtn.disabled = currentPage >= totalPages;
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('bg-blue-600', 'text-white');
          b.classList.add('bg-gray-100', 'text-gray-700');
        });
        btn.classList.remove('bg-gray-100', 'text-gray-700');
        btn.classList.add('bg-blue-600', 'text-white');

        activeType = btn.dataset.filter;
        currentPage = 1;
        updatePagination();
      });
    });

    categoryFilter?.addEventListener('change', (e) => {
      activeCategory = e.target.value;
      currentPage = 1;
      updatePagination();
    });

    prevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        updatePagination();
      }
    });

    nextBtn?.addEventListener('click', () => {
      const filteredCards = getFilteredCards();
      const totalPages = Math.ceil(filteredCards.length / itemsPerPage);
      if (currentPage < totalPages) {
        currentPage++;
        updatePagination();
      }
    });

    // Initial pagination
    updatePagination();
  });
</script>
