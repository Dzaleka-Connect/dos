---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';

// Static mode for Netlify
export const prerender = true;

const pageTitle = "Search Results | Dzaleka Online Services";
const pageDescription = "Search results for services, events, resources, and community stories in Dzaleka.";
---

<MainLayout title={pageTitle} description={pageDescription}>
  <div class="container mx-auto px-4 py-12 min-h-screen">
    <div class="max-w-4xl mx-auto">
      <PageHeader title="Search" description="Find services, events, resources and community stories." />
      <!-- Search Bar -->
      <div class="mb-8">
        <form id="results-search-form" role="search" aria-label="Search the site" class="relative">
          <label for="results-search-input" class="sr-only">Search the site</label>
          <div class="flex rounded ring-1 ring-slate-400">
            <input
              type="search"
              id="results-search-input"
              class="block min-w-0 flex-1 border-0 bg-white px-4 py-3 text-sm text-slate-900 focus:ring-2 focus:ring-primary-700"
              placeholder="Search for services, resources, events..."
              required
            />
            <button
              type="submit"
              class="min-h-[48px] shrink-0 rounded-r bg-primary-900 px-4 py-3 text-sm font-medium text-white hover:bg-primary-800 sm:px-6"
            >
              Search
            </button>
          </div>
        </form>
      </div>

      <!-- Search Results -->
      <div id="searchResults" class="space-y-8">
        <div class="text-center py-12">
          <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-primary-600 mx-auto"></div>
          <p class="mt-4 text-gray-600">Loading search results...</p>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  let searchIndex = [];
  let isLoading = true;

  const resultsContainer = document.getElementById('searchResults');
  const searchInput = document.getElementById('results-search-input');
  const searchForm = document.getElementById('results-search-form');

  // Get query from URL
  const urlParams = new URLSearchParams(window.location.search);
  const initialQuery = urlParams.get('q') || '';

  if (searchInput) {
    searchInput.value = initialQuery;
  }

  // Fetch search index
  async function loadSearchIndex() {
    try {
      const response = await fetch('/api/search-index.json');
      searchIndex = await response.json();
      isLoading = false;
      performSearch(searchInput.value);
    } catch (error) {
      console.error('Failed to load search index:', error);
      resultsContainer.innerHTML = `
        <div class="text-center py-12">
          <p class="text-red-600">Failed to load search results. Try again later.</p>
        </div>
      `;
    }
  }

  // Perform search
  function performSearch(query) {
    if (isLoading) return;

    if (!query.trim()) {
      resultsContainer.innerHTML = `
        <div class="text-center py-12 bg-white rounded border border-gray-100">
          <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <h2 class="text-2xl font-semibold text-gray-900 mb-4">Enter a search term</h2>
          <p class="text-gray-600">Search for services, events, resources, and more.</p>
        </div>
      `;
      return;
    }

    const normalizedQuery = query.toLowerCase();

    // Simple fuzzy search
    const results = searchIndex.filter(item => {
      const titleMatch = item.title?.toLowerCase().includes(normalizedQuery);
      const descMatch = item.description?.toLowerCase().includes(normalizedQuery);
      const tagMatch = item.tags?.some(tag => tag.toLowerCase().includes(normalizedQuery));
      const typeMatch = item.type?.toLowerCase().includes(normalizedQuery);

      return titleMatch || descMatch || tagMatch || typeMatch;
    });

    renderResults(results, query);
  }

  // Render results
  function renderResults(results, query) {
    if (results.length === 0) {
      resultsContainer.innerHTML = `
        <div class="text-center py-12 bg-white rounded border border-gray-100">
          <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h2 class="text-2xl font-semibold text-gray-900 mb-4">No results found</h2>
          <p class="text-gray-600">We couldn't find anything matching "${query}". Try different keywords.</p>
        </div>
      `;
      return;
    }

    // Group results by type
    const groupedResults = results.reduce((acc, item) => {
      if (!acc[item.type]) acc[item.type] = [];
      acc[item.type].push(item);
      return acc;
    }, {});

    resultsContainer.innerHTML = `
      <div class="space-y-8">
        <div class="flex items-center justify-between">
          <h2 class="text-2xl font-semibold text-gray-900">
            Found ${results.length} result${results.length === 1 ? '' : 's'} for "${query}"
          </h2>
        </div>

        ${Object.entries(groupedResults).map(([type, items]) => `
          <div class="border-t border-slate-200 bg-white pt-6">
            <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center capitalize">
              <span class="w-1.5 h-6 bg-primary-500 rounded-full mr-3"></span>
              ${type.endsWith('s') ? type : type + 's'} <span class="ml-2 text-sm font-normal text-gray-500">(${items.length})</span>
            </h3>
            <div class="space-y-4">
              ${items.map(item => `
                <a href="${item.url}" class="group block rounded py-4 hover:bg-slate-50">
                  <div class="flex items-start gap-4">
                    ${item.image ? `
                      <div class="w-16 h-16 bg-gray-100 rounded overflow-hidden flex-shrink-0">
                        <img
                          src="${item.image}"
                          alt="${item.title}"
                          class="w-full h-full object-cover"
                          onerror="this.style.display='none'"
                        />
                      </div>
                    ` : ''}
                    <div class="min-w-0 flex-grow">
                      <div class="flex justify-between items-start">
                        <div>
                          <h4 class="font-semibold text-primary-800 underline underline-offset-4 mb-1 group-hover:text-primary-900">${item.title}</h4>
                          <p class="text-sm text-gray-600 line-clamp-2">${item.description || 'No description available.'}</p>
                          <div class="flex flex-wrap gap-2 mt-2">
                            ${item.category ? `<span class="text-xs px-2 py-1 bg-blue-50 text-blue-700 rounded-md">${item.category}</span>` : ''}
                            ${item.tags?.slice(0, 3).map(tag => `<span class="text-xs px-2 py-1 bg-gray-100 text-gray-600 rounded-md">#${tag}</span>`).join('')}
                          </div>
                        </div>
                        <svg class="w-5 h-5 text-gray-400 flex-shrink-0 mt-1 group-hover:text-primary-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </div>
                    </div>
                  </div>
                </a>
              `).join('')}
            </div>
          </div>
        `).join('')}
      </div>
    `;
  }

  // Initialize
  loadSearchIndex();

  // Handle form submission
  searchForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const newQuery = searchInput.value;
    // Update URL without reloading
    const newUrl = new URL(window.location.href);
    newUrl.searchParams.set('q', newQuery);
    window.history.pushState({}, '', newUrl);

    performSearch(newQuery);
  });
</script>
