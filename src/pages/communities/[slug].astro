---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { communitiesHeroImage, communityGroups } from '../../data/communities';
import type { CommunityGroup } from '../../data/communities';

export function getStaticPaths() {
  return communityGroups.map((community) => ({
    params: { slug: community.slug },
    props: { community },
  }));
}

interface Props {
  community: CommunityGroup;
}

const { community } = Astro.props;
const canonicalUrl = `https://services.dzaleka.com/communities/${community.slug}`;
const pageTitle = `${community.title} Community | Dzaleka Online Services`;
const pageDescription = `${community.tagline} Join the ${community.title} Community of Practice through Dzaleka Online Services.`;
const communityPageStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Dzaleka Online Services',
        url: 'https://services.dzaleka.com',
      },
      breadcrumb: {
        '@id': `${canonicalUrl}#breadcrumb`,
      },
      about: {
        '@type': 'Thing',
        name: `${community.title} Community of Practice`,
        description: community.description,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://services.dzaleka.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Communities',
          item: 'https://services.dzaleka.com/communities',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: community.title,
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  schema={communityPageStructuredData}
  openGraph={{
    title: pageTitle,
    description: pageDescription,
    type: 'website',
    image: {
      url: communitiesHeroImage.seoUrl,
      width: communitiesHeroImage.width,
      height: communitiesHeroImage.height,
      alt: communitiesHeroImage.alt,
      type: communitiesHeroImage.type,
    },
    site_name: 'Dzaleka Online Services',
    locale: 'en_US',
    url: canonicalUrl,
  }}
  twitter={{
    card: 'summary_large_image',
    title: pageTitle,
    description: pageDescription,
    image: communitiesHeroImage.seoUrl,
  }}
>
  <section class="relative overflow-hidden bg-slate-950 text-white">
    <div class="absolute inset-0">
      <img
        src={communitiesHeroImage.src}
        alt={communitiesHeroImage.alt}
        class="h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-slate-950/70"></div>
    </div>

    <div class="relative mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
      <Breadcrumb
        light
        items={[
          { label: 'Home', href: '/' },
          { label: 'Communities', href: '/communities' },
          { label: community.title },
        ]}
      />

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-end">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-sky-200">{community.category} Community</p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl">{community.title}</h1>
          <p class="mt-4 text-xl font-semibold leading-8 text-white">{community.tagline}</p>
          <p class="mt-4 max-w-2xl text-base leading-8 text-slate-100">{community.description}</p>
        </div>

        <aside class="rounded-lg border border-white/20 bg-white/10 p-6 backdrop-blur">
          <h2 class="text-lg font-semibold text-white">Join this Community</h2>
          <p class="mt-3 text-sm leading-6 text-slate-100">
            Open WhatsApp to join the group. The invite opens in a new tab.
          </p>
          <a
            href={community.joinUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-community-join
            data-community-slug={community.slug}
            data-community-name={community.title}
            class="mt-5 inline-flex w-full items-center justify-center rounded-lg bg-emerald-600 px-4 py-3 text-sm font-semibold text-white hover:bg-emerald-700"
          >
            Open WhatsApp invite
          </a>
          <p class="mt-4 text-xs leading-5 text-slate-200">
            By joining, you agree to the Community Charter and Sharing Policy.
          </p>
          <p class="mt-3 text-xs leading-5 text-slate-200">
            Privacy note: your phone number may be visible to Admins and members of this WhatsApp group.
          </p>
          <p class="mt-3 text-xs leading-5 text-slate-200">
            If you exit the full Community, WhatsApp will also remove you from its related groups.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:px-6 lg:grid-cols-[minmax(0,1fr)_340px] lg:px-8">
      <div class="space-y-8">
        <article class="rounded-lg border border-slate-200 bg-white p-6">
          <h2 class="text-2xl font-semibold text-slate-900">Who this is for</h2>
          <p class="mt-3 text-base leading-8 text-slate-600">{community.audience}</p>
        </article>

        <article class="rounded-lg border border-slate-200 bg-white p-6">
          <h2 class="text-2xl font-semibold text-slate-900">Common topics</h2>
          <div class="mt-5 flex flex-wrap gap-2">
            {community.topics.map((topic) => (
              <span class="rounded-full bg-primary-50 px-3 py-1 text-sm font-medium text-primary-800">{topic}</span>
            ))}
          </div>
        </article>

        <article class="rounded-lg border border-slate-200 bg-white p-6">
          <h2 class="text-2xl font-semibold text-slate-900">How members get involved</h2>
          <ul class="mt-5 grid gap-3 sm:grid-cols-2">
            {community.activities.map((activity) => (
              <li class="flex gap-3 text-sm leading-6 text-slate-600">
                <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-primary-600"></span>
                <span>{activity}</span>
              </li>
            ))}
          </ul>
        </article>

        <article class="rounded-lg border border-slate-200 bg-white p-6">
          <h2 class="text-2xl font-semibold text-slate-900">Community Chair role</h2>
          <p class="mt-3 text-base leading-8 text-slate-600">{community.chairRole}</p>
        </article>
      </div>

      <aside class="space-y-6">
        <div class="rounded-lg border border-slate-200 bg-white p-6">
          <h2 class="text-lg font-semibold text-slate-900">Related pages</h2>
          <ul class="mt-4 space-y-3">
            {community.relatedLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm font-medium text-primary-700 hover:text-primary-800 hover:underline">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-lg border border-primary-200 bg-primary-50 p-6">
          <h2 class="text-lg font-semibold text-primary-950">Community Trust</h2>
          <p class="mt-3 text-sm leading-7 text-primary-950">
            Members can use ideas and solutions they receive, but should not reveal who shared sensitive information without permission. Contact Admins or use WhatsApp report tools for spam or unsafe behaviour.
          </p>
          <a href="/communities#community-charter" class="mt-4 inline-flex text-sm font-semibold text-primary-800 hover:text-primary-900">
            Read the charter
          </a>
        </div>

        <div class="rounded-lg border border-slate-200 bg-white p-6">
          <h2 class="text-lg font-semibold text-slate-900">Need another group?</h2>
          <p class="mt-3 text-sm leading-7 text-slate-600">
            Return to the Communities page to browse other sectors. You may join more than one Community if it fits your work or goals.
          </p>
          <a href="/communities#find-your-community" class="mt-4 inline-flex text-sm font-semibold text-primary-700 hover:text-primary-800">
            Browse Communities
          </a>
        </div>
      </aside>
    </div>
  </section>
</MainLayout>

<script>
  document.querySelectorAll('[data-community-join]').forEach((link) => {
    link.addEventListener('click', () => {
      const analytics = window as typeof window & {
        gtag?: (eventType: string, eventName: string, parameters: Record<string, string | null>) => void;
      };

      analytics.gtag?.('event', 'community_join_click', {
        community_slug: link.getAttribute('data-community-slug'),
        community_name: link.getAttribute('data-community-name'),
        link_url: link.getAttribute('href'),
      });
    });
  });
</script>
