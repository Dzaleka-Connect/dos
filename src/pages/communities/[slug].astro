---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { communitiesHeroImage, communityGroups } from '../../data/communities';
import type { CommunityGroup } from '../../data/communities';

export function getStaticPaths() {
  return communityGroups.map((community) => ({
    params: { slug: community.slug },
    props: { community },
  }));
}

interface Props {
  community: CommunityGroup;
}

const { community } = Astro.props;
const canonicalUrl = `https://services.dzaleka.com/communities/${community.slug}`;
const pageTitle = `${community.title} Community | Dzaleka Online Services`;
const pageDescription = `${community.tagline} Join the ${community.title} Community of Practice through Dzaleka Online Services.`;
const communityPageStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Dzaleka Online Services',
        url: 'https://services.dzaleka.com',
      },
      breadcrumb: {
        '@id': `${canonicalUrl}#breadcrumb`,
      },
      about: {
        '@type': 'Thing',
        name: `${community.title} Community of Practice`,
        description: community.description,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://services.dzaleka.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Communities',
          item: 'https://services.dzaleka.com/communities',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: community.title,
          item: canonicalUrl,
        },
      ],
    },
  ],
};
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  schema={communityPageStructuredData}
  openGraph={{
    title: pageTitle,
    description: pageDescription,
    type: 'website',
    image: {
      url: communitiesHeroImage.seoUrl,
      width: communitiesHeroImage.width,
      height: communitiesHeroImage.height,
      alt: communitiesHeroImage.alt,
      type: communitiesHeroImage.type,
    },
    site_name: 'Dzaleka Online Services',
    locale: 'en_US',
    url: canonicalUrl,
  }}
  twitter={{
    card: 'summary_large_image',
    title: pageTitle,
    description: pageDescription,
    image: communitiesHeroImage.seoUrl,
  }}
>
  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Communities', href: '/communities' }, { label: community.title }]} />
      <p class="mt-5 text-sm text-slate-600">{community.category}</p>
      <h1 class="mt-2 text-primary-900">{community.title}</h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-slate-700">{community.description}</p>
    </div>
  </header>
  <div class="mx-auto grid max-w-6xl items-start gap-8 px-4 py-8 sm:px-6 sm:py-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-12 lg:px-8">
    <div class="order-2 space-y-8 lg:order-1">
      <section><h2 class="text-primary-900">Who this group is for</h2><p class="mt-3 text-base leading-7 text-slate-700">{community.audience}</p></section>
      <section class="border-t border-slate-200 pt-6"><h2 class="text-primary-900">Common topics</h2><ul class="mt-4 list-disc space-y-2 pl-5 text-base text-slate-700">{community.topics.map((topic) => <li>{topic}</li>)}</ul></section>
      <section class="border-t border-slate-200 pt-6"><h2 class="text-primary-900">How to take part</h2><ul class="mt-4 list-disc space-y-2 pl-5 text-base text-slate-700">{community.activities.map((activity) => <li>{activity}</li>)}</ul></section>
      <section class="border-t border-slate-200 pt-6"><h2 class="text-primary-900">Community Chairs</h2><p class="mt-3 text-base leading-7 text-slate-700">{community.chairRole}</p><p class="mt-3 text-sm leading-6 text-slate-600">Contact an admin for moderation help. Ask permission before sharing another member’s personal information or work.</p></section>
      <section class="border-t border-slate-200 pt-6"><h2 class="text-primary-900">Related pages</h2><ul class="mt-3">{community.relatedLinks.map((link) => <li><a href={link.href} class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">{link.label}</a></li>)}</ul></section>
    </div>
    <aside class="order-1 rounded border border-slate-200 bg-slate-50 p-5 sm:p-6 lg:order-2" aria-labelledby="join-heading">
      <h2 id="join-heading" class="text-primary-900">Join this group</h2>
      <p class="mt-3 text-sm leading-6 text-slate-700">Your phone number may be visible to admins and members of this WhatsApp group.</p>
      <a href={community.joinUrl} target="_blank" rel="noopener noreferrer" data-community-join data-community-slug={community.slug} data-community-name={community.title} class="mt-5 inline-flex min-h-[44px] w-full items-center justify-center rounded bg-primary-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-800">Open WhatsApp invite <span class="ml-2" aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
      <p class="mt-4 text-sm leading-6 text-slate-600">By joining, you agree to the <a href="/communities#community-charter" class="text-primary-800 underline underline-offset-4">community charter and sharing policy</a>.</p>
      <a href="/communities#find-your-community" class="mt-5 inline-flex min-h-[44px] items-center border-t border-slate-200 pt-3 text-sm text-primary-800 underline underline-offset-4">Browse other groups</a>
    </aside>
  </div>
</MainLayout>

<script>
  document.querySelectorAll('[data-community-join]').forEach((link) => {
    link.addEventListener('click', () => {
      const analytics = window as typeof window & {
        gtag?: (eventType: string, eventName: string, parameters: Record<string, string | null>) => void;
      };

      analytics.gtag?.('event', 'community_join_click', {
        community_slug: link.getAttribute('data-community-slug'),
        community_name: link.getAttribute('data-community-name'),
        link_url: link.getAttribute('href'),
      });
    });
  });
</script>
