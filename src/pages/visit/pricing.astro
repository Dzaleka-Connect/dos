---
import MainLayout from '../../layouts/MainLayout.astro';

const pageTitle = "Visit Pricing | Dzaleka Refugee Camp";
const description = "Plan your visit to Dzaleka Refugee Camp. Get instant pricing for guided tours based on group size. Flexible payment options including mobile money and cash. Book your cultural experience today.";

const seo = {
  title: pageTitle,
  description,
  openGraph: {
    title: pageTitle,
    description,
    type: 'website',
    url: 'https://services.dzaleka.com/visit/pricing',
    image: 'https://services.dzaleka.com/images/Visit_Dzaleka.png',
    site_name: 'Dzaleka Online Services',
    locale: 'en_US'
  },
  twitter: {
    card: 'summary_large_image',
    title: pageTitle,
    description,
    image: 'https://services.dzaleka.com/images/Visit_Dzaleka.png'
  },
  additionalMetaTags: [
    {
      name: 'keywords',
      content: 'Dzaleka Refugee Camp, guided tours, cultural visits, group tours, Malawi tourism, refugee camp visits, educational tours'
    },
    {
      name: 'author',
      content: 'Dzaleka Online Services'
    }
  ]
};

// Pricing data for structured data
const pricingData = [
  { groupSize: '1 person', price: '15000', currency: 'MWK' },
  { groupSize: '2-5 people', price: '50000', currency: 'MWK' },
  { groupSize: '6-10 people', price: '80000', currency: 'MWK' },
  { groupSize: '10+ people', price: '100000', currency: 'MWK' }
];

// Structured data for the page
const structuredData = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": "Dzaleka Refugee Camp Tours",
  "description": description,
  "url": "https://services.dzaleka.com/visit/pricing",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Dowa",
    "addressRegion": "Central Region",
    "addressCountry": "Malawi"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -13.662767,
    "longitude": 33.870807
  },
  "offers": pricingData.map(pricing => ({
    "@type": "Offer",
    "name": `Group Tour (${pricing.groupSize})`,
    "price": pricing.price,
    "priceCurrency": pricing.currency,
    "availability": "https://schema.org/InStock",
    "validFrom": new Date().toISOString().split('T')[0],
    "priceValidUntil": new Date(new Date().setFullYear(new Date().getFullYear() + 1)).toISOString().split('T')[0]
  })),
  "tourBookingPage": "https://services.dzaleka.com/visit/guidelines",
  "paymentAccepted": ["Cash", "Airtel Money", "TNM Mpamba"],
  "openingHours": "Mo-Fr 09:00-17:00",
  "isAccessibleForFree": false,
  "additionalProperty": [
    {
      "@type": "PropertyValue",
      "name": "Tour Duration",
      "value": "2 hours (standard)"
    },
    {
      "@type": "PropertyValue",
      "name": "Additional Hours",
      "value": "MWK 10,000 per hour"
    },
    {
      "@type": "PropertyValue",
      "name": "Transportation",
      "value": "Walking tour only"
    }
  ]
};

// FAQ structured data
const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How much does it cost to visit Dzaleka Refugee Camp?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Prices vary by group size: MWK 15,000 for 1 person, MWK 50,000 for 2-5 people, MWK 80,000 for 6-10 people, and MWK 100,000 for groups of 10 or more."
      }
    },
    {
      "@type": "Question",
      "name": "What payment methods are accepted?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We accept Airtel Money, TNM Mpamba, and cash payments upon arrival at the camp."
      }
    },
    {
      "@type": "Question",
      "name": "How long are the tours?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard tours are 2 hours long. Additional hours can be added for MWK 10,000 per hour."
      }
    },
    {
      "@type": "Question",
      "name": "Is transportation provided during the tour?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No, tours are conducted entirely on foot. Visitors should be prepared for walking throughout the camp."
      }
    }
  ]
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  openGraph={seo.openGraph}
  twitter={seo.twitter}
  additionalMetaTags={seo.additionalMetaTags}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData, null, 2)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData, null, 2)} />

  <main class="min-h-screen bg-gray-50">
    {/* Back Button & Login */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
      <a href="/visit" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-primary-600">
        <svg class="mr-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to Visit
      </a>
      <a href="https://visit.dzaleka.com/login" target="_blank" rel="noopener noreferrer" class="inline-flex items-center px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white text-sm font-medium rounded-lg transition-colors">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
        </svg>
        Login / Sign Up
      </a>
    </div>

    {/* Hero Section */}
    <div class="relative bg-primary-600 text-white py-12 sm:py-16">
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-r from-primary-900/90 to-primary-800/90"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 sm:mb-6">Visit Pricing</h1>
          <p class="text-lg sm:text-xl text-white/90 max-w-2xl mx-auto">
            Plan your visit and get an instant quote for your group
          </p>
        </div>
      </div>
    </div>

    {/* Pricing Calculator Section */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      {/* Pricing Comparison Table */}
      <div class="mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 text-center mb-3">Choose Your Tour Package</h2>
        <p class="text-gray-600 text-center mb-8">All packages include guided tour and community support</p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 lg:gap-8 max-w-6xl mx-auto">
          {/* Solo Package */}
          <div class="bg-white rounded-xl shadow-sm border-2 border-gray-200 p-6 hover:border-primary-500 transition-all duration-300">
            <div class="text-center">
              <h3 class="text-lg font-semibold text-gray-900 mb-2">Solo Explorer</h3>
              <div class="mb-4">
                <span class="text-4xl font-bold text-gray-900">15K</span>
                <span class="text-gray-600 text-sm ml-1">MWK</span>
              </div>
              <p class="text-sm text-gray-500 mb-4">1 person</p>
            </div>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>2-hour guided tour</span>
              </li>
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Personal guide</span>
              </li>
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Flexible schedule</span>
              </li>
            </ul>
            <button onclick="selectPackage(1, 15000)" class="w-full bg-gray-100 hover:bg-slate-900 hover:text-white text-gray-900 py-2 rounded-lg transition-colors font-medium">
              Select
            </button>
          </div>

          {/* Small Group Package - POPULAR */}
          <div class="bg-white rounded-xl shadow-sm border-2 border-primary-500 p-6 relative transition-all duration-300 transform">
            <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
              <span class="bg-slate-900 text-white px-4 py-1 rounded-full text-xs font-semibold">MOST POPULAR</span>
            </div>
            <div class="text-center">
              <h3 class="text-lg font-semibold text-gray-900 mb-2">Small Group</h3>
              <div class="mb-4">
                <span class="text-4xl font-bold text-primary-600">50K</span>
                <span class="text-gray-600 text-sm ml-1">MWK</span>
              </div>
              <p class="text-sm text-gray-500 mb-4">2-5 people</p>
            </div>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>2-hour guided tour</span>
              </li>
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Experienced guide</span>
              </li>
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Best value per person</span>
              </li>
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Group interaction</span>
              </li>
            </ul>
            <button onclick="selectPackage(2, 50000)" class="w-full bg-slate-900 hover:bg-slate-800 text-white py-2 rounded-lg transition-colors font-medium">
              Select
            </button>
          </div>

          {/* Medium Group Package */}
          <div class="bg-white rounded-xl shadow-sm border-2 border-gray-200 p-6 hover:border-primary-500 transition-all duration-300">
            <div class="text-center">
              <h3 class="text-lg font-semibold text-gray-900 mb-2">Medium Group</h3>
              <div class="mb-4">
                <span class="text-4xl font-bold text-gray-900">80K</span>
                <span class="text-gray-600 text-sm ml-1">MWK</span>
              </div>
              <p class="text-sm text-gray-500 mb-4">6-10 people</p>
            </div>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>2-hour guided tour</span>
              </li>
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Senior guide</span>
              </li>
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Great for families</span>
              </li>
            </ul>
            <button onclick="selectPackage(6, 80000)" class="w-full bg-gray-100 hover:bg-slate-900 hover:text-white text-gray-900 py-2 rounded-lg transition-colors font-medium">
              Select
            </button>
          </div>

          {/* Large Group Package */}
          <div class="bg-white rounded-xl shadow-sm border-2 border-gray-200 p-6 hover:border-primary-500 transition-all duration-300">
            <div class="text-center">
              <h3 class="text-lg font-semibold text-gray-900 mb-2">Large Group</h3>
              <div class="mb-4">
                <span class="text-4xl font-bold text-gray-900">100K</span>
                <span class="text-gray-600 text-sm ml-1">MWK</span>
              </div>
              <p class="text-sm text-gray-500 mb-4">10+ people</p>
            </div>
            <ul class="space-y-3 mb-6">
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>2-hour guided tour</span>
              </li>
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Multiple guides</span>
              </li>
              <li class="flex items-start gap-2 text-sm">
                <svg class="w-5 h-5 text-green-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Perfect for schools</span>
              </li>
            </ul>
            <button onclick="selectPackage(11, 100000)" class="w-full bg-gray-100 hover:bg-slate-900 hover:text-white text-gray-900 py-2 rounded-lg transition-colors font-medium">
              Select
            </button>
          </div>
        </div>
      </div>

      {/* Pricing Calculator Section */}
      <div id="pricing-calculator" class="bg-white rounded-xl shadow-sm overflow-hidden">
        {/* Progress Indicator */}
        <div class="bg-slate-900 px-8 py-6">
          <div class="flex items-center justify-between max-w-3xl mx-auto">
            <div class="flex items-center step-indicator active" data-step="1">
              <div class="w-10 h-10 rounded-full bg-white text-primary-600 flex items-center justify-center font-bold step-circle">1</div>
              <span class="ml-3 text-white font-medium hidden sm:inline step-label">Select Package</span>
            </div>
            <div class="flex-1 h-1 bg-primary-400 mx-4"></div>
            <div class="flex items-center step-indicator" data-step="2">
              <div class="w-10 h-10 rounded-full bg-primary-400 text-white flex items-center justify-center font-bold step-circle">2</div>
              <span class="ml-3 text-primary-200 font-medium hidden sm:inline step-label">Customize</span>
            </div>
            <div class="flex-1 h-1 bg-primary-400 mx-4"></div>
            <div class="flex items-center step-indicator" data-step="3">
              <div class="w-10 h-10 rounded-full bg-primary-400 text-white flex items-center justify-center font-bold step-circle">3</div>
              <span class="ml-3 text-primary-200 font-medium hidden sm:inline step-label">Confirm</span>
            </div>
          </div>
        </div>

        <div class="p-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Customize Your Tour</h2>
          
          {/* Pricing Notice */}
          <div class="mb-8 bg-amber-50 border-l-4 border-amber-400 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm text-amber-700">
                  <strong>Payment on Arrival:</strong> No online payment required. You'll pay when you arrive at the camp via Airtel Money, TNM Mpamba, or Cash.
                </p>
              </div>
            </div>
          </div>

          <div class="grid lg:grid-cols-3 gap-8">
            {/* Main Booking Form */}
            <div class="lg:col-span-2 space-y-8">
              {/* Step 1: Select Package */}
              <div class="booking-step" data-step="1">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Step 1: Select Your Package</h3>
                
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Group Size</label>
                  <select id="groupSize" class="mt-1 block w-full pl-3 pr-10 py-3 text-base border-gray-300 focus:outline-none focus:ring-primary-500 focus:border-primary-500 rounded-lg">
                    <option value="1">1 person (MWK 15,000)</option>
                    <option value="2">2-5 people (MWK 50,000)</option>
                    <option value="6">6-10 people (MWK 80,000)</option>
                    <option value="11">10+ people (MWK 100,000)</option>
                  </select>
                </div>

                <button onclick="nextStep(2)" class="mt-6 w-full bg-slate-900 hover:bg-slate-800 text-white py-3 px-6 rounded-lg font-medium transition-colors">
                  Continue to Customize
                </button>
              </div>

              {/* Step 2: Customize */}
              <div class="booking-step hidden" data-step="2">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Step 2: Customize Your Experience</h3>
                
                {/* Date Selection */}
                <div class="mb-6">
                  <label class="block text-sm font-medium text-gray-700 mb-2">Preferred Visit Date</label>
                  <input 
                    type="date" 
                    id="visitDate" 
                    class="mt-1 block w-full px-4 py-3 border-gray-300 focus:ring-primary-500 focus:border-primary-500 rounded-lg"
                  />
                  <p class="mt-1 text-xs text-gray-500">Bookings must be made at least 48 hours in advance</p>
                </div>

                {/* Time Selection */}
                <div class="mb-6">
                  <label class="block text-sm font-medium text-gray-700 mb-2">Preferred Start Time</label>
                  <div class="grid grid-cols-2 gap-4">
                    <label class="flex items-center p-4 border-2 border-gray-200 rounded-lg hover:border-primary-500 cursor-pointer transition-colors">
                      <input type="radio" name="visitTime" value="10:00" class="w-5 h-5 text-primary-600 focus:ring-primary-500" checked />
                      <span class="ml-3 text-gray-900 font-medium">10:00 AM</span>
                    </label>
                    <label class="flex items-center p-4 border-2 border-gray-200 rounded-lg hover:border-primary-500 cursor-pointer transition-colors">
                      <input type="radio" name="visitTime" value="14:00" class="w-5 h-5 text-primary-600 focus:ring-primary-500" />
                      <span class="ml-3 text-gray-900 font-medium">2:00 PM</span>
                    </label>
                  </div>
                </div>

                {/* Duration Selection */}
                <div class="mb-6">
                  <label class="block text-sm font-medium text-gray-700 mb-2">Additional Hours</label>
                  <div class="flex items-center gap-4">
                    <button id="decreaseHours" class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center hover:bg-gray-200 focus:outline-none">
                      <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M20 12H4"/>
                      </svg>
                    </button>
                    <span id="additionalHours" class="text-2xl font-bold text-gray-900 w-12 text-center">0</span>
                    <button id="increaseHours" class="w-12 h-12 rounded-full bg-gray-100 flex items-center justify-center hover:bg-gray-200 focus:outline-none">
                      <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M12 6v12m6-6H6"/>
                      </svg>
                    </button>
                    <span class="text-sm text-gray-500">(MWK 10,000 per hour)</span>
                  </div>
                </div>

                {/* Refer a Friend Discount */}
                <div class="mb-6 bg-green-50 border border-green-200 rounded-lg p-4">
                  <div class="flex items-start">
                    <svg class="w-5 h-5 text-green-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" strokeWidth="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
                    </svg>
                    <div class="ml-3 flex-1">
                      <h4 class="text-sm font-medium text-green-900">Refer a Friend - Get 10% Off!</h4>
                      <p class="text-xs text-green-700 mt-1">If someone you referred has visited in the past 3 months, enter their booking reference for a discount.</p>
                      <div class="mt-3">
                        <input 
                          type="text" 
                          id="referralCode" 
                          placeholder="Enter referral code (optional)"
                          class="w-full px-3 py-2 border-green-300 focus:ring-green-500 focus:border-green-500 rounded-md text-sm"
                        />
                        <p id="referralMessage" class="mt-1 text-xs text-green-600 hidden">✓ 10% discount applied!</p>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="flex gap-4">
                  <button onclick="previousStep(1)" class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-900 py-3 px-6 rounded-lg font-medium transition-colors">
                    Back
                  </button>
                  <button onclick="nextStep(3)" class="flex-1 bg-slate-900 hover:bg-slate-800 text-white py-3 px-6 rounded-lg font-medium transition-colors">
                    Continue to Confirm
                  </button>
                </div>
              </div>

              {/* Step 3: Confirm */}
              <div class="booking-step hidden" data-step="3">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Step 3: Confirm Your Booking</h3>
                
                <div class="bg-gray-50 rounded-lg p-6 mb-6">
