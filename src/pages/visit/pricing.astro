  <script>
    // Price configuration
    const prices = {
      1: 15000,  // 1 person
      2: 50000,  // 2-5 people
      6: 80000,  // 6-10 people
      11: 100000 // 10+ people
    };
    const additionalHourRate = 10000;

    // Get DOM elements
    const groupSizeSelect = document.getElementById('groupSize');
    const decreaseHoursBtn = document.getElementById('decreaseHours');
    const increaseHoursBtn = document.getElementById('increaseHours');
    const additionalHoursDisplay = document.getElementById('additionalHours');
    const basePriceDisplay = document.getElementById('basePrice');
    const additionalCostDisplay = document.getElementById('additionalCost');
    const totalCostDisplay = document.getElementById('totalCost');


    // Set minimum date for visit date picker (48 hours in advance)
    const visitDateInput = document.getElementById('visitDate');
    if (visitDateInput) {
      const minDate = new Date();
      minDate.setDate(minDate.getDate() + 2);
      visitDateInput.min = minDate.toISOString().split('T')[0];
    }

    // Multi-step wizard state
    let currentStep = 1;
    let hasReferralDiscount = false;
    
    // Currency exchange rates (Wise mid-market rates - updated Jan 2025)
    const exchangeRates = {
      USD: 0.0006,  // 1 MWK = 0.0006 USD
      EUR: 0.0005   // 1 MWK = 0.0005 EUR
    };

    // Step navigation functions
    window.nextStep = function(step) {
      document.querySelectorAll('.booking-step').forEach(el => el.classList.add('hidden'));
      const stepElement = document.querySelector(`.booking-step[data-step="${step}"]`);
      if (stepElement) stepElement.classList.remove('hidden');
      updateProgressIndicator(step);
      if (step === 3) populateConfirmation();
      currentStep = step;
      // Removed auto-scroll to allow users to stay in place while customizing
    };

    window.previousStep = function(step) {
      nextStep(step);
    };

    function updateProgressIndicator(step) {
      document.querySelectorAll('.step-indicator').forEach((indicator, index) => {
        const stepNum = index + 1;
        const circle = indicator.querySelector('.step-circle');
        const label = indicator.querySelector('.step-label');
        
        if (stepNum < step) {
          circle.classList.remove('bg-primary-400', 'bg-white');
          circle.classList.add('bg-green-500', 'text-white');
          label.classList.add('text-white');
        } else if (stepNum === step) {
          circle.classList.remove('bg-primary-400', 'bg-green-500');
          circle.classList.add('bg-white', 'text-primary-600');
          label.classList.add('text-white');
        } else {
          circle.classList.remove('bg-white', 'bg-green-500');
          circle.classList.add('bg-primary-400', 'text-white');
          label.classList.add('text-primary-200');
        }
      });
    }

    function populateConfirmation() {
      const groupSizeText = groupSizeSelect.options[groupSizeSelect.selectedIndex].text.split('(')[0].trim();
      document.getElementById('confirmGroupSize').textContent = groupSizeText;
      
      const visitDate = document.getElementById('visitDate');
      if (visitDate.value) {
        const date = new Date(visitDate.value);
        document.getElementById('confirmDate').textContent = date.toLocaleDateString('en-US', { 
          weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' 
        });
      } else {
        document.getElementById('confirmDate').textContent = 'Not selected';
      }
      
      const visitTime = document.querySelector('input[name="visitTime"]:checked');
      if (visitTime) {
        document.getElementById('confirmTime').textContent = visitTime.value === '10:00' ? '10:00 AM' : '2:00 PM';
      }
      
      const totalHours = 2 + additionalHours;
      document.getElementById('confirmDuration').textContent = `${totalHours} hour${totalHours > 1 ? 's' : ''}`;
      
      const basePrice = prices[groupSizeSelect.value];
      const additionalCost = additionalHours * additionalHourRate;
      let total = basePrice + additionalCost;
      if (hasReferralDiscount) total = total * 0.9;
      document.getElementById('confirmTotal').textContent = formatCurrency(total);
    }

    // Referral code handling
    const referralInput = document.getElementById('referralCode');
    if (referralInput) {
      referralInput.addEventListener('input', (e) => {
        const code = e.target.value.trim();
        const message = document.getElementById('referralMessage');
        if (code.length >= 6) {
          hasReferralDiscount = true;
          message.classList.remove('hidden');
          updateTotal();
        } else {
          hasReferralDiscount = false;
          message.classList.add('hidden');
          updateTotal();
        }
      });
    }

    // Currency conversion
    function updateCurrencyConversion(mwkAmount) {
      const usd = mwkAmount * exchangeRates.USD;
      const eur = mwkAmount * exchangeRates.EUR;
      document.getElementById('priceUSD').textContent = `$${usd.toFixed(2)}`;
      document.getElementById('priceEUR').textContent = `€${eur.toFixed(2)}`;
    }
    // State
    let additionalHours = 0;

    // Format currency
    const formatCurrency = (amount) => `MWK ${amount.toLocaleString()}`;

    // Calculate and update total
    const updateTotal = () => {
      const basePrice = prices[groupSizeSelect.value];
      const additionalCost = additionalHours * additionalHourRate;
      let total = basePrice + additionalCost;
      
      // Apply referral discount
      let discount = 0;
      if (hasReferralDiscount) {
        discount = total * 0.1;
        total = total * 0.9;
        document.getElementById('discountRow').classList.remove('hidden');
        document.getElementById('discountAmount').textContent = `-${formatCurrency(discount)}`;
      } else {
        document.getElementById('discountRow').classList.add('hidden');
      }

      basePriceDisplay.textContent = formatCurrency(basePrice);
      additionalCostDisplay.textContent = formatCurrency(additionalCost);
      totalCostDisplay.textContent = formatCurrency(total);
      
      // Update currency conversions
      updateCurrencyConversion(total);
      
      // Add visual feedback animation
      totalCostDisplay.classList.add('scale-110', 'text-primary-700');
      setTimeout(() => {
        totalCostDisplay.classList.remove('scale-110', 'text-primary-700');
      }, 300);
    };

    // Event listeners
    groupSizeSelect.addEventListener('change', updateTotal);

    decreaseHoursBtn.addEventListener('click', () => {
      if (additionalHours > 0) {
        additionalHours--;
        additionalHoursDisplay.textContent = additionalHours;
        updateTotal();
      }
    });

    increaseHoursBtn.addEventListener('click', () => {
      additionalHours++;
      additionalHoursDisplay.textContent = additionalHours;
      updateTotal();
    });

    // Initialize
    updateTotal();

    // Package selection function
    window.selectPackage = (groupValue, basePrice) => {
      groupSizeSelect.value = groupValue;
      updateTotal();
      
      // Scroll to calculator
      const groupSizeElement = document.querySelector('#groupSize');
      if (groupSizeElement) {
        groupSizeElement.scrollIntoView({ 
          behavior: 'smooth', 
          block: 'center' 
        });
      }
      
      // Highlight the calculator briefly
      const calculator = document.querySelector('#pricing-calculator');
      if (calculator) {
        calculator.classList.add('ring-4', 'ring-primary-500', 'ring-opacity-50');
        setTimeout(() => {
          calculator.classList.remove('ring-4', 'ring-primary-500', 'ring-opacity-50');
        }, 2000);
      }
    };

    // Handle Book Your Visit button click
    const bookVisitBtn = document.getElementById('bookVisitBtn');
    if (bookVisitBtn) {
      bookVisitBtn.addEventListener('click', (e) => {
        e.preventDefault();
        
        // Get current selections
        const groupSize = groupSizeSelect.value;
        const hours = additionalHours;
        const basePrice = prices[groupSize];
        const totalCost = basePrice + (hours * additionalHourRate);
        
        // Get date and time selections
        const visitDate = document.getElementById('visitDate')?.value || '';
        const visitTimeRadio = document.querySelector('input[name="visitTime"]:checked');
        const visitTime = visitTimeRadio ? visitTimeRadio.value : '10:00';
        
        // Map group size value to form option
        const groupSizeMap = {
          '1': '1',
          '2': '2-5',
          '6': '6-10',
          '11': '10+'
        };
        
        // Determine tour type based on hours
        let tourType = 'standard';
        if (hours > 0) {
          tourType = hours === 1 || hours === 2 ? 'extended' : 'custom';
        }
        
        // Build URL with parameters including date and time
        const params = new URLSearchParams({
          groupSize: groupSizeMap[groupSize],
          tourType: tourType,
          estimatedCost: totalCost,
          additionalHours: hours,
          visitDate: visitDate,
          visitTime: visitTime
        });
        
        // Navigate to booking form with parameters (params BEFORE hash)
        window.location.href = `/visit/?${params.toString()}#planTripForm`;
      });
    }

    // Initialize currency conversion
    updateCurrencyConversion(15000);
  </script>

  <style>
    /* Step transition animations */
    .booking-step {
      animation: fadeIn 0.3s ease-in;
    }
    
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    /* Progress indicator animations */
    .step-circle {
      transition: all 0.3s ease;
    }
    
    .step-label {
      transition: all 0.3s ease;
    }
    
    /* Radio button styling for time selection */
    input[type="radio"]:checked + span {
      color: #4F46E5;
    }
    
    input[type="radio"]:checked {
      background-color: #4F46E5;
      border-color: #4F46E5;
    }
  </style>
</MainLayout>
