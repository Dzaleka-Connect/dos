                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-gray-700 group-hover:text-primary-600 transition-colors">Lilongwe/Kimuzu International Airport (Lilongwe)</span>
                </li>
                <li class="flex items-start group">
                  <div class="flex-shrink-0 w-6 h-6 bg-primary-100 rounded-full flex items-center justify-center mr-3 mt-1">
                    <svg class="w-3 h-3 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-gray-700 group-hover:text-primary-600 transition-colors">Chileka International Airport (Blantyre)</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
