---
import MainLayout from '../../layouts/MainLayout.astro';

const pageTitle = "Dzaleka Refugee Camp Travel Guide";
const pageDescription = "Comprehensive travel guide for visiting Dzaleka Refugee Camp in Malawi. Includes practical information, cultural experiences, educational opportunities, safety tips, visa requirements, and ethical considerations for visitors. Updated for 2025.";
const pageKeywords = "Dzaleka Refugee Camp, Malawi travel guide, refugee camp visit, Tumaini Festival, TakenoLAB, Dzaleka art, Malawi tourism, refugee tourism, ethical tourism, cultural experiences Malawi, Dowa District travel, Lilongwe tourism, Malawi visa requirements, refugee camp tourism, community tourism, educational tourism, cultural exchange Malawi, humanitarian tourism, responsible tourism Malawi";

const seo = {
  title: pageTitle,
  description: pageDescription,
  image: '/images/20241023_205851_3.jpg',
  keywords: pageKeywords,
  type: 'article',
  publishedTime: '2025-04-01',
  modifiedTime: '2025-04-01',
  author: 'Dzaleka Online Services',
  canonical: 'https://services.dzaleka.com/visit/travel-guide',
  openGraph: {
    title: pageTitle,
    description: pageDescription,
    image: '/images/20241023_205851_3.jpg',
    type: 'article',
    site_name: 'Dzaleka Online Services',
    locale: 'en_US',
    url: 'https://services.dzaleka.com/visit/travel-guide'
  },
  twitter: {
    card: 'summary_large_image',
    title: pageTitle,
    description: pageDescription,
    image: '/images/20241023_205851_3.jpg'
  }
};
---

<MainLayout title={seo.title} description={seo.description} image={seo.image} type={seo.type} canonical={seo.canonical} openGraph={seo.openGraph} twitter={seo.twitter}>
  <main class="min-h-screen bg-gradient-to-b from-gray-50 to-white">
    {/* Floating Book Now CTA */}
    <div id="floatingCTA" class="fixed bottom-6 right-6 z-50 hidden">
      <a 
        href="/visit/#planTripForm" 
        class="flex items-center gap-2 px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white rounded-full shadow-2xl hover:shadow-3xl transition-all duration-300 hover:scale-105 group"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <span class="font-medium">Book Your Visit</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    {/* Hero Section - Enhanced */}
    <div class="relative bg-primary-600 text-white py-20 sm:py-24 md:py-32">
      <div class="absolute inset-0">
        <img 
          src="/images/20241023_205851_3.jpg" 
          alt="Dzaleka Refugee Camp" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/30"></div>
      </div>
      
      {/* Decorative elements - Move these before the content */}
      <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-white to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 h-1/2 bg-grid-pattern opacity-10"></div>
      
      {/* Main content - Add z-index to ensure it's above overlays */}
      <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col items-center text-center">
          <div class="inline-flex items-center px-4 py-2 bg-white/10 backdrop-blur-md rounded-full mb-6 border border-white/20">
            <span class="w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse"></span>
            <span class="text-sm font-medium">Updated for 2025</span>
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-4 sm:mb-6 leading-tight bg-clip-text text-transparent bg-gradient-to-r from-white to-white/80">
            {pageTitle}
          </h1>
          <p class="text-lg sm:text-xl md:text-2xl text-white/90 max-w-3xl mx-auto mb-6 sm:mb-8 leading-relaxed">
            Discover the rich cultural heritage, educational opportunities, and community initiatives at Dzaleka Refugee Camp, Malawi's largest refugee settlement.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <a 
              href="#introduction" 
              class="inline-flex items-center px-6 py-3 bg-white text-primary-600 rounded-full font-medium hover:bg-primary-50 transition-all duration-300 hover:scale-105 hover:shadow-lg group"
            >
              Start Exploring
              <svg 
                class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" 
                fill="none" 
                stroke="currentColor" 
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a 
              href="#practical-info" 
              class="inline-flex items-center px-6 py-3 bg-transparent border-2 border-white text-white rounded-full font-medium hover:bg-white/10 transition-all duration-300 hover:scale-105 group"
            >
              Practical Info
              <svg 
                class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" 
                fill="none" 
                stroke="currentColor" 
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Main Content - Enhanced */}
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      {/* Quick Stats Bar */}
      <div class="grid grid-cols-2 md:flex md:flex-wrap md:justify-between items-center gap-4 sm:gap-6 mb-12 p-4 sm:p-6 bg-white rounded-2xl shadow-lg border border-gray-100">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-primary-50 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm text-gray-500">Population</p>
            <p class="text-xl font-bold text-gray-900">52,000+</p>
          </div>
        </div>
        <div class="h-12 w-px bg-gray-200 hidden md:block"></div>
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-primary-50 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm text-gray-500">Languages</p>
            <p class="text-xl font-bold text-gray-900">English & Chichewa</p>
          </div>
        </div>
        <div class="h-12 w-px bg-gray-200 hidden md:block"></div>
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-primary-50 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm text-gray-500">Time Zone</p>
            <p class="text-xl font-bold text-gray-900">CAT (UTC+2)</p>
          </div>
        </div>
        <div class="h-12 w-px bg-gray-200 hidden md:block"></div>
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-primary-50 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-sm text-gray-500">Currency</p>
            <p class="text-xl font-bold text-gray-900">Malawian Kwacha</p>
          </div>
        </div>
      </div>

      {/* Travel Section */}
      <section class="bg-white rounded-2xl shadow-lg p-8 mb-12 border border-gray-100 hover:shadow-xl transition-all duration-300">
        <div class="flex items-center gap-4 mb-8">
          <div class="w-12 h-12 bg-primary-50 rounded-full flex items-center justify-center shrink-0">
            <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div>
            <h2 class="text-2xl font-bold text-gray-900">Getting Here</h2>
            <p class="text-gray-500 mt-1">Travel options and directions</p>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {/* Location & Transport */}
          <div class="space-y-6">
            <div class="bg-gray-50 rounded-xl p-6 hover:bg-primary-50 transition-all duration-300">
              <h3 class="text-lg font-semibold text-gray-900 mb-3 flex items-center">
                <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                </svg>
                Location
              </h3>
              <ul class="space-y-3 text-gray-700">
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-primary-600 mr-2 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  41 kilometers from Lilongwe city center
                </li>
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-primary-600 mr-2 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  30 kilometers from Kamuzu International Airport
                </li>
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-primary-600 mr-2 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  Located in Dowa District, Central Region
                </li>
              </ul>
            </div>

            <div class="bg-gray-50 rounded-xl p-6 hover:bg-primary-50 transition-all duration-300">
              <h3 class="text-lg font-semibold text-gray-900 mb-3 flex items-center">
                <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                </svg>
                From Kamuzu International Airport
              </h3>
              <ul class="space-y-3 text-gray-700">
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-primary-600 mr-2 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  Taxi services available directly from the airport
                </li>
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-primary-600 mr-2 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  Car rental options at the airport terminal
                </li>
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-primary-600 mr-2 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  Approximately 45 minutes drive
                </li>
              </ul>
            </div>
          </div>

          {/* Public Transport & Directions */}
          <div class="space-y-6">
            <div class="bg-gray-50 rounded-xl p-6 hover:bg-primary-50 transition-all duration-300">
              <h3 class="text-lg font-semibold text-gray-900 mb-3 flex items-center">
                <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v6a2 2 0 002 2h2"/>
                </svg>
                Public Transport
              </h3>
              <ul class="space-y-3 text-gray-700">
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-primary-600 mr-2 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  Regular minibuses from Lilongwe to Dowa
                </li>
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-primary-600 mr-2 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  Local transport available from Dowa to the camp
                </li>
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-primary-600 mr-2 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                  Journey time: 1-1.5 hours total
                </li>
              </ul>
            </div>

            <div class="bg-gray-50 rounded-xl p-6 hover:bg-primary-50 transition-all duration-300">
              <h3 class="text-lg font-semibold text-gray-900 mb-3 flex items-center">
                <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                Tour Guide Services
              </h3>
              <div class="space-y-4">
                <p class="text-gray-700">Make your visit more meaningful with our experienced local guides who can:</p>
                <ul class="space-y-3 text-gray-700">
                  <li class="flex items-start">
                    <svg class="w-5 h-5 text-primary-600 mr-2 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                    Share in-depth knowledge of camp history and culture
                  </li>
                  <li class="flex items-start">
                    <svg class="w-5 h-5 text-primary-600 mr-2 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                    Facilitate community interactions
                  </li>
                  <li class="flex items-start">
                    <svg class="w-5 h-5 text-primary-600 mr-2 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                    Provide translation services when needed
                  </li>
                </ul>
                <div class="mt-6">
                  <a 
                    href="/visit#planTripForm" 
                    class="inline-flex items-center justify-center px-6 py-3 bg-primary-600 hover:bg-primary-700 text-white font-medium rounded-lg transition-all duration-300 hover:scale-105 group"
                  >
                    Book a Tour Guide
                    <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Navigation Tabs - Enhanced */}
      <div class="bg-white rounded-2xl shadow-lg p-1 mb-12 sticky top-4 z-40 border border-gray-100">
        <div class="flex gap-2 p-2 overflow-x-auto custom-scrollbar">
          {['Introduction', 'Practical Info', 'Things to Do', 'Education', 'Community', 'Ethics', 'Malawi Info'].map((item) => (
            <a
              href={`#${item.toLowerCase().replace(' ', '-')}`}
              class="flex-shrink-0 px-4 py-2 rounded-full text-sm font-medium transition-all duration-300 hover:scale-105 hover:shadow-md bg-gray-50 text-gray-700 hover:bg-primary-50 hover:text-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 whitespace-nowrap"
            >
              {item}
            </a>
          ))}
        </div>
      </div>

      {/* Content Sections - Enhanced */}
      <div class="space-y-12">
        {/* Introduction Section */}
        <section id="introduction" class="scroll-mt-20">
          <div class="bg-white rounded-2xl shadow-lg p-8 border border-gray-100 hover:shadow-xl transition-all duration-300">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-12 bg-primary-50 rounded-full flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h2 class="text-2xl font-bold text-gray-900">About Dzaleka Refugee Camp</h2>
                <p class="text-gray-500 mt-1">Established in 1994</p>
              </div>
            </div>
            <div class="prose prose-lg max-w-none">
              <p class="text-gray-700 leading-relaxed">
                Dzaleka Refugee Camp, situated in Malawi's Dowa District approximately 41 kilometers from Lilongwe, was established in 1994 by the Government of Malawi and the United Nations High Commissioner for Refugees (UNHCR). Originally a political prison during Hastings Kamuzu Banda's presidency (1964-1994), it now hosts a population exceeding 52,000 refugees and asylum seekers, primarily from the Democratic Republic of Congo (62%), Burundi (19%), and Rwanda (7%), with additional representation from Ethiopia, Eritrea, Somalia, and other nationalities.
              </p>
              <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-gray-50 rounded-xl p-6 hover:bg-primary-50 transition-all duration-300">
                  <h3 class="font-semibold text-gray-900 mb-2">Location</h3>
                  <p class="text-gray-600">41km from Lilongwe, Malawi's capital city</p>
                </div>
                <div class="bg-gray-50 rounded-xl p-6 hover:bg-primary-50 transition-all duration-300">
                  <h3 class="font-semibold text-gray-900 mb-2">Establishment</h3>
                  <p class="text-gray-600">Founded in 1994 by Malawi Government & UNHCR</p>
                </div>
                <div class="bg-gray-50 rounded-xl p-6 hover:bg-primary-50 transition-all duration-300">
                  <h3 class="font-semibold text-gray-900 mb-2">Demographics</h3>
                  <p class="text-gray-600">Diverse population from multiple African nations</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        {/* Practical Information */}
        <section id="practical-info" class="bg-white rounded-2xl shadow-lg p-8 mb-12 border border-gray-100">
          <div class="flex items-center mb-8">
            <div class="w-12 h-12 bg-primary-100 rounded-full flex items-center justify-center mr-4">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
            </div>
            <h2 class="text-2xl font-bold text-gray-900">Practical Information</h2>
          </div>
          
          <div class="grid md:grid-cols-2 gap-8">
            <div class="bg-gray-50 rounded-xl p-6 hover:shadow-md transition-shadow">
              <h3 class="text-xl font-semibold text-gray-800 mb-3 flex items-center">
                <svg class="w-5 h-5 mr-2 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                Getting There
              </h3>
