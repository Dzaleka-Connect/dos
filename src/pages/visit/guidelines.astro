---

<MainLayout title={seo.title} description={seo.description} openGraph={seo.openGraph} twitter={seo.twitter}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData, null, 2)} />

  <div class="min-h-screen bg-gray-50">
    {/* Hero Section */}
    <div class="border-b border-gray-200 bg-white py-12 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10">
          <div class="inline-flex items-center space-x-2 bg-slate-100 border border-slate-200 rounded-full px-4 py-2 mb-6">
            <svg class="w-4 h-4 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-sm font-medium text-slate-700">Essential Information</span>
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900">Visitor Guidelines</h1>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Essential information to ensure a respectful and meaningful visit to Dzaleka Refugee Camp
          </p>
        </div>

        {/* Quick Guidelines Icons */}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-3xl mx-auto">
          <div class="bg-slate-50 border border-slate-200 rounded p-3 text-center text-slate-800">
            <div class="text-2xl mb-1">🤝</div>
            <div class="text-xs font-medium">Cultural Sensitivity</div>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded p-3 text-center text-slate-800">
            <div class="text-2xl mb-1">📸</div>
            <div class="text-xs font-medium">Photography Rules</div>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded p-3 text-center text-slate-800">
            <div class="text-2xl mb-1">👕</div>
            <div class="text-xs font-medium">Dress Code</div>
          </div>
          <div class="bg-slate-50 border border-slate-200 rounded p-3 text-center text-slate-800">
            <div class="text-2xl mb-1">🏥</div>
            <div class="text-xs font-medium">Health & Safety</div>
          </div>
        </div>
      </div>
    </div>

    {/* Main Content */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      {/* Introduction */}
      <div class="max-w-3xl mx-auto text-center mb-16">
        <p class="text-lg text-gray-700 leading-relaxed">
          Welcome to Dzaleka Refugee Camp. These guidelines are designed to help you have a respectful and meaningful visit while ensuring the comfort and privacy of our community members.
        </p>
      </div>

      {/* Guidelines Grid */}
      <div class="grid md:grid-cols-2 gap-8 mb-16">
        {guidelines.map(section => (
          <div class="bg-white rounded shadow-sm p-5 sm:p-8 transition-all duration-300">
            <div class="flex items-center gap-4 mb-6">
              <span class="text-4xl">{section.icon}</span>
              <h2 class="text-2xl font-bold text-gray-900">{section.category}</h2>
            </div>
            <ul class="space-y-4">
              {section.items.map(item => (
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-primary-600 mr-3 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span class="text-gray-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      {/* Practical Tips */}
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-center mb-12">Practical Tips</h2>
        <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-8">
          {practicalTips.map(tip => (
            <div class="bg-white rounded p-6 text-center transition-all duration-300">
              <span class="text-4xl mb-4 block">{tip.icon}</span>
              <h3 class="font-bold text-gray-900 mb-2">{tip.title}</h3>
              <p class="text-gray-600 text-sm">{tip.description}</p>
            </div>
          ))}
        </div>
      </div>

      {/* Dos and Don'ts */}
      <div class="grid md:grid-cols-2 gap-8 mb-16">
        <div class="bg-white rounded p-5 sm:p-8 border-t-4 border-green-500">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
            <svg class="w-6 h-6 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Do's
          </h2>
          <ul class="space-y-4">
            {dosDonts.dos.map(item => (
              <li class="flex items-start">
                <svg class="w-5 h-5 text-green-500 mr-3 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span class="text-gray-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="bg-white rounded p-5 sm:p-8 border-t-4 border-red-500">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
            <svg class="w-6 h-6 text-red-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Don'ts
          </h2>
          <ul class="space-y-4">
            {dosDonts.donts.map(item => (
              <li class="flex items-start">
                <svg class="w-5 h-5 text-red-500 mr-3 mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
                <span class="text-gray-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      {/* Call to Action */}
      <div class="bg-primary-50 rounded p-5 sm:p-8 text-center">
        <h2 class="text-2xl font-bold text-primary-900 mb-4">Ready to Visit?</h2>
        <p class="text-primary-800 mb-6 max-w-2xl mx-auto">
          Now that you're familiar with our guidelines, book your visit to Dzaleka Refugee Camp and experience our vibrant community.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="https://visit.dzaleka.com/login"
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[44px] inline-flex items-center px-6 py-3 bg-white border border-slate-300 text-slate-700 rounded hover:bg-slate-50 transition-colors"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            Login / Sign Up
          </a>
          <a
            href="/visit#planTripForm"
            class="min-h-[44px] inline-flex items-center px-6 py-3 bg-primary-900 text-white rounded hover:bg-primary-800 transition-colors group"
          >
            Book Your Visit
            <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a
            href="/visit/travel-guide"
            class="min-h-[44px] inline-flex items-center px-6 py-3 border border-slate-300 text-slate-700 rounded hover:bg-slate-50 transition-colors"
          >
            View Travel Guide
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>
