---
import MainLayout from '../../layouts/MainLayout.astro';

const pageTitle = "Visitor Guidelines | Dzaleka Refugee Camp";
const description = "Essential visitor guidelines for Dzaleka Refugee Camp: cultural sensitivity protocols, photography policies, dress code requirements, health & safety tips, and respectful visit practices. Complete guide for meaningful community engagement in Malawi's largest refugee settlement.";

const seo = {
  title: pageTitle,
  description,
  openGraph: {
    title: pageTitle,
    description,
    type: 'article',
    url: 'https://services.dzaleka.com/visit/guidelines',
    image: 'https://services.dzaleka.com/images/Visit_Dzaleka.png'
  },
  twitter: {
    card: 'summary_large_image',
    title: pageTitle,
    description,
    image: 'https://services.dzaleka.com/images/Visit_Dzaleka.png'
  }
};

const guidelines = [
  {
    category: "Cultural Sensitivity",
    icon: "🤝",
    items: [
      "Always ask permission before taking photographs of people",
      "Respect personal space and privacy",
      "Be mindful of different cultural backgrounds",
      "Listen more than you speak",
      "Show appreciation for shared stories"
    ]
  },
  {
    category: "Dress Code",
    icon: "👕",
    items: [
      "Wear modest, culturally appropriate clothing",
      "Comfortable walking shoes are essential",
      "Bring a hat or umbrella for sun protection",
      "Avoid revealing or inappropriate attire",
      "Consider weather conditions when planning your outfit"
    ]
  },
  {
    category: "Photography & Media",
    icon: "📸",
    items: [
      "Always obtain explicit permission before photographing individuals",
      "No photos of government or security facilities",
      "Respect 'no photography' zones",
      "Be mindful of context when sharing photos",
      "Consider privacy implications"
    ]
  },
  {
    category: "Health & Safety",
    icon: "🏥",
    items: [
      "Bring sufficient water and stay hydrated",
      "Use sunscreen and insect repellent",
      "Follow your guide's safety instructions",
      "Keep valuables secure",
      "Be aware of your surroundings"
    ]
  }
];

const practicalTips = [
  {
    title: "Documentation",
    description: "Bring valid identification and any required permits",
    icon: "📄"
  },
  {
    title: "Timing",
    description: "Arrive 15 minutes before your scheduled tour",
    icon: "⏰"
  },
  {
    title: "Communication",
    description: "Save important contact numbers including your guide's",
    icon: "📱"
  },
  {
    title: "Payments",
    description: "Bring local currency for any purchases or donations",
    icon: "💳"
  }
];

const dosDonts = {
  dos: [
    "Ask questions respectfully",
    "Follow guide instructions",
    "Support local businesses",
    "Be punctual for tours",
    "Show gratitude",
    "Maintain positive attitude"
  ],
  donts: [
    "Make promises you can't keep",
    "Give money to individuals",
    "Take photos without permission",
    "Ignore cultural customs",
    "Share sensitive information",
    "Wander off alone"
  ]
};

// Create structured data for the guidelines page
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://services.dzaleka.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Visit",
          "item": "https://services.dzaleka.com/visit"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Visitor Guidelines",
          "item": "https://services.dzaleka.com/visit/guidelines"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What should I wear when visiting Dzaleka Refugee Camp?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Wear modest, culturally appropriate clothing and comfortable walking shoes. Bring a hat or umbrella for sun protection and avoid revealing or inappropriate attire. Consider weather conditions when planning your outfit."
          }
        },
        {
          "@type": "Question",
          "name": "What are the photography rules at Dzaleka Refugee Camp?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Always obtain explicit permission before photographing individuals, do not take photos of government or security facilities, respect 'no photography' zones, and be mindful of context when sharing photos. Consider privacy implications of all photography."
          }
        },
        {
          "@type": "Question",
          "name": "What documents do I need to bring for my visit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bring valid identification and any required permits. Save important contact numbers including your guide's number, and arrive 15 minutes before your scheduled tour."
          }
        },
        {
          "@type": "Question",
          "name": "What are the health and safety guidelines?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bring sufficient water and stay hydrated, use sunscreen and insect repellent, follow your guide's safety instructions, keep valuables secure, and be aware of your surroundings at all times."
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to Visit Dzaleka Refugee Camp Respectfully",
      "description": "Guidelines for ensuring a respectful and meaningful visit to Dzaleka Refugee Camp while maintaining cultural sensitivity and community comfort.",
      "image": {
        "@type": "ImageObject",
        "url": "https://services.dzaleka.com/images/441259874_18314784967180415_6501749961090280063_n.jpg",
        "height": "630",
        "width": "1200",
        "creator": {
          "@type": "Organization",
          "name": "Dzaleka Online Services"
        },
        "creditText": "Dzaleka Online Services",
        "copyrightNotice": `© ${new Date().getFullYear()} Dzaleka Online Services`,
        "license": "https://services.dzaleka.com/terms",
        "acquireLicensePage": "https://services.dzaleka.com/contact"
      },
      "step": [
        {
          "@type": "HowToStep",
          "name": "Cultural Sensitivity",
          "text": "Respect personal space and privacy, be mindful of different cultural backgrounds, listen more than you speak, and show appreciation for shared stories.",
          "image": {
            "@type": "ImageObject",
            "url": "https://services.dzaleka.com/images/361579234_611191654478987_355961963947114655_n.jpg",
            "creator": {
              "@type": "Organization",
              "name": "Dzaleka Online Services"
            },
            "creditText": "Dzaleka Online Services",
            "copyrightNotice": `© ${new Date().getFullYear()} Dzaleka Online Services`,
            "license": "https://services.dzaleka.com/terms",
            "acquireLicensePage": "https://services.dzaleka.com/contact"
          }
        },
        {
          "@type": "HowToStep",
          "name": "Documentation and Preparation",
          "text": "Bring valid identification, required permits, and save important contact numbers including your guide's contact information.",
          "image": {
            "@type": "ImageObject",
            "url": "https://services.dzaleka.com/images/283945145_548818096818208_2823546272117801301_n.jpg",
            "creator": {
              "@type": "Organization",
              "name": "Dzaleka Online Services"
            },
            "creditText": "Dzaleka Online Services",
            "copyrightNotice": `© ${new Date().getFullYear()} Dzaleka Online Services`,
            "license": "https://services.dzaleka.com/terms",
            "acquireLicensePage": "https://services.dzaleka.com/contact"
          }
        },
        {
          "@type": "HowToStep",
          "name": "Health and Safety",
          "text": "Bring water, use sun protection, follow guide instructions, and maintain awareness of surroundings.",
          "image": {
            "@type": "ImageObject",
            "url": "https://services.dzaleka.com/images/Dzaleka Health Centre.jpg",
            "creator": {
              "@type": "Organization",
              "name": "Dzaleka Online Services"
            },
            "creditText": "Dzaleka Online Services",
            "copyrightNotice": `© ${new Date().getFullYear()} Dzaleka Online Services`,
            "license": "https://services.dzaleka.com/terms",
            "acquireLicensePage": "https://services.dzaleka.com/contact"
          }
        }
      ],
      "totalTime": "PT2H"
    },
    {
      "@type": "Article",
      "headline": "Visitor Guidelines for Dzaleka Refugee Camp",
      "description": description,
      "image": "https://services.dzaleka.com/images/Visit_Dzaleka.png",
      "datePublished": "2024-01-01T08:00:00+00:00",
      "dateModified": "2024-04-01T08:00:00+00:00",
      "author": {
        "@type": "Organization",
        "name": "Dzaleka Online Services",
        "url": "https://services.dzaleka.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Dzaleka Online Services",
        "logo": {
          "@type": "ImageObject",
          "url": "https://services.dzaleka.com/images/dzaleka-digital-heritage.png",
          "width": "200",
          "height": "200",
          "creator": {
            "@type": "Organization",
            "name": "Dzaleka Online Services"
          },
          "creditText": "Dzaleka Online Services",
          "copyrightNotice": `© ${new Date().getFullYear()} Dzaleka Online Services`,
          "license": "https://services.dzaleka.com/terms",
          "acquireLicensePage": "https://services.dzaleka.com/contact"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://services.dzaleka.com/visit/guidelines"
      }
    }
  ]
