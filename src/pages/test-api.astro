---
import Layout from '../layouts/Layout.astro';

const exportApiEndpoint = '/api/export';

const collectionGroups = [
  {
    title: 'Core content',
    description: 'Main public collections used across services, updates, and learning pages.',
    items: [
      { key: 'services', label: 'Services', description: 'Service organisations and support listings.' },
      { key: 'resources', label: 'Resources', description: 'Documents, guides, and downloads.' },
      { key: 'events', label: 'Events', description: 'Community events and activity listings.' },
      { key: 'news', label: 'News', description: 'Published articles and updates.' },
      { key: 'jobs', label: 'Jobs', description: 'Job listings and opportunity notices.' },
      { key: 'courses', label: 'Courses', description: 'E-learning courses and training content.' },
      { key: 'docs', label: 'Docs', description: 'Documentation pages for the platform.' },
      { key: 'pages', label: 'Pages', description: 'Optional published pages collection.' },
    ],
  },
  {
    title: 'Community and culture',
    description: 'Collections used by community storytelling, culture, and creative directory pages.',
    items: [
      { key: 'community-voices', label: 'Community voices', description: 'Published community voice stories.' },
      { key: 'photos', label: 'Photos', description: 'Photo gallery items and metadata.' },
      { key: 'artists', label: 'Artists', description: 'Public art artist profiles.' },
      { key: 'artworks', label: 'Artworks', description: 'Public art catalogue artwork entries.' },
      { key: 'poets', label: 'Poets', description: 'Poet directory entries.' },
      { key: 'dancers', label: 'Dancers', description: 'Dance crew and dancer profiles.' },
      { key: 'rights', label: 'Rights navigator', description: 'Legal and rights guidance entries.' },
    ],
  },
  {
    title: 'Directories and business',
    description: 'Marketplace, store, talent, and profile collections used across business-facing sections.',
    items: [
      { key: 'profiles', label: 'Profiles', description: 'Skills exchange profiles.' },
      { key: 'talents', label: 'Talents', description: 'Talent directory data endpoint.' },
      { key: 'marketplace', label: 'Marketplace', description: 'Marketplace product and service listings.' },
      { key: 'stores', label: 'Stores', description: 'Marketplace store profiles.' },
    ],
  },
];

const collectionRecords = collectionGroups.flatMap((group) => group.items);
const totalCollections = collectionRecords.length;
---

<Layout title="API Test Utility">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <main class="min-h-screen bg-gray-50">
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
          <p class="text-sm font-medium text-gray-500">Internal utility</p>
          <h1 class="mt-2 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">
            API test utility
          </h1>
          <p class="mt-4 text-base leading-7 text-gray-600">
            Check public collection endpoints, test export responses, and verify that API routes return the expected shape before publishing changes.
          </p>
        </div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <div class="rounded border border-gray-200 bg-gray-50 p-5">
            <p class="text-sm font-medium text-gray-500">Collections listed</p>
            <p class="mt-2 text-2xl font-semibold text-gray-900">{totalCollections}</p>
          </div>
          <div class="rounded border border-gray-200 bg-gray-50 p-5">
            <p class="text-sm font-medium text-gray-500">Export endpoint</p>
            <code class="mt-2 block text-sm text-gray-900">{exportApiEndpoint}</code>
          </div>
          <div class="rounded border border-gray-200 bg-gray-50 p-5">
            <p class="text-sm font-medium text-gray-500">Methods covered</p>
            <p class="mt-2 text-sm leading-6 text-gray-900">GET, POST, OPTIONS for collection endpoints.</p>
          </div>
          <div class="rounded border border-gray-200 bg-gray-50 p-5">
            <p class="text-sm font-medium text-gray-500">Use this page for</p>
            <p class="mt-2 text-sm leading-6 text-gray-900">Collection checks, export payloads, and quick endpoint debugging.</p>
          </div>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="grid gap-8 xl:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
        <section class="min-w-0 space-y-8">
          <div class="grid gap-6 lg:grid-cols-2">
            <section class="rounded border border-gray-200 bg-white p-6">
              <h2 class="text-lg font-semibold text-gray-900">Export tester</h2>
              <p class="mt-2 text-sm leading-6 text-gray-600">
                Use the export endpoint to fetch a selected collection with optional metadata and stats.
              </p>

              <div class="mt-5 space-y-4">
                <div>
                  <label for="exportApiUrl" class="block text-sm font-medium text-gray-700">Endpoint</label>
                  <div class="mt-2 flex min-w-0 flex-wrap gap-2">
                    <input id="exportApiUrl" type="text" class="min-w-0 w-full rounded border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-700" readonly />
                    <button id="copyExportUrl" type="button" class="rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                      Copy
                    </button>
                  </div>
                </div>

                <div>
                  <label for="exportCollection" class="block text-sm font-medium text-gray-700">Collection</label>
                  <select id="exportCollection" class="mt-2 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700 focus:border-primary-500 focus:ring-primary-500">
                    {collectionGroups.map((group) => (
                      <optgroup label={group.title}>
                        {group.items.map((collection) => (
                          <option value={collection.key}>{collection.label}</option>
                        ))}
                      </optgroup>
                    ))}
                  </select>
                </div>

                <div class="grid gap-3 sm:grid-cols-2">
                  <label class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-700">
                    <input type="checkbox" id="includeMetadata" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" checked />
                    Include metadata
                  </label>
                  <label class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-700">
                    <input type="checkbox" id="includeStats" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" checked />
                    Include stats
                  </label>
                </div>

                <div class="flex flex-wrap gap-3">
                  <button id="testGet" type="button" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                    Test GET info
                  </button>
                  <button id="testExportPost" type="button" class="rounded-md border border-primary-600 bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">
                    Test POST export
                  </button>
                </div>
              </div>
            </section>

            <section class="rounded border border-gray-200 bg-white p-6">
              <h2 class="text-lg font-semibold text-gray-900">Collection tester</h2>
              <p class="mt-2 text-sm leading-6 text-gray-600">
                Test one public collection endpoint directly, or use the cards below to inspect each collection quickly.
              </p>

              <div class="mt-5 space-y-4">
                <div>
                  <label for="directCollection" class="block text-sm font-medium text-gray-700">Collection</label>
                  <select id="directCollection" class="mt-2 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700 focus:border-primary-500 focus:ring-primary-500">
                    {collectionGroups.map((group) => (
                      <optgroup label={group.title}>
                        {group.items.map((collection) => (
                          <option value={collection.key}>{collection.label}</option>
                        ))}
                      </optgroup>
                    ))}
                  </select>
                </div>

                <div>
                  <label for="directApiUrl" class="block text-sm font-medium text-gray-700">Endpoint</label>
                  <div class="mt-2 flex min-w-0 flex-wrap gap-2">
                    <input id="directApiUrl" type="text" class="min-w-0 w-full rounded border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-700" readonly />
                    <button id="copyDirectUrl" type="button" class="rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                      Copy
                    </button>
                  </div>
                </div>

                <div class="grid gap-3 sm:grid-cols-2">
                  <label class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-700">
                    <input type="checkbox" id="directIncludeMetadata" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" checked />
                    Include metadata
                  </label>
                  <label class="flex items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-700">
                    <input type="checkbox" id="directIncludeStats" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" checked />
                    Include stats
                  </label>
                </div>

                <div class="flex flex-wrap gap-3">
                  <button id="testDirectGet" type="button" class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                    Test GET
                  </button>
                  <button id="testDirectPost" type="button" class="rounded-md border border-primary-600 bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">
                    Test POST
                  </button>
                </div>
              </div>
            </section>
          </div>

          <section class="rounded border border-gray-200 bg-white p-6">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="text-lg font-semibold text-gray-900">Collection status</h2>
                <p class="mt-1 text-sm leading-6 text-gray-600">
                  Check all public content collections and see whether the endpoint is available and returning items.
                </p>
              </div>
              <button id="checkAllCollections" type="button" class="rounded-md border border-primary-600 bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700">
                Check all collections
              </button>
            </div>

            <div class="mt-6 grid gap-6">
              {collectionGroups.map((group) => (
                <section>
                  <div class="mb-3">
                    <h3 class="text-sm font-semibold uppercase tracking-wide text-gray-900">{group.title}</h3>
                    <p class="mt-1 text-sm leading-6 text-gray-600">{group.description}</p>
                  </div>
                  <div class="grid gap-4 md:grid-cols-2 2xl:grid-cols-3">
                    {group.items.map((collection) => (
                      <article
                        class="collection-card rounded border border-gray-200 bg-white p-4 transition"
                        data-collection={collection.key}
                        data-endpoint={`/api/${collection.key}`}
                      >
                        <div class="flex items-start justify-between gap-4">
                          <div>
                            <h4 class="text-base font-medium text-gray-900">{collection.label}</h4>
                            <p class="mt-1 text-sm leading-6 text-gray-600">{collection.description}</p>
                          </div>
                          <button class="test-collection-btn rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50" type="button">
                            Test
                          </button>
                        </div>
                        <code class="endpoint-url mt-4 block text-xs text-primary-700"></code>
                        <div class="mt-4 flex items-center gap-2">
                          <span class="status-indicator inline-block h-3 w-3 rounded-full bg-gray-300"></span>
                          <span class="status-text text-sm text-gray-500">Not checked</span>
                        </div>
                        <div class="item-count mt-1 text-xs text-gray-400"></div>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </section>
        </section>

        <aside class="space-y-6">
          <section class="rounded border border-gray-200 bg-white p-6">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-lg font-semibold text-gray-900">Request</h2>
              <button id="copyRequest" type="button" class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50">
                Copy
              </button>
            </div>
            <pre id="request" class="mt-4 max-h-64 overflow-auto rounded-lg bg-gray-950 p-4 text-sm text-green-400">Select an option above to test the API…</pre>
          </section>

          <section class="rounded border border-gray-200 bg-white p-6">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-lg font-semibold text-gray-900">Response</h2>
              <button id="copyResponse" type="button" class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50">
                Copy
              </button>
            </div>
            <pre id="response" class="mt-4 max-h-[32rem] overflow-auto rounded-lg bg-gray-950 p-4 text-sm text-green-400">Response will appear here…</pre>
          </section>

          <section class="rounded border border-gray-200 bg-white p-6">
            <h2 class="text-base font-semibold text-gray-900">What was fixed</h2>
            <ul class="mt-4 space-y-3 text-sm leading-6 text-gray-600">
              <li>`courses` is now part of the public collection API and export list.</li>
              <li>The tester now groups collections instead of showing one long flat list.</li>
              <li>Error responses now include response bodies when available, not just generic status text.</li>
              <li>Status checks reset old border/state classes instead of stacking stale colors.</li>
            </ul>
          </section>
        </aside>
      </div>
    </div>
  </main>

  <script define:vars={{ collectionRecords, exportApiEndpoint }}>
    const requestEl = document.getElementById('request');
    const responseEl = document.getElementById('response');
    const exportApiUrlInput = document.getElementById('exportApiUrl');
    const directApiUrlInput = document.getElementById('directApiUrl');
    const exportCollectionEl = document.getElementById('exportCollection');
    const directCollectionEl = document.getElementById('directCollection');

    const baseUrl = `${window.location.protocol}//${window.location.host}`;
    const collectionMap = Object.fromEntries(collectionRecords.map((entry) => [entry.key, entry]));
    const apiEndpoints = {
      export: `${baseUrl}${exportApiEndpoint}`,
      ...Object.fromEntries(collectionRecords.map((entry) => [entry.key, `${baseUrl}/api/${entry.key}`])),
    };

    function updateRequest(text) {
      if (requestEl) requestEl.textContent = text;
    }

    function updateResponse(text, isError = false) {
      if (!responseEl) return;
      responseEl.textContent = text;
      responseEl.classList.toggle('text-red-400', isError);
      responseEl.classList.toggle('text-green-400', !isError);
    }

    function copyText(text, button) {
      if (!text) return;
      navigator.clipboard.writeText(text);
      if (!button) return;
      const originalText = button.textContent;
      button.textContent = 'Copied';
      setTimeout(() => {
        button.textContent = originalText;
      }, 1200);
    }

    async function parseResponse(response) {
      const contentType = response.headers.get('content-type') || '';
      const rawText = await response.text();

      if (!rawText) return null;

      if (contentType.includes('application/json')) {
        try {
          return JSON.parse(rawText);
        } catch (error) {
          return rawText;
        }
      }

      return rawText;
    }

    async function makeApiRequest(url, options = {}) {
      const response = await fetch(url, options);
      const payload = await parseResponse(response);

      if (!response.ok) {
        const message =
          typeof payload === 'string'
            ? payload
            : payload?.message || payload?.error || `HTTP ${response.status}`;
        throw new Error(message);
      }

      return payload;
    }

    function summariseResponse(responseData) {
      if (!responseData || typeof responseData !== 'object') {
        return responseData;
      }

      if (responseData.data && typeof responseData.data === 'object') {
        return {
          ...responseData,
          data: Object.fromEntries(
            Object.entries(responseData.data).map(([key, value]) => [
              key,
              Array.isArray(value) ? `[${value.length} items]` : value,
            ])
          ),
        };
      }

      return responseData;
    }

    function resetCardState(card) {
      card.classList.remove(
        'border-green-300',
        'border-yellow-300',
        'border-red-300',
        'bg-green-50',
        'bg-yellow-50',
        'bg-red-50'
      );
    }

    function setCardState(card, state, countText = '') {
      const indicator = card.querySelector('.status-indicator');
      const label = card.querySelector('.status-text');
      const count = card.querySelector('.item-count');

      resetCardState(card);

      if (!indicator || !label || !count) return;

      const states = {
        idle: {
          indicator: 'bg-gray-300',
          label: 'Not checked',
          labelClass: 'text-gray-500',
          card: '',
        },
        loading: {
          indicator: 'bg-blue-500',
          label: 'Checking…',
          labelClass: 'text-blue-600',
          card: '',
        },
        available: {
          indicator: 'bg-green-500',
          label: 'Available',
          labelClass: 'text-green-700',
          card: 'border-green-300 bg-green-50',
        },
        empty: {
          indicator: 'bg-yellow-500',
          label: 'Empty',
          labelClass: 'text-yellow-700',
          card: 'border-yellow-300 bg-yellow-50',
        },
        unavailable: {
          indicator: 'bg-red-500',
          label: 'Unavailable',
          labelClass: 'text-red-700',
          card: 'border-red-300 bg-red-50',
        },
      };

      const config = states[state];
      indicator.className = `status-indicator inline-block h-3 w-3 rounded-full ${config.indicator}`;
      label.textContent = config.label;
      label.className = `status-text text-sm ${config.labelClass}`;
      count.textContent = countText;
      if (config.card) {
        card.classList.add(...config.card.split(' '));
      }
    }

    function syncCollectionUrls() {
      if (exportApiUrlInput) exportApiUrlInput.value = apiEndpoints.export;
      if (directApiUrlInput && directCollectionEl) {
        directApiUrlInput.value = apiEndpoints[directCollectionEl.value];
      }
    }

    function buildExportBody() {
      return {
        collections: [exportCollectionEl?.value || 'services'],
        options: {
          includeMetadata: document.getElementById('includeMetadata')?.checked || false,
          includeStats: document.getElementById('includeStats')?.checked || false,
        },
      };
    }

    function buildDirectBody() {
      return {
        options: {
          includeMetadata: document.getElementById('directIncludeMetadata')?.checked || false,
          includeStats: document.getElementById('directIncludeStats')?.checked || false,
        },
      };
    }

    async function runRequest(requestText, requestFactory, button) {
      const originalLabel = button?.textContent;
      if (button) {
        button.disabled = true;
        button.classList.add('opacity-70');
        button.textContent = 'Loading…';
      }

      updateRequest(requestText);
      updateResponse('Loading…');

      try {
        const data = await requestFactory();
        updateResponse(JSON.stringify(summariseResponse(data), null, 2));
      } catch (error) {
        updateResponse(error instanceof Error ? error.message : String(error), true);
      } finally {
        if (button) {
          button.disabled = false;
          button.classList.remove('opacity-70');
          button.textContent = originalLabel;
        }
      }
    }

    async function testCollection(collectionKey, button = null) {
      if (directCollectionEl) directCollectionEl.value = collectionKey;
      syncCollectionUrls();

      const requestText = `GET ${apiEndpoints[collectionKey]}`;
      await runRequest(
        requestText,
        () =>
          makeApiRequest(apiEndpoints[collectionKey], {
            method: 'GET',
            headers: { Accept: 'application/json' },
          }),
        button
      );
    }

    exportCollectionEl?.addEventListener('change', syncCollectionUrls);
    directCollectionEl?.addEventListener('change', syncCollectionUrls);
    syncCollectionUrls();

    document.getElementById('copyExportUrl')?.addEventListener('click', (event) => {
      copyText(exportApiUrlInput?.value || '', event.currentTarget);
    });

    document.getElementById('copyDirectUrl')?.addEventListener('click', (event) => {
      copyText(directApiUrlInput?.value || '', event.currentTarget);
    });

    document.getElementById('copyRequest')?.addEventListener('click', (event) => {
      copyText(requestEl?.textContent || '', event.currentTarget);
    });

    document.getElementById('copyResponse')?.addEventListener('click', (event) => {
      copyText(responseEl?.textContent || '', event.currentTarget);
    });

    document.getElementById('testGet')?.addEventListener('click', async (event) => {
      await runRequest(
        `GET ${apiEndpoints.export}`,
        () => makeApiRequest(apiEndpoints.export, { method: 'GET', headers: { Accept: 'application/json' } }),
        event.currentTarget
      );
    });

    document.getElementById('testExportPost')?.addEventListener('click', async (event) => {
      const payload = buildExportBody();
      await runRequest(
        `POST ${apiEndpoints.export}\n${JSON.stringify(payload, null, 2)}`,
        () =>
          makeApiRequest(apiEndpoints.export, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          }),
        event.currentTarget
      );
    });

    document.getElementById('testDirectGet')?.addEventListener('click', async (event) => {
      const collectionKey = directCollectionEl?.value || 'services';
      await testCollection(collectionKey, event.currentTarget);
    });

    document.getElementById('testDirectPost')?.addEventListener('click', async (event) => {
      const collectionKey = directCollectionEl?.value || 'services';
      const payload = buildDirectBody();
      await runRequest(
        `POST ${apiEndpoints[collectionKey]}\n${JSON.stringify(payload, null, 2)}`,
        () =>
          makeApiRequest(apiEndpoints[collectionKey], {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          }),
        event.currentTarget
      );
    });

    document.querySelectorAll('.collection-card').forEach((card) => {
      card.addEventListener('click', async () => {
        const collectionKey = card.dataset.collection;
        if (!collectionKey) return;
        await testCollection(collectionKey);
      });
    });

    document.querySelectorAll('.test-collection-btn').forEach((button) => {
      button.addEventListener('click', async (event) => {
        event.stopPropagation();
        const card = event.currentTarget.closest('.collection-card');
        const collectionKey = card?.dataset.collection;
        if (!collectionKey) return;

        await testCollection(collectionKey, event.currentTarget);
      });
    });

    document.getElementById('checkAllCollections')?.addEventListener('click', async (event) => {
      const button = event.currentTarget;
      const originalText = button.textContent;
      button.disabled = true;
      button.textContent = 'Checking…';
      button.classList.add('opacity-70');

      const cards = [...document.querySelectorAll('.collection-card')];

      for (const card of cards) {
        const collectionKey = card.dataset.collection;
        if (!collectionKey) continue;

        setCardState(card, 'loading');

        try {
          const data = await makeApiRequest(apiEndpoints[collectionKey], {
            method: 'GET',
            headers: { Accept: 'application/json' },
          });

          const count =
            typeof data?.count === 'number'
              ? data.count
              : Array.isArray(data?.data?.[collectionKey])
                ? data.data[collectionKey].length
                : 0;

          if (count > 0) {
            setCardState(card, 'available', `${count} items`);
          } else {
            setCardState(card, 'empty', '0 items');
          }
        } catch (error) {
          setCardState(card, 'unavailable', error instanceof Error ? error.message : 'API request failed');
        }
      }

      button.disabled = false;
      button.textContent = originalText;
      button.classList.remove('opacity-70');
    });
  </script>

  <style>
    .collection-card {
      cursor: pointer;
    }

    .collection-card:hover {
      border-color: rgb(191 219 254);
      background-color: rgb(249 250 251);
    }

    .endpoint-url {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    }
  </style>
</Layout>
