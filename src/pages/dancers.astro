---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const pageTitle = "Dancers From Dzaleka - Dance Groups & Performers";
const pageDescription = "Discover incredible dance talent from Dzaleka Refugee Camp. Book performances, join dance groups, and connect with dancers from the Democratic Republic of Congo, Rwanda, and Burundi. Traditional and contemporary dance styles.";
const pageKeywords = "Dzaleka dancers, refugee dance groups, DRC dancers, Rwandan dancers, Burundian dancers, dance performances, traditional dance, contemporary dance, dance booking, refugee artists, Dzaleka dance community";
const canonicalURL = "https://services.dzaleka.com/dancers";

// Get dance profiles from content collection
const danceProfiles = await getCollection('dancers');
const danceGroups = danceProfiles.filter(profile => profile.data.type === 'group');
const individualDancers = danceProfiles.filter(profile => profile.data.type === 'individual');

// Generate structured data for dancers
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Dancers From Dzaleka",
  "description": pageDescription,
  "url": canonicalURL,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": danceProfiles.length,
    "itemListElement": danceProfiles.slice(0, 10).map((dancer, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": dancer.data.type === 'group' ? "Organization" : "Person",
        "name": dancer.data.title,
        "description": dancer.data.description,
        "url": `https://services.dzaleka.com/dancers/${dancer.slug}`,
        "nationality": dancer.data.nationality,
        "age": dancer.data.age,
        "jobTitle": dancer.data.type === 'group' ? "Dance Group" : "Dancer",
        "worksFor": {
          "@type": "Organization",
          "name": "Dzaleka Online Services"
        }
      }
    }))
  },
  "publisher": {
    "@type": "Organization",
    "name": "Dzaleka Online Services",
    "url": "https://services.dzaleka.com/"
  }
};
---

<MainLayout 
  title={pageTitle} 
  description={pageDescription}
  keywords={pageKeywords}
  canonical={canonicalURL}
  ogType="website"
  ogImage="/images/dancers/forus-crew.jpg"
  twitterCard="summary_large_image"
>
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-purple-900 via-purple-800 to-purple-900 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl sm:text-6xl font-bold text-white tracking-tight mb-6">
        Dancers From Dzaleka
      </h1>
      <p class="text-xl sm:text-2xl text-purple-100 max-w-4xl mx-auto mb-12">
        Celebrating the Rhythm, Energy, and Stories of Dzaleka's Dance Talent
      </p>
      
      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#browse-dancers" 
           class="inline-flex items-center justify-center px-8 py-4 rounded-lg text-purple-900 bg-white hover:bg-gray-50 transition-colors font-semibold text-lg shadow-lg">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          Browse Dancers
        </a>
        <a href="/dancers/book-performance" 
           class="inline-flex items-center justify-center px-8 py-4 rounded-lg text-white border-2 border-white hover:bg-white hover:text-purple-900 transition-colors font-semibold text-lg">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Book a Performance
        </a>
        <a href="/dancers/submit" 
           class="inline-flex items-center justify-center px-8 py-4 rounded-lg text-white border-2 border-white hover:bg-white hover:text-purple-900 transition-colors font-semibold text-lg">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
          Add Your Profile
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Dance Groups Section -->
  <section id="browse-dancers" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Meet Some Dancers From Dzaleka</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Discover the incredible dance talent and inspiring stories from our community's dance groups and individual performers.
        </p>
      </div>

      <!-- Dance Groups Grid -->
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 mb-16">
        {danceGroups.map(group => (
          <a href={`/dancers/${group.slug}`} 
             class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100 overflow-hidden">
            <div class="relative h-64 overflow-hidden">
              {group.data.image ? (
                <img src={group.data.image} alt={group.data.title} 
                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-purple-400 to-purple-600 flex items-center justify-center">
                  <div class="text-white text-center">
                    <svg class="w-16 h-16 mx-auto mb-4 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <p class="text-sm opacity-90">Dance Group</p>
                  </div>
                </div>
              )}
              {group.data.featured && (
                <div class="absolute top-4 right-4 bg-yellow-400 text-yellow-900 px-3 py-1 rounded-full text-sm font-semibold">
                  Featured
                </div>
              )}
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-purple-600 transition-colors">
                {group.data.title}
              </h3>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2">{group.data.description}</p>
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                  <span class="text-sm text-gray-500">
                    {Array.isArray(group.data.members) ? group.data.members.length : group.data.members} members
                  </span>
                  {(group.data.email || group.data.phone || group.data.whatsapp) && (
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                      Contact Available
                    </span>
                  )}
                </div>
                <span class="text-purple-600 font-semibold group-hover:translate-x-1 transition-transform">
                  View Profile →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Individual Dancers Section -->
      <div class="text-center mb-8">
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Individual Performers</h3>
        <p class="text-gray-600">Meet the talented solo dancers who bring their unique style to our community.</p>
      </div>

      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {individualDancers.map(dancer => (
          <a href={`/dancers/${dancer.slug}`} 
             class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100 overflow-hidden">
            <div class="relative h-64 overflow-hidden">
              {dancer.data.image ? (
                <img src={dancer.data.image} alt={dancer.data.title} 
                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-purple-400 to-purple-600 flex items-center justify-center">
                  <div class="text-white text-center">
                    <svg class="w-16 h-16 mx-auto mb-4 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <p class="text-sm opacity-90">Solo Dancer</p>
                  </div>
                </div>
              )}
              {dancer.data.featured && (
                <div class="absolute top-4 right-4 bg-yellow-400 text-yellow-900 px-3 py-1 rounded-full text-sm font-semibold">
                  Featured
                </div>
              )}
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-purple-600 transition-colors">
                {dancer.data.title}
              </h3>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2">{dancer.data.description}</p>
              <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                  <span class="text-sm text-gray-500">{dancer.data.age} years • {dancer.data.nationality}</span>
                  {(dancer.data.email || dancer.data.phone || dancer.data.whatsapp) && (
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                      Contact Available
                    </span>
                  )}
                </div>
                <span class="text-purple-600 font-semibold group-hover:translate-x-1 transition-transform">
                  View Profile →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Community Impact Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Dance as Community Building</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Our dancers not only entertain but also inspire hope, preserve culture, and create opportunities for economic empowerment.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="bg-purple-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Cultural Preservation</h3>
          <p class="text-gray-600">Keeping traditional dances alive while embracing contemporary styles.</p>
        </div>
        
        <div class="text-center">
          <div class="bg-purple-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Economic Opportunity</h3>
          <p class="text-gray-600">Creating income through performances, teaching, and cultural events.</p>
        </div>
        
        <div class="text-center">
          <div class="bg-purple-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Community Unity</h3>
          <p class="text-gray-600">Bringing people together through the universal language of dance.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="py-16 bg-purple-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Support Our Dance Community</h2>
      <p class="text-xl text-purple-100 mb-8 max-w-2xl mx-auto">
        Whether you want to book a performance, join a dance group, or support our dancers, 
        there are many ways to get involved.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" 
           class="inline-flex items-center justify-center px-8 py-4 rounded-lg text-purple-900 bg-white hover:bg-gray-50 transition-colors font-semibold text-lg">
          Book a Performance
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a href="/dancers/submit" 
           class="inline-flex items-center justify-center px-8 py-4 rounded-lg text-white border-2 border-white hover:bg-white hover:text-purple-900 transition-colors font-semibold text-lg">
          Add Your Profile
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
