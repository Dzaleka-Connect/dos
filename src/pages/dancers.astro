---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const pageTitle = "Dancers From Dzaleka - Dance Groups & Performers";
const pageDescription = "Browse dance groups and performers from Dzaleka Refugee Camp, find booking details, or submit a dance profile.";
const pageKeywords = "Dzaleka dancers, refugee dance groups, DRC dancers, Rwandan dancers, Burundian dancers, dance performances, traditional dance, contemporary dance, dance booking, refugee artists, Dzaleka dance community";
const canonicalURL = "https://services.dzaleka.com/dancers";

// Get dance profiles from content collection
const danceProfiles = await getCollection('dancers');
const danceGroups = danceProfiles.filter(profile => profile.data.type === 'group');
const individualDancers = danceProfiles.filter(profile => profile.data.type === 'individual');

// Generate structured data for dancers
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Dancers From Dzaleka",
  "description": pageDescription,
  "url": canonicalURL,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": danceProfiles.length,
    "itemListElement": danceProfiles.slice(0, 10).map((dancer, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": dancer.data.type === 'group' ? "Organization" : "Person",
        "name": dancer.data.title,
        "description": dancer.data.description,
        "url": `https://services.dzaleka.com/dancers/${dancer.id}`,
        "nationality": dancer.data.nationality,
        "age": dancer.data.age,
        "jobTitle": dancer.data.type === 'group' ? "Dance Group" : "Dancer",
        "worksFor": {
          "@type": "Organization",
          "name": "Dzaleka Online Services"
        }
      }
    }))
  },
  "publisher": {
    "@type": "Organization",
    "name": "Dzaleka Online Services",
    "url": "https://services.dzaleka.com/"
  }
};
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonical={canonicalURL}
  ogType="website"
  ogImage="/images/dancers/forus-crew.jpg"
  twitterCard="summary_large_image"
>
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Hero Section -->
  <section class="border-b border-gray-200 bg-white mb-12">
    <div class="container mx-auto px-4 py-12 lg:py-16">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-block mb-6">
          <span class="px-4 py-1.5 bg-slate-100 text-slate-700 rounded-full text-sm font-medium border border-slate-200">
            Dance Community
          </span>
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          Dancers from Dzaleka
        </h1>
        <p class="text-xl text-gray-600 mb-8 max-w-3xl mx-auto leading-relaxed">
          Celebrating the rhythm, energy, and stories of Dzaleka's dance talent
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#browse-dancers" class="min-h-[44px] inline-flex items-center px-6 py-3 bg-primary-900 text-white rounded hover:bg-primary-800 transition-colors font-medium">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            Browse Dancers
          </a>
          <a href="/dancers/book-performance" class="min-h-[44px] inline-flex items-center px-6 py-3 border-2 border-gray-900 text-slate-700 bg-white rounded hover:bg-slate-50 transition-colors font-medium">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Book Performance
          </a>
          <a href="/dancers/submit" class="min-h-[44px] inline-flex items-center px-6 py-3 border-2 border-gray-900 text-slate-700 bg-white rounded hover:bg-slate-50 transition-colors font-medium">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
            </svg>
            Add Your Profile
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Dance Groups Section -->
  <section id="browse-dancers" class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-3">Dance Groups</h2>
        <p class="text-lg text-gray-600">
          Browse dance groups and performers based in Dzaleka
        </p>
      </div>

      <!-- Dance Groups Grid -->
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mb-12">
        {danceGroups.map(group => (
          <a href={`/dancers/${group.id}`}
             class="group bg-white rounded transition-all duration-200 border border-gray-100 hover:border-slate-200 overflow-hidden flex flex-col">
            <div class="relative h-48 overflow-hidden bg-gray-100">
              {group.data.image ? (
                <img src={group.data.image} alt={group.data.title}
                     class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center">
                  <svg class="w-16 h-16 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h1m4 0h1m-6 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
              )}
              {group.data.featured && (
                <div class="absolute top-3 right-3 bg-amber-500 text-white px-2 py-1 rounded-full text-xs font-semibold">
                  Featured
                </div>
              )}
            </div>
            <div class="p-5 flex-grow flex flex-col">
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                {group.data.title}
              </h3>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2 flex-grow">{group.data.description}</p>
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-500">
                  {Array.isArray(group.data.members) ? group.data.members.length : group.data.members} members
                </span>
                <span class="text-slate-700 font-medium">
                  View Profile →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Individual Dancers Section -->
      <div class="text-center mb-8">
        <h3 class="text-2xl font-bold text-gray-900 mb-3">Individual Performers</h3>
        <p class="text-gray-600">Meet the talented solo dancers from our community</p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {individualDancers.map(dancer => (
          <a href={`/dancers/${dancer.id}`}
             class="group bg-white rounded transition-all duration-200 border border-gray-100 hover:border-slate-200 overflow-hidden flex flex-col">
            <div class="relative h-48 overflow-hidden bg-gray-100">
              {dancer.data.image ? (
                <img src={dancer.data.image} alt={dancer.data.title}
                     class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center">
                  <svg class="w-16 h-16 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
              )}
              {dancer.data.featured && (
                <div class="absolute top-3 right-3 bg-amber-500 text-white px-2 py-1 rounded-full text-xs font-semibold">
                  Featured
                </div>
              )}
            </div>
            <div class="p-5 flex-grow flex flex-col">
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                {dancer.data.title}
              </h3>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2 flex-grow">{dancer.data.description}</p>
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-500">{dancer.data.age} years • {dancer.data.nationality}</span>
                <span class="text-slate-700 font-medium">
                  View Profile →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Community Impact Section -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-3">Dance as community building</h2>
        <p class="text-gray-600 max-w-3xl mx-auto">
          Find performance groups, cultural dance, contemporary work, and booking information.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="text-center bg-white p-6 rounded border border-gray-100">
          <div class="bg-slate-100 rounded-full w-14 h-14 flex items-center justify-center mx-auto mb-3">
            <svg class="w-7 h-7 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Cultural Preservation</h3>
          <p class="text-gray-600 text-sm">Keeping traditional dances alive while embracing contemporary styles</p>
        </div>

        <div class="text-center bg-white p-6 rounded border border-gray-100">
          <div class="bg-slate-100 rounded-full w-14 h-14 flex items-center justify-center mx-auto mb-3">
            <svg class="w-7 h-7 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Economic Opportunity</h3>
          <p class="text-gray-600 text-sm">Creating income through performances, teaching, and cultural events</p>
        </div>

        <div class="text-center bg-white p-6 rounded border border-gray-100">
          <div class="bg-slate-100 rounded-full w-14 h-14 flex items-center justify-center mx-auto mb-3">
            <svg class="w-7 h-7 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Community Unity</h3>
          <p class="text-gray-600 text-sm">Bringing people together through the universal language of dance</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-3">Join our dance community</h2>
      <p class="text-gray-600 mb-6">
        Whether you want to book a performance or add your profile, there are many ways to get involved
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="min-h-[44px] inline-flex items-center justify-center px-6 py-3 rounded bg-primary-900 text-white hover:bg-primary-800 transition-colors font-medium">
          Book a Performance
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a href="/dancers/submit" class="min-h-[44px] inline-flex items-center justify-center px-6 py-3 rounded border-2 border-gray-900 text-slate-700 bg-white hover:bg-slate-50 transition-colors font-medium">
          Add Your Profile
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
