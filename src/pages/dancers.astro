---
import MainLayout from '../layouts/MainLayout.astro';
import CollectionHeader from '../components/ui/CollectionHeader.astro';
import DirectoryCard from '../components/ui/DirectoryCard.astro';
import CultureNav from '../components/culture/CultureNav.astro';
import { getCollection } from 'astro:content';
const profiles = (await getCollection('dancers')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const groups = profiles.filter(profile => profile.data.type === 'group');
const individuals = profiles.filter(profile => profile.data.type !== 'group');
---
<MainLayout title="Dancers from Dzaleka | Dzaleka Online Services" description="Meet dance groups and performers from Dzaleka and find information about performances and bookings." canonical="https://services.dzaleka.com/dancers" image="/images/dancers/forus-crew.jpg">
  <CollectionHeader title="Dancers from Dzaleka" description="Explore traditional and contemporary dance, meet local crews and individual performers, and find the right contact for a performance." action={{ label: 'Request a performance', href: '/dancers/book-performance' }}>
    <a href="/dancers/submit" class="inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">Add a dance profile</a>
  </CollectionHeader>
  <CultureNav current="/dancers" />
  <div class="mx-auto max-w-7xl space-y-10 px-4 py-8 sm:px-6 lg:px-8">
    {[{ title: 'Dance groups', records: groups }, { title: 'Individual performers', records: individuals }].filter(section => section.records.length).map(section => <section>
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-3"><h2 class="text-primary-900">{section.title}</h2><p class="text-sm text-slate-600">{section.records.length} {section.records.length === 1 ? 'profile' : 'profiles'}</p></div>
      <div class="grid auto-rows-fr gap-6 sm:grid-cols-2 lg:grid-cols-3">{section.records.map(profile => <DirectoryCard title={profile.data.title} href={`/dancers/${profile.id}`} image={profile.data.image} description={profile.data.description} meta={profile.data.type === 'group' ? 'Dance group' : profile.data.nationality} contain />)}</div>
    </section>)}
    {profiles.length === 0 && <p class="rounded border border-slate-200 bg-slate-50 p-6 text-slate-700">Dance profiles will appear here as they are published.</p>}
    <aside class="border-t border-slate-200 pt-6"><h2 class="text-primary-900">Planning a performance</h2><p class="mt-3 max-w-3xl text-base leading-7 text-slate-700">Read a group’s profile to learn about its styles and experience. When making a booking request, include the date, venue and type of event so the performers can advise on availability.</p></aside>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'ItemList', name: 'Dancers from Dzaleka', itemListElement: profiles.map((profile, i) => ({ '@type': 'ListItem', position: i + 1, name: profile.data.title, url: `https://services.dzaleka.com/dancers/${profile.id}` })) })} />
</MainLayout>
