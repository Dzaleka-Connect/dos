---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

const serviceAreas = [
  {
    title: 'Find services and information',
    description: 'Browse verified services, support organisations, public resources, and practical information for daily life in and around Dzaleka.',
    links: [
      { label: 'Services directory', href: '/services' },
      { label: 'Resources', href: '/resources' },
      { label: 'Start Here', href: '/start-here' }
    ],
    icon: 'services'
  },
  {
    title: 'Jobs, skills, and learning',
    description: 'Find jobs, list skills, request support, and explore learning and course opportunities across the platform.',
    links: [
      { label: 'Jobs', href: '/jobs' },
      { label: 'Skills Exchange', href: '/skills-exchange' },
      { label: 'E-learning', href: '/e-learning' }
    ],
    icon: 'growth'
  },
  {
    title: 'Business and market access',
    description: 'Explore refugee-led businesses, discover products, and register stores or listings through the marketplace tools.',
    links: [
      { label: 'Marketplace', href: '/marketplace' },
      { label: 'Store directory', href: '/marketplace/stores' },
      { label: 'Register a store', href: '/marketplace/stores/register' }
    ],
    icon: 'business'
  },
  {
    title: 'Culture, stories, and community records',
    description: 'Document places, public art, photography, local talent, and community voices in a shared public archive.',
    links: [
      { label: 'Public Art Catalogue', href: '/public-art-catalogue' },
      { label: 'Site Register', href: '/site-register' },
      { label: 'Community Voices', href: '/community-voices' }
    ],
    icon: 'archive'
  },
  {
    title: 'Events, visits, and participation',
    description: 'Stay updated on events, plan a visit, and find ways to take part in cultural, educational, and community activities.',
    links: [
      { label: 'Events', href: '/events' },
      { label: 'Visit Dzaleka', href: '/visit' },
      { label: 'Yetu Radio', href: '/yetu-radio' }
    ],
    icon: 'calendar'
  },
  {
    title: 'Open data and updates',
    description: 'Follow announcements, browse news, and access the data hub for reference, research, and operational context.',
    links: [
      { label: 'News', href: '/news' },
      { label: 'Open Data Platform', href: '/open-data-platform' },
      { label: 'Data Hub', href: '/data' }
    ],
    icon: 'data'
  }
];

const platformCapabilities = [
  {
    title: 'Directories and listings',
    description: 'Public pages for organisations, businesses, jobs, resources, community sites, and cultural records.'
  },
  {
    title: 'Submission and update forms',
    description: 'Structured forms for new listings, corrections, issue reports, registrations, and content updates.'
  },
  {
    title: 'Public information pages',
    description: 'Guidance pages, FAQs, policies, licensing notes, and task-oriented entry points such as Start Here.'
  },
  {
    title: 'Content collections',
    description: 'News, events, photo archives, talent profiles, oral histories, and public art records.'
  },
  {
    title: 'Data and reporting views',
    description: 'Operational dashboards, public data modules, and collection-backed summaries across the site.'
  },
  {
    title: 'Community publishing support',
    description: 'Tools for contributors, partners, businesses, and cultural organisers to publish or maintain public records.'
  }
];

const currentFocus = [
  'Make services easier to find by task, audience, and location.',
  'Improve request, reporting, and submission flows across the platform.',
  'Strengthen public records for culture, sites, and community knowledge.',
  'Support businesses, creators, educators, and job seekers with practical tools.',
  'Keep the platform usable on mobile and readable for first-time visitors.'
];

function iconMarkup(icon) {
  switch (icon) {
    case 'services':
      return `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`;
    case 'growth':
      return `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8L10 18l-4-4-6 6" /></svg>`;
    case 'business':
      return `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4" /></svg>`;
    case 'archive':
      return `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7h16M5 7l1 12h12l1-12M9 11h6" /></svg>`;
    case 'calendar':
      return `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`;
    case 'data':
      return `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>`;
    default:
      return `<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`;
  }
}
---

<MainLayout
  title="Platform Features - Dzaleka Online Services"
  description="Overview of the service areas, tools, and public records available across Dzaleka Online Services."
>
  <main class="min-h-screen bg-slate-50">
    <section class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="mb-8">
          <Breadcrumb
            items={[
              { label: 'Home', href: '/' },
              { label: 'Platform features' }
            ]}
          />
        </div>

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(320px,0.8fr)] lg:items-start">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-500">Services and tools</p>
            <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
              Platform features
            </h1>
            <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-600">
              Dzaleka Online Services combines public information, directories, submissions, cultural records,
              and practical service tools in one place. This page gives a current overview of what the platform supports.
            </p>
          </div>

          <aside class="rounded-lg border border-slate-200 bg-slate-50 p-6">
            <h2 class="text-lg font-semibold text-slate-900">Quick links</h2>
            <div class="mt-4 space-y-3">
              <a href="/start-here" class="block rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50">
                Start Here
              </a>
              <a href="/services" class="block rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50">
                Browse services
              </a>
              <a href="/data" class="block rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50">
                View data hub
              </a>
            </div>
            <p class="mt-4 text-sm leading-6 text-slate-600">
              If you are not sure where to begin, use <a href="/start-here" class="font-medium text-primary-700 hover:text-primary-800">Start Here</a> for audience-based pathways.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-6">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Service areas</h2>
        <p class="mt-2 max-w-3xl text-base leading-7 text-slate-600">
          These are the main areas currently available across the platform.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {serviceAreas.map((area) => (
          <section class="rounded-lg border border-slate-200 bg-white p-6">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-50 text-primary-700" set:html={iconMarkup(area.icon)} />
              <h3 class="text-lg font-semibold text-slate-900">{area.title}</h3>
            </div>
            <p class="mt-4 text-sm leading-6 text-slate-600">{area.description}</p>
            <div class="mt-5 space-y-2">
              {area.links.map((link) => (
                <a href={link.href} class="flex items-center justify-between rounded-lg border border-slate-200 px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50">
                  <span>{link.label}</span>
                  <span class="text-slate-400">→</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="border-y border-slate-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(320px,0.8fr)]">
          <div>
            <h2 class="text-2xl font-bold tracking-tight text-slate-900">What the platform supports</h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              {platformCapabilities.map((item) => (
                <div class="rounded-lg border border-slate-200 bg-slate-50 p-5">
                  <h3 class="text-base font-semibold text-slate-900">{item.title}</h3>
                  <p class="mt-2 text-sm leading-6 text-slate-600">{item.description}</p>
                </div>
              ))}
            </div>
          </div>

          <aside class="rounded-lg border border-slate-200 bg-slate-50 p-6">
            <p class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-500">Current focus</p>
            <h2 class="mt-2 text-xl font-semibold text-slate-900">What the platform is improving</h2>
            <div class="mt-5 space-y-3">
              {currentFocus.map((item) => (
                <div class="flex gap-3 rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700">
                  <span class="mt-0.5 text-primary-700">•</span>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="rounded-lg border border-slate-200 bg-white p-8">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
          <div>
            <h2 class="text-2xl font-bold tracking-tight text-slate-900">Need help choosing where to go?</h2>
            <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
              If you are looking for the right service, trying to understand which section applies to you,
              or starting for the first time, use the audience pathways page.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href="/start-here" class="inline-flex items-center justify-center rounded-lg bg-primary-600 px-5 py-3 text-sm font-medium text-white hover:bg-primary-700">
              Go to Start Here
            </a>
            <a href="/contact" class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50">
              Contact support
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</MainLayout>
