---
import MainLayout from '../layouts/MainLayout.astro';
import CollectionHeader from '../components/ui/CollectionHeader.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => (b.data.mitSolve?.submissionYear || 0) - (a.data.mitSolve?.submissionYear || 0) || a.data.title.localeCompare(b.data.title));
const festival = projects.find(project => project.id === 'tumaini-festival');
const description = 'Projects from Dzaleka submitted to MIT Solve, covering education, technology, menstrual health and culture.';
---
<MainLayout title="Projects from Dzaleka" description={description}>
  <CollectionHeader title="Projects from Dzaleka" description={description} breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Projects' }]} />
  {festival && <div class="mx-auto max-w-7xl px-4 pt-8 sm:px-6 lg:px-8"><article class="grid overflow-hidden rounded border border-slate-200 bg-primary-50 md:grid-cols-2">
    <img src="/images/tumaini_festival_cover.jpeg" alt="A crowd and performers at Tumaini Festival in Dzaleka" width="960" height="640" class="h-56 w-full object-cover md:h-full md:max-h-80" />
    <div class="flex flex-col justify-center p-6 sm:p-8"><p class="text-sm text-primary-800">From the project archive · {festival.data.mitSolve?.submissionYear}</p><h2 class="mt-3 text-primary-900"><a href={`/projects/${festival.id}`} class="underline underline-offset-4">{festival.data.title}</a></h2><p class="mt-4 text-base leading-7 text-slate-700">{festival.data.description}</p><p class="mt-4 text-sm text-slate-600">{festival.data.mitSolve?.solutionCategory}</p></div>
  </article></div>}
  <div class="mx-auto grid max-w-7xl items-start gap-10 px-4 py-8 sm:px-6 lg:grid-cols-[minmax(0,1fr)_18rem] lg:px-8">
    <section aria-labelledby="projects-heading" class="min-w-0">
      <h2 id="projects-heading" class="text-xl text-primary-900">{festival ? 'More MIT Solve submissions' : 'MIT Solve submissions'}</h2>
      <ul class="mt-4 divide-y divide-slate-200 border-y border-slate-200">{projects.filter(project => project.id !== festival?.id).map(project => <li class="py-6">
        <p class="text-sm text-slate-600">{project.data.category}{project.data.mitSolve?.submissionYear && ` · ${project.data.mitSolve.submissionYear}`}</p>
        <h3 class="mt-2 text-2xl leading-8"><a href={`/projects/${project.id}`} class="text-primary-800 underline underline-offset-4">{project.data.title}</a></h3>
        <p class="mt-3 max-w-prose leading-7 text-slate-700">{project.data.description}</p>
      </li>)}</ul>
    </section>
    <aside class="border-t-2 border-primary-900 pt-5" aria-labelledby="related-project-links">
      <h2 id="related-project-links" class="text-xl text-primary-900">Related information</h2>
      <ul class="mt-4 space-y-5 text-sm leading-6">
        <li><a href="/connecting-dzaleka" class="font-medium text-primary-800 underline underline-offset-4">Connecting Dzaleka</a><p class="mt-1 text-slate-600">The community connectivity project.</p></li>
        <li><a href="https://solve.mit.edu/challenges" class="font-medium text-primary-800 underline underline-offset-4">MIT Solve challenges <span aria-hidden="true">↗</span></a></li>
        <li><a href="https://solve.mit.edu/submit-solution" class="font-medium text-primary-800 underline underline-offset-4">Submit a solution to MIT Solve <span aria-hidden="true">↗</span></a></li>
        <li><a href="/contact" class="font-medium text-primary-800 underline underline-offset-4">Contact us about a project listing</a></li>
      </ul>
    </aside>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Projects from Dzaleka', description, url: 'https://services.dzaleka.com/projects', mainEntity: { '@type': 'ItemList', itemListElement: projects.map((project, index) => ({ '@type': 'ListItem', position: index + 1, name: project.data.title, url: `https://services.dzaleka.com/projects/${project.id}` })) } })} />
</MainLayout>
