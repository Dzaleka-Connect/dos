---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const projects = await getCollection('projects');

// Figures come from the project entries in src/content/projects.
const highlights = [
  {
    number: String(projects.length),
    label: 'Projects on MIT Solve'
  },
  {
    number: '50,000+',
    label: 'Tumaini Festival visitors in 2019'
  },
  {
    number: '1,200+',
    label: 'Young people taught English'
  },
  {
    number: '200',
    label: 'Women given menstrual products'
  }
];

// Create SEO metadata
const seo = {
  description: "Projects from Dzaleka Refugee Camp submitted to MIT Solve: technology training, English teaching and child protection, menstrual health and the Tumaini Festival.",
  type: "website",
  canonical: "https://services.dzaleka.com/projects",
  openGraph: {
    description: "Projects from Dzaleka Refugee Camp submitted to MIT Solve: technology training, English teaching and child protection, menstrual health and the Tumaini Festival.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/projects"
  },
  twitter: {
    card: "summary",
    description: "Projects from Dzaleka Refugee Camp submitted to MIT Solve: technology training, English teaching and child protection, menstrual health and the Tumaini Festival."
  }
};

// Create structured data for the projects page
const projectsStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Dzaleka Projects",
  "description": "Projects from Dzaleka Refugee Camp submitted to MIT Solve",
  "url": "https://services.dzaleka.com/projects",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://services.dzaleka.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Projects",
        "item": "https://services.dzaleka.com/projects"
      }
    ]
  },
  "about": {
    "@type": "Organization",
    "name": "Dzaleka Refugee Camp",
    "description": "A refugee camp in Malawi hosting refugees and asylum seekers from various countries"
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": projects.map((project, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Project",
        "name": project.data.title,
        "description": project.data.description,
        "url": `https://services.dzaleka.com/projects/${project.id}`,
        "category": project.data.category
      }
    }))
  }
};
---

<MainLayout
  title="Projects - MIT Solve Solutions"
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(projectsStructuredData)} />

  <div>
    <!-- Hero Section -->
    <div class="relative overflow-hidden bg-gray-900 border-b border-gray-800">
      <div class="relative z-10 max-w-7xl mx-auto px-4 py-16 sm:py-24 sm:px-6 lg:px-8 text-center">
        <p class="text-sm font-semibold tracking-widest uppercase text-gray-400 mb-6">MIT Solve</p>

        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-6">
          Projects from Dzaleka
        </h1>

        <p class="text-xl sm:text-2xl text-gray-300 max-w-3xl mx-auto mb-10">
          Solutions built in the camp and submitted to MIT Solve, from technology training to a festival that draws visitors from across Malawi.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="#projects"
            class="min-h-[44px] w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-white hover:bg-gray-100 text-gray-900 font-bold rounded transition-colors"
          >
            <span>View projects</span>
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>

          <a
            href="https://solve.mit.edu/challenges"
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[44px] w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-white font-bold rounded border border-gray-600 hover:border-gray-400 transition-colors duration-150"
          >
            <span>MIT Solve Challenges</span>
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 py-16">
      <!-- Impact Stats -->
      <section class="mb-20 -mt-12 relative z-10">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8">
          {highlights.map(stat => (
            <div class="bg-white rounded border border-gray-200 p-6">
              <div class="text-4xl font-bold text-gray-900 mb-2">{stat.number}</div>
              <div class="text-gray-600 font-medium">{stat.label}</div>
            </div>
          ))}
        </div>
      </section>

      <!-- Featured Initiative Banner: Connecting Dzaleka -->
      <section class="mb-16">
        <div class="bg-slate-900 text-white rounded p-8 md:p-10 border border-slate-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="max-w-2xl">
            <span class="text-xs font-semibold tracking-widest uppercase text-primary-300 block mb-2">
              Connectivity
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold text-white">Connecting Dzaleka</h2>
            <p class="mt-2 text-sm sm:text-base text-slate-300 leading-relaxed">
              Solar-powered mesh Wi-Fi zones, Starlink satellite backhaul, and zero-rated community portal access across Dzaleka Refugee Camp.
            </p>
          </div>
          <a
            href="/connecting-dzaleka"
            class="px-6 py-3 rounded bg-white hover:bg-gray-100 text-slate-900 font-bold text-sm transition-colors shrink-0"
          >
            About Connecting Dzaleka
          </a>
        </div>
      </section>

      <!-- Projects Grid -->
      <section class="mb-20" id="projects">
        <div class="max-w-2xl mb-10">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Projects</h2>
          <p class="text-gray-600 leading-relaxed">
            Each project page covers the problem, how the solution works and what it has achieved so far.
          </p>
        </div>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {projects.map((project, index) => (
            <article
              class="group bg-white rounded border border-gray-200 overflow-hidden hover:border-slate-400 transition-colors duration-150"
            >
              <div class="p-6">
                <div class="flex items-center justify-between mb-4">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-900">
                    {project.data.category}
                  </span>
                  <span class="text-sm text-gray-500">{project.data.mitSolve?.submissionYear}</span>
                </div>
                <a href={`/projects/${project.id}`} class="block">
                  <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:underline">{project.data.title}</h3>
                  <p class="text-gray-600 mb-4 line-clamp-3">{project.data.description}</p>
                </a>
                <div class="flex flex-wrap gap-2 mb-6">
                  {project.data.impact?.slice(0, 2).map(impact => (
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                      {impact}
                    </span>
                  ))}
                </div>
                <div class="flex justify-between items-center pt-4 border-t border-gray-100">
                  <a
                    href={`/projects/${project.id}`}
                    class="inline-flex items-center text-gray-900 hover:underline font-medium"
                  >
                    View details
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                  <a
                    href={project.data.mitSolve?.solutionUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center text-gray-500 hover:text-gray-700"
                  >
                    MIT Solve
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Call to Action -->
      <section class="bg-gray-50 border border-gray-200 rounded">
        <div class="max-w-4xl mx-auto text-center py-16 px-4">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Working on a solution?</h2>
          <p class="text-gray-600 text-lg mb-8 max-w-2xl mx-auto">
            MIT Solve runs open challenges each year. Submit your project to them directly, or contact us if you want it listed here.
          </p>
          <div class="flex flex-wrap gap-4 justify-center">
            <a
              href="https://solve.mit.edu/submit-solution"
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] inline-flex items-center justify-center px-6 py-3 border border-transparent rounded text-base font-medium text-white bg-slate-900 hover:bg-slate-800 transition-colors duration-150"
            >
              Submit to MIT Solve
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a
              href="/contact"
              class="min-h-[44px] inline-flex items-center justify-center px-6 py-3 border border-gray-300 rounded text-base font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors duration-150"
            >
              Contact us
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
            </a>
          </div>
        </div>
      </section>
    </div>
  </div>
</MainLayout>
