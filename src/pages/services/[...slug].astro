---
import { getContent } from '../../lib/content';
import { getEntry } from '@dos/news';
import ServiceDirectory from '../../components/services/ServiceDirectory.astro';
import ServiceDetail from '../../components/services/ServiceDetail.astro';
import { getServiceDirectory } from '../../utils/serviceDirectory';

export const prerender = false;
const slug = Astro.params.slug || '';
const page = /^\d+$/.test(slug) ? Number(slug) : null;
const params = new URLSearchParams(Astro.url.searchParams);
const services = page === null ? [] : await getContent('services');
if (page !== null) {
  params.set('page', String(page));
  if (!Number.isSafeInteger(page) || page < 1 || page > getServiceDirectory(services, params).totalPages) return new Response('Not found', { status: 404 });
}
const result = page === null ? await getEntry('services', slug) : null;
if (page === null && !result?.entry) return new Response('Not found', { status: 404 });
if (result?.isPreview) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
}
---
{page !== null ? <ServiceDirectory services={services} params={params} /> : <ServiceDetail service={result?.entry} isPreview={result?.isPreview} />}
