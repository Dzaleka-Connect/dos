---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { Image } from 'astro:assets';
import { getServiceStatus } from '../../utils/serviceHelpers';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(service => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);

const defaultLogo = '/images/dzaleka-digital-heritage.png';

// Breadcrumb navigation
const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: service.data.title }
];

// Format date
const formattedDate = service.data.lastUpdated 
  ? new Date(service.data.lastUpdated).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    })
  : null;

// Clean phone number for tel: link
const phoneNumber = service.data.contact?.phone?.replace(/\D/g, '');

const serviceStatus = service.data.contact?.hours ? getServiceStatus(service.data.contact.hours) : null;

// Get related services based on category
const relatedServices = await getCollection('services')
  .then(services => services
    .filter(s => {
      // Skip if it's the same service
      if (s.id === service.id) return false;
      
      // Skip if no category
      if (!s.data.category || !service.data.category) return false;
      
      // Normalize categories for comparison (same logic as stats page)
      const normalizeCategory = (cat) => {
        return cat.toLowerCase()
          .replace(/organizations?/g, 'organization')
          .replace(/organisations?/g, 'organization')
          .replace(/services?/g, 'service')
          .replace(/centers?/g, 'center')
          .replace(/clinics?/g, 'clinic')
          .replace(/schools?/g, 'school')
          .replace(/programs?/g, 'program')
          .replace(/non-profit/g, 'nonprofit')
          .replace(/non-governmental/g, 'ngo')
          .replace(/charity/g, 'nonprofit')
          .trim();
      };
      
      const normalizedCurrent = normalizeCategory(service.data.category);
      const normalizedService = normalizeCategory(s.data.category);
      
      return normalizedCurrent === normalizedService;
    })
    .slice(0, 3)
  );

// Generate meta description
const metaDescription = service.data.description || 'A service provided by the Dzaleka community';

// Generate share title
const shareTitle = `${service.data.title} | Dzaleka Online Services`;

// Current URL for sharing
const currentUrl = new URL(Astro.url.pathname, Astro.site).toString();

// Get the service logo URL
const logoUrl = service.data.logo || '/images/dzaleka-digital-heritage.png';

// Generate Organization schema
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": service.data.title,
  "description": service.data.description,
  "url": currentUrl,
  "logo": {
    "@type": "ImageObject",
    "url": logoUrl
  },
  "address": service.data.location?.address ? {
    "@type": "PostalAddress",
    "streetAddress": service.data.location.address,
    "addressLocality": service.data.location.city || "Dzaleka Refugee Camp",
    "addressCountry": "MW"
  } : undefined,
  "contactPoint": service.data.contact ? {
    "@type": "ContactPoint",
    "telephone": service.data.contact.phone,
    "email": service.data.contact.email,
    "contactType": "customer service",
    "availableLanguage": ["English", "Swahili", "French"]
  } : undefined,
  "sameAs": service.data.socialMedia ? [
    service.data.socialMedia.facebook,
    service.data.socialMedia.twitter,
    service.data.socialMedia.instagram,
    service.data.socialMedia.linkedin,
    service.data.socialMedia.website
  ].filter(Boolean) : undefined,
  "openingHoursSpecification": service.data.contact?.hours ? service.data.contact.hours.split('\n').map(schedule => {
    const [days, times] = schedule.split(': ');
    if (!days || !times) return null;

    const [startTime, endTime] = times.split(' - ');
    if (!startTime || !endTime) return null;

    const dayMap = {
      'mon': 'Monday',
      'tue': 'Tuesday',
      'wed': 'Wednesday',
      'thu': 'Thursday',
      'fri': 'Friday',
      'sat': 'Saturday',
      'sun': 'Sunday'
    };

    const [startDay, endDay] = days.split('-').map(d => dayMap[d.toLowerCase().trim()]);
    if (!startDay || !endDay) return null;

    // Convert time to 24-hour format
    const convertTime = (time) => {
      const [timePart, period] = time.split(' ');
      let [hours, minutes] = timePart.split(':');
      hours = parseInt(hours);
      if (period.toLowerCase() === 'pm' && hours !== 12) hours += 12;
      if (period.toLowerCase() === 'am' && hours === 12) hours = 0;
      return `${hours.toString().padStart(2, '0')}:${minutes}`;
    };

    return {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [startDay, endDay],
      "opens": convertTime(startTime),
      "closes": convertTime(endTime)
    };
  }).filter(Boolean) : undefined,
  "areaServed": {
    "@type": "City",
    "name": "Dzaleka Refugee Camp",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "MW"
    }
  },
  "location": service.data.location?.coordinates ? {
    "@type": "Place",
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": service.data.location.coordinates.lat,
      "longitude": service.data.location.coordinates.lng
    }
  } : undefined,
  "status": service.data.status === 'active' ? 'https://schema.org/ActiveActionStatus' : 'https://schema.org/InactiveActionStatus',
  "additionalType": `https://schema.org/${service.data.category.replace(/\s+/g, '')}`,
  "identifier": {
    "@type": "PropertyValue",
    "name": "Service ID",
    "value": service.id
  }
};

// SEO metadata
const seo = {
  title: service.data.title || 'Service Details',
  description: metaDescription,
  image: logoUrl,
  keywords: [
    service.data.category,
    'Dzaleka Services',
    'Refugee Services',
    service.data.title,
    ...(service.data.tags || [])
  ].filter(Boolean).join(', '),
  type: 'article',
  publishedDate: service.data.date,
  modifiedDate: service.data.lastUpdated || service.data.date
};

---

<MainLayout 
  title={seo.title}
  description={seo.description}
  image={seo.image}
  type={seo.type}
  keywords={seo.keywords}
  publishedDate={seo.publishedDate}
  modifiedDate={seo.modifiedDate}
>
  <slot name="head">
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </slot>
  <main class="min-h-screen bg-gradient-to-b from-gray-50 to-white">
    <div class="container mx-auto px-4 py-8 sm:py-12">
      <div class="max-w-5xl mx-auto">
        <!-- Breadcrumb -->
        <Breadcrumb items={breadcrumbItems} />

        <article class="bg-white rounded-xl shadow-sm overflow-hidden border border-gray-100">
          <!-- Hero Section -->
          <div class="bg-gradient-to-br from-primary-600 to-primary-800 px-6 py-12 sm:px-8 sm:py-16">
            <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8">
              <div class="w-32 h-32 sm:w-40 sm:h-40 flex-shrink-0 mx-auto sm:mx-0">
                <img
                  src={service.data.logo || defaultLogo}
                alt={`${service.data.title} logo`}
                  class="w-full h-full object-contain bg-white rounded-xl p-4 shadow-md"
                />
              </div>
              <div class="text-center sm:text-left flex-1">
                <h1 class="text-3xl sm:text-4xl font-bold text-white mb-3">{service.data.title}</h1>
                <p class="text-lg text-primary-100 mb-4 max-w-2xl mx-auto sm:mx-0">{service.data.description}</p>
                <div class="flex flex-wrap gap-3 justify-center sm:justify-start">
                  <span class="px-4 py-2 bg-white/20 text-white rounded-full text-sm font-medium">
                    {service.data.category}
                  </span>
                  {service.data.status && (
                    <span class={`px-4 py-2 rounded-full text-sm font-medium flex items-center gap-2 ${
                      service.data.status === 'active'
                        ? 'bg-green-400/20 text-green-100'
                        : 'bg-gray-400/20 text-gray-100'
                    }`}>
                      <span class={`w-2 h-2 rounded-full ${
                        service.data.status === 'active'
                          ? 'bg-green-400'
                          : 'bg-gray-400'
                      }`}></span>
                      {service.data.status === 'active' ? 'Active' : 'Inactive'}
                    </span>
                  )}
                  {service.data.verified && (
                    <span class="px-4 py-2 bg-blue-400/20 text-blue-100 rounded-full text-sm font-medium flex items-center gap-2">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      Verified
                    </span>
                  )}
                  {service.data.featured && (
                    <span class="px-4 py-2 bg-yellow-400/20 text-yellow-100 rounded-full text-sm font-medium flex items-center gap-2">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                      Featured
                    </span>
                  )}
                </div>
                {formattedDate && (
                  <p class="mt-4 text-primary-100 text-sm">Last updated: {formattedDate}</p>
                )}
              </div>
            </div>
          </div>



          <!-- Contact Information -->
          <div class="bg-white border-b border-gray-100">
            <div class="max-w-3xl mx-auto p-6 sm:p-8">
              <h3 class="text-xl font-semibold text-gray-900 mb-4">Contact Information</h3>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
            {service.data.contact?.email && (
              <a
                href={`mailto:${service.data.contact.email}`}
                    class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg hover:bg-primary-50 transition-colors"
              >
                    <div class="p-2 bg-white rounded-lg shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                    <div class="flex-1 min-w-0">
                      <h4 class="text-sm font-medium text-gray-900">Email</h4>
                      <p class="mt-1 text-sm text-gray-600 truncate">{service.data.contact.email}</p>
                    </div>
              </a>
            )}
                
            {service.data.contact?.phone && (
              <a
                    href={`tel:${phoneNumber}`}
                    class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg hover:bg-primary-50 transition-colors"
              >
                    <div class="p-2 bg-white rounded-lg shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                    <div class="flex-1 min-w-0">
                      <h4 class="text-sm font-medium text-gray-900">Phone</h4>
                      <p class="mt-1 text-sm text-gray-600 truncate">{service.data.contact.phone}</p>
                    </div>
              </a>
            )}

                {service.data.location && (
                  <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                    <div class="p-2 bg-white rounded-lg shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                    <div class="flex-1 min-w-0">
                      <h4 class="text-sm font-medium text-gray-900">Location</h4>
                      <p class="mt-1 text-sm text-gray-600">
                        {service.data.location.address}
                        {service.data.location.city && `, ${service.data.location.city}`}
                      </p>
                      {service.data.location.coordinates && (
                        <a 
                          href={`https://www.google.com/maps?q=${service.data.location.coordinates.lat},${service.data.location.coordinates.lng}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center text-xs text-primary-600 hover:text-primary-700 mt-1"
                        >
                          <span>View on map</span>
                          <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                          </svg>
                        </a>
                      )}
                    </div>
              </div>
            )}

            {service.data.contact?.hours && (
                  <div class="flex items-start gap-3 p-3 bg-gray-50 rounded-lg">
                    <div class="p-2 bg-white rounded-lg shadow-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center justify-between gap-4">
                        <h4 class="text-sm font-medium text-gray-900">Operating Hours</h4>
                        {serviceStatus && (
                          <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${
                            serviceStatus === 'open' 
                              ? 'bg-green-100 text-green-800' 
                              : 'bg-red-100 text-red-800'
                          }`}>
                            <span class={`w-2 h-2 mr-1.5 rounded-full ${
                              serviceStatus === 'open'
                                ? 'bg-green-600'
                                : 'bg-red-600'
                            }`}></span>
                            {serviceStatus === 'open' ? 'Open Now' : 'Closed'}
                          </span>
                        )}
                      </div>
                      <div class="mt-2 text-sm text-gray-600">
                        {service.data.contact?.hours ? (
                          <div class="space-y-1">
                            {service.data.contact.hours.split('\n').map((schedule) => (
                              <p>{schedule}</p>
                            ))}
                          </div>
                        ) : (
                          <p class="italic">Hours not specified</p>
                        )}
                      </div>
                    </div>
                  </div>
                )}
              </div>

              {/* Social Media - Compact */}
              {service.data.socialMedia && Object.keys(service.data.socialMedia).length > 0 && (
                <div class="pt-4 border-t border-gray-100">
                  <h4 class="text-sm font-medium text-gray-900 mb-3">Connect</h4>
                  <div class="flex flex-wrap gap-2">
                    {service.data.socialMedia.facebook && (
                      <a href={service.data.socialMedia.facebook} target="_blank" rel="noopener noreferrer" class="p-2 bg-[#1877F2]/10 text-[#1877F2] rounded-lg hover:bg-[#1877F2]/20 transition-colors" title="Facebook">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" /></svg>
                      </a>
                    )}
                    {service.data.socialMedia.twitter && (
                      <a href={service.data.socialMedia.twitter} target="_blank" rel="noopener noreferrer" class="p-2 bg-black/10 text-black rounded-lg hover:bg-black/20 transition-colors" title="X (Twitter)">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
                      </a>
                    )}
                    {service.data.socialMedia.instagram && (
                      <a href={service.data.socialMedia.instagram} target="_blank" rel="noopener noreferrer" class="p-2 bg-[#E4405F]/10 text-[#E4405F] rounded-lg hover:bg-[#E4405F]/20 transition-colors" title="Instagram">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2c5.514 0 10 4.486 10 10s-4.486 10-10 10-10-4.486-10-10 4.486-10 10-10zm0-2c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm0 7.082c1.602 0 1.792.006 2.425.035 1.627.074 2.385.845 2.46 2.459.028.633.034.822.034 2.424s-.006 1.792-.034 2.424c-.075 1.613-.832 2.386-2.46 2.46-.633.028-.822.034-2.425.034-1.602 0-1.792-.006-2.424-.034-1.63-.075-2.385-.849-2.46-2.46-.028-.632-.035-.822-.035-2.424s.007-1.792.035-2.424c.074-1.615.832-2.386 2.46-2.46.632-.029.822-.034 2.424-.034zm0-1.082c-1.63 0-1.833.007-2.474.037-2.18.1-3.39 1.309-3.49 3.489-.029.641-.036.845-.036 2.474 0 1.63.007 1.834.036 2.474.1 2.179 1.31 3.39 3.49 3.489.641.029.844.036 2.474.036 1.63 0 1.834-.007 2.475-.036 2.176-.099 3.391-1.309 3.489-3.489.029-.64.036-.844.036-2.474 0-1.629-.007-1.833-.036-2.474-.098-2.177-1.309-3.39-3.489-3.489-.641-.03-.845-.037-2.475-.037zm0 2.919c-1.701 0-3.081 1.379-3.081 3.081s1.38 3.081 3.081 3.081 3.081-1.379 3.081-3.081c0-1.701-1.38-3.081-3.081-3.081zm0 5.081c-1.105 0-2-.895-2-2 0-1.104.895-2 2-2 1.104 0 2.001.895 2.001 2s-.897 2-2.001 2zm3.202-5.922c-.397 0-.72.322-.72.72 0 .397.322.72.72.72.398 0 .721-.322.721-.72 0-.398-.322-.72-.721-.72z"/></svg>
                      </a>
                    )}
                    {service.data.socialMedia.linkedin && (
                      <a href={service.data.socialMedia.linkedin} target="_blank" rel="noopener noreferrer" class="p-2 bg-[#0A66C2]/10 text-[#0A66C2] rounded-lg hover:bg-[#0A66C2]/20 transition-colors" title="LinkedIn">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
                      </a>
                    )}
                    {service.data.socialMedia.website && (
                      <a href={service.data.socialMedia.website} target="_blank" rel="noopener noreferrer" class="p-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors" title="Website">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                      </a>
                    )}
                  </div>
                </div>
              )}
            </div>
          </div>

        <!-- Content Section -->
          <div class="bg-gray-50 border-t border-gray-100">
            <div class="max-w-3xl mx-auto p-6 sm:p-8">
              <div class="prose prose-lg max-w-none">
                <Content />
              </div>
            </div>
          </div>

          <!-- Footer Actions -->
          <div class="bg-white border-t border-gray-100">
            <div class="max-w-3xl mx-auto p-6 sm:p-8">
              <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
                <a href="/services/update-request" class="text-sm text-gray-600 hover:text-primary-600 transition-colors">
                  Report outdated information →
                </a>
                <a href="/services" class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors text-sm font-medium">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                  Explore More Services
                </a>
              </div>
            </div>
          </div>

        </article>

        <!-- Related Services -->
        {relatedServices.length > 0 && (
          <div class="mt-8">
            <div class="flex items-center justify-between mb-4">
              <div>
                <h3 class="text-2xl font-bold text-gray-900 mb-1">Related Services</h3>
                <p class="text-gray-600">Other services in the {service.data.category} category</p>
              </div>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {relatedServices.map(relatedService => (
                <a
                  href={`/services/${relatedService.id}`}
                  class="group flex flex-col p-4 bg-white rounded-lg hover:bg-primary-50 transition-colors border border-gray-100 hover:border-primary-200 h-full shadow-sm hover:shadow-md"
                >
                  <div class="flex items-center gap-3 mb-3">
                    <div class="w-12 h-12 bg-white rounded-lg p-2 flex-shrink-0 border border-gray-100">
                      <img
                        src={relatedService.data.logo || defaultLogo}
                        alt={`${relatedService.data.title} logo`}
                        class="w-full h-full object-contain"
                      />
                    </div>
                    <h4 class="font-semibold text-gray-900 line-clamp-1 group-hover:text-primary-700 transition-colors">{relatedService.data.title}</h4>
                  </div>
                  <p class="text-sm text-gray-600 line-clamp-3 flex-grow">{relatedService.data.description}</p>
                  <div class="mt-3 text-primary-600 text-sm font-medium flex items-center group-hover:text-primary-700 transition-colors">
                    View details
                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  </main>
</MainLayout>

<script>
  // Copy to clipboard function with toast notification
  function copyToClipboard(text) {
    navigator.clipboard.writeText(text).then(() => {
      // Show success toast
      if (window.showToast) {
        window.showToast('Address copied to clipboard!', 'success');
      }
    }).catch(err => {
      console.error('Failed to copy:', err);
      if (window.showToast) {
        window.showToast('Failed to copy address. Please copy manually.', 'error');
      }
    });
  }

  // Make function globally available
  window.copyToClipboard = copyToClipboard;

  // Wait for the DOM to be fully loaded
  document.addEventListener('DOMContentLoaded', () => {
    const copyLinkBtn = document.getElementById('copyLinkBtn');
    if (copyLinkBtn) {
      copyLinkBtn.addEventListener('click', () => {
        const url = window.location.href;
        navigator.clipboard.writeText(url).then(() => {
          if (window.showToast) {
            window.showToast('Link copied to clipboard!', 'success');
          }
        }).catch(err => {
          console.error('Failed to copy:', err);
          if (window.showToast) {
            window.showToast('Failed to copy link. Please copy manually.', 'error');
          }
        });
      });
    }
  });
</script>