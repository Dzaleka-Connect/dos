---
import MainLayout from '../../layouts/MainLayout.astro';
import CollectionHeader from '../../components/ui/CollectionHeader.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services');
const total = services.length;
const builtOn = new Date();
const builtOnLabel = builtOn.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

const share = (n: number) => (total ? Math.round((n / total) * 100) : 0);
const slugify = (category: string) => category.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');

// Listings use 19 free-text categories, several of them near-duplicates
// ("Cultural" and "Cultural & Arts"). Group them so the table reads as types
// of service, and keep the original categories as links underneath.
const groupFor = (category: string) => {
  const c = category.toLowerCase();
  if (/non-?profit|ngo|charity/.test(c)) return 'Non-profit organisations';
  if (/education|school|literacy|vocational/.test(c)) return 'Education and training';
  if (/health|wellness|healing/.test(c)) return 'Health and wellbeing';
  if (/youth|children/.test(c)) return 'Youth and children';
  if (/community|humanitarian/.test(c)) return 'Community and humanitarian';
  if (/religious|faith/.test(c)) return 'Faith groups';
  if (/entrepreneur|business/.test(c)) return 'Business and enterprise';
  if (/technology|digital|internet|media/.test(c)) return 'Technology and media';
  if (/cultur|arts|heritage/.test(c)) return 'Arts and culture';
  if (/sport|gym|fitness/.test(c)) return 'Sport';
  if (/advocacy/.test(c)) return 'Advocacy';
  return category;
};

const rawCounts = new Map<string, number>();
for (const s of services) rawCounts.set(s.data.category, (rawCounts.get(s.data.category) ?? 0) + 1);

const groups = new Map<string, { count: number; categories: { name: string; count: number }[] }>();
for (const [name, count] of rawCounts) {
  const key = groupFor(name);
  const group = groups.get(key) ?? { count: 0, categories: [] };
  group.count += count;
  group.categories.push({ name, count });
  groups.set(key, group);
}
const byType = [...groups.entries()]
  .map(([name, g]) => ({ name, count: g.count, categories: g.categories.sort((a, b) => b.count - a.count) }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
const topTwoShare = share((byType[0]?.count ?? 0) + (byType[1]?.count ?? 0));

// Where services are based, from the address fields. Map coordinates are not
// used: most listings carry the camp centre as a placeholder.
const placeFor = (s: (typeof services)[number]) => {
  const text = `${s.data.location?.city ?? ''} ${s.data.location?.address ?? ''}`.toLowerCase();
  if (!text.trim()) return 'No location given';
  if (/dzaleka|dowa/.test(text)) return 'Dzaleka and Dowa';
  if (/lilongwe/.test(text)) return 'Lilongwe';
  if (/malawi/.test(text)) return 'Elsewhere in Malawi';
  return 'Outside Malawi';
};
const placeOrder = ['Dzaleka and Dowa', 'Lilongwe', 'Elsewhere in Malawi', 'Outside Malawi', 'No location given'];
const byPlace = placeOrder
  .map((name) => ({ name, count: services.filter((s) => placeFor(s) === name).length }))
  .filter((row) => row.count > 0);
const inCamp = byPlace.find((row) => row.name === 'Dzaleka and Dowa')?.count ?? 0;

const campCentre = { lat: -13.6628274, lng: 33.8704301 };
const atCampCentre = services.filter((s) => {
  const c = s.data.location?.coordinates;
  return c && c.lat === campCentre.lat && c.lng === campCentre.lng;
}).length;
const noCoordinates = services.filter((s) => !s.data.location?.coordinates).length;
const ownCoordinates = total - atCampCentre - noCoordinates;

// How people can get in touch.
const has = (test: (s: (typeof services)[number]) => unknown) => services.filter((s) => Boolean(test(s))).length;
const contactRows = [
  { name: 'Phone number', count: has((s) => s.data.contact?.phone) },
  { name: 'Email address', count: has((s) => s.data.contact?.email) },
  { name: 'Website', count: has((s) => s.data.socialMedia?.website) },
  { name: 'Opening hours', count: has((s) => s.data.businessHours?.length || s.data.contact?.hours) },
  { name: 'WhatsApp', count: has((s) => s.data.contact?.whatsapp) },
];
const noContact = has((s) => !s.data.contact?.phone && !s.data.contact?.email && !s.data.contact?.whatsapp);
const reachable = total - noContact;

// How recently each listing was checked.
const dayMs = 24 * 60 * 60 * 1000;
const ageBand = (s: (typeof services)[number]) => {
  if (!s.data.lastUpdated) return 'No date recorded';
  const days = (builtOn.getTime() - s.data.lastUpdated.getTime()) / dayMs;
  if (days <= 365) return 'In the past 12 months';
  if (days <= 730) return '1 to 2 years ago';
  return 'More than 2 years ago';
};
const byAge = ['In the past 12 months', '1 to 2 years ago', 'More than 2 years ago', 'No date recorded']
  .map((name) => ({ name, count: services.filter((s) => ageBand(s) === name).length }))
  .filter((row) => row.count > 0);
const checkedThisYear = byAge.find((row) => row.name === 'In the past 12 months')?.count ?? 0;

const verified = has((s) => s.data.verified);
const inactive = has((s) => s.data.status === 'inactive');

const keyFigures = [
  { value: total, label: 'Services listed', note: inactive ? `${inactive} marked inactive` : 'all marked active' },
  { value: verified, label: 'Verified listings', note: `${share(verified)}% of listings` },
  { value: reachable, label: 'Have a phone, email or WhatsApp', note: `${share(reachable)}% of listings` },
  { value: checkedThisYear, label: 'Checked in the past 12 months', note: `${share(checkedThisYear)}% of listings` },
];

const sections = [
  { id: 'type', title: 'Types of service' },
  { id: 'location', title: 'Where services are based' },
  { id: 'contact', title: 'How to contact them' },
  { id: 'updated', title: 'How up to date the listings are' },
  { id: 'about', title: 'About this data' },
];

const description = `Figures for the ${total} services listed in the Dzaleka services directory: types of service, location, contact details and when listings were last checked.`;
---

<MainLayout
  title="Services directory statistics"
  description={description}
  type="website"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: 'Dzaleka services directory statistics',
      description,
      url: 'https://services.dzaleka.com/services/stats',
      dateModified: builtOn.toISOString().slice(0, 10),
      distribution: {
        '@type': 'DataDownload',
        encodingFormat: 'application/json',
        contentUrl: 'https://services.dzaleka.com/api/services',
      },
    })}
  />

  <CollectionHeader
    title="Services directory statistics"
    description={`What the directory covers and how complete it is. Figures for all ${total} listings, counted on ${builtOnLabel}.`}
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Services', href: '/services' }, { label: 'Statistics' }]}
    action={{ label: 'Browse services', href: '/services' }}
  />

  <div class="bg-white">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <!-- Key figures -->
      <section aria-labelledby="key-figures">
        <h2 id="key-figures" class="sr-only">Key figures</h2>
        <dl class="grid grid-cols-2 border-l border-t border-slate-200 lg:grid-cols-4">
          {keyFigures.map((figure) => (
            <div class="border-b border-r border-slate-200 p-5 sm:p-6">
              <dt class="text-sm text-slate-600">{figure.label}</dt>
              <dd class="mt-2 text-4xl font-semibold tracking-tight text-slate-900 tabular-nums">{figure.value}</dd>
              <dd class="mt-1 text-sm text-slate-500">{figure.note}</dd>
            </div>
          ))}
        </dl>
      </section>

      <div class="mt-12 grid gap-12 lg:grid-cols-[220px_minmax(0,1fr)]">
        <!-- Contents -->
        <nav aria-label="Contents" class="lg:sticky lg:top-28 lg:self-start">
          <p class="text-sm font-semibold uppercase tracking-widest text-slate-500">Contents</p>
          <ol class="mt-3 space-y-2 border-l border-slate-200 text-sm">
            {sections.map((section) => (
              <li><a href={`#${section.id}`} class="-ml-px block border-l border-transparent pl-4 text-slate-700 hover:border-slate-900 hover:text-slate-900">{section.title}</a></li>
            ))}
          </ol>
        </nav>

        <div class="min-w-0 max-w-3xl space-y-14">
          <!-- Types of service -->
          <section id="type" class="scroll-mt-28" aria-labelledby="type-title">
            <h2 id="type-title" class="text-2xl font-semibold text-slate-900">Types of service</h2>
            <p class="mt-3 text-lg text-slate-700">
              {byType[0]?.name} and {byType[1]?.name.toLowerCase()} make up {topTwoShare}% of listings.
            </p>
            <table class="stat-table mt-6">
              <caption class="sr-only">Listings by type of service</caption>
              <thead><tr><th scope="col">Type</th><th scope="col">Listings</th><th scope="col">Share</th></tr></thead>
              <tbody>
                {byType.map((row) => (
                  <tr>
                    <th scope="row">
                      <span class="block">{row.name}</span>
                      <span class="bar" aria-hidden="true"><span style={`width: ${share(row.count)}%`}></span></span>
                      {row.categories.length > 1 && (
                        <span class="mt-2 block text-sm font-normal text-slate-500">
                          Listed as{' '}
                          {row.categories.map((c, i) => (
                            <>{i > 0 && ', '}<a href={`/services/category/${slugify(c.name)}`} class="underline hover:text-slate-900">{c.name}</a> ({c.count})</>
                          ))}
                        </span>
                      )}
                      {row.categories.length === 1 && (
                        <a href={`/services/category/${slugify(row.categories[0].name)}`} class="mt-2 inline-block text-sm font-normal text-slate-500 underline hover:text-slate-900">View listings</a>
                      )}
                    </th>
                    <td>{row.count}</td>
                    <td>{share(row.count)}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>

          <!-- Location -->
          <section id="location" class="scroll-mt-28" aria-labelledby="location-title">
            <h2 id="location-title" class="text-2xl font-semibold text-slate-900">Where services are based</h2>
            <p class="mt-3 text-lg text-slate-700">
              {inCamp} of {total} listed services are based in Dzaleka or elsewhere in Dowa District.
            </p>
            <table class="stat-table mt-6">
              <caption class="sr-only">Listings by location</caption>
              <thead><tr><th scope="col">Location</th><th scope="col">Listings</th><th scope="col">Share</th></tr></thead>
              <tbody>
                {byPlace.map((row) => (
                  <tr>
                    <th scope="row">
                      <span class="block">{row.name}</span>
                      <span class="bar" aria-hidden="true"><span style={`width: ${share(row.count)}%`}></span></span>
                    </th>
                    <td>{row.count}</td>
                    <td>{share(row.count)}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="mt-4 text-sm text-slate-600">
              Location comes from each listing's address. Only {ownCoordinates} listings have their own map position. {atCampCentre} are placed at the centre of the camp and {noCoordinates} have no map position.
            </p>
          </section>

          <!-- Contact -->
          <section id="contact" class="scroll-mt-28" aria-labelledby="contact-title">
            <h2 id="contact-title" class="text-2xl font-semibold text-slate-900">How to contact them</h2>
            <p class="mt-3 text-lg text-slate-700">
              {noContact} listings have no phone number, email address or WhatsApp.
            </p>
            <table class="stat-table mt-6">
              <caption class="sr-only">Listings with each type of contact detail</caption>
              <thead><tr><th scope="col">Listing includes</th><th scope="col">Listings</th><th scope="col">Share</th></tr></thead>
              <tbody>
                {contactRows.map((row) => (
                  <tr>
                    <th scope="row">
                      <span class="block">{row.name}</span>
                      <span class="bar" aria-hidden="true"><span style={`width: ${share(row.count)}%`}></span></span>
                    </th>
                    <td>{row.count}</td>
                    <td>{share(row.count)}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>

          <!-- Freshness -->
          <section id="updated" class="scroll-mt-28" aria-labelledby="updated-title">
            <h2 id="updated-title" class="text-2xl font-semibold text-slate-900">How up to date the listings are</h2>
            <p class="mt-3 text-lg text-slate-700">
              {checkedThisYear} of {total} listings were checked in the past 12 months.
            </p>
            <table class="stat-table mt-6">
              <caption class="sr-only">Listings by when they were last checked</caption>
              <thead><tr><th scope="col">Last checked</th><th scope="col">Listings</th><th scope="col">Share</th></tr></thead>
              <tbody>
                {byAge.map((row) => (
                  <tr>
                    <th scope="row">
                      <span class="block">{row.name}</span>
                      <span class="bar" aria-hidden="true"><span style={`width: ${share(row.count)}%`}></span></span>
                    </th>
                    <td>{row.count}</td>
                    <td>{share(row.count)}%</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <div class="mt-6 border-l-4 border-slate-900 bg-slate-50 p-5">
              <p class="font-semibold text-slate-900">Know a listing that is out of date?</p>
              <p class="mt-1 text-slate-700">
                Open the service's page and use <span class="font-medium">Suggest an update to this listing</span>, or <a href="/services/register" class="underline hover:text-slate-900">register a service</a> that is missing.
              </p>
            </div>
          </section>

          <!-- About this data -->
          <section id="about" class="scroll-mt-28" aria-labelledby="about-title">
            <h2 id="about-title" class="text-2xl font-semibold text-slate-900">About this data</h2>
            <ul class="mt-4 list-disc space-y-3 pl-5 text-slate-700">
              <li>Figures are counted from the directory's listings each time the site is published. These were counted on {builtOnLabel}.</li>
              <li>Types of service group the {rawCounts.size} categories that listings use. The categories each type contains are shown under it.</li>
              <li>"Checked" uses the date a listing was last updated. A listing can be correct and still have an old date.</li>
              <li>Percentages are rounded, so they may not add up to 100.</li>
            </ul>
            <p class="mt-6 text-slate-700">
              The full list is available as JSON from the <a href="/api/services" class="underline hover:text-slate-900">services API</a>.
              See the <a href="/api-docs" class="underline hover:text-slate-900">API documentation</a> for fields and filters.
            </p>
          </section>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .stat-table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .stat-table thead th {
    padding: 0 0 0.75rem;
    border-bottom: 2px solid #0f172a;
    text-align: left;
    font-size: 0.875rem;
    font-weight: 600;
    color: #334155;
  }
  .stat-table tbody th,
  .stat-table tbody td {
    padding: 1rem 0;
    border-bottom: 1px solid #e2e8f0;
    vertical-align: top;
  }
  .stat-table tbody th {
    text-align: left;
    font-weight: 500;
    color: #0f172a;
  }
  .stat-table th:not(:first-child),
  .stat-table td {
    width: 4rem;
    text-align: right;
    color: #334155;
  }
  .stat-table .bar {
    display: block;
    margin-top: 0.5rem;
    height: 0.5rem;
    max-width: 24rem;
    border-radius: 2px;
    background: #f1f5f9;
  }
  @media (min-width: 640px) {
    .stat-table th:not(:first-child),
    .stat-table td {
      width: 5.5rem;
    }
  }
  .stat-table .bar > span {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: #0369a1;
  }
</style>
