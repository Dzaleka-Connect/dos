            </svg>
          </div>
          <div class="text-2xl font-bold text-gray-900">{socialMediaStats.instagram}</div>
          <div class="text-sm text-gray-600">Instagram</div>
        </div>

        <div class="bg-white rounded border border-gray-100 p-6 text-center">
          <div class="w-12 h-12 bg-blue-700 rounded flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <div class="text-2xl font-bold text-gray-900">{socialMediaStats.linkedin}</div>
          <div class="text-sm text-gray-600">LinkedIn</div>
        </div>
      </div>
    </div>

    <!-- Growth & Trends Analysis -->
    <div class="mb-12">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Growth & trends analysis</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          See how our community services have grown over time. This shows you when new services were added and helps you understand how the support available in Dzaleka has expanded to meet community needs.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-2">
        <!-- Growth Chart -->
        <div class="bg-white rounded border border-gray-100 p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-6">Growth Trends</h3>
          <div class="h-80">
            <canvas id="growthChart"></canvas>
          </div>
        </div>

        <!-- Growth Overview -->
        <div class="bg-white rounded border border-gray-100 p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Growth Overview</h3>
          <div class="space-y-4">
            <div class="flex items-center justify-between p-4 bg-green-50 rounded">
              <div>
                <div class="text-sm text-gray-600">This Year ({currentYear})</div>
                <div class="text-2xl font-bold text-green-600">{thisYearCount} services</div>
              </div>
              <div class="text-right">
                <div class="text-sm text-gray-600">Growth Rate</div>
                <div class={`text-lg font-semibold ${growthRate >= 0 ? 'text-green-600' : 'text-red-600'}`}>
                  {growthRate >= 0 ? '+' : ''}{Math.round(growthRate)}%
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between p-4 bg-blue-50 rounded">
              <div>
                <div class="text-sm text-gray-600">Last 3 Months</div>
                <div class="text-2xl font-bold text-blue-600">{recentGrowth} services</div>
              </div>
              <div class="text-right">
                <div class="text-sm text-gray-600">Recent Activity</div>
                <div class="text-lg font-semibold text-blue-600">
                  {Math.round((recentGrowth / serviceStats.total) * 100)}%
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Service Quality Metrics -->
    <div class="mb-12">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Service quality metrics</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Find the most reliable and well-organized services. This scoring system helps you identify which organizations have complete information and are most likely to be able to help you effectively.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-2">
        <!-- Quality Chart -->
        <div class="bg-white rounded border border-gray-100 p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-6">Quality Distribution Chart</h3>
          <div class="h-80">
            <canvas id="qualityChart"></canvas>
          </div>
        </div>

        <!-- Quality Overview -->
        <div class="bg-white rounded border border-gray-100 p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Quality Overview</h3>
          <div class="space-y-4">
            <div class="flex items-center justify-between p-4 bg-purple-50 rounded">
              <div>
                <div class="text-sm text-gray-600">Average Quality Score</div>
                <div class="text-3xl font-bold text-purple-600">{averageQualityScore}%</div>
              </div>
              <div class="text-right">
                <div class="text-sm text-gray-600">Overall Rating</div>
                <div class="text-lg font-semibold text-purple-600">
                  {averageQualityScore >= 90 ? 'Excellent' : averageQualityScore >= 70 ? 'Good' : averageQualityScore >= 50 ? 'Fair' : 'Poor'}
                </div>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div class="p-4 bg-green-50 rounded text-center">
                <div class="text-2xl font-bold text-green-600">{completeServices}</div>
                <div class="text-sm text-gray-600">Complete Profiles</div>
              </div>
              <div class="p-4 bg-orange-50 rounded text-center">
                <div class="text-2xl font-bold text-orange-600">{incompleteServices}</div>
                <div class="text-sm text-gray-600">Incomplete Profiles</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Digital Presence Metrics -->
    <div class="mb-12">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Digital Presence Metrics</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          See which services are active online and easy to reach through social media or websites. This helps you find organizations that are digitally connected and can provide information and support through online platforms.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-2">
        <!-- Digital Maturity Chart -->
        <div class="bg-white rounded border border-gray-100 p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-6">Digital Presence Radar</h3>
          <div class="h-80">
            <canvas id="digitalChart"></canvas>
          </div>
        </div>

        <!-- Digital Overview -->
        <div class="bg-white rounded border border-gray-100 p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Digital Maturity</h3>
          <div class="space-y-4">
            <div class="flex items-center justify-between p-4 bg-indigo-50 rounded">
              <div>
                <div class="text-sm text-gray-600">Average Digital Score</div>
                <div class="text-3xl font-bold text-indigo-600">{averageDigitalScore}%</div>
              </div>
              <div class="text-right">
                <div class="text-sm text-gray-600">Technology Adoption</div>
                <div class="text-lg font-semibold text-indigo-600">
                  {averageDigitalScore >= 80 ? 'Advanced' : averageDigitalScore >= 50 ? 'Intermediate' : averageDigitalScore >= 20 ? 'Basic' : 'Minimal'}
                </div>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div class="p-4 bg-green-50 rounded text-center">
                <div class="text-2xl font-bold text-green-600">{digitalMaturity.advanced}</div>
                <div class="text-sm text-gray-600">Advanced</div>
              </div>
              <div class="p-4 bg-blue-50 rounded text-center">
                <div class="text-2xl font-bold text-blue-600">{digitalMaturity.intermediate}</div>
                <div class="text-sm text-gray-600">Intermediate</div>
              </div>
              <div class="p-4 bg-yellow-50 rounded text-center">
                <div class="text-2xl font-bold text-yellow-600">{digitalMaturity.basic}</div>
                <div class="text-sm text-gray-600">Basic</div>
              </div>
              <div class="p-4 bg-red-50 rounded text-center">
                <div class="text-2xl font-bold text-red-600">{digitalMaturity.minimal}</div>
                <div class="text-sm text-gray-600">Minimal</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Geographic & Accessibility Analysis -->
    <div class="mb-12">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Geographic & Accessibility Analysis</h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Find out which services are closest to you and easiest to reach. This helps you understand the accessibility of different types of support in your area and plan the best way to get the help you need.
        </p>
      </div>

      <div class="grid gap-8 lg:grid-cols-2">
        <!-- Distance Distribution Chart -->
        <div class="bg-white rounded border border-gray-100 p-6">
          <h3 class="text-xl font-semibold text-gray-900 mb-6">Distance Distribution</h3>
          <div class="h-80">
            <canvas id="distanceChart"></canvas>
          </div>
        </div>

        <!-- Distance Analysis -->
        <div class="bg-white rounded border border-gray-100 p-6">
