---
import MainLayout from '../../layouts/MainLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ServicePagination from '../../components/services/ServicePagination.astro';
import { getCollection } from 'astro:content';
import { sortServices } from '../../utils/serviceHelpers';
import { calculateServiceStats } from '../../utils/serviceStats';

// Get all services
const allServices = await getCollection('services');

// Calculate service stats
const serviceStats = calculateServiceStats(allServices);

// Get URL parameters
const sortBy = Astro.url.searchParams.get('sort') || 'featured';
const verifiedOnly = Astro.url.searchParams.get('verified') === 'true';
const page = Astro.url.searchParams.get('page');

// If page query parameter is present and not 1, redirect to path-based pagination
if (page && page !== '1') {
  const searchParams = new URLSearchParams();
  if (sortBy !== 'featured') searchParams.set('sort', sortBy);
  if (verifiedOnly) searchParams.set('verified', 'true');
  const queryString = searchParams.toString();
  const redirectUrl = `/services/${page}${queryString ? `?${queryString}` : ''}`;
  return Astro.redirect(redirectUrl);
}

// Apply verified filter
let filteredServices = allServices;
if (verifiedOnly) {
  filteredServices = filteredServices.filter(service => service.data.verified);
}

// Sort services
const sortedServices = sortServices(filteredServices, sortBy);

// Pagination
const itemsPerPage = 6;
const totalItems = sortedServices.length;
const totalPages = Math.ceil(totalItems / itemsPerPage);
const currentPage = 1;
const startIndex = 0;
const endIndex = Math.min(itemsPerPage, totalItems);
const paginatedServices = sortedServices.slice(startIndex, endIndex);

// Preserve query parameters for pagination links
const searchParams = new URLSearchParams();
if (sortBy !== 'featured') searchParams.set('sort', sortBy);
if (verifiedOnly) searchParams.set('verified', 'true');
const queryString = searchParams.toString();
const baseUrl = `/services${queryString ? `?${queryString}` : ''}`;

// Group services by category
const servicesByCategory = allServices.reduce((acc, service) => {
  const category = service.data.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(service);
  return acc;
}, {});

// Sort categories alphabetically
const sortedCategories = Object.keys(servicesByCategory).sort();

// SEO metadata
const seo = {
  title: 'Services Directory - Dzaleka Online Services',
  description: 'Connect with 100+ verified organizations providing healthcare, education, legal support, and business services in Dzaleka Refugee Camp. Find trusted local services from healthcare clinics to educational programs and community support.',
  image: '/images/services-directory.jpg',
  keywords: [
    'Dzaleka Services',
    'Refugee Services',
    'Service Directory',
    'Malawi Refugee Services'
  ].filter(Boolean).join(', '),
  type: 'website'
};

---

<script type="application/ld+json">
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Dzaleka Services Directory",
    "description": "A carousel of verified services and organizations in Dzaleka Refugee Camp.",
    "itemListElement": paginatedServices.map((service, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "url": `https://services.dzaleka.com/services/${service.slug}`,
      "name": service.data.title
    }))
  })}
</script>

<MainLayout 
  title={seo.title}
  description={seo.description}
  image={seo.image}
  type={seo.type}
  keywords={seo.keywords}
>
  <!-- Hero Section -->
  <div class="relative overflow-hidden px-4 py-12 sm:py-16">
    <!-- Hero Image Background -->
    <div class="absolute inset-0">
      <img 
        src="/images/dzaleka-hero.jpeg" 
        alt="Dzaleka Community" 
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-primary-600/80 to-primary-800/80"></div>
    </div>
    
    <!-- Hero Content -->
    <div class="relative z-10 max-w-4xl mx-auto text-center">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">Discover Local Services</h1>
      <p class="text-base sm:text-lg lg:text-xl text-white/90 mb-6 sm:mb-8 max-w-2xl mx-auto px-4">
        Find and connect with 100+ verified organizations providing healthcare, education, legal support, and business services in Dzaleka Refugee Camp
      </p>
      
      <!-- Search and Filter Row -->
      <div class="max-w-2xl mx-auto mb-6 sm:mb-8 px-4">
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
          <!-- Search Bar -->
          <div class="flex-1">
            <div class="relative">
              <input
                type="text"
                id="serviceSearch"
                placeholder="Search services..."
                class="w-full px-4 py-3 pl-12 rounded-lg border-0 text-gray-900 placeholder-gray-500 focus:ring-2 focus:ring-white/50 focus:outline-none text-base shadow-lg"
              />
              <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
          </div>
          
          <!-- Category Filter -->
          <div class="w-full sm:w-48">
            <select
              id="categoryFilter"
              class="w-full px-4 py-3 rounded-lg border-0 text-gray-900 bg-white/95 backdrop-blur-sm focus:ring-2 focus:ring-white/50 focus:outline-none text-base shadow-lg"
            >
              <option value="all">All Categories</option>
              {sortedCategories.map(category => (
                <option value={category}>{category}</option>
              ))}
            </select>
          </div>
        </div>
      </div>
      
      <a 
        href="/services/register" 
        class="inline-flex items-center px-4 sm:px-6 py-3 border border-transparent rounded-lg shadow-lg text-sm sm:text-base font-medium text-primary-600 bg-white hover:bg-primary-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-all duration-200 hover:scale-105"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
        </svg>
        Register Your Service
      </a>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 py-8 sm:py-12">
    <!-- Results Header -->
    <div class="mb-6 sm:mb-8">
      <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center space-y-4 lg:space-y-0">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2">
            {totalItems} Services Available
          </h2>
          <p class="text-sm sm:text-base text-gray-600">
            Showing {startIndex + 1}-{endIndex} of {totalItems} services
          </p>
        </div>

        <!-- Advanced Filters -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-3 sm:gap-4 w-full lg:w-auto">
          <label class="flex items-center">
            <input 
              type="checkbox" 
              id="verifiedFilter"
              checked={verifiedOnly}
              class="h-4 w-4 text-primary-600 rounded border-gray-300 focus:ring-primary-500"
            />
            <span class="ml-2 text-sm text-gray-700">Verified Only</span>
          </label>
          
          <select 
            id="sortFilter"
            class="w-full sm:w-auto px-3 py-2 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
          >
            <option value="featured" selected={sortBy === 'featured'}>Featured First</option>
            <option value="name" selected={sortBy === 'name'}>Name (A-Z)</option>
            <option value="newest" selected={sortBy === 'newest'}>Recently Updated</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Services Grid -->
    <div class="grid gap-4 sm:gap-6 md:grid-cols-2 lg:grid-cols-3" id="services-grid">
      {paginatedServices.map(service => {
        // Extract all social media data
        const socialMedia = service.data.socialMedia ? {
          ...(service.data.socialMedia.facebook && { facebook: service.data.socialMedia.facebook }),
          ...(service.data.socialMedia.twitter && { twitter: service.data.socialMedia.twitter }),
          ...(service.data.socialMedia.instagram && { instagram: service.data.socialMedia.instagram }),
          ...(service.data.socialMedia.linkedin && { linkedin: service.data.socialMedia.linkedin }),
          ...(service.data.socialMedia.website && { website: service.data.socialMedia.website })
        } : undefined;

        return (
          <div class="service-card" data-category={service.data.category} data-title={service.data.title.toLowerCase()}>
            <ServiceCard 
              title={service.data.title}
              description={service.data.description}
              category={service.data.category}
              featured={service.data.featured}
              verified={service.data.verified}
              href={`/services/${service.slug}`}
              email={service.data.contact?.email}
              phone={service.data.contact?.phone}
              address={service.data.location?.address}
              logo={service.data.logo}
              socialMedia={socialMedia}
            />
          </div>
        );
      })}
    </div>

    <!-- No Results Message -->
    <div id="no-results" class="text-center py-16 hidden">
      <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gray-100 flex items-center justify-center">
        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.47-.881-6.08-2.33" />
        </svg>
      </div>
      <h3 class="text-lg font-medium text-gray-900 mb-2">No services found</h3>
      <p class="text-gray-600">
        No services match your search criteria. Please try different keywords or filters.
      </p>
    </div>

    <!-- Pagination -->
    <div class="mt-8">
      <ServicePagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl={baseUrl}
      />
    </div>

    <!-- Explore by Category Section -->
    <div class="mt-12">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Browse by Category</h2>
      <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        {sortedCategories.map(category => {
          const categoryServices = allServices.filter(service => service.data.category === category);
          const categorySlug = category.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
          
          // Get category icon
          const getCategoryIcon = (cat) => {
            const icons = {
              'Education': 'M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z',
              'Health': 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
              'Non-profit Organizations': 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
              'Advocacy': 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
              'Humanitarian Aid': 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
              'Entrepreneurship': 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1',
              'Youth': 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
              'Cultural': 'M7 4V2a1 1 0 011-1h4a1 1 0 011 1v2m4 0V2a1 1 0 011-1h1a2 2 0 012 2v16a2 2 0 01-2 2H5a2 2 0 01-2-2V3a2 2 0 012-2h1a1 1 0 011 1v2m-4 0h10'
            };
            return icons[cat] || 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10';
          };
          
          return (
            <a 
              href={`/services/category/${categorySlug}`}
              class="group bg-white rounded-lg p-4 border border-gray-200 hover:border-primary-300 hover:shadow-sm transition-all duration-200"
            >
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 bg-primary-100 rounded-lg flex items-center justify-center group-hover:bg-primary-200 transition-colors">
                    <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getCategoryIcon(category)} />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-medium text-gray-900 group-hover:text-primary-600 transition-colors">
                      {category}
                    </h3>
                    <p class="text-sm text-gray-500">{categoryServices.length} services</p>
                  </div>
                </div>
                <svg class="w-4 h-4 text-gray-400 group-hover:text-primary-500 group-hover:translate-x-1 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>



    <!-- Important Information Section -->
    <div class="mt-16 bg-gray-50 rounded-xl p-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Service Directory Information</h2>
        
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          <!-- Service Quality -->
          <div class="text-center">
            <div class="w-12 h-12 mx-auto mb-4 bg-primary-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Quality Assurance</h3>
            <p class="text-sm text-gray-600">
              All services undergo review to ensure they meet our quality standards and are actively serving the community.
            </p>
          </div>

          <!-- Community Impact -->
          <div class="text-center">
            <div class="w-12 h-12 mx-auto mb-4 bg-primary-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Community Impact</h3>
            <p class="text-sm text-gray-600">
              These services directly support the Dzaleka community, providing essential resources and opportunities.
            </p>
          </div>

          <!-- Regular Updates -->
          <div class="text-center">
            <div class="w-12 h-12 mx-auto mb-4 bg-primary-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Stay Updated</h3>
            <p class="text-sm text-gray-600">
              New services are added regularly. Check back often to discover new opportunities and resources.
            </p>
          </div>
        </div>

        <!-- Call to Action -->
        <div class="mt-8 text-center">
          <div class="bg-white rounded-lg p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Join Our Service Directory</h3>
            <p class="text-gray-600 mb-4">
              Are you providing services in Dzaleka? Register your organization to reach more community members.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 justify-center">
              <a href="/services/register" class="inline-flex items-center px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                Register Your Service
              </a>
              <a href="/contact" class="inline-flex items-center px-4 py-2 border border-primary-600 text-primary-600 rounded-lg hover:bg-primary-50 transition-colors">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
                Contact Us
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const verifiedFilter = document.getElementById('verifiedFilter');
    const sortFilter = document.getElementById('sortFilter');
    const serviceSearch = document.getElementById('serviceSearch');
    const categoryFilter = document.getElementById('categoryFilter');
    const serviceCards = document.querySelectorAll('.service-card');
    const noResults = document.getElementById('no-results');
    const servicesGrid = document.getElementById('services-grid');
    
    let activeCategory = 'all';
    let searchTerm = '';
    
    function filterServices() {
      let visibleCount = 0;
      
      serviceCards.forEach(card => {
        const category = card.dataset.category;
        const title = card.dataset.title;
        
        const matchesCategory = activeCategory === 'all' || category === activeCategory;
        const matchesSearch = !searchTerm || title.includes(searchTerm.toLowerCase());
        
        if (matchesCategory && matchesSearch) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });
      
      // Show/hide no results message
      if (noResults && servicesGrid) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
          servicesGrid.classList.add('hidden');
        } else {
          noResults.classList.add('hidden');
          servicesGrid.classList.remove('hidden');
        }
      }
    }
    
    function updateFilters() {
      const url = new URL(window.location.href);
      
      // Update verified filter
      if (verifiedFilter.checked) {
        url.searchParams.set('verified', 'true');
      } else {
        url.searchParams.delete('verified');
      }
      
      // Update sort filter
      if (sortFilter.value !== 'featured') {
        url.searchParams.set('sort', sortFilter.value);
      } else {
        url.searchParams.delete('sort');
      }
      
      // Navigate to the new URL
      window.location.href = url.toString();
    }
    
    // Search functionality
    serviceSearch?.addEventListener('input', (e) => {
      searchTerm = e.target.value;
      filterServices();
    });
    
    // Category filter functionality
    categoryFilter?.addEventListener('change', (e) => {
      activeCategory = e.target.value;
      filterServices();
    });
    
    // Advanced filters
    verifiedFilter?.addEventListener('change', updateFilters);
    sortFilter?.addEventListener('change', updateFilters);
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>