---
import MainLayout from '../../layouts/MainLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ServicePagination from '../../components/services/ServicePagination.astro';
import Button from '../../components/ui/Button.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { sortServices } from '../../utils/serviceHelpers';
import { calculateServiceStats } from '../../utils/serviceStats';

// Get all services
const allServices = await getCollection('services');

// Calculate service stats
const serviceStats = calculateServiceStats(allServices);

// Sort services
const sortedServices = sortServices(allServices, 'featured');

// Pagination
const itemsPerPage = 6;
const totalItems = sortedServices.length;
const totalPages = Math.ceil(totalItems / itemsPerPage);
const currentPage = 1;
const startIndex = 0;
const endIndex = Math.min(itemsPerPage, totalItems);
const paginatedServices = sortedServices.slice(startIndex, endIndex);

// Preserve query parameters for pagination links
const baseUrl = '/services';

// Group services by category
const servicesByCategory = allServices.reduce((acc, service) => {
  const category = service.data.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(service);
  return acc;
}, {});

// Sort categories alphabetically
const sortedCategories = Object.keys(servicesByCategory).sort();

// SEO metadata
const seo = {
  title: 'Find Services in Dzaleka - Dzaleka Online Services',
  description: 'Search organizations, clinics, schools, community groups, businesses, and support programs working in and around Dzaleka Refugee Camp.',
  image: '/images/services-directory.jpg',
  keywords: [
    'Dzaleka Services',
    'Refugee Services',
    'Service Directory',
    'Malawi Refugee Services'
  ].filter(Boolean).join(', '),
  type: 'website'
};

---

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Dzaleka Services Directory",
    "description": "A searchable list of services and organizations in Dzaleka Refugee Camp.",
    "itemListElement": paginatedServices.map((service, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "url": `https://services.dzaleka.com/services/${service.id}`,
      "name": service.data.title
    }))
  })}
/>

<MainLayout
  title={seo.title}
  description={seo.description}
  image={seo.image}
  type={seo.type}
  keywords={seo.keywords}
>
  <!-- Hero Section -->
  <div class="relative border-b border-gray-200 overflow-hidden bg-slate-50">


    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      <div class="max-w-3xl">
        <div class="mb-2">
          <Breadcrumb
            items={[
              { label: 'Home', href: '/' },
              { label: 'Services' }
            ]}
            light={false}
          />
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold text-primary-900 mb-3">
          Find a service in Dzaleka
        </h1>
        <p class="text-sm text-slate-600 mb-6 leading-6">
          Search {totalItems} organization and service listings, then use category pages to narrow by need.
        </p>

        <!-- Search and Filter Row -->
        <div class="mb-5 max-w-2xl text-left">
          <div class="flex flex-col sm:flex-row gap-2">
            <!-- Search Bar -->
            <div class="flex-1 relative">
              <input
                type="text"
                id="serviceSearch" aria-label="Search services"
                placeholder="Search by name or keyword..."
                class="w-full px-4 py-3 pl-11 rounded border border-slate-400 text-gray-900 placeholder-gray-500 focus:ring-2 focus:ring-primary-500 focus:outline-none transition-colors"
              />
              <svg class="absolute left-3.5 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <button
                type="button"
                id="clearSearch"
                class="min-h-[44px] hidden absolute right-3 top-1/2 -translate-y-1/2 p-1 text-gray-400 hover:text-gray-600 rounded transition-colors"
                aria-label="Clear search"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <!-- Category Filter -->
            <div class="w-full sm:w-48">
              <select
                id="categoryFilter" aria-label="Filter by category"
                class="w-full px-4 py-3 rounded border border-slate-400 text-gray-900 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-primary-500 focus:outline-none transition-colors cursor-pointer"
              >
                <option value="all">All Categories</option>
                {sortedCategories.map(category => (
                  <option value={category}>{category}</option>
                ))}
              </select>
            </div>
          </div>
        </div>

        <a
          href="/services/register"
          class="min-h-[44px] inline-flex items-center px-6 py-3 border border-gray-300 text-sm font-medium rounded text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-200 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
          </svg>
          Register your service
        </a>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Results Header -->
    <div class="mb-6 sm:mb-8">
      <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center space-y-4 lg:space-y-0">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-2">
            Service listings
          </h2>
          <p class="text-sm sm:text-base text-gray-600">
            Showing {startIndex + 1}-{endIndex} of {totalItems}, with featured and recently updated listings first.
          </p>
        </div>

        <!-- Advanced Filters -->
      </div>
    </div>

    <!-- Services Grid -->
    <div class="grid gap-4 sm:gap-6 md:grid-cols-2 lg:grid-cols-3" id="services-grid">
      {paginatedServices.map(service => {
        // Extract all social media data
        const socialMedia = service.data.socialMedia ? {
          ...(service.data.socialMedia.facebook && { facebook: service.data.socialMedia.facebook }),
          ...(service.data.socialMedia.twitter && { twitter: service.data.socialMedia.twitter }),
          ...(service.data.socialMedia.instagram && { instagram: service.data.socialMedia.instagram }),
          ...(service.data.socialMedia.linkedin && { linkedin: service.data.socialMedia.linkedin }),
          ...(service.data.socialMedia.website && { website: service.data.socialMedia.website })
        } : undefined;

        return (
          <div class="service-card" data-category={service.data.category} data-title={service.data.title.toLowerCase()}>
            <ServiceCard
              title={service.data.title}
              description={service.data.description}
              category={service.data.category}
              featured={service.data.featured}
              verified={service.data.verified}
              href={`/services/${service.id}`}
              email={service.data.contact?.email}
              phone={service.data.contact?.phone}
              address={service.data.location?.address}
              logo={service.data.logo}
              hours={service.data.contact?.hours}
              location={service.data.location}
              socialMedia={socialMedia}
            />
          </div>
        );
      })}
    </div>

    <!-- No Results Message -->
    <div id="no-results" class="text-center py-16 hidden">
      <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gray-100 flex items-center justify-center">
        <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.47-.881-6.08-2.33" />
        </svg>
      </div>
      <h3 class="text-lg font-medium text-gray-900 mb-2">No services found</h3>
      <p class="text-gray-600">
        No services match your search criteria. Try different keywords or filters.
      </p>
    </div>

    <!-- Pagination -->
    <div class="mt-8">
      <ServicePagination
        currentPage={currentPage}
        totalPages={totalPages}
        baseUrl={baseUrl}
      />
    </div>

    <!-- Explore by Category Section -->
    <div class="mt-12">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Browse by Category</h2>
      <div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        {sortedCategories.map(category => {
          const categoryServices = allServices.filter(service => service.data.category === category);
          const categorySlug = category.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');

          // Get category icon
          const getCategoryIcon = (cat) => {
            const icons = {
              'Education': 'M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z',
              'Health': 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
              'Non-profit Organizations': 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
              'Advocacy': 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
              'Humanitarian Aid': 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
              'Entrepreneurship': 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1',
              'Youth': 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
              'Cultural': 'M7 4V2a1 1 0 011-1h4a1 1 0 011 1v2m4 0V2a1 1 0 011-1h1a2 2 0 012 2v16a2 2 0 01-2 2H5a2 2 0 01-2-2V3a2 2 0 012-2h1a1 1 0 011 1v2m-4 0h10'
            };
            return icons[cat] || 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10';
          };

          return (
            <a
              href={`/services/category/${categorySlug}`}
              class="group block min-w-0 rounded border border-gray-200 bg-white p-4 transition-all duration-200 hover:border-primary-300"
            >
              <div class="flex min-w-0 items-center justify-between gap-3">
                <div class="flex min-w-0 items-center gap-3">
                  <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded bg-primary-100 transition-colors group-hover:bg-primary-200">
                    <svg class="w-4 h-4 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getCategoryIcon(category)} />
                    </svg>
                  </div>
                  <div class="min-w-0">
                    <h3 class="font-medium text-gray-900 group-hover:text-primary-600 transition-colors break-words">
                      {category}
                    </h3>
                    <p class="text-sm text-gray-500">{categoryServices.length} services</p>
                  </div>
                </div>
                <svg class="h-4 w-4 flex-shrink-0 text-gray-400 transition-all duration-200 group-hover:translate-x-1 group-hover:text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          );
        })}
      </div>
    </div>



    <!-- Register CTA -->
    <div class="mt-12 border border-gray-200 rounded p-6 text-center">
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Run a service, program, or organization in Dzaleka?</h3>
      <p class="text-gray-600 mb-4 text-sm">
        Add a new listing or help keep an existing one accurate.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <Button href="/services/register" size="sm">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          Register
        </Button>
        <Button href="/contact" variant="secondary" size="sm">
          Contact Us
        </Button>
      </div>
    </div>
  </div>
</MainLayout>


<script>
  document.addEventListener('DOMContentLoaded', () => {
    const serviceSearch = document.getElementById('serviceSearch') as HTMLInputElement;
    const categoryFilter = document.getElementById('categoryFilter') as HTMLSelectElement;
    const clearFiltersBtn = document.getElementById('clearFiltersBtn');
    const serviceCards = document.querySelectorAll('.service-card');
    const noResults = document.getElementById('no-results');
    const servicesGrid = document.getElementById('services-grid');

    let searchTerm = '';

    // Function to check if filters are active
    function updateClearButtonVisibility() {
      if (clearFiltersBtn) {
        const hasActiveFilters = searchTerm !== '';
        if (hasActiveFilters) {
          clearFiltersBtn.classList.remove('hidden');
          clearFiltersBtn.classList.add('sm:flex');
        } else {
          clearFiltersBtn.classList.add('hidden');
          clearFiltersBtn.classList.remove('sm:flex');
        }
      }
    }

    function filterServices() {
      let visibleCount = 0;

      serviceCards.forEach(card => {
        // @ts-ignore
        const title = card.dataset.title;
        const matchesSearch = !searchTerm || title.includes(searchTerm.toLowerCase());

        if (matchesSearch) {
          // @ts-ignore
          card.style.display = 'block';
          visibleCount++;
        } else {
          // @ts-ignore
          card.style.display = 'none';
        }
      });

      // Show/hide no results message
      if (noResults && servicesGrid) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
          servicesGrid.classList.add('hidden');
        } else {
          noResults.classList.add('hidden');
          servicesGrid.classList.remove('hidden');
        }
      }

      // Update clear button visibility
      updateClearButtonVisibility();
    }


    // Clear filters functionality
    clearFiltersBtn?.addEventListener('click', () => {
      // Reset search input
      if (serviceSearch) {
        serviceSearch.value = '';
        searchTerm = '';
      }

      // Refilter services
      filterServices();
    });

    // Function to update clear search button visibility
    function updateClearSearchButton() {
      const clearSearchBtn = document.getElementById('clearSearch');
      if (clearSearchBtn && serviceSearch) {
        if (serviceSearch.value.length > 0) {
          clearSearchBtn.classList.remove('hidden');
        } else {
          clearSearchBtn.classList.add('hidden');
        }
      }
    }

    // Search functionality
    serviceSearch?.addEventListener('input', (e) => {
      // @ts-ignore
      searchTerm = e.target.value;
      filterServices();
      updateClearSearchButton();
    });

    // Clear search button
    const clearSearchBtn = document.getElementById('clearSearch');
    clearSearchBtn?.addEventListener('click', () => {
      if (serviceSearch) {
        serviceSearch.value = '';
        searchTerm = '';
        filterServices();
        updateClearSearchButton();
        serviceSearch.focus();
      }
    });

    // Initialize clear button visibility
    updateClearSearchButton();

    // Category filter functionality - Navigate to category page
    categoryFilter?.addEventListener('change', (e) => {
      // @ts-ignore
      const category = e.target.value;
      if (category === 'all') {
        window.location.href = '/services';
      } else {
        // Convert category name to slug
        const slug = category.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
        window.location.href = `/services/category/${slug}`;
      }
    });


    // Initialize button visibility on page load
    updateClearButtonVisibility();
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: scale(1.05); }
    to { opacity: 1; transform: scale(1); }
  }

  .animate-fade-in {
    animation: fadeIn 2s ease-out forwards;
  }
</style>
