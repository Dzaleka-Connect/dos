---
import { getCollection } from 'astro:content';
import ServiceDirectory from '../../components/services/ServiceDirectory.astro';
import { SERVICES_PER_PAGE } from '../../utils/serviceDirectory';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return Array.from({ length: Math.max(0, Math.ceil(services.length / SERVICES_PER_PAGE) - 1) }, (_, i) => ({ params: { page: String(i + 2) } }));
}
const services = await getCollection('services');
const params = new URLSearchParams({ page: Astro.params.page! });
---
<ServiceDirectory services={services} params={params} />
