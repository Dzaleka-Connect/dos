---
import MainLayout from '../../layouts/MainLayout.astro';
import FormHeader from '../../components/ui/FormHeader.astro';
import ServiceAccessFields from '../../components/services/ServiceAccessFields.astro';
const title = 'Update service information';
const description = 'Send corrections or new details for an existing service listing.';
const contactFields = [
  { name: 'address', label: 'Service address' },
  { name: 'contact', label: 'Public phone, email or website' },
  { name: 'hours', label: 'Operating hours' },
];
---
<MainLayout title={title} description={description}>
  <FormHeader title={title} description={description} parent="Services" href="/services" />
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
    <p class="mb-8 border-l-4 border-primary-800 bg-primary-50 p-5 text-sm leading-6 text-slate-700">Send only the details that need changing. Updates are reviewed before publication. For a new organisation, <a href="/services/register" class="text-primary-800 underline underline-offset-4">register a service</a>.</p>
    <form id="updateForm" action="/api/submissions?form=service-correction" method="POST" class="submission-form space-y-10">
      <div hidden aria-hidden="true"><label>Leave this empty<input name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>
      <input type="hidden" name="form-name" value="service-update-request" />
      <p class="text-sm text-slate-600">Optional fields are marked.</p>
      <fieldset class="form-section">
        <legend>1. Your contact details</legend>
        <p class="mb-6 text-sm text-slate-600">These details are for following up on your submission.</p>
        <div class="grid gap-6 sm:grid-cols-2">
          <div><label for="name" class="mb-2 block font-semibold">Your name</label><input id="name" name="name" autocomplete="name" required class="w-full px-3 py-2" /></div>
          <div><label for="email" class="mb-2 block font-semibold">Your email</label><input id="email" name="email" type="email" autocomplete="email" required class="w-full px-3 py-2" /></div>
        </div>
      </fieldset>
      <fieldset class="form-section">
        <legend>2. Listing details</legend>
        <div class="space-y-6">
          <div><label for="title" class="mb-2 block font-semibold">Service name</label><input id="title" name="title" required class="w-full px-3 py-2" /></div>
          <div><label for="listingUrl" class="mb-2 block font-semibold">Listing URL (optional)</label><input id="listingUrl" name="listingUrl" type="url" class="w-full px-3 py-2" /><p class="mt-2 text-sm text-slate-600">The link to the service listing you want to correct.</p></div>
          <div><label for="description" class="mb-2 block font-semibold">Service description (optional)</label><textarea id="description" name="description" rows="4" class="w-full px-3 py-2"></textarea></div>
          <div><label for="category" class="mb-2 block font-semibold">Category (optional)</label><input id="category" name="category" class="w-full px-3 py-2" /></div>
          {contactFields.map(({ name, label }) => <div><label for={name} class="mb-2 block font-semibold">{label} (optional)</label><input id={name} name={name} class="w-full px-3 py-2" /></div>)}
        </div>
      </fieldset>
      <fieldset class="form-section"><legend>3. Using the service</legend><ServiceAccessFields /></fieldset>
      <div><label for="notes" class="mb-2 block font-semibold">Other changes or sources (optional)</label><p id="notes-hint" class="mb-2 text-sm text-slate-600">Explain the correction and include a public source link if you have one. Do not include private documents or information about people receiving support.</p><textarea id="notes" name="notes" rows="4" aria-describedby="notes-hint" class="w-full px-3 py-2"></textarea></div>
      <p id="update-error" role="alert" tabindex="-1" hidden class="border-l-4 border-red-700 bg-red-50 p-5 text-red-900"></p>
      <div class="form-actions"><button type="submit">Submit update</button><a href="/services" class="inline-flex min-h-[44px] items-center px-3 text-primary-800 underline underline-offset-4">Cancel</a></div>
      <p class="text-sm text-slate-600">Read our <a href="/privacy" target="_blank" rel="noopener noreferrer" class="text-primary-800 underline underline-offset-4">privacy policy (opens in a new tab)</a> for how submissions are handled.</p>
    </form>
  </div>
</MainLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#updateForm');
  const titleInput = form?.querySelector<HTMLInputElement>('[name="title"]');
  const listingTitle = new URLSearchParams(window.location.search).get('title');
  if (titleInput && !titleInput.value && listingTitle) titleInput.value = listingTitle;
  const listingInput = form?.querySelector<HTMLInputElement>('[name="listingUrl"]');
  const listingSlug = new URLSearchParams(window.location.search).get('service');
  if (listingInput && listingSlug) listingInput.value = `https://services.dzaleka.com/services/${encodeURIComponent(listingSlug)}`;
  const button = form?.querySelector<HTMLButtonElement>('[type="submit"]');
  const error = document.getElementById('update-error');
  let pending = false;
  if (form && button && error) form.addEventListener('submit', async event => {
    event.preventDefault();
    if (pending || !form.reportValidity()) return;
    pending = true; button.disabled = true; button.textContent = 'Submitting…';
    form.setAttribute('aria-busy', 'true'); error.hidden = true;
    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('Submission failed');
      window.location.assign('/services/update-success');
    } catch {
      error.textContent = 'Your update could not be sent. Your information is still here. Check your connection and try again.';
      error.hidden = false; error.focus(); pending = false; button.disabled = false; button.textContent = 'Submit update';
    } finally { form.removeAttribute('aria-busy'); }
  });
</script>
