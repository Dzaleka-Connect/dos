---
import { getCollection } from 'astro:content';
import ServiceDirectory from '../../../../components/services/ServiceDirectory.astro';
import { SERVICES_PER_PAGE, serviceCategorySlug } from '../../../../utils/serviceDirectory';

export async function getStaticPaths({ paginate }) {
  const services = await getCollection('services');
  const categories = [...new Set(services.map(service => service.data.category))];
  return categories.flatMap(category => paginate(services.filter(service => service.data.category === category), {
    params: { category: serviceCategorySlug(category) }, props: { categoryName: category }, pageSize: SERVICES_PER_PAGE,
  }));
}
const { page, categoryName } = Astro.props;
const services = await getCollection('services');
const params = new URLSearchParams({ category: categoryName, page: String(page.currentPage) });
---
<ServiceDirectory services={services} params={params} categoryPage={categoryName} />
