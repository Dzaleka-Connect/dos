---
import { getContent } from '../../../../lib/content';
import ServiceDirectory from '../../../../components/services/ServiceDirectory.astro';
import { getServiceDirectory, serviceCategorySlug } from '../../../../utils/serviceDirectory';

export const prerender = false;
const services = await getContent('services');
const categoryName = services.find(service => serviceCategorySlug(service.data.category) === Astro.params.category)?.data.category;
const page = Number(Astro.params.page || 1);
const params = new URLSearchParams(Astro.url.searchParams);
params.set('category', categoryName);
params.set('page', String(page));
if (!categoryName || !Number.isSafeInteger(page) || page < 1 || page > getServiceDirectory(services, params).totalPages) return new Response('Not found', { status: 404 });
---
<ServiceDirectory services={services} params={params} categoryPage={categoryName} />
