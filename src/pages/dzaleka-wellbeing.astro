  .wb-stat-label { margin-top: 0.25rem; font-size: 0.875rem; font-weight: 600; color: #0f172a; }
  .wb-stat-note { margin-top: 0.25rem; font-size: 0.75rem; color: #94a3b8; }

  .wb-source-group { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 1.5rem; }
  .wb-source-link {
    display: block; padding: 1rem; border-radius: 8px; background: rgba(15,23,42,0.5);
    border: 1px solid rgba(255,255,255,0.06); transition: all 0.15s;
  }
  .wb-source-link:hover { border-color: rgba(255,255,255,0.2); background: rgba(15,23,42,0.7); }
  .wb-source-link strong { display: block; font-size: 13px; color: #fff; }
  .wb-source-link span { display: block; margin-top: 4px; font-size: 12px; color: #94a3b8; line-height: 1.5; }
</style>


<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.wb-audience-tab');
    const panels = document.querySelectorAll('.wb-tab-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');

        tabs.forEach(t => {
          t.classList.remove('wb-audience-tab--active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('wb-audience-tab--active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(p => {
          p.classList.remove('wb-tab-panel--active');
          if (p.id === `panel-${target}`) {
            p.classList.add('wb-tab-panel--active');
          }
        });
      });
    });
  });
</script>
