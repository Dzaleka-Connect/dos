---
import { getCollection } from "astro:content";
import StartupTemplatePage from "../../components/tools/StartupTemplatePage.astro";

export async function getStaticPaths() {
  const templates = await getCollection("startup-templates");

  return templates.map((template) => ({
    params: { slug: template.id },
    props: {
      template,
      relatedTools: template.data.related.flatMap((slug) =>
        templates.filter((entry) => entry.id === slug),
      ),
    },
  }));
}

const { template, relatedTools } = Astro.props;
---

<StartupTemplatePage template={template} relatedTools={relatedTools} />
