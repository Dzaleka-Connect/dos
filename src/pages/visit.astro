---
import MainLayout from '../layouts/MainLayout.astro';
import FeatureHeader from '../components/ui/FeatureHeader.astro';
const description = 'Plan your visit, explore local experiences and book a guide on the dedicated Visit Dzaleka website.';
const links = [
  { title: 'Plan your trip', description: 'Travel information and practical advice before you arrive.', href: 'https://visit.dzaleka.com/plan-your-trip/' },
  { title: 'Explore experiences', description: 'Browse guided visits, arts, food and community activities.', href: 'https://visit.dzaleka.com/things-to-do/' },
  { title: 'Visitor guidelines', description: 'Read about respectful visits, photography and community privacy.', href: '/visit/guidelines' },
];
---
<MainLayout title="Visit Dzaleka" description={description} image="/images/dzaleka-hero.jpeg">
  <FeatureHeader title="Visit Dzaleka" description={description} eyebrow="Plan a visit"
    image="/images/dzaleka-hero.jpeg" imageAlt="A view over Dzaleka, its football ground and surrounding hills"
    action={{ label: 'Open Visit Dzaleka', href: 'https://visit.dzaleka.com/' }}
    secondary={{ label: 'Explore the community map', href: '/map' }} />
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <p class="max-w-2xl text-base leading-7 text-slate-700">Tour planning and bookings are now on <a href="https://visit.dzaleka.com/" class="font-medium text-primary-800 underline underline-offset-4">visit.dzaleka.com</a>.</p>
    <nav aria-label="Plan your visit" class="mt-8 grid gap-6 md:grid-cols-3">
      {links.map(link => <a href={link.href} class="rounded border border-slate-200 bg-slate-50 p-6 hover:border-primary-700">
        <h2 class="text-xl text-primary-900 underline underline-offset-4">{link.title}<span aria-hidden="true"> {link.href.startsWith('https:') ? '↗' : '→'}</span></h2>
        <p class="mt-3 leading-6 text-slate-700">{link.description}</p>
      </a>)}
    </nav>
    <section class="mt-10 border-t border-slate-200 pt-8" aria-labelledby="before-visiting">
      <h2 id="before-visiting" class="text-primary-900">Get to know Dzaleka</h2>
      <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-3 text-base text-primary-800 underline underline-offset-4">
        <li><a class="inline-flex min-h-[44px] items-center" href="/encyclopedia">Dzaleka Encyclopedia</a></li>
        <li><a class="inline-flex min-h-[44px] items-center" href="/photos">Photo Archive</a></li>
        <li><a class="inline-flex min-h-[44px] items-center" href="/culture">Arts and culture</a></li>
      </ul>
    </section>
  </div>
</MainLayout>
