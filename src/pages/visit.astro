        document.addEventListener('DOMContentLoaded', () => {
          const referralSelect = document.getElementById('referralSource');
          const referralOther = document.getElementById('referralOther');
          
          if (referralSelect && referralOther) {
            referralSelect.addEventListener('change', () => {
              if (referralSelect.value === 'other') {
                referralOther.classList.remove('hidden');
              } else {
                referralOther.classList.add('hidden');
              }
            });
          }
        });
