---
import MainLayout from '../layouts/MainLayout.astro';

// Define SEO metadata
const pageTitle = "Visit Dzaleka Refugee Camp | Guided Tours & Cultural Experiences";
const description = "Book guided tours of Dzaleka Refugee Camp highlighting vibrant culture, rich heritage, and resilient community. Experience authentic cultural performances, visit local businesses, meet community leaders, and learn about refugee life in Malawi's largest settlement.";
const keywords = "Dzaleka tour, refugee camp visit, cultural tourism, Malawi tourism, guided refugee camp tour, cultural experience, Dzaleka community, humanitarian tourism";
const ogImage = "https://tumainiletu.org/wp-content/uploads/2024/10/Badre_Bahaji_Tumaini_festival21_-31-1.jpg";

const zones = [
  { name: 'Lisungwi', icon: '🏘️' },
  { name: 'Kawale 1 & 2', icon: '🏡' },
  { name: 'Likuni 1 & 2', icon: '🏢' },
  { name: 'Zomba', icon: '🏪' },
  { name: 'Blantyre', icon: '🏬' },
  { name: 'Katubza', icon: '🏘️' },
  { name: 'New Katubza', icon: '🏘️' },
  { name: 'Dzaleka Hill', icon: '⛰️' }
];

const activities = [
  {
    title: 'Tumaini Festival',
    description: 'Annual cultural festival showcasing music, art, and performances',
    icon: '🎭',
    image: 'https://tumainiletu.org/wp-content/uploads/2024/10/Badre_Bahaji_Tumaini_festival21_-31-1.jpg'
  },
  {
    title: 'Community Initiatives',
    description: 'Engage with various community-driven projects',
    icon: '🤝',
    image: 'https://tumainiletu.org/wp-content/uploads/2021/07/Website-Entrepreneurship-and-innovation-2048x1536.jpg'
  },
  {
    title: 'Educational Workshops',
    description: 'Participate in programs focusing on entrepreneurship and skills development',
    icon: '📚',
    image: 'https://tumainiletu.org/wp-content/uploads/2021/07/Website-Creative-skills-development-1-1-2048x1365.jpg'
  }
];

const stats = [
  { number: '50km', label: 'From Lilongwe' },
  { number: '55,425', label: 'Residents' },
  { number: '100+', label: 'Local Businesses' },
  { number: '15+', label: 'Languages Spoken' },
  { number: '4+', label: 'Cultural Festivals' },
  { number: '2-Hour', label: 'Guided Tours' }
];

// Create the structured data object
const structuredData = {
      "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["TouristAttraction", "Place"],
      "name": "Visit Dzaleka",
      "alternateName": "Visit Dzaleka Refugee Camp",
      "description": "Explore Dzaleka Refugee Camp with guided tours highlighting vibrant culture, rich heritage, and resilient community. Book your visit to Malawi's largest refugee community today.",
      "url": "https://services.dzaleka.com/visit",
      "isAccessibleForFree": false,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Dzaleka Refugee Camp",
        "addressLocality": "Dowa District",
        "addressRegion": "Central Region",
        "postalCode": "DZ001",
        "addressCountry": "Malawi"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -13.7333,
        "longitude": 33.9333
      },
      "hoursAvailable": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "10:00",
          "closes": "16:00"
        }
      ],
      "image": {
        "@type": "ImageObject",
        "url": "https://tumainiletu.org/wp-content/uploads/2024/10/Badre_Bahaji_Tumaini_festival21_-31-1.jpg",
        "width": "1200",
        "height": "630",
        "creditText": "Photo by Badre Bahaji",
        "copyrightNotice": "© 2024 Tumaini Letu. All rights reserved.",
        "creator": {
          "@type": "Person",
          "name": "Badre Bahaji"
        },
        "license": "https://tumainiletu.org/image-licensing",
        "acquireLicensePage": "https://tumainiletu.org/contact"
      },
      "additionalType": [
        "https://schema.org/CulturalCenter",
        "https://schema.org/TouristDestination"
      ],
      "sameAs": [
        "https://services.dzaleka.com/visit",
        "https://services.dzaleka.com"
      ],
      "amenityFeature": [
        {
          "@type": "LocationFeatureSpecification",
          "name": "Guided Tours",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Cultural Activities",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Educational Workshops",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Kawale 1 & 2",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Dzaleka Hill",
          "value": true
        }
      ],
      "publicAccess": true,
      "hasMap": "https://www.google.com/maps?q=dzaleka+refugee+camp",
      "maximumAttendeeCapacity": 50,
      "availableLanguage": [
        "English",
        "Swahili",
        "French",
        "Kirundi",
        "Kinyarwanda"
      ],
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "Tour Duration",
          "value": "2-4 hours"
        },
        {
          "@type": "PropertyValue",
          "name": "Group Size",
          "value": "1-50 people"
        },
        {
          "@type": "PropertyValue",
          "name": "Established",
          "value": "1994"
        },
        {
          "@type": "PropertyValue",
          "name": "Price Range",
          "value": "MWK 15,000-100,000"
        }
      ],
      "event": [
        {
          "@type": "Event",
          "name": "Tumaini Festival 2025",
          "description": "Annual cultural festival showcasing music, art, and performances.",
          "startDate": "2025-10-30T10:00:00+02:00",
          "endDate": "2025-11-01T18:00:00+02:00",
          "eventStatus": "https://schema.org/EventScheduled",
          "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
          "location": {
            "@type": "Place",
            "name": "Dzaleka Refugee Camp",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Dzaleka Refugee Camp",
              "addressLocality": "Dowa District",
              "addressRegion": "Central Region",
              "postalCode": "DZ001",
              "addressCountry": "MW"
            }
          },
          "image": "https://tumainiletu.org/wp-content/uploads/2024/10/Badre_Bahaji_Tumaini_festival21_-31-1.jpg",
          "offers": {
            "@type": "Offer",
            "url": "https://services.dzaleka.com/visit#planTripForm",
            "price": "0",
            "priceCurrency": "MWK",
            "availability": "https://schema.org/InStock"
          }
        }
      ],
      "potentialAction": {
        "@type": "ReserveAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://services.dzaleka.com/visit#planTripForm",
          "inLanguage": "en",
          "actionPlatform": [
            "http://schema.org/DesktopWebPlatform",
            "http://schema.org/MobileWebPlatform"
          ]
        }
      }
    },
    {
      "@type": ["Person", "LocalBusiness"],
      "name": "Visit Dzaleka Tour Guides",
      "description": "Professional local guides offering cultural and educational tours of Dzaleka Refugee Camp",
      "areaServed": {
        "@type": "City",
        "name": "Dzaleka Refugee Camp",
        "containedInPlace": {
          "@type": "AdministrativeArea",
          "name": "Dowa District"
        }
      }
    },
    {
      "@type": "Organization",
      "name": "Dzaleka Online Services",
      "url": "https://services.dzaleka.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://services.dzaleka.com/images/dzaleka-digital-heritage.png",
        "width": "200",
        "height": "200",
        "creator": {
          "@type": "Organization",
          "name": "Dzaleka Online Services"
        },
        "creditText": "Dzaleka Online Services",
        "copyrightNotice": `© ${new Date().getFullYear()} Dzaleka Online Services`,
        "license": "https://services.dzaleka.com/terms",
        "acquireLicensePage": "https://services.dzaleka.com/contact"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "dzalekaconnect@gmail.com",
        "availableLanguage": ["English", "Swahili", "French"]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What types of tours do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer guided walking tours of Dzaleka Refugee Camp, where visitors can explore key areas, learn about the camp's history, and engage with the community."
          }
        },
        {
          "@type": "Question",
          "name": "How much do tours cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tour prices range from MWK 15,000 for individuals to MWK 100,000 for groups of 10+ people. Additional hours are charged at MWK 10,000 per hour."
          }
        },
        {
          "@type": "Question",
          "name": "What are the different zones in Dzaleka Refugee Camp?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dzaleka Refugee Camp is divided into several distinct zones: Lisungwi, Kawale 1 & 2, Likuni 1 & 2, Zomba, Blantyre, Katubza, New Katubza, and Dzaleka Hill. Each zone has its own unique characteristics and community features."
          }
        },
        {
          "@type": "Question",
          "name": "What should I bring for the tour?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We recommend wearing comfortable walking shoes, bringing a hat, sunscreen, water, and a camera. The tours involve walking, so comfortable attire is essential."
          }
        },
        {
          "@type": "Question",
          "name": "What activities can I experience during the visit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Visitors can experience cultural exchanges, educational workshops, community initiatives, and during special events, the Tumaini Festival which showcases music, art, and performances. You can also engage with local entrepreneurs and artisans."
          }
        },
        {
          "@type": "Question",
          "name": "What are the tour timings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tours operate Monday through Friday, with standard start times at 10:00 AM and 2:00 PM. The standard tour duration is 2 hours, with options for extended tours."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer group discounts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we offer special rates for groups. Groups of 6-10 people pay MWK 80,000, while groups of 10+ people pay MWK 100,000 for a standard 2-hour tour."
          }
        },
        {
          "@type": "Question",
          "name": "What is your cancellation policy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We understand that plans can change. Please inform us as soon as possible if you need to cancel or reschedule your tour, and we will do our best to accommodate your needs."
          }
        },
        {
          "@type": "Question",
          "name": "Are the tours family-friendly?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, our tours are suitable for all ages and are designed to be family-friendly. We can adjust the tour content and pace to accommodate families with children."
          }
        },
        {
          "@type": "Question",
          "name": "Where do tours start from?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tours can start from three recommended meeting points: the UNHCR Office, Appfactory, or JRS (Jesuit Refugee Service). The specific meeting point will be confirmed upon booking."
          }
        }
      ]
    }
  ]
};
---

<MainLayout title={pageTitle} description={description} keywords={keywords} ogImage={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData, null, 2)} />

  <script>
    // Wait for the DOM to be fully loaded
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('visitForm');
      if (form) {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const formData = new FormData(form);
          
          try {
            const response = await fetch(form.action, {
              method: 'POST',
              body: formData,
              headers: {
                'Accept': 'application/json'
              }
            });
            
            if (response.ok) {
              window.location.href = '/thank-you?type=visit';
            }
          } catch (error) {
            console.error('Error:', error);
          }
        });
      }
    });
  </script>

  <main class="min-h-screen bg-gray-50">
    <!-- Hero Section -->
    <div class="relative min-h-[70vh] overflow-hidden border-b border-gray-200">
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-b from-gray-900/55 via-gray-900/60 to-gray-900/85 z-10"></div>
        <img 
          src="https://tumainiletu.org/wp-content/uploads/2024/10/Badre_Bahaji_Tumaini_festival21_-31-1.jpg" 
          alt="Dzaleka Community" 
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Content -->
      <div class="relative z-20 flex min-h-[70vh] flex-col items-center justify-center py-14 md:py-20">
        <div class="container mx-auto px-4 md:px-6">
          <div class="max-w-5xl mx-auto text-center space-y-8">
            <div class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-5 py-2 text-sm font-medium tracking-wide text-white">
              Visit Dzaleka
            </div>
            
            <div class="space-y-6">
              <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-tight tracking-tight">
                Visit Dzaleka
              </h1>
              
              <p class="text-lg sm:text-xl md:text-2xl text-gray-100 max-w-3xl mx-auto leading-relaxed">
                Learn with local guides, meet community members, and experience the culture, history, and everyday life of Malawi's largest refugee community.
              </p>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 md:gap-6 pt-10">
              <a 
                href="https://visit.dzaleka.com/login"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-white hover:bg-gray-50 text-gray-900 font-semibold rounded-lg transition-colors shadow-sm text-lg"
              >
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                <span>Login / Sign Up</span>
              </a>
              <button 
                onclick="document.getElementById('planTripForm').scrollIntoView({behavior: 'smooth'})"
                class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-lg transition-colors shadow-sm text-lg"
              >
                <span>Book Your Visit</span>
                <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <section class="py-12 bg-white border-b border-gray-100">
      <div class="container mx-auto px-4">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 text-center divide-x divide-gray-100">
          {stats.map((stat) => (
            <div class="px-4 first:pl-0 last:pr-0 border-none md:border-solid">
              <span class="block text-3xl md:text-4xl font-bold text-primary-600 mb-1">{stat.number}</span>
              <span class="text-sm text-gray-500 uppercase tracking-wider">{stat.label}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Introduction -->
    <section class="py-20 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <span class="text-primary-600 font-bold tracking-wider uppercase text-sm mb-4 block">About the Camp</span>
          <h2 class="text-4xl md:text-5xl font-bold mb-8 text-gray-900">A Place of Resilience and Hope</h2>
          <div class="prose prose-xl mx-auto text-gray-600 leading-relaxed">
            <p>
              <span class="text-6xl float-left mr-4 mt-[-10px] font-serif text-primary-500">D</span>zaleka Refugee Camp, located approximately 50 km from Lilongwe in Malawi's Dowa District, is more than just a settlement—it's a thriving community. Established in 1994 by the UNHCR, it is now home to over 55,000 residents from the DRC, Rwanda, Burundi, Ethiopia, and Somalia, each contributing to a rich tapestry of culture, art, and innovation.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Activities -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <span class="text-primary-600 font-bold tracking-wider uppercase text-sm mb-3 block">What to Expect</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Featured Activities</h2>
          <p class="text-gray-600 max-w-2xl mx-auto text-lg">Immerse yourself in the daily life and culture of Dzaleka through these curated experiences.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {activities.map((activity) => (
            <div class="bg-white rounded-xl overflow-hidden border border-gray-200 transition-colors hover:border-gray-300">
              <div class="h-48 bg-gray-200 relative overflow-hidden">
                <img 
                  src={activity.image} 
                  alt={activity.title} 
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="p-6">
                <div class="flex items-center mb-3">
                  <span class="text-2xl mr-3">{activity.icon}</span>
                  <h3 class="text-xl font-bold text-gray-900">{activity.title}</h3>
                </div>
                <p class="text-gray-600">{activity.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Living History / Time Capsule Teaser -->
    <section class="py-20 bg-gray-50 relative overflow-hidden">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="relative">

            
            <div class="relative bg-white rounded-2xl p-8 md:p-12 border border-gray-200 shadow-sm">
              <div class="text-6xl font-black text-gray-200 absolute top-4 right-8 select-none">1964</div>
              <h3 class="text-2xl font-bold text-gray-900 mb-6 relative z-10">Did You Know?</h3>
              <blockquote class="text-xl text-gray-700 italic mb-6 relative z-10">
                "The name Dzaleka comes from the Chichewa phrase 'N'dzaleka', meaning 'I will never do it again'."
              </blockquote>
              <p class="text-gray-600 mb-6 relative z-10">
                Originally established as a political prison during the Hastings Banda regime, Dzaleka has transformed into a place of refuge and hope.
              </p>
              <div class="flex items-center gap-4 text-sm font-medium text-gray-500 relative z-10">
                <div class="flex items-center gap-2">
                  <div class="w-2 h-2 bg-red-400 rounded-full"></div>
                  <span>Political Prison (1964-1994)</span>
                </div>
                <div class="flex items-center gap-2">
                  <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                  <span>Refugee Camp (1994-Present)</span>
                </div>
              </div>
            </div>
          </div>

          <div>
            <span class="text-primary-600 font-bold tracking-wider uppercase text-sm mb-3 block">Living History</span>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">A Place of Transformation</h2>
            <p class="text-lg text-gray-600 mb-6 leading-relaxed">
              Understanding Dzaleka requires looking back at its complex history. What was once a site of oppression is now a vibrant community where over 50,000 people from the DRC, Burundi, and Rwanda are rebuilding their lives.
            </p>
            <p class="text-lg text-gray-600 mb-8 leading-relaxed">
              Our digital archive, the <strong>Dzaleka Time Capsule</strong>, documents this journey through historical records, personal testimonies, and cultural artifacts.
            </p>
            
            <a href="/dzaleka-time-capsule" class="inline-flex items-center text-primary-600 font-bold hover:text-primary-700 transition-colors group">
              <span>Explore the Time Capsule</span>
              <svg class="w-5 h-5 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Zones Section -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">Camp Zones</h2>
          <p class="text-gray-600 max-w-2xl mx-auto text-sm">Explore the different areas within Dzaleka</p>
        </div>

        <div class="max-w-5xl mx-auto">
          <div class="flex flex-wrap justify-center gap-3">
            {zones.map(zone => (
              <div class="inline-flex items-center gap-2 bg-gray-50 hover:bg-primary-50 border border-gray-200 hover:border-primary-300 rounded-full px-4 py-2.5 transition-all group cursor-default">
                <span class="text-lg group-hover:scale-110 transition-transform">{zone.icon}</span>
                <span class="font-medium text-gray-700 group-hover:text-primary-700 text-sm transition-colors">{zone.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- About the Tour -->
    <section class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">About the Tour</h2>
            <p class="text-gray-600 max-w-2xl mx-auto">Everything you need to know to prepare for your visit</p>
          </div>

          <!-- Tour Experience -->
          <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden mb-10">
            <div class="flex flex-col md:flex-row">
              <div class="md:w-2/5 bg-primary-700 text-white p-8 flex items-center">
                <div>
                  <div class="inline-block p-3 bg-white/10 rounded-lg mb-5">
                    <span class="text-4xl">🧭</span>
                  </div>
                  <h3 class="text-2xl font-bold mb-3">Tour Experience</h3>
                  <p class="text-white/90">Your journey through Dzaleka with knowledgeable guides who know the community well</p>
                </div>
              </div>
              <div class="md:w-3/5 p-8">
                <p class="text-gray-700 leading-relaxed">
                  Explore Dzaleka Refugee Camp with a knowledgeable guide who will take you through the camp's historical sites and vibrant community areas. During the tour, you'll gain insights into the camp's rich cultural heritage, the lives of its residents, and the history of the camp itself. Our tours are designed to be engaging, educational, and respectful of the community.
                </p>
              </div>
            </div>
          </div>

          <!-- Tour Logistics Grid -->
          <!-- Tour Logistics Grid -->
          <!-- Tour Logistics Grid -->
          <div class="grid md:grid-cols-2 gap-8">
            <!-- Duration Card -->
            <div class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100 hover:shadow-2xl transition-all duration-300 group">
