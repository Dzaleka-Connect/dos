---
import MainLayout from '../layouts/MainLayout.astro';

// Define SEO metadata
const pageTitle = "Visit Dzaleka Refugee Camp | Guided Tours & Cultural Experiences";
const description = "Book guided tours of Dzaleka Refugee Camp highlighting vibrant culture, rich heritage, and resilient community. Experience authentic cultural performances, visit local businesses, meet community leaders, and learn about refugee life in Malawi's largest settlement.";
const keywords = "Dzaleka tour, refugee camp visit, cultural tourism, Malawi tourism, guided refugee camp tour, cultural experience, Dzaleka community, humanitarian tourism";
const ogImage = "https://tumainiletu.org/wp-content/uploads/2024/10/Badre_Bahaji_Tumaini_festival21_-31-1.jpg";

const zones = [
  { name: 'Lisungwi', icon: '🏘️' },
  { name: 'Kawale 1 & 2', icon: '🏡' },
  { name: 'Likuni 1 & 2', icon: '🏢' },
  { name: 'Zomba', icon: '🏪' },
  { name: 'Blantyre', icon: '🏬' },
  { name: 'Katubza', icon: '🏘️' },
  { name: 'New Katubza', icon: '🏘️' },
  { name: 'Dzaleka Hill', icon: '⛰️' }
];

const activities = [
  {
    title: 'Tumaini Festival',
    description: 'Annual cultural festival showcasing music, art, and performances',
    icon: '🎭',
    image: 'https://tumainiletu.org/wp-content/uploads/2024/10/Badre_Bahaji_Tumaini_festival21_-31-1.jpg'
  },
  {
    title: 'Community Initiatives',
    description: 'Engage with various community-driven projects',
    icon: '🤝',
    image: 'https://tumainiletu.org/wp-content/uploads/2021/07/Website-Entrepreneurship-and-innovation-2048x1536.jpg'
  },
  {
    title: 'Educational Workshops',
    description: 'Participate in programs focusing on entrepreneurship and skills development',
    icon: '📚',
    image: 'https://tumainiletu.org/wp-content/uploads/2021/07/Website-Creative-skills-development-1-1-2048x1365.jpg'
  }
];

const stats = [
  { number: '50km', label: 'From Lilongwe' },
  { number: '55,425', label: 'Residents' },
  { number: '100+', label: 'Local Businesses' },
  { number: '15+', label: 'Languages Spoken' },
  { number: '4+', label: 'Cultural Festivals' },
  { number: '2-Hour', label: 'Guided Tours' }
];

// Create the structured data object
const structuredData = {
      "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["TouristAttraction", "Place"],
      "name": "Visit Dzaleka",
      "alternateName": "Visit Dzaleka Refugee Camp",
      "description": "Explore Dzaleka Refugee Camp with guided tours highlighting vibrant culture, rich heritage, and resilient community. Book your visit to Malawi's largest refugee community today.",
      "url": "https://services.dzaleka.com/visit",
      "isAccessibleForFree": false,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Dzaleka Refugee Camp",
        "addressLocality": "Dowa District",
        "addressRegion": "Central Region",
        "postalCode": "DZ001",
        "addressCountry": "Malawi"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -13.7333,
        "longitude": 33.9333
      },
      "hoursAvailable": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "10:00",
          "closes": "16:00"
        }
      ],
      "image": {
        "@type": "ImageObject",
        "url": "https://tumainiletu.org/wp-content/uploads/2024/10/Badre_Bahaji_Tumaini_festival21_-31-1.jpg",
        "width": "1200",
        "height": "630",
        "creditText": "Photo by Badre Bahaji",
        "copyrightNotice": "© 2024 Tumaini Letu. All rights reserved.",
        "creator": {
          "@type": "Person",
          "name": "Badre Bahaji"
        },
        "license": "https://tumainiletu.org/image-licensing",
        "acquireLicensePage": "https://tumainiletu.org/contact"
      },
      "additionalType": [
        "https://schema.org/CulturalCenter",
        "https://schema.org/TouristDestination"
      ],
      "sameAs": [
        "https://services.dzaleka.com/visit",
        "https://dzaleka.com"
      ],
      "amenityFeature": [
        {
          "@type": "LocationFeatureSpecification",
          "name": "Guided Tours",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Cultural Activities",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Educational Workshops",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Kawale 1 & 2",
          "value": true
        },
        {
          "@type": "LocationFeatureSpecification",
          "name": "Dzaleka Hill",
          "value": true
        }
      ],
      "publicAccess": true,
      "hasMap": "https://www.google.com/maps?q=dzaleka+refugee+camp",
      "maximumAttendeeCapacity": 50,
      "availableLanguage": [
        "English",
        "Swahili",
        "French",
        "Kirundi",
        "Kinyarwanda"
      ],
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "Tour Duration",
          "value": "2-4 hours"
        },
        {
          "@type": "PropertyValue",
          "name": "Group Size",
          "value": "1-50 people"
        },
        {
          "@type": "PropertyValue",
          "name": "Established",
          "value": "1994"
        },
        {
          "@type": "PropertyValue",
          "name": "Price Range",
          "value": "MWK 15,000-100,000"
        }
      ],
      "event": [
        {
          "@type": "Event",
          "name": "Tumaini Festival 2025",
          "description": "Annual cultural festival showcasing music, art, and performances.",
          "startDate": "2025-10-30T10:00:00+02:00",
          "endDate": "2025-11-01T18:00:00+02:00",
          "eventStatus": "https://schema.org/EventScheduled",
          "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
          "location": {
            "@type": "Place",
            "name": "Dzaleka Refugee Camp",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "Dzaleka Refugee Camp",
              "addressLocality": "Dowa District",
              "addressRegion": "Central Region",
              "postalCode": "DZ001",
              "addressCountry": "MW"
            }
          },
          "image": "https://tumainiletu.org/wp-content/uploads/2024/10/Badre_Bahaji_Tumaini_festival21_-31-1.jpg",
          "offers": {
            "@type": "Offer",
            "url": "https://services.dzaleka.com/visit#planTripForm",
            "price": "0",
            "priceCurrency": "MWK",
            "availability": "https://schema.org/InStock"
          }
        }
      ],
      "potentialAction": {
        "@type": "ReserveAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://services.dzaleka.com/visit#planTripForm",
          "inLanguage": "en",
          "actionPlatform": [
            "http://schema.org/DesktopWebPlatform",
            "http://schema.org/MobileWebPlatform"
          ]
        }
      }
    },
    {
      "@type": ["Person", "LocalBusiness"],
      "name": "Visit Dzaleka Tour Guides",
      "description": "Professional local guides offering cultural and educational tours of Dzaleka Refugee Camp",
      "areaServed": {
        "@type": "City",
        "name": "Dzaleka Refugee Camp",
        "containedInPlace": {
          "@type": "AdministrativeArea",
          "name": "Dowa District"
        }
      }
    },
    {
      "@type": "Organization",
      "name": "Dzaleka Online Services",
      "url": "https://services.dzaleka.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://services.dzaleka.com/images/dzaleka-digital-heritage.png",
        "width": "200",
        "height": "200"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "dzalekaconnect@gmail.com",
        "availableLanguage": ["English", "Swahili", "French"]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What types of tours do you offer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We offer guided walking tours of Dzaleka Refugee Camp, where visitors can explore key areas, learn about the camp's history, and engage with the community."
          }
        },
        {
          "@type": "Question",
          "name": "How much do tours cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tour prices range from MWK 15,000 for individuals to MWK 100,000 for groups of 10+ people. Additional hours are charged at MWK 10,000 per hour."
          }
        },
        {
          "@type": "Question",
          "name": "What are the different zones in Dzaleka Refugee Camp?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dzaleka Refugee Camp is divided into several distinct zones: Lisungwi, Kawale 1 & 2, Likuni 1 & 2, Zomba, Blantyre, Katubza, New Katubza, and Dzaleka Hill. Each zone has its own unique characteristics and community features."
          }
        },
        {
          "@type": "Question",
          "name": "What should I bring for the tour?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We recommend wearing comfortable walking shoes, bringing a hat, sunscreen, water, and a camera. The tours involve walking, so comfortable attire is essential."
          }
        },
        {
          "@type": "Question",
          "name": "What activities can I experience during the visit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Visitors can experience cultural exchanges, educational workshops, community initiatives, and during special events, the Tumaini Festival which showcases music, art, and performances. You can also engage with local entrepreneurs and artisans."
          }
        },
        {
          "@type": "Question",
          "name": "What are the tour timings?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tours operate Monday through Friday, with standard start times at 10:00 AM and 2:00 PM. The standard tour duration is 2 hours, with options for extended tours."
          }
        },
        {
          "@type": "Question",
          "name": "Do you offer group discounts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, we offer special rates for groups. Groups of 6-10 people pay MWK 80,000, while groups of 10+ people pay MWK 100,000 for a standard 2-hour tour."
          }
        },
        {
          "@type": "Question",
          "name": "What is your cancellation policy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We understand that plans can change. Please inform us as soon as possible if you need to cancel or reschedule your tour, and we will do our best to accommodate your needs."
          }
        },
        {
          "@type": "Question",
          "name": "Are the tours family-friendly?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, our tours are suitable for all ages and are designed to be family-friendly. We can adjust the tour content and pace to accommodate families with children."
          }
        },
        {
          "@type": "Question",
          "name": "Where do tours start from?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Tours can start from three recommended meeting points: the UNHCR Office, Appfactory, or JRS (Jesuit Refugee Service). The specific meeting point will be confirmed upon booking."
          }
        }
      ]
    }
  ]
};
---

<MainLayout title={pageTitle} description={description} keywords={keywords} ogImage={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData, null, 2)} />

  <script>
    // Wait for the DOM to be fully loaded
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('visitForm');
      if (form) {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const formData = new FormData(form);
          
          try {
            const response = await fetch(form.action, {
              method: 'POST',
              body: formData,
              headers: {
                'Accept': 'application/json'
              }
            });
            
            if (response.ok) {
              window.location.href = '/thank-you?type=visit';
            }
          } catch (error) {
            console.error('Error:', error);
          }
        });
      }
    });
  </script>

  <main class="min-h-screen bg-gray-50">
    <!-- Hero Section -->
    <div class="relative h-[80vh] overflow-hidden">
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-br from-primary-900/90 via-primary-800/90 to-primary-900/90"></div>
        <img 
          src="https://tumainiletu.org/wp-content/uploads/2024/10/Badre_Bahaji_Tumaini_festival21_-31-1.jpg" 
          alt="Dzaleka Community" 
          class="w-full h-full object-cover"
        />
      </div>

      <!-- Content -->
      <div class="relative z-20 h-full flex flex-col items-center justify-center py-8 md:py-16 pb-24 md:pb-28">
        <div class="container mx-auto px-4 md:px-6">
          <div class="max-w-4xl mx-auto text-center space-y-8">
            <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-md rounded-full px-4 md:px-6 py-2">
              <span class="w-2 h-2 rounded-full bg-primary-400 animate-pulse"></span>
              <span class="text-xs md:text-sm text-white/90 font-medium tracking-wider uppercase">Experience Dzaleka</span>
            </div>
            
            <div class="space-y-4 sm:space-y-6">
              <h1 class="text-3xl sm:text-4xl md:text-6xl lg:text-7xl font-bold text-white leading-tight">
                Visit <span class="text-primary-400">Dzaleka</span><br class="hidden sm:block"/>Refugee Camp
              </h1>
              
              <p class="text-base sm:text-lg md:text-xl text-white/90 max-w-2xl mx-auto leading-relaxed">
                Discover the vibrant culture, resilient spirit, and inspiring stories of Malawi's largest refugee community
              </p>
            </div>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 md:gap-6 pt-8">
              <button 
                onclick="document.getElementById('planTripForm').scrollIntoView({behavior: 'smooth'})"
                class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-white hover:bg-primary-400 text-primary-900 hover:text-white font-medium rounded-full transition-all duration-300 group shadow-lg hover:shadow-xl text-base transform hover:scale-105"
              >
                <span>Plan Your Visit</span>
                <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </button>
              
              <a 
                href="#activities"
                class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 border-2 border-white/30 hover:border-white/80 text-white font-medium rounded-full transition-all duration-300 group hover:bg-white/10 text-base transform hover:scale-105"
              >
                <span>Explore Activities</span>
                <svg class="w-5 h-5 ml-2 group-hover:translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
                </svg>
              </a>
            </div>
            
            <!-- Quick Preview Cards -->
            <div class="mt-8 sm:mt-12 mb-16 sm:mb-20 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4 max-w-4xl mx-auto">
              <div class="bg-white/10 backdrop-blur-md rounded-xl p-3 sm:p-4 border border-white/20 hover:bg-white/20 transition-all duration-300 group">
                <div class="flex items-center space-x-2 sm:space-x-3">
                  <div class="w-8 h-8 sm:w-10 sm:h-10 bg-white/20 rounded-full flex items-center justify-center group-hover:bg-white/30 transition-colors flex-shrink-0">
                    <span class="text-lg sm:text-xl">🎭</span>
                  </div>
                  <div class="min-w-0 flex-1">
                    <h4 class="text-white font-semibold text-sm sm:text-base">Cultural Festivals</h4>
                    <p class="text-white/80 text-xs sm:text-sm">Experience vibrant celebrations</p>
                  </div>
                </div>
              </div>
              
              <div class="bg-white/10 backdrop-blur-md rounded-xl p-3 sm:p-4 border border-white/20 hover:bg-white/20 transition-all duration-300 group">
                <div class="flex items-center space-x-2 sm:space-x-3">
                  <div class="w-8 h-8 sm:w-10 sm:h-10 bg-white/20 rounded-full flex items-center justify-center group-hover:bg-white/30 transition-colors flex-shrink-0">
                    <span class="text-lg sm:text-xl">🏪</span>
                  </div>
                  <div class="min-w-0 flex-1">
                    <h4 class="text-white font-semibold text-sm sm:text-base">Local Markets</h4>
                    <p class="text-white/80 text-xs sm:text-sm">Shop authentic crafts & goods</p>
                  </div>
                </div>
              </div>
              
              <div class="bg-white/10 backdrop-blur-md rounded-xl p-3 sm:p-4 border border-white/20 hover:bg-white/20 transition-all duration-300 group sm:col-span-2 md:col-span-1">
                <div class="flex items-center space-x-2 sm:space-x-3">
                  <div class="w-8 h-8 sm:w-10 sm:h-10 bg-white/20 rounded-full flex items-center justify-center group-hover:bg-white/30 transition-colors flex-shrink-0">
                    <span class="text-lg sm:text-xl">🤝</span>
                  </div>
                  <div class="min-w-0 flex-1">
                    <h4 class="text-white font-semibold text-sm sm:text-base">Community Life</h4>
                    <p class="text-white/80 text-xs sm:text-sm">Meet inspiring residents</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center animate-bounce">
        <div class="w-1 h-16 bg-gradient-to-b from-white/0 via-white/30 to-white/0"></div>
      </div>
    </div>

    <!-- Stats Section -->
    <section class="relative z-10 -mt-20 pt-8 sm:pt-12">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="bg-white/95 backdrop-blur-xl rounded-3xl shadow-2xl p-6 sm:p-8 border border-white/20">
            <div class="text-center mb-8">
              <h3 class="text-2xl font-bold text-gray-900 mb-2">Why Visit Dzaleka?</h3>
              <p class="text-gray-600">Discover what makes our community unique</p>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6 text-center">
              {stats.map((stat, index) => (
                <div class="group p-4 sm:p-6 rounded-xl sm:rounded-2xl hover:bg-gradient-to-br hover:from-primary-50 hover:to-blue-50 transition-all duration-300 hover:scale-105 hover:shadow-lg border border-transparent hover:border-primary-100">
                  <div class="text-2xl sm:text-4xl font-bold text-primary-600 mb-2 sm:mb-3 group-hover:text-primary-700 transition-colors">{stat.number}</div>
                  <div class="text-gray-700 font-medium text-xs sm:text-sm group-hover:text-gray-900 transition-colors leading-tight">{stat.label}</div>
                  <div class="mt-2 sm:mt-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <div class="w-6 sm:w-8 h-1 bg-gradient-to-r from-primary-400 to-blue-400 rounded-full mx-auto"></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Activities -->
    <section id="activities" class="py-24">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">Featured Activities</h2>
          <p class="text-gray-600 max-w-2xl mx-auto">Immerse yourself in the rich cultural experiences and community initiatives that make Dzaleka unique</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto">
          {activities.map(activity => (
            <div class="group relative overflow-hidden rounded-xl lg:rounded-2xl shadow-lg hover:shadow-xl transition-all">
              <div class="aspect-w-16 aspect-h-9">
                <img 
                  src={activity.image} 
                  alt={activity.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/50 to-transparent">
                <div class="absolute bottom-0 left-0 right-0 p-4 lg:p-6">
                  <div class="flex items-center space-x-2 text-white/90 mb-2">
                    <span class="text-xl lg:text-2xl">{activity.icon}</span>
                    <h3 class="text-lg lg:text-xl font-semibold">{activity.title}</h3>
                  </div>
                  <p class="text-white/80 text-sm lg:text-base">{activity.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Visitor Testimonials -->
    <section class="py-24 bg-gradient-to-br from-primary-50 to-blue-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">What Visitors Say</h2>
          <p class="text-gray-600 max-w-2xl mx-auto">Hear from people who have experienced the warmth and culture of Dzaleka</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto">
          <div class="bg-white rounded-2xl p-6 lg:p-8 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
            <div class="flex items-center mb-4 lg:mb-6">
              <div class="w-10 h-10 lg:w-12 lg:h-12 bg-gradient-to-br from-primary-400 to-blue-500 rounded-full flex items-center justify-center text-white font-bold text-base lg:text-lg mr-3 lg:mr-4 flex-shrink-0">
                E
              </div>
              <div class="min-w-0 flex-1">
                <h4 class="font-semibold text-gray-900 text-sm lg:text-base">Egle</h4>
                <p class="text-xs lg:text-sm text-gray-600">Local Guide & Resident</p>
              </div>
            </div>
            <p class="text-gray-700 italic mb-4 text-sm lg:text-base leading-relaxed">"Despite the sad situation, Dzaleka Refugee Camp has plenty of good and amazing things happening inside there. After 5 months of living close to the camp I even sometimes starting to forget that this is refugee camp. For me now it is like amazing village, where I know many people, where we are going to the local markets and etc."</p>
            <div class="flex items-center justify-between">
              <div class="flex text-yellow-400">
                {[...Array(5)].map(() => (
                  <svg class="w-4 h-4 lg:w-5 lg:h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
