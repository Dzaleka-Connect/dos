<script>
  // Pre-populate form from URL parameters
  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    
    // Check if we have pricing parameters
    if (urlParams.has('groupSize')) {
      const groupSizeSelect = document.getElementById('groupSize');
      const tourTypeSelect = document.getElementById('tourType');
      const messageTextarea = document.getElementById('message');
      
      // Pre-fill group size
      if (groupSizeSelect && urlParams.get('groupSize')) {
        groupSizeSelect.value = urlParams.get('groupSize');
      }
      
      // Pre-fill tour type
      if (tourTypeSelect && urlParams.get('tourType')) {
        tourTypeSelect.value = urlParams.get('tourType');
      }
      
      // Pre-fill visit date
      const visitDateInput = document.getElementById('visitDate');
      if (visitDateInput && urlParams.get('visitDate')) {
        visitDateInput.value = urlParams.get('visitDate');
      }
      
      // Pre-fill visit time
      const visitTimeInput = document.getElementById('visitTime');
      if (visitTimeInput && urlParams.get('visitTime')) {
        visitTimeInput.value = urlParams.get('visitTime');
      }
      
      // Add pricing info to message
      if (messageTextarea) {
        const estimatedCost = urlParams.get('estimatedCost');
        const additionalHours = urlParams.get('additionalHours');
        
        let message = `Selected from pricing calculator:\n`;
        message += `- Group Size: ${urlParams.get('groupSize')}\n`;
        message += `- Tour Type: ${urlParams.get('tourType')}\n`;
        if (additionalHours && additionalHours !== '0') {
          message += `- Additional Hours: ${additionalHours}\n`;
        }
        if (estimatedCost) {
          message += `- Estimated Cost: MWK ${parseInt(estimatedCost).toLocaleString()}\n\n`;
        }
        
        messageTextarea.value = message;
        messageTextarea.focus();
      }
      
      // Scroll to form
      setTimeout(() => {
        document.getElementById('planTripForm')?.scrollIntoView({ 
          behavior: 'smooth',
          block: 'start'
        });
      }, 100);
    }
  });
  
  // Handle form submission
  document.addEventListener('DOMContentLoaded', () => {
    const visitForm = document.getElementById('visitForm');
    if (visitForm) {
      visitForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const submitButton = visitForm.querySelector('button[type="submit"]');
      const originalButtonText = submitButton?.innerHTML;
      
      // Show loading state
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.innerHTML = `
          <svg class="animate-spin h-5 w-5 mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        `;
      }
      
      try {
        const formData = new FormData(visitForm);
        
        // Convert FormData to a plain object for the API
        const formDataObj = {};
        for (const [key, value] of formData.entries()) {
          // Handle multiple values (checkboxes)
          if (formDataObj[key]) {
            if (Array.isArray(formDataObj[key])) {
              formDataObj[key].push(value);
            } else {
              formDataObj[key] = [formDataObj[key], value];
            }
          } else {
            formDataObj[key] = value;
          }
        }
        
        console.log('Submitting form data:', formDataObj);
        
        // Submit to Formspree first
        const formspreeResponse = await fetch('https://formspree.io/f/xqaaajae', {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });
        
        console.log('Formspree response:', formspreeResponse.status);
        
        if (!formspreeResponse.ok) {
          const formspreeError = await formspreeResponse.text();
          console.error('Formspree error:', formspreeError);
          throw new Error('Form submission failed');
        }
        
        // Send confirmation email via our API (don't wait for response)
        const jsonBody = JSON.stringify(formDataObj);
        console.log('Sending email confirmation...');
        
        fetch('/.netlify/functions/send-booking-confirmation', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: jsonBody
        }).then(response => {
          console.log('Email API response:', response.status);
          if (!response.ok) {
            console.error('Email sending failed, but form was submitted successfully');
          }
        }).catch(error => {
          console.error('Email API error:', error);
        });
        
        // Redirect to thank you page immediately
        window.location.href = '/thank-you?type=visit';
        
      } catch (error) {
        console.error('Error submitting form:', error);
        alert('There was an error submitting your booking. Please try again or contact us directly.');
        
        // Restore button
        if (submitButton && originalButtonText) {
          submitButton.disabled = false;
          submitButton.innerHTML = originalButtonText;
        }
      }
      });
    }
  });

  // Handle referral source "Other" field visibility
  document.addEventListener('DOMContentLoaded', () => {
    const referralSource = document.getElementById('referralSource');
    const referralOther = document.getElementById('referralOther');

    if (referralSource && referralOther) {
      referralSource.addEventListener('change', (e) => {
        if (e.target.value === 'other') {
          referralOther.classList.remove('hidden');
        } else {
          referralOther.classList.add('hidden');
        }
      });
    }
  });

</script>
