---
import MainLayout from '../../../layouts/MainLayout.astro';
import FormStatus from '../../../components/applications/FormStatus.astro';

const formId = 'legal-support-form';
---

<MainLayout title="Legal Support Application" robots="noindex, nofollow">
  <div class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto">
        <div class="mb-6">
          <a
            href="/applications"
            class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
            </svg>
            Back to Applications
          </a>
        </div>

        <div class="bg-white rounded p-5 sm:p-8">
          <header class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-4">Legal support application</h1>
            <p class="text-gray-600">
              Request legal assistance and representation for your case. Fill out the form below with accurate information.
            </p>
          </header>

          <FormStatus formId={formId} />

          <form
            id={formId}
            action="https://formspree.io/f/xqaaajae"
            method="POST"
            class="submission-form space-y-6"
            enctype="multipart/form-data"
            data-form-type="legal"
          >
            {/* Hidden Honeypot Field */}
            <input type="text" name="_gotcha" style="display:none" />

            {/* Form Subject */}
            <input
              type="hidden"
              name="_subject"
              value="New Legal Support Application"
            />

            {/* Personal Information */}
            <div class="space-y-6">
              <h2 class="text-xl font-semibold text-gray-900">Personal information</h2>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="firstName" class="block text-sm font-medium text-gray-700">Given name</label>
                  <input
                    type="text"
                    name="firstName"
                    id="firstName"
                    required
                    class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                  />
                </div>

                <div>
                  <label for="lastName" class="block text-sm font-medium text-gray-700">Family name</label>
                  <input
                    type="text"
                    name="lastName"
                    id="lastName"
                    required
                    class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                  />
                </div>
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-gray-700">Email address</label>
                <input
                  type="email"
                  name="email"
                  id="email"
                  required
                  class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                />
              </div>

              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700">Phone number</label>
                <input
                  type="tel"
                  name="phone"
                  id="phone"
                  required
                  class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                />
              </div>
            </div>

            {/* Case Information */}
            <div class="space-y-6 pt-6 border-t">
              <h2 class="text-xl font-semibold text-gray-900">Case information</h2>

              <div>
                <fieldset>
                  <legend class="text-sm font-medium text-gray-700">Type of legal assistance</legend>
                  <div class="mt-2 space-y-2">
                    <div class="flex items-start gap-3">
                      <input type="radio" id="caseType-1" name="caseType" value="documentation" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="caseType-1" class="text-sm text-gray-700">Documentation assistance</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="caseType-2" name="caseType" value="representation" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="caseType-2" class="text-sm text-gray-700">Legal representation</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="caseType-3" name="caseType" value="rights" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="caseType-3" class="text-sm text-gray-700">Rights education</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="caseType-4" name="caseType" value="advocacy" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="caseType-4" class="text-sm text-gray-700">Case advocacy</label>
                    </div>
                  </div>
                </fieldset>
              </div>

              <div>
                <label for="description" class="block text-sm font-medium text-gray-700">Case description</label>
                <p id="description-hint" class="mb-1 text-sm text-slate-600">Describe your case and the type of assistance you need</p>
                <textarea aria-describedby="description-hint"
                  name="description"
                  id="description"
                  rows="4"
                  required
                  class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                ></textarea>
              </div>

              <div>
                <fieldset>
                  <legend class="text-sm font-medium text-gray-700">Urgency level</legend>
                  <div class="mt-2 space-y-2">
                    <div class="flex items-start gap-3">
                      <input type="radio" id="urgency-1" name="urgency" value="low" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="urgency-1" class="text-sm text-gray-700">Low: can wait more than a month</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="urgency-2" name="urgency" value="medium" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="urgency-2" class="text-sm text-gray-700">Medium: need assistance within a month</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="urgency-3" name="urgency" value="high" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="urgency-3" class="text-sm text-gray-700">High: need assistance within a week</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="urgency-4" name="urgency" value="emergency" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="urgency-4" class="text-sm text-gray-700">Emergency: need immediate assistance</label>
                    </div>
                  </div>
                </fieldset>
              </div>
            </div>

            {/* File Upload Section */}
            <div class="space-y-6 pt-6 border-t">
              <h2 class="text-xl font-semibold text-gray-900">Supporting documents</h2>

              <div class="space-y-4">
                <div>
                  <label for="documentLinks" class="block text-sm font-medium text-gray-700">
                    Document links <span class="font-normal text-slate-600">(optional)</span></label>
                  <p class="text-sm text-gray-500 mb-2">
                    Upload your documents (ID, previous case files) to Google Drive or another file sharing service and paste the links below. Make sure the links are accessible.
                  </p>
                  <p id="documentLinks-hint" class="mb-1 text-sm text-slate-600">Paste your document links here, one per line</p>
                  <textarea aria-describedby="documentLinks-hint"
                    name="documentLinks"
                    id="documentLinks"
                    rows="3"
                    class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                  ></textarea>
                </div>
              </div>
            </div>

            {/* Consent Section */}
            <div class="space-y-6 pt-6 border-t">
              <h2 class="text-xl font-semibold text-gray-900">Consent</h2>

              <div class="space-y-4">
                <div class="flex items-start">
                  <div class="flex items-center h-5">
                    <input
                      type="checkbox"
                      name="consent"
                      id="consent"
                      required
                      class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500"
                    />
                  </div>
                  <div class="ml-3 text-sm">
                    <label for="consent" class="font-medium text-gray-700">Information consent</label>
                    <p class="text-gray-500">I consent to the collection and processing of my personal information for the purpose of receiving legal assistance.</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="pt-6">
              <button
                type="submit"
                class="min-h-[44px] w-full flex justify-center py-3 px-4 border border-transparent rounded text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
              >
                Submit Application
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  // Client-side form validation
  window.addEventListener('load', function() {
    const form = document.getElementById(formId);
    const formStatus = document.getElementById('form-status');

    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();

        const requiredFields = form.querySelectorAll('[required]');
        let isValid = true;

        requiredFields.forEach(field => {
          if (!(field as HTMLInputElement).value.trim()) {
            isValid = false;
            field.classList.add('border-red-500');
          } else {
            field.classList.remove('border-red-500');
          }
        });

        if (!isValid) {
          alert('Fill in all required fields.');
          return;
        }

        try {
          const formData = new FormData(form as HTMLFormElement);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            // Redirect to thank you page
            window.location.href = '/thank-you?type=legal';
          } else {
            throw new Error('Form submission failed');
          }
        } catch (error) {
          console.error('Error:', error);
          if (formStatus) {
            formStatus.textContent = 'There was an error submitting your form. Try again.';
            formStatus.classList.remove('hidden');
          }
        }
      });
    }
  });
</script>
