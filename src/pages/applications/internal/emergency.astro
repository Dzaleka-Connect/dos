---
import MainLayout from '../../../layouts/MainLayout.astro';
import FormStatus from '../../../components/applications/FormStatus.astro';

const formId = 'emergency-relief-form';
---

<MainLayout title="Emergency Relief Application" robots="noindex, nofollow">
  <div class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto">
        <div class="mb-6">
          <a
            href="/applications"
            class="inline-flex items-center text-gray-600 hover:text-gray-900 transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
            </svg>
            Back to Applications
          </a>
        </div>

        <div class="bg-white rounded p-5 sm:p-8">
          <header class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-4">Emergency relief application</h1>
            <p class="text-gray-600">
              Request emergency assistance for immediate needs. We prioritize cases based on urgency and available resources.
            </p>
          </header>

          <FormStatus formId={formId} />

          <form
            id={formId}
            action="https://formspree.io/f/xqaaajae"
            method="POST"
            class="submission-form space-y-6"
            enctype="multipart/form-data"
            data-netlify-recaptcha="true"
          >
            {/* Hidden Honeypot Field */}
            <input type="text" name="_gotcha" style="display:none" />

            {/* Form Subject */}
            <input
              type="hidden"
              name="_subject"
              value="New Emergency Relief Request"
            />

            {/* Personal Information */}
            <div class="space-y-6">
              <h2 class="text-xl font-semibold text-gray-900">Personal information</h2>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label for="firstName" class="block text-sm font-medium text-gray-700">Given name</label>
                  <input
                    type="text"
                    name="firstName"
                    id="firstName"
                    required
                    class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                  />
                </div>

                <div>
                  <label for="lastName" class="block text-sm font-medium text-gray-700">Family name</label>
                  <input
                    type="text"
                    name="lastName"
                    id="lastName"
                    required
                    class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                  />
                </div>
              </div>

              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700">Phone number (for urgent contact)</label>
                <input
                  type="tel"
                  name="phone"
                  id="phone"
                  required
                  class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                />
              </div>

              <div>
                <label for="location" class="block text-sm font-medium text-gray-700">Current location</label>
                <p id="location-hint" class="mb-1 text-sm text-slate-600">For example, Block/Section number, Dzaleka Refugee Camp</p>
                <input aria-describedby="location-hint"
                  type="text"
                  name="location"
                  id="location"
                  required
                  class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                />
              </div>

              <div>
                <label for="familySize" class="block text-sm font-medium text-gray-700">Number of family members</label>
                <input
                  type="number"
                  name="familySize"
                  id="familySize"
                  min="1"
                  required
                  class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                />
              </div>
            </div>

            {/* Emergency Details */}
            <div class="space-y-6 pt-6 border-t">
              <h2 class="text-xl font-semibold text-gray-900">Emergency details</h2>

              <div>
                <fieldset>
                  <legend class="text-sm font-medium text-gray-700">Type of assistance needed</legend>
                  <div class="mt-2 space-y-2">
                    <div class="flex items-start gap-3">
                      <input type="radio" id="assistanceType-1" name="assistanceType" value="food" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="assistanceType-1" class="text-sm text-gray-700">Food assistance</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="assistanceType-2" name="assistanceType" value="shelter" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="assistanceType-2" class="text-sm text-gray-700">Emergency shelter</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="assistanceType-3" name="assistanceType" value="medical" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="assistanceType-3" class="text-sm text-gray-700">Medical support</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="assistanceType-4" name="assistanceType" value="necessities" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="assistanceType-4" class="text-sm text-gray-700">Basic necessities</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="assistanceType-5" name="assistanceType" value="other" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="assistanceType-5" class="text-sm text-gray-700">Other (please specify)</label>
                    </div>
                  </div>
                </fieldset>
              </div>

              <div>
                <label for="situation" class="block text-sm font-medium text-gray-700">Emergency situation</label>
                <p id="situation-hint" class="mb-1 text-sm text-slate-600">Describe your emergency situation and immediate needs</p>
                <textarea aria-describedby="situation-hint"
                  name="situation"
                  id="situation"
                  rows="4"
                  required
                  class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                ></textarea>
              </div>

              <div>
                <fieldset>
                  <legend class="text-sm font-medium text-gray-700">Urgency level</legend>
                  <div class="mt-2 space-y-2">
                    <div class="flex items-start gap-3">
                      <input type="radio" id="urgency-1" name="urgency" value="immediate" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="urgency-1" class="text-sm text-gray-700">Immediate: need help within 24 hours</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="urgency-2" name="urgency" value="urgent" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="urgency-2" class="text-sm text-gray-700">Urgent: need help within 2-3 days</label>
                    </div>
                    <div class="flex items-start gap-3">
                      <input type="radio" id="urgency-3" name="urgency" value="soon" required class="mt-1 h-4 w-4 border-gray-300 text-primary-700 focus:ring-primary-600">
                      <label for="urgency-3" class="text-sm text-gray-700">Soon: need help within a week</label>
                    </div>
                  </div>
                </fieldset>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700">Current support</label>
                <div class="mt-2 space-y-2">
                  <div class="flex items-start">
                    <div class="flex items-center h-5">
                      <input aria-label="unhcr"
                        type="checkbox"
                        name="currentSupport"
                        value="unhcr"
                        class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500"
                      />
                    </div>
                    <div class="ml-3 text-sm">
                      <label class="text-gray-700">Receiving support from UNHCR</label>
                    </div>
                  </div>
                  <div class="flex items-start">
                    <div class="flex items-center h-5">
                      <input aria-label="ngo"
                        type="checkbox"
                        name="currentSupport"
                        value="ngo"
                        class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500"
                      />
                    </div>
                    <div class="ml-3 text-sm">
                      <label class="text-gray-700">Receiving support from other NGOs</label>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            {/* File Upload Section */}
            <div class="space-y-6 pt-6 border-t">
              <h2 class="text-xl font-semibold text-gray-900">Supporting documents</h2>

              <div class="space-y-4">
                <div>
                  <label for="documentLinks" class="block text-sm font-medium text-gray-700">
                    Document links <span class="font-normal text-slate-600">(optional)</span></label>
                  <p class="text-sm text-gray-500 mb-2">
                    Upload your documents to Google Drive or another file sharing service and paste the links below. Make sure the links are accessible.
                  </p>
                  <p id="documentLinks-hint" class="mb-1 text-sm text-slate-600">Paste your document links here, one per line</p>
                  <textarea aria-describedby="documentLinks-hint"
                    name="documentLinks"
                    id="documentLinks"
                    rows="3"
                    class="mt-1 block w-full rounded border-gray-300 focus:border-primary-500 focus:ring-primary-500"
                  ></textarea>
                </div>
              </div>
            </div>

            {/* Consent */}
            <div class="space-y-6 pt-6 border-t">
              <h2 class="text-xl font-semibold text-gray-900">Consent</h2>

              <div class="space-y-4">
                <div class="flex items-start">
                  <div class="flex items-center h-5">
                    <input
                      type="checkbox"
                      name="consent"
                      id="consent"
                      required
                      class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500"
                    />
                  </div>
                  <div class="ml-3 text-sm">
                    <label for="consent" class="font-medium text-gray-700">Information consent</label>
                    <p class="text-gray-500">I confirm that the information provided is accurate and consent to its use for processing my emergency assistance request.</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="pt-6">
              {/* reCAPTCHA */}
              <div class="mb-6" data-netlify-recaptcha="true"></div>

              <button
                type="submit"
                class="min-h-[44px] w-full flex justify-center py-3 px-4 border border-transparent rounded text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
              >
                Submit Emergency Request
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  // Client-side form validation
  window.addEventListener('load', function() {
    const form = document.getElementById(formId);
    const formStatus = document.getElementById('form-status');

    if (form) {
      form.addEventListener('submit', async function(e) {
        e.preventDefault();

        const requiredFields = form.querySelectorAll('[required]');
        let isValid = true;

        requiredFields.forEach(field => {
          if (!(field as HTMLInputElement).value.trim()) {
            isValid = false;
            field.classList.add('border-red-500');
          } else {
            field.classList.remove('border-red-500');
          }
        });

        if (!isValid) {
          alert('Fill in all required fields.');
          return;
        }

        try {
          const formData = new FormData(form as HTMLFormElement);
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            // Redirect to thank you page
            window.location.href = '/thank-you?type=emergency';
          } else {
            throw new Error('Form submission failed');
          }
        } catch (error) {
          console.error('Error:', error);
          if (formStatus) {
            formStatus.textContent = 'There was an error submitting your form. Try again.';
            formStatus.classList.remove('hidden');
          }
        }
      });
    }
  });
</script>
