---
import MainLayout from '../../layouts/MainLayout.astro';

const pageTitle = 'Easy Read: About Dzaleka | Dzaleka Online Services';
const description =
  'Clear and easy to read information about where Dzaleka is, when it started, and some key facts about the camp.';
const canonical = 'https://services.dzaleka.com/easy-read/about-dzaleka';
const checkedDate = '18 April 2026';

const factBlocks = [
  {
    title: 'What is Dzaleka?',
    text: 'Dzaleka is a refugee camp in Malawi.',
    detail: 'It is in Dowa District, about 41 kilometres from Lilongwe.',
  },
  {
    title: 'When did Dzaleka start?',
    text: 'Dzaleka opened in 1994.',
    detail: 'It was first planned for about 10,000 to 12,000 people.',
  },
  {
    title: 'How many people live there?',
    text: 'The camp is much larger now than it was meant to be.',
    detail:
      'As of March 2025, UNHCR counted 57,438 people living there.',
  },
  {
    title: 'Where do people come from?',
    text: 'People in Dzaleka come from several countries.',
    detail:
      'UNHCR lists the largest groups as people from the Democratic Republic of the Congo, Burundi, Rwanda, Somalia, and Ethiopia.',
  },
  {
    title: 'What do these words mean?',
    text: 'A refugee is a person who had to leave home to be safe.',
    detail: 'An asylum seeker is a person asking for protection in another country.',
  },
  {
    title: 'Do the numbers stay the same?',
    text: 'No. Population numbers can change over time.',
    detail: 'This guide uses public information, but the latest figures can go up or down.',
  },
];

const helpfulLinks = [
  { label: 'Back to Easy Read', href: '/easy-read' },
  { label: 'Language support', href: '/languages' },
  { label: 'Get help now', href: '/get-help-now' },
];

const sources = [
  {
    label: 'UNHCR Malawi country page',
    href: 'https://www.unhcr.org/us/where-we-work/countries/malawi',
    note:
      'Checked 18 April 2026 for the location, the distance from Lilongwe, and the March 2025 population figure (57,438).',
  },
  {
    label: 'UNHCR data portal for Malawi',
    href: 'https://data.unhcr.org/en/country/mwi',
    note:
      'Checked 18 April 2026 for the opening year and the original planned capacity.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description,
  url: canonical,
};
---

<MainLayout title={pageTitle} description={description} canonical={canonical} schema={schema}>
  <div class="bg-stone-50">
    <section class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Easy Read</p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            About Dzaleka
          </h1>
          <p class="mt-4 text-lg leading-8 text-slate-600">
            Simple facts about where Dzaleka is, when it opened, and how large it is now.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          {helpfulLinks.map((link) => (
            <a
              href={link.href}
              class="min-h-[44px] inline-flex items-center rounded border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="space-y-6">
        {factBlocks.map((block) => (
          <article class="rounded border border-slate-200 bg-white px-6 py-6 sm:px-8">
            <h2 class="text-2xl font-semibold text-slate-900">{block.title}</h2>
            <p class="mt-4 text-lg leading-8 text-slate-700">{block.text}</p>
            <p class="mt-2 text-lg leading-8 text-slate-700">{block.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">Where these facts came from</h2>
          <p class="mt-4 text-base leading-7 text-slate-600">
            Checked on {checkedDate}. The camp location and current population figure came from the
            UNHCR Malawi country page. The opening year and original planned capacity came from the
            UNHCR data portal for Malawi.
          </p>
        </div>

        <ul class="mt-8 space-y-4">
          {sources.map((source) => (
            <li class="border-t border-slate-300 pt-4">
              <a
                href={source.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-base font-semibold text-primary-700 hover:text-primary-800 hover:underline"
              >
                {source.label}
              </a>
              <p class="mt-2 max-w-4xl text-sm leading-6 text-slate-600">{source.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</MainLayout>
