---
import MainLayout from '../../layouts/MainLayout.astro';

const pageTitle = 'Easy Read: Getting help | Dzaleka Online Services';
const description =
  'Clear and easy to read guidance for getting urgent help, using hotlines, and knowing what to say when you ask for support.';
const canonical = 'https://services.dzaleka.com/easy-read/getting-help';
const checkedDate = '18 April 2026';

const urgentSteps = [
  'If someone is in danger, get help as soon as you can.',
  'Use the fastest safe option: call a hotline, go to a clinic, or go to a protection point.',
  'If the first number does not connect, try another safe contact.',
];

const contacts = [
  {
    title: 'Child helpline',
    value: '116',
    detail: 'Use this if a child is in danger, being harmed, or needs urgent protection.',
  },
  {
    title: 'GBV crisis line',
    value: '5600',
    detail: 'Use this for gender-based violence, trafficking, forced marriage, or abuse.',
  },
  {
    title: 'Youth helpline',
    value: '393',
    detail: 'Use this for confidential youth support and referrals.',
  },
  {
    title: 'UNHCR Malawi office',
    value: '+265 177 2155',
    detail: 'Use this for refugee status, documentation, or protection follow-up.',
  },
];

const nextPages = [
  {
    title: 'Get help now',
    description: 'The full urgent help page with hotline links and support routes.',
    href: '/get-help-now',
  },
  {
    title: 'Help Desk',
    description: 'Use this when the problem is not urgent and you need help finding the right page.',
    href: '/help-desk',
  },
  {
    title: 'New to Dzaleka',
    description: 'A practical page if you have just arrived and need first steps.',
    href: '/new-to-dzaleka',
  },
];

const beforeYouCall = [
  'Your name, if it is safe to give it.',
  'A safe phone number, if you have one.',
  'Your location or block.',
  'What happened and when it happened.',
  'What language you need.',
];

const sources = [
  {
    label: 'YONECO contact page',
    href: 'https://yoneco.org/information/',
    note: 'Accessed 18 April 2026 for the 116, 5600, and 393 hotline listings.',
  },
  {
    label: 'UNHCR Malawi country page',
    href: 'https://www.unhcr.org/us/where-we-work/countries/malawi',
    note: 'Accessed 18 April 2026 for the Malawi office phone number and working hours.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description,
  url: canonical,
};
---

<MainLayout title={pageTitle} description={description} canonical={canonical} schema={schema}>
  <main class="bg-stone-50">
    <section class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Easy Read</p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            Getting help
          </h1>
          <p class="mt-4 text-lg leading-8 text-slate-600">
            Simple steps for urgent help, helpline numbers, and what to say when you call.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/get-help-now"
            class="inline-flex items-center rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-800"
          >
            Open Get help now
          </a>
          <a
            href="/easy-read"
            class="inline-flex items-center rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
          >
            Back to Easy Read
          </a>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
      <section class="rounded-2xl border border-red-200 bg-red-50 px-6 py-6 sm:px-8">
        <h2 class="text-2xl font-semibold text-slate-900">If the problem is urgent</h2>
        <ul class="mt-4 space-y-3 text-base leading-7 text-slate-700">
          {urgentSteps.map((step) => (
            <li class="flex gap-3">
              <span class="mt-2 h-2.5 w-2.5 flex-none rounded-full bg-red-500"></span>
              <span>{step}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-8 rounded-2xl border border-slate-200 bg-white px-6 py-6 sm:px-8">
        <h2 class="text-2xl font-semibold text-slate-900">Call these contacts</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {contacts.map((contact) => (
            <article class="rounded-xl border border-slate-200 bg-slate-50 px-5 py-5">
              <h3 class="text-lg font-semibold text-slate-900">{contact.title}</h3>
              <p class="mt-2 text-2xl font-bold tracking-tight text-slate-900">{contact.value}</p>
              <p class="mt-2 text-sm leading-6 text-slate-600">{contact.detail}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="mt-8 rounded-2xl border border-slate-200 bg-white px-6 py-6 sm:px-8">
        <h2 class="text-2xl font-semibold text-slate-900">Know these things before you call</h2>
        <ul class="mt-4 space-y-3 text-base leading-7 text-slate-700">
          {beforeYouCall.map((item) => (
            <li class="flex gap-3">
              <span class="mt-2 h-2.5 w-2.5 flex-none rounded-full bg-slate-400"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-8 rounded-2xl border border-slate-200 bg-white px-6 py-6 sm:px-8">
        <h2 class="text-2xl font-semibold text-slate-900">Useful next pages</h2>
        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {nextPages.map((page) => (
            <a
              href={page.href}
              class="border-t border-slate-300 pt-4 transition-colors hover:border-slate-500"
            >
              <h3 class="text-lg font-semibold text-slate-900">{page.title}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">{page.description}</p>
            </a>
          ))}
        </div>
      </section>
    </section>

    <section class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">Contacts checked on {checkedDate}</h2>
          <p class="mt-4 text-base leading-7 text-slate-600">
            YONECO lists 116, 5600, and 393 on its public contact page. UNHCR Malawi lists the
            office phone number and working hours on its Malawi country page.
          </p>
        </div>

        <ul class="mt-8 space-y-4">
          {sources.map((source) => (
            <li class="border-t border-slate-300 pt-4">
              <a
                href={source.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-base font-semibold text-primary-700 hover:text-primary-800 hover:underline"
              >
                {source.label}
              </a>
              <p class="mt-2 max-w-4xl text-sm leading-6 text-slate-600">{source.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</MainLayout>
