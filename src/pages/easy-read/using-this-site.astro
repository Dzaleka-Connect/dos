---
import MainLayout from '../../layouts/MainLayout.astro';

const pageTitle = 'Easy Read: Using this website | Dzaleka Online Services';
const description =
  'Clear and easy to read guidance for using Start Here, Search, Services, Rights Navigator, and the Help Desk.';
const canonical = 'https://services.dzaleka.com/easy-read/using-this-site';

const steps = [
  {
    title: 'Use Start Here',
    text: 'Start Here helps you choose the section that matches your situation.',
    detail: 'Use it if you are not sure where to begin.',
    href: '/start-here',
  },
  {
    title: 'Use Search',
    text: 'Type the words you need.',
    detail: 'You can search for services, rights information, jobs, stories, and events.',
    href: '/search',
  },
  {
    title: 'Use Services',
    text: 'Services helps you find organisations and programmes.',
    detail: 'Use it for health, education, community services, and support organisations.',
    href: '/services',
  },
  {
    title: 'Use Rights Navigator',
    text: 'Rights Navigator helps with protection and legal information.',
    detail: 'Use it if you need legal help, reporting routes, or guidance about rights.',
    href: '/rights-navigator',
  },
  {
    title: 'Use Help Desk',
    text: 'Help Desk is for questions and site help.',
    detail: 'Use it when the problem is not urgent and you need someone to point you in the right direction.',
    href: '/help-desk',
  },
  {
    title: 'Use Get help now',
    text: 'Get help now is for urgent problems.',
    detail: 'Use it before the Help Desk if someone is in danger or needs fast support.',
    href: '/get-help-now',
  },
  {
    title: 'Use Language support',
    text: 'Most pages are still in English.',
    detail: 'If you need another language or simpler wording, use the Language support page or the Easy Read hub.',
    href: '/languages',
  },
];

const quickLinks = [
  { label: 'Back to Easy Read', href: '/easy-read' },
  { label: 'New to Dzaleka', href: '/new-to-dzaleka' },
  { label: 'Get help now', href: '/get-help-now' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description,
  url: canonical,
};
---

<MainLayout title={pageTitle} description={description} canonical={canonical} schema={schema}>
  <div class="bg-stone-50">
    <section class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Easy Read</p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            Using this website
          </h1>
          <p class="mt-4 text-lg leading-8 text-slate-600">
            This guide shows the main pages most people use first.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          {quickLinks.map((link) => (
            <a
              href={link.href}
              class="min-h-[44px] inline-flex items-center rounded border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="space-y-6">
        {steps.map((step) => (
          <article class="rounded border border-slate-200 bg-white px-6 py-6 sm:px-8">
            <h2 class="text-2xl font-semibold text-slate-900">{step.title}</h2>
            <p class="mt-4 text-lg leading-8 text-slate-700">{step.text}</p>
            <p class="mt-2 text-lg leading-8 text-slate-700">{step.detail}</p>
            <a
              href={step.href}
              class="min-h-[44px] mt-5 inline-flex items-center rounded border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-white"
            >
              Open page
            </a>
          </article>
        ))}
      </div>
    </section>
  </div>
</MainLayout>
