---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

const description = 'Documents, personal accounts and photographs tracing Dzaleka from political prison to refugee settlement.';
const periods = [
  { id: 'origins', dates: '1964–1994', title: 'Political prison', summary: 'Detention under Hastings Kamuzu Banda' },
  { id: 'transition', dates: '1994–2000', title: 'A refugee camp opens', summary: 'Arrival, resettlement and early accounts' },
  { id: 'refugee-era', dates: '2000 onwards', title: 'Community life', summary: 'Population growth, organisations and culture' },
];
const archiveRecords = [
  {
    "id": "origins",
    "records": [
      {
        "title": "State Department Cable",
        "excerpt": "In the Dzaleka detention camp near Dowa, north of Lilongwe, there are now over 3,000 male witnesses who have been incarcerated for a two-year period.",
        "source": "State Department Cable 1976-135342",
        "year": "1976"
      },
      {
        "title": "Africa Contemporary Record",
        "excerpt": "Grim conditions prevail at Dzaleka. A report smuggled from the camp in April 1976 said 70 people had died there—65 of them children.",
        "source": "Africa Contemporary Record, Annual Survey and Documents, 1978",
        "year": "1978"
      },
      {
        "title": "Jehovah's Witnesses Yearbook",
        "excerpt": "At the beginning of the service year, hundreds of our Malawi brothers were still in detention at Dzaleka, a camp in the north of the country, which had previously been used for political detainees.",
        "source": "1978 Yearbook of Jehovah's Witnesses",
        "year": "1978"
      }
    ]
  },
  {
    "id": "transition",
    "records": [
      {
        "title": "Personal Testimony: Joseph Ndereyimana",
        "excerpt": "On 23rd December 1995, we were taken to the Dzaleka Refugee Centre, outside Dowa. We were feeling happy in the hope that we might meet up with people we knew, and even hear news of our families whom we had left behind in Kashusha.",
        "source": "\"Walk this way: the journey of a Rwandan refugee\" (1999)",
        "year": "1995"
      },
      {
        "title": "Camp Organization",
        "excerpt": "Dzaleka Centre was organised so that people of each nationality had their own accommodation. For example, there was a single men's dormitory for the Rwandans, one for the Zaireans, one for the Somalis and so on.",
        "source": "Personal testimony, Joseph Ndereyimana",
        "year": "1995"
      },
      {
        "title": "Initial Population",
        "excerpt": "At the outset, there were only about one hundred and fifty refugees in this well-equipped centre: families were accommodated in houses while there were dormitories for the singles.",
        "source": "\"Walk this way: the journey of a Rwandan refugee\" (1999)",
        "year": "1995"
      }
    ]
  },
  {
    "id": "refugee-era",
    "records": [
      {
        "title": "State Department Cable",
        "excerpt": "The Dzaleka camp covers 201 hectares and UNHCR estimates it can hold a maximum of 9300 people. Once all refugees are relocated it will have a population approaching 8800 people and continues to get a steady stream of new refugees from the Congo.",
        "source": "State Department Cable 07LILONGWE803",
        "year": "2007"
      },
      {
        "title": "Academic Research",
        "excerpt": "This study inquired into the nature of identity among refugee youth living at Dzaleka Refugee Camp in Malawi. Aged between eighteen and twenty-four, the sample comprised of twenty-two female and thirty-eight male participants, from Burundi, the Democratic Republic of Congo, Rwanda, and Somalia.",
        "source": "Refugee Youth Identity Formation at Dzaleka Refugee Camp (2023)",
        "year": "2023"
      },
      {
        "title": "Food Security Study",
        "excerpt": "Food security and dietary diversity surveys were conducted with 300 women living in Dzaleka camp, Malawi. Ninety-one percent of women had severe food insecurity and women only ate on average 2–3 food groups the previous day.",
        "source": "Food insecurity and dietary diversity among women living in Dzaleka refugee camp, Malawi (2025)",
        "year": "2025"
      }
    ]
  }
];
const schema = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: 'Dzaleka Time Capsule', description,
  image: 'https://services.dzaleka.com/images/encyclopedia/entrance-sign.jpg',
  author: { '@type': 'Organization', name: 'Dzaleka Online Services' },
  mainEntityOfPage: 'https://services.dzaleka.com/dzaleka-time-capsule',
};
---
<MainLayout title="Dzaleka Time Capsule" description={description} image="/images/encyclopedia/entrance-sign.jpg" schema={schema}>
  <div class="history-page">
    <header class="border-b border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Dzaleka Time Capsule' }]} />
        <div class="mt-6 grid gap-8 lg:grid-cols-[minmax(0,1fr)_21rem] lg:gap-16">
          <div class="min-w-0">
            <p class="text-sm font-medium text-primary-700">History and memory</p>
            <h1 class="mt-3 text-primary-900">Dzaleka Time Capsule</h1>
            <p class="mt-4 max-w-xl text-lg leading-8 text-slate-700">{description}</p>
            <nav class="mt-8" aria-label="Historical periods">
              <ol class="border-t border-slate-300">
                {periods.map(period => <li class="border-b border-slate-300">
                  <a href={`#${period.id}`} class="group grid gap-1 py-4 sm:grid-cols-[8rem_1fr] sm:gap-4">
                    <span class="text-sm font-semibold tabular-nums text-primary-800">{period.dates}</span>
                    <span><span class="font-semibold text-slate-900 underline-offset-4 group-hover:underline">{period.title} <span aria-hidden="true">↓</span></span><span class="mt-1 block text-sm leading-6 text-slate-600">{period.summary}</span></span>
                  </a>
                </li>)}
              </ol>
            </nav>
          </div>
          <figure class="m-0 self-start">
            <img src="/images/encyclopedia/entrance-sign.jpg" alt="The entrance sign and gateway at Dzaleka Refugee Camp" width="1200" height="1600" fetchpriority="high" class="mx-auto max-h-[27rem] w-auto max-w-full rounded" />
            <figcaption class="mt-3 text-sm leading-6 text-slate-600">The entrance to Dzaleka Refugee Camp.<br />Dzaleka Online Services archive.</figcaption>
          </figure>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="border-b border-slate-200 py-5 text-sm leading-6 text-slate-600">This collection includes accounts of imprisonment, persecution and loss, and may name people who have died.</p>
      {periods.map((period, index) => <section id={period.id} aria-labelledby={`${period.id}-title`} class="history-period grid gap-5 border-b border-slate-200 py-10 lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-12 lg:py-14">
        <div class="lg:border-r lg:border-slate-200 lg:pr-6">
          <p class="text-sm text-slate-500">{String(index + 1).padStart(2, '0')}</p>
          <p class="mt-2 text-2xl font-semibold tabular-nums text-primary-900">{period.dates}</p>
        </div>
        <div class="min-w-0">
          <h2 id={`${period.id}-title`} class="text-2xl text-primary-900 sm:text-3xl">{period.title}</h2>
          {period.id === 'origins' && <div class="history-copy mt-5 max-w-3xl">
            <p>Before it became a refugee camp, Dzaleka was a political detention facility during the presidency of Hastings Kamuzu Banda. Political dissidents and religious minorities were held there.</p>
            <p>The records below describe the imprisonment of Jehovah’s Witnesses who refused to join the Malawi Congress Party, forced labour and conditions in the camp during the 1970s.</p>
          </div>}
          {period.id === 'transition' && <div class="history-copy mt-5 max-w-3xl">
            <p>The Government of Malawi and UNHCR established Dzaleka as a refugee camp in 1994, as conflicts displaced people across Rwanda, Burundi and the Democratic Republic of the Congo.</p>
            <p>Joseph Ndereyimana’s account records his arrival in December 1995, the accommodation arrangements and the small number of residents in the centre’s early years.</p>
            <p>The name Dzaleka comes from the Chichewa expression “N’dzaleka”, commonly translated as “I will not do it again”.</p>
          </div>}
          {period.id === 'refugee-era' && <>
            <div class="history-copy mt-5 max-w-3xl">
              <p>Dzaleka developed into a long-term settlement. Residents established businesses, schools, faith communities, cultural groups and refugee-led organisations.</p>
              <p>In 2007, the closure of Luwani camp brought approximately 3,000 people to Dzaleka. The population continued to grow, increasing pressure on housing, schools and health services. <a href="/encyclopedia/history-of-dzaleka">Read the history and its sources</a>.</p>
            </div>
            <figure class="mt-7 overflow-hidden rounded border border-slate-200">
              <img src="/images/tumaini_festival_cover.jpeg" alt="Crowds gathered around the stage at Tumaini Festival" width="960" height="540" loading="lazy" class="max-h-80 w-full object-cover" />
              <figcaption class="bg-slate-50 px-5 py-4 text-sm leading-6 text-slate-700"><a href="/encyclopedia/tumaini-festival" class="font-semibold text-primary-800 underline underline-offset-4">Tumaini Festival</a>, founded in 2014 by Trésor Nzengu Mpauni, known as Menes la Plume, brings residents, Malawian communities and visiting artists together.</figcaption>
            </figure>
            <div class="mt-7 max-w-3xl">
              <h3 class="text-lg font-semibold text-slate-900">Population in the records</h3>
              <dl class="mt-3 divide-y divide-slate-200 border-y border-slate-200 text-sm">
                <div class="grid grid-cols-[6rem_1fr] gap-4 py-3"><dt class="font-semibold">1995</dt><dd>About 150 residents at the outset, in Joseph Ndereyimana’s account.</dd></div>
                <div class="grid grid-cols-[6rem_1fr] gap-4 py-3"><dt class="font-semibold">2007</dt><dd>About 5,000 before the Luwani transfer; more than 8,000 afterwards.</dd></div>
                <div class="grid grid-cols-[6rem_1fr] gap-4 py-3"><dt class="font-semibold">End of 2024</dt><dd>More than 52,000 residents, reported by UNHCR.</dd></div>
              </dl>
              <p class="mt-3 text-sm text-slate-600">These are dated records. See <a href="/encyclopedia/population-and-demography" class="text-primary-800 underline underline-offset-4">population and demography</a> for sources and context.</p>
            </div>
          </>}
          <div class="mt-7 rounded border border-slate-200 bg-slate-50 px-5 sm:px-6">
            <h3 class="py-5 text-lg font-semibold text-slate-900">{period.id === 'transition' ? 'Personal accounts' : 'From the records'}</h3>
            {archiveRecords.find(era => era.id === period.id)?.records.map(record => <details class="border-t border-slate-200">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-4 text-primary-900"><span><span class="mr-3 text-sm font-medium text-slate-600">{record.year}</span><span class="font-semibold">{record.title}</span></span><span class="record-toggle shrink-0 text-lg" aria-hidden="true">+</span></summary>
              <div class="pb-5"><blockquote class="max-w-3xl border-l-2 border-primary-600 pl-4 text-base leading-7 text-slate-800">“{record.excerpt}”</blockquote><p class="mt-3 text-sm leading-6 text-slate-600">Source: {record.source}</p></div>
            </details>)}
          </div>
        </div>
      </section>)}
    </div>

    <section aria-labelledby="history-contribute" class="bg-primary-50">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[1fr_1fr] lg:px-8">
        <div><h2 id="history-contribute" class="text-2xl text-primary-900">Add to the community archive</h2><p class="mt-4 max-w-xl leading-7 text-slate-700">Share photographs, documents or a personal account of life in Dzaleka. Include the date, names and source where known.</p><p class="mt-3 text-sm leading-6 text-slate-600">Digital material only. For help with an upload, contact <a href="mailto:bakari@mail.dzaleka.com" class="text-primary-800 underline underline-offset-4">bakari@mail.dzaleka.com</a>.</p></div>
        <ul class="divide-y divide-primary-200 border-y border-primary-200">
          <li><a href="/photos/submit" class="block py-4 font-semibold text-primary-900 underline underline-offset-4">Share a photograph</a></li>
          <li><a href="/resources/submit" class="block py-4 font-semibold text-primary-900 underline underline-offset-4">Submit a document or record</a></li>
          <li><a href="/submit-voice" class="block py-4 font-semibold text-primary-900 underline underline-offset-4">Share a personal story</a></li>
        </ul>
      </div>
    </section>
    <nav aria-label="Related collections" class="mx-auto flex max-w-7xl flex-wrap gap-x-8 gap-y-3 px-4 py-6 text-sm sm:px-6 lg:px-8">
      <a href="/photos" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Photo Archive</a>
      <a href="/encyclopedia/history-of-dzaleka" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">History in the Encyclopedia</a>
      <a href="/resources" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Resource collection</a>
    </nav>
  </div>
</MainLayout>
<style>
  .history-copy { color: #334155; line-height: 1.85; }
  .history-copy p + p { margin-top: 1rem; }
  .history-copy a { color: #075985; text-decoration: underline; text-underline-offset: 4px; }
  .history-period { scroll-margin-top: 12rem; }
  summary::-webkit-details-marker { display: none; }
  details[open] .record-toggle { transform: rotate(45deg); }
  @media (max-width: 767px) { .history-period { scroll-margin-top: 7rem; } }
</style>
