---
import MainLayout from '../layouts/MainLayout.astro';
import { format } from 'date-fns';

// Comprehensive SEO metadata
const seo = {
  title: 'Dzaleka Time Capsule - Complete Historical Archive of Dzaleka Refugee Camp (1964-Present)',
  description: 'Explore the complete history of Dzaleka Refugee Camp from its origins as a political prison during Hastings Banda\'s regime to its transformation into a refugee settlement. Discover historical documents, personal testimonies, population data, and cultural achievements. A living archive documenting the journey from oppression to hope.',
  image: '/images/dzaleka-hero.jpeg',
  keywords: [
    'Dzaleka History',
    'Dzaleka Refugee Camp',
    'Dzaleka Historical Archive',
    'Malawi Political Prison',
    'Hastings Banda Regime',
    'Jehovah\'s Witnesses Persecution',
    'Refugee History Malawi',
    'Malawi History 1964-1994',
    'Dzaleka Political Prison',
    'Refugee Camp Transformation',
    'Dzaleka Population Growth',
    'Tumaini Festival Dzaleka',
    'Refugee Community Development',
    'Malawi Refugee History',
    'Dzaleka Time Capsule',
    'Historical Documents Dzaleka',
    'Refugee Testimonies',
    'Dzaleka Cultural Achievements',
    'Malawi Refugee Camp History',
    'Dzaleka Historical Timeline',
    'Refugee Settlement History',
    'Dzaleka Community Archive',
    'Malawi Political History',
    'Refugee Rights History',
    'Dzaleka Historical Research',
    'Refugee Camp Evolution',
    'Dzaleka Historical Records',
    'Malawi Refugee Policy',
    'Dzaleka Historical Documentation',
    'Refugee Community Building'
  ].join(', '),
  type: 'article',
  publishedDate: '2024-12-19',
  modifiedDate: new Date().toISOString().split('T')[0],
  author: 'Dzaleka Online Services',
  publisher: 'Dzaleka Online Services',
  section: 'History',
  tags: ['Dzaleka', 'Refugee Camp', 'History', 'Malawi', 'Political Prison', 'Refugee Rights', 'Cultural Heritage', 'Historical Archive'],
  canonical: 'https://services.dzaleka.com/dzaleka-time-capsule',
  ogType: 'article',
  twitterCard: 'summary_large_image',
  twitterCreator: '@dzalekaconnect',
  twitterSite: '@dzalekaconnect'
};

// Structured data for rich snippets
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Dzaleka Time Capsule - Complete Historical Archive of Dzaleka Refugee Camp (1964-Present)",
  "description": seo.description,
  "image": {
    "@type": "ImageObject",
    "url": "https://services.dzaleka.com/images/dzaleka-hero.jpeg",
    "width": 1200,
    "height": 630
  },
  "author": {
    "@type": "Organization",
    "name": "Dzaleka Online Services",
    "url": "https://services.dzaleka.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Dzaleka Online Services",
    "logo": {
      "@type": "ImageObject",
      "url": "https://services.dzaleka.com/images/logo.png"
    }
  },
  "datePublished": seo.publishedDate,
  "dateModified": seo.modifiedDate,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": seo.canonical
  },
  "keywords": seo.keywords,
  "articleSection": "History",
  "inLanguage": "en",
  "isAccessibleForFree": true,
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "h2", "h3", "p"]
  }
};

// Additional structured data for historical place
const placeStructuredData = {
  "@context": "https://schema.org",
  "@type": "Place",
  "name": "Dzaleka Refugee Camp",
  "alternateName": "Dzaleka",
  "description": "A refugee camp in Malawi that was originally a political prison during the Hastings Banda regime (1964-1994) and later transformed into a refugee settlement.",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Dowa",
    "addressRegion": "Central Region",
    "addressCountry": "MW"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -13.7167,
    "longitude": 33.9333
  },
  "hasMap": "https://maps.google.com/?q=Dzaleka+Refugee+Camp,+Malawi",
  "sameAs": [
    "https://en.wikipedia.org/wiki/Dzaleka_Refugee_Camp",
    "https://www.unhcr.org/countries/malawi"
  ]
};

// Breadcrumb structured data
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://services.dzaleka.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "History",
      "item": "https://services.dzaleka.com/data"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "Dzaleka Time Capsule",
      "item": seo.canonical
    }
  ]
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description}
  image={seo.image}
  keywords={seo.keywords}
  type={seo.type}
  publishedDate={seo.publishedDate}
  modifiedDate={seo.modifiedDate}
  author={seo.author}
  publisher={seo.publisher}
  section={seo.section}
  tags={seo.tags}
  canonical={seo.canonical}
  ogType={seo.ogType}
  twitterCard={seo.twitterCard}
  twitterCreator={seo.twitterCreator}
  twitterSite={seo.twitterSite}
  structuredData={[structuredData, placeStructuredData, breadcrumbStructuredData]}
>
  <main class="bg-white">
    <!-- Hero Section -->
    <div class="relative bg-black text-white py-24 overflow-hidden">
      <!-- Background Pattern -->
      <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 25% 25%, white 2px, transparent 2px), radial-gradient(circle at 75% 75%, white 2px, transparent 2px); background-size: 50px 50px;"></div>
      </div>
      
      <div class="relative container mx-auto px-4 text-center">
        <div class="max-w-3xl mx-auto">
          <div class="inline-block mb-8">
            <div class="w-16 h-1 bg-white mx-auto mb-4"></div>
            <span class="text-sm uppercase tracking-wider text-white/70">Historical Archive</span>
          </div>
          
          <h1 class="text-4xl md:text-6xl font-light mb-8 leading-tight">
            Dzaleka<br>
            <span class="font-bold">Time Capsule</span>
          </h1>
          
          <p class="text-lg md:text-xl text-white/80 mb-8 max-w-2xl mx-auto leading-relaxed">
            A living archive documenting the transformation from political prison to refugee settlement
          </p>
          
          <div class="flex flex-wrap justify-center gap-6 text-sm">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-white/60 rounded-full"></div>
              <span class="text-white/70">1964-1994</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-white/60 rounded-full"></div>
              <span class="text-white/70">1994-2000</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 bg-white/60 rounded-full"></div>
              <span class="text-white/70">2000-Present</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Timeline Navigation -->
    <div class="bg-white border-b sticky top-0 z-10">
      <div class="container mx-auto px-4 py-6">
        <div class="flex justify-center space-x-8">
          <a href="#origins" class="text-sm font-medium text-gray-600 hover:text-black border-b-2 border-transparent hover:border-black transition-colors pb-2">
            Origins
          </a>
          <a href="#transition" class="text-sm font-medium text-gray-600 hover:text-black border-b-2 border-transparent hover:border-black transition-colors pb-2">
            Transition
          </a>
          <a href="#refugee-era" class="text-sm font-medium text-gray-600 hover:text-black border-b-2 border-transparent hover:border-black transition-colors pb-2">
            Refugee Era
          </a>
        </div>
      </div>
    </div>

    <!-- Origins Section -->
    <section id="origins" class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-16">
            <div class="inline-block mb-4">
              <span class="text-sm uppercase tracking-wider text-gray-500">1964-1994</span>
            </div>
            <h2 class="text-3xl md:text-5xl font-light mb-6">
              Origins:<br>
              <span class="font-bold">Political Prison Era</span>
            </h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
              The dark chapter of Dzaleka as a detention center during the presidency of Hastings Kamuzu Banda
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
            <div class="space-y-6">
              <div class="border-l-4 border-red-500 pl-8">
                <h3 class="text-2xl font-bold text-gray-900 mb-4">Political Prison Facility</h3>
                <p class="text-gray-700 mb-6 leading-relaxed">
                  Dzaleka was specifically chosen as a political prison due to its colder climate, where prisoners were not accustomed to the weather and were denied basic comforts like blankets.
                </p>
                <ul class="space-y-3 text-gray-600">
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-red-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Capacity: Up to 6,000 inmates</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-red-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Harsh conditions and forced labor</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-red-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Sisal fiber production for fabric industry</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-red-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Political dissidents and religious minorities</span>
                  </li>
                </ul>
              </div>
            </div>

            <div class="space-y-6">
              <div class="border-l-4 border-orange-500 pl-8">
                <h3 class="text-2xl font-bold text-gray-900 mb-4">Jehovah's Witnesses Persecution</h3>
                <p class="text-gray-700 mb-6 leading-relaxed">
                  The facility became notorious for the imprisonment of Jehovah's Witnesses who refused to join the Malawi Congress Party.
                </p>
                <ul class="space-y-3 text-gray-600">
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-orange-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Over 3,000 male Witnesses imprisoned</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-orange-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Women held in separate camps</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-orange-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Forced labor and torture reported</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-orange-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Children died from malnutrition</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Historical Documents -->
          <div class="border-t border-gray-200 pt-16">
            <div class="text-center mb-12">
              <h3 class="text-2xl font-bold text-gray-900 mb-4">Historical Documents</h3>
              <p class="text-gray-600">Primary sources from 1976-1978</p>
            </div>
            
            <div class="space-y-8">
              <div class="border-l-4 border-gray-300 pl-8">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-sm font-bold text-gray-600">1976</span>
                  </div>
                  <div class="flex-1">
                    <h4 class="font-semibold text-gray-900 mb-2">State Department Cable</h4>
                    <blockquote class="text-gray-700 italic mb-3 text-lg">
                      "In the Dzaleka detention camp near Dowa, north of Lilongwe, there are now over 3,000 male witnesses who have been incarcerated for a two-year period."
                    </blockquote>
                    <span class="text-sm text-gray-500">Source: State Department Cable 1976-135342</span>
                  </div>
                </div>
              </div>

              <div class="border-l-4 border-gray-300 pl-8">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-sm font-bold text-gray-600">1978</span>
                  </div>
                  <div class="flex-1">
                    <h4 class="font-semibold text-gray-900 mb-2">Africa Contemporary Record</h4>
                    <blockquote class="text-gray-700 italic mb-3 text-lg">
                      "Grim conditions prevail at Dzaleka. A report smuggled from the camp in April 1976 said 70 people had died there—65 of them children."
                    </blockquote>
                    <span class="text-sm text-gray-500">Source: Africa Contemporary Record, Annual Survey and Documents, 1978</span>
                  </div>
                </div>
              </div>

              <div class="border-l-4 border-gray-300 pl-8">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-sm font-bold text-gray-600">1978</span>
                  </div>
                  <div class="flex-1">
                    <h4 class="font-semibold text-gray-900 mb-2">Jehovah's Witnesses Yearbook</h4>
                    <blockquote class="text-gray-700 italic mb-3 text-lg">
                      "At the beginning of the service year, hundreds of our Malawi brothers were still in detention at Dzaleka, a camp in the north of the country, which had previously been used for political detainees."
                    </blockquote>
                    <span class="text-sm text-gray-500">Source: 1978 Yearbook of Jehovah's Witnesses</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Transition Section -->
    <section id="transition" class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-16">
            <div class="inline-block mb-4">
              <span class="text-sm uppercase tracking-wider text-gray-500">1994-2000</span>
            </div>
            <h2 class="text-3xl md:text-5xl font-light mb-6">
              Transition:<br>
              <span class="font-bold">From Prison to Refugee Camp</span>
            </h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
              The transformation following the end of Banda's regime and the establishment of refugee services
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
            <div class="space-y-6">
              <div class="border-l-4 border-blue-500 pl-8">
                <h3 class="text-2xl font-bold text-gray-900 mb-4">End of Banda Era</h3>
                <p class="text-gray-700 mb-6 leading-relaxed">
                  With the fall of Hastings Kamuzu Banda's regime in 1994, the political prison was closed and the facility was repurposed.
                </p>
                <ul class="space-y-3 text-gray-600">
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-blue-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Democratic transition in Malawi</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-blue-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Closure of political detention facilities</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-blue-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>International pressure for reform</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-blue-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>UNHCR involvement begins</span>
                  </li>
                </ul>
              </div>
            </div>

            <div class="space-y-6">
              <div class="border-l-4 border-green-500 pl-8">
                <h3 class="text-2xl font-bold text-gray-900 mb-4">Refugee Camp Establishment</h3>
                <p class="text-gray-700 mb-6 leading-relaxed">
                  The facility was officially established as a refugee camp by the Government of Malawi and UNHCR in 1994.
                </p>
                <ul class="space-y-3 text-gray-600">
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-green-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Initial capacity: 10,000-12,000 people</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-green-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Refugees from Great Lakes region</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-green-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Burundi, Rwanda, DRC conflicts</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-green-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Humanitarian infrastructure development</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Early Refugee Period Documentation -->
          <div class="border-t border-gray-200 pt-16">
            <div class="text-center mb-12">
              <h3 class="text-2xl font-bold text-gray-900 mb-4">Early Refugee Period</h3>
              <p class="text-gray-600">Personal testimonies from 1995-1996</p>
            </div>
            
            <div class="space-y-8">
              <div class="border-l-4 border-gray-300 pl-8">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-sm font-bold text-gray-600">1995</span>
                  </div>
                  <div class="flex-1">
                    <h4 class="font-semibold text-gray-900 mb-2">Personal Testimony: Joseph Ndereyimana</h4>
                    <blockquote class="text-gray-700 italic mb-3 text-lg">
                      "On 23rd December 1995, we were taken to the Dzaleka Refugee Centre, outside Dowa. We were feeling happy in the hope that we might meet up with people we knew, and even hear news of our families whom we had left behind in Kashusha."
                    </blockquote>
                    <span class="text-sm text-gray-500">Source: "Walk this way: the journey of a Rwandan refugee" (1999)</span>
                  </div>
                </div>
              </div>

              <div class="border-l-4 border-gray-300 pl-8">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-sm font-bold text-gray-600">1995</span>
                  </div>
                  <div class="flex-1">
                    <h4 class="font-semibold text-gray-900 mb-2">Camp Organization</h4>
                    <blockquote class="text-gray-700 italic mb-3 text-lg">
                      "Dzaleka Centre was organised so that people of each nationality had their own accommodation. For example, there was a single men's dormitory for the Rwandans, one for the Zaireans, one for the Somalis and so on."
                    </blockquote>
                    <span class="text-sm text-gray-500">Source: Personal testimony, Joseph Ndereyimana</span>
                  </div>
                </div>
              </div>

              <div class="border-l-4 border-gray-300 pl-8">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-sm font-bold text-gray-600">1995</span>
                  </div>
                  <div class="flex-1">
                    <h4 class="font-semibold text-gray-900 mb-2">Initial Population</h4>
                    <blockquote class="text-gray-700 italic mb-3 text-lg">
                      "At the outset, there were only about one hundred and fifty refugees in this well-equipped centre: families were accommodated in houses while there were dormitories for the singles."
                    </blockquote>
                    <span class="text-sm text-gray-500">Source: "Walk this way: the journey of a Rwandan refugee" (1999)</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Name Origin -->
          <div class="border-t border-gray-200 pt-16">
            <div class="text-center mb-12">
              <h3 class="text-2xl font-bold text-gray-900 mb-4">The Name "Dzaleka"</h3>
              <p class="text-gray-600">Meaning and significance</p>
            </div>
            
            <div class="max-w-3xl mx-auto">
              <p class="text-lg text-gray-700 mb-8 leading-relaxed">
                The name Dzaleka comes from the Chichewa phrase "N'dzaleka," meaning "I will never do it again." This name carries profound significance, representing both the hope for a better future and the acknowledgment of past suffering.
              </p>
              <div class="border-l-4 border-gray-400 pl-8">
                <blockquote class="text-gray-700 italic text-lg">
                  "The name serves as a reminder of the transformation from a place of oppression to a place of refuge and hope."
                </blockquote>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Refugee Era Section -->
    <section id="refugee-era" class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
          <div class="text-center mb-16">
            <div class="inline-block mb-4">
              <span class="text-sm uppercase tracking-wider text-gray-500">2000-Present</span>
            </div>
            <h2 class="text-3xl md:text-5xl font-light mb-6">
              Refugee Era:<br>
              <span class="font-bold">Community Development</span>
            </h2>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">
              The evolution of Dzaleka into a vibrant, self-sustaining community despite ongoing challenges
            </p>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
            <div class="space-y-6">
              <div class="border-l-4 border-purple-500 pl-8">
                <h3 class="text-2xl font-bold text-gray-900 mb-4">Population Growth</h3>
                <p class="text-gray-700 mb-6 leading-relaxed">
                  From its initial capacity, Dzaleka now accommodates over 52,000 refugees and asylum seekers.
                </p>
                <ul class="space-y-3 text-gray-600">
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-purple-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Democratic Republic of Congo: 62%</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-purple-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Burundi: 19%</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-purple-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Rwanda: 7%</span>
                  </li>
                  <li class="flex items-start gap-3">
                    <div class="w-1.5 h-1.5 bg-purple-500 rounded-full mt-2 flex-shrink-0"></div>
                    <span>Other nationalities: 12%</span>
                  </li>
                </ul>
              </div>
            </div>

            <div class="space-y-6">
              <div class="border-l-4 border-indigo-500 pl-8">
                <h3 class="text-2xl font-bold text-gray-900 mb-4">Community Development</h3>
                <p class="text-gray-700 mb-6 leading-relaxed">
                  Despite challenges, residents have created a vibrant community with businesses, schools, and cultural initiatives.
                </p>
