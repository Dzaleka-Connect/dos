---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import StoryCard from '../../components/StoryCard.astro';

const title = "Photo Stories | Dzaleka Heritage Archive";

let stories = [];
try {
  stories = await getCollection('stories');
} catch (error) {
  console.error('Error loading stories:', error);
}

// Get unique tags from all stories
const allTags = [...new Set(stories.flatMap(story => story.data.tags))];
---

<MainLayout title={title}>
  <main class="min-h-screen bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <header class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Photo Stories</h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Explore narrative journeys through Dzaleka Refugee Camp, combining powerful imagery with compelling stories.
        </p>
      </header>

      <div class="mb-8">
        <div class="flex flex-col sm:flex-row gap-4 items-center justify-between">
          <div class="w-full sm:w-96">
            <input
              type="text"
              id="search"
              placeholder="Search stories..."
              class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>
          
          <div class="flex flex-wrap gap-2">
            {allTags.map(tag => (
              <button
                class="px-3 py-1 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-full hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-blue-500"
                data-tag={tag}
              >
                {tag}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="stories-grid">
        {stories.map(story => <StoryCard story={story} />)}
      </div>

      {!stories.length && (
        <div class="text-center py-12">
          <p class="text-gray-600">
            No stories available at the moment. Please check back later.
          </p>
        </div>
      )}
    </div>
  </main>
</MainLayout>

<script>
  // Search functionality
  const searchInput = document.getElementById('search');
  const storiesGrid = document.getElementById('stories-grid');
  const storyCards = storiesGrid?.querySelectorAll('article');
  const tagButtons = document.querySelectorAll('[data-tag]');
  
  let activeTags = new Set();
  
  function filterStories() {
    const searchTerm = searchInput?.value.toLowerCase() || '';
    
    storyCards?.forEach(card => {
      const title = card.querySelector('h2')?.textContent?.toLowerCase() || '';
      const description = card.querySelector('p')?.textContent?.toLowerCase() || '';
      const tags = Array.from(card.querySelectorAll('[data-tag]')).map(tag => tag.textContent?.toLowerCase());
      
      const matchesSearch = title.includes(searchTerm) || description.includes(searchTerm);
      const matchesTags = activeTags.size === 0 || tags.some(tag => activeTags.has(tag));
      
      card.style.display = matchesSearch && matchesTags ? 'block' : 'none';
    });
  }
  
  searchInput?.addEventListener('input', filterStories);
  
  tagButtons.forEach(button => {
    button.addEventListener('click', () => {
      const tag = button.dataset.tag?.toLowerCase();
      if (!tag) return;
      
      if (activeTags.has(tag)) {
        activeTags.delete(tag);
        button.classList.remove('bg-blue-50', 'text-blue-600', 'border-blue-200');
        button.classList.add('bg-white', 'text-gray-700', 'border-gray-300');
      } else {
        activeTags.add(tag);
        button.classList.remove('bg-white', 'text-gray-700', 'border-gray-300');
        button.classList.add('bg-blue-50', 'text-blue-600', 'border-blue-200');
      }
      
      filterStories();
    });
  });
</script> 