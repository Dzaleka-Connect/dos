---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { format } from 'date-fns';

type StoryImage = {
  image: string;
  caption?: string;
  text?: string;
  photographer?: string;
};

export async function getStaticPaths() {
  const stories = await getCollection('stories');
  return stories.map(story => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const { title, description, date, coverImage, author, tags, content, source, photos } = story.data;
const storyTags = tags ?? [];
const storySections = content ?? [];
const storyPhotos = photos ?? [];
const storyImages: StoryImage[] = [...storyPhotos, ...storySections
  .filter((section) => Boolean(section.image))
  .map((section) => ({
    image: section.image!,
    caption: section.caption,
  }))];
const uniqueStoryImages = storyImages.reduce<StoryImage[]>((images, photo) => {
  if (!photo.image) return images;

  const existingPhoto = images.find((item) => item.image === photo.image);
  if (existingPhoto) {
    existingPhoto.caption = existingPhoto.caption || photo.caption;
    existingPhoto.text = existingPhoto.text || photo.text;
    existingPhoto.photographer = existingPhoto.photographer || photo.photographer;
    return images;
  }

  images.push({ ...photo });
  return images;
}, []);
const galleryPhotos = uniqueStoryImages.filter((photo) => photo.image !== coverImage);
const photoCount = uniqueStoryImages.length;
const leadPhotographer = uniqueStoryImages.find((photo) => photo.photographer)?.photographer;
const coverPhoto = uniqueStoryImages.find((photo) => photo.image === coverImage) ?? uniqueStoryImages[0];
const formattedDate = format(new Date(date), 'MMMM d, yyyy');
---

<MainLayout title={`${title} | Dzaleka Online Services`}>
  <article class="min-h-screen bg-gray-50">
    <section class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <nav class="mb-4 text-sm text-gray-500">
          <a href="/" class="hover:text-primary-700">Home</a>
          <span class="mx-2">/</span>
          <a href="/stories" class="hover:text-primary-700">Stories</a>
          <span class="mx-2">/</span>
          <span class="text-gray-900">{title}</span>
        </nav>

        <figure class="mt-5 overflow-hidden rounded-xl border border-gray-200 bg-white">
          <div class="bg-gray-100">
            <img
              src={coverImage}
              alt={coverPhoto?.caption || title}
              class="w-full h-auto"
            />
          </div>
          {(coverPhoto?.caption || coverPhoto?.photographer) && (
            <figcaption class="border-t border-gray-200 px-4 py-3 sm:px-5">
              {coverPhoto?.caption && (
                <p class="text-sm leading-6 text-gray-700">{coverPhoto.caption}</p>
              )}
              {coverPhoto?.photographer && (
                <p class="mt-2 text-xs font-medium uppercase tracking-[0.18em] text-gray-500">
                  Photo by {coverPhoto.photographer}
                </p>
              )}
            </figcaption>
          )}
        </figure>

        <div class="mt-6 max-w-4xl">
          <div class="flex flex-wrap gap-2">
            <span class="rounded-md bg-primary-50 px-2.5 py-1 text-xs font-medium text-primary-700">
              Photo story
            </span>
            {source && (
              <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">
                Adapted source
              </span>
            )}
            {storyTags.map((tag) => (
              <span class="rounded-md bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">
                {tag}
              </span>
            ))}
          </div>

          <h1 class="mt-4 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">
            {title}
          </h1>
          <p class="mt-3 max-w-3xl text-lg leading-8 text-gray-600">
            {description}
          </p>

          <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-600">
            <p><span class="font-medium text-gray-900">Published:</span> {formattedDate}</p>
            <p><span class="font-medium text-gray-900">Author:</span> {author.name}</p>
            {author.role && <p>{author.role}</p>}
            <p><span class="font-medium text-gray-900">Images:</span> {photoCount}</p>
            <p><span class="font-medium text-gray-900">Photo credit:</span> {leadPhotographer || author.name}</p>
          </div>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="space-y-8">
        {galleryPhotos.length > 0 && (
          <section class="rounded-xl border border-gray-200 bg-white p-4">
            <div class="mb-3 flex items-center justify-between gap-4">
              <div>
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary-700">Photo log</p>
                <h2 class="mt-1 text-base font-semibold text-gray-900">Story images</h2>
              </div>
              <div class="flex items-center gap-3">
                <p class="text-xs uppercase tracking-[0.18em] text-gray-500">{galleryPhotos.length} image{galleryPhotos.length === 1 ? '' : 's'}</p>
                {galleryPhotos.length > 4 && (
                  <div class="flex items-center gap-2">
                    <button
                      type="button"
                      class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-300 text-sm text-gray-700 transition hover:border-primary-300 hover:text-primary-700 disabled:cursor-not-allowed disabled:opacity-40"
                      data-photo-scroll-prev
                      aria-label="Show previous photos"
                    >
                      ←
                    </button>
                    <button
                      type="button"
                      class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-300 text-sm text-gray-700 transition hover:border-primary-300 hover:text-primary-700 disabled:cursor-not-allowed disabled:opacity-40"
                      data-photo-scroll-next
                      aria-label="Show next photos"
                    >
                      →
                    </button>
                  </div>
                )}
              </div>
            </div>

            <div
              class="photo-log-track flex gap-3 overflow-x-auto scroll-smooth pb-2"
              data-photo-scroll-track
            >
              {galleryPhotos.map((photo, index) => (
                <button
                  type="button"
                  class="w-[calc(100%-0rem)] shrink-0 overflow-hidden rounded-lg border border-gray-200 bg-white text-left transition hover:border-primary-300 hover:shadow-sm sm:w-[calc(50%-0.375rem)] xl:w-[calc(25%-0.5625rem)]"
                  data-photo-trigger
                  data-photo-src={photo.image}
                  data-photo-alt={photo.caption || `${title} photo ${index + 1}`}
                  data-photo-caption={photo.caption || ''}
                  data-photo-credit={photo.photographer ? `Photo by ${photo.photographer}` : ''}
                >
                  <div class="aspect-[4/3] overflow-hidden bg-gray-100">
                    <img
                      src={photo.image}
                      alt={photo.caption || `${title} photo ${index + 1}`}
                      class="h-full w-full object-cover"
                      loading="lazy"
                    />
                  </div>
                  <div class="space-y-1 px-3 py-2.5">
                    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-500">
                      Photo {String(index + 1).padStart(2, '0')}
                    </p>
                    {photo.caption && <p class="text-xs leading-5 text-gray-700">{photo.caption}</p>}
                  </div>
                </button>
              ))}
            </div>
          </section>
        )}

        <div class="space-y-6">
          {storySections.map((section, index) => (
            <section class="overflow-hidden rounded-xl border border-gray-200 bg-white">
              {section.image && (
                <div class="bg-gray-100">
                  <img
                    src={section.image}
                    alt={section.caption || `Image ${index + 1}`}
                    class="max-h-[640px] w-full object-cover"
                  />
                </div>
              )}
              <div class="p-5 sm:p-6">
                <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-100 pb-4">
                  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gray-500">
                    Section {String(index + 1).padStart(2, '0')}
                  </p>
                  {section.image && (
                    <p class="text-xs font-medium uppercase tracking-[0.18em] text-gray-400">
                      Photo Essay
                    </p>
                  )}
                </div>

                {section.caption && (
                  <p class="mt-4 max-w-3xl text-sm italic leading-6 text-gray-500">
                    {section.caption}
                  </p>
                )}

                {section.text && (
                  <div class="mt-4 max-w-3xl text-base leading-8 text-gray-700">
                    <p>{section.text}</p>
                  </div>
                )}
              </div>
            </section>
          ))}
        </div>

        {(source || storyTags.length > 0) && (
          <section class="border-t border-gray-200 pt-6">
            <div class="grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
              <div class="space-y-5">
                {source && (
                  <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary-700">Source note</p>
                    <p class="mt-3 text-sm leading-6 text-gray-700">
                      <a
                        href={source.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium underline decoration-gray-300 underline-offset-4 hover:text-primary-700"
                      >
                        {source.title}
                      </a>
                    </p>
                    {source.note && <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600">{source.note}</p>}
                  </div>
                )}

                {storyTags.length > 0 && (
                  <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary-700">Tags</p>
                    <div class="mt-3 flex flex-wrap gap-2">
                      {storyTags.map((tag) => (
                        <span class="text-sm text-gray-600">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
              </div>

              <div>
                <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary-700">Share</p>
                <div class="mt-3 flex flex-wrap gap-3">
                  <button
                    class="text-sm font-medium text-gray-700 underline decoration-gray-300 underline-offset-4 transition hover:text-primary-700"
                    data-share="twitter"
                    aria-label="Share on Twitter"
                  >
                    Twitter
                  </button>
                  <button
                    class="text-sm font-medium text-gray-700 underline decoration-gray-300 underline-offset-4 transition hover:text-primary-700"
                    data-share="facebook"
                    aria-label="Share on Facebook"
                  >
                    Facebook
                  </button>
                  <button
                    class="text-sm font-medium text-gray-700 underline decoration-gray-300 underline-offset-4 transition hover:text-primary-700"
                    data-share="whatsapp"
                    aria-label="Share on WhatsApp"
                  >
                    WhatsApp
                  </button>
                </div>
              </div>
            </div>
          </section>
        )}
      </div>
    </div>

    <dialog id="photo-log-viewer" class="m-auto w-full max-w-6xl rounded-none bg-transparent p-0 backdrop:bg-black/80">
      <div class="flex min-h-screen items-center justify-center p-4">
        <div class="w-full overflow-hidden rounded-xl bg-white shadow-2xl">
          <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3">
            <p class="text-sm font-semibold text-gray-900">Photo preview</p>
            <button
              type="button"
              class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 transition hover:border-primary-300 hover:text-primary-700"
              data-photo-close
            >
              Close
            </button>
          </div>
          <div class="bg-gray-100 p-4">
            <img
              id="photo-log-viewer-image"
              src=""
              alt=""
              class="max-h-[80vh] w-full object-contain"
            />
          </div>
          <div class="border-t border-gray-200 px-4 py-4 sm:px-5">
            <p id="photo-log-viewer-caption" class="text-sm leading-6 text-gray-700"></p>
            <p id="photo-log-viewer-credit" class="mt-2 text-xs font-medium uppercase tracking-[0.18em] text-gray-500"></p>
          </div>
        </div>
      </div>
    </dialog>
  </article>
</MainLayout>

<script>
  // Share functionality
  const shareButtons = document.querySelectorAll('[data-share]');
  const title = document.querySelector('h1')?.textContent || '';
  const url = window.location.href;

  shareButtons.forEach(button => {
    button.addEventListener('click', () => {
      const platform = button.getAttribute('data-share');
      let shareUrl = '';

      switch (platform) {
        case 'twitter':
          shareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;
          break;
        case 'facebook':
          shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
          break;
        case 'whatsapp':
          shareUrl = `https://wa.me/?text=${encodeURIComponent(title + ' ' + url)}`;
          break;
      }

      if (shareUrl) {
        window.open(shareUrl, '_blank');
      }
    });
  });

  // Photo log viewer
  const photoDialog = document.getElementById('photo-log-viewer');
  const photoImage = document.getElementById('photo-log-viewer-image');
  const photoCaption = document.getElementById('photo-log-viewer-caption');
  const photoCredit = document.getElementById('photo-log-viewer-credit');
  const photoScrollTrack = document.querySelector('[data-photo-scroll-track]');
  const photoScrollPrev = document.querySelector('[data-photo-scroll-prev]');
  const photoScrollNext = document.querySelector('[data-photo-scroll-next]');
  const photoTriggers = document.querySelectorAll('[data-photo-trigger]');
  const photoCloseButtons = document.querySelectorAll('[data-photo-close]');

  function updatePhotoScrollButtons() {
    if (!photoScrollTrack || !photoScrollPrev || !photoScrollNext) return;

    const maxScrollLeft = photoScrollTrack.scrollWidth - photoScrollTrack.clientWidth - 1;
    photoScrollPrev.disabled = photoScrollTrack.scrollLeft <= 0;
    photoScrollNext.disabled = photoScrollTrack.scrollLeft >= maxScrollLeft;
  }

  photoTriggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!photoDialog || !photoImage || !photoCaption || !photoCredit) return;

      photoImage.setAttribute('src', trigger.getAttribute('data-photo-src') || '');
      photoImage.setAttribute('alt', trigger.getAttribute('data-photo-alt') || '');
      photoCaption.textContent = trigger.getAttribute('data-photo-caption') || '';
      photoCredit.textContent = trigger.getAttribute('data-photo-credit') || '';

      if (typeof photoDialog.showModal === 'function') {
        photoDialog.showModal();
      }
    });
  });

  photoCloseButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (photoDialog && typeof photoDialog.close === 'function') {
        photoDialog.close();
      }
    });
  });

  photoDialog?.addEventListener('click', (event) => {
    if (event.target === photoDialog && typeof photoDialog.close === 'function') {
      photoDialog.close();
    }
  });

  photoScrollPrev?.addEventListener('click', () => {
    if (!photoScrollTrack) return;
    photoScrollTrack.scrollBy({ left: -photoScrollTrack.clientWidth, behavior: 'smooth' });
  });

  photoScrollNext?.addEventListener('click', () => {
    if (!photoScrollTrack) return;
    photoScrollTrack.scrollBy({ left: photoScrollTrack.clientWidth, behavior: 'smooth' });
  });

  photoScrollTrack?.addEventListener('scroll', updatePhotoScrollButtons);
  window.addEventListener('resize', updatePhotoScrollButtons);
  updatePhotoScrollButtons();
</script>

<style>
  .photo-log-track {
    scrollbar-width: none;
  }

  .photo-log-track::-webkit-scrollbar {
    display: none;
  }
</style>
