---
import MainLayout from '../layouts/MainLayout.astro';

// Create SEO metadata
const seo = {
  description: "Learn how Dzaleka Online Services maintains practical service information, public resources, community records, and cultural archives for people connected to Dzaleka Refugee Camp.",
  type: "website",
  canonical: "https://services.dzaleka.com/about",
  openGraph: {
    description: "Learn how Dzaleka Online Services maintains practical service information, public resources, community records, and cultural archives for people connected to Dzaleka Refugee Camp.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/about"
  },
  twitter: {
    card: "summary",
    description: "Learn how Dzaleka Online Services maintains practical service information, public resources, community records, and cultural archives for people connected to Dzaleka Refugee Camp."
  }
};

// Create structured data for the about page
const aboutStructuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Dzaleka Online Services",
  "description": "Learn about Dzaleka Online Services and how the site maintains practical information and public records for Dzaleka.",
  "url": "https://services.dzaleka.com/about",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://services.dzaleka.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "About",
        "item": "https://services.dzaleka.com/about"
      }
    ]
  },
  "mainEntity": {
    "@type": "Organization",
    "name": "Dzaleka Online Services",
    "description": "A community-maintained website for services, public resources, events, jobs, data, and cultural records connected to Dzaleka.",
    "url": "https://services.dzaleka.com",
    "sameAs": [
      "https://services.dzaleka.com"
    ]
  }
};

const partners = [
  {
    name: 'UNHCR',
    description: 'United Nations High Commissioner for Refugees',
    iconPath: 'M12 3a9 9 0 100 18 9 9 0 000-18zm0 0c2.5 2.4 3.75 5.4 3.75 9S14.5 18.6 12 21m0-18C9.5 5.4 8.25 8.4 8.25 12S9.5 18.6 12 21M3.6 9h16.8M3.6 15h16.8'
  },
  {
    name: 'Community Organizations',
    description: 'Local organizations supporting refugee communities',
    iconPath: 'M17 20h5v-2a4 4 0 00-4-4h-1M7 20H2v-2a4 4 0 014-4h1m0-4a4 4 0 118 0 4 4 0 01-8 0zm10 0a3 3 0 116 0 3 3 0 01-6 0z'
  }
];

const services = [
  {
    title: 'Skills Exchange',
    description: 'A place for people to list skills, request help, teach, learn, and connect practical knowledge to income opportunities.',
    iconPath: 'M16 11c1.657 0 3-1.12 3-2.5S17.657 6 16 6s-3 1.12-3 2.5S14.343 11 16 11zM8 11c1.657 0 3-1.12 3-2.5S9.657 6 8 6 5 7.12 5 8.5 6.343 11 8 11zm0 2c-2.761 0-5 1.343-5 3v1h10v-1c0-1.657-2.239-3-5-3zm8 0c-.71 0-1.39.09-2 .26 1.2.73 2 1.69 2 2.74v1h5v-1c0-1.657-2.239-3-5-3z',
    url: '/skills-exchange'
  },
  {
    title: 'Site Register',
    description: 'A public record of landmarks, gathering places, services, and cultural spaces within Dzaleka.',
    iconPath: 'M3 21h18M5 21V9m14 12V9M4 9l8-5 8 5M8 21v-7m4 7v-7m4 7v-7',
    url: '/site-register'
  },
  {
    title: 'Public Art Catalogue',
    description: 'A catalogue of murals, artworks, artists, and visual records that document public culture in the camp.',
    iconPath: 'M12 3a9 9 0 00-9 9 7 7 0 007 7h1.5a1.5 1.5 0 000-3H11a2 2 0 010-4h1a9 9 0 000-18zm-4 8h.01M9 7h.01M15 7h.01M17 11h.01',
    url: '/public-art-catalogue'
  },
  {
    title: 'Photo Archive',
    description: 'A growing collection of photographs and stories documenting daily life, events, work, creativity, and memory.',
    iconPath: 'M3 8a2 2 0 012-2h2l1.5-2h7L17 6h2a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V8zm9 9a4 4 0 100-8 4 4 0 000 8z',
    url: '/photos'
  },
  {
    title: 'Community Directory',
    description: 'A searchable directory of organizations, businesses, schools, clinics, programs, and community services.',
    iconPath: 'M21 21l-5.2-5.2M10.5 18a7.5 7.5 0 100-15 7.5 7.5 0 000 15z',
    url: '/services'
  },
  {
    title: 'Online Services',
    description: 'Forms and workflows for service updates, submissions, registrations, reporting, and community support requests.',
    iconPath: 'M4 5h16v10H4V5zm-1 14h18M8 19h8',
    url: '/applications'
  }
];

const goals = [
  {
    title: 'Practical access',
    description: 'Make it easier to find services, contacts, forms, and next steps without asking in many different places.'
  },
  {
    title: 'Accurate records',
    description: 'Keep public information clear, dated, sourced where possible, and open to corrections from the community.'
  },
  {
    title: 'Community publishing',
    description: 'Give residents, organizations, artists, educators, traders, and visitors routes to add or update information.'
  },
  {
    title: 'Cultural Preservation',
    description: 'Document photos, places, public art, stories, events, and creative work as part of Dzaleka\'s shared memory.'
  },
  {
    title: 'Opportunities and learning',
    description: 'Connect people to jobs, courses, grants, tools, skills exchange, and business visibility.'
  },
  {
    title: 'Responsible growth',
    description: 'Improve the site in ways that remain mobile-friendly, readable, privacy-aware, and useful for first-time visitors.'
  }
];

const serviceList = [
  {
    category: 'Internal Support Services',
    items: [
      'Legal Support & Advocacy',
      'Emergency Relief Assistance',
      'Leadership Support Programs',
      'Advocacy Campaign Support',
      'Rights Awareness & Education',
      'Community Organizing'
    ]
  },
  {
    category: 'Community Services',
    items: [
      'Legal Representation',
      'Documentation Assistance',
      'Emergency Shelter',
      'Medical Support',
      'Leadership Training',
      'Network Development'
    ]
  }
];
---

<MainLayout
  title="About Dzaleka Online Services - Community information and public records"
  description="Learn how Dzaleka Online Services maintains practical service information, public resources, community records, and cultural archives for people connected to Dzaleka Refugee Camp."
  keywords="Dzaleka refugee camp, Malawi refugees, digital heritage, cultural records, community support, humanitarian aid, refugee services, community information"
  canonical="https://services.dzaleka.com/about"
  ogType="website"
  ogImage="/images/about-hero.jpg"
  twitterCard="summary_large_image"
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutStructuredData)} />

  <main class="min-h-screen">
    <!-- Hero Section -->
    <div class="border-b border-slate-200 bg-white">
      <div class="max-w-7xl mx-auto px-4 py-16 sm:py-20 sm:px-6 lg:px-8">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-slate-500">About</p>
        <h1 class="mb-6 max-w-4xl text-4xl font-bold text-gray-900 sm:text-5xl">
          About Dzaleka Online Services
        </h1>
        <p class="max-w-3xl text-lg leading-8 text-gray-600 sm:text-xl">
          Practical information, public records, and community archives for people connected to Dzaleka
        </p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-16 sm:px-6 lg:px-8">
      <!-- Mission Section -->
      <section class="max-w-4xl mx-auto mb-24">
        <div class="mb-12">
          <span class="text-sm font-semibold uppercase tracking-widest text-slate-500">Our purpose</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mt-2">Our Mission</h2>
        </div>
        <div class="prose prose-lg prose-blue text-gray-600">
          <p class="lead mb-8 text-xl text-gray-700">
            Dzaleka Online Services helps people find the right service, contact, document, event,
            job, or community record without guessing where to begin.
          </p>
          <p>
            The site brings together directories, urgent help pages, public resources, events, jobs,
            marketplace listings, open data, and cultural archives. Each section is meant to answer a
            practical question: where to go, who to contact, what to bring, what is happening, or how to
            contribute a correction.
          </p>
          <p>
            The cultural side of the site includes the Site Register, Photo Archive, Public Art Catalogue,
            dancers, poets, artists, and community voices. These records name people, places, and creative
            work that can otherwise disappear from public memory.
          </p>
          <p>
            We also maintain contribution routes so residents, organizations, traders, artists, educators,
            and visitors can submit updates, add records, report issues, and keep the information useful
            for the next person who needs it.
          </p>
        </div>
      </section>

      <!-- Services Section -->
      <section class="mb-24">
        <div class="mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">What we offer</h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            The main sections of the site, grouped by what people usually need to do.
          </p>
        </div>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {services.map((service, index) => (
            <a
              href={service.url}
              class="group bg-white p-8 rounded-xl border border-slate-200 hover:border-slate-300 transition-colors block"
            >
              <div class="flex items-center mb-6">
                <span class="mr-4 flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-slate-50 text-slate-700">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={service.iconPath} />
                  </svg>
                </span>
                <h3 class="text-xl font-bold text-gray-900 group-hover:text-slate-700 transition-colors break-words">
                  {service.title}
                </h3>
              </div>
              <p class="text-gray-600 leading-relaxed mb-6 break-words">
                {service.description}
              </p>
              <div class="mt-auto flex items-center text-slate-700 font-medium">
                <span class="mr-2">Open</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Goals Section -->
      <section class="mb-24 bg-slate-50 rounded-xl p-8 sm:p-12 lg:p-16 border border-slate-200">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Our Goals</h2>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
              A clearer, more maintainable public information system for Dzaleka.
            </p>
          </div>
          <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {goals.map((goal, index) => (
              <div class="bg-white p-8 rounded-xl border border-slate-200 hover:border-slate-300 transition-colors">
                <h3 class="text-lg font-bold mb-3 text-slate-900">{goal.title}</h3>
                <p class="text-gray-600 leading-relaxed">
                  {goal.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Service Listing Section -->
      <section class="mb-24">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl font-bold text-gray-900 mb-12 text-center">Our service directory</h2>
          <div class="grid gap-8 md:grid-cols-2 max-w-4xl mx-auto">
            {serviceList.map(category => (
              <div class="bg-white p-8 rounded-xl border border-slate-200 hover:border-slate-300 transition-colors">
                <h3 class="text-xl font-bold mb-6 text-gray-900 border-b border-gray-100 pb-4">{category.category}</h3>
                <ul class="space-y-4">
                  {category.items.map(item => (
                    <li class="flex items-center text-gray-600">
                      <svg class="w-5 h-5 text-slate-600 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Partners Section -->
      <section class="mb-24">
        <h2 class="text-3xl font-bold text-gray-900 mb-12 text-center">Our Partners</h2>
        <div class="grid gap-8 md:grid-cols-2 max-w-4xl mx-auto">
          {partners.map(partner => (
            <div class="bg-white p-8 rounded-xl border border-slate-200 hover:border-slate-300 transition-colors flex items-start">
              <div class="mr-6 flex h-14 w-14 flex-shrink-0 items-center justify-center rounded-lg bg-gray-50 text-slate-700">
                <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={partner.iconPath} />
                </svg>
              </div>
              <div class="min-w-0">
                <h3 class="text-xl font-bold mb-2 text-gray-900 break-words">{partner.name}</h3>
                <p class="text-gray-600 leading-relaxed">{partner.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Contact Section -->
      <section class="max-w-4xl mx-auto text-center bg-gray-900 rounded-xl p-12 sm:p-16 text-white">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Get Involved</h2>
        <p class="text-xl text-gray-300 mb-10 max-w-2xl mx-auto">
          We welcome corrections, new listings, photos, stories, services, and feedback from people
          who know Dzaleka directly.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/skills-exchange"
            class="inline-flex items-center justify-center px-8 py-4 rounded-lg text-base font-medium text-gray-900 bg-white hover:bg-gray-50 transition-colors"
          >
            Join Skills Exchange
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-8 py-4 border border-white/30 rounded-lg text-base font-medium text-white hover:bg-white/10 transition-colors"
          >
            Contact Us
          </a>
        </div>
      </section>
    </div>
  </main>
</MainLayout>
