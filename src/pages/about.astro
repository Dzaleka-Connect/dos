---
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';

// Create SEO metadata
const seo = {
  description: "Discover how Dzaleka Online Services empowers 57,000+ refugees through digital connectivity, cultural preservation, and community support. Learn about our mission to bridge digital divides and preserve heritage in Malawi's largest refugee camp.",
  type: "website",
  canonical: "https://services.dzaleka.com/about",
  openGraph: {
    description: "Discover how Dzaleka Online Services empowers 57,000+ refugees through digital connectivity, cultural preservation, and community support. Learn about our mission to bridge digital divides and preserve heritage in Malawi's largest refugee camp.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/about"
  },
  twitter: {
    card: "summary",
    description: "Discover how Dzaleka Online Services empowers 57,000+ refugees through digital connectivity, cultural preservation, and community support. Learn about our mission to bridge digital divides and preserve heritage in Malawi's largest refugee camp."
  }
};

// Create structured data for the about page
const aboutStructuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Dzaleka Online Services",
  "description": "Learn about Dzaleka Online Services, our mission to empower refugees through digital connectivity.",
  "url": "https://services.dzaleka.com/about",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://services.dzaleka.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "About",
        "item": "https://services.dzaleka.com/about"
      }
    ]
  },
  "mainEntity": {
    "@type": "Organization",
    "name": "Dzaleka Online Services",
    "description": "A digital platform empowering refugees through service accessibility and community connections.",
    "url": "https://services.dzaleka.com",
    "sameAs": [
      "https://services.dzaleka.com"
    ]
  }
};

const partners = [
  {
    name: 'UNHCR',
    description: 'United Nations High Commissioner for Refugees',
    icon: '🌐'
  },
  {
    name: 'Community Organizations',
    description: 'Local organizations supporting refugee communities',
    icon: '🤝'
  }
];

const services = [
  {
    title: 'Skills Exchange',
    description: 'A community-driven platform where members share expertise, earn income, and help others develop new skills. From photography to music, languages to crafts - every skill has value.',
    icon: '🤝',
    url: '/skills-exchange'
  },
  {
    title: 'Site Register',
    description: 'Documenting and preserving important community sites, landmarks, and cultural spaces within Dzaleka. A digital archive of our community\'s physical heritage.',
    icon: '🏛️',
    url: '/site-register'
  },
  {
    title: 'Public Art Catalogue',
    description: 'Showcasing the vibrant visual arts community and public artworks that tell our stories. From murals to sculptures, celebrating creativity and cultural expression.',
    icon: '🎨',
    url: '/public-art-catalogue'
  },
  {
    title: 'Photo Gallery',
    description: 'Explore and contribute to our growing collection of photos, videos, and stories that document life in Dzaleka. Help preserve our cultural heritage for future generations.',
    icon: '📷',
    url: '/photos'
  },
  {
    title: 'Community Directory',
    description: 'Find and connect with local organizations, businesses, and services within Dzaleka. A comprehensive database of community resources at your fingertips.',
    icon: '🔍',
    url: '/services'
  },
  {
    title: 'Online Services',
    description: 'Access essential services digitally - from permit applications to community program registrations. Making administrative tasks more accessible.',
    icon: '💻',
    url: '/applications'
  }
];

const goals = [
  {
    title: 'Economic Empowerment',
    description: 'Creating opportunities for community members to earn income through their skills and knowledge.'
  },
  {
    title: 'Digital Inclusion',
    description: 'Making services accessible to all community members through digital platforms.'
  },
  {
    title: 'Community Empowerment',
    description: 'Providing tools and resources for self-sufficiency and growth.'
  },
  {
    title: 'Cultural Preservation',
    description: 'Documenting and preserving our rich cultural heritage for future generations.'
  },
  {
    title: 'Skills Development',
    description: 'Fostering a learning environment where knowledge flows freely and skills are valued.'
  },
  {
    title: 'Service Integration',
    description: 'Streamlining access to essential services and support programs.'
  }
];

const serviceList = [
  {
    category: 'Internal Support Services',
    items: [
      'Legal Support & Advocacy',
      'Emergency Relief Assistance',
      'Leadership Support Programs',
      'Advocacy Campaign Support',
      'Rights Awareness & Education',
      'Community Organizing'
    ]
  },
  {
    category: 'Community Services',
    items: [
      'Legal Representation',
      'Documentation Assistance',
      'Emergency Shelter',
      'Medical Support',
      'Leadership Training',
      'Network Development'
    ]
  }
];
---

<MainLayout 
  title="About Dzaleka Digital Heritage Archive - Our Mission & Community Impact"
  description="Discover how Dzaleka Digital Heritage Archive empowers 57,000+ refugees through digital connectivity, cultural preservation, and community support. Learn about our mission to bridge digital divides and preserve heritage in Malawi's largest refugee camp."
  keywords="Dzaleka refugee camp, Malawi refugees, digital heritage, cultural preservation, community support, refugee empowerment, humanitarian aid, refugee services, community development"
  canonical="https://dzalekaheritage.org/about"
  ogType="website"
  ogImage="/images/about-hero.jpg"
  twitterCard="summary_large_image"
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutStructuredData)} />
  
  <main>
    <!-- Hero Section -->
    <div class="bg-gradient-to-br from-primary-600 to-primary-800 text-white">
      <div class="container mx-auto px-4 py-20">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-5xl font-bold mb-6">About Dzaleka Online Services</h1>
          <p class="text-xl text-white/90 leading-relaxed">
            Empowering our community through digital connectivity and service accessibility
          </p>
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 py-16">
      <!-- Mission Section -->
      <section class="max-w-4xl mx-auto mb-20">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Our Mission</h2>
        <div class="prose prose-lg prose-primary mx-auto">
          <p class="mb-6 text-gray-600 leading-relaxed">
            Dzaleka Online Services is dedicated to enhancing the lives of refugees and community members 
            by providing easy access to essential services, preserving our cultural heritage, and fostering 
            community connections through digital solutions.
          </p>
          <p class="mb-6 text-gray-600 leading-relaxed">
            Our platform includes the Skills Exchange initiative, where community members like Philemon Kasaro 
            (photographer earning 300,000 Kwacha monthly), Muenyemali Mutewa Tresort (filmmaker and teacher), 
            and many others share their expertise to help others while earning income.
          </p>
          <p class="mb-6 text-gray-600 leading-relaxed">
            We also feature the Site Register documenting our community's important landmarks and cultural spaces, 
            and the Public Art Catalogue showcasing our vibrant visual arts community with artists like Jacqueline 
            Nyanduhuro, Paulin Engambee, and many others who express our stories through murals, sculptures, and paintings.
          </p>
          <p class="text-gray-600 leading-relaxed">
            We strive to create a platform that empowers our community members to access resources, 
            submit applications, share their stories, participate in community events, and develop 
            economic self-reliance through skills sharing.
          </p>
        </div>
      </section>

      <!-- Services Section -->
      <section class="mb-20">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">What We Offer</h2>
        <p class="text-xl text-gray-600 text-center max-w-3xl mx-auto mb-12">
          Comprehensive digital solutions designed to serve, connect, and empower our community through 
          skills sharing, cultural preservation, heritage documentation, and service accessibility.
        </p>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {services.map(service => (
            <a
              href={service.url}
              class="group bg-white p-8 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-all duration-300 block"
            >
              <div class="flex items-center mb-4">
                <span class="text-4xl mr-4 group-hover:scale-110 transition-transform duration-300">{service.icon}</span>
                <h3 class="text-xl font-semibold text-gray-900 group-hover:text-primary-600 transition-colors duration-300">
                  {service.title}
                </h3>
              </div>
              <p class="text-gray-600 leading-relaxed">
                {service.description}
              </p>
              <div class="mt-4 flex items-center text-primary-600 font-medium">
                <span class="mr-2">Learn More</span>
                <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Goals Section -->
      <section class="mb-20">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Our Goals</h2>
        <p class="text-xl text-gray-600 text-center max-w-3xl mx-auto mb-12">
          Working towards a more connected, empowered, and self-sufficient community through 
          economic opportunities, cultural preservation, and heritage documentation.
        </p>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {goals.map(goal => (
            <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-all duration-300">
              <h3 class="text-xl font-semibold mb-4 text-primary-600">{goal.title}</h3>
              <p class="text-gray-600 leading-relaxed">
                {goal.description}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Service Listing Section -->
      <section class="mb-20 bg-gray-50 py-16 px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-3xl font-bold text-gray-900 mb-12 text-center">Our Service Directory</h2>
          <div class="grid gap-8 md:grid-cols-2 max-w-4xl mx-auto">
            {serviceList.map(category => (
              <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-all duration-300">
                <h3 class="text-xl font-semibold mb-6 text-primary-600">{category.category}</h3>
                <ul class="space-y-3">
                  {category.items.map(item => (
                    <li class="flex items-center text-gray-600">
                      <svg class="w-5 h-5 text-primary-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Partners Section -->
      <section class="mb-20">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Our Partners</h2>
        <div class="grid gap-8 md:grid-cols-2 max-w-4xl mx-auto">
          {partners.map(partner => (
            <div class="bg-white p-8 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-all duration-300">
              <div class="text-4xl mb-4">{partner.icon}</div>
              <h3 class="text-xl font-semibold mb-3 text-gray-900">{partner.name}</h3>
              <p class="text-gray-600 leading-relaxed">{partner.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Contact Section -->
      <section class="max-w-2xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">Get Involved</h2>
        <p class="text-gray-600 mb-8 leading-relaxed">
          We welcome community participation and feedback. Whether you want to share your skills, 
          learn from others, or contribute to our mission, there are many ways to get involved.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/skills-exchange"
            class="inline-flex items-center px-8 py-4 border border-transparent rounded-lg shadow-sm text-lg font-medium text-white bg-primary-600 hover:bg-primary-700 transition-colors duration-300"
          >
            Join Skills Exchange
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center px-8 py-4 border border-primary-600 rounded-lg shadow-sm text-lg font-medium text-primary-600 bg-white hover:bg-gray-50 transition-colors duration-300"
          >
            Contact Us
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </section>
    </div>
  </main>
</MainLayout>