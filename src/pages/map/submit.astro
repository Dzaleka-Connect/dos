---
import MainLayout from '../../layouts/MainLayout.astro';
import LocationPickerMap from '../../components/keeping-place/LocationPickerMap';

const seo = {
  title: "Submit a Community Location - GIS Community Mapping",
  description: "Submit new spatial coordinates, community facilities, local businesses, or cultural sites in Dzaleka Refugee Camp for open community verification and mapping.",
  keywords: "Dzaleka, open mapping, community GIS, refugee camp map, submit location, Dowa Malawi",
  canonical: "https://services.dzaleka.com/map/submit"
};
---

<MainLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
>
  <div class="min-h-screen bg-slate-50 text-slate-900 pb-16">
    <!-- Header Section -->
    <div class="bg-slate-900 text-white border-b border-slate-800 py-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <nav class="flex items-center space-x-2 text-xs font-medium text-slate-400 mb-4" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/explore" class="hover:text-white transition-colors">GIS Explorer</a>
          <span>/</span>
          <span class="text-sky-400 font-semibold">Submit Location</span>
        </nav>
        
        <p class="text-xs font-semibold tracking-widest uppercase text-sky-400 mb-2">
          Open Community Mapping Protocol
        </p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4">
          Submit a community location
        </h1>
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
          Help keep Dzaleka's community map fresh, accurate, and self-maintained. Submit local businesses, youth centers, schools, or landmarks for community review.
        </p>
      </div>
    </div>

    <!-- Main Submission Container -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="bg-white rounded-xl border border-slate-200 p-6 sm:p-8 shadow-sm">
        
        <!-- Submission Guidelines Callout -->
        <div class="mb-8 p-4 rounded-lg bg-sky-50 border border-sky-200 text-sky-900 text-xs sm:text-sm leading-relaxed">
          <h2 class="font-bold text-sky-950 mb-1 flex items-center gap-2">
            <svg class="w-4 h-4 text-sky-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Community review and verification notice
          </h2>
          <p>
            All submitted locations are staged locally on your device and routed to project contact 
            <strong class="font-semibold underline">dzalekaconnect@gmail.com</strong> for open verification. Please ensure accurate GPS coordinates.
          </p>
        </div>

        <form id="mapSubmitForm" class="space-y-6">
          
          <!-- Location Name & Category -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="locationName" class="block text-sm font-semibold text-slate-700 mb-2">
                Location / Facility Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="locationName"
                name="locationName"
                required
                placeholder="e.g. Hope Vocational Workshop"
                class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition-colors"
              />
            </div>

            <div>
              <label for="category" class="block text-sm font-semibold text-slate-700 mb-2">
                Category <span class="text-red-500">*</span>
              </label>
              <select
                id="category"
                name="category"
                required
                class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition-colors"
              >
                <option value="public_service">Public Service / Healthcare / Legal</option>
                <option value="wash_water">Water & Sanitation (Borehole / WASH Point)</option>
                <option value="education">Education & Learning Center</option>
                <option value="community">Community Organization / NGO</option>
                <option value="cultural_site">Cultural / Heritage / Innovation</option>
                <option value="commercial">Commercial / Business / Dining</option>
                <option value="recreation">Sports & Recreation</option>
              </select>
            </div>
          </div>

          <!-- Sector & Custodian -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="zone" class="block text-sm font-semibold text-slate-700 mb-2">
                Sector / Zone <span class="text-red-500">*</span>
              </label>
              <select
                id="zone"
                name="zone"
                required
                class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition-colors"
              >
                <option value="Katubza Zone">Katubza Zone</option>
                <option value="New Katubza Zone">New Katubza Zone</option>
                <option value="Kawale 1 Zone">Kawale 1 Zone</option>
                <option value="Kawale 2 Zone">Kawale 2 Zone</option>
                <option value="Likuni 1 Zone">Likuni 1 Zone</option>
                <option value="Likuni 2 Zone">Likuni 2 Zone</option>
                <option value="Lisungwi Zone">Lisungwi Zone</option>
                <option value="Zomba Zone">Zomba Zone</option>
                <option value="Blantyre Zone">Blantyre Zone</option>
                <option value="Dzaleka Hill Zone">Dzaleka Hill Zone</option>
                <option value="Central Administrative Zone">Central Administrative Zone (UNHCR / Health Centre)</option>
                <option value="Main Market & Commercial Hub">Main Market & Commercial Hub</option>
                <option value="Camp Entrance & Highway Corridor">Camp Entrance & Highway Corridor</option>
                <option value="Youth Sports Complex (Tumaini Arena)">Youth Sports Complex (Tumaini Arena)</option>
                <option value="Dzaleka Camp Sector">Other Dzaleka Block / Area</option>
              </select>
            </div>

            <div>
              <label for="custodian" class="block text-sm font-semibold text-slate-700 mb-2">
                Operator / Custodian
              </label>
              <input
                type="text"
                id="custodian"
                name="custodian"
                placeholder="e.g. Local Community Cooperative"
                class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition-colors"
              />
            </div>
          </div>

          <!-- Interactive Coordinate Picker Map Component -->
          <LocationPickerMap client:only="react" />

          <!-- Operational Status & Water / WASH Indicators -->
          <div class="p-4 rounded-xl border border-slate-200 bg-slate-50 space-y-4">
            <h3 class="text-sm font-semibold text-slate-800 flex items-center gap-2">
              <svg class="w-4 h-4 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
              Humanitarian & Service Operational Indicators (HOT Framework)
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label for="operationalStatus" class="block text-sm font-semibold text-slate-700 mb-1">
                  Operational Status
                </label>
                <select
                  id="operationalStatus"
                  name="operationalStatus"
                  class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-900 focus:border-sky-500 outline-none"
                >
                  <option value="Operational / Functional">Operational / Functional</option>
                  <option value="Needs Maintenance">Needs Maintenance / Repair</option>
                  <option value="Non-Functional / Closed">Non-Functional / Closed</option>
                  <option value="Under Construction">Under Construction / Planned</option>
                </select>
              </div>

              <div>
                <label for="washType" class="block text-sm font-semibold text-slate-700 mb-1">
                  Water / WASH Point Type
                </label>
                <select
                  id="washType"
                  name="washType"
                  class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-900 focus:border-sky-500 outline-none"
                >
                  <option value="Not Applicable">N/A (General Facility)</option>
                  <option value="Borehole with Handpump">Borehole (Handpump)</option>
                  <option value="Solar / Electric Tap Stand">Solar / Electric Tap Stand</option>
                  <option value="Water Tank Storage">Water Tank Storage</option>
                  <option value="Public Latrine / Washroom">Public Latrine / Washroom</option>
                </select>
              </div>

              <div>
                <label for="capacityStats" class="block text-sm font-semibold text-slate-700 mb-1">
                  Catchment / Capacity Count
                </label>
                <input
                  type="text"
                  id="capacityStats"
                  name="capacityStats"
                  placeholder="e.g. ~1,200 households daily"
                  class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-900 focus:border-sky-500 outline-none"
                />
              </div>
            </div>

            <!-- Accessibility & Amenities Checkboxes -->
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Key Amenities & Accessibility</label>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-sm text-slate-700">
                <label class="flex items-center gap-1.5 cursor-pointer">
                  <input type="checkbox" name="amenity_wheelchair" value="true" class="rounded border-slate-300 text-sky-600 focus:ring-sky-500" />
                  <span>Wheelchair Access</span>
                </label>
                <label class="flex items-center gap-1.5 cursor-pointer">
                  <input type="checkbox" name="amenity_solar" value="true" class="rounded border-slate-300 text-sky-600 focus:ring-sky-500" />
                  <span>Solar Power</span>
                </label>
                <label class="flex items-center gap-1.5 cursor-pointer">
                  <input type="checkbox" name="amenity_wifi" value="true" class="rounded border-slate-300 text-sky-600 focus:ring-sky-500" />
                  <span>Public Internet</span>
                </label>
                <label class="flex items-center gap-1.5 cursor-pointer">
                  <input type="checkbox" name="amenity_free" value="true" class="rounded border-slate-300 text-sky-600 focus:ring-sky-500" />
                  <span>Free Public Access</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Contact & Mapper Details -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="contactPhone" class="block text-sm font-semibold text-slate-700 mb-2">
                Contact Phone / WhatsApp
              </label>
              <input
                type="text"
                id="contactPhone"
                name="contactPhone"
                placeholder="e.g. +265 999 000 000"
                class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition-colors"
              />
            </div>

            <div>
              <label for="submitterName" class="block text-sm font-semibold text-slate-700 mb-2">
                Mapper / Submitter Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="submitterName"
                name="submitterName"
                required
                placeholder="Your name or YouthMappers team"
                class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition-colors"
              />
            </div>
          </div>

          <!-- Summary & Detailed Description -->
          <div class="space-y-4">
            <div>
              <label for="summary" class="block text-sm font-semibold text-slate-700 mb-2">
                Short Summary <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="summary"
                name="summary"
                required
                placeholder="Brief 1-sentence overview of the facility, borehole, or business"
                class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition-colors"
              />
            </div>

            <div>
              <label for="detailedDescription" class="block text-sm font-semibold text-slate-700 mb-2">
                Detailed Context, Languages & Background Notes
              </label>
              <textarea
                id="detailedDescription"
                name="detailedDescription"
                rows="4"
                placeholder="Provide details on languages spoken (Swahili, French, English), operating schedule, services provided, or historical notes..."
                class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-sm text-slate-900 focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition-colors"
              ></textarea>
            </div>
          </div>

          <!-- Submit Buttons & Status -->
          <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
            <a
              href="/explore"
              class="w-full sm:w-auto text-center rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors"
            >
              Cancel & Return to Map
            </a>

            <button
              type="submit"
              id="submitBtn"
              class="w-full sm:w-auto rounded-lg bg-slate-900 px-6 py-2.5 text-xs font-bold text-white hover:bg-slate-800 transition-colors shadow-sm"
            >
              Submit Location Record
            </button>
          </div>

          <div id="statusMessage" class="hidden p-4 rounded-lg text-xs font-semibold"></div>
        </form>

      </div>

      <!-- About this Project Card -->
      <div class="mt-8 rounded-xl border border-slate-200 bg-white p-6 sm:p-8 shadow-sm">
        <div class="flex items-center gap-2 mb-3">
          <span class="rounded-md bg-sky-100 text-sky-800 text-[11px] font-bold uppercase tracking-wider px-2.5 py-0.5">
            Project Lineage & Open GIS Protocol
          </span>
        </div>
        
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3">
          About the Dzaleka community mapping initiative
        </h2>
        
        <p class="text-sm text-slate-600 leading-relaxed mb-4">
          Established in 1994 by UNHCR in response to regional displacement, Dzaleka Refugee Camp has grown from an initial capacity of 10,000 to over 50,000 registered residents living across 12 distinct administrative zones, including Katubza, Kawale 1 & 2, Likuni 1 & 2, Lisungwi, Zomba, Blantyre, and Dzaleka Hill.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6 border-y border-slate-100 py-6">
          <div>
            <h3 class="text-sm font-semibold text-slate-800 mb-2 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
              HOT Microgrants 2021 Lineage
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              This participatory mapping protocol draws directly from the <strong>Humanitarian OpenStreetMap Team (HOT) Microgrants 2021 Initiative</strong> led by <em>Ndapile Mkuwu & Zola Manyungwa</em>. Their ground-truth survey mapped basic human needs—including Dzaleka's 43 water boreholes, schools, and health facilities—establishing the foundation for open community GIS.
            </p>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-slate-800 mb-2 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
              Participatory Community Ownership
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Rather than relying on closed data collection, our open-source submission workflow empowers local youth, women mappers, resident artists, and business owners to directly update place names, operating status, accessibility notes, and GPS coordinates under an open Creative Commons (CC BY-SA 4.0) license.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-4 text-xs text-slate-500">
          <span>Public Access License: CC BY-SA 4.0</span>
          <a
            href="https://wiki.openstreetmap.org/wiki/Humanitarian_OSM_Team/HOT_Microgrants/Community_Impact_Microgrants_2021/Proposal/Dzaleka_Mapping"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sky-700 font-semibold hover:underline flex items-center gap-1"
          >
            <span>View HOT 2021 Wiki Proposal</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('mapSubmitForm') as HTMLFormElement;
      const statusMsg = document.getElementById('statusMessage');

      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();

          const formData = new FormData(form);
          const categoryVal = formData.get('category') as string;
          let catLabel = 'Community Location';
          if (categoryVal === 'public_service') catLabel = 'Public Service & Health';
          if (categoryVal === 'wash_water') catLabel = 'Water & WASH Point';
          if (categoryVal === 'education') catLabel = 'Education & Learning';
          if (categoryVal === 'commercial') catLabel = 'Commercial & Business';

          const opStatus = (formData.get('operationalStatus') as string) || 'Operational';
          const washType = (formData.get('washType') as string) || 'N/A';
          const capacity = (formData.get('capacityStats') as string) || '';
          const submitter = (formData.get('submitterName') as string) || 'Community Volunteer';
          const phone = (formData.get('contactPhone') as string) || '';

          const latVal = parseFloat((formData.get('lat') as string) || '-13.65920');
          const lngVal = parseFloat((formData.get('lng') as string) || '33.87050');

          const newRecord = {
            id: `custom-node-${Date.now()}`,
            referenceId: `DZK-SUB-${Math.floor(100 + Math.random() * 900)}`,
            name: formData.get('locationName') as string,
            category: categoryVal as any,
            categoryLabel: catLabel,
            protocol: 'public',
            protocolBadge: 'Public Unrestricted',
            protocolDescription: 'Community-submitted location for open verification.',
            lat: latVal,
            lng: lngVal,
            zone: formData.get('zone') as string,
            custodian: (formData.get('custodian') as string) || 'Local Community',
            surveyDate: new Date().toISOString().split('T')[0],
            capacityOrStats: capacity ? `Status: ${opStatus} | Type: ${washType} | Capacity: ${capacity}` : `Status: ${opStatus} | Type: ${washType}`,
            summary: formData.get('summary') as string,
            detailedDescription: (formData.get('detailedDescription') as string) || (formData.get('summary') as string),
            tags: [formData.get('zone') as string, 'Community Submission', opStatus, washType].filter((t) => t && t !== 'N/A')
          };

          try {
            const existing = JSON.parse(localStorage.getItem('dzaleka_keeping_place_custom_records') || '[]');
            existing.push(newRecord);
            localStorage.setItem('dzaleka_keeping_place_custom_records', JSON.stringify(existing));
          } catch (err) {
            console.warn('Unable to write to localStorage', err);
          }

          if (statusMsg) {
            statusMsg.className = 'p-4 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs font-semibold block';
            statusMsg.innerHTML = `
              Location <strong>"${newRecord.name}"</strong> submitted successfully! 
              Staged for review and added to your interactive map preview.
            `;
          }

          const mailSubject = encodeURIComponent(`[HOT Community Map Submission] ${newRecord.name}`);
          const mailBody = encodeURIComponent(
            `New Location Submission Details:\n\nName: ${newRecord.name}\nCategory: ${newRecord.category} (${catLabel})\nSector/Zone: ${newRecord.zone}\nGPS Coordinates: ${latVal}, ${lngVal}\nOperator/Custodian: ${newRecord.custodian}\nOperational Status: ${opStatus}\nWASH Point Type: ${washType}\nCapacity/Catchment: ${capacity}\nMapper Name: ${submitter}\nContact Phone: ${phone}\nShort Summary: ${newRecord.summary}\nDetailed Notes: ${newRecord.detailedDescription}\n\nSubmitted via services.dzaleka.com`
          );
          
          setTimeout(() => {
            window.location.href = `mailto:dzalekaconnect@gmail.com?subject=${mailSubject}&body=${mailBody}`;
          }, 1500);
        });
      }
    });
  </script>
</MainLayout>
