---
import MainLayout from '../layouts/MainLayout.astro';

const lastUpdated = new Date('2025-11-20');

// SEO metadata
const seo = {
  description: "Learn about Dzaleka Online Services privacy policy and data protection measures. Understand how we collect, use, and safeguard your personal information while serving 57,000+ refugees in Malawi's largest settlement.",
  type: "website",
  canonical: "https://services.dzaleka.com/privacy",
  openGraph: {
    description: "Learn about Dzaleka Online Services privacy policy and data protection measures. Understand how we collect, use, and safeguard your personal information while serving 57,000+ refugees in Malawi's largest settlement.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/privacy"
  },
  twitter: {
    card: "summary",
    description: "Learn about Dzaleka Online Services privacy policy and data protection measures. Understand how we collect, use, and safeguard your personal information while serving 57,000+ refugees in Malawi's largest settlement."
  }
};

const sections = [
  {
    id: 'information-collection',
    title: 'Information Collection',
    content: `We collect information to provide better services to our users and improve the Dzaleka Online Services platform.`
  },
  {
    id: 'data-usage',
    title: 'Data Usage',
    content: `Your information helps us maintain and improve the platform for the Dzaleka community.`
  }
];
---

<MainLayout 
  title="Privacy Policy"
  description={seo.description} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <main class="min-h-screen bg-gray-50">
    {/* Hero Section */}
    <div class="border-b border-gray-200 bg-white py-12 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto">
          <div class="inline-flex items-center space-x-2 bg-slate-100 border border-slate-200 rounded-full px-4 py-2 mb-6">
            <svg class="w-4 h-4 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            <span class="text-sm font-medium text-slate-700">Legal Information</span>
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mb-4 text-gray-900">
            Privacy Policy
          </h1>
          <p class="text-lg text-gray-600">
            How we protect and handle your information at Dzaleka Online Services
          </p>
        </div>
      </div>
    </div>

    {/* Content Section */}
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
        <div class="prose prose-lg max-w-none">
          <div class="mb-12">
            <p class="text-gray-600">
              Last updated: November 20, 2025
            </p>
            <p class="text-gray-600 mt-4">
              At Dzaleka Online Services, we are committed to protecting your privacy and ensuring the security of your personal information. Guided by humanitarian "Do No Harm" principles, this Privacy Policy explains our strict practices regarding data collection, use, and protection for all vulnerable individuals in the camp.
            </p>
          </div>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Anonymity & Pseudonyms</h2>
            <div class="bg-primary-50 border border-primary-200 rounded-lg p-6">
              <p class="text-primary-800">
                We understand that many members of the Dzaleka community face specific protection risks. <strong>You have the absolute right to use pseudonyms (fake names) or remain anonymous</strong> when interacting with community features on our platform, provided you do not violate our Terms and Conditions. We will never force you to disclose your real legal identity unless strictly required for specific operational features.
              </p>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Information We Collect</h2>
            <div class="space-y-6">
              <div class="bg-gray-50 rounded-lg p-6">
                <h3 class="font-semibold text-gray-900 mb-3">Personal Information</h3>
                <ul class="list-disc list-inside text-gray-600 space-y-2">
                  <li>Name and contact information</li>
                  <li>Email address</li>
                  <li>Organization affiliation (if applicable)</li>
                  <li>Content you submit to our platform</li>
                  <li>Profile information (optional)</li>
                  <li>Location data (if permitted)</li>
                  <li><strong>Protection of Minors:</strong> We do not knowingly collect identifying information from unaccompanied minors or children without explicit guardianship consent.</li>
                </ul>
              </div>
              
              <div class="bg-gray-50 rounded-lg p-6">
                <h3 class="font-semibold text-gray-900 mb-3">Technical Information</h3>
                <ul class="list-disc list-inside text-gray-600 space-y-2">
                  <li>Device information</li>
                  <li>Browser type and version</li>
                  <li>Access times and dates</li>
                  <li>Pages visited</li>
                  <li>IP address</li>
                </ul>
              </div>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">How We Use Your Information</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-slate-50 border border-slate-200 rounded-lg p-6">
                <h3 class="font-semibold text-slate-900 mb-3">Primary Uses</h3>
                <ul class="text-slate-700 space-y-2">
                  <li class="flex items-start">
                    <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>Provide and maintain our services</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>Process resource submissions</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>Facilitate community interactions</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>Manage event registrations</span>
                  </li>
                </ul>
              </div>
              <div class="bg-slate-50 border border-slate-200 rounded-lg p-6">
                <h3 class="font-semibold text-slate-900 mb-3">Secondary Uses</h3>
                <ul class="text-slate-700 space-y-2">
                  <li class="flex items-start">
                    <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>Improve platform features</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>Send community updates</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>Research and analytics</span>
                  </li>
                  <li class="flex items-start">
                    <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>Community engagement</span>
                  </li>
                </ul>
              </div>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Third-Party Data Sharing</h2>
            <div class="bg-red-50 border border-red-200 rounded-lg p-6">
              <p class="text-red-800 mb-4">
                <strong>We do not, and will never, sell your personal data.</strong> Because of the sensitive nature of refugee populations, our data sharing policies are extremely strict:
              </p>
              <ul class="space-y-3">
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-red-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                  </svg>
                  <span class="text-red-800"><strong>No Unauthorized Sharing:</strong> We do not share your individual profiles or activity with UNHCR, the Government of Malawi, or NGOs without your explicit, informed consent.</span>
                </li>
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-red-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                  </svg>
                  <span class="text-red-800"><strong>Life-Saving Interventions:</strong> In extreme circumstances where there is an immediate threat to life or severe protection risks (such as human trafficking), we may disclose specific information to protection partners.</span>
                </li>
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-red-600 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                  </svg>
                  <span class="text-red-800"><strong>Aggregate Data:</strong> We may share strictly anonymous, non-identifiable statistics with partners for funding or operational reporting.</span>
                </li>
              </ul>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Data Protection Measures</h2>
            <div class="bg-slate-50 border border-slate-200 rounded-lg p-6">
              <p class="text-slate-800 mb-4">
                We implement comprehensive security measures to protect your personal information:
              </p>
              <ul class="space-y-3">
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                  </svg>
                  <span class="text-slate-700">Encrypted data storage and transmission</span>
                </li>
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                  </svg>
                  <span class="text-slate-700">Regular security assessments and updates</span>
                </li>
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                  </svg>
                  <span class="text-slate-700">Strict access controls and authentication</span>
                </li>
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                  </svg>
                  <span class="text-slate-700">Regular data backups and recovery procedures</span>
                </li>
              </ul>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Your Privacy Rights</h2>
            <div class="bg-slate-50 border border-slate-200 rounded-lg p-6">
              <p class="text-slate-800 mb-4">As a user of Dzaleka Online Services, you have the right to:</p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="flex items-center space-x-2">
                  <svg class="h-5 w-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="text-slate-700">Access your personal data</span>
                </div>
                <div class="flex items-center space-x-2">
                  <svg class="h-5 w-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="text-slate-700">Request data corrections</span>
                </div>
                <div class="flex items-center space-x-2">
                  <svg class="h-5 w-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="text-slate-700">Delete your account</span>
                </div>
                <div class="flex items-center space-x-2">
                  <svg class="h-5 w-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <span class="text-slate-700">Control communications</span>
                </div>
                <div class="flex items-center space-x-2">
                  <svg class="h-5 w-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                  <span class="text-slate-700">Request complete data deletion</span>
                </div>
              </div>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Community Guidelines</h2>
            <div class="bg-slate-50 border border-slate-200 rounded-lg p-6">
              <p class="text-slate-800 mb-4">
                To maintain a safe and respectful community environment, we expect all users to:
              </p>
              <ul class="space-y-3">
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-slate-700">Respect other community members' privacy</span>
                </li>
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-slate-700">Share appropriate and relevant content</span>
                </li>
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-slate-700">Follow our content guidelines</span>
                </li>
              </ul>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Contact Information</h2>
            <div class="bg-gray-50 rounded-lg p-6">
              <p class="text-gray-600 mb-4">
                For questions about this Privacy Policy or to exercise your privacy rights, please contact us:
              </p>
              <ul class="space-y-2 text-gray-600">
                <li class="flex items-center space-x-2">
                  <svg class="h-5 w-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                  <span>Email: info@mail.dzaleka.com</span>
                </li>
                <li class="flex items-center space-x-2">
                  <svg class="h-5 w-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <span>Address: Dzaleka Refugee Camp, Malawi</span>
                </li>
              </ul>
            </div>
          </section>

          <section class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Updates to This Policy</h2>
            <div class="bg-slate-50 border border-slate-200 rounded-lg p-6">
              <p class="text-slate-800 mb-4">
                We may update this Privacy Policy from time to time. When we make significant changes, we will:
              </p>
              <ul class="space-y-3">
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-slate-700">Notify you via email or platform announcement</span>
                </li>
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-slate-700">Update the "Last modified" date at the top of this policy</span>
                </li>
                <li class="flex items-start">
                  <svg class="h-6 w-6 text-slate-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-slate-700">Obtain your consent when required by law</span>
                </li>
              </ul>
            </div>
          </section>
        </div>

        <div class="mt-12 text-center">
          <a
            href="/"
            class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500"
          >
            Return to Homepage
          </a>
        </div>
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .prose h2 {
    @apply text-2xl font-bold text-gray-900 mt-8 mb-4;
  }
  .prose h3 {
    @apply text-xl font-semibold text-gray-900 mt-6 mb-3;
  }
  .prose p {
    @apply text-gray-700 leading-relaxed mb-4;
  }
</style>