---
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import { getDatasetCatalog, getDatasetStats } from "../data/datasets";
const datasets = await getDatasetCatalog();
const featured = datasets.filter((dataset) => dataset.featured).slice(0, 3);
const stats = getDatasetStats(datasets);
const title = "Open data platform";
const description =
  "Browse Dzaleka datasets, download spatial records in CSV or GeoJSON, and use the public API. Check each dataset for its source, update date and licence.";
const canonical = "https://services.dzaleka.com/open-data-platform";
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: canonical,
};
---

<MainLayout
  title={title}
  description={description}
  canonical={canonical}
  image="https://services.dzaleka.com/images/dzaleka-hero.jpeg"
  schema={schema}
>
  <section class="bg-primary-900 text-white">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
      <Breadcrumb
        light
        items={[{ label: "Home", href: "/" }, { label: "Open data" }]}
      />
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:gap-16">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-primary-200">
            Dzaleka data catalogue
          </p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
            Open data platform
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-primary-50">
            Find records about Dzaleka’s services, places and cultural life.
            Browse a dataset, download a file or connect to the API.
          </p>
          <a
            href="/datasets"
            class="mt-6 inline-flex min-h-[44px] items-center rounded bg-white px-5 py-3 font-semibold text-primary-900 hover:bg-primary-50"
          >
            Browse {stats.totalDatasets} datasets{" "}
            <span class="ml-3" aria-hidden="true">
              →
            </span>
          </a>
        </div>
        <aside class="self-center border-l border-primary-600 pl-6">
          <h2 class="text-lg font-semibold">Choose how to use the data</h2>
          <ul class="mt-4 space-y-4 text-primary-50">
            <li>
              <a
                href="/data"
                class="font-semibold underline underline-offset-4"
              >
                Read statistics
              </a>
              <p class="mt-1 text-sm">
                Population figures and background information.
              </p>
            </li>
            <li>
              <a
                href="#downloads"
                class="font-semibold underline underline-offset-4"
              >
                Download map records
              </a>
              <p class="mt-1 text-sm">
                Files for spreadsheets and mapping software.
              </p>
            </li>
            <li>
              <a
                href="/api-docs"
                class="font-semibold underline underline-offset-4"
              >
                Build with the API
              </a>
              <p class="mt-1 text-sm">
                Endpoints, examples and response formats.
              </p>
            </li>
          </ul>
        </aside>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 class="text-2xl font-bold text-slate-900">Featured datasets</h2>
      <a
        href="/datasets"
        class="inline-flex min-h-[44px] items-center font-medium text-primary-800 underline underline-offset-4"
      >
        View the full catalogue
      </a>
    </div>
    <div class="mt-5 grid gap-5 md:grid-cols-3">
      {featured.map((dataset) => (
        <article class="flex flex-col rounded border border-slate-200 border-t-[3px] border-t-primary-700 p-6">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
            {dataset.theme}
          </p>
          <h3 class="mt-3 text-xl font-bold">
            <a
              href={`/datasets/${dataset.slug}`}
              class="text-primary-800 underline decoration-primary-200 underline-offset-4 hover:decoration-primary-800"
            >
              {dataset.title}
            </a>
          </h3>
          <p class="mt-3 leading-7 text-slate-600">{dataset.summary}</p>
          <dl class="mt-auto space-y-2 pt-5 text-sm">
            <div class="flex justify-between gap-3 border-t border-slate-200 pt-4">
              <dt class="text-slate-500">Records</dt>
              <dd class="font-medium text-slate-700">
                {dataset.recordDisplay}
              </dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-slate-500">Updated</dt>
              <dd class="text-right text-slate-700">
                {dataset.lastUpdatedDisplay}
              </dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
  </section>
  <section
    id="downloads"
    class="scroll-mt-28 border-y border-slate-200 bg-slate-50"
  >
    <div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.7fr)] lg:px-8">
      <div>
        <h2 class="text-2xl font-bold text-slate-900">Map data downloads</h2>
        <p class="mt-3 leading-7 text-slate-600">
          Coordinates and details for community places, site records and public
          art.
        </p>
        <a
          href="/map"
          class="mt-4 inline-flex min-h-[44px] items-center font-medium text-primary-800 underline underline-offset-4"
        >
          Explore the interactive map →
        </a>
      </div>
      <div class="divide-y divide-slate-200 rounded border border-slate-200 bg-white">
        {[
          ["GeoJSON", "For GIS and web maps", "/api/v1/spatial.json"],
          ["CSV", "For spreadsheets and data analysis", "/api/v1/spatial.csv"],
          [
            "JSON",
            "A list of records for applications",
            "/api/v1/spatial.json?format=json",
          ],
        ].map(([format, help, href]) => (
          <div class="flex flex-wrap items-center justify-between gap-3 p-5">
            <div>
              <h3 class="font-semibold text-slate-900">{format}</h3>
              <p class="mt-1 text-sm text-slate-600">{help}</p>
            </div>
            <a
              href={href}
              download={`dzaleka-spatial.${format === "CSV" ? "csv" : "json"}`}
              class="inline-flex min-h-[44px] items-center rounded border border-slate-300 px-4 py-2 text-sm font-semibold text-primary-800 hover:border-primary-600"
            >
              Download {format}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="mx-auto grid max-w-7xl gap-8 px-4 py-10 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:px-8">
    <div>
      <h2 class="text-2xl font-bold text-slate-900">
        Before you reuse a dataset
      </h2>
      <ul class="mt-4 list-disc space-y-3 pl-5 leading-7 text-slate-600">
        <li>
          Read its source notes and update date. Publication dates differ
          between datasets.
        </li>
        <li>
          Check the licence and attribution requirements on the dataset page.
        </li>
        <li>
          Keep the source and reporting period with any figures you quote.
        </li>
      </ul>
    </div>
    <div>
      <h2 class="text-2xl font-bold text-slate-900">Developer resources</h2>
      <p class="mt-3 leading-7 text-slate-600">
        Use the API reference for request examples, filters, rate limits and
        errors.
      </p>
      <ul class="mt-4 space-y-3">
        <li>
          <a
            href="/api-docs"
            class="font-medium text-primary-800 underline underline-offset-4"
          >
            API documentation
          </a>
        </li>
        <li>
          <a
            href="/tools-and-templates#featured-tools"
            class="font-medium text-primary-800 underline underline-offset-4"
          >
            Metadata and archive tools
          </a>
        </li>
        <li>
          <a
            href="/help-desk"
            class="font-medium text-primary-800 underline underline-offset-4"
          >
            Report a data issue
          </a>
        </li>
      </ul>
    </div>
  </section>
</MainLayout>
