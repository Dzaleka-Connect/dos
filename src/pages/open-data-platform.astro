---
import MainLayout from '../layouts/MainLayout.astro';
import { getDatasetCatalog, getDatasetStats } from '../data/datasets';

const datasets = await getDatasetCatalog();
const featuredDatasets = datasets.filter((dataset) => dataset.featured).slice(0, 3);
const datasetStats = getDatasetStats(datasets);

const seo = {
  title: "Open Data Platform",
  description: "Access Dzaleka's comprehensive open data platform featuring cultural heritage, community demographics, and historical records. Support community-led research, storytelling, and heritage preservation with verified datasets from Malawi's largest refugee camp.",
  keywords: "Dzaleka, open data, cultural heritage, refugee camp, digital archive, community storytelling, research platform",
  canonical: "https://services.dzaleka.com/open-data-platform",
  openGraph: {
    title: "Open Data Platform - Dzaleka Online Services",
    description: "Access Dzaleka's comprehensive open data platform featuring cultural heritage, community demographics, and historical records. Support community-led research, storytelling, and heritage preservation with verified datasets from Malawi's largest refugee camp.",
    type: "article",
    image: {
      url: "https://services.dzaleka.com/images/dzaleka-hero.jpeg",
      alt: "Dzaleka Open Data Platform - Preserving Cultural Heritage",
    },
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/open-data-platform",
  },
  twitter: {
    card: "summary_large_image",
    creator: "@dzalekaconnect",
    title: "Open Data Platform - Dzaleka Online Services",
    description: "Access Dzaleka's comprehensive open data platform featuring cultural heritage, community demographics, and historical records. Support community-led research, storytelling, and heritage preservation with verified datasets from Malawi's largest refugee camp.",
    image: "https://services.dzaleka.com/images/dzaleka-hero.jpeg",
  },
};
---

<MainLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <Fragment slot="head">
    <meta name="author" content="Dzaleka Online Services" />
    <meta name="geo.region" content="MW" />
    <meta name="geo.placename" content="Dzaleka Refugee Camp" />
  </Fragment>

  <!-- Hero -->
  <div class="relative overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/dzaleka-hero.jpeg"
        alt="Dzaleka Cultural Heritage"
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0 bg-gray-900/70"></div>
    </div>
    <div class="relative min-h-[50vh] flex items-center">
      <div class="container mx-auto px-6 py-12">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight">
            Open Data Platform
          </h1>
          <p class="text-lg text-white/90 leading-relaxed mb-8 mx-auto max-w-2xl">
            {datasetStats.totalDatasets} datasets supporting community-led storytelling, research, and heritage preservation in Dzaleka Refugee Camp
          </p>
          <div class="flex justify-center">
            <a
              href="/datasets"
              class="inline-flex items-center px-6 py-3 bg-white text-slate-700 rounded-full hover:bg-slate-50 transition-colors duration-150 font-medium"
            >
              Browse datasets
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Featured Datasets -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <span class="text-slate-700 font-semibold text-sm uppercase tracking-wider">Featured Datasets</span>
        <h2 class="text-3xl font-bold text-gray-900 mt-4">Start here</h2>
        <p class="text-lg text-gray-600 mt-4">
          The most-used public datasets — good starting points for research, integration, or exploration.
        </p>
      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3 max-w-7xl mx-auto">
        {featuredDatasets.map((dataset) => (
          <article class="bg-white rounded-xl border border-gray-200 hover:border-slate-400 transition-colors duration-150 overflow-hidden">
            <div class="p-6">
              <div class="flex items-center justify-between gap-3 mb-4">
                <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
                  {dataset.theme}
                </span>
                <span class="text-sm text-gray-500">{dataset.lastUpdatedDisplay}</span>
              </div>
              <h3 class="text-xl font-bold text-gray-900 mb-3">
                <a href={`/datasets/${dataset.slug}`} class="hover:text-primary-700">
                  {dataset.title}
                </a>
              </h3>
              <p class="text-gray-600 mb-4 text-sm leading-relaxed">{dataset.summary}</p>
              <div class="flex items-center gap-4 text-sm text-gray-500 mb-5">
                <span>{dataset.recordDisplay} {dataset.recordLabel.toLowerCase()}</span>
                <span>·</span>
                <span>{dataset.distributionCount} resources</span>
              </div>
              <a
                href={`/datasets/${dataset.slug}`}
                class="inline-flex items-center text-slate-700 hover:text-slate-900 font-medium text-sm"
              >
                View dataset
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-8 text-center">
        <a href="/datasets" class="text-sm font-semibold text-primary-700 hover:text-primary-800">
          See all {datasetStats.totalDatasets} datasets →
        </a>
      </div>
    </div>
  </section>

  <!-- How the platform works -->
  <section id="platform-components" class="py-20 bg-gray-50">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <span class="text-slate-700 font-semibold text-sm uppercase tracking-wider">How it works</span>
        <h2 class="text-3xl font-bold text-gray-900 mt-4">From community stories to open data</h2>
        <p class="text-lg text-gray-600 mt-4">
          We collect, organise, and publish data that reflects life in Dzaleka — making community narratives accessible, secure, and community-owned.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-7xl mx-auto">
        <!-- Collect -->
        <div class="bg-white rounded-xl p-8 border border-gray-200">
          <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Collect</h3>
          <ul class="space-y-2 text-gray-600 text-sm">
            <li>Oral histories, photos, and documents from residents</li>
            <li>Cultural events and community project records</li>
            <li>Community-led news stories and camp updates</li>
          </ul>
        </div>

        <!-- Organise -->
        <div class="bg-white rounded-xl p-8 border border-gray-200">
          <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Organise</h3>
          <p class="text-gray-600 text-sm">
            All content is stored in a central, searchable archive — structured for reliable referencing and long-term preservation of Dzaleka's cultural memory.
          </p>
        </div>

        <!-- Publish -->
        <div class="bg-white rounded-xl p-8 border border-gray-200">
          <div class="w-12 h-12 bg-slate-100 rounded-lg flex items-center justify-center mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Publish</h3>
          <p class="text-gray-600 text-sm">
            Data is presented through browsable pages, API endpoints, and thematic galleries — making it usable for researchers, builders, and the community alike.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Open Spatial Data & Public API Exporter -->
  <section class="py-16 bg-slate-50 text-slate-900 border-t border-b border-slate-200">
    <div class="container mx-auto px-6 max-w-5xl">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="inline-block rounded-md bg-sky-50 text-sky-700 text-xs font-bold uppercase tracking-widest px-3 py-1 border border-sky-200 mb-3">
          Open Access Spatial Data Protocol &bull; CC BY-SA 4.0
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-slate-900 mb-4">
          Open Spatial Data & Public API Exporter
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Download open spatial datasets or query public endpoints to access verified community locations, infrastructure nodes, and site registry records in GeoJSON, CSV, or JSON.
        </p>
      </div>

      <!-- Download Buttons Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        <a
          href="/api/v1/spatial.json"
          target="_blank"
          class="rounded-xl border border-slate-200 bg-white p-5 hover:border-sky-300 hover:shadow-sm transition-all text-center block group"
        >
          <div class="text-xs font-bold uppercase tracking-wider text-sky-700 mb-1">RFC 7946 Standard</div>
          <div class="text-lg font-bold text-slate-900 group-hover:text-sky-700 transition-colors">GeoJSON Export</div>
          <p class="text-slate-500 text-xs mt-2">Full spatial features with geometry & properties</p>
          <span class="inline-block mt-4 text-xs font-semibold text-sky-700 group-hover:underline">GET /api/v1/spatial.json &rarr;</span>
        </a>

        <a
          href="/api/v1/spatial.csv"
          download="dzaleka-spatial-records.csv"
          class="rounded-xl border border-slate-200 bg-white p-5 hover:border-emerald-300 hover:shadow-sm transition-all text-center block group"
        >
          <div class="text-xs font-bold uppercase tracking-wider text-emerald-700 mb-1">Spreadsheet & QGIS</div>
          <div class="text-lg font-bold text-slate-900 group-hover:text-emerald-700 transition-colors">CSV Export</div>
          <p class="text-slate-500 text-xs mt-2">Tabular coordinates, categories, zones & stats</p>
          <span class="inline-block mt-4 text-xs font-semibold text-emerald-700 group-hover:underline">GET /api/v1/spatial.csv &rarr;</span>
        </a>

        <a
          href="/api/v1/spatial.json?format=json"
          target="_blank"
          class="rounded-xl border border-slate-200 bg-white p-5 hover:border-amber-300 hover:shadow-sm transition-all text-center block group"
        >
          <div class="text-xs font-bold uppercase tracking-wider text-amber-700 mb-1">Developer API Payload</div>
          <div class="text-lg font-bold text-slate-900 group-hover:text-amber-700 transition-colors">JSON Array</div>
          <p class="text-slate-500 text-xs mt-2">Clean REST array object for web & mobile apps</p>
          <span class="inline-block mt-4 text-xs font-semibold text-amber-700 group-hover:underline">GET /api/v1/spatial.json?format=json &rarr;</span>
        </a>
      </div>

      <!-- Interactive API Sandbox Code Snippets -->
      <div class="rounded-xl border border-slate-200 bg-slate-900 p-6 sm:p-8 text-white">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-300 mb-4 flex items-center gap-2">
          <svg class="w-4 h-4 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>
          Quick Code Snippets (CORS Allowed: *)
        </h3>

        <div class="space-y-4 text-xs font-mono">
          <div>
            <span class="text-slate-400 font-semibold block mb-1">cURL (Command Line):</span>
            <pre class="bg-slate-950 p-3 rounded-lg text-sky-300 overflow-x-auto">curl -sS "https://services.dzaleka.com/api/v1/spatial.json?category=public_service"</pre>
          </div>

          <div>
            <span class="text-slate-400 font-semibold block mb-1">JavaScript / TypeScript (Fetch API):</span>
            <pre class="bg-slate-950 p-3 rounded-lg text-emerald-300 overflow-x-auto">const res = await fetch('https://services.dzaleka.com/api/v1/spatial.json');
const data = await res.json();
console.log('Loaded ' + data.features.length + ' spatial features.');</pre>
          </div>

          <div>
            <span class="text-slate-400 font-semibold block mb-1">Python (Requests / GeoPandas):</span>
            <pre class="bg-slate-950 p-3 rounded-lg text-amber-300 overflow-x-auto">import geopandas as gpd
gdf = gpd.read_file("https://services.dzaleka.com/api/v1/spatial.json")
print(gdf.head())</pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center mb-12">
        <span class="text-slate-700 font-semibold text-sm uppercase tracking-wider">Our approach</span>
        <h2 class="text-3xl font-bold text-gray-900 mt-4">Guiding Principles</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
        <div class="border-l-2 border-slate-300 pl-6 py-2">
          <h3 class="font-bold text-gray-900 mb-2">Evidence-informed storytelling</h3>
          <p class="text-gray-600 text-sm">Data supports local narratives — it doesn't replace them. We make information accessible so creators and researchers can tell Dzaleka's story with confidence.</p>
        </div>

        <div class="border-l-2 border-slate-300 pl-6 py-2">
          <h3 class="font-bold text-gray-900 mb-2">Ethical data stewardship</h3>
          <p class="text-gray-600 text-sm">Consent, privacy, and clarity are central to how we collect and publish. Contributors know how their information will be used.</p>
        </div>

        <div class="border-l-2 border-slate-300 pl-6 py-2">
          <h3 class="font-bold text-gray-900 mb-2">Trust and accountability</h3>
          <p class="text-gray-600 text-sm">Every dataset we publish is part of a commitment to accuracy, representation, and public trust in digital heritage.</p>
        </div>

        <div class="border-l-2 border-slate-300 pl-6 py-2">
          <h3 class="font-bold text-gray-900 mb-2">Community of practice</h3>
          <p class="text-gray-600 text-sm">We work with writers, archivists, community leaders, and youth. Active use and feedback help us improve and stay responsive to community needs.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="relative py-20 overflow-hidden bg-gray-900 border-t border-gray-800">
    <div class="relative container mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-2 bg-gray-800 text-white/90 rounded-full text-sm font-medium mb-4 border border-gray-700">
          Get started
        </span>
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          Explore, build, and contribute
        </h2>
        <p class="text-lg text-white/80 mb-10 max-w-2xl mx-auto">
          Browse the dataset catalog, read the API docs, or explore the data hub.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="/datasets"
            class="inline-flex items-center px-6 py-3 bg-white text-slate-900 rounded-full hover:bg-slate-50 transition-colors duration-150 font-medium"
          >
            Browse datasets
          </a>
          <a
            href="/api-docs"
            class="inline-flex items-center px-6 py-3 bg-gray-800 text-white rounded-full hover:bg-gray-700 transition-colors duration-150 font-medium border border-gray-700"
          >
            API docs
          </a>
          <a
            href="/data"
            class="inline-flex items-center px-6 py-3 bg-gray-800 text-white rounded-full hover:bg-gray-700 transition-colors duration-150 font-medium border border-gray-700"
          >
            Data hub
          </a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
