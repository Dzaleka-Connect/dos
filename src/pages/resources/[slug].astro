---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map(resource => ({
    params: { slug: resource.id },
    props: { resource },
  }));
}

const { resource } = Astro.props;
const { Content } = await render(resource);

// Category color mapping
const categoryColors = {
  'Report': 'bg-primary-100 text-primary-800 border-primary-200',
  'Guide': 'bg-green-100 text-green-800 border-green-200',
  'Factsheet': 'bg-primary-100 text-primary-800 border-primary-200',
  'Document': 'bg-slate-100 text-slate-800 border-slate-200',
  'Research': 'bg-primary-100 text-primary-800 border-primary-200',
  'Media': 'bg-blue-100 text-blue-800 border-blue-200',
  'Legal': 'bg-slate-100 text-slate-800 border-slate-200',
  'Policy': 'bg-slate-100 text-slate-800 border-slate-200',
  'Guidelines': 'bg-slate-100 text-slate-800 border-slate-200',
  'Research article': 'bg-primary-100 text-primary-800 border-primary-200',
  'Research & Report': 'bg-primary-100 text-primary-800 border-primary-200',
  'Story': 'bg-blue-100 text-blue-800 border-blue-200',
  'Insight & Analysis': 'bg-blue-100 text-blue-800 border-blue-200',
  'Situation Reports / Updates': 'bg-amber-100 text-amber-800 border-amber-200',
  'Brief': 'bg-amber-100 text-amber-800 border-amber-200'
};

// Format date
const formattedDate = new Date(resource.data.lastUpdated || resource.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Get related resources
const allResources = await getCollection('resources');
const relatedResources = allResources
  .filter(r =>
    r.id !== resource.id &&
    (r.data.category === resource.data.category ||
     r.data.tags?.some(tag => resource.data.tags?.includes(tag)))
  )
  .slice(0, 3);

// Create SEO metadata
const seo = {
  description: `${resource.data.description || `Learn about ${resource.data.title}, a ${resource.data.category} resource for the Dzaleka community.`}`,
  type: "article",
  canonical: `https://services.dzaleka.com/resources/${resource.id}`,
  openGraph: {
    title: `${resource.data.title} | Dzaleka Online Services`,
    description: resource.data.description || `Learn about ${resource.data.title}, a ${resource.data.category} resource for the Dzaleka community.`,
    type: "article",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/resources/${resource.id}`
  },
  twitter: {
    card: "summary_large_image",
    description: resource.data.description || `Learn about ${resource.data.title}, a ${resource.data.category} resource for the Dzaleka community.`
  }
};

const defaultImageMetadata = {
  "creator": {
    "@type": "Organization",
    "name": "Dzaleka Online Services"
  },
  "creditText": "Dzaleka Online Services",
  "copyrightNotice": `© ${new Date().getFullYear()} Dzaleka Online Services`,
  "license": "https://services.dzaleka.com/terms",
  "acquireLicensePage": "https://services.dzaleka.com/contact"
};

// Create structured data for the resource
const resourceStructuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": resource.data.title,
  "description": resource.data.description,
  "datePublished": resource.data.date,
  "dateModified": resource.data.lastUpdated || resource.data.date,
  "author": {
    "@type": "Organization",
    "name": resource.data.author || "Dzaleka Online Services"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Dzaleka Online Services",
    "logo": {
      "@type": "ImageObject",
      "url": "https://services.dzaleka.com/images/dzaleka-digital-heritage.png",
      ...defaultImageMetadata
    }
  },
  "url": `https://services.dzaleka.com/resources/${resource.id}`
};

// Create breadcrumb structured data
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://services.dzaleka.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Resources",
      "item": "https://services.dzaleka.com/resources"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": resource.data.title,
      "item": `https://services.dzaleka.com/resources/${resource.id}`
    }
  ]
};
---

<MainLayout
  title={`${resource.data.title} - Dzaleka Online Services`}
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(resourceStructuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />

  <main class="min-h-screen bg-gray-50">
    {/* Breadcrumb Navigation */}
    <div class="bg-white border-b border-gray-200">
      <div class="container mx-auto px-4 py-3">
        <div class="flex items-center text-sm overflow-x-auto whitespace-nowrap">
          <a href="/" class="text-gray-500 hover:text-primary-600 transition-colors">Home</a>
          <svg class="w-4 h-4 mx-2 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <a href="/resources" class="text-gray-500 hover:text-primary-600 transition-colors">Resources</a>
          <svg class="w-4 h-4 mx-2 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <span class="text-gray-900 font-medium truncate">{resource.data.title}</span>
        </div>
      </div>
    </div>

    {/* Hero Section - Modern & Clean */}
    <section class="bg-white border-b border-gray-200">
      <div class="container mx-auto px-4 py-8 md:py-12">
        <div class="max-w-5xl mx-auto">
          {/* Meta Information */}
          <div class="flex flex-wrap items-center gap-3 mb-6">
            <span class={`inline-flex items-center px-4 py-1.5 rounded-lg text-sm font-semibold shadow-sm ${
              categoryColors[resource.data.category] || 'bg-gray-100 text-gray-800 border-gray-200'
            }`}>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
              {resource.data.category}
            </span>
            <span class="inline-flex items-center text-sm text-gray-600 px-3 py-1.5 bg-gray-50 rounded-lg border border-gray-200">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              {formattedDate}
            </span>
            {resource.data.featured && (
              <span class="inline-flex items-center px-3 py-1.5 bg-amber-100 text-amber-800 rounded-lg text-xs font-semibold border border-amber-200">
                Featured
              </span>
            )}
          </div>

          {/* Title */}
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4 leading-tight tracking-tight">
            {resource.data.title}
          </h1>

          {/* Description */}
          <p class="text-lg md:text-xl text-gray-600 leading-relaxed mb-6">
            {resource.data.description}
          </p>

          {/* Author & Quick Stats */}
          <div class="flex flex-wrap items-center gap-4 pt-6 border-t border-gray-200 text-sm text-gray-600">
            {resource.data.author && (
              <div class="flex items-center">
                <svg class="h-4 w-4 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span>{resource.data.author}</span>
              </div>
            )}
            {resource.data.fileType && (
              <div class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                </svg>
                <span>
                  {resource.data.fileType.toUpperCase()}
                  {resource.data.fileSize && <span> • {resource.data.fileSize}</span>}
                </span>
              </div>
            )}
            {resource.data.language && (
              <div class="flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                </svg>
                <span>{resource.data.language}</span>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    {/* Main Content & Sidebar */}
    <section class="container mx-auto px-4 py-12">
      <div class="max-w-5xl mx-auto">
        <div class="grid lg:grid-cols-3 gap-8">
          {/* Main Content */}
          <div class="lg:col-span-2">
            {/* Document Preview (if available) */}
            {resource.data.thumbnail && (
              <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden mb-8">
                <img
                  src={resource.data.thumbnail}
                  alt={`Preview of ${resource.data.title}`}
                  class="w-full h-auto"
                />
              </div>
            )}

            {/* Document Content */}
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 md:p-10">
              <div class="prose prose-lg prose-primary max-w-none">
                <Content />
              </div>

              {/* Tags */}
              {resource.data.tags && resource.data.tags.length > 0 && (
                <div class="mt-8 pt-8 border-t border-gray-200">
                  <h3 class="text-sm font-semibold text-gray-900 mb-4">Tags</h3>
                  <div class="flex flex-wrap gap-2">
                    {resource.data.tags.map(tag => (
                      <span class="px-3 py-1.5 bg-gray-100 text-gray-700 rounded-lg text-sm font-medium hover:bg-gray-200 transition-colors">
                        #{tag}
                      </span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>

          {/* Sidebar - Sticky */}
          <div class="space-y-6 lg:sticky lg:top-6 self-start">
            {/* Access Document Card */}
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
              <h2 class="text-lg font-bold text-gray-900 mb-4">
                Access Document
              </h2>

              <div class="space-y-3">
                {resource.data.downloadUrl && (
                  <a
                    href={resource.data.downloadUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center w-full px-5 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors font-medium border border-transparent"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                    Download PDF
                  </a>
                )}
                {resource.data.resourceUrl && (
                  <a
                    href={resource.data.resourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center w-full px-5 py-3 bg-white text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors font-medium"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    View Original
                  </a>
                )}
              </div>
            </div>

            {/* Document Information Card */}
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
              <h3 class="text-lg font-bold text-gray-900 mb-4">
                Document Info
              </h3>

              <dl class="space-y-4">
                {resource.data.author && (
                  <div class="flex items-start">
                    <dt class="w-24 text-sm text-gray-500 font-medium">Author:</dt>
                    <dd class="flex-1 text-sm text-gray-900 font-semibold">{resource.data.author}</dd>
                  </div>
                )}
                {resource.data.fileType && (
                  <div class="flex items-start">
                    <dt class="w-24 text-sm text-gray-500 font-medium">Type:</dt>
                    <dd class="flex-1 text-sm text-gray-900 font-semibold">{resource.data.fileType}</dd>
                  </div>
                )}
                {resource.data.fileSize && (
                  <div class="flex items-start">
                    <dt class="w-24 text-sm text-gray-500 font-medium">Size:</dt>
                    <dd class="flex-1 text-sm text-gray-900 font-semibold">{resource.data.fileSize}</dd>
                  </div>
                )}
                {resource.data.language && (
                  <div class="flex items-start">
                    <dt class="w-24 text-sm text-gray-500 font-medium">Language:</dt>
                    <dd class="flex-1 text-sm text-gray-900 font-semibold">{resource.data.language}</dd>
                  </div>
                )}
                {resource.data.lastUpdated && (
                  <div class="flex items-start">
                    <dt class="w-24 text-sm text-gray-500 font-medium">Updated:</dt>
                    <dd class="flex-1 text-sm text-gray-900 font-semibold">
                      {new Date(resource.data.lastUpdated || resource.data.date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric'
                      })}
                    </dd>
                  </div>
                )}
              </dl>
            </div>

            {/* Share Card */}
            <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
              <h3 class="text-lg font-bold text-gray-900 mb-4">
                Share Resource
              </h3>

              <div class="flex gap-2">
                <button
                  id="shareTwitter"
                  data-url={Astro.url.toString()}
                  data-title={resource.data.title}
                  class="flex-1 flex items-center justify-center p-3 bg-[#1DA1F2] text-white rounded-lg hover:bg-[#1a8cd8] transition-colors"
                  aria-label="Share on Twitter"
                  title="Share on Twitter"
                >
                  <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                  </svg>
                </button>
                <button
                  id="shareLinkedIn"
                  data-url={Astro.url.toString()}
                  data-title={resource.data.title}
                  class="flex-1 flex items-center justify-center p-3 bg-[#0A66C2] text-white rounded-lg hover:bg-[#094c8f] transition-colors"
                  aria-label="Share on LinkedIn"
                  title="Share on LinkedIn"
                >
                  <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </button>
                <button
                  id="copyLink"
                  class="flex-1 flex items-center justify-center p-3 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors"
                  aria-label="Copy link to clipboard"
                  title="Copy link"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Related Resources Section */}
    {relatedResources.length > 0 && (
      <section class="bg-white border-t border-gray-200 py-16">
        <div class="container mx-auto px-4">
          <div class="max-w-5xl mx-auto">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
                Related Resources
              </h2>
              <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                Related documents, reports, and research from the resource library
              </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {relatedResources.map(related => (
                <a
                  href={`/resources/${related.id}`}
                  class="group block"
                >
                  <article class="bg-white rounded-xl shadow-sm border border-gray-200 hover:border-gray-300 transition-colors overflow-hidden h-full">
                    <div class="p-6">
                      <div class="flex items-center justify-between mb-4">
                        <span class={`px-3 py-1 rounded-lg text-xs font-semibold ${
                          categoryColors[related.data.category] || 'bg-gray-100 text-gray-800 border-gray-200'
                        }`}>
                          {related.data.category}
                        </span>
                        {related.data.featured && (
                          <span class="px-2 py-1 bg-amber-100 text-amber-800 rounded-lg text-xs font-semibold border border-amber-200">
                            Featured
                          </span>
                        )}
                      </div>
                      <h3 class="text-lg font-bold text-gray-900 group-hover:text-gray-700 transition-colors line-clamp-2 mb-3">
                        {related.data.title}
                      </h3>
                      <p class="text-gray-600 text-sm line-clamp-3 mb-4">
                        {related.data.description}
                      </p>
                      <div class="flex items-center text-gray-600 hover:text-gray-900 transition-colors text-sm font-medium">
                        Read More
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </div>
                    </div>
                  </article>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
    )}
  </main>
</MainLayout>

<script>
  // Share functionality
  document.addEventListener('DOMContentLoaded', () => {
    const shareTwitter = document.getElementById('shareTwitter');
    const shareLinkedIn = document.getElementById('shareLinkedIn');
    const copyLink = document.getElementById('copyLink');

    if (shareTwitter) {
      shareTwitter.addEventListener('click', () => {
        const url = shareTwitter.getAttribute('data-url');
        const title = shareTwitter.getAttribute('data-title');
        const twitterUrl = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url || window.location.href)}&text=${encodeURIComponent(title || '')}`;
        window.open(twitterUrl, '_blank', 'noopener,noreferrer');
      });
    }

    if (shareLinkedIn) {
      shareLinkedIn.addEventListener('click', () => {
        const url = shareLinkedIn.getAttribute('data-url');
        const title = shareLinkedIn.getAttribute('data-title');
        const linkedInUrl = `https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(url || window.location.href)}&title=${encodeURIComponent(title || '')}`;
        window.open(linkedInUrl, '_blank', 'noopener,noreferrer');
      });
    }

    if (copyLink) {
      copyLink.addEventListener('click', async () => {
        // Try Web Share API first (mobile)
        if (navigator.share) {
          try {
            await navigator.share({
              title: document.title,
              url: window.location.href
            });
            if (window.showToast) {
              window.showToast('Shared successfully!', 'success');
            }
            return;
          } catch (err) {
            // User cancelled share or error occurred
            if ((err as Error).name !== 'AbortError') {
              console.error('Share failed:', err);
            }
          }
        }

        // Fallback to clipboard
        try {
          await navigator.clipboard.writeText(window.location.href);
          if (window.showToast) {
            window.showToast('Link copied to clipboard!', 'success');
          }
        } catch (err) {
          console.error('Failed to copy link:', err);
          if (window.showToast) {
            window.showToast('Failed to copy link. Please copy manually.', 'error');
          }
        }
      });
    }
  });
</script>

<style is:global>
  /* Enhanced Markdown Content Styling */
  .prose {
    @apply text-gray-700;
  }
  .prose h1 {
