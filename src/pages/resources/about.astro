---
import MainLayout from '../../layouts/MainLayout.astro';

// Create SEO metadata
const seo = {
  description: "Learn about the Dzaleka Online Services, preserving 500+ cultural artifacts, documents, and digital resources from the refugee community. Our mission to safeguard cultural heritage and share authentic stories from Malawi's largest refugee camp.",
  type: "website",
  canonical: "https://services.dzaleka.com/resources/about",
  openGraph: {
    description: "Learn about the Dzaleka Online Services, preserving 500+ cultural artifacts, documents, and digital resources from the refugee community. Our mission to safeguard cultural heritage and share authentic stories from Malawi's largest refugee camp.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/resources/about"
  },
  twitter: {
    card: "summary",
    description: "Learn about the Dzaleka Online Services, preserving 500+ cultural artifacts, documents, and digital resources from the refugee community. Our mission to safeguard cultural heritage and share authentic stories from Malawi's largest refugee camp."
  }
};

// Create structured data for the about page
const aboutStructuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Dzaleka Online Services",
  "description": "Learn about the Dzaleka Online Services, our mission to preserve and share the rich cultural heritage of the Dzaleka refugee community.",
  "url": "https://services.dzaleka.com/resources/about",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://services.dzaleka.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Resources",
        "item": "https://services.dzaleka.com/resources"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "About",
        "item": "https://services.dzaleka.com/resources/about"
      }
    ]
  },
  "mainEntity": {
    "@type": "Organization",
    "name": "Dzaleka Services Online",
    "description": "A digital archive preserving and sharing the cultural heritage of the Dzaleka refugee community.",
    "url": "https://services.dzaleka.com/resources",
    "logo": {
      "@type": "ImageObject",
      "url": "https://services.dzaleka.com/images/dzaleka-digital-heritage.png",
      "creator": {
        "@type": "Organization",
        "name": "Dzaleka Online Services"
      },
      "creditText": "Dzaleka Online Services",
      "copyrightNotice": `© ${new Date().getFullYear()} Dzaleka Online Services`,
      "license": "https://services.dzaleka.com/terms",
      "acquireLicensePage": "https://services.dzaleka.com/contact"
    },
    "sameAs": [
      "https://services.dzaleka.com"
    ]
  }
};
---

<MainLayout 
  title="About Dzaleka Online Services"
  description={seo.description} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutStructuredData)} />
  
  <div class="min-h-screen bg-white">
    <div class="bg-white py-4 px-4 sm:px-6 lg:px-8 border-b">
      <div class="max-w-7xl mx-auto">
        <a href="/resources" class="inline-flex items-center text-sm font-medium text-gray-500 hover:text-gray-700">
          <svg class="mr-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M7.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
          </svg>
          Back to Resources
        </a>
      </div>
    </div>
    <!-- Header -->
    <div class="bg-primary-600 py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h1 class="text-4xl font-bold text-white mb-4">About Dzaleka Online Services</h1>
        <p class="text-xl text-white/90">
          Preserving and sharing the rich cultural heritage of the Dzaleka refugee community
        </p>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <!-- Mission & Vision -->
      <div class="space-y-12 mb-16">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Our Mission</h2>
          <p class="text-lg text-gray-600">
            To preserve, document, and share the rich cultural heritage, stories, and experiences of the Dzaleka refugee community 
            through digital resources, ensuring that these valuable narratives are accessible to future generations.
          </p>
        </div>

        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-6">Our Vision</h2>
          <p class="text-lg text-gray-600">
            To maintain a searchable digital archive of documents, research, stories, and public records connected to Dzaleka,
            fostering understanding, connection, and cultural preservation.
          </p>
        </div>
      </div>

      <!-- Values -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Our Values</h2>
        <div class="grid gap-8 md:grid-cols-3">
          <div class="text-center">
            <div class="bg-primary-50 w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-4">
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Preservation</h3>
            <p class="text-gray-600">Ensuring cultural heritage is documented and preserved for future generations.</p>
          </div>

          <div class="text-center">
            <div class="bg-primary-50 w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-4">
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Community</h3>
            <p class="text-gray-600">Celebrating and honoring the diverse voices and experiences of our community.</p>
          </div>

          <div class="text-center">
            <div class="bg-primary-50 w-16 h-16 mx-auto rounded-full flex items-center justify-center mb-4">
              <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Accessibility</h3>
            <p class="text-gray-600">Making cultural resources available to everyone, everywhere.</p>
          </div>
        </div>
      </div>

      <!-- What We Do -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">What we do</h2>
        <div class="grid gap-8 md:grid-cols-2">
          <div class="bg-gray-50 p-8 rounded-lg">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">For community members</h3>
            <ul class="space-y-4">
              <li class="flex items-center">
                <svg class="w-5 h-5 text-primary-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Share Your Story</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-primary-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Access Cultural Resources</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-primary-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Connect with Heritage</span>
              </li>
            </ul>
          </div>

          <div class="bg-gray-50 p-8 rounded-lg">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">For researchers & educators</h3>
            <ul class="space-y-4">
              <li class="flex items-center">
                <svg class="w-5 h-5 text-primary-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Access Primary Sources</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-primary-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Educational Materials</span>
              </li>
              <li class="flex items-center">
                <svg class="w-5 h-5 text-primary-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Research Support</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Notice -->
      <div class="bg-amber-50 p-8 rounded-lg">
        <h2 class="text-xl font-semibold text-amber-800 mb-4">Important Notice</h2>
        <p class="text-amber-700">
          This archive is dedicated to preserving and sharing the cultural heritage of the Dzaleka refugee community. 
          If you have questions about the content or would like to contribute to our archive, please contact the 
          Dzaleka Online Service team at 
          <a href="mailto:dzalekaconnect@gmail.com" class="text-amber-800 underline">dzalekaconnect@gmail.com</a>.
        </p>
      </div>

      <!-- CTA -->
      <div class="mt-16 text-center">
        <div class="space-x-4">
          <a href="/resources" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700">
            Browse Resources
          </a>
          <a href="/resources/submit" class="inline-flex items-center px-6 py-3 border border-primary-600 text-base font-medium rounded-md text-primary-600 hover:bg-primary-50">
            Submit a Resource
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout> 
