---
import MainLayout from '../../layouts/MainLayout.astro';
import CollectionHeader from '../../components/ui/CollectionHeader.astro';
const description = 'What the resource hub contains, how to use its records and how to contribute.';
---
<MainLayout title="About the resource collection" description={description}>
  <CollectionHeader title="About the resource collection" description={description} breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Resources', href: '/resources' }, { label: 'About the collection' }]} action={{ label: 'Browse resources', href: '/resources' }} />
  <div class="mx-auto grid max-w-7xl items-start gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:px-8">
    <article class="prose prose-slate max-w-prose prose-a:text-primary-800">
      <h2 class="!mt-0">What you can find</h2>
      <p>The resource hub brings together reports, research, policies, guides and community records connected to Dzaleka. It helps residents, researchers and educators find documents and understand their context.</p>
      <h2>Find a resource</h2>
      <p>Search by title, author or keyword, or choose a category. Open a record to read its description and follow the supplied document or source link.</p>
      <h2>Read the record</h2>
      <p>Records include publication dates and, where supplied, authors, languages, file details and update dates. Check the original source when using or citing a document. A record's update date is separate from the document's publication date.</p>
      <h2>Help maintain the collection</h2>
      <p>You can <a href="/resources/submit">submit a resource</a> or <a href="/contact">report a correction or broken link</a>. Include the record's title or URL so the team can find it.</p>
      <p>For questions about the archive, email <a href="mailto:dzalekaconnect@gmail.com">dzalekaconnect@gmail.com</a>.</p>
    </article>
    <aside class="rounded border border-slate-200 bg-primary-50 p-6" aria-labelledby="related-collections"><h2 id="related-collections" class="text-xl text-primary-900">Related collections</h2><ul class="mt-4 divide-y divide-primary-100 text-primary-800">
      <li><a class="block py-4 underline underline-offset-4" href="/encyclopedia">Dzaleka Encyclopedia</a></li>
      <li><a class="block py-4 underline underline-offset-4" href="/photos">Photo Archive</a></li>
      <li><a class="block py-4 underline underline-offset-4" href="/datasets">Datasets</a></li>
      <li><a class="block py-4 underline underline-offset-4" href="/dzaleka-time-capsule">Dzaleka Time Capsule</a></li>
    </ul></aside>
  </div>
</MainLayout>
