---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import ResourcePagination from '../../components/resources/ResourcePagination.astro';
import { getCollection } from 'astro:content';

export const prerender = false;
const PAGE_SIZE = 6;
const allResources = (await getCollection('resources')).sort((a, b) => (b.data.lastUpdated || b.data.date).getTime() - (a.data.lastUpdated || a.data.date).getTime());
const categories = [...new Set(allResources.map(resource => resource.data.category))].sort();
const search = (Astro.url.searchParams.get('search') || '').trim();
const requestedCategory = Astro.url.searchParams.get('category') || '';
const category = categories.includes(requestedCategory) ? requestedCategory : '';
const words = search.toLocaleLowerCase().split(/\s+/).filter(Boolean);
const matches = allResources.filter(resource => {
  const text = [resource.data.title, resource.data.description, resource.data.author, resource.data.category, ...(resource.data.tags || [])].join(' ').toLocaleLowerCase();
  return (!category || resource.data.category === category) && words.every(word => text.includes(word));
});
const totalPages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE));
const requestedPage = Number(Astro.params.page || 1);
const currentPage = Number.isSafeInteger(requestedPage) ? Math.max(1, Math.min(totalPages, requestedPage)) : 1;
const start = (currentPage - 1) * PAGE_SIZE;
const resources = matches.slice(start, start + PAGE_SIZE);
const featured = allResources.find(resource => resource.data.featured) || allResources[0];
const introduction = !search && !category && currentPage === 1;
const dateLabel = (date: Date) => date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Africa/Blantyre' });
const description = 'Reports, research, policies and community records connected to Dzaleka.';
---
<MainLayout title="Dzaleka resource hub" description={description}>
  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Resources' }]} />
      <div class:list={['mt-5 grid items-center gap-8', introduction && featured && 'lg:grid-cols-[1fr_1fr]']}>
        <div><p class="mb-3 text-sm font-medium text-primary-700">The document collection</p><h1 class="text-primary-900">Dzaleka resource hub</h1><p class="mt-4 max-w-xl text-base leading-7 text-slate-700">{description}</p>
          <p class="mt-3 text-sm text-slate-600">{allResources.length} records across {categories.length} categories</p>
          <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2"><a href="#resourceSearch" class="inline-flex min-h-[44px] items-center rounded bg-primary-900 px-5 py-3 font-medium text-white hover:bg-primary-800">Search the collection</a><a href="/resources/submit" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Submit a resource</a></div>
        </div>
        {introduction && featured && <article class="border-l-4 border-primary-700 bg-white p-6 sm:p-8">
          <p class="text-sm text-slate-600">From the collection · {featured.data.category}</p>
          <h2 class="mt-3 text-xl leading-7"><a href={`/resources/${featured.id}`} class="text-primary-900 underline underline-offset-4">{featured.data.title}</a></h2>
          <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-700">{featured.data.description}</p>
          <p class="mt-4 text-sm text-slate-500">{featured.data.author} · {dateLabel(featured.data.date)}</p>
        </article>}
      </div>
    </div>
  </header>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <form action="/resources" method="get" role="search" aria-label="Resource collection" class="grid items-end gap-4 rounded border border-slate-200 bg-white p-5 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_auto]">
      <div class="min-w-0"><label for="resourceSearch" class="mb-2 block font-semibold text-slate-900">Search resources</label><input id="resourceSearch" name="search" type="search" value={search} placeholder="Title, author or keyword" class="w-full rounded border-slate-400" /></div>
      <div class="min-w-0"><label for="categoryFilter" class="mb-2 block font-semibold text-slate-900">Category</label><select id="categoryFilter" name="category" class="w-full rounded border-slate-400"><option value="">All categories</option>{categories.map(value => <option value={value} selected={category === value}>{value}</option>)}</select></div>
      <button class="min-h-[44px] rounded bg-primary-900 px-6 py-2.5 font-medium text-white hover:bg-primary-800" type="submit">Search</button>
    </form>
    <section class="mt-8" aria-labelledby="resource-results">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3"><div class="min-w-0"><h2 id="resource-results" class="break-words text-xl text-primary-900">{search ? `Results for “${search}”` : category || 'Browse the collection'}</h2><p class="mt-2 text-sm text-slate-600">{matches.length ? `Showing ${start + 1}–${start + resources.length} of ${matches.length} resources` : 'No resources found'}</p></div>{(search || category) && <a href="/resources" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Clear filters</a>}</div>
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {resources.map(resource => <li class="min-w-0"><article class="flex h-full flex-col rounded border border-slate-200 bg-white">
          {resource.data.thumbnail && <img src={resource.data.thumbnail} alt="" width="480" height="320" loading="lazy" class="h-48 w-full bg-slate-50 object-contain" onerror="this.style.display='none'" />}
          <div class="flex flex-1 flex-col p-6"><div class="flex flex-wrap items-center justify-between gap-2"><p class="text-sm text-primary-700">{resource.data.category}</p>{resource.data.fileType && <span class="rounded bg-slate-100 px-2 py-1 text-xs uppercase text-slate-700">{resource.data.fileType}</span>}</div>
            <h3 class="mt-3 text-xl leading-7"><a href={`/resources/${resource.id}`} class="text-primary-900 underline underline-offset-4">{resource.data.title}</a></h3>
            <p class="mt-3 line-clamp-4 text-sm leading-6 text-slate-700">{resource.data.description}</p>
            <div class="mt-auto pt-5"><p class="border-t border-slate-200 pt-4 text-sm text-slate-600">{resource.data.author && <span class="block">{resource.data.author}</span>}<time datetime={resource.data.date.toISOString()}>{dateLabel(resource.data.date)}</time></p></div>
          </div>
        </article></li>)}
      </ul>
      {!resources.length && <p class="border-y border-slate-200 py-8 text-base text-slate-700">Try another title, author or keyword, or choose all categories.</p>}
      {totalPages > 1 && <div class="mt-8"><ResourcePagination currentPage={currentPage} totalPages={totalPages} baseUrl="/resources" searchQuery={search} category={category} /></div>}
    </section>
    <details class="mt-10 border-y border-slate-200 py-4"><summary class="cursor-pointer py-2 font-semibold text-primary-900">Browse all resource categories</summary><ul class="mt-3 grid gap-x-8 sm:grid-cols-2 lg:grid-cols-3">{categories.map(value => <li><a href={`/resources?category=${encodeURIComponent(value)}`} class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">{value}</a></li>)}</ul></details>
    <p class="mt-5 text-slate-600">Read <a href="/resources/about" class="text-primary-800 underline underline-offset-4">about the collection</a>, or <a href="/contact" class="text-primary-800 underline underline-offset-4">send a correction</a>.</p>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Dzaleka resource hub', description, mainEntity: { '@type': 'ItemList', itemListElement: resources.map((resource, index) => ({ '@type': 'ListItem', position: start + index + 1, name: resource.data.title, url: `https://services.dzaleka.com/resources/${resource.id}` })) } })} />
</MainLayout>
