---
// src/pages/resources/[...page].astro
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import ResourcePagination from '../../components/resources/ResourcePagination.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import EmptyState from '../../components/ui/EmptyState.astro';

export const prerender = false;
const PAGE_SIZE = 6;

// Resource Types Overview
const resourceTypes = [
  {
    title: "Policy Documents & Legal Frameworks",
    description: "Find refugee policies, legal documents, and protection guidelines from UNHCR, government, and rights-focused sources",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>`,
    categories: ["Legal", "Policy", "Guidelines"],
    // Styling
    bgGradient: "from-earth-50/50",
    borderColor: "border-earth-100 group-hover:border-earth-200",
    textColor: "text-earth-700",
    hoverTextColor: "group-hover:text-earth-800",
    tagClass: "text-earth-800 border-earth-200 hover:bg-earth-50"
  },
  {
    title: "Situation Reports & Updates",
    description: "Read factsheets, operational updates, and situation reports about Dzaleka and refugee issues in Malawi",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
    categories: ["Report", "Situation Reports / Updates", "Brief"],
    // Styling
    bgGradient: "from-ochre-50/50",
    borderColor: "border-ochre-100 group-hover:border-ochre-200",
    textColor: "text-ochre-700",
    hoverTextColor: "group-hover:text-ochre-800",
    tagClass: "text-ochre-800 border-ochre-200 hover:bg-ochre-50"
  },
  {
    title: "Research & Academic Studies",
    description: "Browse academic research, case studies, and analysis on displacement, rights, livelihoods, and community life",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>`,
    categories: ["Research", "Research article", "Research & Report"],
    // Styling
    bgGradient: "from-primary-50/50",
    borderColor: "border-primary-100 group-hover:border-primary-200",
    textColor: "text-primary-700",
    hoverTextColor: "group-hover:text-primary-800",
    tagClass: "text-primary-800 border-primary-100 hover:bg-primary-50"
  },
  {
    title: "Stories & Insights",
    description: "Read stories, interviews, essays, and field notes about life, culture, and local initiatives in Dzaleka",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2M7 7h10"/></svg>`,
    categories: ["Story", "Insight & Analysis"],
    // Styling
    bgGradient: "from-terracotta-50/50",
    borderColor: "border-terracotta-100 group-hover:border-terracotta-200",
    textColor: "text-terracotta-700",
    hoverTextColor: "group-hover:text-terracotta-800",
    tagClass: "text-terracotta-800 border-terracotta-100 hover:bg-terracotta-50"
  }
];

// Thematic Areas
const thematicAreas = [
  {
    title: "Protection & Rights",
    description: "Legal protection, human rights, and documentation",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    categories: ["Legal", "Policy", "Guidelines"]
  },
  {
    title: "Vulnerable Groups",
    description: "Women, children, elderly, and special needs",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
    categories: ["Research", "Report"]
  },
  {
    title: "Livelihoods & Services",
    description: "Economic opportunities and essential services",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>`,
    categories: ["Situation Reports / Updates", "Brief"]
  }
];

const rawPageParam = Astro.params.page;
const requestedPage = Number.parseInt(rawPageParam || '1', 10);
const requestedPageNumber = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;
const search = Astro.url.searchParams.get('search') || '';
const category = Astro.url.searchParams.get('category') || '';

const allResources = await getCollection('resources');
const allSortedResources = [...allResources].sort((a, b) => {
  const dateA = new Date(a.data.lastUpdated || a.data.date);
  const dateB = new Date(b.data.lastUpdated || b.data.date);
  return dateB.getTime() - dateA.getTime();
});

// Filters need the full collection, not just the current paginated slice.
const categories = [...new Set(allResources.map(resource => resource.data.category))]
  .filter(Boolean)
  .sort();

let filteredResources = [...allSortedResources];

// Search functionality
if (search) {
  const searchLower = search.toLowerCase().trim();
  filteredResources = filteredResources.filter(resource => {
    const searchableText = [
      resource.data.title,
      resource.data.description,
      resource.data.author,
      resource.data.category,
      ...(resource.data.tags || [])
    ].filter(Boolean).join(' ').toLowerCase();

    return searchableText.includes(searchLower);
  });
}

// Category filtering (only if not already filtered by URL param)
if (category) {
  filteredResources = filteredResources.filter(resource =>
    resource.data.category === category
  );
}

const totalFilteredResources = filteredResources.length;
const totalPages = Math.max(1, Math.ceil(totalFilteredResources / PAGE_SIZE));
const currentPage = Math.min(requestedPageNumber, totalPages);
const pageStart = (currentPage - 1) * PAGE_SIZE;
const sortedResources = filteredResources.slice(pageStart, pageStart + PAGE_SIZE);
const page = {
  data: sortedResources,
  currentPage,
  total: totalFilteredResources,
  size: PAGE_SIZE
};

// Compute page title for search results
let pageHeading = 'All Resources';
let pageDescription = 'Browse our complete collection of resources, reports, and documents';

if (search && category) {
  pageHeading = `Results for "${search}" in ${category}`;
  pageDescription = `${totalFilteredResources} ${totalFilteredResources === 1 ? 'resource' : 'resources'} found`;
} else if (search) {
  pageHeading = `Search Results for "${search}"`;
  pageDescription = `${totalFilteredResources} ${totalFilteredResources === 1 ? 'resource' : 'resources'} found`;
} else if (category) {
  pageHeading = `${category} Resources`;
  pageDescription = `${totalFilteredResources} ${totalFilteredResources === 1 ? 'resource' : 'resources'} found`;
}

// Build pagination URL with search params
function buildPaginationUrl(pageNum: number) {
  const searchParams = new URLSearchParams();
  if (search) searchParams.set('search', search);
  if (category) searchParams.set('category', category);
  const queryString = searchParams.toString();
  return `/resources${pageNum > 1 ? `/${pageNum}` : ''}${queryString ? `?${queryString}` : ''}`;
}

// Category color mapping - matching detail page style
const categoryColors = {
  'Legal': 'bg-earth-100 text-earth-800 border-earth-200',
  'Policy': 'bg-earth-100 text-earth-800 border-earth-200',
  'Guidelines': 'bg-earth-100 text-earth-800 border-earth-200',
  'Report': 'bg-primary-100 text-primary-800 border-primary-200',
  'Research': 'bg-primary-100 text-primary-800 border-primary-200',
  'Brief': 'bg-ochre-100 text-ochre-800 border-ochre-200',
  'Story': 'bg-terracotta-100 text-terracotta-800 border-terracotta-200',
  'Research article': 'bg-primary-100 text-primary-800 border-primary-200',
  'Research & Report': 'bg-primary-100 text-primary-800 border-primary-200',
  'Situation Reports / Updates': 'bg-ochre-100 text-ochre-800 border-ochre-200',
  'Insight & Analysis': 'bg-terracotta-100 text-terracotta-800 border-terracotta-200',
  'default': 'bg-sand-100 text-gray-800 border-sand-200'
};

// Create enhanced SEO metadata
const pageTitle = page.currentPage > 1
  ? `Resources for Refugees - Page ${page.currentPage}`
  : category
    ? `${category} Resources - Dzaleka Refugee Camp`
    : search
      ? `Search Results for "${search}" - Resources`
      : "Resource Hub - Dzaleka Refugee Camp";
const canonicalParams = new URLSearchParams();
if (category) canonicalParams.set('category', category);
if (search) canonicalParams.set('search', search);
const canonicalQuery = canonicalParams.toString();

const seo = {
  title: pageTitle,
  description: category
    ? `Explore ${category.toLowerCase()} resources about Dzaleka Refugee Camp, including reports, legal materials, research, and community records.`
    : search
      ? `Search results for "${search}" in Dzaleka refugee resources. Find relevant documents, reports, and materials about refugee life, rights, and services in Malawi.`
      : `Browse ${allResources.length}+ public resources about Dzaleka Refugee Camp, including UNHCR reports, academic studies, policy documents, legal materials, and community stories.`,
  keywords: [
    "Dzaleka resources",
    "refugee resources Malawi",
    "refugee camp documents",
    "UNHCR Malawi",
    "refugee rights",
    "academic research refugees",
    "refugee policy documents",
    "Dzaleka reports",
    "refugee camp research",
    "humanitarian resources",
    category,
    search
  ].filter(Boolean).join(", "),
  type: "website",
  canonical: `https://services.dzaleka.com/resources${page.currentPage > 1 ? `/${page.currentPage}` : ''}${canonicalQuery ? `?${canonicalQuery}` : ''}`,
  openGraph: {
    title: pageTitle,
    description: category
      ? `Explore ${category.toLowerCase()} resources about Dzaleka Refugee Camp in Malawi.`
      : `Access ${allResources.length}+ resources, reports, and research materials about Dzaleka Refugee Camp.`,
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/resources${page.currentPage > 1 ? `/${page.currentPage}` : ''}`,
    image: {
      url: "https://services.dzaleka.com/images/resources-og.jpg",
      width: 1200,
      height: 630,
      alt: "Dzaleka Refugee Camp Resources - Documents, Reports & Research",
      type: "image/jpeg"
    }
  },
  twitter: {
    card: "summary_large_image",
    title: pageTitle,
    description: category
      ? `${category} resources from Dzaleka Refugee Camp`
      : `${allResources.length}+ public resources about Dzaleka Refugee Camp`,
    image: "https://services.dzaleka.com/images/resources-og.jpg"
  }
};

// Create structured data for the resources list
const resourcesStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Resources for Refugees | Dzaleka Online Services",
  "description": "A collection of resources for refugees in Dzaleka, including educational materials, legal information, and community support resources.",
  "url": `https://services.dzaleka.com/resources${page.currentPage > 1 ? `/${page.currentPage}` : ''}`,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://services.dzaleka.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Resources",
        "item": "https://services.dzaleka.com/resources"
      }
    ]
  },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": page.data.map((resource, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Article",
        "name": resource.data.title,
        "description": resource.data.description,
        "url": `https://services.dzaleka.com/resources/${resource.id}`,
        "datePublished": resource.data.published,
        "author": {
          "@type": "Organization",
          "name": resource.data.author
        }
      }
    }))
  }
};

// Create pagination structured data
const paginationStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": `Resources Page ${page.currentPage} | Dzaleka Online Services`,
  "description": `Page ${page.currentPage} of resources for refugees in Dzaleka.`,
  "url": `https://services.dzaleka.com/resources${page.currentPage > 1 ? `/${page.currentPage}` : ''}`,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://services.dzaleka.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Resources",
        "item": "https://services.dzaleka.com/resources"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": `Page ${page.currentPage}`,
        "item": `https://services.dzaleka.com/resources${page.currentPage > 1 ? `/${page.currentPage}` : ''}`
      }
    ]
  }
};

---

<MainLayout
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  type={seo.type}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(resourcesStructuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(paginationStructuredData)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What types of resources are available about Dzaleka Refugee Camp?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Our resource hub includes policy documents, legal frameworks, UNHCR reports, academic research, situation updates, factsheets, and personal stories about life in Dzaleka Refugee Camp. All resources are verified and regularly updated to ensure accuracy."
          }
        },
        {
          "@type": "Question",
          "name": "How can I access refugee policy documents for Malawi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Browse our Legal and Policy categories to access official refugee policies, legal frameworks, and protection guidelines from UNHCR and the Malawian government. All documents are freely accessible and downloadable."
          }
        },
        {
          "@type": "Question",
          "name": "Are these resources suitable for academic research?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, our collection includes peer-reviewed academic studies, research articles, case studies, and in-depth analysis suitable for academic research on refugee issues, rights, and community development."
          }
        },
        {
          "@type": "Question",
          "name": "How often are resources updated?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Resources are continuously updated as new documents, reports, and research become available. Each resource displays its publication and last updated dates for transparency."
          }
        }
      ]
    })}
  />

  <main class="min-h-screen bg-white">
    {/* Hero Section */}
    <div class="relative border-b border-gray-200 overflow-hidden bg-gray-900 mb-12">
      <div class="absolute inset-0 z-0">
        <img src="/images/dzaleka-hero.jpeg" alt="Dzaleka Resources Hub" class="w-full h-full object-cover" />
        <div class="absolute inset-0 bg-gray-900/60"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
        <div class="max-w-3xl mx-auto text-center">
          <div class="mb-6 flex justify-center">
            <Breadcrumb items={[
              { label: 'Home', href: '/' },
              { label: 'Resources', href: '/resources' },
              ...(page.currentPage > 1 ? [{ label: `Page ${page.currentPage}` }] : [])
            ]} light={true} />
          </div>

          <h1 class="text-4xl md:text-6xl font-bold text-white mb-6 tracking-tight leading-tight">
            Dzaleka Resource Hub
          </h1>
          <p class="text-xl text-gray-200 mb-10 max-w-2xl mx-auto leading-relaxed">
            Search {allResources.length}+ reports, policies, legal materials, studies, guides, and community records connected to Dzaleka.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
            <a
              href="#resourceFilterForm"
              class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-sm font-medium rounded-lg text-gray-900 bg-white hover:bg-gray-50 transition-colors shadow-sm"
            >
              Browse resources
            </a>
            <a
              href="/resources/submit"
              class="inline-flex items-center px-6 py-3 border border-white/30 text-sm font-medium rounded-lg text-white hover:bg-white/10 transition-colors shadow-sm"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 01-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
              </svg>
              Submit a Resource
            </a>
          </div>

          <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-sm text-gray-100">
            <span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-4 py-1.5 font-medium">
              {sortedResources.length} shown on this page
            </span>
            <span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-4 py-1.5 font-medium">
              {categories.length} categories
            </span>
            {(search || category) && (
              <span class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-4 py-1.5 font-medium">
                {totalFilteredResources} filtered results
              </span>
            )}
          </div>
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 py-8">
    <section id="resourceFilterForm" class="mb-14 scroll-mt-24">
      <div class="max-w-5xl mx-auto rounded-2xl border border-gray-200 bg-white p-5 md:p-6">
        <form
          action="/resources"
          method="GET"
          class="space-y-4"
        >
          <div class="flex flex-col gap-3 md:flex-row">
            <div class="flex-1">
              <label for="resourceSearch" class="mb-2 block text-sm font-medium text-gray-700">Search resources</label>
              <div class="relative">
                <input
                  type="text"
                  name="search"
                  id="resourceSearch"
                  placeholder="Search by title, author, or keyword"
                  value={search || ''}
                  class="w-full rounded-lg border border-gray-300 px-4 py-3 pl-11 text-gray-900 placeholder-gray-500 focus:border-gray-500 focus:outline-none focus:ring-2 focus:ring-gray-200"
                />
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
                  </svg>
                </div>
              </div>
            </div>

            <div class="w-full md:w-72">
              <label for="categoryFilter" class="mb-2 block text-sm font-medium text-gray-700">Category</label>
              <select
                name="category"
                id="categoryFilter"
                class="w-full rounded-lg border border-gray-300 px-4 py-3 text-gray-900 focus:border-gray-500 focus:outline-none focus:ring-2 focus:ring-gray-200"
              >
                <option value="">All categories</option>
                {categories.map(cat => (
                  <option value={cat} selected={category === cat}>{cat}</option>
                ))}
              </select>
            </div>

            <div class="md:self-end">
              <button
                type="submit"
                class="inline-flex w-full items-center justify-center rounded-lg bg-gray-900 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-gray-800 md:w-auto"
              >
                Search
              </button>
            </div>
          </div>

          {(search || category) && (
            <div class="flex flex-wrap items-center gap-2 border-t border-gray-100 pt-4">
              <span class="text-sm font-medium text-gray-600">Active filters:</span>
              {search && (
                <span class="inline-flex items-center gap-1.5 rounded-md border border-gray-200 bg-gray-50 px-3 py-1 text-sm text-gray-700">
                  Search: "{search}"
                </span>
              )}
              {category && (
                <span class="inline-flex items-center gap-1.5 rounded-md border border-gray-200 bg-gray-50 px-3 py-1 text-sm text-gray-700">
                  Category: {category}
                </span>
              )}
              <a href="/resources" class="text-sm font-medium text-gray-700 underline decoration-gray-300 underline-offset-2 hover:text-gray-900">
                Clear all
              </a>
            </div>
          )}
        </form>
      </div>
    </section>

    {/* Resource Types Overview - Only show when not searching/filtering */}
    {!search && !category && (
      <section class="mb-20 container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4 tracking-tight">Browse by Collection</h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">Start with the document collection closest to your question.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {resourceTypes.map(type => (
            <a href={`/resources?category=${encodeURIComponent(type.categories[0])}`} class="group flex h-full min-w-0 flex-col rounded-xl border border-gray-200 bg-white px-6 py-6 transition-colors hover:border-gray-300 hover:shadow-sm">
                {/* Icon Container */}
                <div class={`w-10 h-10 rounded-lg mb-4 flex items-center justify-center bg-gray-50 text-gray-600 border border-gray-200`}>
                  <div class="w-5 h-5 flex items-center justify-center">
                     <Fragment set:html={type.icon} />
                  </div>
                </div>

                <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-gray-700 transition-colors break-words">
                  {type.title}
                </h3>
                <p class="text-sm text-gray-600 leading-relaxed break-words">
                  {type.description}
                </p>
            </a>
          ))}
        </div>

        {/* Categories Quick Links */}
        <div class="mt-10 flex flex-wrap justify-center gap-3">
          {categories.slice(0, 8).map(cat => (
             <a
               href={`/resources?category=${encodeURIComponent(cat)}`}
               class="px-4 py-2 bg-gray-50 text-gray-600 rounded-full text-sm font-medium hover:bg-white hover:text-primary-600 hover:shadow-sm border border-transparent hover:border-gray-200 transition-all"
             >
               {cat}
             </a>
          ))}
          {categories.length > 8 && (
             <a href="#resourceFilterForm" class="px-4 py-2 text-primary-600 text-sm font-medium hover:text-primary-700 transition-colors">
               + {categories.length - 8} more
             </a>
          )}
        </div>
      </section>
    )}

    {/* Resources Grid */}
    <section id="results">
      <div class="mb-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-3">{pageHeading}</h2>
        <p class="text-gray-600">{pageDescription}</p>
      </div>

      {filteredResources.length > 0 ? (
        <>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
            {sortedResources.map(resource => (
              <article class="group relative flex h-full min-w-0 flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition-colors hover:border-gray-300">
                {/* Card Header with File Type Badge */}
                <div class="p-5 pb-0">
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <div class="flex min-w-0 flex-wrap items-center gap-2">
                       <span class={`max-w-full break-words px-2 py-0.5 rounded text-xs font-semibold tracking-wide uppercase ${categoryColors[resource.data.category] || categoryColors.default} bg-opacity-10 border-opacity-20`}>
                        {resource.data.category}
                      </span>
                      {resource.data.featured && (
                        <span class="px-2 py-0.5 rounded text-xs font-semibold tracking-wide uppercase bg-ochre-50 text-ochre-700 border border-ochre-100">
                          Featured
                        </span>
                      )}
                    </div>

                    {resource.data.fileType === 'pdf' ? (
                      <span class="inline-flex items-center text-gray-400" title="PDF Document">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                        </svg>
                      </span>
                    ) : (
                      <span class="inline-flex items-center text-gray-400" title="Link/Web Page">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                        </svg>
                      </span>
                    )}
                  </div>

                  <h2 class="text-lg font-bold text-gray-900 line-clamp-2 group-hover:text-primary-700 transition-colors leading-snug mb-2 break-words">
                    <a href={`/resources/${resource.id}`} class="before:absolute before:inset-0">
                      {resource.data.title}
                    </a>
                  </h2>
                </div>

                {/* Card Body */}
                <div class="px-5 pb-5 flex-grow flex flex-col">
                  <p class="text-gray-600 text-sm mb-4 line-clamp-3 leading-relaxed flex-grow break-words">
                    {resource.data.description}
                  </p>

                  {/* Metadata */}
                  <div class="mt-auto flex min-w-0 items-center justify-between gap-3 border-t border-gray-100 pt-4 text-xs text-gray-500">
                    {resource.data.author ? (
                      <div class="flex min-w-0 items-center font-medium text-gray-600">
                        <svg class="h-3.5 w-3.5 mr-1.5 flex-shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        <span class="truncate">{resource.data.author}</span>
                      </div>
                    ) : <div></div>}
                    <div class="flex flex-shrink-0 items-center font-medium text-gray-500">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 mr-1.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                         <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      <time datetime={resource.data.lastUpdated || resource.data.date}>
                        {new Date(resource.data.lastUpdated || resource.data.date).toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'short',
                          day: 'numeric'
                        })}
                      </time>
                    </div>
                  </div>
                </div>
              </article>
            ))}
          </div>

          {page.total > page.size && (
            <ResourcePagination
              currentPage={page.currentPage}
              totalPages={Math.ceil(page.total / page.size)}
              baseUrl="/resources"
              searchQuery={search}
              category={category}
            />
          )}
        </>
      ) : (
        <EmptyState
          title="No resources found"
          description={search || category
            ? "Try adjusting your search terms or filters to find what you're looking for."
            : "No resources available at this time. Check back soon for updates."
          }
          iconType="search"
        >
          <div slot="action" class="flex flex-col sm:flex-row gap-3 justify-center">
            {(search || category) && (
              <Button href="/resources" variant="primary">
                View All Resources
              </Button>
            )}
            <Button href="/resources/submit" variant="outline">
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
              Submit a Resource
            </Button>
          </div>
          {categories.length > 0 && (
            <div class="mt-6">
              <p class="text-sm text-gray-600 mb-3">Browse by category:</p>
              <div class="flex flex-wrap justify-center gap-2">
                {categories.slice(0, 6).map(cat => (
                  <a
                    href={`/resources?category=${encodeURIComponent(cat)}`}
                    class="px-3 py-1 bg-primary-50 text-primary-700 rounded-full text-sm hover:bg-primary-100 transition-colors"
                  >
                    {cat}
                  </a>
                ))}
              </div>
            </div>
          )}
        </EmptyState>
      )}
    </section>

    {/* Information Cards */}
    <section class="mt-16 mb-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {/* History Card */}
        <div class="group bg-white border border-gray-200 rounded-xl p-6 hover:border-gray-300 transition-colors flex flex-col h-full relative overflow-hidden">
          <div class="relative z-10 flex-grow flex flex-col">
            <div class="w-10 h-10 bg-gray-50 rounded-lg border border-gray-200 flex items-center justify-center text-gray-600 mb-4 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">History</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              A dated archive of public documents and records connected to Dzaleka, including materials that help explain changes since 1994.
            </p>
          </div>
        </div>

        {/* Mission & Scope Card */}
        <div class="group bg-white border border-gray-200 rounded-xl p-6 hover:border-gray-300 transition-colors flex flex-col h-full relative overflow-hidden">
          <div class="relative z-10 flex-grow flex flex-col">
            <div class="w-10 h-10 bg-gray-50 rounded-lg border border-gray-200 flex items-center justify-center text-gray-600 mb-4 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Why this hub exists</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              To make public documents easier to find, compare, cite, and use when people need context about rights, services, policy, or camp history.
            </p>
          </div>
        </div>

        {/* Our audience Card */}
        <div class="group bg-white border border-gray-200 rounded-xl p-6 hover:border-gray-300 transition-colors flex flex-col h-full relative overflow-hidden">
          <div class="relative z-10 flex-grow flex flex-col">
             <div class="w-10 h-10 bg-gray-50 rounded-lg border border-gray-200 flex items-center justify-center text-gray-600 mb-4 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Who it helps</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Built for residents, service providers, researchers, advocates, staff, and anyone checking public information about Dzaleka.
            </p>
          </div>
        </div>

        {/* Contact Us Card */}
        <a href="/contact" class="group bg-white border border-gray-200 rounded-xl p-6 hover:border-gray-300 transition-colors flex flex-col h-full relative overflow-hidden">
          <div class="relative z-10 flex-grow flex flex-col">
             <div class="w-10 h-10 bg-gray-50 rounded-lg border border-gray-200 flex items-center justify-center text-gray-600 mb-4 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">Contact Us</h3>
            <p class="text-gray-600 text-sm mb-4 leading-relaxed flex-grow">
              Send corrections, missing links, new documents, or questions about a resource record.
            </p>
            <div class="flex items-center text-sm font-semibold text-gray-700 transition-colors mt-auto">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
              </svg>
              <span class="break-all">dzalekaconnect@gmail.com</span>
            </div>
          </div>
        </a>
      </div>
    </section>
   </div>
  </main>
</MainLayout>

<script>
  // Clear search button functionality and auto-scroll to results
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('resourceSearch');
    const clearButton = document.getElementById('clearResourceSearch');
    const urlParams = new URLSearchParams(window.location.search);
    const hasSearchOrFilter = urlParams.get('search') || urlParams.get('category');

    function updateClearButton() {
      if (searchInput && clearButton) {
        if (searchInput.value.length > 0) {
          clearButton.classList.remove('hidden');
        } else {
          clearButton.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', updateClearButton);

    clearButton?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        updateClearButton();
        searchInput.focus();
      }
    });

    // Initialize on page load
    updateClearButton();

    // Auto-scroll to results if user just searched/filtered
    if (hasSearchOrFilter) {
      const resultsSection = document.getElementById('results');
      if (resultsSection) {
        setTimeout(() => {
          resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
      }
    }
  });
</script>

<style is:global>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Custom select dropdown styling for better visibility on gradient background */
  select option {
    background-color: white;
    color: #1f2937;
  }
</style>
