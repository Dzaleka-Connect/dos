    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Hero Image Slider
        const slides = document.querySelectorAll('[id^="slide-"]');
        let currentSlide = 0;
        const slideInterval = 5000; // 5 seconds
        
        function showSlide(index) {
          slides.forEach((slide, i) => {
            if (i === index) {
              slide.style.opacity = '1';
            } else {
              slide.style.opacity = '0';
            }
          });
        }
        
        function nextSlide() {
          currentSlide = (currentSlide + 1) % slides.length;
          showSlide(currentSlide);
        }
        
        // Auto-slide every 5 seconds
        setInterval(nextSlide, slideInterval);
        
        // Community Carousel
        const carousel = document.getElementById('carousel');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');

        let currentCarouselSlide = 0;
        const slideWidth = 320; // w-80 = 320px
        const maxSlides = 5; // Total number of slides

        function updateCarousel() {
          carousel.style.transform = `translateX(-${currentCarouselSlide * slideWidth}px)`;

          // Update arrow visibility
          prevBtn.style.display = currentCarouselSlide === 0 ? 'none' : 'block';
          // Adjust logic for end of carousel (show fewer items at once on mobile vs desktop?)
          // For simplicity, let's just limit it so we don't scroll past the end
          // Assuming 3 items visible on desktop, we stop earlier
          const visibleSlides = window.innerWidth >= 1024 ? 3 : window.innerWidth >= 768 ? 2 : 1;
          nextBtn.style.display = currentCarouselSlide >= maxSlides - visibleSlides ? 'none' : 'block';
        }

        prevBtn.addEventListener('click', () => {
          if (currentCarouselSlide > 0) {
            currentCarouselSlide--;
            updateCarousel();
          }
        });

        nextBtn.addEventListener('click', () => {
          const visibleSlides = window.innerWidth >= 1024 ? 3 : window.innerWidth >= 768 ? 2 : 1;
          if (currentCarouselSlide < maxSlides - visibleSlides) {
            currentCarouselSlide++;
            updateCarousel();
          }
        });
        
        // Update on resize
        window.addEventListener('resize', updateCarousel);

        // Initialize carousel
        updateCarousel();
      });
    </script>

