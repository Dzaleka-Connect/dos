---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import SearchBar from '../components/ui/SearchBar.astro';
import MobileServiceCard from '../components/MobileServiceCard.astro';
import FeaturedServices from '../components/services/FeaturedServices.astro';
import ResourceGrid from '../components/resources/ResourceGrid.astro';
import { format } from 'date-fns';

// Get all services and filter featured ones
const services = await getCollection('services');
const featuredServices = services
  .filter(service => service.data.featured)
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .slice(0, 6);

// Get upcoming events
const events = await getCollection('events');
const upcomingEvents = events
  .filter(event => {
    // Check if event is TBA either in data or title
    const isTBA = event.data.isTBA || event.data.title.toLowerCase().includes('tba');
    return isTBA || new Date(event.data.date) >= new Date();
  })
  .sort((a, b) => {
    // Put TBA events at the end
    const aIsTBA = a.data.isTBA || a.data.title.toLowerCase().includes('tba');
    const bIsTBA = b.data.isTBA || b.data.title.toLowerCase().includes('tba');
    if (aIsTBA) return 1;
    if (bIsTBA) return -1;
    return new Date(a.data.date).getTime() - new Date(b.data.date).getTime();
  })
  .slice(0, 3);

// Fetch latest resources
const allResources = await getCollection('resources');
const latestResources = allResources
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 6); // Get latest 6 resources

const categories = [
  {
    title: 'Humanitarian Aid',
    icon: '🤝',
    description: 'Access essential support and emergency assistance'
  },
  {
    title: 'Education',
    icon: '📚',
    description: 'Find learning opportunities and educational resources'
  },
  {
    title: 'Healthcare',
    icon: '⚕️',
    description: 'Access the Ministry of Health clinic and local pharmacies'
  },
  {
    title: 'Legal Support',
    icon: '⚖️',
    description: 'Get help with legal matters and advocacy'
  },
  {
    title: 'Youth Programs',
    icon: '🌟',
    description: 'Discover opportunities for young people'
  },
  {
    title: 'Community',
    icon: '👥',
    description: 'Connect with community groups and activities'
  }
];

const mobileServices = [
  {
    name: 'TNM Malawi',
    logo: 'https://www.tnm.co.mw/_nuxt/img/tnm-logo-1.0dd9a10.svg',
    description: "Get connected with TNM's reliable mobile and data services.",
    services: ['Mobile Services', 'Internet', 'Mpamba'],
    link: 'https://www.tnm.co.mw',
    icon: '📱',
    socialMedia: {
      website: 'https://www.tnm.co.mw',
      facebook: 'https://www.facebook.com/tnmmw',
      twitter: 'https://twitter.com/tnmmw',
      instagram: 'https://www.instagram.com/tnmmw',
      linkedin: 'https://www.linkedin.com/company/tnm-malawi'
    }
  },
  {
    name: 'Airtel Malawi',
    logo: 'https://cdn-webportal.airtelstream.net/website/malawi/assets/images/main-logo.svg',
    description: 'Experience wide coverage and fast internet with Airtel.',
    services: ['Mobile Services', '4G Internet', 'Airtel Money'],
    link: 'https://www.airtel.mw',
    icon: '📶',
    socialMedia: {
      website: 'https://www.airtel.mw',
      facebook: 'https://www.facebook.com/airtelmw',
      twitter: 'https://twitter.com/airtelmw',
      instagram: 'https://www.instagram.com/airtelmw',
      linkedin: 'https://www.linkedin.com/company/airtel-malawi'
    }
  }
];

const stats = [
  { number: '55,425', label: 'Current Camp Population' },
  { number: '35,952', label: 'DRC Refugees' },
  { number: '79%', label: 'Funding Gap' },
  { number: '66', label: 'UNHCR Staff' }
];

const nationalities = ['Congolese', 'Burundians', 'Rwandans', 'Somalis', 'Ethiopians'];

// SEO metadata
const seo = {
  title: 'Dzaleka Online Services',
  description: 'Your digital gateway to Dzaleka Refugee Camp services, cultural heritage, and community connections. Find healthcare, education, business services, photo galleries, and local resources in Malawi\'s largest refugee community.',
  image: '/images/283945145_548818096818208_2823546272117801301_n.jpg',
  keywords: [
    'Dzaleka Services',
    'Refugee Services',
    'Community Services',
    'Malawi Refugee Camp',
    'Online Services'
  ].filter(Boolean).join(', '),
  type: 'website'
};

---

<MainLayout title="Welcome to Dzaleka Online Services">
  <main>
    <!-- Hero Section -->
    <div class="relative min-h-[600px] flex items-center justify-center text-white overflow-hidden">
      {/* Background Image */}
      <div class="absolute inset-0">
        <img 
          src="/images/dzaleka-hero.jpeg" 
          alt="Dzaleka Community" 
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>
      </div>

      {/* Content */}
      <div class="relative container mx-auto px-4 py-20 text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 max-w-4xl mx-auto leading-tight">
          Welcome to Dzaleka Online Services
        </h1>
        <p class="text-xl md:text-2xl text-white/90 mb-12 max-w-2xl mx-auto">
          Your digital gateway to community services, cultural events, resources, and connections in Dzaleka Refugee Camp
        </p>

        {/* Search Bar */}
        <div class="max-w-2xl mx-auto">
          <form action="/search/results/" method="GET" class="relative">
            <input
              type="text"
              name="q"
              placeholder="Search organizations and resources..."
              class="w-full px-6 py-4 text-lg rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-white placeholder-white/70 focus:outline-none focus:ring-2 focus:ring-white/50"
            />
            <button
              type="submit"
              class="absolute right-3 top-1/2 -translate-y-1/2 p-2 hover:bg-white/10 rounded-full transition-colors duration-200 flex items-center justify-center"
              aria-label="Search"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
          </form>
        </div>

        {/* Quick Links */}
        <div class="mt-12 flex flex-wrap justify-center gap-4">
          <a href="/photos" class="px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 transition-all duration-200">
            Browse Photos
          </a>
          <a href="/services" class="px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 transition-all duration-200">
            Find Services
          </a>
          <a href="/about" class="px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 transition-all duration-200">
            About Us
          </a>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <div class="bg-white py-12 -mt-8 relative z-10">
      <div class="container mx-auto px-4">
        <div class="bg-white rounded-2xl shadow-xl p-8">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">
            {stats.map(stat => (
              <div class="text-center">
                <div class="text-3xl md:text-4xl font-bold text-primary-600 mb-2">{stat.number}</div>
                <div class="text-gray-600">{stat.label}</div>
              </div>
            ))}
          </div>
          <div class="border-t pt-6">
            <p class="text-center text-gray-600 mb-4">Main Nationalities in Dzaleka:</p>
            <div class="flex flex-wrap justify-center gap-4">
              {nationalities.map(nationality => (
                <span class="px-4 py-2 bg-primary-50 text-primary-700 rounded-full text-sm font-medium">
                  {nationality}
                </span>
              ))}
            </div>
            <div class="text-center mt-6 text-sm text-gray-500">
              Source: <a href="https://www.unhcr.org/sites/default/files/2024-11/Fact%20Sheet_Malawi_August%202024.pdf" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:underline">UNHCR Malawi Fact Sheet - August 2024</a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Housing & Infrastructure Development -->
    <div class="bg-gray-50 py-12">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">
            Housing & Infrastructure Development
          </h2>
          
          <div class="grid md:grid-cols-2 gap-8">
            <!-- Current Challenges -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-orange-100 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">Current Challenges</h3>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                Dzaleka refugee camp remains highly congested, resulting in poor living conditions and inadequate infrastructure due to limited space and resources.
              </p>
            </div>

            <!-- 2023 Progress -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">2023 Achievements</h3>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                To improve housing conditions, a total of <strong>8,047 housing units</strong> were constructed in 2023, significantly enhancing living standards for camp residents.
              </p>
            </div>

            <!-- 2024 Progress -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">2024 Developments</h3>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                Significant progress in shelter and infrastructure establishment at camp extension areas: <strong>Katubza</strong>, <strong>Woodlot</strong>, and <strong>Dzaleka Hills</strong> to accommodate more refugees.
              </p>
            </div>

            <!-- New Settlement Plan -->
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">New Settlement Plan</h3>
              </div>
              <p class="text-gray-600 text-sm leading-relaxed">
                Government identified new site in <strong>Kayilizi area, Chitipa</strong>: <strong>439 hectares</strong> to accommodate <strong>10,240 households</strong> (approximately <strong>51,200 individuals</strong>).
              </p>
            </div>
          </div>

          <div class="mt-8 text-center">
            <p class="text-sm text-gray-500">
              Two Joint Assessment Missions (JAM) conducted in July 2023 and March 2024 to evaluate the new settlement site.
            </p>
            <p class="text-sm text-gray-500 mt-2">
              Source: <a href="https://www.unhcr.org/sites/default/files/2024-11/Fact%20Sheet_Malawi_August%202024.pdf" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:underline">UNHCR Malawi Fact Sheet - August 2024</a>
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Essential Services & Living Conditions -->
    <div class="bg-white py-12">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">
            Essential Services & Living Conditions
          </h2>
          
          <div class="grid lg:grid-cols-3 gap-8">
            <!-- Food Security & Nutrition -->
            <div class="bg-gradient-to-br from-orange-50 to-red-50 rounded-xl p-6 border border-orange-200">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.5 5M7 13l2.5 5m6-5v6a2 2 0 01-2 2H9a2 2 0 01-2-2v-6m6 5V9a2 2 0 00-2-2H9a2 2 0 00-2 2v4.01" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">Food Security & Nutrition</h3>
              </div>
              
              <div class="space-y-3 text-sm">
                <div class="bg-white/50 rounded-lg p-3">
                  <p class="text-gray-700 font-medium mb-1">Food Security Status</p>
                  <p class="text-gray-600">Only <strong>22%</strong> of households were marginally food secure with WFP assistance (Nov 2023 assessment)</p>
                </div>
                
                <div class="bg-white/50 rounded-lg p-3">
                  <p class="text-gray-700 font-medium mb-1">WFP Assistance</p>
                  <p class="text-gray-600">Ration size increased from <strong>50%</strong> to <strong>75%</strong> starting August 2024 to address El Niño-induced food insecurity</p>
                </div>
              </div>
            </div>

            <!-- Water & Sanitation -->
            <div class="bg-gradient-to-br from-blue-50 to-cyan-50 rounded-xl p-6 border border-blue-200">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">Water & Sanitation</h3>
              </div>
              
              <div class="space-y-3 text-sm">
                <div class="bg-white/50 rounded-lg p-3">
                  <p class="text-gray-700 font-medium mb-1">Water Supply</p>
                  <ul class="text-gray-600 space-y-1">
                    <li>• <strong>36</strong> functional handpumps</li>
                    <li>• <strong>13</strong> electrical pumps</li>
                    <li>• <strong>275</strong> functional taps</li>
                    <li>• <strong>8</strong> chlorinated solar systems</li>
                  </ul>
                </div>
                
                <div class="bg-white/50 rounded-lg p-3">
                  <p class="text-gray-700 font-medium mb-1">Sanitation</p>
                  <ul class="text-gray-600 space-y-1">
                    <li>• <strong>84.5%</strong> households have own latrine</li>
                    <li>• <strong>324</strong> communal latrine stances</li>
                    <li>• <strong>30.3%</strong> have handwashing devices</li>
                    <li>• <strong>54.5%</strong> have access to soap</li>
                  </ul>
                </div>
              </div>
            </div>

            <!-- Waste Management & Livelihoods -->
            <div class="bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-6 border border-green-200">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">Waste & Livelihoods</h3>
              </div>
              
              <div class="space-y-3 text-sm">
                <div class="bg-white/50 rounded-lg p-3">
                  <p class="text-gray-700 font-medium mb-1">Waste Management</p>
                  <ul class="text-gray-600 space-y-1">
                    <li>• <strong>25,000+ kg</strong> waste per day</li>
                    <li>• <strong>80%</strong> organic matter</li>
                    <li>• <strong>13</strong> collection sites</li>
                    <li>• <strong>80%</strong> households have access</li>
                  </ul>
                </div>
                
                <div class="bg-white/50 rounded-lg p-3">
                  <p class="text-gray-700 font-medium mb-1">Livelihoods</p>
                  <ul class="text-gray-600 space-y-1">
                    <li>• <strong><7%</strong> benefit from activities</li>
                    <li>• Crop & livestock production</li>
                    <li>• Insect farming</li>
                    <li>• Enterprise development</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-8 text-center">
            <p class="text-sm text-gray-500">
              Source: <a href="https://www.unhcr.org/sites/default/files/2024-11/Fact%20Sheet_Malawi_August%202024.pdf" target="_blank" rel="noopener noreferrer" class="text-primary-600 hover:underline">UNHCR Malawi Fact Sheet - August 2024</a>
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Explore Our Community Carousel -->
    <div class="container mx-auto px-4 py-12">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">
          Explore Our Community
        </h2>
        <p class="text-gray-600">
          Discover different aspects of life in Dzaleka Refugee Camp
        </p>
      </div>

      <div class="relative">
        {/* Navigation Arrows */}
        <button id="prevBtn" class="absolute left-0 top-1/2 transform -translate-y-1/2 z-10 bg-white rounded-full p-2 shadow-lg hover:shadow-xl transition-all duration-200 border border-gray-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        
        <button id="nextBtn" class="absolute right-0 top-1/2 transform -translate-y-1/2 z-10 bg-white rounded-full p-2 shadow-lg hover:shadow-xl transition-all duration-200 border border-gray-200">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        {/* Carousel Container */}
        <div class="overflow-hidden">
          <div id="carousel" class="flex transition-transform duration-300 ease-in-out gap-6">
            {/* Services */}
            <div class="flex-shrink-0 w-80">
              <a href="/services" class="block bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-200 p-6 group h-full">
                <div class="w-12 h-12 bg-primary-100 rounded-lg flex items-center justify-center mb-4 group-hover:bg-primary-200 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">Community Directory</h3>
                <p class="text-gray-600 mb-4">
                  Connect with essential services and refugee-led organizations within the Dzaleka community
                </p>
                <span class="inline-flex items-center text-primary-600 hover:text-primary-700 font-medium">
                  Find Support
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </span>
              </a>
            </div>

            {/* Resources */}
            <div class="flex-shrink-0 w-80">
              <a href="/resources" class="block bg-white rounded-xl shadow-sm hover:shadow-lg transition-all duration-200 p-6 group h-full">
