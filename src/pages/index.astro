---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import { format } from 'date-fns';

// Get all services and filter featured ones
const services = await getCollection('services');
const featuredServices = services
  .filter(service => service.data.featured)
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .slice(0, 6);

// Get upcoming events
const events = await getCollection('events');
const upcomingEvents = events
  .filter(event => {
    // Check if event is TBA either in data or title
    const isTBA = event.data.isTBA || event.data.title.toLowerCase().includes('tba');
    return isTBA || new Date(event.data.date) >= new Date();
  })
  .sort((a, b) => {
    // Put TBA events at the end
    const aIsTBA = a.data.isTBA || a.data.title.toLowerCase().includes('tba');
    const bIsTBA = b.data.isTBA || b.data.title.toLowerCase().includes('tba');
    if (aIsTBA) return 1;
    if (bIsTBA) return -1;
    return new Date(a.data.date).getTime() - new Date(b.data.date).getTime();
  })
  .slice(0, 3);

// Fetch latest resources
const allResources = await getCollection('resources');
const latestResources = allResources
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 6); // Get latest 6 resources



const stats = [
  { number: '55,425', label: 'Current Camp Population' },
  { number: '35,952', label: 'DRC Refugees' },
  { number: '79%', label: 'Funding Gap' },
  { number: '66', label: 'UNHCR Staff' }
];

const nationalities = ['Congolese', 'Burundians', 'Rwandans', 'Somalis', 'Ethiopians'];

// SEO metadata
const seo = {
  title: 'Dzaleka Online Services',
  description: 'Your digital gateway to Dzaleka Refugee Camp services, cultural heritage, and community connections. Find healthcare, education, business services, photo galleries, and local resources in Malawi\'s largest refugee community.',
  image: '/images/283945145_548818096818208_2823546272117801301_n.jpg',
  keywords: [
    'Dzaleka Services',
    'Refugee Services',
    'Community Services',
    'Malawi Refugee Camp',
    'Online Services'
  ].filter(Boolean).join(', '),
  type: 'website'
};

