---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import { format } from 'date-fns';
import HomeSection from '../components/home/Section.astro';
import PageFeedback from '../components/ui/PageFeedback.astro';

export const prerender = false;

const serviceTopics = [
  {
    href: '/services', title: 'Services and support', description: 'Local organisations and community support.',
    icon: 'M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16m14 0h2m-2 0h-5M5 21H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5h4v5',
  },
  {
    href: '/dzaleka-wellbeing', title: 'Health and wellbeing', description: 'Find care and support for your wellbeing.',
    icon: 'M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z',
  },
  {
    href: '/skills-exchange', title: 'Education and skills', description: 'Find teachers and share practical skills.',
    icon: 'M12 6.3v13m0-13C9 4.5 6 4.5 3 6.3v13c3-1.8 6-1.8 9 0m0-13c3-1.8 6-1.8 9 0v13c-3-1.8-6-1.8-9 0',
  },
  {
    href: '/jobs', title: 'Jobs and opportunities', description: 'Browse vacancies and opportunities to work.',
    icon: 'M21 13a24 24 0 0 1-18 0M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2m4 6h.01M5 20h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2Z',
  },
  {
    href: '/grants-and-programs', title: 'Grants and programs', description: 'Explore funding, scholarships and support programs.',
    icon: 'M12 3 3 8l9 5 9-5-9-5Zm-6 8v6c4 3 8 3 12 0v-6m3-3v9',
  },
  {
    href: '/events', title: 'Events and culture', description: 'See what is happening in the community.',
    icon: 'M8 7V3m8 4V3M3 11h18M5 21h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2Z',
  },
  {
    href: 'https://visit.dzaleka.com/', title: 'Visit Dzaleka', description: 'Plan a visit and discover local experiences.',
    icon: 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM3 12h18M12 3c4 5 4 13 0 18-4-5-4-13 0-18Z',
  },
  {
    href: '/map', title: 'Maps and places', description: 'Find your way around Dzaleka.',
    icon: 'm9 18-6 3V6l6-3 6 3 6-3v15l-6 3-6-3Zm0 0V3m6 3v15',
  },
  {
    href: '/resources', title: 'Guides and resources', description: 'Read community guides and useful documents.',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6l6 6v10a2 2 0 0 1-2 2ZM13 3v6h6',
  },
];

// Get upcoming events
const events = await getCollection('events');
const upcomingEvents = events
  .filter(event => {
    // Check if event is TBA either in data or title
    const isTBA = event.data.isTBA || event.data.title.toLowerCase().includes('tba');
    if (isTBA) return true;

    const eventDate = new Date(event.data.date);
    const now = new Date();

    // Reset time to start of day for accurate date comparison
    eventDate.setHours(0, 0, 0, 0);
    now.setHours(0, 0, 0, 0);

    return eventDate >= now;
  })
  .sort((a, b) => {
    // Put TBA events at the end
    const aIsTBA = a.data.isTBA || a.data.title.toLowerCase().includes('tba');
    const bIsTBA = b.data.isTBA || b.data.title.toLowerCase().includes('tba');
    if (aIsTBA) return 1;
    if (bIsTBA) return -1;
    return new Date(a.data.date).getTime() - new Date(b.data.date).getTime();
  })
  .slice(0, 3);

// Fetch latest resources
const allResources = await getCollection('resources');
const latestResources = allResources
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 6); // Get latest 6 resources

// Fetch announcements for Notice Board
const news = await getCollection('news');
const announcements = news
  .filter(item => item.data.category === 'announcement')
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

// SEO metadata
const canonical = 'https://services.dzaleka.com/';
const seo = {
  title: 'Dzaleka Online Services | Help, services, jobs and community records',
  description: 'Find urgent help, local services, jobs, events, public resources, community data, and cultural records for Dzaleka Refugee Camp in Malawi.',
  canonical,
  openGraph: {
    title: 'Dzaleka Online Services | Help, services, jobs and community records',
    description: 'Find urgent help, local services, jobs, events, public resources, community data, and cultural records for Dzaleka Refugee Camp in Malawi.',
    type: 'website',
    site_name: 'Dzaleka Online Services',
    locale: 'en_US',
    url: canonical,
    image: {
      url: 'https://services.dzaleka.com/images/dzaleka-hero.jpeg',
      alt: 'View of community life in Dzaleka Refugee Camp'
    }
  },
  twitter: {
    card: 'summary_large_image',
    title: 'Dzaleka Online Services | Help, services, jobs and community records',
    description: 'Find urgent help, local services, jobs, events, public resources, community data, and cultural records for Dzaleka Refugee Camp in Malawi.',
    image: 'https://services.dzaleka.com/images/dzaleka-hero.jpeg'
  }
};

const homepageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${canonical}#website`,
    name: 'Dzaleka Online Services',
    alternateName: ['Dzaleka Online', 'services.dzaleka.com'],
    url: canonical,
    description: seo.description,
    inLanguage: 'en',
    publisher: {
      '@id': `${canonical}#organization`
    },
    about: {
      '@id': 'https://services.dzaleka.com/encyclopedia/dzaleka-refugee-camp#entity'
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${canonical}#organization`,
    name: 'Dzaleka Online Services',
    url: canonical,
    description: seo.description,
    email: 'mailto:dzalekaconnect@gmail.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://services.dzaleka.com/images/dzaleka-digital-heritage.png'
    },
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Dzaleka Refugee Camp',
      addressRegion: 'Dowa District',
      addressCountry: 'MW'
    },
    areaServed: {
      '@id': 'https://services.dzaleka.com/encyclopedia/dzaleka-refugee-camp#entity'
    },
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: 'dzalekaconnect@gmail.com',
        url: 'https://services.dzaleka.com/contact',
        areaServed: 'MW',
        availableLanguage: ['English', 'French', 'Swahili']
      },
      {
        '@type': 'ContactPoint',
        contactType: 'emergency',
        url: 'https://services.dzaleka.com/get-help-now',
        areaServed: 'MW',
        availableLanguage: ['English', 'French', 'Swahili']
      },
      {
        '@type': 'ContactPoint',
        contactType: 'technical support',
        email: 'dzalekaconnect@gmail.com',
        url: 'https://services.dzaleka.com/api-docs',
        availableLanguage: ['English']
      }
    ],
    sameAs: [
      'https://facebook.com/dzalekaonline',
      'https://twitter.com/dzalekaconnect',
      'https://instagram.com/dzalekaonline'
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Place',
    '@id': 'https://services.dzaleka.com/encyclopedia/dzaleka-refugee-camp#entity',
    name: 'Dzaleka Refugee Camp',
    alternateName: ['Dzaleka Camp', 'Dzaleka Refugee Settlement'],
    description: "A long-established refugee settlement in Dowa District, Malawi, opened in 1994 and home to a multilingual community from the Great Lakes region and the Horn of Africa.",
    url: 'https://services.dzaleka.com/encyclopedia/dzaleka-refugee-camp',
    image: 'https://services.dzaleka.com/images/encyclopedia/entrance-sign.jpg',
    geo: {
      '@type': 'GeoCoordinates',
      latitude: -13.6628138,
      longitude: 33.8704301
    },
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Dzaleka',
      addressRegion: 'Dowa District',
      addressCountry: 'MW'
    },
    sameAs: [
      'https://www.wikidata.org/wiki/Q135224742',
      'https://en.wikipedia.org/wiki/Dzaleka_Refugee_Camp',
      'https://www.unhcr.org/us/where-we-work/countries/malawi'
    ]
  }
];

---

<MainLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
  schema={homepageSchema}
>
  <div>
    <section class="relative overflow-hidden bg-slate-50" aria-labelledby="home-heading">
      <img src="/images/dzaleka-hero.jpeg" alt="" fetchpriority="high" class="absolute inset-0 hidden h-full w-full object-cover object-center sm:block" />
      <div class="relative mx-auto max-w-7xl sm:px-6 sm:py-10 lg:px-8">
        <div class="mx-auto max-w-4xl border-b-4 border-primary-700 bg-slate-50 px-4 py-8 sm:px-8 sm:py-9">
          <h1 id="home-heading" class="text-3xl font-semibold leading-tight text-primary-900 sm:text-center sm:text-4xl">
            Dzaleka Online Services
          </h1>
          <p class="mt-3 text-sm leading-6 text-slate-600 sm:text-center">
            Find local services, jobs, events and community information.
          </p>
          <form action="/search/results/" method="GET" role="search" class="mx-auto mt-6 max-w-2xl">
            <label for="home-search" class="mb-2 block text-sm font-semibold text-slate-900">How can we help?</label>
            <div class="flex rounded ring-1 ring-slate-500">
              <input id="home-search" type="search" name="q" placeholder="Search Dzaleka..."
                class="min-w-0 flex-1 rounded-l border-0 bg-white px-4 py-3 text-sm text-slate-900 placeholder-slate-500 focus:relative focus:z-10 focus:ring-2 focus:ring-primary-700" />
              <button type="submit" class="flex min-h-[48px] shrink-0 items-center justify-center gap-2 rounded-r bg-primary-900 px-4 py-3 text-sm font-medium text-white hover:bg-primary-800 sm:px-6">
                <svg class="hidden h-5 w-5 sm:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-width="2" d="m21 21-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0" /></svg>
                Search
              </button>
            </div>
          </form>
          <nav aria-label="Popular pages" class="mx-auto mt-3 grid max-w-2xl grid-cols-2 items-center gap-x-5 text-sm sm:flex sm:flex-wrap sm:justify-center">
            <span class="hidden text-slate-600 sm:inline">Popular:</span>
            {[
              { href: '/get-help-now', label: 'Get help now' },
              { href: '/new-to-dzaleka', label: 'New to Dzaleka?' },
              { href: '/jobs', label: 'Jobs' },
              { href: '/events', label: 'Events' },
            ].map(({ href, label }) => (
              <a href={href} class="inline-flex min-h-[40px] items-center text-primary-800 underline underline-offset-4 hover:text-primary-900 hover:decoration-2">{label}</a>
            ))}
          </nav>
        </div>
      </div>
    </section>

    <section class="bg-white py-10 sm:py-12" aria-labelledby="services-heading">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 id="services-heading" class="mb-6 text-2xl font-semibold text-slate-900">Information and services</h2>
        <ul class="grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-12 lg:gap-y-5">
          {serviceTopics.map(({ href, title, description, icon }) => (
            <li>
              <a href={href} class="group flex items-start gap-4 py-3">
                <svg class="mt-0.5 h-7 w-7 shrink-0 text-primary-800" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icon} /></svg>
                <div>
                  <h3 class="text-lg font-semibold leading-6 text-primary-800 underline decoration-primary-800/40 underline-offset-4 group-hover:text-primary-900 group-hover:decoration-2 group-hover:decoration-primary-900">{title}</h3>
                  <p class="mt-2 text-sm leading-6 text-slate-600">{description}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-slate-50 py-10 sm:py-12" aria-label="Community updates">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-3 lg:gap-12">
          <div class="lg:col-span-2">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
              <h2 class="text-2xl font-semibold text-slate-900">Community notices</h2>
              <a href="/news" class="inline-flex min-h-[44px] items-center text-sm font-medium text-primary-800 underline underline-offset-4 hover:text-primary-900">View all notices <span class="ml-2" aria-hidden="true">→</span></a>
            </div>
            <div class="divide-y divide-slate-200 border-t border-slate-200">
              {announcements.length > 0 ? (
                announcements.map(item => (
                  <article class="py-5">
                    <time datetime={new Date(item.data.date).toISOString()} class="text-sm text-slate-600">{format(new Date(item.data.date), 'd MMMM yyyy')}</time>
                    <h3 class="mt-1 text-lg font-semibold leading-7">
                      <a href={`/news/${item.id}`} class="text-primary-800 underline decoration-primary-800/40 underline-offset-4 hover:text-primary-900 hover:decoration-2">{item.data.title}</a>
                    </h3>
                    <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600">{item.data.description}</p>
                  </article>
                ))
              ) : (
                <p class="py-6 text-sm text-slate-600">No active announcements at this time.</p>
              )}
            </div>
          </div>
          <div>
            <h2 class="mb-4 flex min-h-[44px] items-center text-2xl font-semibold text-slate-900">Have your say</h2>
            <p class="text-sm leading-6 text-slate-600">Help us improve Dzaleka services and share your community stories.</p>
            <ul class="mt-5 divide-y divide-slate-200 border-y border-slate-200">
              {[
                { href: '/contact', label: 'Suggest a service' },
                { href: '/submit-voice', label: 'Submit a story' },
                { href: '/contact', label: 'Report an issue' },
              ].map(({ href, label }) => (
                <li><a href={href} class="flex min-h-[52px] items-center justify-between gap-3 py-3 text-sm font-medium text-primary-800 underline underline-offset-4 hover:text-primary-900">{label}<span aria-hidden="true">→</span></a></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <aside class="bg-primary-50 py-8" aria-label="DzalekaPay">
      <div class="mx-auto flex max-w-7xl flex-col gap-5 px-4 sm:px-6 lg:flex-row lg:items-center lg:gap-8 lg:px-8">
        <img src="/images/dzalekapay-logo.svg" alt="DzalekaPay" loading="lazy" class="h-9 w-auto self-start lg:self-center" />
        <div class="flex-1">
          <h2 class="text-xl font-semibold text-primary-900">Everyday payments in Dzaleka</h2>
          <p class="mt-2 text-sm leading-6 text-slate-700">Accept mobile money or card payments from one simple link.</p>
          <p class="mt-1 text-sm leading-6 text-slate-600">Not a bank, wallet, mobile-money operator, or remittance service.</p>
        </div>
        <a href="https://pay.dzaleka.com/" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] shrink-0 items-center justify-center gap-2 self-start rounded px-4 py-2.5 text-sm font-medium text-primary-900 ring-1 ring-primary-900 hover:bg-primary-100 lg:self-center">
          Open DzalekaPay <span class="sr-only">(opens in a new tab)</span>
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M9 7h8v8" /></svg>
        </a>
      </div>
    </aside>

    <HomeSection id="culture-heading" title="Culture and heritage" description="Art, music, poetry and performance from across the camp." href="/culture" linkLabel="Explore culture">
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
        <figure>
          <a href="/stories/tumaini-at-dzaleka" class="block" aria-label="Read the story of Tumaini Festival at Dzaleka in 2017">
            <img src="/images/tumaini-festival-2017-matt-smith/18.JPG" alt="Crowds gather on the festival grounds as the sun sets over Dzaleka." width="1600" height="1200" loading="lazy" class="aspect-[16/9] w-full object-cover" />
          </a>
          <figcaption class="mt-3 text-sm leading-6 text-slate-600">
            Tumaini Festival, 2017. Photograph: Matt Smith.
          </figcaption>
        </figure>
        <ul class="divide-y divide-slate-200 border-y border-slate-200">
          {[
            { href: '/photos', title: 'Photo gallery', description: 'Community life through photography.' },
            { href: '/site-register', title: 'Site register', description: 'Landmarks, gathering places and cultural spaces.' },
            { href: '/public-art-catalogue', title: 'Public art and visual culture', description: 'Murals, artworks and visual media from the camp.' },
            { href: '/dancers', title: 'Dancers from Dzaleka', description: 'Dance groups and performers from Dzaleka.' },
            { href: '/poets', title: 'Poets from Dzaleka', description: 'Poetry and spoken word from the camp.' },
          ].map(({ href, title, description }) => (
            <li><a href={href} class="group flex items-start justify-between gap-4 py-3">
              <div>
                <h3 class="text-lg font-semibold leading-6 text-primary-800 underline decoration-primary-800/40 underline-offset-4 group-hover:text-primary-900 group-hover:decoration-2">{title}</h3>
                <p class="mt-1 text-sm leading-6 text-slate-600">{description}</p>
              </div>
              <span class="mt-1 shrink-0 text-primary-800" aria-hidden="true">→</span>
            </a></li>
          ))}
        </ul>
      </div>
    </HomeSection>

    {upcomingEvents.length > 0 && (
      <HomeSection id="events-heading" title="Upcoming events" description="Make time for music, culture and community." href="/events" linkLabel="View all events" tone="subtle">
        <div class:list={['grid gap-6', upcomingEvents.length > 1 && 'md:grid-cols-2', upcomingEvents.length > 2 && 'lg:grid-cols-3']}>
          {upcomingEvents.map(event => {
            const isTBA = event.data.isTBA || event.data.title.toLowerCase().includes('tba');
            const eventDate = isTBA ? null : new Date(event.data.date);
            const dateOptions = { timeZone: 'Africa/Blantyre' };
            const singleEvent = upcomingEvents.length === 1;
            return (
              <article class:list={['group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm', singleEvent && 'md:grid md:grid-cols-[1.15fr_1fr]']}>
                <a href={`/events/${event.id}`} tabindex="-1" aria-hidden="true" class:list={['relative block overflow-hidden bg-slate-100', singleEvent ? 'aspect-[4/3] md:aspect-auto md:min-h-[22rem]' : 'aspect-video']}>
                  {event.data.image ? <img src={event.data.image} alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" onerror="this.hidden = true" /> : <svg viewBox="0 0 240 160" fill="none" class="h-full w-full text-primary-800" aria-hidden="true"><rect x="65" y="36" width="110" height="100" rx="8" stroke="currentColor" stroke-width="3"/><path d="M65 65h110M90 24v26m60-26v26M87 87h17m14 0h17m14 0h6M87 109h17m14 0h17" stroke="currentColor" stroke-width="3"/></svg>}
                  <div class="absolute left-5 top-5 flex min-h-20 min-w-20 flex-col items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-primary-900 shadow-sm">
                    {eventDate ? <><span class="text-sm font-semibold uppercase">{eventDate.toLocaleDateString('en-GB', { ...dateOptions, month: 'short' })}</span><span class="text-3xl font-semibold leading-tight">{eventDate.toLocaleDateString('en-GB', { ...dateOptions, day: '2-digit' })}</span></> : <span class="max-w-20 text-center text-sm font-semibold">Date to come</span>}
                  </div>
                </a>
                <div class:list={['flex min-w-0 flex-col p-6', singleEvent && 'sm:p-8 lg:p-10']}>
                  <p class="text-sm font-medium text-slate-600">{event.data.category || 'Community event'}</p>
                  <h3 class:list={['mt-3 font-semibold leading-snug text-primary-900', singleEvent ? 'text-2xl lg:text-3xl' : 'text-xl']}><a href={`/events/${event.id}`} class="underline decoration-primary-900/30 underline-offset-4 hover:decoration-2">{event.data.title}</a></h3>
                  <p class="mt-4 line-clamp-3 text-base leading-7 text-slate-700">{event.data.description}</p>
                  <div class="mt-6 space-y-3 border-t border-slate-200 pt-5 text-sm leading-6 text-slate-700">
                    <p class="flex items-start gap-3"><svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 11h18"/></svg>{eventDate ? <time datetime={eventDate.toISOString()}>{eventDate.toLocaleDateString('en-GB', { ...dateOptions, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })}</time> : <span>Date to be announced</span>}</p>
                    {event.data.location && <p class="flex items-start gap-3"><svg class="mt-0.5 h-5 w-5 shrink-0 text-primary-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><span>{event.data.location}</span></p>}
                  </div>
                  <a href={`/events/${event.id}`} class="mt-6 inline-flex min-h-[44px] items-center justify-center gap-3 self-start rounded bg-primary-900 px-5 py-3 text-sm font-semibold text-white hover:bg-primary-800">Event details<span aria-hidden="true">→</span><span class="sr-only"> for {event.data.title}</span></a>
                </div>
              </article>
            );
          })}
        </div>
      </HomeSection>
    )}

    <HomeSection id="resources-heading" title="Latest resources" description="Guides, reports and reference documents." href="/resources" linkLabel="Browse all resources">
      <div class="grid gap-x-12 sm:grid-cols-2">
        {latestResources.map(resource => {
          const resourceDate = new Date(resource.data.lastUpdated || resource.data.date);
          const details = [resource.data.fileSize, resource.data.languages?.join(', ')].filter(Boolean);
          return (
            <article class="border-t border-slate-200 py-5">
              <div class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-slate-600">
                <span>{resource.data.category}</span>
                <time datetime={resourceDate.toISOString()}>{format(resourceDate, 'd MMMM yyyy')}</time>
              </div>
              <h3 class="mt-2 text-lg font-semibold leading-7">
                <a href={`/resources/${resource.id}`} class="text-primary-800 underline decoration-primary-800/40 underline-offset-4 hover:text-primary-900 hover:decoration-2">{resource.data.title}</a>
              </h3>
              <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600">{resource.data.description}</p>
              {details.length > 0 && <p class="mt-2 text-sm leading-6 text-slate-600">{details.join(' · ')}</p>}
            </article>
          );
        })}
      </div>
    </HomeSection>

    <HomeSection id="support-heading" title="Help and support" description="Medical, legal and protection services in Dzaleka." href="/get-help-now" linkLabel="Get help now" tone="subtle">
      <div class="grid gap-8 md:grid-cols-3 lg:gap-12">
        <div class="border-t border-slate-300 pt-5">
          <h3 class="text-lg font-semibold leading-7 text-slate-900">Medical care</h3>
          <p class="mt-2 text-sm font-medium text-slate-900">Dzaleka Health Centre</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">Located within Dzaleka Refugee Camp, providing essential medical services and emergency care.</p>
          <dl class="mt-3 space-y-1 text-sm leading-6 text-slate-600">
            <div class="flex flex-wrap justify-between gap-x-3"><dt>Monday–Friday</dt><dd>7:30 am–4:30 pm</dd></div>
            <div class="flex flex-wrap justify-between gap-x-3"><dt>Saturday</dt><dd>7:30 am–12 pm</dd></div>
            <div class="flex flex-wrap justify-between gap-x-3"><dt>Sunday</dt><dd>Closed</dd></div>
          </dl>
        </div>
        <div class="border-t border-slate-300 pt-5">
          <h3 class="text-lg font-semibold leading-7 text-slate-900">Legal aid and advocacy</h3>
          <p class="mt-2 text-sm font-medium text-slate-900">Inua Advocacy</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">Professional legal assistance and advocacy services for refugees.</p>
          <ul class="mt-3 text-sm">
            <li><a href="tel:+265886447277" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4 hover:text-primary-900">+265 886 44 72 77</a></li>
            <li><a href="mailto:info@inuaadvocacy.org" class="inline-flex min-h-[44px] items-center break-all text-primary-800 underline underline-offset-4 hover:text-primary-900">info@inuaadvocacy.org</a></li>
          </ul>
        </div>
        <div class="border-t border-slate-300 pt-5">
          <h3 class="text-lg font-semibold leading-7 text-slate-900">Protection services</h3>
          <p class="mt-2 text-sm font-medium text-slate-900">UNHCR and police</p>
          <p class="mt-2 text-sm leading-6 text-slate-600">Security and protection services for camp residents.</p>
          <p class="mt-3 text-sm"><a href="tel:+2651772155" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4 hover:text-primary-900">UNHCR: +265 1 772 155</a></p>
          <p class="mt-1 text-sm leading-6 text-slate-600">Dzaleka Dowa Police</p>
        </div>
      </div>
      <div class="mt-6 flex flex-col gap-3 border-t border-slate-200 pt-5 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
        <p class="text-sm leading-6 text-slate-600">For urgent emergencies, contact the appropriate service directly or visit the nearest facility.</p>
        <a href="/contact" class="inline-flex min-h-[44px] shrink-0 items-center gap-2 self-start text-sm font-medium text-primary-800 underline underline-offset-4 hover:text-primary-900">Contact support <span aria-hidden="true">→</span></a>
      </div>
    </HomeSection>

    <HomeSection id="community-heading" title="From the community" description="People and organisations working in Dzaleka." href="/community-voice" linkLabel="Browse community stories">
      <div class="grid gap-8 md:grid-cols-3">
        {[
          { name: 'Innocent Magambi', role: 'Founder, There is Hope', image: '/images/profiles/innocent-magambi.png', href: '/encyclopedia/innocent-magambi', description: 'Innocent founded There is Hope, which runs education, livelihoods, and community support programmes in Dzaleka and Dowa.' },
          { name: 'Menes la Plume', role: 'Founder, Tumaini Festival', image: '/images/profiles/menes-la-plume.jpg', href: '/encyclopedia/menes-la-plume', description: 'Menes founded Tumaini Festival, bringing artists from Dzaleka, Malawi, and other countries onto the same programme.' },
          { name: 'Remy Gakwaya', role: 'Founder, TakenoLAB & RELON', image: 'https://www.unhcr.org/africa/sites/afr/files/legacy-images/58c7ec274_3.jpg', href: '/skills-exchange/profile/remy-gakwaya', description: 'Remy founded TakenoLAB to teach computing and digital skills, and has supported refugee-led networks in Malawi.' },
        ].map(({ name, role, image, href, description }) => (
          <article>
            <a href={href} class="group block">
              <img src={image} alt="" loading="lazy" class="aspect-[4/3] w-full object-cover" />
              <h3 class="mt-4 text-lg font-semibold leading-7 text-primary-800 underline decoration-primary-800/40 underline-offset-4 group-hover:text-primary-900 group-hover:decoration-2">{name}</h3>
            </a>
            <p class="mt-1 text-sm font-medium leading-6 text-slate-700">{role}</p>
            <p class="mt-2 text-sm leading-6 text-slate-600">{description}</p>
          </article>
        ))}
      </div>
      <details class="mt-8 border-y border-slate-200">
        <summary class="cursor-pointer py-4 text-sm font-medium text-primary-800 underline underline-offset-4 hover:text-primary-900">More community organisations</summary>
        <div class="grid gap-6 pb-6 sm:grid-cols-2 lg:grid-cols-4">
          {[
            { name: 'Mirash Films', description: 'A Dzaleka-based film team producing and screening work by refugee filmmakers.' },
            { name: 'Salama Africa', description: 'A dance group performing work shaped by styles from Dzaleka and across the region.' },
            { name: 'Amahoro Drummers', description: 'A drumming ensemble presenting traditional music at community and national events.' },
            { name: 'Fountain of Hope', description: 'Community programmes connecting education, practical skills, and livelihoods.' },
          ].map(({ name, description }) => (
            <div>
              <h3 class="text-lg font-semibold text-slate-900">{name}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">{description}</p>
            </div>
          ))}
        </div>
      </details>
    </HomeSection>

    <PageFeedback />
  </div>
</MainLayout>
