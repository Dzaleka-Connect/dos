---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import { format } from 'date-fns';
import Button from '../components/ui/Button.astro';
import PageFeedback from '../components/ui/PageFeedback.astro';

export const prerender = false;

// Get all services and filter featured ones
const services = await getCollection('services');
const featuredServices = services
  .filter(service => service.data.featured)
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .slice(0, 6);

// Get upcoming events
const events = await getCollection('events');
const upcomingEvents = events
  .filter(event => {
    // Check if event is TBA either in data or title
    const isTBA = event.data.isTBA || event.data.title.toLowerCase().includes('tba');
    if (isTBA) return true;

    const eventDate = new Date(event.data.date);
    const now = new Date();
    
    // Reset time to start of day for accurate date comparison
    eventDate.setHours(0, 0, 0, 0);
    now.setHours(0, 0, 0, 0);
    
    return eventDate >= now;
  })
  .sort((a, b) => {
    // Put TBA events at the end
    const aIsTBA = a.data.isTBA || a.data.title.toLowerCase().includes('tba');
    const bIsTBA = b.data.isTBA || b.data.title.toLowerCase().includes('tba');
    if (aIsTBA) return 1;
    if (bIsTBA) return -1;
    return new Date(a.data.date).getTime() - new Date(b.data.date).getTime();
  })
  .slice(0, 3);

// Fetch latest resources
const allResources = await getCollection('resources');
const latestResources = allResources
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 6); // Get latest 6 resources

// Fetch announcements for Notice Board
const news = await getCollection('news');
const announcements = news
  .filter(item => item.data.category === 'announcement')
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

// SEO metadata
const canonical = 'https://services.dzaleka.com/';
const seo = {
  title: 'Dzaleka Online Services | Help, services, jobs and community records',
  description: 'Find urgent help, local services, jobs, events, public resources, community data, and cultural records for Dzaleka Refugee Camp in Malawi.',
  canonical,
  openGraph: {
    title: 'Dzaleka Online Services | Help, services, jobs and community records',
    description: 'Find urgent help, local services, jobs, events, public resources, community data, and cultural records for Dzaleka Refugee Camp in Malawi.',
    type: 'website',
    site_name: 'Dzaleka Online Services',
    locale: 'en_US',
    url: canonical,
    image: {
      url: 'https://services.dzaleka.com/images/dzaleka-hero.jpeg',
      alt: 'View of community life in Dzaleka Refugee Camp'
    }
  },
  twitter: {
    card: 'summary_large_image',
    title: 'Dzaleka Online Services | Help, services, jobs and community records',
    description: 'Find urgent help, local services, jobs, events, public resources, community data, and cultural records for Dzaleka Refugee Camp in Malawi.',
    image: 'https://services.dzaleka.com/images/dzaleka-hero.jpeg'
  }
};

const homepageSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${canonical}#website`,
    name: 'Dzaleka Online Services',
    url: canonical,
    description: seo.description,
    inLanguage: 'en',
    publisher: {
      '@id': `${canonical}#organization`
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${canonical}#organization`,
    name: 'Dzaleka Online Services',
    url: canonical,
    description: seo.description,
    email: 'mailto:dzalekaconnect@gmail.com',
    logo: {
      '@type': 'ImageObject',
      url: 'https://services.dzaleka.com/images/dzaleka-digital-heritage.png'
    },
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Dzaleka Refugee Camp',
      addressRegion: 'Dowa District',
      addressCountry: 'MW'
    },
    sameAs: [
      'https://facebook.com/dzalekaonline',
      'https://twitter.com/dzalekaconnect',
      'https://instagram.com/dzalekaonline'
    ]
  }
];

---

<MainLayout
  title={seo.title}
  description={seo.description}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
  schema={homepageSchema}
>
  <main>
    <!-- Hero Section -->
    <div class="relative min-h-[640px] flex items-center justify-center text-white overflow-hidden">
      {/* Background Images Slider */}
      <div class="absolute inset-0">
        <div class="relative w-full h-full">
        <img 
          src="/images/dzaleka-hero.jpeg" 
          alt="Dzaleka Community" 
            class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-100"
            id="slide-1"
          />
          <img 
            src="/images/Visit_Dzaleka.png" 
            alt="Dzaleka Community Life" 
            class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-0"
            id="slide-2"
          />
          <img 
            src="/images/20241023_205851_3.jpg" 
            alt="Dzaleka Community Activities" 
            class="absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 opacity-0"
            id="slide-3"
          />
        </div>
        <div class="absolute inset-0 bg-slate-950/65"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/25 to-transparent"></div>
      </div>

      {/* Content */}
      <div class="relative container mx-auto px-4 py-20 text-center">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 max-w-4xl mx-auto leading-tight text-white">
          Dzaleka Online Services
        </h1>
        <p class="text-xl md:text-2xl text-white mb-12 max-w-2xl mx-auto">
          Find information, access services and have your say
        </p>

        {/* Search Bar */}
        <div class="max-w-2xl mx-auto mb-8">
          <form action="/search/results/" method="GET" class="relative">
            <input
              type="text"
              name="q"
              placeholder="Search organizations and resources..."
              class="w-full rounded-lg border border-white bg-white px-5 py-4 pr-14 text-lg text-slate-900 placeholder-slate-500 shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-500"
            />
            <button
              type="submit"
              class="absolute right-2 top-1/2 flex -translate-y-1/2 items-center justify-center rounded-lg bg-slate-900 p-2.5 text-white transition-colors duration-200 hover:bg-slate-800"
              aria-label="Search"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 md:h-6 md:w-6 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
          </form>
        </div>

        {/* Popular Pages */}
        <div class="flex flex-col items-center gap-3">
          <span class="text-white/80 text-sm font-medium uppercase tracking-wider">Popular pages</span>
          <div class="flex flex-wrap justify-center gap-3">
            <a href="/get-help-now" class="rounded-lg border border-red-500 bg-red-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-red-700">
              Get help now
            </a>
            <a href="/new-to-dzaleka" class="rounded-lg border border-white/40 bg-slate-950/70 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-slate-900">
              New to Dzaleka? Start here
            </a>
            <a href="https://pay.dzaleka.com/" target="_blank" rel="noopener noreferrer" class="rounded-lg border border-primary-400 bg-primary-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-700">
              DzalekaPay
            </a>
            <a href="/easy-read" class="rounded-lg border border-white/40 bg-slate-950/70 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-slate-900">
              Easy Read
            </a>
            <a href="/languages" class="rounded-lg border border-white/40 bg-slate-950/70 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-slate-900">
              Languages
            </a>
            <a href="/jobs" class="rounded-lg border border-white/40 bg-slate-950/70 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-slate-900">
              Job Board
            </a>
            <a href="/events" class="rounded-lg border border-white/40 bg-slate-950/70 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-slate-900">
              Community Events
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- What are you looking for? Section -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-8 text-center">What are you looking for?</h2>
        
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
          <a href="/services" class="flex flex-col items-center p-6 bg-slate-50 border border-slate-200 rounded-xl hover:bg-white hover:border-slate-300 transition-all duration-200 text-center h-full">
            <div class="w-12 h-12 bg-white border border-slate-200 text-slate-700 rounded-lg flex items-center justify-center mb-3">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            </div>
            <span class="font-semibold text-slate-900">Find Services</span>
          </a>

          <a href="https://visit.dzaleka.com/" class="flex flex-col items-center p-6 bg-slate-50 border border-slate-200 rounded-xl hover:bg-white hover:border-slate-300 transition-all duration-200 text-center h-full">
            <div class="w-12 h-12 bg-white border border-slate-200 text-slate-700 rounded-lg flex items-center justify-center mb-3">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <span class="font-semibold text-slate-900">Visit Dzaleka</span>
          </a>

          <a href="/skills-exchange" class="flex flex-col items-center p-6 bg-slate-50 border border-slate-200 rounded-xl hover:bg-white hover:border-slate-300 transition-all duration-200 text-center h-full">
            <div class="w-12 h-12 bg-white border border-slate-200 text-slate-700 rounded-lg flex items-center justify-center mb-3">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            </div>
            <span class="font-semibold text-slate-900">Education & Skills</span>
          </a>

          <a href="/jobs" class="flex flex-col items-center p-6 bg-slate-50 border border-slate-200 rounded-xl hover:bg-white hover:border-slate-300 transition-all duration-200 text-center h-full">
            <div class="w-12 h-12 bg-white border border-slate-200 text-slate-700 rounded-lg flex items-center justify-center mb-3">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <span class="font-semibold text-slate-900">Jobs & Opportunity</span>
          </a>

          <a href="/events" class="flex flex-col items-center p-6 bg-slate-50 border border-slate-200 rounded-xl hover:bg-white hover:border-slate-300 transition-all duration-200 text-center h-full">
            <div class="w-12 h-12 bg-white border border-slate-200 text-slate-700 rounded-lg flex items-center justify-center mb-3">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            </div>
            <span class="font-semibold text-slate-900">Events & Culture</span>
          </a>

          <a href="/resources" class="flex flex-col items-center p-6 bg-slate-50 border border-slate-200 rounded-xl hover:bg-white hover:border-slate-300 transition-all duration-200 text-center h-full">
            <div class="w-12 h-12 bg-white border border-slate-200 text-slate-700 rounded-lg flex items-center justify-center mb-3">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </div>
            <span class="font-semibold text-slate-900">Resources</span>
          </a>
        </div>

        <!-- DzalekaPay Highlight -->
        <div class="mt-8">
          <div class="relative overflow-hidden rounded-xl bg-gray-900 p-6 md:p-8 text-left">
            <div class="absolute inset-0 opacity-25">
              <img src="/images/Dzaleka_Marketplace.jpeg" alt="" class="h-full w-full object-cover" />
            </div>
            <div class="absolute inset-0 bg-slate-950/55"></div>

            <div class="relative flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
              <div class="max-w-2xl">
                <div class="mb-4 inline-flex rounded-lg bg-white px-4 py-2 shadow-sm">
                  <img src="https://pay.dzaleka.com/logo.svg" alt="DzalekaPay" class="h-8 w-auto" />
                </div>
                <h3 class="text-2xl md:text-3xl font-bold text-white mb-2">
                  Everyday payments in Dzaleka
                </h3>
                <p class="text-base text-gray-200">
                  Accept mobile money or card payments from one simple link.
                </p>
                <p class="mt-2 text-xs text-gray-400">
                  Not a bank, wallet, mobile-money operator, or remittance service.
                </p>
              </div>

              <div class="shrink-0">
                <a href="https://pay.dzaleka.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center rounded-lg bg-white px-5 py-3 text-sm font-semibold text-gray-900 transition-colors hover:bg-gray-100">
                  Open DzalekaPay
                  <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M9 7h8v8" /></svg>
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Community Updates Section (Notice Board & Have Your Say) -->
    <section class="py-12 bg-white border-b border-gray-100">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-3 gap-8">
          
          {/* Notice Board (2/3 width) */}
          <div class="lg:col-span-2">
            <div class="flex items-center justify-between mb-6">
              <h2 class="text-2xl font-bold text-gray-900 flex items-center">
                <span class="w-2 h-8 bg-slate-300 rounded-full mr-3"></span>
                Notice Board
              </h2>
              <a href="/news" class="text-slate-700 text-sm font-medium hover:underline">View all notices &rarr;</a>
            </div>
            
            <div class="bg-slate-50 rounded-xl border border-gray-200 divide-y divide-gray-200 overflow-hidden">
              {announcements.length > 0 ? (
                announcements.map(item => (
                  <div class="p-4 md:p-6 hover:bg-white transition-colors">
                    <div class="flex items-start gap-4">
                      <div class="flex-shrink-0 mt-1">
                        <div class="w-10 h-10 bg-white border border-slate-200 text-slate-700 rounded-lg flex items-center justify-center">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
                          </svg>
                        </div>
                      </div>
                      <div class="flex-1">
                        <div class="flex items-center gap-2 mb-1">
                          <span class="text-xs font-semibold text-slate-600 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded uppercase tracking-wide">Announcement</span>
                          <span class="text-xs text-slate-500">{new Date(item.data.date).toLocaleDateString()}</span>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 mb-1">
                          <a href={`/news/${item.id}`} class="hover:underline transition-colors">
                            {item.data.title}
                          </a>
                        </h3>
                        <p class="text-gray-600 text-sm line-clamp-2">{item.data.description}</p>
                      </div>
                    </div>
                  </div>
                ))
              ) : (
                <div class="p-8 text-center text-gray-500">
                  No active announcements at this time.
                </div>
              )}
            </div>
          </div>

          {/* Have Your Say (1/3 width) */}
          <div>
            <div class="flex items-center justify-between mb-6">
              <h2 class="text-2xl font-bold text-gray-900 flex items-center">
                <span class="w-2 h-8 bg-slate-400 rounded-full mr-3"></span>
                Have Your Say
              </h2>
            </div>

            <div class="bg-slate-50 rounded-xl border border-slate-200 p-6">
              <p class="text-slate-700 mb-6">
                Your voice matters. Help us improve Dzaleka services and share your community stories.
              </p>
              
              <div class="space-y-3">
                <a href="/contact" class="flex items-center p-3 bg-white rounded-lg border border-slate-200 hover:border-slate-300 transition-all">
                  <div class="w-8 h-8 bg-white border border-slate-200 text-slate-700 rounded mr-3 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                  </div>
                  <span class="font-medium text-slate-700">Suggest a Service</span>
                </a>

                <a href="/submit-voice" class="flex items-center p-3 bg-white rounded-lg border border-slate-200 hover:border-slate-300 transition-all">
                  <div class="w-8 h-8 bg-white border border-slate-200 text-slate-700 rounded mr-3 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                  </div>
                  <span class="font-medium text-slate-700">Submit a Story</span>
                </a>

                <a href="/contact" class="flex items-center p-3 bg-white rounded-lg border border-slate-200 hover:border-slate-300 transition-all">
                  <div class="w-8 h-8 bg-white border border-slate-200 text-slate-700 rounded mr-3 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path></svg>
                  </div>
                  <span class="font-medium text-slate-700">Report an Issue</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Discover Dzaleka's Culture Carousel -->
    <div class="bg-white py-16">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">
            Culture & Heritage
          </h2>
          <p class="text-base text-gray-600 max-w-2xl mx-auto">
            Art, music, poetry, and performance from across the camp
          </p>
        </div>

      <div class="relative">
        {/* Navigation Arrows */}
        <button id="prevBtn" aria-label="Previous slide" class="absolute left-0 top-1/2 transform -translate-y-1/2 z-10 bg-white rounded-lg p-2 shadow-sm transition-colors duration-200 border border-gray-200 hover:border-gray-300 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <button id="nextBtn" aria-label="Next slide" class="absolute right-0 top-1/2 transform -translate-y-1/2 z-10 bg-white rounded-lg p-2 shadow-sm transition-colors duration-200 border border-gray-200 hover:border-gray-300 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        {/* Carousel Container */}
        <div class="overflow-hidden">
          <div id="carousel" class="flex transition-transform duration-300 ease-in-out gap-6">
            
            {/* Photos */}
