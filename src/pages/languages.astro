---
import MainLayout from '../layouts/MainLayout.astro';

const pageTitle = 'Language support | Dzaleka Online Services';
const description =
  'A practical language support page showing where to start if you need information in simpler English or another language.';
const canonical = 'https://services.dzaleka.com/languages';
const checkedDate = '18 April 2026';

const demographics = [
  { label: 'DR Congo (65%)', note: 'Swahili, Lingala, French, Tshiluba, Kibembe' },
  { label: 'Burundi (22%)', note: 'Kirundi, Swahili, French' },
  { label: 'Rwanda (13%)', note: 'Kinyarwanda, Swahili, French' },
  { label: 'Others (1%)', note: 'Somalia, Ethiopia, Eritrea, and others' }
];

const phrases = [
  {
    language: 'Chichewa (Malawi)',
    items: [
      { original: 'Moni', translation: 'Hello' },
      { original: 'Muli bwanji?', translation: 'How are you?' },
      { original: 'Ndili bwino', translation: 'I am fine' },
      { original: 'Zikomo', translation: 'Thank you / Excuse me / Please' },
      { original: 'Pepani', translation: 'I am sorry' },
      { original: 'Ndalama zingati?', translation: 'How much?' },
      { original: 'Mundithandize!', translation: 'Help me!' },
      { original: 'Takulandirani', translation: 'Welcome' },
    ]
  },
  {
    language: 'Swahili (Camp Lingua Franca)',
    items: [
      { original: 'Habari', translation: 'Hello / News' },
      { original: 'Hujambo?', translation: 'How are you?' },
      { original: 'Sijambo', translation: 'I am fine' },
      { original: 'Asante', translation: 'Thank you' },
      { original: 'Samahani', translation: 'I am sorry / Excuse me' },
      { original: 'Bei gani?', translation: 'How much?' },
      { original: 'Nisaidie!', translation: 'Help me!' },
      { original: 'Karibu', translation: 'Welcome' },
    ]
  }
];

const supportRoutes = [
  {
    title: 'Most pages are still in English',
    text:
      'Start with Easy Read if you want shorter sentences. If you have just arrived, use New to Dzaleka next.',
    links: [
      { label: 'Open Easy Read', href: '/easy-read' },
      { label: 'Open New to Dzaleka', href: '/new-to-dzaleka' },
    ],
  },
  {
    title: 'If you need urgent help in a crisis',
    text:
      'Use the urgent help page first and tell the person helping you what language you need.',
    links: [{ label: 'Open Get help now', href: '/get-help-now' }],
  },
  {
    title: 'If you want spoken news and community information',
    text:
      'Yetu Radio is the main multilingual option linked on this site. It broadcasts in Chichewa, English, French, Swahili, and Kinyarwanda.',
    links: [{ label: 'Open Yetu Radio', href: '/yetu-radio' }],
  },
  {
    title: 'If you need a reply from the site team',
    text:
      'For non-urgent questions, the Help Desk can reply in English, French, and Swahili.',
    links: [{ label: 'Open Help Desk', href: '/help-desk' }],
  },
];

const sourceLinks = [
  {
    label: 'UNHCR story about Yetu community radio',
    href: 'https://www.unhcr.org/news/stories/community-radio-fosters-refugee-inclusion-malawi',
    note:
      'Published 13 February 2024. It lists Chichewa, English, French, Swahili, and Kinyarwanda as Yetu broadcast languages.',
  },
  {
    label: 'Yetu FM about page',
    href: 'https://yetufm.mw/about-us/',
    note:
      'Checked 18 April 2026. Yetu FM describes itself as a five-language community radio service in Dzaleka.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description,
  url: canonical,
};
---

<MainLayout title={pageTitle} description={description} canonical={canonical} schema={schema}>
  <main class="bg-slate-50">
    <section class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">Language support</p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
            Start here if you need another language
          </h1>
          <p class="mt-4 text-lg leading-8 text-slate-600">
            Dzaleka is home to over 60,000 residents from the Great Lakes region. 
            While most official info is in English, this page helps you find easier English, 
            radio updates, or a reply in another language.
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="space-y-8">
        <!-- New Multilingual Context Section in Original Style -->
        <section class="rounded-2xl border border-slate-200 bg-white px-6 py-6 sm:px-8">
          <h2 class="text-2xl font-semibold text-slate-900">The Multilingual Heart of Dzaleka</h2>
          <p class="mt-4 text-base leading-7 text-slate-600">
            Swahili is the <i>lingua franca</i> of the camp, connecting people from different backgrounds. 
            Within communities, you will also hear Lingala, Kinyarwanda, Kirundi, and French.
          </p>
          <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
            {demographics.map((item) => (
              <div class="p-3 bg-slate-50 rounded-lg border border-slate-200">
                <div class="font-semibold text-slate-900">{item.label}</div>
                <div class="text-sm text-slate-500">{item.note}</div>
              </div>
            ))}
          </div>
        </section>

        <section class="rounded-2xl border border-slate-200 bg-white px-6 py-6 sm:px-8">
          <h2 class="text-2xl font-semibold text-slate-900">Where to start</h2>
          <div class="mt-6 grid gap-4">
            {supportRoutes.map((route) => (
              <article class="border-t border-slate-300 pt-4 first:border-t-0 first:pt-0">
                <h3 class="text-lg font-semibold text-slate-900">{route.title}</h3>
                <p class="mt-2 text-base leading-7 text-slate-600">{route.text}</p>
                <div class="mt-4 flex flex-wrap gap-3">
                  {route.links.map((link) => (
                    <a
                      href={link.href}
                      class="inline-flex items-center rounded-lg border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-700 hover:bg-white"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- New Practical Phrases Section in Original Style -->
        <section class="rounded-2xl border border-slate-200 bg-white px-6 py-6 sm:px-8">
          <h2 class="text-2xl font-semibold text-slate-900">Practical Phrases</h2>
          <p class="mt-4 text-base leading-7 text-slate-600">
            Essential words to help you navigate daily life in and around the camp.
          </p>
          <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-8">
            {phrases.map((type) => (
              <div>
                <h3 class="font-bold text-slate-900 mb-4">{type.language}</h3>
                <div class="grid grid-cols-1 gap-2">
                  {type.items.map((item) => (
                    <div class="flex justify-between text-sm py-1 border-b border-slate-100 last:border-0">
                      <span class="text-slate-500">{item.translation}:</span>
                      <span class="font-medium text-slate-900">{item.original}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <section class="rounded-2xl border border-slate-200 bg-white px-6 py-6 sm:px-8">
          <h2 class="text-2xl font-semibold text-slate-900">Important note</h2>
          <p class="mt-4 text-base leading-7 text-slate-600">
            Not every service on this website can reply in more than one language. If you need
            language help, say that early so the person helping you can route you properly.
          </p>
        </section>
      </div>
    </section>

    <section class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-900">Where this information came from</h2>
          <p class="mt-4 text-base leading-7 text-slate-600">
            Checked on {checkedDate}. The information on this page is sourced from community demographics, 
            local radio broadcast data, and UNHCR reporting.
          </p>
        </div>

        <ul class="mt-8 space-y-4">
          {sourceLinks.map((source) => (
            <li class="border-t border-slate-300 pt-4">
              <a
                href={source.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-base font-semibold text-primary-700 hover:text-primary-800 hover:underline"
              >
                {source.label}
              </a>
              <p class="mt-2 max-w-4xl text-sm leading-6 text-slate-600">{source.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</MainLayout>
