---
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import '../styles/maps.css';
import MainLayout from '../layouts/MainLayout.astro';
import { KeepingPlaceExplorer } from '../components/keeping-place/KeepingPlaceExplorer';

const pageTitle = "Explore Dzaleka | Places and heritage records";
const description = "Explore Dzaleka’s places, cultural heritage and community records through a map and searchable directory.";
const keywords = "Dzaleka Keeping Place, GIS cultural heritage map, Dzaleka spatial mapping, customary land rights, Dowa refugee camp GIS, OpenStreetMap Dzaleka, refugee data sovereignty";
const canonicalUrl = "https://services.dzaleka.com/explore";
const ogImageUrl = "https://services.dzaleka.com/images/Dzaleka%20Health%20Centre.jpg";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://services.dzaleka.com/explore#webpage",
      "url": canonicalUrl,
      "name": pageTitle,
      "description": description,
      "inLanguage": "en-US",
      "isPartOf": {
        "@type": "WebSite",
        "@id": "https://services.dzaleka.com/#website",
        "name": "Dzaleka Online Services",
        "url": "https://services.dzaleka.com"
      },
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://services.dzaleka.com"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Keeping Place GIS Explorer",
            "item": canonicalUrl
          }
        ]
      }
    },
    {
      "@type": "Map",
      "@id": "https://services.dzaleka.com/explore#map",
      "name": "Dzaleka Keeping Place Spatial Map",
      "description": "A map of recorded community landmarks, health facilities, education centres and cultural heritage sites in Dzaleka.",
      "url": canonicalUrl
    },
    {
      "@type": "Dataset",
      "@id": "https://services.dzaleka.com/explore#dataset",
      "name": "Dzaleka Spatial & Cultural Heritage Dataset",
      "description": "Open GIS spatial dataset containing geographic coordinates, cultural protocol classifications, and research citations for Dzaleka Refugee Camp.",
      "license": "https://creativecommons.org/licenses/by-sa/4.0/",
      "spatialCoverage": {
        "@type": "Place",
        "name": "Dzaleka Refugee Camp",
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": -13.6592,
          "longitude": 33.8705
        }
      }
    }
  ]
};
---
<MainLayout title={pageTitle} description={description} keywords={keywords} canonical={canonicalUrl} image={ogImageUrl} schema={structuredData}>
  <header class="border-b border-slate-200 bg-slate-50"><div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Explore' }]} />
    <div class="mt-4 flex flex-wrap items-end justify-between gap-4"><div><h1 class="text-primary-900">Explore Dzaleka</h1><p class="mt-3 max-w-2xl text-base leading-7 text-slate-700">Discover places, cultural heritage and community records. Switch between the map, place list and related records.</p></div><a href="/site-register" class="inline-flex min-h-[44px] items-center rounded border border-primary-800 bg-white px-4 py-2 text-sm font-medium text-primary-900">Browse the site register</a></div>
  </div></header>
  <div class="map-workspace mx-auto h-[58rem] max-w-7xl border-b border-slate-200 sm:h-[52rem] lg:h-[46rem]" role="region" aria-label="Explore Dzaleka places and records"><KeepingPlaceExplorer client:load /></div>
  <nav class="mx-auto flex max-w-7xl flex-wrap gap-x-6 gap-y-2 px-4 py-6 sm:px-6 lg:px-8" aria-label="Related Dzaleka collections"><a href="/encyclopedia" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Dzaleka Encyclopedia</a><a href="/photos" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Photo Archive</a><a href="/map" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Find services on the map</a></nav>
</MainLayout>
