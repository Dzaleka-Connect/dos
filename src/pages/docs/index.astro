---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getCollection } from 'astro:content';
import { groupDocs } from '../../data/docsNavigation';

const docs = await getCollection('docs');
const groupedDocs = groupDocs(docs);
const featuredSlugs = ['getting-started', 'faq', 'using-services', 'skills-exchange'];
const featuredDocs = featuredSlugs
  .map((slug) => docs.find((doc) => doc.id === slug))
  .filter(Boolean);
---

<DocsLayout title="Documentation">
  <div class="min-h-screen bg-gray-50">
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="text-sm font-medium text-gray-500">Documentation</p>
          <h1 class="mt-2 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">
            Help guides and reference pages
          </h1>
          <p class="mt-4 text-base leading-7 text-gray-600">
            Use these guides to understand the platform, find the right section faster, and follow the correct submission or support route.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="/search"
              class="min-h-[44px] inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
            >
              Search the site
            </a>
            <a
              href="/support"
              class="min-h-[44px] inline-flex items-center rounded-md border border-primary-600 bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700"
            >
              Get help
            </a>
          </div>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="space-y-10 lg:flex lg:items-start lg:gap-10 lg:space-y-0">
        <div class="min-w-0 flex-1 space-y-10">
          <section class="grid gap-4 sm:grid-cols-2">
            {featuredDocs.map((doc) => (
              <a
                href={`/docs/${doc.id}`}
                class="rounded border border-gray-200 bg-white p-6 transition hover:border-primary-200"
              >
                <p class="text-sm font-medium text-gray-500">Popular guide</p>
                <h2 class="mt-2 text-lg font-semibold text-gray-900">{doc.data.title}</h2>
                {doc.data.description && (
                  <p class="mt-2 text-sm leading-6 text-gray-600">{doc.data.description}</p>
                )}
              </a>
            ))}
          </section>

          <section class="space-y-6">
            {groupedDocs.map((group) => (
              <div class="rounded border border-gray-200 bg-white">
                <div class="border-b border-gray-200 px-6 py-5">
                  <h2 class="text-lg font-semibold text-gray-900">{group.title}</h2>
                  <p class="mt-1 text-sm leading-6 text-gray-600">{group.description}</p>
                </div>
                <div class="divide-y divide-gray-200">
                  {group.items.map((doc) => (
                    <a
                      href={`/docs/${doc.id}`}
                      class="block px-6 py-4 transition hover:bg-gray-50"
                    >
                      <div class="flex items-start justify-between gap-4">
                        <div>
                          <h3 class="text-base font-medium text-gray-900">{doc.data.title}</h3>
                          {doc.data.description && (
                            <p class="mt-1 text-sm leading-6 text-gray-600">{doc.data.description}</p>
                          )}
                        </div>
                        <span class="mt-1 text-sm text-primary-600">Open</span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </section>
        </div>

        <aside class="space-y-6 lg:w-72 lg:flex-none">
          <div class="rounded border border-gray-200 bg-white p-6">
            <h2 class="text-base font-semibold text-gray-900">Start with</h2>
            <ul class="mt-4 space-y-3 text-sm">
              <li><a href="/docs/getting-started" class="text-primary-600 hover:text-primary-700">Getting Started</a></li>
              <li><a href="/docs/faq" class="text-primary-600 hover:text-primary-700">Frequently Asked Questions</a></li>
              <li><a href="/docs/using-services" class="text-primary-600 hover:text-primary-700">Using Services</a></li>
              <li><a href="/docs/support" class="text-primary-600 hover:text-primary-700">Support & Contact</a></li>
            </ul>
          </div>

          <div class="rounded border border-gray-200 bg-white p-6">
            <h2 class="text-base font-semibold text-gray-900">Common actions</h2>
            <ul class="mt-4 space-y-3 text-sm">
              <li><a href="/services/register" class="text-primary-600 hover:text-primary-700">Register a service</a></li>
              <li><a href="/resources/submit" class="text-primary-600 hover:text-primary-700">Submit a resource</a></li>
              <li><a href="/events/organize" class="text-primary-600 hover:text-primary-700">Organize an event</a></li>
              <li><a href="/help-desk" class="text-primary-600 hover:text-primary-700">Open help desk</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </div>
</DocsLayout>
