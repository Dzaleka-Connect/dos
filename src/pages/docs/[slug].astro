---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getCollection, render } from 'astro:content';
import { getDocGroup, getRelatedDocs, groupDocs } from '../../data/docsNavigation';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map(doc => ({
    params: { slug: doc.id },
    props: { doc }
  }));
}

const { doc } = Astro.props;
const docs = await getCollection('docs');
const groupedDocs = groupDocs(docs);
const currentGroup = getDocGroup(doc.id);
const relatedDocs = getRelatedDocs(docs, doc.id);
const { Content } = await render(doc);
---

<DocsLayout title={`${doc.data.title} - Documentation`}>
  <div class="min-h-screen bg-gray-50">
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        <nav class="text-sm text-gray-500" aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href="/docs" class="hover:text-gray-700">Docs</a></li>
            {currentGroup && (
              <>
                <li>/</li>
                <li>{currentGroup.title}</li>
              </>
            )}
          </ol>
        </nav>
        <div class="mt-4 max-w-3xl">
          {currentGroup && (
            <p class="text-sm font-medium text-gray-500">{currentGroup.title}</p>
          )}
          <h1 class="mt-2 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">
            {doc.data.title}
          </h1>
          {doc.data.description && (
            <p class="mt-4 text-base leading-7 text-gray-600">
              {doc.data.description}
            </p>
          )}
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="/docs"
              class="min-h-[44px] inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
            >
              All docs
            </a>
            <a
              href="/search"
              class="min-h-[44px] inline-flex items-center rounded-md border border-primary-600 bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700"
            >
              Search the site
            </a>
          </div>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="space-y-8 lg:flex lg:items-start lg:gap-8 lg:space-y-0">
        <div class="lg:hidden">
          <label for="docs-nav" class="sr-only">Select documentation page</label>
          <select id="docs-nav"
                  class="block w-full rounded border-gray-300 bg-white focus:border-primary-500 focus:ring-primary-500"
                  onchange="window.location.href=this.value">
            {groupedDocs.map((group) => (
              <optgroup label={group.title}>
                {group.items.map((d) => (
                  <option value={`/docs/${d.id}`} selected={d.id === doc.id}>
                    {d.data.title}
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
        </div>

        <aside class="hidden lg:block lg:w-72 lg:flex-none">
          <nav class="sticky top-24 lg:top-44 space-y-4" aria-label="Documentation">
            {groupedDocs.map((group) => (
              <div class="rounded border border-gray-200 bg-white">
                <div class="border-b border-gray-200 px-4 py-3">
                  <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-900">
                    {group.title}
                  </h2>
                </div>
                <ul class="divide-y divide-gray-200">
                  {group.items.map((d) => (
                    <li>
                      <a
                        href={`/docs/${d.id}`}
                        class={`block px-4 py-3 text-sm transition ${
                          d.id === doc.id
                            ? 'bg-primary-50 text-primary-700 font-medium'
                            : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'
                        }`}
                      >
                        {d.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>
        </aside>

        <div class="min-w-0 flex-1 space-y-8">
          <article class="rounded border border-gray-200 bg-white p-5 sm:p-8 lg:p-10">
            <div class="prose max-w-none prose-headings:text-gray-900 prose-p:text-gray-700 prose-li:text-gray-700 prose-a:text-primary-700 prose-a:no-underline hover:prose-a:underline">
              <Content />
            </div>
          </article>

          {relatedDocs.length > 0 && (
            <section class="rounded border border-gray-200 bg-white p-5 sm:p-8">
              <h2 class="text-lg font-semibold text-gray-900">Related guides</h2>
              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                {relatedDocs.map((d) => (
                  <a
                    href={`/docs/${d.id}`}
                    class="rounded border border-gray-200 p-5 transition hover:border-primary-200 hover:bg-gray-50"
                  >
                    <h3 class="text-base font-medium text-gray-900">{d.data.title}</h3>
                    {d.data.description && (
                      <p class="mt-2 text-sm leading-6 text-gray-600">{d.data.description}</p>
                    )}
                  </a>
                ))}
              </div>
            </section>
          )}

          <section class="rounded border border-gray-200 bg-white p-5 sm:p-8">
            <h2 class="text-lg font-semibold text-gray-900">Need help?</h2>
            <p class="mt-2 text-sm leading-6 text-gray-600">
              If the guide does not answer your question, use the support or contact pages for follow-up help.
            </p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a
                href="/support"
                class="min-h-[44px] inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
              >
                Support
              </a>
              <a
                href="/contact"
                class="min-h-[44px] inline-flex items-center rounded-md border border-primary-600 bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700"
              >
                Contact
              </a>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>
</DocsLayout>
