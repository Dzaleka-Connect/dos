---
import MainLayout from '../layouts/MainLayout.astro';

const pageTitle = 'Get help now | Dzaleka Online Services';
const description =
  'Urgent contacts and next steps for safety, protection, health, legal issues, and essential support in and around Dzaleka.';
const canonical = 'https://services.dzaleka.com/get-help-now';
const checkedDate = '18 April 2026';

const immediateSteps = [
  'If someone is in immediate danger, use the fastest safe option available: call a hotline, go to the nearest clinic, or go to the nearest protection or police point.',
  'If a child may be at risk, call 116 as soon as you can.',
  'If the first number does not connect, try another listed contact and keep moving to the safest available help.',
];

const hotlines = [
  {
    title: 'Police emergency',
    value: '990 or 997',
    href: 'tel:990',
    detail: 'Malawi national police emergency lines. These numbers can sometimes be unreliable — if they do not connect, go directly to the nearest police post.',
    availability: '24 hours',
  },
  {
    title: 'Gender-based violence, trafficking, or forced marriage',
    value: '5600',
    href: 'tel:5600',
    detail: 'Tithandizane GBV crisis line. Free to call from Malawian mobile networks.',
    availability: '24 hours, Mon–Sat',
  },
  {
    title: 'Child protection',
    value: '116',
    href: 'tel:116',
    detail: 'Use this if a child is being abused, exploited, neglected, or is in danger.',
    availability: '24 hours, Mon–Sat',
  },
  {
    title: 'Youth support and sexual health information',
    value: '393',
    href: 'tel:393',
    detail: 'Confidential support for young people who need advice or referrals.',
    availability: '24 hours, Mon–Sat',
  },
];

const officeContacts = [
  {
    title: 'UNHCR Malawi office',
    value: '+265 177 2155',
    href: 'tel:+2651772155',
    detail: 'For protection, documentation, or status issues that need UNHCR follow-up.',
    availability: 'Mon–Thu 7:30–17:00, Fri 7:30–13:30',
  },
  {
    title: 'UNHCR protection email',
    value: 'mlwli@unhcr.org',
    href: 'mailto:mlwli@unhcr.org',
    detail: 'Useful when you need to send written details or documents.',
    availability: 'Email',
  },
  {
    title: 'UNHCR HELP portal',
    value: 'help.unhcr.org',
    href: 'https://help.unhcr.org/',
    detail: 'Official UNHCR help site for refugees and asylum seekers. Select Malawi for country-specific guidance.',
    availability: 'Online',
  },
];

const helpRoutes = [
  {
    title: 'I need safety or protection help',
    description:
      'Use this if you are dealing with violence, abuse, trafficking, threats, exploitation, or a protection concern.',
    links: [
      { label: 'Protection hotlines', href: '/rights-navigator/protection-hotlines' },
      { label: 'Report a rights violation', href: '/rights-navigator/incident-report' },
      { label: 'Rights Navigator', href: '/rights-navigator' },
    ],
  },
  {
    title: 'I need legal help or I have been arrested',
    description:
      'Use this if you need legal advice, help with refugee status issues, or support after arrest or detention.',
    links: [
      { label: 'Legal aid directory', href: '/rights-navigator/legal-aid-directory' },
      { label: 'UNHCR Malawi', href: '/services/unhcr-malawi' },
      { label: 'Rights Navigator', href: '/rights-navigator' },
    ],
  },
  {
    title: 'I need medical help',
    description:
      'Use this if you are sick, injured, pregnant, need treatment, or need urgent health support.',
    links: [
      { label: 'Dzaleka Health Centre', href: '/services/dzaleka-health-centre' },
      { label: 'Browse services', href: '/services' },
      { label: 'Help Desk', href: '/help-desk' },
    ],
  },
  {
    title: 'I need mental health or emotional support',
    description:
      'Use this if you feel overwhelmed, hopeless, distressed, or need a calmer starting point for trauma, counseling, or community-based wellbeing support.',
    links: [
      { label: 'Dzaleka Wellbeing', href: '/dzaleka-wellbeing' },
      { label: 'Dzaleka Health Centre', href: '/services/dzaleka-health-centre' },
      { label: 'JRS Malawi', href: '/services/jrs-malawi' },
    ],
  },
  {
    title: 'I need food, shelter, or basic support',
    description:
      'Use this if your need is urgent but not only legal or medical, and you need help reaching the right support route.',
    links: [
      { label: 'Emergency relief application', href: '/applications/internal/emergency' },
      { label: 'Help Desk', href: '/help-desk' },
      { label: 'Start Here', href: '/start-here' },
    ],
  },
];

const beforeYouCall = [
  'Your name and a safe phone number, if you have one.',
  'Your exact location or block.',
  'What happened and when it happened.',
  'Who is at risk right now.',
  'Whether you need language support or an interpreter.',
];

const sourceLinks = [
  {
    label: 'YONECO (Youth Net and Counselling)',
    href: 'https://yoneco.org',
    note: 'Hotline numbers 5600, 116, and 393 are listed site-wide. The former /information/ page has been removed.',
  },
  {
    label: 'UNHCR Malawi office page',
    href: 'https://www.unhcr.org/us/where-we-work/countries/malawi',
    note: 'Checked 18 April 2026 for the Malawi office phone number, email, and working hours.',
  },
  {
    label: 'Malawi police emergency numbers',
    href: 'https://www.gov.uk/foreign-travel-advice/malawi',
    note: 'Police numbers 990 and 997 confirmed via UK FCDO travel advice for Malawi.',
  },
  {
    label: 'UNHCR HELP portal for refugees',
    href: 'https://help.unhcr.org/',
    note: 'Official UNHCR self-service portal for asylum procedures, legal support, and services.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description,
  url: canonical,
};
---

<MainLayout title={pageTitle} description={description} canonical={canonical} schema={schema}>
  <div class="bg-white">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">

      <header class="pb-8 pt-12">
        <p class="text-sm font-semibold uppercase tracking-widest text-slate-500">Urgent help</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Get help now
        </h1>
        <p class="mt-5 text-xl leading-9 text-slate-600">
          Use this page when your problem cannot wait. It brings together the quickest routes for
          safety, protection, legal, health, and essential support.
        </p>
        <p class="mt-5 text-sm text-slate-500">Contacts checked: {checkedDate}</p>
      </header>

      <div class="border-l-4 border-red-600 bg-red-50 px-5 py-5" role="alert">
        <h2 class="text-lg font-bold text-slate-900">If the situation is urgent</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-[0.9375rem] leading-7 text-slate-700 marker:text-red-600">
          {immediateSteps.map((step) => <li>{step}</li>)}
        </ul>
      </div>

      <section class="mt-12 border-t border-slate-200 pt-10">
        <h2 class="text-2xl font-bold text-slate-900">Call or email now</h2>
        <p class="mt-4 text-[0.9375rem] leading-[1.85] text-slate-700">
          Start with the most direct contact for your situation.
        </p>
        <div class="mt-6 divide-y divide-slate-200 border-y border-slate-200">
          {hotlines.map((hotline) => (
            <div class="py-6">
              <h3 class="text-base font-bold text-slate-900">{hotline.title}</h3>
              <p class="mt-1 text-3xl font-bold tracking-tight text-slate-900">
                <a href={hotline.href} class="underline underline-offset-4 hover:text-slate-600">{hotline.value}</a>
              </p>
              <p class="mt-2 text-[0.9375rem] leading-7 text-slate-700">{hotline.detail}</p>
              <p class="mt-1 text-sm text-slate-500">{hotline.availability}</p>
            </div>
          ))}
        </div>

        <h3 class="mt-10 text-lg font-bold text-slate-900">Offices and online help</h3>
        <div class="mt-2 divide-y divide-slate-200 border-y border-slate-200">
          {officeContacts.map((contact) => (
            <div class="py-5">
              <h4 class="text-base font-bold text-slate-900">{contact.title}</h4>
              <p class="mt-1 text-lg font-semibold text-slate-900">
                <a href={contact.href} class="underline underline-offset-[3px] hover:text-slate-600">{contact.value}</a>
              </p>
              <p class="mt-2 text-[0.9375rem] leading-7 text-slate-700">{contact.detail}</p>
              <p class="mt-1 text-sm text-slate-500">{contact.availability}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-12 border-t border-slate-200 pt-10">
        <h2 class="text-2xl font-bold text-slate-900">Before you call or write</h2>
        <p class="mt-4 text-[0.9375rem] leading-[1.85] text-slate-700">
          If it is safe to do so, prepare these details first.
        </p>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-[0.9375rem] leading-7 text-slate-700 marker:text-slate-400">
          {beforeYouCall.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="mt-12 border-t border-slate-200 pt-10">
        <h2 class="text-2xl font-bold text-slate-900">Choose the right route</h2>
        <div class="mt-6 divide-y divide-slate-200 border-y border-slate-200">
          {helpRoutes.map((route) => (
            <div class="py-6">
              <h3 class="text-lg font-bold text-slate-900">{route.title}</h3>
              <p class="mt-2 text-[0.9375rem] leading-7 text-slate-700">{route.description}</p>
              <p class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-[0.9375rem]">
                {route.links.map((link) => (
                  <a href={link.href} class="font-semibold text-slate-900 underline underline-offset-[3px] hover:text-slate-600">{link.label}</a>
                ))}
              </p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-12 border-t border-slate-200 pt-10">
        <h2 class="text-2xl font-bold text-slate-900">Not sure which page to use?</h2>
        <p class="mt-4 text-[0.9375rem] leading-[1.85] text-slate-700">
          If your situation is urgent but you are not sure where it fits, start with support and
          ask to be routed to the right team.
        </p>
        <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-[0.9375rem]">
          <a href="/help-desk" class="font-semibold text-slate-900 underline underline-offset-[3px] hover:text-slate-600">Open Help Desk</a>
          <a href="/start-here" class="font-semibold text-slate-900 underline underline-offset-[3px] hover:text-slate-600">Go to Start Here</a>
        </p>
      </section>

      <section class="mb-16 mt-12 border-t border-slate-200 pt-10">
        <h2 class="text-2xl font-bold text-slate-900">Where these contacts came from</h2>
        <p class="mt-4 text-[0.9375rem] leading-[1.85] text-slate-700">
          Checked on {checkedDate}. Hotline and office details on this page came from the sources below.
        </p>
        <ul class="mt-4 space-y-4 text-[0.9375rem] leading-7 text-slate-700">
          {sourceLinks.map((source) => (
            <li>
              <a href={source.href} class="font-semibold text-slate-900 underline underline-offset-[3px] hover:text-slate-600">{source.label}</a>
              <span class="block text-sm text-slate-600">{source.note}</span>
            </li>
          ))}
        </ul>
      </section>

    </div>
  </div>
</MainLayout>
