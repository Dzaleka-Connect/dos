---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { isJobExpired } from '../utils/dateHelpers';
import { formatOpportunityDate as formatDate, opportunityStatus, externalOpportunityStatus } from '../utils/opportunityDates';
import OpportunityFeature from '../components/opportunities/OpportunityFeature.astro';
import { papitaKhasuResidency } from '../data/papitaKhasuResidency';
export const prerender = false;
import {
  audienceLabels,
  audienceShortLabels,
  curatedGrantsPrograms,
  externalOpportunities,
  getStatusClasses,
  type ExternalOpportunityStatus,
  type OpportunityAudience,
  type OpportunityStatus
} from '../data/grantsPrograms';

interface FinderItem {
  title: string;
  summary: string;
  href: string;
  status: OpportunityStatus;
  type: string;
  audience: OpportunityAudience[];
  organization: string;
  deadline?: string;
}

const pageTitle = 'Grants and programs';
const pageDescription =
  'Browse Dzaleka opportunities, official external grants, refugee business support programmes, and watchlist sources relevant to Malawi and the wider region.';
const canonicalUrl = 'https://services.dzaleka.com/grants-and-programs';
const pageKeywords =
  'Dzaleka grants, Dzaleka programs, refugee opportunities Malawi, refugee business grants Malawi, refugee entrepreneur support, Dzaleka job opportunities, business support Dzaleka';

const jobItems = (await getCollection('jobs'))
  .filter((job) => job.data.status === 'open' && !isJobExpired(job.data.deadline))
  .sort((a, b) => {
    const dateA = a.data.deadline ? new Date(a.data.deadline).getTime() : Infinity;
    const dateB = b.data.deadline ? new Date(b.data.deadline).getTime() : Infinity;
    return dateA - dateB;
  })
  .map<FinderItem>((job) => ({
    title: job.data.title,
    summary: job.data.description,
    href: `/jobs/${job.id}`,
    status: 'open',
    type: 'Job opportunity',
    audience:
      job.data.category === 'business'
        ? ['small businesses and traders', 'artists, educators, and job seekers']
        : job.data.category === 'community' || job.data.category === 'services'
          ? ['residents and families', 'artists, educators, and job seekers']
          : ['artists, educators, and job seekers'],
    organization: job.data.organization,
    deadline: job.data.deadline ? job.data.deadline.toISOString() : undefined
  }));

const curatedItems: FinderItem[] = curatedGrantsPrograms.map((item) => ({
  title: item.title,
  summary: item.summary,
  href: `/grants-and-programs/${item.slug}`,
  status: opportunityStatus(item),
  type: item.type,
  audience: item.audience,
  organization: item.organization,
  deadline: item.deadline
}));

const platformItems = [...curatedItems, ...jobItems];
const datedExternalOpportunities = externalOpportunities.map(item => ({ ...item, status: externalOpportunityStatus(item) }));
const externalSectionLabels: Record<ExternalOpportunityStatus, string> = {
  'open now': 'Open now',
  'ongoing support': 'Ongoing support',
  watchlist: 'Watchlist',
  closed: 'Previous calls — closed'
};

const externalSections = (['open now', 'ongoing support', 'watchlist', 'closed'] as ExternalOpportunityStatus[]).map((status) => ({
  status,
  title: externalSectionLabels[status],
  items: datedExternalOpportunities.filter((item) => item.status === status)
})).filter(section => section.items.length);

const collectionStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: [...platformItems, ...externalOpportunities].map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      url:
        'href' in item
          ? item.href.startsWith('http')
            ? item.href
            : `https://services.dzaleka.com${item.href}`
          : item.sourceUrl
    }))
  }
};

const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://services.dzaleka.com'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Grants and programs',
      item: canonicalUrl
    }
  ]
};
---

<MainLayout title={`${pageTitle} | Dzaleka Online Services`} description={pageDescription} canonical={canonicalUrl} keywords={pageKeywords}>
  <script type="application/ld+json" set:html={JSON.stringify(collectionStructuredData)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  <div class="grants-page">
    <header class="grants-width grants-heading">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: pageTitle }]} />
      <h1>{pageTitle}</h1>
      <p>Find funding, jobs and ways to take part in community programmes. Check eligibility and closing dates before applying.</p>
      <a href="/grants-and-programs/submit" class="text-link">Submit an opportunity <span aria-hidden="true">→</span></a>
    </header>
    <div class="grants-width"><OpportunityFeature program={papitaKhasuResidency} /></div>
    <section class="grants-width directory-section" id="platform-opportunities" aria-labelledby="opportunities-heading">
      <h2 id="opportunities-heading">Browse opportunities</h2>
      <p class="section-intro">Funding calls, community jobs and ongoing registration routes. Each listing explains what is offered and how to take part.</p>
      <div class="finder-filters">
        <fieldset><legend>Status</legend><div data-status-filters class="status-filters">{['all', 'open', 'opening soon', 'ongoing', 'closed'].map(status => <button type="button" data-status={status} aria-pressed={status === 'all'}>{status === 'all' ? 'All' : status}</button>)}</div></fieldset>
        <div><label for="audience-filter">Audience</label><select id="audience-filter"><option value="all">All audiences</option>{audienceLabels.map(audience => <option value={audience}>{audienceShortLabels[audience]}</option>)}</select></div>
      </div>
      <p id="platform-results-info" role="status" class="results-count">{platformItems.length} opportunities</p>
      <div id="opportunity-list">
        {platformItems.map(item => <article class="opportunity-row" data-opportunity-card data-status={item.status} data-audience={item.audience.join('|')}>
          <div><p class="row-meta">{item.type} · {item.organization}</p><h3><a href={item.href}>{item.title}</a></h3><p class="row-summary">{item.summary}</p><p class="row-audience">{item.audience.map(audience => audienceShortLabels[audience]).join(' · ')}</p></div>
          <div class="row-details"><span class:list={['status-label', getStatusClasses(item.status)]}>{item.status}</span><p>{item.deadline ? <><span>Closing date</span><time datetime={item.deadline}>{formatDate(item.deadline)}</time></> : 'No fixed closing date'}</p></div>
        </article>)}
      </div>
      <p id="empty-state" class="hidden empty-state">No opportunities match these filters. Try another status or audience.</p>
      <nav id="platform-pagination" aria-label="Opportunity pages" class="finder-pagination"><button id="platform-prev" type="button">← Previous</button><span id="platform-page-info">Page 1</span><button id="platform-next" type="button">Next →</button></nav>
    </section>
    <section class="grants-width external-directory" aria-labelledby="external-heading">
      <h2 id="external-heading">External programmes and sources</h2><p class="section-intro">Support available elsewhere, and sources to watch for future calls. Some programmes are specific to other countries. Eligibility and programme details were last reviewed on 13 April 2026; check the official source for updates.</p>
      {externalSections.map(section => <section class="external-section"><h3>{section.title}</h3>{section.items.map(item => <details class="external-item"><summary><span><strong>{item.title}</strong><span class="external-meta">{item.location} · {item.type}</span></span><span class="disclosure-icon" aria-hidden="true">+</span></summary><div class="external-body"><p>{item.summary}</p><p><strong>Eligibility:</strong> {item.eligibilityNote}</p><p>{item.note}</p><p class="external-dates">{item.deadline && <>Closing date: {formatDate(item.deadline)} · </>}Last reviewed: {formatDate(item.verifiedDate)}</p><a class="text-link" href={item.sourceUrl}>{item.sourceLabel} <span aria-hidden="true">↗</span></a></div></details>)}</section>)}
    </section>
    <aside class="grants-width help-note"><h2>Help with an application</h2><p>Use the <a href="/tools-and-templates">document templates</a>, <a href="/help-desk">ask the help desk</a> or <a href="/contact">contact the team</a> for support.</p></aside>
  </div>
</MainLayout>
<style>
  .grants-page { background:white; color:#334155; padding-bottom:3rem; }
  .grants-width { max-width:76rem; margin-inline:auto; padding-inline:2rem; }
  .grants-heading { padding-block:2rem; }
  h1 { margin-top:1.5rem; color:#1e4865; font-size:clamp(2rem,4vw,3rem); line-height:1.2; letter-spacing:-.025em; }
  .grants-heading > p { font-size:1.125rem; line-height:1.75; max-width:45rem; margin-block:1rem .5rem; }
  .text-link { display:inline-flex; min-height:44px; align-items:center; gap:.5rem; color:#1e4865; font-size:.875rem; text-decoration:underline; text-underline-offset:4px; }
  h2 { color:#1e4865; font-size:1.5rem; line-height:1.35; }
  .section-intro { font-size:.9375rem; line-height:1.75; max-width:48rem; margin-top:.75rem; }
  .directory-section,.external-directory { padding-top:3rem; }
  .finder-filters { display:grid; grid-template-columns:1fr 17rem; gap:1.5rem; padding-block:1.5rem; border-bottom:1px solid #cbd5e1; }
  .finder-filters legend,.finder-filters label { display:block; font-size:.8125rem; font-weight:600; margin-bottom:.5rem; }
  .status-filters { display:flex; flex-wrap:wrap; gap:.5rem; }
  .status-filters button,.finder-pagination button { min-height:44px; border:1px solid #cbd5e1; border-radius:4px; padding:.5rem .875rem; font-size:.875rem; text-transform:capitalize; }
  .status-filters button[aria-pressed='true'] { background:#1e4865; border-color:#1e4865; color:white; }
  .status-filters button[aria-pressed='false']:hover,.finder-pagination button:hover:enabled { background:#f1f5f9; }
  select { min-height:44px; width:100%; border:1px solid #cbd5e1; border-radius:4px; font-size:.875rem; padding:.6rem 2rem .6rem .75rem; }
  .results-count { padding-top:1rem; font-size:.8125rem; color:#64748b; }
  .opportunity-row { display:grid; grid-template-columns:minmax(0,1fr) 12rem; gap:2rem; padding-block:1.5rem; border-bottom:1px solid #e2e8f0; }
  .opportunity-row.hidden { display:none; }
  .row-meta,.row-audience { color:#64748b; font-size:.8125rem; line-height:1.6; }
  .opportunity-row h3 { margin-top:.5rem; font-size:1.25rem; line-height:1.4; }
  .opportunity-row h3 a { color:#1e4865; text-decoration:underline; text-underline-offset:4px; }
  .row-summary { font-size:.9375rem; line-height:1.7; margin-block:.65rem; max-width:45rem; }
  .status-label { display:inline-block; border-radius:4px; padding:.2rem .5rem; font-size:.75rem; text-transform:capitalize; }
  .row-details > p { font-size:.8125rem; line-height:1.6; color:#64748b; margin-top:.75rem; }
  .row-details time { display:block; color:#334155; }
  .empty-state { padding-block:2rem; }
  .finder-pagination { display:flex; justify-content:space-between; align-items:center; gap:1rem; padding-top:1.5rem; font-size:.875rem; }
  .finder-pagination.hidden { display:none; }
  .finder-pagination button:disabled { opacity:.4; cursor:not-allowed; }
  .external-section { margin-top:2rem; }
  .external-section > h3 { font-size:1.125rem; margin-bottom:.75rem; color:#1e4865; }
  .external-item { border-top:1px solid #cbd5e1; }
  .external-item:last-child { border-bottom:1px solid #cbd5e1; }
  .external-item summary { cursor:pointer; display:flex; justify-content:space-between; gap:1rem; list-style:none; padding-block:1rem; }
  .external-item summary::-webkit-details-marker { display:none; }
  .external-item strong { font-weight:600; }
  .external-meta { display:block; font-size:.8125rem; color:#64748b; margin-top:.35rem; }
  .disclosure-icon { font-size:1.4rem; font-weight:400; }
  .external-item[open] .disclosure-icon { transform:rotate(45deg); }
  .external-body { max-width:52rem; padding-bottom:1rem; }
  .external-body p { font-size:.9375rem; line-height:1.75; margin-bottom:.75rem; }
  .external-body .external-dates { font-size:.8125rem; color:#64748b; }
  .help-note { padding-top:3rem; }
  .help-note h2 { font-size:1.125rem; }
  .help-note p { margin-top:.75rem; font-size:.9375rem; line-height:1.75; }
  .help-note a { color:#1e4865; text-decoration:underline; text-underline-offset:3px; }
  @media(max-width:767px) {
    .grants-width { padding-inline:1rem; }
    .grants-heading { padding-top:1.25rem; }
    .grants-heading > p { font-size:1rem; }
    .finder-filters { grid-template-columns:1fr; }
    .opportunity-row { grid-template-columns:1fr; gap:1rem; }
    .row-details { display:flex; align-items:center; flex-wrap:wrap; gap:.75rem; }
    .row-details > p { margin:0; }
    .row-details time { display:inline; margin-left:.5rem; }
  }
</style>
<script>
  const statusButtons = Array.from(document.querySelectorAll('[data-status-filters] button'));
  const audienceFilter = document.getElementById('audience-filter');
  const cards = Array.from(document.querySelectorAll('[data-opportunity-card]'));
  const emptyState = document.getElementById('empty-state');
  const pagination = document.getElementById('platform-pagination');
  const prevButton = document.getElementById('platform-prev');
  const nextButton = document.getElementById('platform-next');
  const pageInfo = document.getElementById('platform-page-info');
  const resultsInfo = document.getElementById('platform-results-info');

  let activeStatus = 'all';
  let currentPage = 1;
  const itemsPerPage = 6;

  function getFilteredCards() {
    const audienceValue = audienceFilter instanceof HTMLSelectElement ? audienceFilter.value : 'all';

    return cards.filter((card) => {
      const cardStatus = card.getAttribute('data-status');
      const cardAudience = card.getAttribute('data-audience') || '';
      const matchesStatus = activeStatus === 'all' || cardStatus === activeStatus;
      const matchesAudience = audienceValue === 'all' || cardAudience.includes(audienceValue);
      return matchesStatus && matchesAudience;
    });
  }

  function updateCards() {
    const filteredCards = getFilteredCards();
    const totalPages = Math.max(1, Math.ceil(filteredCards.length / itemsPerPage));

    if (currentPage > totalPages) currentPage = totalPages;

    cards.forEach((card) => {
      card.classList.add('hidden');
    });

    const startIndex = (currentPage - 1) * itemsPerPage;
    const endIndex = startIndex + itemsPerPage;

    filteredCards.slice(startIndex, endIndex).forEach((card) => {
      card.classList.remove('hidden');
    });

    emptyState?.classList.toggle('hidden', filteredCards.length !== 0);

    if (resultsInfo) resultsInfo.textContent = `${filteredCards.length} ${filteredCards.length === 1 ? 'opportunity' : 'opportunities'} found`;
    if (pagination && prevButton && nextButton && pageInfo && resultsInfo) {
      const shouldShowPagination = filteredCards.length > itemsPerPage;
      pagination.classList.toggle('hidden', !shouldShowPagination);
      prevButton.toggleAttribute('disabled', currentPage === 1);
      nextButton.toggleAttribute('disabled', currentPage === totalPages);
      pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
      resultsInfo.textContent = `${filteredCards.length} ${filteredCards.length === 1 ? 'opportunity' : 'opportunities'} found`;
    }
  }

  statusButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeStatus = button.getAttribute('data-status') || 'all';
      currentPage = 1;

      statusButtons.forEach((otherButton) => {
        const isActive = otherButton === button;
        otherButton.setAttribute('aria-pressed', String(isActive));
      });

      updateCards();
    });
  });

  audienceFilter?.addEventListener('change', () => {
    currentPage = 1;
    updateCards();
  });

  prevButton?.addEventListener('click', () => {
    if (currentPage === 1) return;
    currentPage -= 1;
    updateCards();
  });

  nextButton?.addEventListener('click', () => {
    const totalPages = Math.max(1, Math.ceil(getFilteredCards().length / itemsPerPage));
    if (currentPage === totalPages) return;
    currentPage += 1;
    updateCards();
  });

  updateCards();
</script>
