---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const stories = await getCollection('inspirational-stories');
  return stories.map(story => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const { title, name, age, country, description, date, personImage, content, tags, contact } = story.data;
const currentUrl = Astro.url.href;

// Convert Markdown content to HTML using a simple approach
const htmlContent = content
  .replace(/^# (.*$)/gim, '<h1 class="text-3xl font-bold text-gray-900 mb-4">$1</h1>')
  .replace(/^## (.*$)/gim, '<h2 class="text-2xl font-semibold text-gray-800 mb-3">$1</h2>')
  .replace(/^### (.*$)/gim, '<h3 class="text-xl font-semibold text-gray-800 mb-2">$1</h3>')
  .replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold">$1</strong>')
  .replace(/\*(.*?)\*/g, '<em class="italic">$1</em>')
  .replace(/\n\n/g, '</p><p class="mb-4">')
  .replace(/^(.+)$/gm, '<p class="mb-4">$1</p>')
  .replace(/<p class="mb-4"><\/p>/g, '')
  .replace(/<p class="mb-4"><h/g, '<h')
  .replace(/<\/h[1-6]><\/p>/g, '</h$1>');

// SEO meta tags
const seoTitle = `${name} - Inspiring Refugee Story from ${country}`;
const seoDescription = `${description} Read the incredible true story of ${name}, a refugee from ${country} living in Dzaleka Camp, Malawi. Discover how ${name} overcame challenges and found hope. ${tags?.length ? `Topics: ${tags.slice(0, 3).join(', ')}` : ''}`;
const seoKeywords = `${name}, ${country} refugee, refugee story, refugee success, Dzaleka refugee camp, Malawi refugees, refugee resilience, refugee hope, refugee empowerment, ${tags?.join(', ') || ''}, inspiring refugee stories, refugee survival stories`;
const seoImage = personImage || '/images/default-profile.jpg';
---

<MainLayout 
  title={seoTitle} 
  description={seoDescription} 
  keywords={seoKeywords}
  image={seoImage}
  url={currentUrl}
  openGraph={{
    title: seoTitle,
    description: seoDescription,
    type: "article",
    url: currentUrl,
    site_name: "Dzaleka Online Services",
    image: {
      url: seoImage,
      width: 1200,
      height: 630,
      alt: `${name} - Inspiring Refugee Story`
    },
    article: {
      publishedTime: date,
      author: name,
      tags: tags || [],
      section: "Inspirational Stories"
    }
  }}
  twitter={{
    card: "summary_large_image",
    title: seoTitle,
    description: seoDescription,
    image: seoImage
  }}
>
  {/* Structured Data for SEO */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": name,
    "description": description,
    "image": seoImage,
    "url": currentUrl,
    "nationality": {
      "@type": "Country",
      "name": country
    },
    "knowsAbout": tags || [],
    "hasOccupation": {
      "@type": "Occupation",
      "name": title
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": currentUrl
    },
    "publisher": {
      "@type": "Organization",
      "name": "Dzaleka Online Services",
      "url": "https://services.dzaleka.com"
    }
  })} />
  <article class="min-h-screen bg-white">
    {/* Header Section */}
    <div class="bg-gradient-to-br from-blue-50 to-indigo-100 border-b border-gray-200">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {/* Back Button */}
        <div class="mb-8">
          <a
            href="/inspirational-stories"
            class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-lg text-gray-700 hover:bg-gray-50 transition-colors shadow-sm border border-gray-200"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span>Back to Inspirational Stories</span>
          </a>
        </div>

        {/* Person Info */}
        <div class="flex flex-col lg:flex-row gap-8 items-start">
          {/* Person Photo */}
          <div class="flex-shrink-0">
            {personImage ? (
              <div class="w-48 h-48 rounded-full overflow-hidden shadow-lg border-4 border-white">
                <img
                  src={personImage}
                  alt={name}
                  class="w-full h-full object-cover"
                />
              </div>
            ) : (
              <div class="w-48 h-48 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center shadow-lg border-4 border-white">
                <span class="text-6xl font-bold text-white">
                  {name.charAt(0)}
                </span>
              </div>
            )}
          </div>

          {/* Person Details */}
          <div class="flex-1 space-y-4">
            <div class="space-y-2">
              <h1 class="text-3xl lg:text-4xl font-bold text-gray-900">
                {name}
              </h1>
              <p class="text-xl text-gray-600 font-medium">
                {title}
              </p>
            </div>

            <p class="text-lg text-gray-700 leading-relaxed">
              {description}
            </p>

            <div class="flex flex-wrap items-center gap-4">
              <span class="px-3 py-1 text-sm font-medium text-blue-700 bg-blue-100 rounded-full">
                {country}
              </span>
              {age && (
                <span class="px-3 py-1 text-sm font-medium text-green-700 bg-green-100 rounded-full">
                  {age} years old
                </span>
              )}
              {tags?.map(tag => (
                <span class="px-3 py-1 text-sm font-medium text-gray-600 bg-gray-100 rounded-full">
                  {tag}
                </span>
              ))}
              <time class="text-sm text-gray-500">
                {new Date(date).toLocaleDateString('en-US', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </time>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Main Content */}
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      {/* Story Content */}
      <div class="prose prose-lg max-w-none">
        <div class="text-gray-700 leading-relaxed space-y-6 story-content" set:html={htmlContent} />
      </div>

      {/* Contact Information Section */}
      {contact && (
        <div class="mt-16 pt-8 border-t border-gray-200">
          <div class="bg-gradient-to-r from-gray-50 to-blue-50 rounded-2xl p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Get in Touch with {name}
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {contact.whatsapp && (
                <a 
                  href={`https://wa.me/${contact.whatsapp.replace(/[^0-9]/g, '')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 p-4 bg-green-50 rounded-xl hover:bg-green-100 transition-colors border border-green-200"
                >
                  <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-semibold text-green-800">WhatsApp</div>
                    <div class="text-sm text-green-600">{contact.whatsapp}</div>
                  </div>
                </a>
              )}

              {contact.email && (
                <a 
                  href={`mailto:${contact.email}`}
                  class="flex items-center gap-3 p-4 bg-blue-50 rounded-xl hover:bg-blue-100 transition-colors border border-blue-200"
                >
                  <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-semibold text-blue-800">Email</div>
                    <div class="text-sm text-blue-600">{contact.email}</div>
                  </div>
                </a>
              )}

              {contact.twitter && (
                <a 
                  href={`https://twitter.com/${contact.twitter.replace('@', '')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 p-4 bg-sky-50 rounded-xl hover:bg-sky-100 transition-colors border border-sky-200"
                >
                  <div class="w-10 h-10 bg-sky-500 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-semibold text-sky-800">Twitter</div>
                    <div class="text-sm text-sky-600">@{contact.twitter.replace('@', '')}</div>
                  </div>
                </a>
              )}

              {contact.website && (
                <a 
                  href={contact.website.startsWith('http') ? contact.website : `https://${contact.website}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 p-4 bg-purple-50 rounded-xl hover:bg-purple-100 transition-colors border border-purple-200"
                >
                  <div class="w-10 h-10 bg-purple-500 rounded-full flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.94-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="font-semibold text-purple-800">Website</div>
                    <div class="text-sm text-purple-600">{contact.website}</div>
                  </div>
                </a>
              )}
            </div>

            <div class="mt-6 p-4 bg-yellow-50 rounded-xl border border-yellow-200">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-yellow-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <div class="text-sm text-yellow-800">
                  <strong>Note:</strong> Please be respectful when reaching out. These individuals are sharing their stories to inspire others and create connections. Consider their time and circumstances when contacting them.
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Share Section */}
      <div class="mt-16 pt-8 border-t border-gray-200">
        <div class="flex items-center justify-between">
          <h3 class="text-lg font-semibold text-gray-900">Share this story</h3>
          <div class="flex gap-3">
            <button
              class="p-3 rounded-full bg-blue-600 text-white hover:bg-blue-700 transition-colors shadow-sm"
              data-share="twitter"
              aria-label="Share on Twitter"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
            </button>
            <button
              class="p-3 rounded-full bg-blue-800 text-white hover:bg-blue-900 transition-colors shadow-sm"
              data-share="facebook"
              aria-label="Share on Facebook"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </button>
            <button
              class="p-3 rounded-full bg-green-600 text-white hover:bg-green-700 transition-colors shadow-sm"
              data-share="whatsapp"
              aria-label="Share on WhatsApp"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

      {/* Related Stories Section */}
      <div class="mt-16 pt-8 border-t border-gray-200">
        <h3 class="text-2xl font-bold text-gray-900 mb-6">More Inspirational Stories</h3>
        <div class="text-center">
          <a 
            href="/inspirational-stories" 
            class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white font-medium rounded-lg hover:from-blue-700 hover:to-purple-700 transition-all shadow-lg"
          >
            <span>View All Stories</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </article>
</MainLayout>

<script>
  // Share functionality
  const shareButtons = document.querySelectorAll('[data-share]');
  const title = document.querySelector('h1')?.textContent || '';
  const url = window.location.href;

  shareButtons.forEach(button => {
    button.addEventListener('click', () => {
      const platform = button.getAttribute('data-share');
      let shareUrl = '';

      switch (platform) {
        case 'twitter':
          shareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;
          break;
        case 'facebook':
          shareUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
          break;
        case 'whatsapp':
          shareUrl = `https://wa.me/?text=${encodeURIComponent(title + ' ' + url)}`;
          break;
      }

      if (shareUrl) {
        window.open(shareUrl, '_blank');
      }
    });
  });
</script>

<style>
  /* Improved text formatting and spacing */
  .story-content {
    font-size: 1.125rem;
    line-height: 1.625;
    color: #374151;
  }

  .story-content :global(p) {
    margin-bottom: 1.25rem;
    line-height: 1.625;
    color: #374151;
    text-align: justify;
    font-size: 1.125rem;
    font-weight: 400;
  }

  .story-content :global(p:first-of-type) {
    font-size: 1.125rem;
    font-weight: 400;
    color: #374151;
    margin-bottom: 1.25rem;
    line-height: 1.625;
  }

  .story-content h1 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    color: #1f2937;
    border-bottom: 2px solid #e5e7eb;
    padding-bottom: 0.5rem;
  }

  .story-content h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #1f2937;
  }

  .story-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: #1f2937;
  }

  .story-content p {
    margin-bottom: 1.25rem;
    line-height: 1.625;
    color: #374151;
    text-align: justify;
    font-size: 1.125rem;
    font-weight: 400;
  }

  .story-content p:first-of-type {
    font-size: 1.125rem;
    font-weight: 400;
    color: #374151;
    margin-bottom: 1.25rem;
    line-height: 1.625;
  }

  .story-content strong {
    font-weight: 600;
    color: #1f2937;
  }

  .story-content em {
    font-style: italic;
    color: #6b7280;
  }

  .story-content blockquote {
    border-left: 4px solid #3b82f6;
    padding: 1rem 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #6b7280;
    background-color: #f8fafc;
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .story-content ul, .story-content ol {
    margin: 1.5rem 0;
    padding-left: 1.5rem;
  }

  .story-content li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }

  .story-content a {
    color: #3b82f6;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }

  .story-content a:hover {
    color: #2563eb;
  }

  /* Responsive text sizing */
  @media (max-width: 768px) {
    .story-content {
      font-size: 1rem;
      line-height: 1.6;
    }
    
    .story-content h1 {
      font-size: 1.5rem;
    }
    
    .story-content h2 {
      font-size: 1.25rem;
    }
    
    .story-content h3 {
      font-size: 1.125rem;
    }
    
