---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
  const stories = await getCollection('inspirational-stories');
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story },
  }));
}

const { story } = Astro.props;
const { title, name, age, country, description, date, personImage, content, tags, contact } = story.data;
const currentUrl = Astro.url.href;

const htmlContent = `<p class="mb-5">${content
  .replace(/^### (.*$)/gim, '</p><h3 class="mt-8 text-xl font-semibold text-gray-900">$1</h3><p class="mb-5">')
  .replace(/^## (.*$)/gim, '</p><h2 class="mt-10 text-2xl font-semibold text-gray-900">$1</h2><p class="mb-5">')
  .replace(/^# (.*$)/gim, '</p><h1 class="mt-10 text-3xl font-semibold text-gray-900">$1</h1><p class="mb-5">')
  .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
  .replace(/\*(.*?)\*/g, '<em>$1</em>')
  .replace(/\n\n/g, '</p><p class="mb-5">')}</p>`
  .replace(/<p class="mb-5"><\/p>/g, '')
  .replace(/<p class="mb-5">\s*<\/p>/g, '');

const seoTitle = `${name} | Inspirational Stories`;
const seoDescription = `${description} Read the story of ${name} from ${country}.`;
const seoImage = personImage || '/images/default-profile.jpg';

const shareLinks = {
  twitter: `https://twitter.com/intent/tweet?text=${encodeURIComponent(`${name} - Inspirational story from Dzaleka`)}&url=${encodeURIComponent(currentUrl)}`,
  facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`,
  whatsapp: `https://wa.me/?text=${encodeURIComponent(`${name} - ${currentUrl}`)}`,
};
---

<MainLayout
  title={seoTitle}
  description={seoDescription}
  image={seoImage}
  url={currentUrl}
  canonical={currentUrl}
  openGraph={{
    title: seoTitle,
    description: seoDescription,
    type: 'article',
    url: currentUrl,
    site_name: 'Dzaleka Online Services',
  }}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name,
      description,
      image: seoImage,
      url: currentUrl,
      nationality: { '@type': 'Country', name: country },
      knowsAbout: tags || [],
      hasOccupation: { '@type': 'Occupation', name: title },
      mainEntityOfPage: { '@type': 'WebPage', '@id': currentUrl },
      publisher: {
        '@type': 'Organization',
        name: 'Dzaleka Online Services',
        url: 'https://services.dzaleka.com',
      },
    })}
  />

  <article class="bg-gray-50">
    <section class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
        <nav class="mb-5 text-sm text-gray-500">
          <a href="/" class="hover:text-primary-700">Home</a>
          <span class="mx-2">/</span>
          <a href="/inspirational-stories" class="hover:text-primary-700">Inspirational stories</a>
          <span class="mx-2">/</span>
          <span class="text-gray-900">{name}</span>
        </nav>

        <div class="grid gap-8 md:grid-cols-[220px_minmax(0,1fr)] md:items-start">
          <div class="overflow-hidden rounded-xl border border-gray-200 bg-gray-100">
            {personImage ? (
              <img src={personImage} alt={name} class="h-full w-full object-cover" />
            ) : (
              <div class="flex aspect-square items-center justify-center">
                <div class="flex h-20 w-20 items-center justify-center rounded-full bg-primary-700 text-4xl font-semibold text-white">
                  {name.charAt(0)}
                </div>
              </div>
            )}
          </div>

          <div class="max-w-3xl">
            <p class="text-sm font-medium text-primary-700">{title}</p>
            <h1 class="mt-2 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">{name}</h1>
            <p class="mt-4 text-lg leading-8 text-gray-600">{description}</p>

            <div class="mt-6 flex flex-wrap gap-2 text-sm text-gray-600">
              <span class="rounded-lg bg-gray-100 px-3 py-1.5">{country}</span>
              {age && <span class="rounded-lg bg-gray-100 px-3 py-1.5">{age} years old</span>}
              <time class="rounded-lg bg-gray-100 px-3 py-1.5">
                {new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl">
          <div class="prose prose-gray max-w-none text-[17px] leading-8 text-gray-700 story-content" set:html={htmlContent} />

          {tags && tags.length > 0 && (
            <section class="mt-10 rounded-xl border border-gray-200 bg-gray-50 p-5">
              <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-gray-700">Topics</h2>
              <div class="mt-4 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <span class="rounded-md bg-white px-2.5 py-1 text-sm text-gray-700 border border-gray-200">{tag}</span>
                ))}
              </div>
            </section>
          )}

          {contact && (
            <section class="mt-8 rounded-xl border border-gray-200 bg-white p-5">
              <h2 class="text-lg font-semibold text-gray-900">Contact information</h2>
              <p class="mt-2 text-sm leading-6 text-gray-600">
                If contact details are shared here, use them respectfully and only for appropriate outreach.
              </p>

              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                {contact.whatsapp && (
                  <a
                    href={`https://wa.me/${contact.whatsapp.replace(/[^0-9]/g, '')}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-lg border border-gray-200 px-4 py-3 text-sm text-gray-700 hover:border-primary-300 hover:text-primary-700"
                  >
                    WhatsApp: {contact.whatsapp}
                  </a>
                )}
                {contact.email && (
                  <a
                    href={`mailto:${contact.email}`}
                    class="rounded-lg border border-gray-200 px-4 py-3 text-sm text-gray-700 hover:border-primary-300 hover:text-primary-700"
                  >
                    Email: {contact.email}
                  </a>
                )}
                {contact.twitter && (
                  <a
                    href={`https://twitter.com/${contact.twitter.replace('@', '')}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-lg border border-gray-200 px-4 py-3 text-sm text-gray-700 hover:border-primary-300 hover:text-primary-700"
                  >
                    Twitter: {contact.twitter}
                  </a>
                )}
                {contact.website && (
                  <a
                    href={contact.website.startsWith('http') ? contact.website : `https://${contact.website}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="rounded-lg border border-gray-200 px-4 py-3 text-sm text-gray-700 hover:border-primary-300 hover:text-primary-700"
                  >
                    Website: {contact.website}
                  </a>
                )}
              </div>
            </section>
          )}

          <section class="mt-8 rounded-xl border border-gray-200 bg-gray-50 p-5">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h2 class="text-lg font-semibold text-gray-900">Share this story</h2>
                <p class="mt-1 text-sm text-gray-600">Help other people find this profile.</p>
              </div>
              <div class="flex flex-wrap gap-2">
                <a href={shareLinks.twitter} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 hover:text-primary-700">Twitter</a>
                <a href={shareLinks.facebook} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 hover:text-primary-700">Facebook</a>
                <a href={shareLinks.whatsapp} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700 hover:text-primary-700">WhatsApp</a>
              </div>
            </div>
          </section>

          <section class="mt-8 rounded-xl border border-gray-200 bg-white p-5">
            <h2 class="text-lg font-semibold text-gray-900">More stories</h2>
            <p class="mt-2 text-sm text-gray-600">Go back to the full list to keep exploring profiles from across the community.</p>
            <a href="/inspirational-stories" class="mt-4 inline-flex text-sm font-medium text-primary-700 hover:text-primary-800">
              View all inspirational stories
            </a>
          </section>
        </div>
      </div>
    </section>
  </article>
</MainLayout>
