---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const title = "Inspiring Refugee Stories from Dzaleka Camp - Real Stories of Resilience & Hope";
const description = "Discover 15+ incredible true stories of refugees from Dzaleka Camp in Malawi. From tech entrepreneurs to artists, these inspiring individuals show resilience, hope, and determination. Read real refugee success stories that will inspire you.";
const keywords = "refugee stories, Dzaleka refugee camp, inspiring refugee stories, refugee success stories, Malawi refugees, refugee entrepreneurs, refugee artists, refugee resilience, humanitarian stories, refugee hope, refugee empowerment, African refugees, refugee community leaders, refugee youth stories, refugee survival stories";

let stories = [];
try {
  stories = await getCollection('inspirational-stories');
  // Sort by featured first, then by name
  stories.sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return a.data.name.localeCompare(b.data.name);
  });
} catch (error) {
  console.error('Error loading inspirational stories:', error);
}

// Get unique countries from all stories
const countries = [...new Set(stories.map(story => story.data.country))];
---

<MainLayout 
  title={title} 
  description={description} 
  keywords={keywords}
  openGraph={{
    title: title,
    description: description,
    type: "website",
    url: Astro.url.href,
    site_name: "Dzaleka Online Services",
    image: {
      url: "/images/inspirational-stories-og.jpg",
      width: 1200,
      height: 630,
      alt: "Inspiring Refugee Stories from Dzaleka Camp"
    }
  }}
  twitter={{
    card: "summary_large_image",
    title: title,
    description: description,
    image: "/images/inspirational-stories-og.jpg"
  }}
>
  {/* Structured Data for SEO */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": title,
    "description": description,
    "url": Astro.url.href,
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": stories.length,
      "itemListElement": stories.map((story, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "item": {
          "@type": "Person",
          "name": story.data.name,
          "description": story.data.description,
          "url": `${Astro.site}inspirational-stories/${story.id}`,
          "nationality": {
            "@type": "Country",
            "name": story.data.country
          },
          "image": story.data.personImage || `${Astro.site}images/default-profile.jpg`
        }
      }))
    }
  })} />
  <main class="min-h-screen bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      {/* Hero Section */}
      <header class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
          Meet Some People with Inspirational Stories from Dzaleka
        </h1>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto mb-6">
          Discover the incredible journeys of resilience, hope, and determination from the people of Dzaleka Refugee Camp.
        </p>
        
        {/* Simple Stats */}
        <div class="flex justify-center gap-8">
          <div class="text-center">
            <div class="text-2xl font-bold text-blue-600">{stories.length}</div>
            <div class="text-sm text-gray-600">Stories</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-purple-600">{countries.length}</div>
            <div class="text-sm text-gray-600">Countries</div>
          </div>
        </div>
      </header>

      {/* Simple Search and Filter */}
      <div class="mb-8">
        <div class="flex flex-col sm:flex-row gap-4 items-center justify-between">
          <div class="w-full sm:w-80">
            <input
              type="text"
              id="search"
              placeholder="Search people..."
              class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            />
          </div>
          
          <div class="flex flex-wrap gap-2">
            <button
              class="px-3 py-1 text-sm font-medium text-gray-700 bg-blue-100 border border-blue-300 rounded-full"
              data-country="all"
            >
              All Countries
            </button>
            {countries.map(country => (
              <button
                class="px-3 py-1 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-full hover:bg-gray-50"
                data-country={country}
              >
                {country}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Stories Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="stories-grid">
        {stories.map(story => (
          <article class="group bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow" data-country={story.data.country}>
            <a href={`/inspirational-stories/${story.id}`} class="block">
              <div class="aspect-w-16 aspect-h-12 overflow-hidden bg-gray-200">
                {story.data.personImage ? (
                  <img
                    src={story.data.personImage}
                    alt={`${story.data.name} - ${story.data.title}`}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <div class="text-center">
                      <div class="w-16 h-16 mx-auto mb-2 rounded-full bg-blue-500 flex items-center justify-center">
                        <span class="text-2xl font-bold text-white">
                          {story.data.name.charAt(0)}
                        </span>
                      </div>
                      <p class="text-sm text-gray-600">Photo coming soon</p>
                    </div>
                  </div>
                )}
              </div>
              
              <div class="p-5">
                <div class="flex items-center gap-2 mb-3">
                  <span class="px-2 py-1 text-xs font-medium text-blue-600 bg-blue-50 rounded-full">
                    {story.data.country}
                  </span>
                  {story.data.age && (
                    <span class="px-2 py-1 text-xs font-medium text-green-600 bg-green-50 rounded-full">
                      {story.data.age} years old
                    </span>
                  )}
                </div>
                
                <h2 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
                  {story.data.name}
                </h2>
                
                <p class="text-gray-600 text-sm mb-3 line-clamp-2">
                  {story.data.description}
                </p>
                
                {/* Tags */}
                {story.data.tags && story.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1 mb-3">
                    {story.data.tags.slice(0, 2).map(tag => (
                      <span class="px-2 py-1 text-xs font-medium text-gray-600 bg-gray-100 rounded-md">
                        {tag}
                      </span>
                    ))}
                    {story.data.tags.length > 2 && (
                      <span class="px-2 py-1 text-xs font-medium text-gray-500 bg-gray-50 rounded-md">
                        +{story.data.tags.length - 2} more
                      </span>
                    )}
                  </div>
                )}
                
                {/* Contact Info Preview */}
                {story.data.contact && (
                  <div class="flex items-center gap-2 mb-3">
                    {story.data.contact.whatsapp && (
                      <span class="inline-flex items-center text-xs text-green-600">
                        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                        </svg>
                        WhatsApp
                      </span>
                    )}
                    {story.data.contact.email && (
                      <span class="inline-flex items-center text-xs text-blue-600">
                        <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                        </svg>
                        Email
                      </span>
                    )}
                  </div>
                )}
                
                <div class="text-sm text-gray-500">
                  {story.data.title}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>

      {/* No Results Message - Hidden by default, shown via JavaScript */}
      <div id="no-results" class="text-center py-16" style="display: none;">
        <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gray-100 flex items-center justify-center">
          <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.47-.881-6.08-2.33" />
          </svg>
        </div>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No stories found</h3>
        <p class="text-gray-600">
          No inspirational stories match your search criteria. Please try different keywords or filters.
        </p>
      </div>

      {/* Call to Action */}
      <div class="mt-16 text-center">
        <div class="bg-blue-600 rounded-lg p-8 text-white">
          <h2 class="text-2xl font-bold mb-4">Inspired by these stories?</h2>
          <p class="text-blue-100 mb-6 max-w-2xl mx-auto">
            These incredible individuals are just a few examples of the resilience and talent found in Dzaleka Refugee Camp. Support their work and help create more opportunities for refugees.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" class="inline-flex items-center px-6 py-3 bg-white text-blue-600 font-medium rounded-lg hover:bg-gray-50 transition-colors">
              Get in Touch
            </a>
            <a href="/support-our-work" class="inline-flex items-center px-6 py-3 border-2 border-white text-white font-medium rounded-lg hover:bg-white hover:text-blue-600 transition-colors">
              Support Our Work
            </a>
          </div>
        </div>
      </div>
    </main>
</MainLayout>

<script>
  // Enhanced search and filter functionality
  const searchInput = document.getElementById('search');
  const storiesGrid = document.getElementById('stories-grid');
  const storyCards = storiesGrid?.querySelectorAll('article');
  const countryButtons = document.querySelectorAll('[data-country]');
  
  let activeCountries = new Set();
  
  function filterStories() {
    const searchTerm = searchInput?.value.toLowerCase() || '';
    let visibleCount = 0;
    
    storyCards?.forEach(card => {
      const name = card.querySelector('h2')?.textContent?.toLowerCase() || '';
      const description = card.querySelector('p')?.textContent?.toLowerCase() || '';
      const title = card.querySelector('.text-sm.text-gray-500')?.textContent?.toLowerCase() || '';
      const tags = Array.from(card.querySelectorAll('.text-xs.font-medium.text-gray-600')).map(tag => tag.textContent?.toLowerCase() || '');
      const country = card.dataset.country?.toLowerCase();
      
      const matchesSearch = name.includes(searchTerm) || 
                           description.includes(searchTerm) || 
                           title.includes(searchTerm) ||
                           tags.some(tag => tag.includes(searchTerm));
      const matchesCountry = activeCountries.size === 0 || 
                            activeCountries.has('all') || 
                            (country && activeCountries.has(country));
      
      if (matchesSearch && matchesCountry) {
        card.style.display = 'block';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // Show/hide no results message
    const noResults = document.getElementById('no-results');
    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }
  
  searchInput?.addEventListener('input', filterStories);
  
  countryButtons.forEach(button => {
    button.addEventListener('click', () => {
      const country = button.dataset.country?.toLowerCase();
      if (!country) return;
      
      // Reset all buttons
      countryButtons.forEach(btn => {
        btn.classList.remove('bg-blue-100', 'text-blue-700', 'border-blue-300');
        btn.classList.add('bg-white', 'text-gray-700', 'border-gray-300');
      });
      
      if (country === 'all') {
        activeCountries.clear();
        activeCountries.add('all');
        button.classList.remove('bg-white', 'text-gray-700', 'border-gray-300');
        button.classList.add('bg-blue-100', 'text-blue-700', 'border-blue-300');
      } else {
        activeCountries.clear();
        activeCountries.add(country);
        button.classList.remove('bg-white', 'text-gray-700', 'border-gray-300');
        button.classList.add('bg-blue-100', 'text-blue-700', 'border-blue-300');
      }
      
      filterStories();
    });
  });

  // Initialize with "All Countries" selected
  const allButton = document.querySelector('[data-country="all"]');
  if (allButton) {
    allButton.click();
  }
</script>

<style>
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
