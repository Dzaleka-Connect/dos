---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const title = 'Inspirational Stories | Dzaleka Online Services';
const description =
  'Read personal stories from people connected to Dzaleka, including artists, workers, entrepreneurs, and community leaders.';

let stories = [];
try {
  stories = await getCollection('inspirational-stories');
  stories.sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return a.data.name.localeCompare(b.data.name);
  });
} catch (error) {
  console.error('Error loading inspirational stories:', error);
}

const countries = [...new Set(stories.map((story) => story.data.country))];
---

<MainLayout
  title={title}
  description={description}
  canonical="https://services.dzaleka.com/inspirational-stories"
  openGraph={{
    title,
    description,
    type: 'website',
    url: 'https://services.dzaleka.com/inspirational-stories',
    site_name: 'Dzaleka Online Services',
  }}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: title,
      description,
      url: 'https://services.dzaleka.com/inspirational-stories',
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: stories.length,
        itemListElement: stories.map((story, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          item: {
            '@type': 'Person',
            name: story.data.name,
            description: story.data.description,
            url: `https://services.dzaleka.com/inspirational-stories/${story.id}`,
          },
        })),
      },
    })}
  />

  <main class="bg-gray-50">
    <section class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <nav class="mb-4 text-sm text-gray-500">
          <a href="/" class="hover:text-primary-700">Home</a>
          <span class="mx-2">/</span>
          <span class="text-gray-900">Inspirational stories</span>
        </nav>

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_260px] lg:items-start">
          <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary-700">People and stories</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">
              Inspirational stories from Dzaleka
            </h1>
            <p class="mt-4 text-lg leading-8 text-gray-600">
              Read first-person and profile-style stories showing resilience, work, and everyday leadership across the community.
            </p>
          </div>

          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1">
            <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
              <div class="text-2xl font-semibold text-gray-900">{stories.length}</div>
              <div class="mt-1 text-sm text-gray-600">Published profiles</div>
            </div>
            <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
              <div class="text-2xl font-semibold text-gray-900">{countries.length}</div>
              <div class="mt-1 text-sm text-gray-600">Countries represented</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-gray-200 bg-gray-50">
      <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
        <div class="rounded-xl border border-gray-200 bg-white p-4 sm:p-5">
          <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
            <div class="w-full lg:max-w-sm">
              <label for="search" class="sr-only">Search stories</label>
              <input
                type="text"
                id="search"
                placeholder="Search by name, title, or topic"
                class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200"
              />
            </div>

            <div class="flex flex-wrap gap-2">
              <button
                class="rounded-lg border border-primary-200 bg-primary-50 px-3 py-2 text-sm font-medium text-primary-700"
                data-country="all"
              >
                All countries
              </button>
              {countries.map((country) => (
                <button
                  class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 transition hover:border-primary-300 hover:text-primary-700"
                  data-country={country}
                >
                  {country}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3" id="stories-grid">
          {stories.map((story) => (
            <article
              class="rounded-xl border border-gray-200 bg-white overflow-hidden"
              data-country={story.data.country}
            >
              <a href={`/inspirational-stories/${story.id}`} class="block h-full">
                <div class="aspect-[4/3] bg-gray-100">
                  {story.data.personImage ? (
                    <img
                      src={story.data.personImage}
                      alt={`${story.data.name} - ${story.data.title}`}
                      class="h-full w-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex h-full items-center justify-center bg-gray-100">
                      <div class="flex h-16 w-16 items-center justify-center rounded-full bg-primary-700 text-2xl font-semibold text-white">
                        {story.data.name.charAt(0)}
                      </div>
                    </div>
                  )}
                </div>

                <div class="p-5">
                  <div class="flex flex-wrap gap-2">
                    <span class="rounded-lg bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">
                      {story.data.country}
                    </span>
                    {story.data.age && (
                      <span class="rounded-lg bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">
                        {story.data.age} years old
                      </span>
                    )}
                  </div>

                  <h2 class="mt-3 text-xl font-semibold text-gray-900">{story.data.name}</h2>
                  <p class="mt-1 text-sm font-medium text-primary-700">{story.data.title}</p>
                  <p class="mt-3 text-sm leading-6 text-gray-600">{story.data.description}</p>

                  {story.data.tags && story.data.tags.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {story.data.tags.slice(0, 3).map((tag) => (
                        <span class="rounded-md bg-gray-50 px-2 py-1 text-xs text-gray-600">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            </article>
          ))}
        </div>

        <div id="no-results" class="hidden rounded-xl border border-gray-200 bg-gray-50 px-6 py-10 text-center">
          <h3 class="text-lg font-semibold text-gray-900">No stories match your search</h3>
          <p class="mt-2 text-sm text-gray-600">Try another keyword or remove one of the country filters.</p>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<script>
  const searchInput = document.getElementById('search');
  const storiesGrid = document.getElementById('stories-grid');
  const storyCards = storiesGrid?.querySelectorAll('article');
  const countryButtons = document.querySelectorAll('[data-country]');

  let activeCountries = new Set();

  function filterStories() {
    const searchTerm = searchInput?.value.toLowerCase() || '';
    let visibleCount = 0;

    storyCards?.forEach((card) => {
      const textContent = card.textContent?.toLowerCase() || '';
      const country = card.dataset.country?.toLowerCase();
      const matchesSearch = textContent.includes(searchTerm);
      const matchesCountry =
        activeCountries.size === 0 ||
        activeCountries.has('all') ||
        (country && activeCountries.has(country));

      if (matchesSearch && matchesCountry) {
        card.style.display = 'block';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    const noResults = document.getElementById('no-results');
    if (noResults) {
      noResults.classList.toggle('hidden', visibleCount !== 0);
    }
  }

  searchInput?.addEventListener('input', filterStories);

  countryButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const country = button.dataset.country?.toLowerCase();
      if (!country) return;

      countryButtons.forEach((btn) => {
        btn.classList.remove('border-primary-200', 'bg-primary-50', 'text-primary-700');
        btn.classList.add('border-gray-300', 'bg-white', 'text-gray-700');
      });

      if (country === 'all') {
        activeCountries.clear();
      } else {
        activeCountries.clear();
        activeCountries.add(country);
      }

      button.classList.remove('border-gray-300', 'bg-white', 'text-gray-700');
      button.classList.add('border-primary-200', 'bg-primary-50', 'text-primary-700');

      filterStories();
    });
  });
</script>
