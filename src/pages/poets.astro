---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const pageTitle = "Poets From Dzaleka - Literary Talent & Spoken Word Artists";
const pageDescription = "Discover the incredible poets and spoken word artists from Dzaleka Refugee Camp. Read poetry, book readings, and connect with literary talent from the Democratic Republic of Congo, Rwanda, and Burundi.";
const pageKeywords = "Dzaleka poets, refugee poetry, spoken word artists, DRC poets, Rwandan poets, Burundian poets, poetry readings, literary talent, refugee artists, Dzaleka literary community";
const canonicalURL = "https://services.dzaleka.com/poets";

// Get poet profiles from content collection
const poetProfiles = await getCollection('poets');
const featuredPoets = poetProfiles.filter(poet => poet.data.featured);

// Generate structured data for poets
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Poets From Dzaleka",
  "description": pageDescription,
  "url": canonicalURL,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": poetProfiles.length,
    "itemListElement": poetProfiles.slice(0, 10).map((poet, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Person",
        "name": poet.data.title,
        "description": poet.data.description,
        "url": `https://services.dzaleka.com/poets/${poet.id}`,
        "nationality": poet.data.nationality,
        "age": poet.data.age,
        "jobTitle": "Poet",
        "worksFor": {
          "@type": "Organization",
          "name": "Dzaleka Online Services"
        }
      }
    }))
  },
  "publisher": {
    "@type": "Organization",
    "name": "Dzaleka Online Services",
    "url": "https://services.dzaleka.com/"
  }
};
---

<MainLayout 
  title={pageTitle} 
  description={pageDescription}
  keywords={pageKeywords}
  canonical={canonicalURL}
  ogType="website"
  ogImage="/images/poets/hassan-c-honore.jpg"
  twitterCard="summary_large_image"
>
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-slate-50 to-white border-b-2 border-slate-200 mb-12 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]">
      <div class="absolute inset-0 pattern-mudcloth"></div>
    </div>

    <div class="relative container mx-auto px-4 py-16">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-block mb-6">
          <span class="px-4 py-1.5 bg-slate-100 text-slate-700 rounded-full text-sm font-medium border border-slate-200">
            Literary Community
          </span>
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          Poets From Dzaleka
        </h1>
        <p class="text-xl text-gray-600 mb-8 max-w-3xl mx-auto leading-relaxed">
          Celebrating the voices, stories, and poetry of Dzaleka's literary talent
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#browse-poets" class="inline-flex items-center px-6 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors font-medium">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            Browse Poets
          </a>
          <a href="/poets/submit" class="inline-flex items-center px-6 py-3 border-2 border-gray-900 text-slate-700 bg-white rounded-lg hover:bg-slate-50 transition-colors font-medium">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
            Add Your Profile
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Poets Section -->
  <section id="browse-poets" class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-3">Featured Poets</h2>
        <p class="text-lg text-gray-600">
          Discover the incredible literary talent from our community
        </p>
      </div>

      <!-- Poets Grid -->
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {poetProfiles.slice(0, 6).map(poet => (
          <a href={`/poets/${poet.id}`} 
             class="group bg-white rounded-lg shadow-sm hover:shadow-md transition-all duration-200 border border-gray-100 hover:border-slate-200 overflow-hidden flex flex-col">
            <div class="relative h-48 overflow-hidden bg-gray-100">
              {poet.data.image ? (
                <img src={poet.data.image} alt={poet.data.title} 
                     class="w-full h-full object-cover" />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center">
                  <svg class="w-16 h-16 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                </div>
              )}
              {poet.data.featured && (
                <div class="absolute top-3 right-3 bg-yellow-500 text-white px-2 py-1 rounded-full text-xs font-semibold">
                  Featured
                </div>
              )}
            </div>
            <div class="p-5 flex-grow flex flex-col">
              <h3 class="text-lg font-bold text-gray-900 mb-2">
                {poet.data.title}
              </h3>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2 flex-grow">{poet.data.description}</p>
              <div class="flex items-center justify-between text-sm">
                <span class="text-gray-500 truncate">
                  {poet.data.age && `${poet.data.age} years`} {poet.data.age && poet.data.nationality && '•'} {poet.data.nationality}
                </span>
                <span class="text-slate-700 font-medium">
                  View Profile →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Pagination -->
      {poetProfiles.length > 6 && (
        <div class="mt-12 flex justify-center">
          <div class="flex items-center space-x-2">
            <a href="/poets" 
               class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border-2 border-gray-900 rounded-lg hover:bg-slate-50">
              1
            </a>
            {poetProfiles.length > 6 && (
              <a href="/poets/2" 
                 class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                2
              </a>
            )}
            {poetProfiles.length > 12 && (
              <a href="/poets/3" 
                 class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                3
              </a>
            )}
            {poetProfiles.length > 18 && (
              <a href="/poets/4" 
                 class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                4
              </a>
            )}
            {poetProfiles.length > 6 && (
              <a href="/poets/2" 
                 class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
                Next →
              </a>
            )}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Community Impact Section -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-3">Poetry as Community Voice</h2>
        <p class="text-gray-600 max-w-3xl mx-auto">
          Our poets give voice to the community, preserve stories, and create opportunities for cultural expression
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6">
        <div class="text-center bg-white p-6 rounded-lg border border-gray-100">
          <div class="bg-slate-100 rounded-full w-14 h-14 flex items-center justify-center mx-auto mb-3">
            <svg class="w-7 h-7 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Community Voice</h3>
          <p class="text-gray-600 text-sm">Giving voice to stories and experiences through poetry</p>
        </div>
        
        <div class="text-center bg-white p-6 rounded-lg border border-gray-100">
          <div class="bg-slate-100 rounded-full w-14 h-14 flex items-center justify-center mx-auto mb-3">
            <svg class="w-7 h-7 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Cultural Expression</h3>
          <p class="text-gray-600 text-sm">Preserving heritage through spoken word and written poetry</p>
        </div>
        
        <div class="text-center bg-white p-6 rounded-lg border border-gray-100">
          <div class="bg-slate-100 rounded-full w-14 h-14 flex items-center justify-center mx-auto mb-3">
            <svg class="w-7 h-7 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Emotional Healing</h3>
          <p class="text-gray-600 text-sm">Using poetry for healing, expression, and connection</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-bold text-gray-900 mb-3">Join Our Poetry Community</h2>
      <p class="text-gray-600 mb-6">
        Whether you want to book a reading or add your profile, there are many ways to get involved
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-gray-900 text-white hover:bg-gray-800 transition-colors font-medium">
          Book a Reading
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a href="/poets/submit" class="inline-flex items-center justify-center px-6 py-3 rounded-lg border-2 border-gray-900 text-slate-700 bg-white hover:bg-slate-50 transition-colors font-medium">
          Add Your Profile
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.line-clamp-1 {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
</style>
