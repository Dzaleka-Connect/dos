---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const pageTitle = "Poets From Dzaleka - Literary Talent & Spoken Word Artists";
const pageDescription = "Discover the incredible poets and spoken word artists from Dzaleka Refugee Camp. Read poetry, book readings, and connect with literary talent from the Democratic Republic of Congo, Rwanda, and Burundi.";
const pageKeywords = "Dzaleka poets, refugee poetry, spoken word artists, DRC poets, Rwandan poets, Burundian poets, poetry readings, literary talent, refugee artists, Dzaleka literary community";
const canonicalURL = "https://services.dzaleka.com/poets";

// Get poet profiles from content collection
const poetProfiles = await getCollection('poets');
const featuredPoets = poetProfiles.filter(poet => poet.data.featured);

// Generate structured data for poets
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Poets From Dzaleka",
  "description": pageDescription,
  "url": canonicalURL,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": poetProfiles.length,
    "itemListElement": poetProfiles.slice(0, 10).map((poet, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Person",
        "name": poet.data.title,
        "description": poet.data.description,
        "url": `https://services.dzaleka.com/poets/${poet.slug}`,
        "nationality": poet.data.nationality,
        "age": poet.data.age,
        "jobTitle": "Poet",
        "worksFor": {
          "@type": "Organization",
          "name": "Dzaleka Online Services"
        }
      }
    }))
  },
  "publisher": {
    "@type": "Organization",
    "name": "Dzaleka Digital Heritage Archive",
    "url": "https://services.dzaleka.com/"
  }
};
---

<MainLayout 
  title={pageTitle} 
  description={pageDescription}
  keywords={pageKeywords}
  canonical={canonicalURL}
  ogType="website"
  ogImage="/images/poets/hassan-c-honore.jpg"
  twitterCard="summary_large_image"
>
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-indigo-900 via-indigo-800 to-purple-900 py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl sm:text-6xl font-bold text-white tracking-tight mb-6">
        Poets From Dzaleka
      </h1>
      <p class="text-xl sm:text-2xl text-indigo-100 max-w-4xl mx-auto mb-12">
        Celebrating the Voices, Stories, and Poetry of Dzaleka's Literary Talent
      </p>
      
      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#browse-poets" 
           class="inline-flex items-center justify-center px-8 py-4 rounded-lg text-indigo-900 bg-white hover:bg-gray-50 transition-colors font-semibold text-lg shadow-lg">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          Browse Poets
        </a>
        <a href="/contact" 
           class="inline-flex items-center justify-center px-8 py-4 rounded-lg text-white border-2 border-white hover:bg-white hover:text-indigo-900 transition-colors font-semibold text-lg">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          Book a Reading
        </a>
        <a href="/poets/submit" 
           class="inline-flex items-center justify-center px-8 py-4 rounded-lg text-white border-2 border-white hover:bg-white hover:text-indigo-900 transition-colors font-semibold text-lg">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          Add Your Profile
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Poets Section -->
  <section id="browse-poets" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Meet Some Poets From Dzaleka</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Discover the incredible literary talent and inspiring stories from our community's poets and spoken word artists.
        </p>
      </div>

      <!-- Poets Grid -->
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {poetProfiles.slice(0, 6).map(poet => (
          <a href={`/poets/${poet.slug}`} 
             class="group bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-gray-100 overflow-hidden flex flex-col h-full">
            <div class="relative h-64 overflow-hidden flex-shrink-0">
              {poet.data.image ? (
                <img src={poet.data.image} alt={poet.data.title} 
                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-indigo-400 to-purple-600 flex items-center justify-center">
                  <div class="text-white text-center">
                    <svg class="w-16 h-16 mx-auto mb-4 opacity-80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                    <p class="text-sm opacity-90">Poet</p>
                  </div>
                </div>
              )}
              {poet.data.featured && (
                <div class="absolute top-4 right-4 bg-yellow-400 text-yellow-900 px-3 py-1 rounded-full text-sm font-semibold z-10">
                  Featured
                </div>
              )}
            </div>
            <div class="p-6 flex flex-col flex-grow">
              <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-indigo-600 transition-colors line-clamp-1">
                {poet.data.title}
              </h3>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2 flex-grow">{poet.data.description}</p>
              <div class="mt-auto">
                <div class="flex flex-col space-y-3">
                  <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-500 truncate">
                      {poet.data.age && `${poet.data.age} years`} {poet.data.age && poet.data.nationality && '•'} {poet.data.nationality}
                    </span>
                    {(poet.data.groupName || poet.data.currentStatus) && (
                      <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 flex-shrink-0 ml-2">
                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        {poet.data.groupName || poet.data.currentStatus}
                      </span>
                    )}
                  </div>
                  <div class="flex justify-end">
                    <span class="text-indigo-600 font-semibold text-sm group-hover:translate-x-1 transition-transform">
                      View Profile →
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Pagination -->
      {poetProfiles.length > 6 && (
        <div class="mt-12 flex justify-center">
          <div class="flex items-center space-x-2">
            <a href="/poets" 
               class="px-4 py-2 text-sm font-medium text-indigo-600 bg-white border border-indigo-300 rounded-md hover:bg-indigo-50">
              1
            </a>
            {poetProfiles.length > 6 && (
              <a href="/poets/2" 
                 class="px-4 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                2
              </a>
            )}
            {poetProfiles.length > 12 && (
              <a href="/poets/3" 
                 class="px-4 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                3
              </a>
            )}
            {poetProfiles.length > 18 && (
              <a href="/poets/4" 
                 class="px-4 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                4
              </a>
            )}
            {poetProfiles.length > 6 && (
              <a href="/poets/2" 
                 class="px-4 py-2 text-sm font-medium text-gray-500 bg-white border border-gray-300 rounded-md hover:bg-gray-50">
                Next →
              </a>
            )}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Community Impact Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Poetry as Community Voice</h2>
        <p class="text-lg text-gray-600 max-w-3xl mx-auto">
          Our poets not only entertain but also give voice to the community, preserve stories, and create opportunities for cultural expression.
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="bg-indigo-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Community Voice</h3>
          <p class="text-gray-600">Giving voice to the stories and experiences of our community through poetry.</p>
        </div>
        
        <div class="text-center">
          <div class="bg-indigo-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Cultural Expression</h3>
          <p class="text-gray-600">Preserving and sharing cultural heritage through spoken word and written poetry.</p>
        </div>
        
        <div class="text-center">
          <div class="bg-indigo-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">Emotional Healing</h3>
          <p class="text-gray-600">Using poetry as a tool for healing, expression, and community connection.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="py-16 bg-indigo-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Support Our Poetry Community</h2>
      <p class="text-xl text-indigo-100 mb-8 max-w-2xl mx-auto">
        Whether you want to book a poetry reading, join our literary community, or support our poets, 
        there are many ways to get involved.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" 
           class="inline-flex items-center justify-center px-8 py-4 rounded-lg text-indigo-900 bg-white hover:bg-gray-50 transition-colors font-semibold text-lg">
          Book a Reading
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
        <a href="/poets/submit" 
           class="inline-flex items-center justify-center px-8 py-4 rounded-lg text-white border-2 border-white hover:bg-white hover:text-indigo-900 transition-colors font-semibold text-lg">
          Add Your Profile
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</MainLayout>

<style>
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.line-clamp-1 {
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
</style>
