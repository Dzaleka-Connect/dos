---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';

const pageTitle = 'Connecting Dzaleka: Wi-Fi & Connectivity Proposal for 2027 | services.dzaleka.com';
const pageDescription =
  'Through Connecting Dzaleka, we are planning better mobile, broadband, and free public Wi-Fi connectivity to help refugee communities and local businesses thrive.';
const canonicalUrl = 'https://services.dzaleka.com/connecting-dzaleka';
const pageKeywords =
  'Connecting Dzaleka, Wi-Fi Dzaleka, refugee camp internet, Starlink satellite Malawi, digital inclusion, refugee connectivity benchmarks';

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects' },
  { label: 'Connecting Dzaleka', href: '/connecting-dzaleka' },
];

const wifiLocations = [
  { name: 'Kawale 2 Market Spine', desc: 'Central commercial district candidate site for local traders, enterprises, and visitors.' },
  { name: 'Dzaleka Youth Tech Hub', desc: 'Educational hub candidate site supporting distance learning, coding, and digital skills.' },
  { name: 'Main Gate & Health Perimeter', desc: 'Clinic administration and emergency hotline coordination desk candidate site.' },
  { name: 'Katubiza Community Center', desc: 'Residential extension zone gathering space and community information point.' },
];

const benchmarks = [
  {
    camp: 'Nakivale Refugee Settlement (Uganda)',
    initiative: 'Community Technology Access (CTA) & CAMPUS Hub',
    learnings: 'Demonstrated that zero-rating local services while offering low-cost micro-passes for general web access makes community Wi-Fi 100% self-sustaining after setup.',
  },
  {
    camp: 'Bidi Bidi Refugee Settlement (Uganda)',
    initiative: 'Solar Hello Hubs (Hello World & UNHCR)',
    learnings: 'Showed the necessity of solar battery backup stations and training refugee youth as Network Stewards to maintain outdoor Wi-Fi hardware locally.',
  },
  {
    camp: 'Kakuma Refugee Camp (Kenya)',
    initiative: 'Giga Network (UNICEF & ITU)',
    learnings: 'Proved the high social impact of prioritizing zero-rated educational tools, maps, and civic portals for refugee students.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentService',
  name: 'Connecting Dzaleka',
  description: pageDescription,
  url: canonicalUrl,
  provider: {
    '@type': 'Organization',
    name: 'Dzaleka Online Services',
    url: 'https://services.dzaleka.com',
  },
};
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  image="/images/dzaleka-hero.jpeg"
  structuredData={structuredData}
>
  <div class="bg-white min-h-screen text-slate-900 pb-20">

    {/* Vic.gov Page Header */}
    <header class="border-b border-slate-200 bg-slate-50 py-8 md:py-12">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <Breadcrumb items={breadcrumbItems} />

        <div class="mt-4">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-950">
            Connecting Dzaleka
          </h1>
          <p class="mt-4 text-lg sm:text-xl text-slate-600 leading-relaxed font-normal">
            By 2027, connectivity in Dzaleka could look very different. Connecting Dzaleka is a proposed digital infrastructure initiative seeking partners, technology sponsors, and grant funding to bring high-speed Wi-Fi and zero-rated community services to Dzaleka Refugee Camp.
          </p>
        </div>
      </div>
    </header>

    {/* Body Content */}
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

      {/* On This Page Navigation */}
      <nav class="p-6 rounded border border-slate-200 bg-slate-50 mb-10" aria-label="On this page">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700 mb-3">On this page</h2>
        <ul class="space-y-2 text-sm text-sky-800 font-medium">
          <li><a href="#how-we-are-improving" class="hover:underline">1. Proposed Connectivity Framework for 2027</a></li>
          <li><a href="#free-public-wifi" class="hover:underline">2. Proposed Free Public Wi-Fi Candidate Sites</a></li>
          <li><a href="#international-benchmarks" class="hover:underline">3. International Refugee Camp Benchmarks</a></li>
          <li><a href="#how-we-selected-places" class="hover:underline">4. How we selected candidate places</a></li>
          <li><a href="#role-of-partners" class="hover:underline">5. The role of international partners and UNHCR</a></li>
          <li><a href="#find-a-project" class="hover:underline">6. Find a project & Inquiry</a></li>
        </ul>
      </nav>

      <div class="space-y-12 text-slate-800 text-base leading-relaxed">

        {/* Section 1: Proposed Connectivity Framework */}
        <section id="how-we-are-improving" class="scroll-mt-8 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-950 border-b border-slate-200 pb-3">
            Proposed Connectivity Framework for 2027
          </h2>
          <p>
            Connecting Dzaleka is a planned proposal to fast-track better mobile, satellite, and broadband connectivity. This project aims to transform how residents study, work, and keep in touch with loved ones.
          </p>
          <p>
            We are actively seeking grant funding and co-investment partnerships with telecommunications providers, humanitarian innovation funds, and technology sponsors to:
          </p>

          <ul class="list-disc list-outside ml-6 space-y-2 text-slate-800">
            <li>create community-grade high-speed broadband zones</li>
            <li>give more residents and students access to Starlink satellite internet</li>
            <li>increase Wi-Fi coverage across commercial and educational sectors</li>
            <li>equip key locations with solar battery backups for 24/7 power resilience</li>
            <li>bring zero-rated public Wi-Fi access to essential community services</li>
            <li>improve access to emergency safety information and health desks.</li>
          </ul>
        </section>

        {/* Section 2: Free public wi-fi candidate sites */}
        <section id="free-public-wifi" class="scroll-mt-8 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-950 border-b border-slate-200 pb-3">
            Proposed Free Public Wi-Fi Candidate Sites
          </h2>
          <p>
            Free public Wi-Fi is essential for digital inclusion. It helps bridge the gap for residents who do not have affordable internet access. Under the 2027 proposal, we are evaluating initial candidate sites for co-funded Wi-Fi hotspot deployment:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 my-6">
            {wifiLocations.map((loc) => (
              <div key={loc.name} class="p-4 rounded border border-slate-200 bg-slate-50/50">
                <h3 class="font-bold text-slate-950 text-base">{loc.name}</h3>
                <p class="text-xs text-slate-600 mt-1 leading-relaxed">{loc.desc}</p>
              </div>
            ))}
          </div>
        </section>

        {/* Section 3: International Benchmarks */}
        <section id="international-benchmarks" class="scroll-mt-8 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-950 border-b border-slate-200 pb-3">
            International Refugee Camp Benchmarks
          </h2>
          <p>
            Connecting Dzaleka draws on proven digital inclusion models successfully deployed across major refugee settlements globally:
          </p>

          <div class="space-y-4 my-6">
            {benchmarks.map((bm) => (
              <div key={bm.camp} class="p-5 rounded border border-slate-200 bg-white">
                <h3 class="font-bold text-slate-950 text-base">{bm.camp}</h3>
                <p class="text-xs font-semibold text-sky-800 mt-0.5">{bm.initiative}</p>
                <p class="text-xs text-slate-600 mt-2 leading-relaxed">{bm.learnings}</p>
              </div>
            ))}
          </div>
        </section>

        {/* Section 4: How we selected candidate places */}
        <section id="how-we-selected-places" class="scroll-mt-8 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-950 border-b border-slate-200 pb-3">
            How we selected candidate places for projects
          </h2>
          <p>
            We selected candidate project locations by listening to community members and local enterprise leaders.
          </p>
          <p>
            You told us where the connectivity gaps were, and where we could make the biggest difference. We looked at how we can support communities to work, study and keep in touch with loved ones, and how we can help local enterprises to grow and thrive.
          </p>
        </section>

        {/* Section 5: The role of international partners */}
        <section id="role-of-partners" class="scroll-mt-8 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-950 border-b border-slate-200 pb-3">
            The role of international partners and UNHCR
          </h2>
          <p>
            We have always and will continue to advocate for new and upgraded telecommunications infrastructure.
          </p>
          <p>
            International partners, grant makers, and humanitarian agencies have a key role in ensuring that connectivity services are adequate. The Connecting Dzaleka proposal seeks co-investment to build community telecommunications infrastructure to fill coverage gaps.
          </p>
        </section>

        {/* Section 6: Find a project & Inquiry */}
        <section id="find-a-project" class="scroll-mt-8 space-y-4">
          <div class="p-6 rounded border border-slate-200 bg-slate-50 space-y-3">
            <h2 class="text-xl font-bold text-slate-950">Partner or Fund Connecting Dzaleka</h2>
            <p class="text-sm text-slate-600">
              We welcome inquiries from grant foundations, UNHCR Innovation Service, GSMA, technology sponsors, and telecommunications providers to co-fund or pilot the 2027 connectivity framework.
            </p>
            <div class="pt-2 flex flex-wrap gap-3">
              <a
                href="mailto:dzalekaconnect@gmail.com?subject=Connecting%20Dzaleka%20Partnership%20Inquiry"
                class="px-5 py-2.5 rounded bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs transition-colors"
              >
                Inquire for Partnership →
              </a>
              <a
                href="/map"
                class="px-5 py-2.5 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-800 font-semibold text-xs transition-colors"
              >
                Open Map Dashboard
              </a>
            </div>
          </div>
        </section>

      </div>
    </div>
  </div>
</MainLayout>
