---
import CollectionHeader from '../components/ui/CollectionHeader.astro';
import MainLayout from '../layouts/MainLayout.astro';

const seo = {
  title: "Dzaleka Online Chrome Extension | Stay Connected to the Community",
  description: "Get real-time updates from Dzaleka Refugee Camp directly in your Chrome browser. Access news, events, services, jobs, and community resources with our comprehensive browser extension.",
  keywords: "Dzaleka Chrome extension, browser extension, refugee community, real-time news, community events, business directory, job opportunities, Dzaleka Online Services",
  canonical: "https://services.dzaleka.com/chrome-extension",
  openGraph: {
    title: "Dzaleka Online Chrome Extension | Stay Connected to the Community",
    description: "Get real-time updates from Dzaleka Refugee Camp directly in your Chrome browser. Access news, events, services, jobs, and community resources with our comprehensive browser extension.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/chrome-extension",
    images: [
      {
        url: "https://services.dzaleka.com/images/dzaleka-digital-heritage.png",
        width: 1200,
        height: 630,
        alt: "Dzaleka Online Chrome Extension"
      }
    ]
  },
  twitter: {
    card: "summary_large_image",
    site: "@dzalekaconnect",
    creator: "@dzalekaconnect",
    title: "Dzaleka Online Chrome Extension | Stay Connected to the Community",
    description: "Get real-time updates from Dzaleka Refugee Camp directly in your Chrome browser. Access news, events, services, jobs, and community resources with our comprehensive browser extension.",
    image: "https://services.dzaleka.com/images/dzaleka-digital-heritage.png"
  }
};

const features = [
  {
    icon: "newspaper",
    title: "Latest News",
    description: "Get real-time updates from the Dzaleka community with automatic notifications",
    details: "Stay informed with breaking news, community updates, and important announcements delivered directly to your browser."
  },
  {
    icon: "calendar",
    title: "Community Events",
    description: "Discover upcoming events, workshops, and cultural activities",
    details: "Never miss important community gatherings, educational workshops, cultural celebrations, or skill-building sessions."
  },
  {
    icon: "building",
    title: "Business Directory",
    description: "Find local businesses, services, and entrepreneurs",
    details: "Connect with Dzaleka's vibrant entrepreneurial community. Find tailors, tech services, food vendors, and more."
  },
  {
    icon: "book",
    title: "Resources",
    description: "Access educational materials, guides, and community resources",
    details: "Quick access to educational content, health information, legal resources, and community guides."
  },
  {
    icon: "briefcase",
    title: "Job Opportunities",
    description: "Browse available jobs and employment opportunities",
    details: "Find employment opportunities within the camp and surrounding areas, with real-time job postings and updates."
  },
  {
    icon: "users",
    title: "Community Hub",
    description: "Connect with community members through photos and skills exchange",
    details: "View community photos, share skills, and connect with fellow residents through our integrated community platform."
  },
  {
    icon: "heart",
    title: "Fundraising",
    description: "Support community projects and initiatives",
    details: "Contribute to community development projects, emergency funds, and local initiatives directly through the extension."
  },
  {
    icon: "search",
    title: "Smart Search",
    description: "Search across all community content with our advanced search feature",
    details: "Powerful search functionality to find specific information across news, events, services, and community resources."
  },
  {
    icon: "moon",
    title: "Dark Mode",
    description: "Comfortable viewing with light and dark theme options",
    details: "Customize your viewing experience with light and dark themes for comfortable browsing at any time of day."
  },
  {
    icon: "settings",
    title: "Customizable",
    description: "Adjust refresh intervals, font sizes, and display preferences",
    details: "Personalize your experience with customizable settings for notifications, display options, and content preferences."
  }
];

const installationSteps = [
  {
    step: 1,
    title: "Visit Chrome Web Store",
    description: "Open the extension’s Chrome Web Store listing using the link above.",
    icon: "shopping-cart"
  },
  {
    step: 2,
    title: "Install Extension",
    description: "Select 'Add to Chrome' on the Chrome Web Store page",
    icon: "plus"
  },
  {
    step: 3,
    title: "Confirm Installation",
    description: "Confirm the installation when prompted by Chrome",
    icon: "check"
  },
  {
    step: 4,
    title: "Start Using",
    description: "The extension will appear in your toolbar. Select to access Dzaleka community content!",
    icon: "play"
  }
];
---

<MainLayout title={seo.title} description={seo.description} canonical={seo.canonical} keywords={seo.keywords} image={seo.openGraph.images[0].url}>
  <CollectionHeader title="Dzaleka Online for Chrome" description="Access community news, events, services and resources from your browser toolbar." action={{ label: 'View in Chrome Web Store', href: 'https://chromewebstore.google.com/detail/dzaleka-online/kkjdcpkllgckmklggmibeemoolnihdbc' }} />
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-8 sm:px-6 lg:grid-cols-[minmax(0,1fr)_20rem] lg:px-8">
    <section id="features"><h2 class="text-primary-900">What you can access</h2><dl class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2">{features.map(feature => <div class="border-t border-slate-200 pt-4"><dt class="text-lg font-semibold text-primary-900">{feature.title}</dt><dd class="mt-2 text-sm leading-6 text-slate-700">{feature.description}</dd></div>)}</dl></section>
    <aside id="install" class="border-t-2 border-primary-900 pt-5"><h2 class="text-xl text-primary-900">Install the extension</h2><ol class="mt-5 list-decimal space-y-5 pl-5 text-sm leading-6 text-slate-700">{installationSteps.map(step => <li class="pl-1"><strong class="block font-semibold text-slate-900">{step.title}</strong>{step.description}</li>)}</ol><p class="mt-6 text-sm leading-6 text-slate-600">Check the Chrome Web Store listing for current browser requirements and the permissions requested during installation.</p><a href="/privacy" class="mt-2 inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">Privacy policy →</a></aside>
    <section class="border-t border-slate-200 pt-6"><h2 class="text-primary-900">Questions and support</h2><details class="mt-5 border-b border-slate-200 py-2"><summary class="min-h-[44px] cursor-pointer py-3 font-medium text-primary-900">Is the extension free?</summary><p class="pb-4 text-sm leading-6 text-slate-700">Dzaleka Online is free to install and use as a community service.</p></details><details class="border-b border-slate-200 py-2"><summary class="min-h-[44px] cursor-pointer py-3 font-medium text-primary-900">Can I change notifications and display settings?</summary><p class="pb-4 text-sm leading-6 text-slate-700">Open the extension’s settings to choose notification preferences, refresh intervals and its light or dark theme.</p></details><p class="mt-6 text-sm leading-6 text-slate-700">For help with the extension, email <a href="mailto:dzalekaconnect@gmail.com" class="break-all text-primary-800 underline underline-offset-4">dzalekaconnect@gmail.com</a>.</p></section>
  </div>
</MainLayout>
