---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

// Get staff announcements
let announcements = [];
let events = [];

try {
  announcements = await getCollection('announcements') || [];
  events = await getCollection('events') || [];
} catch (error) {
  console.error('Error fetching collections:', error);
}

const sortedAnnouncements = announcements.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
).slice(0, 5);

const upcomingEvents = events
  .filter(event => new Date(event.data.date) > new Date())
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
  .slice(0, 5);

// Fetch all content from collections
const allNews = await getCollection('news');
const allEvents = await getCollection('events');
const allServices = await getCollection('services');
const allJobs = await getCollection('jobs');

// Sort all content by date
const sortedNews = allNews.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const sortedEvents = allEvents.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const sortedServices = allServices.sort((a, b) => new Date(b.data.lastUpdated || b.data.date).getTime() - new Date(a.data.lastUpdated || a.data.date).getTime());
const sortedJobs = allJobs.sort((a, b) => new Date(b.data.posted).getTime() - new Date(a.data.posted).getTime());

// Get recent items for the dashboard
const recentNews = sortedNews.slice(0, 3);
const recentEvents = sortedEvents.slice(0, 3);
const recentServices = sortedServices.slice(0, 3);
const recentJobs = sortedJobs.slice(0, 3);

// Fetch recent announcements
const recentAnnouncements = allNews
  .filter(entry => entry.data.category === 'announcement')
  .sort((a, b) => new Date(b.data.date) - new Date(a.data.date))
  .slice(0, 3);

// Format date for display
function formatDate(dateValue) {
  if (!dateValue) return 'Date not available';
  try {
    const date = new Date(dateValue);
    if (isNaN(date.getTime())) return 'Invalid date';
    return date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });
  } catch (error) {
    return 'Invalid date';
  }
}

// Get date for different content types
function getContentDate(content) {
  switch (content.collection) {
    case 'news':
      return content.data.date;
    case 'events':
      return content.data.date;
    case 'services':
      return content.data.lastUpdated || content.data.date;
    case 'jobs':
      return content.data.posted;
    default:
      return null;
  }
}

// Get current date for welcome message
const currentDate = new Date().toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// SEO Metadata
const seo = {
  title: "Staff Portal",
  description: "Manage content, organize events, and support the Dzaleka community through our comprehensive staff portal. Access resources, training materials, and community tools.",
  canonicalURL: new URL(Astro.url.pathname, Astro.site),
  openGraph: {
    basic: {
      title: "Staff Portal - Dzaleka Online Services",
      type: "website",
      image: "https://www.unhcr.org/us/sites/en-us/files/styles/landscape_10/public/2023-05/RF1285791.webp?h=46391c37&itok=OncxYJVH&t=1684919018",
    },
    optional: {
      description: "Manage content, organize events, and support the Dzaleka community through our comprehensive staff portal.",
      siteName: "Dzaleka Online Services",
    },
    image: {
      alt: "Dzaleka Refugee Camp Staff Portal",
    },
  },
  twitter: {
    card: "summary_large_image",
    site: "@dzalekaconnect",
    creator: "@dzalekaconnect",
    title: "Staff Portal - Dzaleka Online Services",
    description: "Manage content, organize events, and support the Dzaleka community through our comprehensive staff portal.",
    image: "https://www.unhcr.org/us/sites/en-us/files/styles/landscape_10/public/2023-05/RF1285791.webp?h=46391c37&itok=OncxYJVH&t=1684919018",
    imageAlt: "Dzaleka Refugee Camp Staff Portal",
  },
  robots: {
    index: false,
    follow: true,
  },
};

---

<MainLayout title={seo.title} description={seo.description}>
  <!-- SEO Meta Tags -->
  <head>
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={seo.canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={seo.openGraph.basic.type} />
    <meta property="og:url" content={seo.canonicalURL} />
    <meta property="og:title" content={seo.openGraph.basic.title} />
    <meta property="og:description" content={seo.openGraph.optional.description} />
    <meta property="og:image" content={seo.openGraph.basic.image} />
    <meta property="og:image:alt" content={seo.openGraph.image.alt} />
    <meta property="og:site_name" content={seo.openGraph.optional.siteName} />

    <!-- Twitter -->
    <meta name="twitter:card" content={seo.twitter.card} />
    <meta name="twitter:site" content={seo.twitter.site} />
    <meta name="twitter:creator" content={seo.twitter.creator} />
    <meta name="twitter:title" content={seo.twitter.title} />
    <meta name="twitter:description" content={seo.twitter.description} />
    <meta name="twitter:image" content={seo.twitter.image} />
    <meta name="twitter:image:alt" content={seo.twitter.imageAlt} />

    <!-- Robots -->
    <meta name="robots" content={`${seo.robots.index ? 'index' : 'noindex'},${seo.robots.follow ? 'follow' : 'nofollow'}`} />

    <!-- Additional Meta Tags -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="language" content="English" />
    <meta name="author" content="Dzaleka Online Services" />
    <meta name="revisit-after" content="7 days" />
  </head>

  <main class="min-h-screen bg-gray-50">
    <!-- Hero Section with Background Image -->
    <div class="relative bg-gray-900">
      <!-- Background Image -->
      <div class="absolute inset-0">
        <img
          src="https://www.unhcr.org/us/sites/en-us/files/styles/landscape_10/public/2023-05/RF1285791.webp?h=46391c37&itok=OncxYJVH&t=1684919018"
          alt="Staff Portal Background"
          class="w-full h-full object-cover opacity-50"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-gray-900 to-gray-900/70"></div>
      </div>
      
      <!-- Hero Content -->
      <div class="relative container mx-auto px-4 py-16 sm:py-24">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">
            Welcome to the Staff Portal
          </h1>
          <p class="text-xl text-gray-200 mb-8">
            Manage content, organize events, and support the Dzaleka community
          </p>
          
          <!-- Search Bar -->
          <form action="/search/results" method="GET" class="w-full max-w-2xl mx-auto mb-12" class="relative">
            <div class="relative">
              <input
                type="search"
                name="q"
                placeholder="Search news, events, services..."
                class="w-full px-6 py-4 text-lg bg-white/10 backdrop-blur-sm border border-white/20 rounded-full text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-white/50"
              />
              <button
                type="submit"
                class="absolute right-2 top-1/2 -translate-y-1/2 p-2 text-white hover:text-primary-200 focus:outline-none focus:ring-2 focus:ring-white/50 rounded-full"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </button>
            </div>
          </form>

          <!-- Quick Links -->
          <div class="flex flex-wrap justify-center gap-4 mt-8">
            <a href="/staff/onboarding" class="inline-flex items-center justify-center px-6 py-3 bg-white/10 backdrop-blur-sm rounded-full text-white hover:bg-white/20 transition-colors">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
