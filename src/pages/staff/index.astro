---
import { getNews } from '@dos/news';
import { getContent } from '../../lib/content';
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import { getCollection } from "astro:content";
const [news, events, services, jobs] = await Promise.all([
  getNews(),
  getContent('events'),
  getContent('services'),
  getContent('jobs'),
]);
const recentNews = [...news]
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 5);
const upcoming = events
  .filter(
    (event) =>
      new Date(event.data.endDate || event.data.date).getTime() >= Date.now(),
  )
  .sort(
    (a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime(),
  )
  .slice(0, 4);
const formatDate = (value: Date | string) =>
  new Date(value).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
const tasks = [
  {
    title: "Write a news post",
    description: "Open the Dzaleka news editor in Blogger.",
    href: "https://draft.blogger.com/u/0/blog/posts/415814352087212165",
  },
  {
    title: "Organise an event",
    description: "Add the date, venue and event details.",
    href: "/events/organize",
  },
  {
    title: "Register a service",
    description: "Create an organisation or service listing.",
    href: "/services/register",
  },
  {
    title: "Post a job",
    description: "Submit a vacancy to the jobs board.",
    href: "/jobs/post",
  },
  {
    title: "Share a resource",
    description: "Submit a document, guide or report.",
    href: "/resources/submit",
  },
  {
    title: "Correct a service listing",
    description: "Send updated contacts or service information.",
    href: "/services/update-request",
  },
];
const description =
  "Publishing shortcuts, content totals, recent posts and training resources for Dzaleka Online Services contributors.";
---

<MainLayout
  title="Staff portal"
  description={description}
  canonical="https://services.dzaleka.com/staff"
  robots="noindex, follow"
  showFeedback={false}
>
  <section class="bg-slate-900 text-white">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <Breadcrumb
        light
        items={[{ label: "Home", href: "/" }, { label: "Staff portal" }]}
      />
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-slate-300">
            Contributor workspace
          </p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight">Staff portal</h1>
          <p class="mt-3 max-w-2xl text-lg leading-8 text-slate-300">
            Publishing tools, site content and guidance for contributors.
          </p>
        </div>
        <a
          href="/staff/onboarding"
          class="inline-flex min-h-[44px] items-center rounded bg-white px-5 py-3 font-semibold text-slate-900 hover:bg-slate-100"
        >
          New contributor? Start here →
        </a>
      </div>
    </div>
  </section>
  <div class="mx-auto max-w-7xl px-4 py-9 sm:px-6 lg:px-8">
    <section aria-labelledby="content-heading">
      <h2
        id="content-heading"
        class="text-sm font-semibold uppercase tracking-widest text-slate-500"
      >
        Published site content
      </h2>
      <dl class="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
        {[
          ["News posts", news.length, "/news"],
          ["Event listings", events.length, "/events"],
          ["Services", services.length, "/services"],
          ["Job listings", jobs.length, "/jobs"],
        ].map(([label, count, href]) => (
          <div class="rounded border border-slate-200 px-5 py-4">
            <dt class="text-sm text-slate-600">
              <a
                href={String(href)}
                class="text-primary-800 underline underline-offset-4"
              >
                {label}
              </a>
            </dt>
            <dd class="mt-2 text-3xl font-bold text-slate-900">{count}</dd>
          </div>
        ))}
      </dl>
    </section>
    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_300px]">
      <div>
        <section>
          <h2 class="text-2xl font-bold text-slate-900">Publish or update</h2>
          <div class="mt-5 grid gap-x-8 sm:grid-cols-2">
            {tasks.map((task) => (
              <article class="border-t border-slate-200 py-5">
                <h3 class="font-semibold">
                  <a
                    href={task.href}
                    class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4"
                  >
                    {task.title} →
                  </a>
                </h3>
                <p class="mt-1 text-sm leading-6 text-slate-600">
                  {task.description}
                </p>
              </article>
            ))}
          </div>
        </section>
        <section class="mt-8">
          <div class="flex items-center justify-between gap-4">
            <h2 class="text-2xl font-bold text-slate-900">Recent news posts</h2>
            <a
              href="/news"
              class="text-sm text-primary-800 underline underline-offset-4"
            >
              All news
            </a>
          </div>
          <ul class="mt-4 divide-y divide-slate-200 border-y border-slate-200">
            {recentNews.map((item) => (
              <li class="py-4">
                <time
                  datetime={new Date(item.data.date).toISOString()}
                  class="text-xs text-slate-500"
                >
                  {formatDate(item.data.date)}
                </time>
                <a
                  href={`/news/${item.id}`}
                  class="mt-1 block font-medium leading-7 text-primary-800 hover:underline"
                >
                  {item.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
        <section class="mt-8">
          <h2 class="text-2xl font-bold text-slate-900">Upcoming events</h2>
          {upcoming.length ? (
            <ul class="mt-4 divide-y divide-slate-200">
              {upcoming.map((event) => (
                <li class="py-4">
                  <p class="text-sm text-slate-500">
                    {formatDate(event.data.date)}
                  </p>
                  <a
                    href={`/events/${event.id}`}
                    class="mt-1 block font-medium text-primary-800 underline underline-offset-4"
                  >
                    {event.data.title}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 text-slate-600">No upcoming events are listed.</p>
          )}
        </section>
      </div>
      <aside class="space-y-6">
        <section class="rounded border border-slate-200 bg-slate-50 p-5">
          <h2 class="text-lg font-semibold text-slate-900">
            Contributor guidance
          </h2>
          <ul class="mt-3 divide-y divide-slate-200">
            {[
              ["Onboarding", "/staff/onboarding"],
              ["Contributing", "/staff/contributing"],
              ["Content guidelines", "/staff/guidelines"],
              ["Training", "/staff/training"],
              ["Staff FAQ", "/staff/faq"],
            ].map(([label, href]) => (
              <li>
                <a
                  href={href}
                  class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </section>
        <section class="border-t border-slate-200 pt-5">
          <h2 class="text-lg font-semibold text-slate-900">Files and tools</h2>
          <ul class="mt-3 space-y-3">
            <li>
              <a
                href="https://drive.google.com/drive/u/1/folders/1n1DCddBHQbNeNthMAUIBVd7eJYVxcdOG"
                class="text-primary-800 underline underline-offset-4"
              >
                Shared Google Drive folder
              </a>
            </li>
            <li>
              <a
                href="/dashboard"
                class="text-primary-800 underline underline-offset-4"
              >
                Content dashboard
              </a>
            </li>
            <li>
              <a
                href="/docs"
                class="text-primary-800 underline underline-offset-4"
              >
                Site documentation
              </a>
            </li>
            <li>
              <a
                href="/help-desk"
                class="text-primary-800 underline underline-offset-4"
              >
                Website help desk
              </a>
            </li>
          </ul>
        </section>
      </aside>
    </div>
  </div>
</MainLayout>
