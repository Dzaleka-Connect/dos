---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Training Materials - Staff Portal">
  <main class="min-h-screen bg-gray-50">
    <div class="bg-primary-600 text-white">
      <div class="container mx-auto px-4 py-12">
        <h1 class="text-3xl sm:text-4xl font-bold mb-4">Training Materials</h1>
        <p class="text-lg text-primary-100">Learn how to use Dzaleka Online Services platform effectively</p>
      </div>
    </div>

    <div class="container mx-auto px-4 py-8">
      <div class="max-w-4xl mx-auto">
        <!-- Content Management -->
        <section class="bg-white rounded-xl shadow-sm p-6 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Content Management</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <a href="/staff/onboarding" class="block p-6 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
              <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center mr-4">
                  <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900">News Publishing</h3>
              </div>
              <p class="text-gray-600">Learn how to publish and manage news articles on Blogger.com</p>
            </a>

            <a href="/staff/contributing" class="block p-6 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
              <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-pink-100 rounded-lg flex items-center justify-center mr-4">
                  <svg class="w-6 h-6 text-pink-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900">Event Management</h3>
              </div>
              <p class="text-gray-600">Create and manage community events and activities</p>
            </a>
          </div>
        </section>

        <!-- Forms and Features -->
        <section class="bg-white rounded-xl shadow-sm p-6 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Forms and Features</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-6 bg-gray-50 rounded-lg">
              <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
                  <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900">Service Directory</h3>
              </div>
              <ul class="space-y-2 text-gray-600">
                <li>• Add new services to the directory</li>
                <li>• Update service information</li>
                <li>• Manage service categories</li>
                <li>• Handle service verification</li>
              </ul>
            </div>

            <div class="p-6 bg-gray-50 rounded-lg">
              <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mr-4">
                  <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900">Job Listings</h3>
              </div>
              <ul class="space-y-2 text-gray-600">
                <li>• Post new job opportunities</li>
                <li>• Manage job applications</li>
                <li>• Update job status</li>
                <li>• Track application responses</li>
              </ul>
          </div>

            <div class="p-6 bg-gray-50 rounded-lg">
              <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mr-4">
                  <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900">Photo Gallery</h3>
              </div>
              <ul class="space-y-2 text-gray-600">
                <li>• Upload and organize photos</li>
                <li>• Add photo descriptions</li>
                <li>• Manage photo categories</li>
                <li>• Handle photo permissions</li>
              </ul>
            </div>

            <div class="p-6 bg-gray-50 rounded-lg">
              <div class="flex items-center mb-4">
                <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center mr-4">
                  <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900">Resource Library</h3>
              </div>
              <ul class="space-y-2 text-gray-600">
                <li>• Add educational resources</li>
                <li>• Organize resource categories</li>
                <li>• Manage resource access</li>
                <li>• Update resource information</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Project Structure -->
        <section class="bg-white rounded-xl shadow-sm p-6 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Project Structure</h2>
          <div class="prose prose-lg">
            <h3>Content Collections</h3>
            <ul>
              <li><code>src/content/news/</code> - News articles and announcements</li>
              <li><code>src/content/events/</code> - Community events and activities</li>
              <li><code>src/content/services/</code> - Service directory listings</li>
              <li><code>src/content/jobs/</code> - Job opportunities</li>
              <li><code>src/content/photos/</code> - Photo gallery images</li>
              <li><code>src/content/resources/</code> - Educational resources</li>
            </ul>

            <h3>Key Features</h3>
            <ul>
              <li>News publishing via Blogger.com integration</li>
              <li>Event management and calendar</li>
              <li>Service directory with search and filtering</li>
              <li>Job board with application tracking</li>
              <li>Photo gallery with categories</li>
              <li>Resource library with access control</li>
            </ul>
          </div>
        </section>

        <!-- Quick Guides -->
        <section class="bg-white rounded-xl shadow-sm p-6 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Quick Guides</h2>
          <div class="space-y-4">
            <a href="/docs" class="flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
              <svg class="w-5 h-5 text-gray-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span class="text-gray-900">Getting Started Guide</span>
            </a>
            <a href="/staff/contributing" class="flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
              <svg class="w-5 h-5 text-gray-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span class="text-gray-900">Content Guidelines</span>
            </a>
            <a href="/staff/faq" class="flex items-center p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
              <svg class="w-5 h-5 text-gray-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span class="text-gray-900">FAQ and Troubleshooting</span>
            </a>
          </div>
        </section>

        <!-- Support -->
        <section class="bg-white rounded-xl shadow-sm p-6">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Need Help?</h2>
          <div class="text-center">
            <p class="text-gray-600 mb-4">Can't find what you're looking for? Our support team is here to help.</p>
            <a href="/staff/help-desk" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700">
              Contact Support
            </a>
          </div>
        </section>
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .prose h3 {
    @apply text-lg font-medium text-gray-900 mb-2;
  }
  .prose p {
    @apply text-gray-600;
  }
  .prose ul {
    @apply list-disc pl-6 mb-4;
  }
  .prose ol {
    @apply list-decimal pl-6 mb-4;
  }
  .prose code {
    @apply bg-gray-100 px-2 py-1 rounded text-sm font-mono;
  }
</style> 