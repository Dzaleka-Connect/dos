---
import MainLayout from '../../../layouts/MainLayout.astro';

const seo = {
  title: "Create, Edit, and Manage Posts for Dzaleka.com - Staff Portal",
  description: "Learn how to create, edit, and manage posts effectively for Dzaleka.com using Google Blogger. Comprehensive guide for Dzaleka Online Services content creators.",
  canonicalURL: new URL(Astro.url.pathname, Astro.site),
  openGraph: {
    basic: {
      title: "Create, Edit, and Manage Posts for Dzaleka.com - Staff Portal",
      type: "article",
      image: "https://images.pexels.com/photos/2678468/pexels-photo-2678468.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2",
    },
    optional: {
      description: "Master post creation and management for Dzaleka.com using Google Blogger.",
      siteName: "Dzaleka Online Services",
    },
    image: {
      alt: "Dzaleka.com Post Management Guide",
    },
  },
  twitter: {
    card: "summary_large_image",
    site: "@dzalekaconnect",
    creator: "@dzalekaconnect",
    title: "Create, Edit, and Manage Posts for Dzaleka.com - Staff Portal",
    description: "Master post creation and management for Dzaleka.com using Google Blogger.",
    image: "https://images.pexels.com/photos/2678468/pexels-photo-2678468.jpeg?auto=compress&cs=tinysrgb&w=1260&h=750&dpr=2",
    imageAlt: "Dzaleka.com Post Management Guide",
  },
  robots: {
    index: true,
    follow: true,
  },
};
---

<MainLayout title={seo.title} description={seo.description}>
  <main class="min-h-screen bg-gray-50">
    <div class="bg-gray-900 text-white">
      <div class="container mx-auto px-4 py-12">
        <h1 class="text-3xl sm:text-4xl font-bold mb-4">Create, Edit, and Manage Posts for Dzaleka.com</h1>
        <p class="text-lg text-slate-100">Learn how to effectively create, edit, and manage content for Dzaleka.com using Google Blogger</p>
      </div>
    </div>

    <div class="container mx-auto px-4 py-8">
      <div class="max-w-4xl mx-auto">
        <!-- Author Access -->
        <section class="bg-white rounded-xl border border-gray-200 p-6 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Dzaleka.com Author Access and Permissions</h2>
          <div class="prose prose-lg">
            <h3>What Authors Can Do on Dzaleka.com</h3>
            <ul>
              <li>Create and publish new posts on Dzaleka.com</li>
              <li>Edit your own posts on the platform</li>
              <li>Schedule posts for future publication</li>
              <li>Add Dzaleka-specific labels (tags) to your posts</li>
              <li>Upload and manage images in your posts</li>
              <li>Enable/disable comments on your posts</li>
              <li>Set up email posting for your Dzaleka.com account</li>
              <li>Remove yourself as an author if needed</li>
            </ul>

            <h3>Author Limitations on Dzaleka.com</h3>
            <ul>
              <li>Cannot edit posts by other authors</li>
              <li>Cannot modify Dzaleka.com blog settings or template</li>
              <li>Cannot change Dzaleka.com URL, title, or description</li>
              <li>Cannot moderate comments globally</li>
              <li>Cannot edit Dzaleka.com pages</li>
              <li>Cannot view blog statistics</li>
              <li>Cannot install AdSense</li>
              <li>Cannot invite other authors</li>
            </ul>
          </div>
        </section>

        <!-- Creating Content -->
        <section class="bg-white rounded-xl border border-gray-200 p-6 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Creating and Managing Posts for Dzaleka.com</h2>
          <div class="prose prose-lg">
            <h3>Creating a New Post on Dzaleka.com</h3>
            <ol>
              <li>Sign in to Blogger with your Google account</li>
              <li>Select the Dzaleka.com blog</li>
              <li>Click "New Post" in the dashboard</li>
              <li>Use the rich text editor to create your content:
                <ul>
                  <li>Format text (bold, italic, headings)</li>
                  <li>Add links and images</li>
                  <li>Create lists and tables</li>
                  <li>Insert quotes and code blocks</li>
                </ul>
                <div class="mt-2">
                  <a href="#rich-text-editor" class="inline-flex items-center text-slate-700 hover:text-slate-700">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                    View detailed rich text editor guide
                  </a>
                </div>
              </li>
              <li>Add Dzaleka-specific labels for better organization</li>
              <li>Preview your post before publishing</li>
            </ol>

            <h3>Dzaleka.com Post Settings for Authors</h3>
            <ul>
              <li><strong>Schedule:</strong> Set future publication date and time</li>
              <li><strong>Labels:</strong> Add Dzaleka-specific tags for categorization</li>
              <li><strong>Location:</strong> Add Dzaleka camp location tags if relevant</li>
              <li><strong>Comments:</strong> Enable/disable comments for your post</li>
              <li><strong>Options:</strong> Set post URL and other preferences</li>
            </ul>
          </div>
        </section>

        <!-- Media Management -->
        <section class="bg-white rounded-xl border border-gray-200 p-6 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Media Management</h2>
          <div class="prose prose-lg">
            <h3>Adding Images</h3>
            <ul>
              <li>Click the image icon in the editor</li>
              <li>Upload from your computer or select from existing images</li>
              <li>Optimize images before uploading (recommended size: 1200x800px)</li>
              <li>Add descriptive alt text for accessibility</li>
              <li>Choose image alignment and size</li>
            </ul>

            <h3>Adding Videos</h3>
            <ul>
              <li>Click the video icon in the editor</li>
              <li>Upload a video or embed from YouTube</li>
              <li>Set video size and alignment</li>
              <li>Add a title and description</li>
            </ul>
          </div>
        </section>

        <!-- Best Practices -->
        <section class="bg-white rounded-xl border border-gray-200 p-6 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Author best practices</h2>
          <div class="prose prose-lg">
            <h3>Content Creation</h3>
            <ul>
              <li>Write clear, engaging headlines</li>
              <li>Use short paragraphs for readability</li>
              <li>Include relevant images and media</li>
              <li>Add internal links to related content</li>
              <li>Proofread before publishing</li>
            </ul>

            <h3>Organization</h3>
            <ul>
              <li>Use consistent labeling system</li>
              <li>Create descriptive post titles</li>
              <li>Maintain a content calendar</li>
              <li>Keep drafts for future posts</li>
              <li>Use the scheduling feature for regular posting</li>
            </ul>

            <h3>Engagement</h3>
            <ul>
              <li>Respond to comments on your posts</li>
              <li>Share your posts on social media</li>
              <li>Monitor post performance</li>
              <li>Update content when needed</li>
            </ul>
          </div>
        </section>

        <!-- Rich Text Editor -->
        <section id="rich-text-editor" class="bg-white rounded-xl border border-gray-200 p-6 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Using the Rich Text Editor</h2>
          <div class="prose prose-lg">
            <h3>Editor Interface</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-slate-700 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                  </svg>
                  <h4 class="font-medium">Toolbar</h4>
                </div>
                <p class="text-gray-600">Contains all formatting options and tools for styling your content</p>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>Text formatting buttons</li>
                  <li>Alignment options</li>
                  <li>List creation tools</li>
                  <li>Media insertion buttons</li>
                </ul>
              </div>

              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                  <h4 class="font-medium">Content Area</h4>
                </div>
                <p class="text-gray-600">The main writing space where you create and format your content</p>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>WYSIWYG editing</li>
                  <li>Real-time formatting</li>
                  <li>Drag and drop support</li>
                  <li>Auto-save feature</li>
                </ul>
              </div>

              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                  </svg>
                  <h4 class="font-medium">HTML View</h4>
                </div>
                <p class="text-gray-600">Toggle to edit raw HTML code for advanced customization</p>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>Direct HTML editing</li>
                  <li>Code syntax highlighting</li>
                  <li>Custom HTML insertion</li>
                  <li>Advanced formatting</li>
                </ul>
              </div>

              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                  <h4 class="font-medium">Preview</h4>
                </div>
                <p class="text-gray-600">See how your post will look when published</p>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>Live preview</li>
                  <li>Mobile view</li>
                  <li>Desktop view</li>
                  <li>Responsive check</li>
                </ul>
              </div>
            </div>

            <h3>Text formatting options</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/>
                  </svg>
                  <h4 class="font-medium">Headings</h4>
                </div>
                <p class="text-gray-600">Use different heading levels for content hierarchy</p>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>H1 - Main title</li>
                  <li>H2 - Section headers</li>
                  <li>H3 - Subsection headers</li>
                </ul>
              </div>

              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                  </svg>
                  <h4 class="font-medium">Text Style</h4>
                </div>
                <p class="text-gray-600">Format your text with various styles</p>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>Bold (Ctrl/Cmd + B)</li>
                  <li>Italic (Ctrl/Cmd + I)</li>
                  <li>Underline (Ctrl/Cmd + U)</li>
                  <li>Strikethrough</li>
                </ul>
              </div>
            </div>

            <h3>Advanced Formatting</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-slate-700 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                  </svg>
                  <h4 class="font-medium">Links</h4>
                </div>
                <p class="text-gray-600">Add and manage hyperlinks</p>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>External website links</li>
                  <li>Internal blog post links</li>
                  <li>Email links</li>
                  <li>Open in new tab option</li>
                </ul>
              </div>

              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  <h4 class="font-medium">Images</h4>
                </div>
                <p class="text-gray-600">Insert and format images</p>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>Upload from computer</li>
                  <li>Add from web URL</li>
                  <li>Resize and align</li>
                  <li>Add alt text</li>
                </ul>
              </div>

              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                  </svg>
                  <h4 class="font-medium">Tables</h4>
                </div>
                <p class="text-gray-600">Create and format tables</p>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>Add/remove rows/columns</li>
                  <li>Merge/split cells</li>
                  <li>Set table properties</li>
                  <li>Style table borders</li>
                </ul>
              </div>
            </div>

            <h3>Special Features</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                  </svg>
                  <h4 class="font-medium">HTML Mode</h4>
                </div>
                <p class="text-gray-600">Advanced code editing features</p>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>Direct HTML editing</li>
                  <li>Syntax highlighting</li>
                  <li>Custom code insertion</li>
                  <li>Advanced formatting</li>
                </ul>
              </div>

              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"/>
                  </svg>
                  <h4 class="font-medium">Paste Options</h4>
                </div>
                <p class="text-gray-600">Control content formatting</p>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>Paste as plain text</li>
                  <li>Keep formatting</li>
                  <li>Remove formatting</li>
                  <li>Clean up HTML</li>
                </ul>
              </div>
            </div>

            <h3>Best Practices</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <h4 class="font-medium">Content Structure</h4>
                </div>
                <p class="text-gray-600">Organize your content effectively</p>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>Use consistent headings</li>
                  <li>Keep formatting simple</li>
                  <li>Preview before publishing</li>
                  <li>Check mobile view</li>
                </ul>
              </div>

              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-slate-700 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                  </svg>
                  <h4 class="font-medium">Optimization</h4>
                </div>
                <p class="text-gray-600">Optimize your content</p>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>Optimize images</li>
                  <li>Clean up formatting</li>
                  <li>Use tables appropriately</li>
                  <li>Check loading speed</li>
                </ul>
              </div>
            </div>

            <h3>Keyboard Shortcuts</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                  </svg>
                  <h4 class="font-medium">Formatting Shortcuts</h4>
                </div>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>Ctrl/Cmd + B: Bold</li>
                  <li>Ctrl/Cmd + I: Italic</li>
                  <li>Ctrl/Cmd + U: Underline</li>
                  <li>Ctrl/Cmd + K: Insert link</li>
                </ul>
              </div>

              <div class="bg-gray-50 p-4 rounded-lg">
                <div class="flex items-center mb-3">
                  <svg class="w-6 h-6 text-gray-600 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/>
                  </svg>
                  <h4 class="font-medium">Navigation Shortcuts</h4>
                </div>
                <ul class="mt-2 text-sm text-gray-500">
                  <li>Ctrl/Cmd + Z: Undo</li>
                  <li>Ctrl/Cmd + Y: Redo</li>
                  <li>Ctrl/Cmd + F: Find</li>
                  <li>Ctrl/Cmd + S: Save</li>
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- Resources -->
        <section class="bg-white rounded-xl border border-gray-200 p-6">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Additional Resources</h2>
          <div class="prose prose-lg">
            <h3>Dzaleka.com Resources</h3>
            <ul>
              <li><a href="/staff/guidelines" class="text-slate-700 hover:text-slate-700">Dzaleka.com Content Guidelines</a></li>
              <li><a href="/staff/faq" class="text-slate-700 hover:text-slate-700">Dzaleka.com FAQ and Troubleshooting</a></li>
              <li><a href="/staff/contributing" class="text-slate-700 hover:text-slate-700">Dzaleka.com Contributing Guidelines</a></li>
              <li><a href="/staff/training" class="text-slate-700 hover:text-slate-700">Dzaleka.com Training Resources</a></li>
            </ul>

            <h3>Official Documentation</h3>
            <ul>
              <li><a href="https://support.google.com/blogger" target="_blank" rel="noopener noreferrer" class="text-slate-700 hover:text-slate-700">Official Blogger Help Center</a></li>
              <li><a href="https://support.google.com/blogger/answer/154172?hl=en&ref_topic=3339243&sjid=6116235680583910115-NC" target="_blank" rel="noopener noreferrer" class="text-slate-700 hover:text-slate-700">Blogger Post Editor Guide</a></li>
              <li><a href="https://support.google.com/blogger/answer/41641?hl=en&ref_topic=3339243&sjid=6116235680583910115-NC" target="_blank" rel="noopener noreferrer" class="text-slate-700 hover:text-slate-700">Blogger Media Management</a></li>
              <li><a href="https://support.google.com/blogger/?visit_id=638848549877886675-3670382006&rd=1#topic=6321959" target="_blank" rel="noopener noreferrer" class="text-slate-700 hover:text-slate-700">Blogger Post Settings</a></li>
            </ul>

            <h3>Useful Tools for Dzaleka.com</h3>
            <ul>
              <li><a href="https://www.google.com/webmasters/tools/home" target="_blank" rel="noopener noreferrer" class="text-slate-700 hover:text-slate-700">Google Search Console</a> - Monitor Dzaleka.com's search performance</li>
              <li><a href="https://analytics.google.com" target="_blank" rel="noopener noreferrer" class="text-slate-700 hover:text-slate-700">Google Analytics</a> - Track Dzaleka.com traffic and engagement</li>
              <li><a href="https://www.google.com/alerts" target="_blank" rel="noopener noreferrer" class="text-slate-700 hover:text-slate-700">Google Alerts</a> - Monitor Dzaleka camp mentions</li>
              <li><a href="https://www.google.com/trends" target="_blank" rel="noopener noreferrer" class="text-slate-700 hover:text-slate-700">Google Trends</a> - Research Dzaleka-related topics</li>
            </ul>

