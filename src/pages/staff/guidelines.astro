---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Content Guidelines - Staff Portal">
  <div class="min-h-screen bg-white">
    <div class="border-b border-slate-200 bg-slate-50 text-slate-900">
      <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-10">
        <h1 class="text-3xl sm:text-4xl font-bold mb-4">Content Guidelines</h1>
        <p class="text-base leading-7 text-slate-600">Best practices for creating and publishing content</p>
      </div>
    </div>

    <div class="container mx-auto px-4 py-8">
      <div class="max-w-4xl mx-auto">
        <!-- Writing Guidelines -->
        <section class="border-b border-slate-200 pb-8 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Writing Guidelines</h2>
          <div class="prose prose-lg">
            <h3>General Principles</h3>
            <ul>
              <li>Write in clear, simple language that's easy to understand</li>
              <li>Use active voice and present tense when possible</li>
              <li>Keep paragraphs short and focused</li>
              <li>Include relevant images and media</li>
              <li>Fact-check all information before publishing</li>
            </ul>

            <h3>Content Structure</h3>
            <ul>
              <li>Start with a compelling headline</li>
              <li>Include a brief introduction</li>
              <li>Use subheadings to organize content</li>
              <li>End with a clear conclusion or call to action</li>
            </ul>
          </div>
        </section>

        <!-- SEO Guidelines -->
        <section class="border-b border-slate-200 pb-8 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">SEO Guidelines</h2>
          <div class="prose prose-lg">
            <h3>Meta Information</h3>
            <ul>
              <li>Write descriptive titles (50-60 characters)</li>
              <li>Create compelling meta descriptions (150-160 characters)</li>
              <li>Use relevant keywords naturally</li>
              <li>Include alt text for all images</li>
            </ul>

            <h3>Content Optimization</h3>
            <ul>
              <li>Use descriptive URLs</li>
              <li>Include internal and external links</li>
              <li>Optimize images for web</li>
              <li>Structure content with proper heading hierarchy</li>
            </ul>
          </div>
        </section>

        <!-- Media Guidelines -->
        <section class="border-b border-slate-200 pb-8 mb-8">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Media Guidelines</h2>
          <div class="prose prose-lg">
            <h3>Image Requirements</h3>
            <ul>
              <li>Use high-quality, relevant images</li>
              <li>Optimize images for web (compress when necessary)</li>
              <li>Include proper attribution</li>
              <li>Follow copyright guidelines</li>
            </ul>

            <h3>Video Guidelines</h3>
            <ul>
              <li>Keep videos concise and focused</li>
              <li>Include captions or transcripts</li>
              <li>Optimize for mobile viewing</li>
              <li>Use appropriate thumbnail images</li>
            </ul>
          </div>
        </section>

        <!-- Publishing Process -->
        <section class="bg-white rounded border border-gray-200 p-6">
          <h2 class="text-2xl font-semibold text-gray-900 mb-6">Publishing Process</h2>
          <div class="prose prose-lg">
            <h3>Before Publishing</h3>
            <ol>
              <li>Review content for accuracy</li>
              <li>Check spelling and grammar</li>
              <li>Verify all links work</li>
              <li>Ensure proper formatting</li>
              <li>Get necessary approvals</li>
            </ol>

            <h3>After Publishing</h3>
            <ol>
              <li>Share on social media</li>
              <li>Monitor engagement</li>
              <li>Respond to comments</li>
              <li>Update content as needed</li>
            </ol>
          </div>
        </section>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .prose ul {
    @apply list-disc pl-6 mb-4;
  }
  .prose ol {
    @apply list-decimal pl-6 mb-4;
  }
  .prose h3 {
    @apply text-xl font-semibold text-gray-900 mt-6 mb-4;
  }
</style>