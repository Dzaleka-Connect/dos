---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

export async function getStaticPaths() {
  const entries = await getCollection('encyclopedia');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allEntries = await getCollection('encyclopedia');
const relatedEntries = (entry.data.relatedEntries || [])
  .map((id) => allEntries.find((candidate) => candidate.id === id))
  .filter(Boolean);

const canonical = `https://services.dzaleka.com/encyclopedia/${entry.id}`;
const schemaType = entry.data.entryType === 'person'
  ? 'Person'
  : entry.data.entryType === 'place' || entry.data.entryType === 'overview'
    ? 'Place'
    : entry.data.entryType === 'organization'
      ? 'Organization'
      : 'Thing';
const reviewedDate = entry.data.lastReviewed.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<MainLayout
  title={`${entry.data.title} | Dzaleka Encyclopedia`}
  description={entry.data.summary}
  canonical={canonical}
  image={entry.data.image || '/images/dzaleka-hero.jpeg'}
  type="article"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: entry.data.title,
      description: entry.data.summary,
      image: entry.data.image ? `https://services.dzaleka.com${entry.data.image}` : undefined,
      dateModified: entry.data.lastReviewed.toISOString(),
      mainEntityOfPage: canonical,
      author: {
        '@type': 'Organization',
        name: 'Dzaleka Online Services',
      },
      publisher: {
        '@type': 'Organization',
        name: 'Dzaleka Online Services',
        url: 'https://services.dzaleka.com',
      },
      about: {
        '@type': schemaType,
        name: entry.data.title,
        alternateName: entry.data.aliases || undefined,
      },
      citation: entry.data.sources.map((source) => source.url),
    })}
  />

  <main class="bg-white">
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Dzaleka Encyclopedia', href: '/encyclopedia' },
            { label: entry.data.title },
          ]}
        />
        <div class="mt-8 max-w-4xl">
          <div class="flex flex-wrap items-center gap-3">
            <p class="text-sm font-semibold uppercase tracking-widest text-slate-500">{entry.data.category}</p>
            {entry.data.status === 'developing' && (
              <span class="rounded-md bg-amber-50 px-2.5 py-1 text-xs font-semibold text-amber-800">Developing entry</span>
            )}
          </div>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">{entry.data.title}</h1>
          {entry.data.aliases && entry.data.aliases.length > 0 && (
            <p class="mt-3 text-sm text-slate-500">Also known as {entry.data.aliases.join(', ')}</p>
          )}
          <p class="mt-5 text-lg leading-8 text-slate-600 sm:text-xl">{entry.data.summary}</p>
          <p class="mt-5 text-sm text-slate-500">Last reviewed {reviewedDate}</p>
        </div>
      </div>
    </header>

    {entry.data.image && (
      <div class="mx-auto max-w-6xl px-4 pt-8 sm:px-6 lg:px-8">
        <figure class:list={[
          'overflow-hidden rounded-xl border border-slate-200 bg-slate-100',
          entry.data.entryType === 'person' ? 'max-w-sm' : '',
        ]}>
          <img
            src={entry.data.image}
            alt={entry.data.imageAlt || entry.data.title}
            class:list={[
              'w-full object-cover',
              entry.data.entryType === 'person' ? 'aspect-[4/5]' : 'aspect-[16/7]',
            ]}
          />
        </figure>
      </div>
    )}

    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_300px] lg:px-8 lg:py-14">
      <article class="min-w-0">
        {entry.data.status === 'developing' && (
          <div class="mb-8 border-l-4 border-amber-500 bg-amber-50 p-4 text-sm leading-6 text-amber-950">
            This entry documents verified historical information, but a recent primary source has not yet confirmed every current operational detail.
          </div>
        )}

        <div class="encyclopedia-prose prose prose-slate max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary-700 prose-a:underline prose-a:underline-offset-4 prose-p:leading-8 prose-li:leading-7">
          <Content />
        </div>

        {relatedEntries.length > 0 && (
          <section class="mt-12 border-t border-slate-200 pt-8">
            <h2 class="text-2xl font-bold text-slate-950">Related entries</h2>
            <div class="mt-5 divide-y divide-slate-200 border-y border-slate-200">
              {relatedEntries.map((related) => related && (
                <a href={`/encyclopedia/${related.id}`} class="group flex items-center justify-between gap-4 py-4">
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{related.data.category}</p>
                    <h3 class="mt-1 font-bold text-slate-950 group-hover:text-primary-700">{related.data.title}</h3>
                  </div>
                  <span class="text-primary-700" aria-hidden="true">&rarr;</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>

      <aside class="space-y-8 lg:sticky lg:top-28 lg:h-fit">
        {entry.data.facts && entry.data.facts.length > 0 && (
          <section class="rounded-xl border border-slate-200 bg-slate-50 p-5">
            <h2 class="text-sm font-semibold uppercase tracking-widest text-slate-500">At a glance</h2>
            <dl class="mt-4 divide-y divide-slate-200">
              {entry.data.facts.map((fact) => (
                <div class="py-3 first:pt-0 last:pb-0">
                  <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">{fact.label}</dt>
                  <dd class="mt-1 text-sm leading-6 text-slate-800">{fact.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}

        <section class="border-t border-slate-200 pt-6 lg:border-t-0 lg:pt-0">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-slate-500">Sources</h2>
          <ol class="mt-4 space-y-4">
            {entry.data.sources.map((source, index) => (
              <li class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-2 text-sm leading-6">
                <span class="font-semibold text-slate-400">{index + 1}</span>
                <div>
                  <a href={source.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800">
                    {source.title}
                  </a>
                  <p class="text-slate-600">{source.publisher}{source.date ? `, ${source.date}` : ''}</p>
                  {source.note && <p class="mt-1 text-xs text-slate-500">{source.note}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>

        <section class="border-t border-slate-200 pt-6">
          <h2 class="font-bold text-slate-950">See something to correct?</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">Send evidence or a better source for editorial review.</p>
          <a href="/support" class="mt-4 inline-flex rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-800 hover:bg-slate-50">Report an issue</a>
        </section>
      </aside>
    </div>
  </main>
</MainLayout>

<style>
  .encyclopedia-prose :global(h2) {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(226 232 240);
  }

  .encyclopedia-prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
</style>
