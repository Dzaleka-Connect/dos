---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const dancers = await getCollection('dancers');
  return dancers.map(dancer => ({
    params: { slug: dancer.id },
    props: { dancer }
  }));
}

const { dancer } = Astro.props;
const { Content } = await render(dancer);

// Enhanced SEO metadata for individual dancer pages
const pageTitle = `${dancer.data.title} - ${dancer.data.type === 'group' ? 'Dance Group' : 'Dancer'} from Dzaleka Refugee Camp`;
const pageDescription = `${dancer.data.description} ${dancer.data.age ? `Age: ${dancer.data.age} years.` : ''} ${dancer.data.nationality ? `Nationality: ${dancer.data.nationality}.` : ''} ${dancer.data.type === 'group' ? 'Book performances and join this dance group.' : 'Book performances and connect with this talented dancer.'} from Dzaleka Refugee Camp.`;
const pageKeywords = `${dancer.data.title}, Dzaleka ${dancer.data.type === 'group' ? 'dance group' : 'dancer'}, refugee dance, ${dancer.data.nationality || 'African'} ${dancer.data.type === 'group' ? 'dance group' : 'dancer'}, dance performances, traditional dance, contemporary dance, dance booking, Dzaleka dance community`;
const canonicalURL = `https://services.dzaleka.com/dancers/${dancer.id}`;

// Generate structured data for individual dancer
const structuredData = {
  "@context": "https://schema.org",
  "@type": dancer.data.type === 'group' ? "Organization" : "Person",
  "name": dancer.data.title,
  "description": dancer.data.description,
  "url": canonicalURL,
  "nationality": dancer.data.nationality,
  "age": dancer.data.age,
  "jobTitle": dancer.data.type === 'group' ? "Dance Group" : "Dancer",
  "worksFor": {
    "@type": "Organization",
    "name": "Dzaleka Online Services"
  },
  "image": dancer.data.image ? `https://services.dzaleka.com${dancer.data.image}` : undefined,
  "sameAs": [
    canonicalURL
  ]
};

// Get members from frontmatter if this is a group
const members = dancer.data.type === 'group' && dancer.data.members ? dancer.data.members : [];
---

<MainLayout 
  title={pageTitle} 
  description={pageDescription}
  keywords={pageKeywords}
  canonical={canonicalURL}
  ogType="profile"
  ogImage={dancer.data.image || "/images/dancers/forus-crew.jpg"}
  twitterCard="summary_large_image"
>
  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  
  <!-- Hero Section -->
  <section class="border-b border-gray-200 bg-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center mb-8">
        <a href="/dancers" class="inline-flex items-center text-slate-700 hover:text-slate-700 transition-colors font-medium">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Back to Dancers
        </a>
      </div>
      
      <div class="lg:grid lg:grid-cols-3 lg:gap-12 items-start">
        <!-- Hero Image Section -->
        <div class="lg:col-span-1 mb-8 lg:mb-0">
          {dancer.data.image ? (
            <div class="relative aspect-[3/4] overflow-hidden rounded-lg shadow-md border border-gray-100">
              <img src={dancer.data.image} alt={dancer.data.title} 
                   class="w-full h-full object-cover" />
            </div>
          ) : (
            <div class="relative aspect-[3/4] overflow-hidden rounded-lg shadow-md border border-gray-100 bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center">
              <svg class="w-24 h-24 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
          )}
        </div>
        
        <!-- Content Section -->
        <div class="lg:col-span-2">
          <div class="flex items-center mb-4">
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-slate-100 text-slate-800 mr-3 border border-slate-200">
              {dancer.data.type === 'group' ? 'Dance Group' : 'Solo Dancer'}
            </span>
            {dancer.data.featured && (
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-amber-100 text-amber-800 border border-amber-200">
                Featured
              </span>
            )}
          </div>
          
          <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 tracking-tight mb-6">
            {dancer.data.title}
          </h1>
          
          <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            {dancer.data.description}
          </p>
          
          <!-- Quick Stats -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
            {dancer.data.type === 'group' && dancer.data.members && (
              <div class="bg-white rounded-lg p-3 border border-gray-200 shadow-sm">
                <div class="text-lg font-bold text-slate-700 leading-tight">
                  {Array.isArray(dancer.data.members) ? dancer.data.members.length : dancer.data.members}
                </div>
                <div class="text-xs text-gray-500 font-medium uppercase tracking-wide mt-1">Members</div>
              </div>
            )}
            {dancer.data.type === 'individual' && dancer.data.age && (
              <div class="bg-white rounded-lg p-3 border border-gray-200 shadow-sm">
                <div class="text-lg font-bold text-slate-700 leading-tight">{dancer.data.age}</div>
                <div class="text-xs text-gray-500 font-medium uppercase tracking-wide mt-1">Age</div>
              </div>
            )}
            {dancer.data.founded && (
              <div class="bg-white rounded-lg p-3 border border-gray-200 shadow-sm">
                <div class="text-lg font-bold text-slate-700 leading-tight">{dancer.data.founded}</div>
                <div class="text-xs text-gray-500 font-medium uppercase tracking-wide mt-1">Founded</div>
              </div>
            )}
            {dancer.data.nationality && (
              <div class="bg-white rounded-lg p-3 border border-gray-200 shadow-sm">
                <div class="text-lg font-bold text-slate-700 leading-tight truncate" title={dancer.data.nationality}>{dancer.data.nationality}</div>
                <div class="text-xs text-gray-500 font-medium uppercase tracking-wide mt-1">Nationality</div>
              </div>
            )}
          </div>
          
          <!-- Sidebar Info (Moved inline for better flow) -->
          <div class="bg-white rounded-lg p-6 border border-gray-200 shadow-sm mb-8">
            <h3 class="text-lg font-semibold text-gray-900 mb-4">Dance Styles</h3>
            <div class="flex flex-wrap gap-2 mb-6">
              {dancer.data.danceStyles?.map(style => (
                <span class="px-3 py-1 bg-gray-100 rounded-md text-sm text-gray-700 border border-gray-200">
                  {style}
                </span>
              ))}
            </div>
            
            {dancer.data.festivals && (
              <div class="mb-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-3">Festivals & Performances</h3>
                <ul class="space-y-2">
                  {dancer.data.festivals.map(festival => (
                    <li class="flex items-center text-gray-600">
                      <svg class="w-4 h-4 mr-2 text-slate-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      <span class="text-sm">{festival}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            
            {/* Contact Information */}
            {(dancer.data.email || dancer.data.phone || dancer.data.whatsapp || dancer.data.youtubeChannel || dancer.data.socialMedia) && (
              <div>
                <h3 class="text-lg font-semibold text-gray-900 mb-3">Contact Information</h3>
                <div class="space-y-3">
                  {dancer.data.email && (
                    <div class="flex items-center text-gray-600">
                      <svg class="w-4 h-4 mr-2 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                      <a href={`mailto:${dancer.data.email}`} class="text-sm text-slate-700 hover:text-slate-700 transition-colors">
                        {dancer.data.email}
                      </a>
                    </div>
                  )}
                  
                  {dancer.data.phone && (
                    <div class="flex items-center text-gray-600">
                      <svg class="w-4 h-4 mr-2 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                      </svg>
                      <a href={`tel:${dancer.data.phone}`} class="text-sm text-slate-700 hover:text-slate-700 transition-colors">
                        {dancer.data.phone}
                      </a>
                    </div>
                  )}
                  
                  {dancer.data.whatsapp && (
                    <div class="flex items-center text-gray-600">
                      <svg class="w-4 h-4 mr-2 text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
                      </svg>
                      <a href={`https://wa.me/${dancer.data.whatsapp.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener noreferrer" class="text-sm text-slate-700 hover:text-slate-700 transition-colors">
                        WhatsApp
                      </a>
                    </div>
                  )}
                  
                  {dancer.data.youtubeChannel && (
                    <div class="flex items-center text-gray-600">
                      <svg class="w-4 h-4 mr-2 text-gray-400 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                      </svg>
                      <a href={dancer.data.youtubeChannel} target="_blank" rel="noopener noreferrer" class="text-sm text-slate-700 hover:text-slate-700 transition-colors">
                        YouTube Channel
                      </a>
                    </div>
                  )}
                  
                  {dancer.data.socialMedia && (
                    <div class="flex items-center text-gray-600">
                      <svg class="w-4 h-4 mr-2 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2m-9 0h10m-10 0a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V6a2 2 0 00-2-2" />
                      </svg>
                      <span class="text-sm">Social Media</span>
                    </div>
                  )}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg prose-primary mx-auto">
        <Content />
      </div>
    </div>
  </section>

  {/* Group Members Section - Only show for groups */}
  {dancer.data.type === 'group' && dancer.data.members && (
    <section class="py-12 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Meet the Team</h2>
          <p class="text-lg text-gray-600 max-w-2xl mx-auto">
            Get to know the talented members who make up {dancer.data.title}
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {members.length > 0 ? (
            members.map(member => (
              <div class="bg-white rounded-lg shadow-sm hover:shadow-md transition-all duration-200 border border-gray-100 overflow-hidden">
                <div class="h-48 bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center">
                  <svg class="w-16 h-16 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
                <div class="p-6">
                  <h3 class="text-lg font-semibold text-gray-900 mb-2">{member.name}</h3>
                  <div class="flex items-center space-x-2 mb-3">
                    <span class="text-sm text-slate-700 font-medium">{member.role}</span>
                    {member.age && (
                      <span class="text-sm text-gray-500">• {member.age} years</span>
                    )}
                    {member.nationality && (
                      <span class="text-sm text-gray-500">• {member.nationality}</span>
                    )}
                  </div>
                  
                  {/* Specialties */}
                  {member.specialties && member.specialties.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-4">
                      {member.specialties.map(specialty => (
                        <span class="px-2 py-1 bg-slate-50 text-slate-700 rounded-md text-xs border border-slate-200">
                          {specialty}
                        </span>
                      ))}
                    </div>
                  )}
                  
                  <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-600">Group Member</span>
                    {member.email && (
                      <a href={`mailto:${member.email}`} 
                         class="inline-flex items-center px-3 py-1 bg-slate-50 text-slate-700 rounded-full text-xs hover:bg-slate-100 transition-colors">
                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                        Contact
                      </a>
                    )}
                  </div>
                </div>
              </div>
            ))
          ) : (
            // Fallback for groups without member details
            Array.from({ length: (Array.isArray(dancer.data.members) ? dancer.data.members.length : dancer.data.members) || 4 }, (_, i) => (
              <div class="bg-white rounded-lg shadow-sm hover:shadow-md transition-all duration-200 border border-gray-100 overflow-hidden">
                <div class="h-48 bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center">
                  <svg class="w-16 h-16 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
                <div class="p-6">
                  <h3 class="text-lg font-semibold text-gray-900 mb-2">Dancer {i + 1}</h3>
                  <p class="text-gray-600 text-sm mb-4">Group Member</p>
                  <div class="flex items-center justify-between">
                    <span class="text-sm text-slate-700 font-medium">Dancer</span>
                    <div class="flex space-x-2">
                      {dancer.data.danceStyles?.slice(0, 2).map(style => (
                        <span class="px-2 py-1 bg-slate-50 text-slate-700 rounded-md text-xs border border-slate-200">{style}</span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            ))
          )}
        </div>
        
        <div class="text-center mt-12">
          <p class="text-gray-600 mb-6">
            Interested in joining {dancer.data.title} or booking the group for a performance?
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/dancers/book-performance" 
               class="inline-flex items-center justify-center px-6 py-3 rounded-lg text-white bg-gray-900 hover:bg-gray-800 transition-colors font-medium">
              Book Performance
              <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            <a href="/contact" 
               class="inline-flex items-center justify-center px-6 py-3 rounded-lg text-slate-700 border-2 border-gray-900 hover:bg-slate-50 transition-colors font-medium">
              Contact Group
              <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

</MainLayout>
