---
import MainLayout from '../../layouts/MainLayout.astro';
import CreativeProfile from '../../components/culture/CreativeProfile.astro';
import { getCollection, render } from 'astro:content';
import { recordImageUrl } from '../../utils/recordMedia';

export async function getStaticPaths() {
  return (await getCollection('dancers')).map(dancer => ({ params: { slug: dancer.id }, props: { dancer } }));
}
const { dancer } = Astro.props;
const { Content } = await render(dancer);
const data = dancer.data;
const members = data.type === 'group' ? data.members || [] : [];
const canonical = `https://services.dzaleka.com/dancers/${dancer.id}`;
const image = recordImageUrl(data.image);
const facts = [
  { label: 'Dance styles', value: data.danceStyles },
  { label: 'Nationality', value: data.nationality },
  { label: 'Age recorded in this biography', value: data.age },
  { label: 'Founded (as recorded)', value: data.founded || data.officialStart },
  { label: 'Rehearsals', value: data.rehearsalSchedule },
  { label: 'Group representative', value: data.groupRepresentative },
  { label: 'Festivals and performances', value: data.festivals },
  { label: 'Biography by', value: data.biographyAuthor },
  { label: 'Interview by', value: data.interviewer },
  { label: 'Interview date', value: data.interviewDate },
];
---
<MainLayout title={`${data.title} | Dance in Dzaleka`} description={data.description} canonical={canonical} image={image} type="profile" schema={{ '@context': 'https://schema.org', '@type': data.type === 'group' ? 'PerformingGroup' : 'Person', name: data.title, description: data.description, url: canonical, image: image ? new URL(image, canonical).href : undefined }}>
  <CreativeProfile title={data.title} description={data.description} image={image} parent="Dance" href="/dancers" kind={data.type === 'group' ? 'Dance group' : 'Dancer'} facts={facts}>
    <Content />
    {(data.email || data.phone || data.whatsapp || data.youtubeChannel || data.socialMedia?.length) && <section slot="details" class="border-t border-slate-200 pt-5">
      <h2 class="mb-2 text-xl text-primary-900">Published contacts</h2>
      <div class="flex flex-col items-start">
        {data.email && <a href={`mailto:${data.email}`} class="inline-flex min-h-[44px] items-center break-all text-sm text-primary-800 underline underline-offset-4">{data.email}</a>}
        {data.phone && <a href={`tel:${data.phone.replace(/[^+\d]/g, '')}`} class="inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">{data.phone}</a>}
        {data.whatsapp && <a href={`https://wa.me/${data.whatsapp.replace(/\D/g, '')}`} class="inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">WhatsApp</a>}
        {data.youtubeChannel && <a href={data.youtubeChannel} class="inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">YouTube channel ↗</a>}
      </div>
      {data.socialMedia?.length > 0 && <ul class="mt-3 space-y-2 text-sm leading-6 text-slate-700 [overflow-wrap:anywhere]">{data.socialMedia.map(profile => <li>{profile}</li>)}</ul>}
    </section>}
    <Fragment slot="after">
      {members.length > 0 && <section class="mt-8 border-t border-slate-200 pt-6">
        <h2 class="text-primary-900">Group members</h2>
        <p class="mt-3 text-sm text-slate-600">People named in this profile.</p>
        <ul class="mt-5 grid gap-5 sm:grid-cols-2">{members.map(member => <li class="min-w-0 rounded border border-slate-200 p-5">
          <h3 class="text-lg text-primary-900">{member.name}</h3>
          {member.role && <p class="mt-2 text-sm text-slate-700">{member.role}</p>}
          {member.nationality && <p class="mt-2 text-sm text-slate-600">{member.nationality}</p>}
          {member.age && <p class="mt-2 text-sm text-slate-600">Age recorded: {member.age}</p>}
          {member.specialties?.length > 0 && <p class="mt-2 text-sm leading-6 text-slate-700">{member.specialties.join(', ')}</p>}
          {member.email && <a href={`mailto:${member.email}`} class="mt-2 inline-flex min-h-[44px] items-center break-all text-sm text-primary-800 underline underline-offset-4">{member.email}</a>}
        </li>)}</ul>
      </section>}
      <aside class="mt-8 border-t border-slate-200 pt-6">
        <h2 class="text-primary-900">Performance enquiries</h2>
        <p class="mt-3 text-base leading-7 text-slate-700">Use the published contact details or send a performance enquiry through the directory.</p>
        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-3"><a href="/dancers/book-performance" class="inline-flex min-h-[44px] items-center rounded bg-primary-900 px-5 py-3 text-sm text-white hover:bg-primary-800">Enquire about a performance</a><a href="/dancers" class="inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">Browse all dancers →</a></div>
      </aside>
    </Fragment>
  </CreativeProfile>
</MainLayout>
