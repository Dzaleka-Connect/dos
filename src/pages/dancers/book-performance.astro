---
import Layout from '../../layouts/Layout.astro';
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

// Get all dancer profiles
const dancers = await getCollection('dancers');

// Separate groups and individuals
const danceGroups = dancers.filter(dancer => dancer.data.type === 'group');
const individualDancers = dancers.filter(dancer => dancer.data.type === 'individual');

// Filter dancers with contact information
const dancersWithContact = dancers.filter(dancer => 
  dancer.data.email || dancer.data.phone || dancer.data.whatsapp
);

const title = "Book a Performance - Dancers From Dzaleka";
const description = "Book performances from talented dancers and dance groups from Dzaleka Refugee Camp. Contact information and booking details for all available performers.";
---

<MainLayout title={title} description={description}>
  <Layout>
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-br from-purple-900 via-purple-800 to-indigo-900 text-white py-20">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl font-bold mb-6">
            Book a Performance
          </h1>
          <p class="text-xl text-purple-100 max-w-3xl mx-auto mb-8">
            Connect with talented dancers and dance groups from Dzaleka for your events, festivals, and special occasions.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/dancers" class="inline-flex items-center px-6 py-3 border border-transparent rounded-lg shadow-sm text-lg font-medium text-purple-900 bg-white hover:bg-gray-50 transition-colors duration-300">
              Browse All Dancers
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a href="/contact" class="inline-flex items-center px-6 py-3 border border-white rounded-lg shadow-sm text-lg font-medium text-white hover:bg-white/10 transition-colors duration-300">
              Contact Us
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Booking Information -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">How to Book</h2>
          <p class="text-lg text-gray-600 max-w-3xl mx-auto">
            Contact the dancers directly using the information provided below. Most dancers are available for performances, workshops, and special events.
          </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8 mb-16">
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">Contact Directly</h3>
            <p class="text-gray-600">Use the contact information provided for each dancer to reach out directly about booking.</p>
          </div>
          
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">Plan Ahead</h3>
            <p class="text-gray-600">Contact dancers at least 2-3 weeks in advance to ensure availability and proper preparation.</p>
          </div>
          
          <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
            <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">Discuss Rates</h3>
            <p class="text-gray-600">Discuss performance rates, travel arrangements, and any special requirements with the dancers.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Dance Groups with Contact -->
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Dance Groups Available for Booking</h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {danceGroups.map(group => (
            <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 overflow-hidden">
              <div class="relative h-48 overflow-hidden">
                {group.data.image ? (
                  <img 
                    src={group.data.image} 
                    alt={group.data.title}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-purple-400 to-indigo-500 flex items-center justify-center">
                    <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4V2a1 1 0 011-1h8a1 1 0 011 1v2m-9 0h10m-10 0a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V6a2 2 0 00-2-2" />
                    </svg>
                  </div>
                )}
                <div class="absolute top-4 right-4">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                    {Array.isArray(group.data.members) ? group.data.members.length : group.data.members} members
                  </span>
                </div>
              </div>
              
              <div class="p-6">
                <h3 class="text-xl font-semibold text-gray-900 mb-2">{group.data.title}</h3>
                <p class="text-gray-600 text-sm mb-4 line-clamp-2">{group.data.description}</p>
                
                {/* Dance Styles */}
                <div class="flex flex-wrap gap-2 mb-4">
                  {group.data.danceStyles?.slice(0, 3).map(style => (
                    <span class="px-2 py-1 bg-gray-100 rounded-full text-xs text-gray-700">
                      {style}
                    </span>
                  ))}
                </div>
                
                {/* Contact Information */}
                <div class="space-y-2 mb-4">
                  {group.data.email && (
                    <div class="flex items-center text-sm">
                      <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                      <a href={`mailto:${group.data.email}`} class="text-purple-600 hover:text-purple-700">
                        {group.data.email}
                      </a>
                    </div>
                  )}
                  
                  {group.data.phone && (
                    <div class="flex items-center text-sm">
                      <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                      </svg>
                      <a href={`tel:${group.data.phone}`} class="text-purple-600 hover:text-purple-700">
                        {group.data.phone}
                      </a>
                    </div>
                  )}
                  
                  {group.data.whatsapp && (
                    <div class="flex items-center text-sm">
                      <svg class="w-4 h-4 mr-2 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
                      </svg>
                      <a href={`https://wa.me/${group.data.whatsapp.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener noreferrer" class="text-purple-600 hover:text-purple-700">
                        WhatsApp
                      </a>
                    </div>
                  )}
                </div>
                
                <div class="flex items-center justify-between">
                  <a href={`/dancers/${group.slug}`} class="text-purple-600 hover:text-purple-700 font-medium text-sm">
                    View Full Profile →
                  </a>
                  {!group.data.email && !group.data.phone && !group.data.whatsapp && (
                    <span class="text-xs text-gray-500">Contact info coming soon</span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Individual Dancers with Contact -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Individual Dancers Available for Booking</h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {individualDancers.map(dancer => (
            <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 overflow-hidden">
              <div class="relative h-48 overflow-hidden">
                {dancer.data.image ? (
                  <img 
                    src={dancer.data.image} 
                    alt={dancer.data.title}
                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                  />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-purple-400 to-indigo-500 flex items-center justify-center">
                    <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                  </div>
                )}
                <div class="absolute top-4 right-4">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800">
                    {dancer.data.age} years
                  </span>
                </div>
              </div>
              
              <div class="p-6">
                <h3 class="text-xl font-semibold text-gray-900 mb-2">{dancer.data.title}</h3>
                <p class="text-gray-600 text-sm mb-4 line-clamp-2">{dancer.data.description}</p>
                
                {/* Dance Styles */}
                <div class="flex flex-wrap gap-2 mb-4">
                  {dancer.data.danceStyles?.slice(0, 3).map(style => (
                    <span class="px-2 py-1 bg-gray-100 rounded-full text-xs text-gray-700">
                      {style}
                    </span>
                  ))}
                </div>
                
                {/* Contact Information */}
                <div class="space-y-2 mb-4">
                  {dancer.data.email && (
                    <div class="flex items-center text-sm">
                      <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                      </svg>
                      <a href={`mailto:${dancer.data.email}`} class="text-purple-600 hover:text-purple-700">
                        {dancer.data.email}
                      </a>
                    </div>
                  )}
                  
                  {dancer.data.phone && (
                    <div class="flex items-center text-sm">
                      <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                      </svg>
                      <a href={`tel:${dancer.data.phone}`} class="text-purple-600 hover:text-purple-700">
                        {dancer.data.phone}
                      </a>
                    </div>
                  )}
                  
                  {dancer.data.whatsapp && (
                    <div class="flex items-center text-sm">
                      <svg class="w-4 h-4 mr-2 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
                      </svg>
                      <a href={`https://wa.me/${dancer.data.whatsapp.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener noreferrer" class="text-purple-600 hover:text-purple-700">
                        WhatsApp
                      </a>
                    </div>
                  )}
                </div>
                
                <div class="flex items-center justify-between">
                  <a href={`/dancers/${dancer.slug}`} class="text-purple-600 hover:text-purple-700 font-medium text-sm">
                    View Full Profile →
                  </a>
                  {!dancer.data.email && !dancer.data.phone && !dancer.data.whatsapp && (
                    <span class="text-xs text-gray-500">Contact info coming soon</span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact Information Section -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Contact Our Dancers</h2>
          <p class="text-lg text-gray-600 max-w-3xl mx-auto">
            To contact individual dancers, some of them have provided social media, email, and/or WhatsApp numbers. 
            These can be found by reading the biographies for individual dancers.
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="bg-white rounded-xl p-6 shadow-lg border border-gray-100">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mr-4">
                <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900">Project Email</h3>
            </div>
            <p class="text-gray-600 mb-3">For general inquiries about the Dzaleka Art Project:</p>
            <a href="mailto:Dzaleka.Art.Project@gmail.com" class="text-purple-600 hover:text-purple-700 font-medium">
              Dzaleka.Art.Project@gmail.com
            </a>
          </div>
          
          <div class="bg-white rounded-xl p-6 shadow-lg border border-gray-100">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mr-4">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900">Lisa Gilman</h3>
            </div>
            <p class="text-gray-600 mb-3">Project Director & Researcher:</p>
            <div class="space-y-2">
              <a href="mailto:lgilman3@gmu.edu" class="block text-purple-600 hover:text-purple-700 font-medium">
                lgilman3@gmu.edu
              </a>
              <a href="https://wa.me/15412857043" target="_blank" rel="noopener noreferrer" class="block text-green-600 hover:text-green-700 font-medium">
                WhatsApp: +1-541-285-7043
              </a>
            </div>
          </div>
          
          <div class="bg-white rounded-xl p-6 shadow-lg border border-gray-100">
            <div class="flex items-center mb-4">
              <div class="w-12 h-12 bg-indigo-100 rounded-lg flex items-center justify-center mr-4">
                <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-900">Team Contact</h3>
            </div>
            <p class="text-gray-600 mb-3">To contact other team members:</p>
            <a href="mailto:Dzaleka.Art.Project@gmail.com" class="text-purple-600 hover:text-purple-700 font-medium">
              Dzaleka.Art.Project@gmail.com
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-16 bg-purple-900 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold mb-4">Ready to Book a Performance?</h2>
        <p class="text-xl text-purple-100 mb-8 max-w-2xl mx-auto">
          Contact the dancers directly or reach out to us for assistance with booking arrangements, event planning, and coordination.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/dancers" class="inline-flex items-center px-8 py-4 border border-transparent rounded-lg shadow-sm text-lg font-medium text-purple-900 bg-white hover:bg-gray-50 transition-colors duration-300">
            Browse All Dancers
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
