---
import FormHeader from '../../components/ui/FormHeader.astro';
import MainLayout from '../../layouts/MainLayout.astro';

const pageTitle = "Add Your Dance Profile";
const pageDescription = "Submit your dance group or individual dancer profile to be featured on our platform";
---

<MainLayout title={pageTitle} description={pageDescription}>

    <FormHeader title="Add your dance profile" description="Introduce yourself or your dance group and share your work with the community." parent="Dancers" href="/dancers" />

    <!-- Form Section -->
    <section class="py-8 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <form id="dancerForm" action="https://formspree.io/f/xqaaajae" method="POST" class="submission-form space-y-8">
          <!-- Profile Type -->
          <div>
            <label class="block text-lg font-semibold text-gray-900 mb-4">Profile type</label>
            <div class="grid md:grid-cols-2 gap-4">
              <label class="flex items-center p-4 border-2 border-gray-200 rounded cursor-pointer hover:border-slate-300 hover:bg-slate-50 transition-all duration-200 group">
                <input type="radio" name="profileType" value="group" class="mr-3 h-5 w-5 shrink-0" required>
                <div class="flex items-center">
                  <div>
                    <div class="font-medium text-gray-900 group-hover:text-slate-900">Dance Group</div>
                    <div class="text-sm text-gray-600 group-hover:text-slate-700">For dance crews and groups</div>
                  </div>
                </div>
              </label>
              <label class="flex items-center p-4 border-2 border-gray-200 rounded cursor-pointer hover:border-slate-300 hover:bg-slate-50 transition-all duration-200 group">
                <input type="radio" name="profileType" value="individual" class="mr-3 h-5 w-5 shrink-0" required>
                <div class="flex items-center">
                  <div>
                    <div class="font-medium text-gray-900 group-hover:text-slate-900">Solo Dancer</div>
                    <div class="text-sm text-gray-600 group-hover:text-slate-700">For individual performers</div>
                  </div>
                </div>
              </label>
            </div>
          </div>

          <!-- Basic Information -->
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-2">Name or group name</label>
              <input type="text" id="name" name="name" required
                     class="w-full px-4 py-3 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-colors">
            </div>

            <div>
              <label for="nationality" class="block text-sm font-medium text-gray-700 mb-2">Nationality</label>
              <input type="text" id="nationality" name="nationality" required
                     class="w-full px-4 py-3 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-colors">
            </div>
          </div>

          <!-- Group-specific fields -->
          <div id="groupFields" class="hidden space-y-6">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="memberCount" class="block text-sm font-medium text-gray-700 mb-2">Number of members <span class="font-normal text-slate-600">(optional)</span></label>
                <input type="number" id="memberCount" name="memberCount" min="2"
                       class="w-full px-4 py-3 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-colors">
              </div>

              <div>
                <label for="founded" class="block text-sm font-medium text-gray-700 mb-2">Year founded <span class="font-normal text-slate-600">(optional)</span></label>
                <input type="text" id="founded" name="founded"
                       class="w-full px-4 py-3 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-colors">
              </div>
            </div>

            <div>
              <label for="members" class="block text-sm font-medium text-gray-700 mb-2">Member names & ages <span class="font-normal text-slate-600">(optional)</span></label>
              <p id="members-hint" class="mb-1 text-sm text-slate-600">List each member with their name, age, and nationality (for example, John Doe: 25yrs, DRC)</p>
              <textarea aria-describedby="members-hint" id="members" name="members" rows="4"
                        class="w-full px-4 py-3 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-colors"></textarea>
            </div>
          </div>

          <!-- Individual-specific fields -->
          <div id="individualFields" class="hidden space-y-6">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="age" class="block text-sm font-medium text-gray-700 mb-2">Age <span class="font-normal text-slate-600">(optional)</span></label>
                <input type="number" id="age" name="age" min="1" max="120"
                       class="w-full px-4 py-3 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-colors">
              </div>

              <div>
                <label for="birthplace" class="block text-sm font-medium text-gray-700 mb-2">Birthplace <span class="font-normal text-slate-600">(optional)</span></label>
                <input type="text" id="birthplace" name="birthplace"
                       class="w-full px-4 py-3 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-colors">
              </div>
            </div>
          </div>

          <!-- Dance Information -->
          <div class="space-y-6">
            <div>
              <label for="danceStyles" class="block text-sm font-medium text-gray-700 mb-2">Dance styles</label>
              <p id="danceStyles-hint" class="mb-1 text-sm text-slate-600">For example, Afro Dance, Hip Hop, Contemporary, Cultural Dance, Acrobatic Dance</p>
              <textarea aria-describedby="danceStyles-hint" id="danceStyles" name="danceStyles" rows="3" required
                        class="w-full px-4 py-3 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-colors"></textarea>
            </div>

            <div>
              <label for="festivals" class="block text-sm font-medium text-gray-700 mb-2">Festivals & performances <span class="font-normal text-slate-600">(optional)</span></label>
              <p id="festivals-hint" class="mb-1 text-sm text-slate-600">List festivals and events where you've performed</p>
              <textarea aria-describedby="festivals-hint" id="festivals" name="festivals" rows="3"
                        class="w-full px-4 py-3 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-colors"></textarea>
            </div>

            <div>
              <label for="rehearsalSchedule" class="block text-sm font-medium text-gray-700 mb-2">Rehearsal schedule <span class="font-normal text-slate-600">(optional)</span></label>
              <p id="rehearsalSchedule-hint" class="mb-1 text-sm text-slate-600">For example, Monday to Friday, 2pm to 4pm</p>
              <input aria-describedby="rehearsalSchedule-hint" type="text" id="rehearsalSchedule" name="rehearsalSchedule"
                     class="w-full px-4 py-3 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-colors">
            </div>
          </div>

          <!-- Biography -->
          <div>
            <label for="biography" class="block text-sm font-medium text-gray-700 mb-2">Biography/story</label>
            <p id="biography-hint" class="mb-1 text-sm text-slate-600">Tell us your story: how you started dancing, your journey, challenges, achievements, and what dance means to you</p>
            <textarea aria-describedby="biography-hint" id="biography" name="biography" rows="8" required
                      class="w-full px-4 py-3 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-colors"></textarea>
          </div>

          <!-- Contact Information -->
          <div class="space-y-6">
            <h2 class="text-lg font-semibold text-gray-900">Contact information</h2>

            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Email <span class="font-normal text-slate-600">(optional)</span></label>
                <input type="email" id="email" name="email"
                       class="w-full px-4 py-3 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-colors">
              </div>

              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">Phone number <span class="font-normal text-slate-600">(optional)</span></label>
                <input type="tel" id="phone" name="phone"
                       class="w-full px-4 py-3 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-colors">
              </div>
            </div>

            <div>
              <label for="socialMedia" class="block text-sm font-medium text-gray-700 mb-2">Social media links <span class="font-normal text-slate-600">(optional)</span></label>
              <p id="socialMedia-hint" class="mb-1 text-sm text-slate-600">For example, YouTube, Instagram, Facebook, TikTok</p>
              <textarea aria-describedby="socialMedia-hint" id="socialMedia" name="socialMedia" rows="3"
                        class="w-full px-4 py-3 border border-gray-300 rounded focus:ring-2 focus:ring-slate-500 focus:border-slate-500 transition-colors"></textarea>
            </div>
          </div>

          <!-- Photo Upload -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Profile photo (optional)</label>
            <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded hover:border-slate-400 hover:bg-slate-50 transition-all duration-200">
              <div class="space-y-1 text-center">
                <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                  <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <div class="flex text-sm text-gray-600 justify-center">
                  <label for="photo" class="relative cursor-pointer bg-white rounded font-medium text-slate-700 hover:text-slate-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-slate-500">
                    <span>Upload a photo</span>
                    <input id="photo" name="photo" type="file" class="sr-only" accept="image/*">
                  </label>
                  <p class="pl-1">or drag and drop</p>
                </div>
                <p class="text-xs text-gray-500">PNG, JPG, GIF up to 10MB</p>
              </div>
            </div>
            <p id="photoUploadStatus" class="text-sm mt-2 text-slate-700 font-medium"></p>
            <input type="hidden" name="photoUrl" id="photoUrlInput" />
          </div>

          <!-- Submit Button -->
          <div class="text-center">
            <button type="submit"
                    class="min-h-[44px] inline-flex items-center px-8 py-4 border border-transparent rounded text-lg font-medium text-white bg-primary-900 hover:bg-primary-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-500 transition-colors duration-200">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
              </svg>
              Submit Profile
            </button>
          </div>

          <!-- Success/Error Messages -->
          <div id="successMessage" class="hidden bg-green-50 border border-green-200 rounded p-4">
            <div class="flex">
              <svg class="w-5 h-5 text-green-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p class="text-green-800">Thank you. We have received your profile. We'll review it and get back to you soon.</p>
            </div>
          </div>

          <div id="errorMessage" class="hidden bg-red-50 border border-red-200 rounded p-4">
            <div class="flex">
              <svg class="w-5 h-5 text-red-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <p class="text-red-800">There was an error submitting your profile. Try again.</p>
            </div>
          </div>
        </form>
      </div>
    </section>

</MainLayout>

<script>
  // Handle profile type selection
  const profileTypeInputs = document.querySelectorAll('input[name="profileType"]');
  const groupFields = document.getElementById('groupFields');
  const individualFields = document.getElementById('individualFields');

  profileTypeInputs.forEach(input => {
    input.addEventListener('change', function() {
      if (this.value === 'group') {
        groupFields.classList.remove('hidden');
        individualFields.classList.add('hidden');
      } else {
        individualFields.classList.remove('hidden');
        groupFields.classList.add('hidden');
      }
    });
  });

  // Handle form submission
  const form = document.getElementById('dancerForm');
  const successMessage = document.getElementById('successMessage');
  const errorMessage = document.getElementById('errorMessage');

  form.addEventListener('submit', async function(e) {
    e.preventDefault();

    // Handle photo upload if present
    const photoInput = document.getElementById('photo');
    const photoUrlInput = document.getElementById('photoUrlInput');
    const photoUploadStatus = document.getElementById('photoUploadStatus');

    if (photoInput.files.length > 0) {
      photoUploadStatus.textContent = 'Uploading photo...';

      const formData = new FormData();
      formData.append('file', photoInput.files[0]);
      formData.append('upload_preset', 'dzaleka_events');

      try {
        const response = await fetch('https://api.cloudinary.com/v1_1/dcvwslmow/image/upload', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();
        photoUrlInput.value = data.secure_url;
        photoUploadStatus.textContent = 'Photo uploaded.';
        photoUploadStatus.classList.remove('text-slate-700');
        photoUploadStatus.classList.add('text-green-600');
      } catch (error) {
        photoUploadStatus.textContent = 'Photo upload failed. Try again.';
        photoUploadStatus.classList.remove('text-slate-700');
        photoUploadStatus.classList.add('text-red-600');
        return;
      }
    }

    // Submit form
    try {
      const formData = new FormData(form);
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData
      });

      if (response.ok) {
        successMessage.classList.remove('hidden');
        errorMessage.classList.add('hidden');
        form.reset();
        groupFields.classList.add('hidden');
        individualFields.classList.add('hidden');
        if (photoUploadStatus) photoUploadStatus.textContent = '';
      } else {
        throw new Error('Form submission failed');
      }
    } catch (error) {
      errorMessage.classList.remove('hidden');
      successMessage.classList.add('hidden');
    }
  });
</script>
