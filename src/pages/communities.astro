---
import MainLayout from '../layouts/MainLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import { communitiesHeroImage, communityGroups, mainCommunity } from '../data/communities';

const canonicalUrl = 'https://services.dzaleka.com/communities';
const pageTitle = 'Dzaleka Communities of Practice | Dzaleka Online Services';
const pageDescription =
  'Join Dzaleka Communities of Practice on WhatsApp for peer learning, local announcements, sector meetups, and practical support.';

const sectorCommunities = communityGroups.filter((community) => !community.isMain);
const categoryFilters = ['All', ...new Set(sectorCommunities.map((community) => community.category))];

const effectiveUseCards = [
  {
    title: 'Ask useful questions',
    description:
      'Good questions help the right people answer quickly. Give context, say what you tried, and name the decision or help you need.',
  },
  {
    title: 'Share back what worked',
    description:
      'When a solution helps you, return with the result. A short summary can become the answer another member needs next week.',
  },
  {
    title: 'Use the right space',
    description:
      'Keep the Main Group for orientation and announcements. Use sector groups for specific practice questions, and contact Admins for private concerns.',
  },
  {
    title: 'Turn chat into resources',
    description:
      'Strong communities do more than talk. Save useful templates, guides, links, job posts, event notes, and summaries so knowledge does not disappear.',
  },
];

const faqItems = [
  {
    question: 'Who can join a Dzaleka Online Services Community?',
    answer:
      'Membership is open to any Dzaleka resident, camp worker, or local partner. Whether you are an expert or a beginner, there is a place for you.',
  },
  {
    question: 'How many Communities can I join?',
    answer:
      'You can join as many as you like. We recommend focusing on two or three groups that match your daily work or career goals so you can stay active in the discussions.',
  },
  {
    question: 'How often do Communities meet and what platforms do they use?',
    answer:
      'WhatsApp is the main home for daily questions and real-time updates. Communities may also hold periodic workshops through Zoom or Google Meet and casual in-person meetups across Dzaleka.',
  },
  {
    question: 'Are Community chats confidential?',
    answer:
      'Communities follow a Community Trust policy. WhatsApp is still a social space: members in the same sub-group may see your phone number, and people can screenshot or forward messages. Do not post sensitive information unless you are comfortable with the group seeing it.',
  },
  {
    question: 'I have forgotten which Community I joined. What should I do?',
    answer:
      'Check the Communities tab in WhatsApp. If you changed phones or left a group, return to this page and open the relevant Community page again.',
  },
  {
    question: 'What happens if I leave a WhatsApp Community?',
    answer:
      'If you leave a WhatsApp Community, WhatsApp says you also leave the groups you are in that are part of that Community. If you only want to hide it from Chats, archive it instead. If you choose exit and delete, the community chats are deleted from your device.',
  },
  {
    question: 'How do I find meeting dates?',
    answer:
      'Key dates for workshops and meetups are posted in the WhatsApp Group Description and pinned in the Announcements channel of each group.',
  },
  {
    question: 'How do I report spam or unsafe behaviour?',
    answer:
      'Contact Community Chairs first for local moderation. You can also use WhatsApp report and block tools. When a group is reported, WhatsApp may receive recent messages and group details, so avoid sharing sensitive information unless needed.',
  },
  {
    question: 'How do I contact the Chairs of my Community?',
    answer:
      'Each group is moderated by Admins, also called Community Chairs. Tap the group name to see Admins, tag @admin for general assistance, or use the Contact page for private inquiries.',
  },
];

const communitySteps = [
  'Join the Main Group first if you are unsure where to begin.',
  'Open any sector group that matches your work, interests, or professional goals.',
  'Keep announcements on, and mute busy sub-groups when needed.',
  'Use @admin when you need help from a Community Chair.',
];

const charterPrinciples = [
  {
    title: 'Share for community benefit',
    body:
      'Stories, templates, links, examples, and experience should support peer help, professional development, and collective problem-solving.',
  },
  {
    title: 'Respect sharing boundaries',
    body:
      'Use ideas and solutions you receive, but respect any Amber or Red boundary and do not reveal who shared sensitive information without permission.',
  },
  {
    title: 'No spam or hard selling',
    body:
      'Discuss products, services, and vendors professionally. Repeated advertising and pressure selling are not allowed.',
  },
  {
    title: 'Stay respectful and on topic',
    body:
      'Respect Dzaleka\'s multicultural community. Harassment, discrimination, hate speech, chain posts, and noisy off-topic posts are not welcome.',
  },
  {
    title: 'Credit shared resources',
    body:
      'Do not claim ownership of another member\'s template, guide, document, or creative work.',
  },
  {
    title: 'Use the right channel',
    body:
      'Post questions that benefit the group in the group chat. Send private, personal, or high-risk issues directly to Admins or the DOS Contact page.',
  },
];

const confidentialityLevels = [
  {
    level: 'Green',
    label: 'General knowledge',
    description: 'Can be shared anywhere.',
    classes: 'border-emerald-200 bg-emerald-50 text-emerald-900',
  },
  {
    level: 'Amber',
    label: 'Community-only',
    description: 'Share within the group, but keep names private.',
    classes: 'border-amber-200 bg-amber-50 text-amber-900',
  },
  {
    level: 'Red',
    label: 'Highly sensitive',
    description: 'Do not share outside the specific discussion thread.',
    classes: 'border-red-200 bg-red-50 text-red-900',
  },
];

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const communityDirectoryStructuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Dzaleka Online Services',
        url: 'https://services.dzaleka.com',
      },
      about: {
        '@type': 'Thing',
        name: 'Dzaleka Communities of Practice',
      },
      mainEntity: {
        '@id': `${canonicalUrl}#community-list`,
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://services.dzaleka.com/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Communities',
          item: canonicalUrl,
        },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${canonicalUrl}#community-list`,
      name: 'Dzaleka Online Services Communities of Practice',
      numberOfItems: communityGroups.length,
      itemListElement: communityGroups.map((community, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: community.title,
        description: community.description,
        url: `${canonicalUrl}/${community.slug}`,
      })),
    },
  ],
};
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  schema={communityDirectoryStructuredData}
  openGraph={{
    title: pageTitle,
    description: pageDescription,
    type: 'website',
    image: {
      url: communitiesHeroImage.seoUrl,
      width: communitiesHeroImage.width,
      height: communitiesHeroImage.height,
      alt: communitiesHeroImage.alt,
      type: communitiesHeroImage.type,
    },
    site_name: 'Dzaleka Online Services',
    locale: 'en_US',
    url: canonicalUrl,
  }}
  twitter={{
    card: 'summary_large_image',
    title: pageTitle,
    description: pageDescription,
    image: communitiesHeroImage.seoUrl,
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />

  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Communities' }]} />
      <h1 class="mt-5 text-primary-900">Dzaleka Communities</h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-slate-700">Find a WhatsApp group for your interests or work. Ask questions, share opportunities and learn from people in Dzaleka.</p>
      <nav class="mt-5 flex flex-wrap gap-x-6 gap-y-2" aria-label="Communities page">
        <a href="#find-your-community" class="inline-flex min-h-[44px] items-center font-medium text-primary-800 underline underline-offset-4">Find a group</a>
        <a href="#community-charter" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Community guidelines</a>
        <a href="#community-faqs" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Questions and help</a>
      </nav>
    </div>
  </header>

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <section class="grid items-start gap-5 border-l-4 border-primary-800 bg-slate-50 p-5 sm:p-6 md:grid-cols-[minmax(0,1fr)_auto]" aria-labelledby="main-group-heading">
      <div>
        <h2 id="main-group-heading" class="text-primary-900">New here? Start with the main group</h2>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-700">{mainCommunity.description}</p>
        <a href={`/communities/${mainCommunity.slug}`} class="mt-2 inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">About the main group</a>
      </div>
      <a href={mainCommunity.joinUrl} target="_blank" rel="noopener noreferrer" data-community-join data-community-slug={mainCommunity.slug} data-community-name={mainCommunity.title} class="inline-flex min-h-[44px] items-center justify-center rounded bg-primary-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-primary-800">Join the main group <span class="ml-2" aria-hidden="true">↗</span><span class="sr-only"> on WhatsApp (opens in a new tab)</span></a>
    </section>
    <p class="mt-4 text-sm leading-6 text-slate-600">WhatsApp invitations open in a new tab. Your phone number may be visible to group members. Read the <a href="#community-charter" class="text-primary-800 underline underline-offset-4">community guidelines</a> before joining.</p>

    <section id="find-your-community" class="mt-10" aria-labelledby="groups-heading">
      <div class="flex flex-wrap items-end justify-between gap-5 border-b border-slate-200 pb-5">
        <div><h2 id="groups-heading" class="text-primary-900">Find your group</h2><p id="community-count" class="mt-2 text-sm text-slate-600" role="status">{sectorCommunities.length} groups</p></div>
        <div class="w-full sm:w-64"><label for="community-category" class="mb-2 block text-sm font-medium text-slate-900">Filter by interest</label><select id="community-category" class="w-full border border-slate-400 bg-white px-3 py-2">{categoryFilters.map((category) => <option value={category}>{category === 'All' ? 'All interests' : category}</option>)}</select></div>
      </div>
      <div class="grid gap-x-8 sm:grid-cols-2" id="community-grid">
        {sectorCommunities.map((community) => <article class="flex min-w-0 flex-col border-b border-slate-200 py-6" data-community-card data-category={community.category}>
          <p class="text-sm text-slate-600">{community.category}</p>
          <h3 class="mt-2 text-lg"><a href={`/communities/${community.slug}`} class="font-semibold text-primary-800 underline underline-offset-4 hover:text-primary-900">{community.title}</a></h3>
          <p class="mt-3 text-sm leading-6 text-slate-700">{community.tagline}</p>
          <div class="mt-auto pt-4"><a href={community.joinUrl} target="_blank" rel="noopener noreferrer" data-community-join data-community-slug={community.slug} data-community-name={community.title} class="inline-flex min-h-[44px] items-center rounded border border-primary-800 px-4 py-2 text-sm font-medium text-primary-900 hover:bg-slate-50">Join on WhatsApp <span class="ml-2" aria-hidden="true">↗</span><span class="sr-only">: {community.title} (opens in a new tab)</span></a></div>
        </article>)}
      </div>
      <p id="community-empty-state" class="hidden py-6 text-slate-600">No groups match this interest. Choose another interest or view all groups.</p>
    </section>

    <section id="community-charter" class="mt-12 max-w-3xl" aria-labelledby="guidelines-heading">
      <h2 id="guidelines-heading" class="text-primary-900">Community guidelines</h2>
      <p class="mt-3 text-base leading-7 text-slate-700">Be respectful, stay on topic and avoid repeated advertising. Ask permission before sharing someone else’s personal information or work.</p>
      <div class="mt-5 divide-y divide-slate-200 border-y border-slate-200">
        <details class="py-1"><summary class="cursor-pointer py-3 text-base font-semibold text-primary-800">Getting started and taking part</summary>
          <ol class="mb-5 ml-5 list-decimal space-y-3 text-sm leading-6 text-slate-700">{communitySteps.map((step) => <li>{step}</li>)}</ol>
          <dl class="mb-5 space-y-4">{effectiveUseCards.map((item) => <div><dt class="font-semibold text-slate-900">{item.title}</dt><dd class="mt-1 text-sm leading-6 text-slate-700">{item.description}</dd></div>)}</dl>
        </details>
        <details class="py-1"><summary class="cursor-pointer py-3 text-base font-semibold text-primary-800">Community charter and sharing policy</summary>
          <ul class="mb-6 space-y-5">{charterPrinciples.map((principle) => <li><h3 class="text-base text-slate-900">{principle.title}</h3><p class="mt-1 text-sm leading-6 text-slate-700">{principle.body}</p></li>)}</ul>
          <h3 class="text-base text-slate-900">Sharing boundaries</h3>
          <dl class="my-4 space-y-3">{confidentialityLevels.map((item) => <div><dt class="font-semibold text-slate-900">{item.level}: {item.label}</dt><dd class="text-sm leading-6 text-slate-700">{item.description}</dd></div>)}</dl>
          <p class="mb-5 text-sm leading-6 text-slate-700">When in doubt, ask permission before sharing names, phone numbers, photographs, business plans or personal stories. Community Chairs may warn or remove members who repeatedly break the rules.</p>
        </details>
      </div>
    </section>

    <section id="community-faqs" class="mt-12 max-w-3xl" aria-labelledby="questions-heading">
      <h2 id="questions-heading" class="text-primary-900">Questions and help</h2>
      <div class="mt-5 divide-y divide-slate-200 border-y border-slate-200">{faqItems.map((item) => <details class="py-1"><summary class="cursor-pointer py-3 text-base font-semibold text-primary-800">{item.question}</summary><p class="pb-5 text-sm leading-7 text-slate-700">{item.answer}</p></details>)}</div>
      <p class="mt-5 text-sm text-slate-600">Need help with a group? <a href="/contact" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Contact Dzaleka Online Services</a>.</p>
    </section>
  </div>
</MainLayout>

<script>
  const categorySelect = document.getElementById('community-category') as HTMLSelectElement | null;
  const communityCards = Array.from(document.querySelectorAll<HTMLElement>('[data-community-card]'));
  categorySelect?.addEventListener('change', () => {
    let count = 0;
    communityCards.forEach((card) => {
      const visible = categorySelect.value === 'All' || card.dataset.category === categorySelect.value;
      card.hidden = !visible;
      card.classList.toggle('hidden', !visible);
      if (visible) count += 1;
    });
    const status = document.getElementById('community-count');
    if (status) status.textContent = `${count} ${count === 1 ? 'group' : 'groups'}`;
    document.getElementById('community-empty-state')?.classList.toggle('hidden', count > 0);
  });

  document.querySelectorAll('[data-community-join]').forEach((link) => {
    link.addEventListener('click', () => {
      const analytics = window as typeof window & {
        gtag?: (eventType: string, eventName: string, parameters: Record<string, string | null>) => void;
      };

      analytics.gtag?.('event', 'community_join_click', {
        community_slug: link.getAttribute('data-community-slug'),
        community_name: link.getAttribute('data-community-name'),
        link_url: link.getAttribute('href'),
      });
    });
  });
</script>
