---
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import HelpDeskForm from "../components/HelpDeskForm.astro";
const description =
  "Ask for help using Dzaleka Online Services, report a website problem or request a listing correction. Contact the site team by form or email.";
const canonical = "https://services.dzaleka.com/help-desk";
---

<MainLayout
  title="Help desk"
  description={description}
  canonical={canonical}
  image="https://services.dzaleka.com/images/dzaleka-hero.jpeg"
  schema={{
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "Help desk",
    description,
    url: canonical,
  }}
>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
      <Breadcrumb
        items={[{ label: "Home", href: "/" }, { label: "Help desk" }]}
      />
      <p class="text-sm font-semibold uppercase tracking-widest text-primary-700">
        Website support
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
        Help desk
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-600">
        Report a website problem, ask about a listing or send a question to the
        site team.
      </p>
    </div>
  </section>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-14 lg:px-8">
    <section id="supportFormSection" class="scroll-mt-28">
      <h2 class="text-2xl font-bold text-slate-900">Send a message</h2>
      <p class="mb-6 mt-2 leading-7 text-slate-600">
        Include the page address and explain what happened so we can look into
        it.
      </p>
      <HelpDeskForm />
    </section>
    <aside class="space-y-8">
      <section class="rounded border border-slate-200 bg-slate-50 p-5">
        <h2 class="text-lg font-semibold text-slate-900">
          Looking for something else?
        </h2>
        <ul class="mt-4 divide-y divide-slate-200">
          <li class="py-3 first:pt-0">
            <a
              href="/services/update-request"
              class="font-medium text-primary-800 underline underline-offset-4"
            >
              Update a service listing
            </a>
            <p class="mt-1 text-sm leading-6 text-slate-600">
              Send changes to contact details, hours or service information.
            </p>
          </li>
          <li class="py-3">
            <a
              href="https://visit.dzaleka.com"
              class="font-medium text-primary-800 underline underline-offset-4"
            >
              Visit Dzaleka
            </a>
            <p class="mt-1 text-sm leading-6 text-slate-600">
              Tour and visitor information is on the dedicated website.
            </p>
          </li>
          <li class="pt-3">
            <a
              href="/get-help-now"
              class="font-medium text-primary-800 underline underline-offset-4"
            >
              Get help now
            </a>
            <p class="mt-1 text-sm leading-6 text-slate-600">
              Find urgent help contacts. This website form is not an emergency
              service.
            </p>
          </li>
        </ul>
      </section>
      <section>
        <h2 class="text-lg font-semibold text-slate-900">Email the team</h2>
        <a
          href="mailto:dzalekaconnect@gmail.com"
          class="mt-3 inline-flex min-h-[44px] items-center break-all text-primary-800 underline underline-offset-4"
        >
          dzalekaconnect@gmail.com
        </a>
      </section>
      <section class="border-t border-slate-200 pt-6">
        <h2 class="text-lg font-semibold text-slate-900">What to include</h2>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-sm leading-6 text-slate-600">
          <li>The page or listing you need help with.</li>
          <li>What you were trying to do.</li>
          <li>Any error message you saw.</li>
        </ul>
      </section>
    </aside>
  </div>
</MainLayout>
