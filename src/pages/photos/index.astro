---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { format } from 'date-fns';

// Get URL parameters
const { searchParams } = Astro.url;
const PHOTOS_PER_PAGE = 9;

// Get all photos
const photos = await getCollection('photos');

// Group photos by year
const photosByYear = photos.reduce((acc, photo) => {
  const year = new Date(photo.data.date).getFullYear();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(photo);
  return acc;
}, {} as Record<number, typeof photos>);

// Sort years in descending order
const years = Object.keys(photosByYear)
  .map(Number)
  .sort((a, b) => b - a);

// Sort photos within each year and get top 3
const previewPhotosByYear = years.reduce((acc, year) => {
  // Sort photos for this year
  const yearPhotos = photosByYear[year].sort((a, b) => 
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  acc[year] = {
    photos: yearPhotos.slice(0, 3),
    totalPhotos: yearPhotos.length
  };

  return acc;
}, {} as Record<number, { 
  photos: typeof photos, 
  totalPhotos: number 
}>);

// Function to generate pagination URL
function getPaginationUrl(year: number, page: number) {
  const params = new URLSearchParams(searchParams);
  params.set(`${year}Page`, page.toString());
  return `?${params.toString()}#${year}`;
}

// Create SEO metadata
const seo = {
  title: "Photo Gallery | Dzaleka Online Services",
  description: "Explore our collection of photographs documenting life, culture, and stories from Dzaleka Refugee Camp. Browse photos by year and discover the rich visual heritage of our community.",
  type: "website",
  canonical: "https://services.dzaleka.com/photos",
  openGraph: {
    title: "Dzaleka Photo Gallery",
    description: "Explore our collection of photographs documenting life, culture, and stories from Dzaleka Refugee Camp. Browse photos by year and discover the rich visual heritage of our community.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/photos",
    image: {
      url: photos[0]?.data.image || "https://services.dzaleka.com/images/dzaleka-hero.jpeg",
      width: 1200,
      height: 630,
      alt: "Dzaleka Photo Gallery",
      type: "image/jpeg"
    }
  },
  twitter: {
    card: "summary_large_image",
    title: "Photo Gallery | Dzaleka Online Services",
    description: "Explore our collection of photographs documenting life, culture, and stories from Dzaleka Refugee Camp. Browse photos by year and discover the rich visual heritage of our community.",
    image: photos[0]?.data.image || "https://services.dzaleka.com/images/dzaleka-hero.jpeg"
  }
};

// Create structured data for photo gallery
const galleryStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Photo Gallery | Dzaleka Online Services",
  "description": "Explore our collection of photographs documenting life, culture, and stories from Dzaleka Refugee Camp.",
  "url": "https://services.dzaleka.com/photos",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://services.dzaleka.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Photo Gallery",
        "item": "https://services.dzaleka.com/photos"
      }
    ]
  },
  "mainEntity": {
    "@type": "ImageGallery",
    "name": "Dzaleka Photo Gallery",
    "description": "A collection of photographs documenting life, culture, and stories from Dzaleka Refugee Camp",
    "numberOfItems": photos.length,
    "itemListElement": years.map((year, yearIndex) => ({
      "@type": "ListItem",
      "position": yearIndex + 1,
      "item": {
        "@type": "CollectionPage",
        "name": `${year} Photos`,
        "description": `Photographs from the year ${year} in Dzaleka Refugee Camp`,
        "url": `https://services.dzaleka.com/photos/${year}`,
        "numberOfItems": photosByYear[year].length
      }
    })),
    "image": photos.map(photo => ({
      "@type": "ImageObject",
      "url": photo.data.image,
      "caption": photo.data.title,
      "creator": {
        "@type": "Person",
        "name": photo.data.photographer || "Dzaleka Community Photographers"
      },
      "license": "https://services.dzaleka.com/photos/license",
      "acquireLicensePage": "https://services.dzaleka.com/contact",
      "creditText": undefined,
      "copyrightNotice": undefined
    }))
  }
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(galleryStructuredData)} />
  
  <main class="min-h-screen">
    <!-- Hero Section with Pattern -->
    <div class="pattern-kitenge pattern-earth relative overflow-hidden">
      <div class="container mx-auto px-4 pt-8 pb-20">
        {/* Breadcrumb - would be added here if needed */}

        <div class="max-w-4xl mx-auto text-center">
          <h1 class="font-heading text-5xl md:text-6xl font-bold text-gray-900 mb-6 border-accent">
            Photo Gallery
          </h1>
          <p class="font-body text-xl md:text-2xl text-gray-700 mb-12 max-w-2xl mx-auto leading-relaxed">
            Visual stories from Dzaleka — moments of joy, resilience, and everyday life captured by our community
          </p>

          {/* Submit Photo Button */}
          <a
            href="/photos/submit"
            class="inline-flex items-center px-8 py-4 text-lg font-medium rounded-xl shadow-md text-white bg-primary-600 hover:bg-primary-700 transition-all duration-300 transform hover:scale-105"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Share Your Story
          </a>
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 py-16">
    
    {years.map(year => {
      const { photos, totalPhotos } = previewPhotosByYear[year];
      return (
        <div class="mb-20 scroll-reveal" id={year.toString()}>
          <div class="flex items-center justify-between mb-8">
            <div>
              <h2 class="font-heading text-4xl font-bold text-gray-900 flex items-center gap-4">
                {year}
              </h2>
              <p class="font-body text-lg text-gray-600 mt-2">{totalPhotos} photographs preserving our heritage</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
            {photos.map((photo, index) => {
              const isGallery = photo.data.gallery && photo.data.gallery.length > 0;
              return (
                <a
                  href={`/photos/${photo.id}`}
                  class={`group block bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-500 border-2 border-gray-100 hover:border-primary-200 animate-fade-in-up stagger-${(index % 9) + 1} ${isGallery ? 'gallery-card' : ''}`}
                >
                  <div class="relative">
                    {/* Stack Effects for Gallery */}
                    {isGallery && (
                      <>
                        <div class="absolute inset-0 bg-white border border-gray-300 rounded-xl transform translate-x-2 translate-y-2 rotate-3 transition-transform duration-300 group-hover:translate-x-3 group-hover:translate-y-3 group-hover:rotate-6 z-0 shadow-sm"></div>
                        <div class="absolute inset-0 bg-white border border-gray-300 rounded-xl transform -translate-x-2 -translate-y-2 -rotate-3 transition-transform duration-300 group-hover:-translate-x-3 group-hover:-translate-y-3 group-hover:-rotate-6 z-0 shadow-sm"></div>
                      </>
                    )}

                    {/* Main Image Container */}
                    <div class="aspect-w-4 aspect-h-3 bg-gradient-to-br from-gray-100 to-gray-50 relative overflow-hidden rounded-t-xl z-10 shadow-sm">
                      <img
                        src={photo.data.image}
                        alt={photo.data.title}
                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                      />
                      {/* Overlay on hover */}
                      <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                      
                      {/* Gallery Indicator Badge */}
                      {isGallery && (
                        <div class="absolute top-3 right-3 z-20">
                          <div class="bg-black/70 backdrop-blur-md text-white px-3 py-1.5 rounded-full flex items-center gap-2 shadow-lg border border-white/20 group-hover:bg-primary-600/90 transition-colors duration-300">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <span class="text-xs font-bold tracking-wide">{photo.data.gallery.length} PHOTOS</span>
                          </div>
                        </div>
                      )}
                    </div>
                  </div>

                  <div class="p-5 bg-white relative z-10 rounded-b-xl">
                    <h3 class="font-heading text-xl font-bold text-gray-900 group-hover:text-primary-600 transition-colors duration-300 mb-2 line-clamp-1">
                      {photo.data.title}
                    </h3>
                    <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-gray-600 font-body">
                      <span>{format(new Date(photo.data.date), 'MMMM d, yyyy')}</span>
                      {photo.data.photographer && (
                        <span class="flex items-center gap-1">
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                          </svg>
                          {typeof photo.data.photographer === 'string' 
                            ? photo.data.photographer 
                            : photo.data.photographer.name}
                        </span>
                      )}
                    </div>
                    <p class="mt-3 text-sm text-gray-700 line-clamp-2 leading-relaxed">
                      {photo.data.description}
                    </p>
                    {photo.data.tags && (
                      <div class="mt-4 flex flex-wrap gap-2">
                        {photo.data.tags.slice(0, 3).map(tag => (
                          <span class="px-3 py-1 bg-primary-50 text-primary-700 border border-primary-100 rounded-full text-xs font-medium">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              );
            })}
          </div>

          {totalPhotos > 3 && (
            <div class="text-center">
              <a
                href={`/photos/${year}`}
                class="inline-flex items-center px-8 py-4 bg-primary-600 text-white rounded-xl hover:bg-primary-700 transition-all duration-300 transform hover:scale-105 shadow-md font-body font-medium group"
              >
                Explore All {year} Photos
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          )}
        </div>
      );
    })}
    </div>
  </main>
</MainLayout>
