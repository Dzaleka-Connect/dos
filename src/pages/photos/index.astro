---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import PhotoArchiveCard from '../../components/photos/PhotoArchiveCard.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';

// Get all photos
const photos = await getCollection('photos');

// Group photos by year
const photosByYear = photos.reduce((acc, photo) => {
  const year = new Date(photo.data.date).getFullYear();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(photo);
  return acc;
}, {} as Record<number, typeof photos>);

// Sort years in descending order
const years = Object.keys(photosByYear)
  .map(Number)
  .sort((a, b) => b - a);

const siteUrl = "https://services.dzaleka.com";
const toAbsoluteUrl = (value?: string) => {
  if (!value) return `${siteUrl}/images/dzaleka-hero.jpeg`;
  return value.startsWith('http') ? value : `${siteUrl}${value}`;
};

// Sort photos within each year and get top 3
const previewPhotosByYear = years.reduce((acc, year) => {
  // Sort photos for this year
  const yearPhotos = photosByYear[year].sort((a, b) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  acc[year] = {
    photos: yearPhotos.slice(0, 3),
    totalPhotos: yearPhotos.length
  };

  return acc;
}, {} as Record<number, {
  photos: typeof photos,
  totalPhotos: number
}>);

// Create SEO metadata
const seo = {
  title: "Photo Archive | Dzaleka Online Services",
  description: "Browse photographs documenting daily life, work, culture, events, and community memory in Dzaleka Refugee Camp.",
  type: "website",
  canonical: "https://services.dzaleka.com/photos",
  openGraph: {
    title: "Dzaleka Photo Archive",
    description: "Browse photographs documenting daily life, work, culture, events, and community memory in Dzaleka Refugee Camp.",
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/photos",
    image: {
      url: toAbsoluteUrl(photos[0]?.data.image),
      width: 1200,
      height: 630,
      alt: "Dzaleka Photo Archive",
      type: "image/jpeg"
    }
  },
  twitter: {
    card: "summary_large_image",
    title: "Photo Archive | Dzaleka Online Services",
    description: "Browse photographs documenting daily life, work, culture, events, and community memory in Dzaleka Refugee Camp.",
    image: toAbsoluteUrl(photos[0]?.data.image)
  }
};

// Create structured data for photo gallery
const galleryStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Photo Archive | Dzaleka Online Services",
  "description": "Photographs documenting daily life, work, culture, events, and community memory in Dzaleka Refugee Camp.",
  "url": "https://services.dzaleka.com/photos",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://services.dzaleka.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Photo Archive",
        "item": "https://services.dzaleka.com/photos"
      }
    ]
  },
  "mainEntity": {
    "@type": "ImageGallery",
    "name": "Dzaleka Photo Archive",
    "description": "A collection of photographs documenting daily life, work, culture, events, and community memory in Dzaleka Refugee Camp",
    "numberOfItems": photos.length,
    "itemListElement": years.map((year, yearIndex) => ({
      "@type": "ListItem",
      "position": yearIndex + 1,
      "item": {
        "@type": "CollectionPage",
        "name": `${year} Photos`,
        "description": `Photographs from the year ${year} in Dzaleka Refugee Camp`,
        "url": `https://services.dzaleka.com/photos/${year}`,
        "numberOfItems": photosByYear[year].length
      }
    })),
    "image": photos.map(photo => ({
      "@type": "ImageObject",
      "url": toAbsoluteUrl(photo.data.image),
      "caption": photo.data.title,
      "creator": {
        "@type": "Person",
        "name": typeof photo.data.photographer === 'string'
          ? photo.data.photographer
          : (photo.data.photographer?.name || "Dzaleka Community Photographers")
      },
      "license": "https://services.dzaleka.com/photos/license",
      "acquireLicensePage": "https://services.dzaleka.com/contact",
      "creditText": `Photo by ${typeof photo.data.photographer === 'string'
        ? photo.data.photographer
        : (photo.data.photographer?.name || "Dzaleka Community Photographers")}`,
      "copyrightNotice": `© ${new Date(photo.data.date).getFullYear()} ${typeof photo.data.photographer === 'string'
        ? photo.data.photographer
        : (photo.data.photographer?.name || "Dzaleka Community Photographers")}`
    }))
  }
};
---

<MainLayout
  title={seo.title}
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(galleryStructuredData)} />

  <header class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Photo Archive' }]} />
      <div class="mt-5 flex flex-wrap items-end justify-between gap-5">
        <div class="max-w-2xl">
          <h1 class="text-primary-900">Photo Archive</h1>
          <p class="mt-4 text-base leading-7 text-slate-600">Explore photographs of Dzaleka’s daily life, culture and community history. Open a photograph for its caption, date and photographer credits.</p>
        </div>
        <Button href="/photos/submit" variant="secondary">Contribute a photograph</Button>
      </div>
      <nav class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm" aria-label="Photo Archive information">
        <a href="/photos/contributors" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Photographers</a>
        <a href="/photos/license" class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4">Using archive photographs</a>
      </nav>
    </div>
  </header>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <nav class="mb-10 border-b border-slate-200 pb-6" aria-label="Browse photographs by year">
      <p class="mb-3 text-sm font-semibold text-slate-900">Browse by year</p>
      <ul class="flex flex-wrap gap-2">{years.map((year) => <li><a href={`#${year}`} class="inline-flex min-h-[44px] items-center rounded border border-slate-300 px-4 py-2 text-sm text-primary-800 hover:bg-slate-50">{year}</a></li>)}</ul>
    </nav>
    {years.map((year) => <section class="mb-12" id={year.toString()} aria-labelledby={`year-${year}`}>
      <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
        <div><h2 id={`year-${year}`} class="text-primary-900">{year}</h2><p class="mt-1 text-sm text-slate-600">{previewPhotosByYear[year].totalPhotos} archive {previewPhotosByYear[year].totalPhotos === 1 ? 'entry' : 'entries'}</p></div>
        <a href={`/photos/${year}`} class="inline-flex min-h-[44px] items-center text-sm font-medium text-primary-800 underline underline-offset-4">View all {year} photographs <span class="ml-2" aria-hidden="true">→</span></a>
      </div>
      <div class="grid auto-rows-fr gap-6 sm:grid-cols-2 lg:grid-cols-3">{previewPhotosByYear[year].photos.map((photo) => <PhotoArchiveCard photo={photo} />)}</div>
    </section>)}
  </div>
</MainLayout>
