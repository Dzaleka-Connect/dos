---
import { photographerSlug } from '../../utils/photographerSlug';
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import RecordGallery from '../../components/records/RecordGallery.astro';
import RecordFacts from '../../components/records/RecordFacts.astro';
import RecordTools from '../../components/records/RecordTools.astro';
import PhotoArchiveCard from '../../components/photos/PhotoArchiveCard.astro';
import { recordImages, formatRecordDate, sameRecordValue } from '../../utils/recordMedia';
import '../../styles/records.css';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const photos = await getCollection('photos');
  return photos.map(photo => ({
    params: { slug: photo.id },
    props: { photo }
  }));
}

const { photo } = Astro.props;
const { title, description, photographer, image, date, tags, location, gallery } = photo.data;
const { Content } = await render(photo);
const siteUrl = "https://services.dzaleka.com";
const toAbsoluteUrl = (value?: string) => {
  if (!value) return `${siteUrl}/images/dzaleka-hero.jpeg`;
  return value.startsWith('http') ? value : `${siteUrl}${value}`;
};
const photographerName = typeof photographer === 'string'
  ? photographer
  : (photographer?.name || "Dzaleka Community Photographers");

// Get related photos based on tags and location
const allPhotos = await getCollection('photos');
const relatedPhotos = allPhotos
  .filter(p =>
    p.id !== photo.id && // Exclude current photo
    (
      // Match by tags
      (p.data.tags && photo.data.tags &&
        p.data.tags.some(tag => photo.data.tags.includes(tag))) ||
      // Match by location
      sameRecordValue(p.data.location, photo.data.location) ||
      // Match by photographer
      sameRecordValue(typeof p.data.photographer === 'string' ? p.data.photographer : p.data.photographer?.name, photographerName)
    )
  )
  .slice(0, 3); // Limit to 3 related photos

// Create SEO metadata
const seo = {
  title: `${title} | Dzaleka Online Services`,
  description: description,
  image: image,
  type: "article",
  canonical: `https://services.dzaleka.com/photos/${photo.id}`,
  openGraph: {
    title: `${title} | Dzaleka Online Services`,
    description: description,
    type: "article",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/photos/${photo.id}`,
    image: {
      url: toAbsoluteUrl(image),
      width: 1200,
      height: 630,
      alt: title,
      type: "image/jpeg"
    }
  }
};

const photoStructuredData = {
  "@context": "https://schema.org",
  "@type": "Photograph",
  "name": title,
  "description": description,
  "url": `https://services.dzaleka.com/photos/${photo.id}`,
  "dateCreated": new Date(date).toISOString(),
  "contentUrl": toAbsoluteUrl(image),
  "image": {
    "@type": "ImageObject",
    "url": toAbsoluteUrl(image),
    "caption": title,
    "creator": {
      "@type": "Person",
      "name": photographerName
    },
    "creditText": `Photo by ${photographerName}`,
    "copyrightNotice": `© ${new Date(date).getFullYear()} ${photographerName}`,
    "license": "https://services.dzaleka.com/photos/license",
    "acquireLicensePage": "https://services.dzaleka.com/contact"
  },
  "creator": {
    "@type": "Person",
    "name": photographerName
  },
  "keywords": tags?.join(", "),
  "locationCreated": location ? {
    "@type": "Place",
    "name": location
  } : undefined
};

const images = recordImages(image, gallery || []);
const creator = typeof photographer === 'string' ? { name: photographer } : photographer;
const creatorHref = `/photos/contributor/${photographerSlug(photo.data.contributor, photographerName)}`;
const facts = [
  { label: 'Photographer', value: photographerName, href: creatorHref },
  { label: 'Date photographed', value: formatRecordDate(date) },
  { label: 'Location', value: location },
  { label: 'Images in this record', value: images.length },
  { label: 'Topics', value: tags },
];
---
<MainLayout title={seo.title} description={seo.description} image={seo.image} type={seo.type} canonical={seo.canonical} openGraph={seo.openGraph}>
  <script type="application/ld+json" set:html={JSON.stringify(photoStructuredData)} />
  <div class="record-detail bg-white">
    <header class="border-b border-slate-200 bg-slate-50"><div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Photo Archive', href: '/photos' }, { label: title }]} />
      <div class="mt-5 max-w-4xl"><h1 class="text-primary-900">{title}</h1><p class="mt-4 text-base leading-7 text-slate-700">{description}</p><p class="mt-4 text-sm text-slate-600">Photographs by <a href={creatorHref} class="text-primary-800 underline underline-offset-4">{photographerName}</a><span class="mx-2" aria-hidden="true">·</span><time datetime={new Date(date).toISOString()}>{formatRecordDate(date)}</time></p></div>
    </div></header>
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-10">
        <div class="min-w-0 space-y-8">
          <RecordGallery images={images} title={title} credit={`Photo: ${photographerName}`} />
          <article class="record-prose prose prose-slate max-w-none"><Content /></article>
        </div>
        <aside class="min-w-0 space-y-8" aria-label="Photo record information">
          <section class="record-meta"><h2 class="text-primary-900">Photo information</h2><RecordFacts facts={facts} />
            {creator?.instagram && <a href={`https://www.instagram.com/${creator.instagram.replace(/^@/, '')}/`} class="mt-4 inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">Photographer on Instagram ↗</a>}
          </section>
          <section class="record-section"><h2 class="text-primary-900">Using this photograph</h2><p class="text-sm leading-6 text-slate-700">Keep the photographer’s credit with the image. Check the archive’s usage policy before reusing or publishing a copy.</p><a href="/photos/license" class="mt-3 inline-flex min-h-[44px] items-center text-sm text-primary-800 underline underline-offset-4">Photo licence and usage policy →</a></section>
          <RecordTools title={title} url={seo.canonical} printHref={`/photos/${photo.id}/print`} />
        </aside>
      </div>
      {relatedPhotos.length > 0 && <section class="record-section mt-12"><h2 class="text-primary-900">More from the Photo Archive</h2><div class="grid auto-rows-fr gap-6 sm:grid-cols-2 lg:grid-cols-3">{relatedPhotos.map(relatedPhoto => <PhotoArchiveCard photo={relatedPhoto} />)}</div></section>}
    </div>
  </div>
</MainLayout>
