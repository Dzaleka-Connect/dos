---
import { getCollection, render } from 'astro:content';
import RecordPrintLayout from '../../../layouts/RecordPrintLayout.astro';
import RecordFacts from '../../../components/records/RecordFacts.astro';
import { recordImages, formatRecordDate } from '../../../utils/recordMedia';

export async function getStaticPaths() {
  return (await getCollection('photos')).map(photo => ({ params: { slug: photo.id }, props: { photo } }));
}
const { photo } = Astro.props;
const { title, description, photographer, image, gallery, date, tags, location } = photo.data;
const { Content } = await render(photo);
const images = recordImages(image, gallery || []);
const name = typeof photographer === 'string' ? photographer : photographer?.name || 'Dzaleka Community Photographers';
const facts = [
  { label: 'Photographer', value: name },
  { label: 'Date photographed', value: formatRecordDate(date) },
  { label: 'Location', value: location },
  { label: 'Topics', value: tags },
  { label: 'Images in the online record', value: images.length },
];
---
<RecordPrintLayout title={title} description={description} collection="Photo Archive" href={`/photos/${photo.id}`}>
  {images[0] && <figure><img src={images[0]} alt={title} /><figcaption>Photo: {name}{images.length > 1 && ` · Cover image; view all ${images.length} photographs in the online record.`}</figcaption></figure>}
  <RecordFacts facts={facts} />
  <article><Content /></article>
  <section><h2>Image usage</h2><p>Keep the photographer’s credit with the image. Review the <a href="/photos/license">photo licence and usage policy</a> before reusing or publishing a copy.</p></section>
</RecordPrintLayout>
