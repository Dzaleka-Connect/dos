---
import { getCollection } from 'astro:content';
import { format } from 'date-fns';

export async function getStaticPaths() {
  const photos = await getCollection('photos');
  return photos.map(photo => ({
    params: { slug: photo.id },
    props: { photo }
  }));
}

const { photo } = Astro.props;
const { title, description, photographer, image, date, tags, location } = photo.data;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | Dzaleka Online Services</title>
  <style>
    /* Base styles */
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.6;
      color: #1f2937;
      max-width: 100%;
      margin: 0;
      padding: 2rem;
      background: #f9fafb;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      background: white;
      padding: 2rem;
      border-radius: 1rem;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    }

    .header {
      text-align: center;
      margin-bottom: 2rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid #e5e7eb;
    }

    .header h1 {
      font-size: 2rem;
      font-weight: 700;
      color: #111827;
      margin-bottom: 0.5rem;
    }

    .header p {
      color: #6b7280;
      font-size: 1.125rem;
    }

    .photo-container {
      margin-bottom: 2rem;
      text-align: center;
    }

    .photo-container img {
      max-width: 100%;
      height: auto;
      border-radius: 0.5rem;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-bottom: 2rem;
    }

    .info-section {
      background: #f9fafb;
      padding: 1.5rem;
      border-radius: 0.5rem;
    }

    .info-section h2 {
      font-size: 1.25rem;
      font-weight: 600;
      color: #111827;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid #e5e7eb;
    }

    .meta-item {
      margin-bottom: 1rem;
    }

    .meta-label {
      font-weight: 600;
      color: #4b5563;
      display: block;
      margin-bottom: 0.25rem;
    }

    .meta-value {
      color: #111827;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tag {
      background: #e5e7eb;
      color: #374151;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.875rem;
    }

    .footer {
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 2px solid #e5e7eb;
      text-align: center;
      color: #6b7280;
      font-size: 0.875rem;
    }

    .print-button {
      position: fixed;
      top: 1rem;
      right: 1rem;
      background: #4f46e5;
      color: white;
      padding: 0.75rem 1.5rem;
      border-radius: 0.5rem;
      font-weight: 500;
      cursor: pointer;
      border: none;
      box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
      transition: all 0.2s;
    }

    .print-button:hover {
      background: #4338ca;
      transform: translateY(-1px);
    }

    /* Print-specific styles */
    @media print {
      body {
        background: white;
        padding: 0;
      }

      .container {
        box-shadow: none;
        padding: 0;
      }

      .print-button {
        display: none;
      }

      .photo-container img {
        box-shadow: none;
      }

      .info-section {
        background: none;
        padding: 0;
      }

      .tag {
        border: 1px solid #e5e7eb;
      }

      @page {
        margin: 2cm;
      }
    }
  </style>
</head>
<body>
  <button onclick="window.print()" class="print-button">
    Print Photo
  </button>

  <div class="container">
    <div class="header">
      <h1>{title}</h1>
      <p>Dzaleka Online Services</p>
    </div>

    <div class="photo-container">
      <img src={image} alt={title} />
    </div>

    <div class="info-grid">
      <div class="info-section">
        <h2>Photo Details</h2>
        <div class="meta-item">
          <span class="meta-label">Photographer</span>
          <span class="meta-value">
            {photographer.name}
            {photographer.instagram && (
              <span> (@{photographer.instagram})</span>
            )}
          </span>
        </div>

        <div class="meta-item">
          <span class="meta-label">Date</span>
          <span class="meta-value">{format(new Date(date), 'MMMM d, yyyy')}</span>
        </div>

        {location && (
          <div class="meta-item">
            <span class="meta-label">Location</span>
            <span class="meta-value">{location}</span>
          </div>
        )}
      </div>

      <div class="info-section">
        <h2>Description</h2>
        <p>{description}</p>

        {tags && tags.length > 0 && (
          <div class="meta-item">
            <span class="meta-label">Tags</span>
            <div class="tags">
              {tags.map(tag => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>

    <div class="footer">
      <p>© {new Date().getFullYear()} Dzaleka Online Services</p>
      <p>Printed on {new Date().toLocaleDateString()}</p>
      <p>URL: https://services.dzaleka.com/photos/{photo.id}</p>
    </div>
  </div>

  <script>
    // Add print functionality
    document.addEventListener('keydown', (e) => {
      if (e.ctrlKey && e.key === 'p') {
        e.preventDefault();
        window.print();
      }
    });
  </script>
</body>
</html> 