---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { format } from 'date-fns';
import Badge from '../../components/ui/Badge.astro';

export async function getStaticPaths() {
  const photos = await getCollection('photos');
  return photos.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Get the year for breadcrumb
const photoYear = new Date(entry.data.date).getFullYear();

// Create SEO metadata
const seo = {
  title: `${entry.data.title}`,
  description: entry.data.description || `A photograph by ${entry.data.photographer.name} taken on ${format(entry.data.date, 'MMMM d, yyyy')}${entry.data.location ? ` in ${entry.data.location}` : ''}.`,
  image: entry.data.image,
  type: "article",
  canonical: `https://services.dzaleka.com/photos/${entry.id}`,
  openGraph: {
    title: `${entry.data.title}`,
    description: entry.data.description || `A photograph by ${entry.data.photographer.name} taken on ${format(entry.data.date, 'MMMM d, yyyy')}${entry.data.location ? ` in ${entry.data.location}` : ''}.`,
    type: "article",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: `https://services.dzaleka.com/photos/${entry.id}`,
    image: {
      url: entry.data.image,
      width: 1200,
      height: 630,
      alt: entry.data.title,
      type: "image/jpeg"
    }
  },
  twitter: {
    card: "summary_large_image",
    title: `${entry.data.title} | Dzaleka Photo Gallery`,
    description: entry.data.description || `A photograph by ${entry.data.photographer.name} taken on ${format(entry.data.date, 'MMMM d, yyyy')}${entry.data.location ? ` in ${entry.data.location}` : ''}.`,
    image: entry.data.image,
    creator: entry.data.photographer.twitter || "@DzalekaConnect"
  }
};

// Create structured data for photo
const photoStructuredData = {
  "@context": "https://schema.org",
  "@type": "ImageObject",
  "name": entry.data.title,
  "description": entry.data.description || `A photograph by ${entry.data.photographer.name} taken on ${format(entry.data.date, 'MMMM d, yyyy')}${entry.data.location ? ` in ${entry.data.location}` : ''}.`,
  "contentUrl": entry.data.image,
  "datePublished": entry.data.date.toISOString(),
  "creator": {
    "@type": "Person",
    "name": entry.data.photographer.name,
    "url": entry.data.photographer.website || undefined
  },
  "locationCreated": entry.data.location ? {
    "@type": "Place",
    "name": entry.data.location
  } : undefined,
  "keywords": entry.data.tags.join(", "),
  "license": "https://creativecommons.org/licenses/by-nc-sa/4.0/",
  "acquireLicensePage": "https://services.dzaleka.com/contact",
  "creditText": `Photo by ${entry.data.photographer.name}`,
  "copyrightNotice": `© ${new Date().getFullYear()} ${entry.data.photographer.name}. All rights reserved.`,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://services.dzaleka.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Photo Gallery",
        "item": "https://services.dzaleka.com/photos"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": photoYear.toString(),
        "item": `https://services.dzaleka.com/photos/${photoYear}`
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": entry.data.title,
        "item": `https://services.dzaleka.com/photos/${entry.id}`
      }
    ]
  }
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  image={seo.image} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
  twitter={seo.twitter}
>
  <script type="application/ld+json" set:html={JSON.stringify(photoStructuredData)} />
  
  <main class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-sm text-gray-600 mb-6">
        <a href="/photos" class="hover:text-primary-600">Gallery</a>
        <span>/</span>
        <a href={`/photos/${photoYear}`} class="hover:text-primary-600">{photoYear}</a>
        <span>/</span>
        <span class="text-gray-900">{entry.data.title}</span>
      </nav>

      <!-- Return Button -->
      <div class="mb-6">
        <a 
          href="javascript:history.back()" 
          class="inline-flex items-center gap-2 text-gray-600 hover:text-primary-600 group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          <span>Back</span>
        </a>
      </div>

      <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        <!-- Hero Image -->
        <div class="relative">
          <img 
            src={entry.data.image} 
            alt={entry.data.title}
            class="w-full h-[60vh] object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent">
            <div class="absolute bottom-0 p-8">
              <h1 class="text-4xl font-bold text-white mb-4">
                {entry.data.title}
              </h1>
              <div class="flex flex-wrap gap-2 mb-4">
                {entry.data.tags.map(tag => (
                  <Badge variant="blue">{tag}</Badge>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Content -->
        <div class="p-8">
          <!-- Photo Description and Story -->
          <div class="prose prose-lg max-w-none">
            <Content />
          </div>

          <!-- Photographer Info -->
          <div class="flex items-center justify-between mt-8 pt-8 border-t">
            <div class="flex items-center gap-4">
              <div>
                <h2 class="text-xl font-bold text-gray-900">
                  {entry.data.photographer.name}
                </h2>
                <div class="flex items-center gap-4 mt-2">
                  {entry.data.photographer.instagram && (
                    <a 
                      href={`https://instagram.com/${entry.data.photographer.instagram}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary-600 hover:text-primary-700 flex items-center gap-1"
                    >
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                      </svg>
                      @{entry.data.photographer.instagram}
                    </a>
                  )}
                  {entry.data.photographer.website && (
                    <a 
                      href={entry.data.photographer.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary-600 hover:text-primary-700"
                    >
                      Portfolio →
                    </a>
                  )}
                </div>
              </div>
            </div>
            <div class="text-right">
              <time 
                datetime={entry.data.date.toISOString()}
                class="text-gray-500"
              >
                {format(entry.data.date, 'MMMM d, yyyy')}
              </time>
              {entry.data.location && (
                <p class="text-gray-500 mt-1">{entry.data.location}</p>
              )}
              <button 
                onclick="window.print()"
                class="mt-4 inline-flex items-center gap-2 text-primary-600 hover:text-primary-700 group"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                <span>Print</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</MainLayout>

<style>
  @media print {
    /* Hide elements that shouldn't be printed */
    nav, button, .no-print {
      display: none !important;
    }
    
    /* Ensure the image and content are properly displayed */
    img {
      max-height: 50vh !important;
      object-fit: contain !important;
    }
    
    /* Adjust text colors for better printing */
    .text-gray-500, .text-gray-600 {
      color: #000 !important;
    }
    
    /* Ensure proper page breaks */
    .prose {
      page-break-inside: avoid;
    }
  }
</style>