---
import MainLayout from '../layouts/MainLayout.astro';
import ArtCatalogue from '../components/culture/ArtCatalogue.astro';
export const prerender = false;
const currentPage = Number.parseInt(Astro.url.searchParams.get('page') || '1', 10);
---
<MainLayout title="Public Art Catalogue | Dzaleka Online Services" description="Browse public artworks, murals, artists and cultural documentation from Dzaleka." canonical="https://services.dzaleka.com/public-art-catalogue">
  <ArtCatalogue currentPage={currentPage} />
</MainLayout>
