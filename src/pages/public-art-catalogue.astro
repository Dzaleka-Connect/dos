---
import Layout from '../layouts/Layout.astro';
import MainLayout from '../layouts/MainLayout.astro';

const title = "Dzaleka Public Art & Visual Culture";
const description = "Explore and celebrate public artworks, visual media, and cultural expressions in Dzaleka Refugee Camp. Discover the stories behind murals, sculptures, installations, and visual content created by talented artists who call Dzaleka home.";

// Pagination settings
const itemsPerPage = 9; // Show 9 items per page (3x3 grid)
const currentPage = 1; // Default to first page

// Dynamically import all artwork content
let artworks = [];
try {
  artworks = await Astro.glob('../content/artworks/*.md');
} catch (error) {
  console.error('Error loading artworks:', error);
  artworks = [];
}

// Load artist spotlight data
let spotlightArtists = [];
try {
  const allArtists = await Astro.glob('../content/artists/*.md');
  spotlightArtists = allArtists
    .filter(artist => artist.frontmatter.spotlight)
    .slice(0, 6); // Show up to 6 artists in spotlight
} catch (error) {
  console.error('Error loading artist spotlight:', error);
  spotlightArtists = [];
}

// Sort artworks by featured status and title
artworks.sort((a, b) => {
  if (a.frontmatter.featured && !b.frontmatter.featured) return -1;
  if (!a.frontmatter.featured && b.frontmatter.featured) return 1;
  return a.frontmatter.title.localeCompare(b.frontmatter.title);
});

// Calculate pagination
const totalItems = artworks.length;
const totalPages = Math.ceil(totalItems / itemsPerPage);
const startIndex = (currentPage - 1) * itemsPerPage;
const endIndex = startIndex + itemsPerPage;
const currentArtworks = artworks.slice(startIndex, endIndex);

// Generate pagination info
const pagination = {
  currentPage,
  totalPages,
  totalItems,
  hasNextPage: currentPage < totalPages,
  hasPrevPage: currentPage > 1,
  nextPage: currentPage + 1,
  prevPage: currentPage - 1,
  startItem: startIndex + 1,
  endItem: Math.min(endIndex, totalItems)
};
---

<MainLayout title={title} description={description}>
  <Layout>
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-br from-slate-50 to-white border-b-2 border-slate-200 mb-12 overflow-hidden">
      <div class="absolute inset-0 opacity-[0.03]">
        <div class="absolute inset-0 pattern-mudcloth"></div>
      </div>

      <div class="relative container mx-auto px-4 py-16">
        <div class="max-w-4xl mx-auto text-center">
          <div class="inline-block mb-6">
            <span class="px-4 py-1.5 bg-slate-100 text-slate-700 rounded-full text-sm font-medium border border-slate-200">
              Public Art & Visual Culture
            </span>
          </div>

          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
            Dzaleka Art Catalogue
          </h1>
          <p class="text-xl text-gray-600 mb-8 max-w-3xl mx-auto leading-relaxed">
            Celebrating creativity and cultural expression through public art and visual media in Dzaleka
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="#artworks" class="inline-flex items-center px-6 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors font-medium">
              View Artworks
            </a>
            <a href="/public-art-catalogue/submit" class="inline-flex items-center px-6 py-3 border-2 border-gray-900 text-gray-900 bg-white rounded-lg hover:bg-slate-50 transition-colors font-medium">
              Submit Artwork
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Artworks Section -->
    <section id="artworks" class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Featured Artworks & Visual Content</h2>
          <p class="text-lg text-gray-600">Discover the creativity and talent of Dzaleka's artists and visual creators</p>
        </div>

        <!-- Dynamic artwork listings -->
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {currentArtworks.length > 0 ? (
            currentArtworks.map((artwork) => (
              <div class="bg-white border border-gray-200 rounded-xl hover:border-slate-400 transition-colors duration-300 group overflow-hidden">
                <div class="relative h-64 bg-gray-100">
                  {artwork.frontmatter.image ? (
                    <img src={artwork.frontmatter.image} alt={artwork.frontmatter.title} class="w-full h-full object-cover transition-opacity duration-700" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-slate-50">
                      <svg class="w-16 h-16 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  <div class="absolute top-4 left-4">
                    <span class="bg-white/90 backdrop-blur-sm text-slate-700 px-3 py-1 rounded-full text-xs font-medium shadow-sm border border-slate-200">
                      {artwork.frontmatter.category}
                    </span>
                  </div>
                  {artwork.frontmatter.featured && (
                    <div class="absolute top-4 right-4">
                      <span class="bg-yellow-400 text-yellow-900 px-2 py-1 rounded text-xs font-bold shadow-sm">
                        Featured
                      </span>
                    </div>
                  )}
                </div>
                <div class="p-6">
                  <div class="mb-4">
                    <h3 class="text-lg font-bold text-gray-900 group-hover:text-slate-700 transition-colors mb-1">
                      {artwork.frontmatter.title}
                    </h3>
                    <p class="text-sm text-gray-500 mb-2">by <span class="font-medium text-gray-700">{artwork.frontmatter.artistName}</span></p>
                    <div class="flex items-center text-xs text-gray-500 mb-3">
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      {artwork.frontmatter.campZone}
                    </div>
                  </div>
                  <p class="text-gray-600 mb-6 line-clamp-2 text-sm leading-relaxed">
                    {artwork.frontmatter.description || 'Experience the creativity and cultural expression of this remarkable artwork...'}
                  </p>
                  <div class="pt-4 border-t border-gray-50">
                    <a href={`/public-art-catalogue/${artwork.file.split('/').pop().replace('.md', '')}`} class="inline-flex items-center text-slate-700 font-medium hover:text-slate-900 text-sm">
                      View Details
                      <svg class="w-4 h-4 ml-1 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            ))
          ) : (
            <div class="col-span-full text-center py-16">
              <div class="max-w-md mx-auto">
                <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
                  <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zM21 5a2 2 0 00-2-2h-4a2 2 0 00-2 2v12a4 4 0 004 4h4a2 2 0 002-2V5z" />
                  </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">No Artworks Yet</h3>
                <p class="text-gray-600 mb-6">Be the first to submit a public artwork to our catalogue!</p>
                <a href="/public-art-catalogue/submit" class="inline-flex items-center bg-gray-900 text-white px-6 py-3 rounded-lg font-semibold hover:bg-gray-800 transition-colors">
                  Submit First Artwork
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                </a>
              </div>
            </div>
          )}
        </div>

        {/* Pagination Controls */}
        {totalPages > 1 && (
          <div class="mt-12">
            <div class="flex items-center justify-between border-t border-gray-200 pt-6">
              {/* Results info */}
              <div class="text-sm text-gray-500">
                Showing <span class="font-medium text-gray-900">{pagination.startItem}</span> to <span class="font-medium text-gray-900">{pagination.endItem}</span> of <span class="font-medium text-gray-900">{pagination.totalItems}</span> results
              </div>
              
              {/* Pagination buttons */}
              <div class="flex items-center space-x-2">
                {/* Previous button */}
                {pagination.hasPrevPage ? (
                  <a href={`/public-art-catalogue?page=${pagination.prevPage}`} class="inline-flex items-center px-3 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Previous
                  </a>
                ) : (
                  <button disabled class="inline-flex items-center px-3 py-2 border border-gray-200 rounded-md text-sm font-medium text-gray-400 bg-gray-50 cursor-not-allowed">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Previous
                  </button>
                )}
                
                {/* Page numbers */}
                <div class="hidden md:flex items-center space-x-1">
                  {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
                    pageNum === currentPage ? (
                      <span class="inline-flex items-center px-3 py-2 border border-slate-500 rounded-md text-sm font-medium text-slate-700 bg-slate-50">
                        {pageNum}
                      </span>
                    ) : (
                      <a href={`/public-art-catalogue?page=${pageNum}`} class="inline-flex items-center px-3 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                        {pageNum}
                      </a>
                    )
                  ))}
                </div>
                
                {/* Next button */}
                {pagination.hasNextPage ? (
                  <a href={`/public-art-catalogue?page=${pagination.nextPage}`} class="inline-flex items-center px-3 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors">
                    Next
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </a>
                ) : (
                  <button disabled class="inline-flex items-center px-3 py-2 border border-gray-200 rounded-md text-sm font-medium text-gray-400 bg-gray-50 cursor-not-allowed">
                    Next
                    <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                  </button>
                )}
              </div>
            </div>
          </div>
        )}

        <div class="text-center mt-12">
          <a href="/public-art-catalogue/submit" class="inline-flex items-center justify-center px-6 py-3 bg-gray-900 text-white font-medium rounded-lg hover:bg-gray-800 transition-colors shadow-sm hover:shadow-md">
            Submit New Artwork
          </a>
        </div>
      </div>
    </section>

    <!-- Artist Spotlight Section -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 mb-4">Artist Spotlight</h2>
          <p class="text-lg text-gray-600 mb-6">Meet the talented artists and visual creators behind Dzaleka's public art and visual culture</p>
          <a href="/public-art-catalogue/visual-arts-community" class="inline-flex items-center text-slate-700 hover:text-slate-900 font-medium text-sm">
            View All Visual Artists
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {spotlightArtists.length > 0 ? (
            spotlightArtists.map((artist) => (
              <div class="bg-white border border-gray-200 rounded-xl hover:border-slate-400 transition-colors duration-300 group overflow-hidden">
                <div class="relative h-48 bg-gray-100">
                  {artist.frontmatter.image ? (
                    <img src={artist.frontmatter.image} alt={artist.frontmatter.artistName} class="w-full h-full object-cover transition-opacity duration-700" />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-slate-50">
                      <svg class="w-16 h-16 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                      </svg>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  <div class="absolute top-3 left-3">
                    <span class="bg-white/90 backdrop-blur-sm text-slate-700 px-2.5 py-0.5 rounded-full text-xs font-medium shadow-sm">
                      {artist.frontmatter.medium}
                    </span>
                  </div>
                </div>
                <div class="p-4">
                  <div class="mb-3">
                    <h3 class="text-lg font-bold text-gray-900 group-hover:text-slate-700 transition-colors mb-1">
                      {artist.frontmatter.artistName}
                    </h3>
                    <div class="flex items-center text-xs text-gray-500 mb-2">
                      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      {artist.frontmatter.nationality}
                    </div>
                  </div>
                  <p class="text-gray-600 mb-4 line-clamp-2 text-sm leading-relaxed">
                    {artist.frontmatter.bio}
                  </p>
                  <div class="pt-3 border-t border-gray-50">
                    <a href={`/public-art-catalogue/artist/${artist.file.split('/').pop().replace('.md', '')}`} class="inline-flex items-center text-slate-700 font-medium hover:text-slate-900 text-sm">
                      View Profile
                      <svg class="w-3 h-3 ml-1 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            ))
          ) : (
            <div class="col-span-full text-center py-16">
              <div class="max-w-md mx-auto">
                <div class="w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
                  <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2">No Featured Artists Yet</h3>
                <p class="text-gray-600 mb-6">Be the first artist to be featured in our spotlight!</p>
                <a href="/public-art-catalogue/submit" class="inline-flex items-center bg-gray-900 text-white px-6 py-3 rounded-lg font-semibold hover:bg-gray-800 transition-colors">
                  Submit Your Artwork
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                </a>
              </div>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- How to Contribute Section -->
    <section class="py-16 border-t border-gray-100">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Contribute to the Archive</h2>
        <p class="text-gray-600 mb-8 max-w-2xl mx-auto">Help us document Dzaleka's vibrant visual culture. Submit your own artwork or share photos of public art you've discovered.</p>
        
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/public-art-catalogue/submit" class="inline-flex items-center justify-center px-6 py-3 bg-gray-900 text-white font-medium rounded-lg hover:bg-gray-800 transition-colors">
            Submit Artwork
          </a>
          <a href="/photo-guidelines" class="inline-flex items-center justify-center px-6 py-3 bg-white text-gray-700 border border-gray-300 font-medium rounded-lg hover:bg-gray-50 transition-colors">
            View Guidelines
          </a>
        </div>
      </div>
    </section>
  </Layout>
</MainLayout>
