---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { format } from 'date-fns';
import Badge from '../components/ui/Badge.astro';

// Get all photos and sort by date
const photos = await getCollection('photos');
const sortedPhotos = photos.sort((a, b) => {
  const dateA = new Date(a.data.date).getTime();
  const dateB = new Date(b.data.date).getTime();
  return dateB - dateA; // Sort in descending order (newest first)
});

// Group photos by month and year
const groupedPhotos = sortedPhotos.reduce((groups, photo) => {
  const date = photo.data.date;
  const key = format(date, 'MMMM yyyy');
  if (!groups[key]) {
    groups[key] = [];
  }
  groups[key].push(photo);
  return groups;
}, {} as Record<string, typeof photos>);

// Create SEO metadata
const seo = {
  title: "Photo Gallery | Dzaleka Heritage Archive",
  description: "Explore our collection of photographs documenting life in Dzaleka Refugee Camp, Malawi.",
  type: "website",
  canonical: "https://services.dzaleka.com/photo-gallery",
  openGraph: {
    title: "Photo Gallery | Dzaleka Heritage Archive",
    description: "Explore our collection of photographs documenting life in Dzaleka Refugee Camp, Malawi.",
    type: "website",
    site_name: "Dzaleka Heritage Archive",
    locale: "en_US",
    url: "https://services.dzaleka.com/photo-gallery"
  }
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
>
  <div class="min-h-screen bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Photo Gallery</h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Explore our collection of photographs documenting life in Dzaleka Refugee Camp, Malawi.
        </p>
      </div>

      <!-- Photo Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPhotos.map(photo => (
          <a 
            href={`/photos/${photo.slug}`}
            class="group block bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-md transition-shadow"
          >
            <div class="aspect-w-16 aspect-h-9">
              <img 
                src={photo.data.image} 
                alt={photo.data.title}
                class="w-full h-full object-cover"
              />
            </div>
            <div class="p-4">
              <h2 class="text-lg font-semibold text-gray-900 group-hover:text-primary-600 transition-colors">
                {photo.data.title}
              </h2>
              <p class="text-sm text-gray-500 mt-1">
                {format(new Date(photo.data.date), 'MMMM d, yyyy')}
              </p>
              {photo.data.photographer?.name && (
                <p class="text-sm text-gray-500 mt-1">
                  By {photo.data.photographer.name}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</MainLayout>

<style>
  /* Add any component-specific styles here */
</style>