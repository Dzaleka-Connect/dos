---
import MainLayout from "../layouts/MainLayout.astro";
import Breadcrumb from "../components/ui/Breadcrumb.astro";
import { getCollection } from "astro:content";
const stories = await getCollection("inspirational-stories");
const businessStories = [
  {
    id: "glorieuse",
    summary:
      "Glorieuse describes saving for a sewing machine and starting a tailoring business from home.",
    trade: "Tailoring",
  },
  {
    id: "clementine",
    summary:
      "Clementine, known as U-Cley, writes about learning photography and earning an income with her camera.",
    trade: "Photography",
  },
  {
    id: "ali-hussein",
    summary:
      "Ali Hussein shares his experience working as a hairdresser in Dzaleka.",
    trade: "Hairdressing",
  },
].flatMap((item) => {
  const story = stories.find((story) => story.id === item.id);
  return story ? [{ ...item, story }] : [];
});
const description =
  "Business planning worksheets, marketplace listings, training and funding opportunities for entrepreneurs in Dzaleka. Read stories from local business owners.";
const canonical = "https://services.dzaleka.com/entrepreneurs";
const tasks = [
  {
    title: "Plan your business",
    text: "Write an action plan, work out your costs or plan how to reach customers.",
    href: "/tools-and-templates",
    action: "Choose a worksheet",
  },
  {
    title: "Sell your work",
    text: "List a product or service so buyers can contact you.",
    href: "/marketplace/submit",
    action: "Create a marketplace listing",
  },
  {
    title: "Learn a skill",
    text: "Find courses and learning materials in the e-learning catalogue.",
    href: "/e-learning",
    action: "Browse learning resources",
  },
  {
    title: "Find an opportunity",
    text: "Check grant, programme and open-call listings for eligibility and deadlines.",
    href: "/grants-and-programs",
    action: "Browse grants and programmes",
  },
];
---

<MainLayout
  title="Entrepreneurs"
  description={description}
  canonical={canonical}
  image="https://services.dzaleka.com/images/profiles/glorieuse.jpg"
>
  <section class="bg-primary-900 text-white">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
      <Breadcrumb
        light
        items={[{ label: "Home", href: "/" }, { label: "Entrepreneurs" }]}
      />
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_330px] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-primary-200">
            Small business in Dzaleka
          </p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
            Entrepreneurs
          </h1>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-primary-50">
            Plan your next step, list what you sell and find opportunities for
            your business.
          </p>
        </div>
        <aside class="border-l border-primary-600 pl-6">
          <h2 class="text-lg font-semibold">Already trading?</h2>
          <a
            href="/marketplace/stores/register"
            class="mt-3 inline-flex min-h-[44px] items-center font-medium text-white underline underline-offset-4"
          >
            Register your shop or restaurant →
          </a>
          <a
            href="/services/register"
            class="inline-flex min-h-[44px] items-center font-medium text-white underline underline-offset-4"
          >
            Add a community service →
          </a>
        </aside>
      </div>
    </div>
  </section>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section aria-labelledby="tasks-heading">
      <h2 id="tasks-heading" class="text-2xl font-bold text-slate-900">
        What do you want to do?
      </h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {tasks.map((task, index) => (
          <article class="flex flex-col rounded border border-slate-200 p-5">
            <p
              class="text-sm font-semibold text-primary-700"
              aria-hidden="true"
            >
              0{index + 1}
            </p>
            <h3 class="mt-2 text-xl font-bold text-slate-900">{task.title}</h3>
            <p class="mb-4 mt-3 leading-7 text-slate-600">{task.text}</p>
            <a
              href={task.href}
              class="mt-auto inline-flex min-h-[44px] items-center font-semibold text-primary-800 underline underline-offset-4"
            >
              {task.action} →
            </a>
          </article>
        ))}
      </div>
    </section>
    <section class="mt-12 border-t border-slate-200 pt-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">
            Business owners’ stories
          </h2>
          <p class="mt-2 text-slate-600">
            Personal accounts from the story archive.
          </p>
        </div>
        <a
          href="/inspirational-stories"
          class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4"
        >
          All personal stories →
        </a>
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {businessStories.map(({ id, story, summary, trade }) => (
          <article class="overflow-hidden rounded border border-slate-200">
            <div class="aspect-[4/3] bg-slate-100">
              <img
                src={story.data.personImage}
                alt={story.data.name}
                class="h-full w-full object-contain"
                width="640"
                height="480"
                loading="lazy"
              />
            </div>
            <div class="p-5">
              <p class="text-sm text-slate-500">{trade}</p>
              <h3 class="mt-1 text-xl font-bold">
                <a
                  href={`/inspirational-stories/${id}`}
                  class="text-primary-800 underline underline-offset-4"
                >
                  {story.data.name}
                </a>
              </h3>
              <p class="mt-3 leading-7 text-slate-600">{summary}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
    <section class="mt-10 grid gap-8 border-l-4 border-primary-700 bg-slate-50 p-6 sm:p-8 lg:grid-cols-2">
      <div>
        <h2 class="text-xl font-bold text-slate-900">
          Make a plan you can use
        </h2>
        <p class="mt-3 leading-7 text-slate-600">
          Start with a goal, three priorities and the people or materials you
          need. Download your notes to keep working offline.
        </p>
        <a
          href="/tools-and-templates/one-page-business-action-plan"
          class="mt-4 inline-flex min-h-[44px] items-center font-semibold text-primary-800 underline underline-offset-4"
        >
          Open the business action plan →
        </a>
      </div>
      <div>
        <h2 class="text-xl font-bold text-slate-900">
          Find people and local businesses
        </h2>
        <ul class="mt-3 space-y-2">
          <li>
            <a
              href="/marketplace/stores"
              class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4"
            >
              Shops and restaurants
            </a>
          </li>
          <li>
            <a
              href="/skills-exchange"
              class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4"
            >
              Skills exchange profiles
            </a>
          </li>
          <li>
            <a
              href="/help-desk"
              class="inline-flex min-h-[44px] items-center text-primary-800 underline underline-offset-4"
            >
              Get help with a website listing
            </a>
          </li>
        </ul>
      </div>
    </section>
  </div>
</MainLayout>
