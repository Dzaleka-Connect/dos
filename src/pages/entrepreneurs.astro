---
import MainLayout from '../layouts/MainLayout.astro';

const pageTitle = "Entrepreneurs | Dzaleka Online Services";
const pageDescription = "Join our entrepreneur community supporting refugee businesses in Dzaleka. Access business development resources, connect with mentors, find funding opportunities, and build sustainable enterprises. Empowering refugee entrepreneurs through digital platforms and local partnerships.";
const seo = {
  title: pageTitle,
  description: pageDescription,
  type: "website",
  canonical: "https://services.dzaleka.com/entrepreneurs",
  openGraph: {
    title: pageTitle,
    description: pageDescription,
    type: "website",
    site_name: "Dzaleka Online Services",
    locale: "en_US",
    url: "https://services.dzaleka.com/entrepreneurs"
  }
};
---

<MainLayout 
  title={seo.title} 
  description={seo.description} 
  type={seo.type} 
  canonical={seo.canonical} 
  openGraph={seo.openGraph}
>
  <main class="bg-white">
    <!-- Hero Section -->
    <section class="relative bg-gradient-to-r from-primary-900 via-primary-800 to-primary-700 text-white py-20 overflow-hidden">
      <div class="absolute inset-0 opacity-20 bg-pattern"></div>
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-5xl md:text-6xl font-black mb-6 leading-tight">Discover the power of your own ideas.</h1>
          <div class="max-w-2xl mx-auto">
            <p class="text-xl mb-8 leading-relaxed text-white/90">
              Join a business community of people with refugee backgrounds and supporters.
              Connect with mentors and coaches.
              Develop your skills and access business opportunities.
            </p>
            <a 
              href="#join-waitlist" 
              class="inline-block px-8 py-4 bg-white text-primary-700 rounded-xl font-bold text-lg shadow-lg hover:bg-gray-100 transition-colors"
            >
              Join our waitlist
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Intro Section -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-4xl font-bold text-gray-900 mb-10">Build your path with Dzaleka Online Services.</h2>
          <h3 class="text-2xl font-bold text-gray-800 mb-12">How to join our community</h3>
          
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
            <div class="bg-gray-50 p-6 rounded-xl">
              <div class="w-12 h-12 bg-primary-100 text-primary-700 rounded-full flex items-center justify-center text-xl font-bold mb-4 mx-auto">1</div>
              <h4 class="text-lg font-bold text-gray-900 mb-2">Join our waitlist</h4>
              <p class="text-gray-600 mb-4">Join the waitlist to be informed when applications re-open in Spring 2025.</p>
              <a 
                href="#join-waitlist" 
                class="inline-block px-5 py-2 bg-primary-600 text-white rounded-lg font-medium text-sm hover:bg-primary-700 transition-colors"
              >
                Join our waitlist
              </a>
            </div>
            <div class="bg-gray-50 p-6 rounded-xl">
              <div class="w-12 h-12 bg-primary-100 text-primary-700 rounded-full flex items-center justify-center text-xl font-bold mb-4 mx-auto">2</div>
              <h4 class="text-lg font-bold text-gray-900 mb-2">Apply to Dzaleka Online Services</h4>
              <p class="text-gray-600">Complete a short online application form.</p>
            </div>
            <div class="bg-gray-50 p-6 rounded-xl">
              <div class="w-12 h-12 bg-primary-100 text-primary-700 rounded-full flex items-center justify-center text-xl font-bold mb-4 mx-auto">3</div>
              <h4 class="text-lg font-bold text-gray-900 mb-2">Meet the team</h4>
              <p class="text-gray-600">Have a welcome call to learn more about our support.</p>
            </div>
            <div class="bg-gray-50 p-6 rounded-xl">
              <div class="w-12 h-12 bg-primary-100 text-primary-700 rounded-full flex items-center justify-center text-xl font-bold mb-4 mx-auto">4</div>
              <h4 class="text-lg font-bold text-gray-900 mb-2">Join the community</h4>
              <p class="text-gray-600">Access free ongoing business support.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="py-16 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
          <div class="grid md:grid-cols-2 gap-12 mb-16">
            <!-- Community & Networking -->
            <div class="bg-gray-50 p-8 rounded-xl">
              <h3 class="text-2xl font-bold text-gray-900 mb-4">Community & Networking</h3>
              <p class="text-lg text-gray-600 mb-6">Join the Dzaleka Online Services community to:</p>
              <ul class="space-y-3">
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-gray-700">Attend social & professional events</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-gray-700">Meet people in your industry</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-gray-700">Collaborate with other entrepreneurs</span>
                </li>
              </ul>
            </div>

            <!-- Mentoring & Training -->
            <div class="bg-gray-50 p-8 rounded-xl">
              <h3 class="text-2xl font-bold text-gray-900 mb-4">Mentoring & Training</h3>
              <p class="text-lg text-gray-600 mb-6">Our programmes support you to develop your business through:</p>
              <ul class="space-y-3">
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-gray-700">Interactive business workshops</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-gray-700">Business mentoring & coaching</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-gray-700">Events to showcase your business</span>
                </li>
              </ul>
            </div>

            <!-- Expert Advice -->
            <div class="bg-gray-50 p-8 rounded-xl">
              <h3 class="text-2xl font-bold text-gray-900 mb-4">Expert Advice</h3>
              <p class="text-lg text-gray-600 mb-6">Access 1:1 support from our business experts:</p>
              <ul class="space-y-3">
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-gray-700">Help with taxes, legal advice and business finance</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-gray-700">Support on branding and marketing</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-gray-700">Find business partners and build your customer base</span>
                </li>
              </ul>
            </div>

            <!-- Business Opportunities -->
            <div class="bg-gray-50 p-8 rounded-xl">
              <h3 class="text-2xl font-bold text-gray-900 mb-4">Business Opportunities</h3>
              <p class="text-lg text-gray-600 mb-6">Grow your business with Dzaleka Online Services' connections:</p>
              <ul class="space-y-3">
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-gray-700">Join Service listing to reach more people</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-gray-700">Pitch your idea at business showcases</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-6 h-6 text-primary-600 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <span class="text-gray-700">Receive weekly business opportunities</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Join Waitlist Section -->
    <section id="join-waitlist" class="py-20 bg-gradient-to-r from-primary-800 to-primary-900 text-white">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-4xl font-bold mb-8">Join Our Waitlist</h2>
          <p class="text-xl mb-10">Be the first to know when we open applications for our entrepreneur program.</p>
          
          <form class="max-w-md mx-auto">
            <div class="space-y-4">
              <div>
                <label for="name" class="block text-sm font-medium text-white mb-1">Your Full Name</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  class="w-full px-4 py-3 rounded-lg border-white/20 bg-white/10 text-white placeholder-white/60 focus:border-white/30 focus:ring-white/20"
                  placeholder="Enter your name"
                  required
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-white mb-1">Email Address</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  class="w-full px-4 py-3 rounded-lg border-white/20 bg-white/10 text-white placeholder-white/60 focus:border-white/30 focus:ring-white/20"
                  placeholder="Enter your email"
                  required
                />
              </div>
              <div>
                <label for="business" class="block text-sm font-medium text-white mb-1">Business Idea (Optional)</label>
                <textarea 
                  id="business" 
                  name="business" 
                  rows="3" 
                  class="w-full px-4 py-3 rounded-lg border-white/20 bg-white/10 text-white placeholder-white/60 focus:border-white/30 focus:ring-white/20"
                  placeholder="Briefly describe your business idea"
                ></textarea>
              </div>
              <button 
                type="submit" 
                class="w-full px-6 py-3 bg-white text-primary-800 rounded-lg font-bold hover:bg-gray-100 transition-colors"
              >
                Join Waitlist
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  /* Background pattern */
  .bg-pattern {
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.15'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
</style> 