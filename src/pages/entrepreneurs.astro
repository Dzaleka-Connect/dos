---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const pageTitle = 'Entrepreneurs | Dzaleka Online Services';
const pageDescription =
  'Find business support, training, marketplace tools, and examples from entrepreneurs in Dzaleka.';

const allProfiles = await getCollection('profiles');
const featuredProfiles = allProfiles.filter((profile) => profile.data.featured === true).slice(0, 3);
const displayProfiles = featuredProfiles.length > 0 ? featuredProfiles : allProfiles.slice(0, 3);

const supportAreas = [
  {
    title: 'Start or improve a business',
    description: 'Use the platform to present your work, share a service, or find examples from others already trading in the community.',
    href: '/skills-exchange',
    action: 'Browse profiles',
  },
  {
    title: 'Sell products or services',
    description: 'List items in the marketplace or register a store so buyers can contact you directly.',
    href: '/marketplace',
    action: 'Open marketplace',
  },
  {
    title: 'Learn and build skills',
    description: 'Explore training, digital learning, and practical knowledge that can help with planning, promotion, and customer service.',
    href: '/e-learning',
    action: 'View learning resources',
  },
  {
    title: 'Find work and partnerships',
    description: 'Check job opportunities, community organisations, and local support pathways that can help your business grow.',
    href: '/jobs',
    action: 'See opportunities',
  },
];

const seo = {
  title: pageTitle,
  description: pageDescription,
  type: 'website',
  canonical: 'https://services.dzaleka.com/entrepreneurs',
  openGraph: {
    title: pageTitle,
    description: pageDescription,
    type: 'website',
    site_name: 'Dzaleka Online Services',
    locale: 'en_US',
    url: 'https://services.dzaleka.com/entrepreneurs',
  },
};
---

<MainLayout
  title={seo.title}
  description={seo.description}
  type={seo.type}
  canonical={seo.canonical}
  openGraph={seo.openGraph}
>
  <main class="bg-gray-50">
    <section class="border-b border-gray-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
        <nav class="mb-4 text-sm text-gray-500">
          <a href="/" class="hover:text-primary-700">Home</a>
          <span class="mx-2">/</span>
          <span class="text-gray-900">Entrepreneurs</span>
        </nav>

        <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_280px] lg:items-start">
          <div class="max-w-3xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary-700">Business support</p>
            <h1 class="mt-3 text-3xl font-semibold tracking-tight text-gray-900 sm:text-4xl">
              Entrepreneurs in Dzaleka
            </h1>
            <p class="mt-4 text-lg leading-8 text-gray-600">
              This page brings together practical routes for people building businesses in and around Dzaleka.
              Use it to find examples, promote what you offer, and connect with training or support.
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href="/marketplace/submit"
                class="inline-flex items-center rounded-lg bg-primary-700 px-5 py-3 text-sm font-medium text-white transition hover:bg-primary-800"
              >
                List a product or service
              </a>
              <a
                href="/skills-exchange"
                class="inline-flex items-center rounded-lg border border-gray-300 px-5 py-3 text-sm font-medium text-gray-700 transition hover:border-primary-300 hover:text-primary-700"
              >
                Browse community profiles
              </a>
            </div>
          </div>

          <aside class="rounded-xl border border-gray-200 bg-gray-50 p-5">
            <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-gray-700">Quick links</h2>
            <ul class="mt-4 space-y-3 text-sm text-gray-600">
              <li><a href="/marketplace" class="hover:text-primary-700">Marketplace</a></li>
              <li><a href="/marketplace/stores" class="hover:text-primary-700">Restaurants and shops</a></li>
              <li><a href="/e-learning" class="hover:text-primary-700">E-learning</a></li>
              <li><a href="/jobs" class="hover:text-primary-700">Jobs</a></li>
              <li><a href="/support-our-work" class="hover:text-primary-700">Support and partnerships</a></li>
            </ul>
          </aside>
        </div>
      </div>
    </section>

    <section class="border-b border-gray-200 bg-gray-50">
      <div class="mx-auto grid max-w-6xl gap-4 px-4 py-10 sm:grid-cols-2 sm:px-6 lg:grid-cols-4 lg:px-8">
        {supportAreas.map((area) => (
          <article class="rounded-xl border border-gray-200 bg-white p-5">
            <h2 class="text-lg font-semibold text-gray-900">{area.title}</h2>
            <p class="mt-2 text-sm leading-6 text-gray-600">{area.description}</p>
            <a href={area.href} class="mt-4 inline-flex text-sm font-medium text-primary-700 hover:text-primary-800">
              {area.action}
            </a>
          </article>
        ))}
      </div>
    </section>

    {displayProfiles.length > 0 && (
      <section class="bg-white">
        <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
          <div class="max-w-2xl">
            <h2 class="text-2xl font-semibold text-gray-900">Featured profiles</h2>
            <p class="mt-3 text-base leading-7 text-gray-600">
              A few examples of people sharing skills, services, and business activity through the platform.
            </p>
          </div>

          <div class="mt-8 grid gap-6 md:grid-cols-3">
            {displayProfiles.map((profile) => (
              <article class="overflow-hidden rounded-xl border border-gray-200 bg-white">
                <div class="aspect-[4/3] bg-gray-100">
                  <img
                    src={profile.data.profileImage || '/images/dzaleka-digital-heritage.png'}
                    alt={profile.data.name}
                    class="h-full w-full object-cover"
                  />
                </div>
                <div class="p-5">
                  <p class="text-sm font-medium text-primary-700">{profile.data.skill}</p>
                  <h3 class="mt-1 text-xl font-semibold text-gray-900">{profile.data.name}</h3>
                  <p class="mt-3 text-sm leading-6 text-gray-600">
                    {profile.data.shortDescription || 'Community profile on Dzaleka Online Services.'}
                  </p>
                  <a
                    href={`/skills-exchange/profile/${profile.id}`}
                    class="mt-4 inline-flex text-sm font-medium text-primary-700 hover:text-primary-800"
                  >
                    View profile
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="border-t border-gray-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="rounded-xl border border-gray-200 bg-gray-50 p-6 sm:p-8">
          <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_220px] lg:items-start">
            <div>
              <h2 class="text-2xl font-semibold text-gray-900">Business planning templates</h2>
              <p class="mt-3 max-w-3xl text-sm leading-6 text-gray-600">
                If you are starting out or trying to organise the next stage of your business, use the startup tools library for simple planning templates on marketing, cash flow, action steps, and risk planning.
              </p>
            </div>
            <div class="flex flex-col gap-3">
              <a
                href="/tools-and-templates"
                class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 transition hover:border-primary-300 hover:text-primary-700"
              >
                Open tools library
              </a>
              <a
                href="/tools-and-templates/marketing-plan-template"
                class="inline-flex items-center justify-center rounded-lg bg-primary-700 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-primary-800"
              >
                Start with marketing plan
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-gray-200 bg-gray-50">
      <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="rounded-xl border border-gray-200 bg-white p-6 sm:p-8">
          <div class="max-w-2xl">
            <h2 class="text-2xl font-semibold text-gray-900">Join the entrepreneur mailing list</h2>
            <p class="mt-3 text-sm leading-6 text-gray-600">
              Leave your details if you want updates about business support, marketplace opportunities, or future entrepreneurship programmes.
            </p>
          </div>

          <form action="https://formspree.io/f/xqaaajae" method="POST" class="mt-8 space-y-5">
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700">Full name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200"
                  placeholder="Your name"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700">Email address</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200"
                  placeholder="name@example.com"
                />
              </div>
            </div>

            <div>
              <label for="business" class="block text-sm font-medium text-gray-700">Business idea or service</label>
              <textarea
                id="business"
                name="business"
                rows="4"
                class="mt-2 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-200"
                placeholder="Tell us briefly what you do or what support you are looking for."
              ></textarea>
            </div>

            <button
              type="submit"
              class="inline-flex items-center rounded-lg bg-primary-700 px-5 py-3 text-sm font-medium text-white transition hover:bg-primary-800"
            >
              Join updates
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>
</MainLayout>
