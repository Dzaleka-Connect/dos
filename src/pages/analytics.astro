        // Visitor Trend Chart
        const visitorTrendCtx = document.getElementById('visitor-trend-chart')?.getContext('2d');
        if (visitorTrendCtx) {
          new Chart(visitorTrendCtx, {
            id: 'visitor-trend-chart',
          type: 'line',
          data: {
              labels: visitorTrendData.labels,
