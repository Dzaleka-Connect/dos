---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

const pageTitle = 'Request Skills Help';
const pageDescription = 'Submit a request for skills training or assistance.';

const skillCategories = [
  'Photography',
  'Business',
  'Handicrafts',
  'Technology',
  'Language Learning',
  'Music',
  'Art',
  'Cooking'
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-8">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Skills Exchange', href: '/skills-exchange' },
            { label: 'Request a skill' }
          ]}
        />
      </div>

      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(260px,0.9fr)] lg:items-start">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Request support</p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Request skills help</h1>
          <p class="mt-4 text-lg leading-8 text-slate-600">
            Use this form if you want to learn a skill or need help from someone in the community who can teach or support you.
          </p>
        </div>

        <div class="rounded border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-lg font-semibold text-slate-900">Before you submit</h2>
          <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-600">
            <li>Explain the exact skill or help you are looking for.</li>
            <li>Include your availability so people know when they can reach you.</li>
            <li>Choose the contact method you are most likely to check.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl rounded border border-slate-200 bg-white p-6 sm:p-8">
      <form id="requestForm" action="https://formspree.io/f/xqaaajae" method="POST" class="submission-form space-y-8">
        <input type="hidden" name="_subject" value="New Skills Request Submission" />
        <input type="hidden" name="_next" value="/skills-exchange/thank-you" />

        <div class="grid gap-6 sm:grid-cols-[180px_minmax(0,1fr)] sm:items-start">
          <label for="name" class="text-sm font-medium text-slate-700 sm:pt-3">Full name</label>
          <input
            type="text"
            name="name"
            id="name"
            required
            class="block w-full rounded border-slate-300 text-sm focus:border-primary-500 focus:ring-primary-500"
          />
        </div>

        <div class="grid gap-6 sm:grid-cols-[180px_minmax(0,1fr)] sm:items-start">
          <label for="email" class="text-sm font-medium text-slate-700 sm:pt-3">Email</label>
          <input
            type="email"
            name="email"
            id="email"
            required
            class="block w-full rounded border-slate-300 text-sm focus:border-primary-500 focus:ring-primary-500"
          />
        </div>

        <div class="grid gap-6 sm:grid-cols-[180px_minmax(0,1fr)] sm:items-start">
          <label for="skillCategory" class="text-sm font-medium text-slate-700 sm:pt-3">Skill category</label>
          <select
            id="skillCategory"
            name="skillCategory"
            required
            class="block w-full rounded border-slate-300 text-sm focus:border-primary-500 focus:ring-primary-500"
          >
            <option value="">Select a category</option>
            {skillCategories.map((category) => (
              <option value={category.toLowerCase()}>{category}</option>
            ))}
          </select>
        </div>

        <div class="grid gap-6 sm:grid-cols-[180px_minmax(0,1fr)] sm:items-start">
          <label for="skillRequested" class="text-sm font-medium text-slate-700 sm:pt-3">Specific skill</label>
          <input
            type="text"
            name="skillRequested"
            id="skillRequested"
            required
            placeholder="What would you like to learn?"
            class="block w-full rounded border-slate-300 text-sm focus:border-primary-500 focus:ring-primary-500"
          />
        </div>

        <div class="grid gap-6 sm:grid-cols-[180px_minmax(0,1fr)] sm:items-start">
          <label for="description" class="text-sm font-medium text-slate-700 sm:pt-3">Request details</label>
          <textarea
            id="description"
            name="description"
            rows="4"
            required
            placeholder="Describe what you want to learn and your current skill level."
            class="block w-full rounded border-slate-300 text-sm focus:border-primary-500 focus:ring-primary-500"
          ></textarea>
        </div>

        <div class="grid gap-6 sm:grid-cols-[180px_minmax(0,1fr)] sm:items-start">
          <label for="availability" class="text-sm font-medium text-slate-700 sm:pt-3">Availability</label>
          <textarea
            id="availability"
            name="availability"
            rows="3"
            required
            placeholder="When are you available for learning sessions?"
            class="block w-full rounded border-slate-300 text-sm focus:border-primary-500 focus:ring-primary-500"
          ></textarea>
        </div>

        <div class="grid gap-6 sm:grid-cols-[180px_minmax(0,1fr)] sm:items-start">
          <label for="preferredContact" class="text-sm font-medium text-slate-700 sm:pt-3">Preferred contact</label>
          <select
            id="preferredContact"
            name="preferredContact"
            required
            class="block w-full rounded border-slate-300 text-sm focus:border-primary-500 focus:ring-primary-500"
          >
            <option value="email">Email</option>
            <option value="phone">Phone</option>
            <option value="whatsapp">WhatsApp</option>
          </select>
        </div>

        <div class="flex flex-col gap-3 border-t border-slate-200 pt-6 sm:flex-row sm:justify-end">
          <button
            type="button"
            onclick="window.location.href='/skills-exchange'"
            class="min-h-[44px] inline-flex items-center justify-center rounded border border-slate-300 px-4 py-2.5 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="min-h-[44px] inline-flex items-center justify-center rounded bg-primary-600 px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-700"
          >
            Submit request
          </button>
        </div>
      </form>

      <div id="successMessage" class="hidden mt-6 rounded border border-emerald-200 bg-emerald-50 p-4">
        <p class="text-sm font-medium text-emerald-800">Request submitted successfully.</p>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  const form = document.getElementById('requestForm');
  const successMessage = document.getElementById('successMessage');

  if (form && successMessage) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      try {
        await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {
            Accept: 'application/json'
          }
        });

        successMessage.classList.remove('hidden');
        form.reset();

        setTimeout(() => {
          window.location.href = '/skills-exchange';
        }, 2000);
      } catch (error) {
        console.error('Error:', error);
        alert('An error occurred. Try again.');
      }
    });
  }
</script>
