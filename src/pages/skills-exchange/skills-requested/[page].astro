---
import MainLayout from '../../../layouts/MainLayout.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const itemsPerPage = 9;

export async function getStaticPaths() {
  const itemsPerPage = 9;
  const allProfiles = await getCollection('profiles');
  const requestedProfiles = allProfiles.filter(
    (profile) =>
      profile.data.status === 'Requested' &&
      (!profile.data.requestStatus || profile.data.requestStatus === 'Open')
  );
  const categories = [...new Set(requestedProfiles.map((profile) => profile.data.category))].sort();
  const totalPages = Math.ceil(requestedProfiles.length / itemsPerPage);

  return Array.from({ length: totalPages }, (_, index) => {
    const currentPage = index + 1;
    return {
      params: { page: currentPage.toString() },
      props: {
        profiles: requestedProfiles,
        currentPage,
        totalPages,
        categories
      }
    };
  });
}

const { profiles, currentPage, totalPages, categories } = Astro.props;
const selectedCategory = Astro.url.searchParams.get('category');

const filteredProfiles = selectedCategory
  ? profiles.filter((profile) => profile.data.category === selectedCategory)
  : profiles;

const filteredTotalItems = filteredProfiles.length;
const filteredTotalPages = Math.max(1, Math.ceil(filteredTotalItems / itemsPerPage));
const safeCurrentPage = Math.min(currentPage, filteredTotalPages);
const startIndex = (safeCurrentPage - 1) * itemsPerPage;
const currentProfiles = filteredProfiles.slice(startIndex, startIndex + itemsPerPage);

function getPageUrl(pageNumber) {
  const basePath = `/skills-exchange/skills-requested/${pageNumber}`;
  return selectedCategory ? `${basePath}?category=${encodeURIComponent(selectedCategory)}` : basePath;
}

function getVisiblePages(current, total) {
  if (total <= 5) return Array.from({ length: total }, (_, index) => index + 1);

  const pages = [1];
  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);

  if (start > 2) pages.push('...');
  for (let page = start; page <= end; page += 1) pages.push(page);
  if (end < total - 1) pages.push('...');
  pages.push(total);

  return pages;
}

const visiblePages = getVisiblePages(safeCurrentPage, filteredTotalPages);
---

<MainLayout title="Learning Requests | Skills Exchange" description="Browse learning requests from community members">
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-8">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Skills Exchange', href: '/skills-exchange' },
            { label: 'Learning requests' }
          ]}
        />
      </div>

      <div class="max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Skills Exchange</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Learning requests</h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          See what people want to learn and offer your support where your skills can help.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/skills-exchange/request" class="min-h-[44px] inline-flex items-center rounded bg-primary-600 px-5 py-3 text-sm font-medium text-white hover:bg-primary-700">
          Request a skill
        </a>
        <a href="/skills-exchange/skills-offered" class="min-h-[44px] inline-flex items-center rounded border border-slate-300 px-5 py-3 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">
          Browse skills offered
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-slate-600">
        <span><span class="font-semibold text-slate-900">{filteredTotalItems}</span> requests</span>
        {selectedCategory && <span>Category: <span class="font-semibold text-slate-900">{selectedCategory}</span></span>}
        <span>Page <span class="font-semibold text-slate-900">{safeCurrentPage}</span> of <span class="font-semibold text-slate-900">{filteredTotalPages}</span></span>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section class="mb-10">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Filter</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900">Categories</h2>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/skills-exchange/skills-requested/1"
          class:list={[
            'inline-flex items-center rounded-md border px-4 py-2 text-sm font-medium',
            !selectedCategory ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300 text-slate-700 hover:border-slate-400 hover:text-slate-900'
          ]}
        >
          All categories
        </a>
        {categories.map((category) => (
          <a
            href={`/skills-exchange/skills-requested/1?category=${encodeURIComponent(category)}`}
            class:list={[
              'inline-flex items-center rounded-md border px-4 py-2 text-sm font-medium',
              selectedCategory === category ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300 text-slate-700 hover:border-slate-400 hover:text-slate-900'
            ]}
          >
            {category}
          </a>
        ))}
      </div>
    </section>

    <section>
      <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
        {currentProfiles.map((profile) => (
          <a
            href={`/skills-exchange/profile/${profile.id.replace('.md', '')}`}
            class="block overflow-hidden rounded border border-slate-200 bg-white transition-colors hover:border-slate-300 hover:bg-slate-50"
          >
            <div class="aspect-[16/10] bg-slate-100">
              <img onerror="this.onerror=null; this.src='/images/unavailable-image.svg'; this.alt='Image unavailable';" src={profile.data.profileImage} alt={profile.data.name} class="h-full w-full object-cover" />
            </div>

            <div class="p-5">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-base font-semibold text-slate-900">Learning {profile.data.skill}</h3>
                  <p class="mt-1 text-sm text-slate-500">{profile.data.name}{profile.data.location ? ` · ${profile.data.location}` : ''}</p>
                </div>
                <span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">Requested</span>
              </div>

              <p class="mt-4 text-sm leading-6 text-slate-600 line-clamp-2">{profile.data.shortDescription}</p>

              <div class="mt-4 flex flex-wrap gap-2">
                <span class="rounded-md border border-slate-200 px-2.5 py-1 text-xs text-slate-700">{profile.data.category}</span>
                {profile.data.level && <span class="rounded-md border border-slate-200 px-2.5 py-1 text-xs text-slate-700">{profile.data.level}</span>}
              </div>

              <div class="mt-5 text-sm font-medium text-primary-700">Offer help</div>
            </div>
          </a>
        ))}
      </div>

      {currentProfiles.length === 0 && (
        <div class="rounded border border-slate-200 bg-white px-6 py-12 text-center">
          <h2 class="text-2xl font-semibold text-slate-900">No requests found</h2>
          <p class="mt-3 text-slate-600">There are no open learning requests in this category yet.</p>
        </div>
      )}
    </section>

    {filteredTotalPages > 1 && (
      <nav class="mt-12 flex items-center justify-between border-t border-slate-200 pt-6" aria-label="Pagination">
        <div class="flex flex-1">
          {safeCurrentPage > 1 && (
            <a href={getPageUrl(safeCurrentPage - 1)} class="inline-flex items-center text-sm font-medium text-slate-600 hover:text-primary-700">
              Previous
            </a>
          )}
        </div>

        <div class="hidden md:flex md:items-center md:gap-2">
          {visiblePages.map((pageNumber) =>
            pageNumber === '...' ? (
              <span class="px-2 text-sm text-slate-500">...</span>
            ) : (
              <a
                href={getPageUrl(pageNumber)}
                class:list={[
                  'inline-flex min-w-10 items-center justify-center rounded-md px-3 py-2 text-sm font-medium',
                  safeCurrentPage === pageNumber ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'
                ]}
              >
                {pageNumber}
              </a>
            )
          )}
        </div>

        <div class="flex flex-1 justify-end">
          {safeCurrentPage < filteredTotalPages && (
            <a href={getPageUrl(safeCurrentPage + 1)} class="inline-flex items-center text-sm font-medium text-slate-600 hover:text-primary-700">
              Next
            </a>
          )}
        </div>
      </nav>
    )}
  </div>
</MainLayout>

<style>
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
