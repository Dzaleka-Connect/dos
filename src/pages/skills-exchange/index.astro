---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const pageTitle = 'Skills Exchange';
const pageDescription = 'Find people offering skills, discover learning requests, and share your own experience with the Dzaleka community.';

const allProfiles = await getCollection('profiles');
const skillsOffered = allProfiles.filter((profile) => profile.data.status === 'Available');
const skillsRequested = allProfiles.filter(
  (profile) =>
    profile.data.status === 'Requested' &&
    (!profile.data.requestStatus || profile.data.requestStatus === 'Open')
);

const featuredOffered = skillsOffered.slice(0, 4);
const featuredRequested = skillsRequested.slice(0, 4);

const categories = [
  {
    name: 'Photography',
    description: 'Visual storytelling, editing, and camera skills.',
    icon: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z'
  },
  {
    name: 'Business',
    description: 'Entrepreneurship, sales, bookkeeping, and trade skills.',
    icon: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
  },
  {
    name: 'Technology',
    description: 'Digital literacy, software, and practical computing skills.',
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
  },
  {
    name: 'Language',
    description: 'Language learning, communication, and interpretation support.',
    icon: 'M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129'
  },
  {
    name: 'Arts & Crafts',
    description: 'Creative practice, design, tailoring, and handmade work.',
    icon: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z'
  },
  {
    name: 'Music',
    description: 'Instrument, singing, production, and performance skills.',
    icon: 'M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3'
  }
];

const summaryStats = [
  { label: 'Skills offered', value: skillsOffered.length },
  { label: 'Learning requests', value: skillsRequested.length },
  { label: 'Total listings', value: skillsOffered.length + skillsRequested.length }
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-8">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Skills Exchange' }
          ]}
        />
      </div>

      <div class="max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Community skills</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">Skills Exchange</h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          Find people sharing skills, see what others want to learn, and add your own profile to connect with the community.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/skills-exchange/skills-offered"
          class="min-h-[44px] inline-flex items-center rounded bg-primary-600 px-5 py-3 text-sm font-medium text-white hover:bg-primary-700"
        >
          Browse skills offered
        </a>
        <a
          href="/skills-exchange/skills-requested"
          class="min-h-[44px] inline-flex items-center rounded border border-slate-300 px-5 py-3 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900"
        >
          View learning requests
        </a>
        <a
          href="/skills-exchange/list-profile"
          class="min-h-[44px] inline-flex items-center rounded border border-slate-300 px-5 py-3 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900"
        >
          Add your profile
        </a>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {summaryStats.map((stat) => (
          <div class="rounded border border-slate-200 bg-slate-50 px-5 py-4">
            <div class="text-sm text-slate-500">{stat.label}</div>
            <div class="mt-1 text-2xl font-semibold text-slate-900">{stat.value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section class="mb-12">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Browse</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900">Categories</h2>
        </div>
        <a href="/skills-exchange/skills-offered" class="text-sm font-medium text-primary-700 hover:text-primary-800">
          Browse all skills
        </a>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {categories.map((category) => (
          <a
            href={`/skills-exchange/skills-offered?category=${category.name}`}
            class="rounded border border-slate-200 bg-white p-5 transition-colors hover:border-slate-300 hover:bg-slate-50"
          >
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-md bg-slate-100 text-slate-700">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d={category.icon} />
                </svg>
              </span>
              <h3 class="text-base font-semibold text-slate-900">{category.name}</h3>
            </div>
            <p class="mt-3 text-sm leading-6 text-slate-600">{category.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mb-12 grid gap-10 lg:grid-cols-2">
      <div>
        <div class="flex items-end justify-between gap-4 border-b border-slate-200 pb-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Available now</p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-900">Skills offered</h2>
          </div>
          <a href="/skills-exchange/skills-offered" class="text-sm font-medium text-primary-700 hover:text-primary-800">
            View all
          </a>
        </div>

        <div class="mt-6 space-y-4">
          {featuredOffered.map((profile) => (
            <a
              href={`/skills-exchange/profile/${profile.id.replace('.md', '')}`}
              class="block rounded border border-slate-200 bg-white p-4 transition-colors hover:border-slate-300 hover:bg-slate-50"
            >
              <div class="flex items-start gap-4">
                <img onerror="this.onerror=null; this.src='/images/unavailable-image.svg'; this.alt='Image unavailable';" src={profile.data.profileImage} alt={profile.data.name} class="h-12 w-12 rounded object-cover" />
                <div class="min-w-0 flex-1">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <h3 class="text-base font-semibold text-slate-900">{profile.data.skill}</h3>
                      <p class="mt-1 text-sm text-slate-500">{profile.data.name}</p>
                    </div>
                    <span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">Available</span>
                  </div>
                  <p class="mt-3 text-sm leading-6 text-slate-600 line-clamp-2">{profile.data.shortDescription}</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div>
        <div class="flex items-end justify-between gap-4 border-b border-slate-200 pb-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Open requests</p>
            <h2 class="mt-2 text-2xl font-semibold text-slate-900">Learning requests</h2>
          </div>
          <a href="/skills-exchange/skills-requested" class="text-sm font-medium text-primary-700 hover:text-primary-800">
            View all
          </a>
        </div>

        <div class="mt-6 space-y-4">
          {featuredRequested.map((profile) => (
            <a
              href={`/skills-exchange/profile/${profile.id.replace('.md', '')}`}
              class="block rounded border border-slate-200 bg-white p-4 transition-colors hover:border-slate-300 hover:bg-slate-50"
            >
              <div class="flex items-start gap-4">
                <img onerror="this.onerror=null; this.src='/images/unavailable-image.svg'; this.alt='Image unavailable';" src={profile.data.profileImage} alt={profile.data.name} class="h-12 w-12 rounded object-cover" />
                <div class="min-w-0 flex-1">
                  <div class="flex items-start justify-between gap-3">
                    <div>
                      <h3 class="text-base font-semibold text-slate-900">Learning {profile.data.skill}</h3>
                      <p class="mt-1 text-sm text-slate-500">{profile.data.name}</p>
                    </div>
                    <span class="rounded-md bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">Requested</span>
                  </div>
                  <p class="mt-3 text-sm leading-6 text-slate-600 line-clamp-2">{profile.data.shortDescription}</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-slate-200 pt-8">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(280px,0.8fr)]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">How it works</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900">Share a skill or ask for one</h2>
          <div class="mt-6 space-y-5">
            <div class="border-l-2 border-slate-200 pl-4">
              <h3 class="text-base font-semibold text-slate-900">Create a profile</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">
                Add your skill, experience, contact details, and how people can learn from you or support your request.
              </p>
            </div>
            <div class="border-l-2 border-slate-200 pl-4">
              <h3 class="text-base font-semibold text-slate-900">Connect directly</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">
                Browse listings and contact the person offering or requesting a skill to arrange the next step.
              </p>
            </div>
            <div class="border-l-2 border-slate-200 pl-4">
              <h3 class="text-base font-semibold text-slate-900">Build opportunities</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">
                Use the exchange to find new work, improve your skills, or support someone else in the community.
              </p>
            </div>
          </div>
        </div>

        <div class="rounded border border-slate-200 bg-slate-50 p-6">
          <h3 class="text-lg font-semibold text-slate-900">Next steps</h3>
          <div class="mt-5 space-y-3">
            <a href="/skills-exchange/list-profile" class="block rounded bg-primary-600 px-4 py-3 text-sm font-medium text-white hover:bg-primary-700">
              Create your profile
            </a>
            <a href="/skills-exchange/request" class="block rounded border border-slate-300 bg-white px-4 py-3 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">
              Request a skill
            </a>
            <a href="/skills-exchange/about" class="block rounded border border-slate-300 bg-white px-4 py-3 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900">
              Learn how it works
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<style>
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
