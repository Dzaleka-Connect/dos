---
import MainLayout from '../../../layouts/MainLayout.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allProfiles = await getCollection('profiles');
  const categories = new Set();

  allProfiles.forEach((profile) => {
    if (profile.data.category) {
      categories.add(profile.data.category);
    }
  });

  return Array.from(categories).map((category) => ({
    params: { category },
    props: { category }
  }));
}

const { category } = Astro.props;
const pageTitle = `${category} Matches | Skills Exchange`;
const pageDescription = `View all skills offered and requested in the ${category} category.`;

const allProfiles = await getCollection('profiles');
const categoryProfiles = allProfiles.filter((profile) => profile.data.category === category);
const offers = categoryProfiles.filter((profile) => profile.data.status === 'Available');
const requests = categoryProfiles.filter(
  (profile) =>
    profile.data.status === 'Requested' &&
    (!profile.data.requestStatus || profile.data.requestStatus === 'Open')
);

const potentialMatches = Math.min(offers.length, requests.length);

const categoryStats = [
  { label: 'Potential matches', value: potentialMatches },
  { label: 'Skills offered', value: offers.length },
  { label: 'Open requests', value: requests.length }
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-8">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Skills Exchange', href: '/skills-exchange' },
            { label: 'Matches', href: '/skills-exchange/matches' },
            { label: category }
          ]}
        />
      </div>

      <div class="max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Category view</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">{category} matches</h1>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          Compare people offering support in {category} with people who have active requests in the same area.
        </p>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {categoryStats.map((stat) => (
          <div class="rounded border border-slate-200 bg-slate-50 px-5 py-4">
            <div class="text-sm text-slate-500">{stat.label}</div>
            <div class="mt-1 text-2xl font-semibold text-slate-900">{stat.value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section class="rounded border border-slate-200 bg-white">
      <div class="flex flex-col gap-4 border-b border-slate-200 px-6 py-5 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <h2 class="text-lg font-semibold text-slate-900">{category}</h2>
          <p class="mt-1 text-sm text-slate-500">
            Review current offers and requests in this category and process a match if needed.
          </p>
        </div>
        <button
          id="match-all-btn"
          data-category={category}
          class="min-h-[44px] inline-flex items-center rounded bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700"
        >
          Match all in {category}
        </button>
      </div>

      <div class="grid gap-8 px-6 py-6 lg:grid-cols-2">
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Skills offered</h3>
          {offers.length > 0 ? (
            <div class="mt-4 space-y-4">
              {offers.map((profile) => (
                <div class="rounded border border-slate-200 bg-slate-50 p-4">
                  <div class="flex items-start gap-4">
                    <img onerror="this.onerror=null; this.src='/images/unavailable-image.svg'; this.alt='Image unavailable';"
                      class="h-12 w-12 rounded object-cover"
                      src={profile.data.profileImage || '/images/avatars/default-avatar.png'}
                      alt={profile.data.name}
                    />
                    <div class="min-w-0 flex-1">
                      <h4 class="text-sm font-semibold text-slate-900">{profile.data.name}</h4>
                      <p class="mt-1 text-sm text-slate-700">{profile.data.skill}</p>
                      <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600">{profile.data.bio}</p>
                      <div class="mt-3 flex items-center justify-between gap-3">
                        <span class="text-xs text-slate-400">Posted {new Date(profile.data.dateJoined).toLocaleDateString()}</span>
                        <a href={`/skills-exchange/profile/${profile.id.replace('.md', '')}`} class="text-sm font-medium text-primary-700 hover:text-primary-800">
                          View profile
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="mt-4 rounded border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center">
              <p class="text-sm text-slate-600">No one is offering this skill yet.</p>
              <a href="/skills-exchange/list-profile" class="mt-3 inline-block text-sm font-medium text-primary-700 hover:text-primary-800">
                Be the first to offer a skill
              </a>
            </div>
          )}
        </div>

        <div>
          <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Requests</h3>
          {requests.length > 0 ? (
            <div class="mt-4 space-y-4">
              {requests.map((profile) => (
                <div class="rounded border border-slate-200 bg-slate-50 p-4">
                  <div class="flex items-start gap-4">
                    <img onerror="this.onerror=null; this.src='/images/unavailable-image.svg'; this.alt='Image unavailable';"
                      class="h-12 w-12 rounded object-cover"
                      src={profile.data.profileImage || '/images/avatars/default-avatar.png'}
                      alt={profile.data.name}
                    />
                    <div class="min-w-0 flex-1">
                      <h4 class="text-sm font-semibold text-slate-900">{profile.data.name}</h4>
                      <p class="mt-1 text-sm text-slate-700">{profile.data.skill}</p>
                      <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600">{profile.data.bio}</p>
                      <div class="mt-3 flex items-center justify-between gap-3">
                        <span class="text-xs text-slate-400">Posted {new Date(profile.data.dateJoined).toLocaleDateString()}</span>
                        <a href={`/skills-exchange/profile/${profile.id.replace('.md', '')}`} class="text-sm font-medium text-primary-700 hover:text-primary-800">
                          View profile
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="mt-4 rounded border border-dashed border-slate-300 bg-slate-50 px-4 py-8 text-center">
              <p class="text-sm text-slate-600">No one has requested this skill yet.</p>
              <a href="/skills-exchange/request" class="mt-3 inline-block text-sm font-medium text-primary-700 hover:text-primary-800">
                Be the first to request a skill
              </a>
            </div>
          )}
        </div>
      </div>
    </section>
  </div>

  <div id="notification-container" class="fixed bottom-4 right-4 z-50 flex flex-col space-y-2"></div>

  <script>
    const matchBtn = document.getElementById('match-all-btn');

    if (matchBtn) {
      matchBtn.addEventListener('click', async () => {
        const category = matchBtn.dataset.category;
        const originalText = matchBtn.textContent;

        matchBtn.disabled = true;
        matchBtn.textContent = 'Processing...';
        matchBtn.classList.add('opacity-75', 'cursor-not-allowed');

        try {
          const response = await fetch('/api/match-category', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ category })
          });

          const data = await response.json();

          if (response.ok) {
            showNotification(data.message, 'success');
          } else {
            showNotification(data.message || 'Failed to process matches', 'error');
          }
        } catch (error) {
          console.error('Error:', error);
          showNotification('An unexpected error occurred', 'error');
        } finally {
          matchBtn.disabled = false;
          matchBtn.textContent = originalText;
          matchBtn.classList.remove('opacity-75', 'cursor-not-allowed');
        }
      });
    }

    function showNotification(message, type = 'info') {
      const container = document.getElementById('notification-container');
      const notification = document.createElement('div');

      let bgColor;
      switch (type) {
        case 'success':
          bgColor = 'bg-green-600';
          break;
        case 'error':
          bgColor = 'bg-red-600';
          break;
        default:
          bgColor = 'bg-slate-700';
      }

      notification.className = `${bgColor} text-white px-4 py-3 rounded-lg shadow-lg max-w-md transform transition-all duration-300 ease-in-out translate-x-0 mb-2`;
      notification.innerHTML = `
        <div class="flex items-center">
          <div class="flex-1"><p class="text-sm font-medium">${message}</p></div>
          <button class="min-h-[44px] ml-4 text-white opacity-75 hover:opacity-100 focus:outline-none" onclick="this.parentElement.parentElement.remove()">
            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      `;

      container.appendChild(notification);

      setTimeout(() => {
        if (notification.parentNode) {
          notification.classList.add('opacity-0', 'translate-x-full');
          setTimeout(() => notification.remove(), 300);
        }
      }, 5000);
    }
  </script>
</MainLayout>

<style>
.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
