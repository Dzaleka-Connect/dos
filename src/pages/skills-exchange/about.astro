---
import MainLayout from '../../layouts/MainLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const pageTitle = 'About Skills Exchange';
const pageDescription = 'Learn how the Dzaleka Skills Exchange helps community members share experience, find support, and build income opportunities.';

const allProfiles = await getCollection('profiles');
const featuredProfiles = allProfiles
  .filter((profile) => profile.data.status === 'Available')
  .slice(0, 6);

const totalProfiles = allProfiles.length;
const availableSkills = allProfiles.filter((profile) => profile.data.status === 'Available').length;
const requestedSkills = allProfiles.filter((profile) => profile.data.status === 'Requested').length;
const categories = [...new Set(allProfiles.map((profile) => profile.data.category))].length;

const summaryStats = [
  { label: 'Community profiles', value: totalProfiles },
  { label: 'Skills offered', value: availableSkills },
  { label: 'Learning requests', value: requestedSkills },
  { label: 'Categories', value: categories }
];

const processSteps = [
  {
    title: 'Create a profile',
    description: 'Add your skill, experience, contact details, and the kind of support or learning you offer.'
  },
  {
    title: 'Find a match',
    description: 'Browse skills offered or requests, then connect directly with the person most relevant to you.'
  },
  {
    title: 'Build opportunities',
    description: 'Use the exchange to earn income, strengthen community networks, and support practical learning.'
  }
];

const values = [
  {
    title: 'Community',
    description: 'Skills are treated as shared assets that can support both livelihoods and learning.'
  },
  {
    title: 'Trust',
    description: 'Clear profiles and direct contact help people build reliable working relationships.'
  },
  {
    title: 'Self-reliance',
    description: 'The exchange supports practical ways for people to use their experience to generate opportunity.'
  },
  {
    title: 'Learning',
    description: 'People can teach, learn, and grow without needing a formal institution to get started.'
  }
];
---

<MainLayout title={pageTitle} description={pageDescription}>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-8">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Skills Exchange', href: '/skills-exchange' },
            { label: 'About' }
          ]}
        />
      </div>

      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(260px,0.8fr)] lg:items-start">
        <div class="max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Overview</p>
          <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">About Skills Exchange</h1>
          <p class="mt-4 text-lg leading-8 text-slate-600">
            Skills Exchange is a community listing service for people who want to offer a skill, learn from someone else,
            or connect around practical work, training, and income opportunities in Dzaleka.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/skills-exchange/list-profile"
              class="min-h-[44px] inline-flex items-center rounded bg-primary-600 px-5 py-3 text-sm font-medium text-white hover:bg-primary-700"
            >
              Add your profile
            </a>
            <a
              href="/skills-exchange/skills-offered"
              class="min-h-[44px] inline-flex items-center rounded border border-slate-300 px-5 py-3 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900"
            >
              Browse skills
            </a>
          </div>
        </div>

        <div class="rounded border border-slate-200 bg-slate-50 p-6">
          <h2 class="text-lg font-semibold text-slate-900">At a glance</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
            {summaryStats.map((stat) => (
              <div class="rounded border border-slate-200 bg-white px-4 py-4">
                <div class="text-sm text-slate-500">{stat.label}</div>
                <div class="mt-1 text-2xl font-semibold text-slate-900">{stat.value}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <section class="grid gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(280px,0.8fr)]">
      <div class="rounded border border-slate-200 bg-white p-6 sm:p-8">
        <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Why it exists</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-900">A practical platform for community knowledge</h2>
        <div class="mt-6 space-y-5 text-sm leading-7 text-slate-600 sm:text-base">
          <p>
            The exchange was built around a simple idea: people arriving in Dzaleka bring experience, professional skills,
            trades, and creative knowledge that can still be used to support others and generate work.
          </p>
          <p>
            Instead of treating that experience as invisible, the platform gives it a public place. Profiles make it easier
            for neighbours, learners, organisations, and collaborators to find relevant people and connect directly.
          </p>
          <p>
            The result is not only a directory. It is a local pathway for earning, teaching, learning, and building stronger
            community links through practical exchange.
          </p>
        </div>
      </div>

      <div class="rounded border border-slate-200 bg-white p-6">
        <h2 class="text-xl font-semibold text-slate-900">Mission and vision</h2>
        <div class="mt-5 space-y-5">
          <div class="rounded border border-slate-200 bg-slate-50 p-4">
            <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Mission</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              Support a reliable ecosystem where people can offer expertise, find training, and build self-reliance through
              practical community connections.
            </p>
          </div>
          <div class="rounded border border-slate-200 bg-slate-50 p-4">
            <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Vision</h3>
            <p class="mt-2 text-sm leading-6 text-slate-600">
              A community where skills are visible, learning is accessible, and talent can lead to dignity, opportunity, and
              stronger local networks.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-12">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Community profiles</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900">Examples from the exchange</h2>
        </div>
        <a href="/skills-exchange/skills-offered" class="text-sm font-medium text-primary-700 hover:text-primary-800">
          Browse all skills
        </a>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {featuredProfiles.map((profile) => (
          <a
            href={`/skills-exchange/profile/${profile.id.replace('.md', '')}`}
            class="rounded border border-slate-200 bg-white p-5 transition-colors hover:border-slate-300 hover:bg-slate-50"
          >
            <div class="flex items-center gap-3">
              <img onerror="this.onerror=null; this.src='/images/unavailable-image.svg'; this.alt='Image unavailable';"
                src={profile.data.profileImage}
                alt={profile.data.name}
                class="h-12 w-12 rounded object-cover"
              />
              <div class="min-w-0">
                <h3 class="truncate text-base font-semibold text-slate-900">{profile.data.name}</h3>
                <p class="mt-1 text-sm text-slate-500">{profile.data.skill}</p>
              </div>
            </div>
            <p class="mt-4 line-clamp-3 text-sm leading-6 text-slate-600">{profile.data.shortDescription}</p>
            <div class="mt-4">
              <span class="rounded-md border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">
                Available
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-12 grid gap-8 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">How it works</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-900">Simple steps for sharing or learning</h2>
        <div class="mt-6 space-y-4">
          {processSteps.map((step, index) => (
            <div class="rounded border border-slate-200 bg-white p-5">
              <div class="flex items-start gap-4">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-slate-100 text-sm font-semibold text-slate-700">
                  {index + 1}
                </div>
                <div>
                  <h3 class="text-base font-semibold text-slate-900">{step.title}</h3>
                  <p class="mt-2 text-sm leading-6 text-slate-600">{step.description}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Principles</p>
        <h2 class="mt-2 text-2xl font-semibold text-slate-900">What guides the platform</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {values.map((value) => (
            <div class="rounded border border-slate-200 bg-white p-5">
              <h3 class="text-base font-semibold text-slate-900">{value.title}</h3>
              <p class="mt-2 text-sm leading-6 text-slate-600">{value.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mt-12 rounded border border-slate-200 bg-slate-50 p-6 sm:p-8">
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Get started</p>
          <h2 class="mt-2 text-2xl font-semibold text-slate-900">Join the exchange</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600 sm:text-base">
            Add your profile if you want to share a skill, or browse the exchange if you want to find someone to learn from.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a
            href="/skills-exchange/list-profile"
            class="min-h-[44px] inline-flex items-center justify-center rounded bg-primary-600 px-5 py-3 text-sm font-medium text-white hover:bg-primary-700"
          >
            Add your profile
          </a>
          <a
            href="/skills-exchange/request"
            class="min-h-[44px] inline-flex items-center justify-center rounded border border-slate-300 bg-white px-5 py-3 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900"
          >
            Request a skill
          </a>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<style>
.line-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
</style>
