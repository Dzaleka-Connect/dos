---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';

export async function getStaticPaths() {
  const profiles = await getCollection('profiles');
  return profiles.map((profile) => ({
    params: { slug: profile.id.replace('.md', '') },
    props: { profile }
  }));
}

const { profile } = Astro.props;
const { Content } = await render(profile);

const {
  name,
  skill,
  status,
  requestStatus,
  helpOfferedBy,
  helpOfferedDate,
  email,
  location,
  profileImage,
  languages,
  availability,
  shortDescription,
  socialMedia,
  phone,
  website,
  category,
  level,
  chargeType,
  rate,
  paymentMethods
} = profile.data;

const contactLinks = [
  email ? { href: `mailto:${email}`, label: 'Email' } : null,
  phone ? { href: `tel:${phone}`, label: 'Call' } : null,
  website ? { href: website, label: 'Website', external: true } : null
].filter(Boolean);

const socialLinks = [
  socialMedia?.linkedin ? { href: socialMedia.linkedin, label: 'LinkedIn' } : null,
  socialMedia?.twitter ? { href: socialMedia.twitter, label: 'Twitter' } : null,
  socialMedia?.instagram ? { href: socialMedia.instagram, label: 'Instagram' } : null
].filter(Boolean);

const statusLabel =
  status === 'Available' ? 'Available' :
  status === 'Unavailable' ? 'Unavailable' :
  status || 'Profile';

const statusBadgeClass =
  status === 'Available'
    ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
    : status === 'Unavailable'
      ? 'bg-red-50 text-red-700 border-red-200'
      : 'bg-amber-50 text-amber-700 border-amber-200';

const requestStatusBadgeClass =
  requestStatus === 'Open'
    ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
    : requestStatus === 'HelpOffered'
      ? 'bg-amber-50 text-amber-700 border-amber-200'
      : requestStatus === 'Completed'
        ? 'bg-sky-50 text-sky-700 border-sky-200'
        : 'bg-slate-100 text-slate-700 border-slate-200';
---

<MainLayout title={`${name} - Skills Profile`} description={shortDescription || `${name}'s skills profile`}>
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-8">
        <Breadcrumb
          items={[
            { label: 'Home', href: '/' },
            { label: 'Skills Exchange', href: '/skills-exchange' },
            { label: name }
          ]}
        />
      </div>

      <div class="grid gap-8 md:grid-cols-[160px_minmax(0,1fr)] md:items-start">
        <div class="w-32 h-32 sm:w-40 sm:h-40 overflow-hidden rounded-lg border border-slate-200 bg-slate-100">
          <img src={profileImage} alt={`${name}'s profile picture`} class="h-full w-full object-cover" />
        </div>

        <div>
          <div class="flex flex-wrap items-center gap-2">
            <span class={`rounded-md border px-2.5 py-1 text-xs font-medium ${statusBadgeClass}`}>{statusLabel}</span>
            {category && <span class="rounded-md border border-slate-200 px-2.5 py-1 text-xs text-slate-700">{category}</span>}
            {level && <span class="rounded-md border border-slate-200 px-2.5 py-1 text-xs text-slate-700">{level}</span>}
            {chargeType && <span class="rounded-md border border-slate-200 px-2.5 py-1 text-xs text-slate-700">{chargeType}</span>}
          </div>

          <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900">{name}</h1>
          <p class="mt-3 text-lg font-medium text-slate-700">{skill}</p>
          {shortDescription && <p class="mt-4 text-base leading-7 text-slate-600">{shortDescription}</p>}
          {location && <p class="mt-4 text-sm text-slate-500">{location}</p>}

          <div class="mt-6 flex flex-wrap gap-3">
            {contactLinks.map((link) => (
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                class="inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900"
              >
                {link.label}
              </a>
            ))}
            <a
              href={`/skills-exchange/update-profile?profile=${Astro.params.slug}`}
              class="inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900"
            >
              Update profile
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <article class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    {requestStatus && (
      <section class="mb-10 rounded-lg border border-slate-200 bg-white p-6">
        <p class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Request status</p>
        <div class="mt-3">
          <span class={`inline-flex rounded-md border px-3 py-1.5 text-sm font-medium ${requestStatusBadgeClass}`}>{requestStatus}</span>
        </div>
        {(helpOfferedBy || helpOfferedDate) && (
          <div class="mt-4 space-y-1 text-sm text-slate-600">
            {helpOfferedBy && <p>Help offered by: {helpOfferedBy}</p>}
            {helpOfferedDate && <p>Date: {helpOfferedDate}</p>}
          </div>
        )}
      </section>
    )}

    <div class="mx-auto max-w-3xl">
      <div class="prose prose-lg max-w-none prose-headings:text-slate-900 prose-p:text-slate-700 prose-li:text-slate-700 prose-a:text-primary-700">
        <Content />
      </div>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      {(languages || availability || location) && (
        <section class="rounded-lg border border-slate-200 bg-white p-6">
          <h2 class="text-xl font-semibold text-slate-900">Profile details</h2>
          <div class="mt-5 space-y-5">
            {languages && (
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Languages</h3>
                <div class="mt-3 flex flex-wrap gap-2">
                  {languages.map((lang) => (
                    <span class="rounded-md border border-slate-200 px-3 py-1 text-sm text-slate-700">{lang}</span>
                  ))}
                </div>
              </div>
            )}
            {availability && (
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Availability</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">{availability}</p>
              </div>
            )}
            {location && (
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Location</h3>
                <p class="mt-2 text-sm leading-6 text-slate-600">{location}</p>
              </div>
            )}
          </div>
        </section>
      )}

      {(chargeType === 'paid' || socialLinks.length > 0 || website) && (
        <section class="rounded-lg border border-slate-200 bg-white p-6">
          <h2 class="text-xl font-semibold text-slate-900">Additional information</h2>
          <div class="mt-5 space-y-5">
            {chargeType === 'paid' && (
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Payment</h3>
                <div class="mt-3 space-y-3 text-sm text-slate-600">
                  {rate && <p>Rate: <span class="font-medium text-slate-900">{rate}</span></p>}
                  {paymentMethods && paymentMethods.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {paymentMethods.map((method) => (
                        <span class="rounded-md border border-slate-200 px-3 py-1 text-sm text-slate-700">{method.type}</span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            )}

            {(socialLinks.length > 0 || website) && (
              <div>
                <h3 class="text-sm font-semibold uppercase tracking-[0.12em] text-slate-500">Links</h3>
                <div class="mt-3 flex flex-wrap gap-3">
                  {socialLinks.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900"
                    >
                      {link.label}
                    </a>
                  ))}
                  {website && (
                    <a
                      href={website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:border-slate-400 hover:text-slate-900"
                    >
                      Website
                    </a>
                  )}
                </div>
              </div>
            )}
          </div>
        </section>
      )}
    </div>
  </article>
</MainLayout>
