{
  "$ref": "#/definitions/marketplace",
  "definitions": {
    "marketplace": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "product",
            "service"
          ]
        },
        "category": {
          "type": "string"
        },
        "price": {
          "type": "string"
        },
        "priceType": {
          "type": "string",
          "enum": [
            "fixed",
            "negotiable",
            "free",
            "contact"
          ],
          "default": "contact"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vendor": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "whatsapp": {
              "type": "string"
            },
            "location": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "sold",
            "pending",
            "inactive"
          ],
          "default": "pending"
        },
        "featured": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "datePosted": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "condition": {
          "type": "string",
          "enum": [
            "new",
            "used",
            "refurbished"
          ]
        },
        "quantity": {
          "type": "number"
        },
        "deliveryOptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paymentMethods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "externalLink": {
          "type": "string",
          "format": "uri"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "type",
        "category",
        "vendor",
        "datePosted"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}