{
  "$ref": "#/definitions/courses",
  "definitions": {
    "courses": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "authorEmail": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "technology",
            "business",
            "languages",
            "arts",
            "health",
            "science",
            "professional-skills",
            "personal-development",
            "other"
          ]
        },
        "duration": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ],
          "default": "beginner"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "thumbnail": {
          "type": "string"
        },
        "videoUrl": {
          "type": "string"
        },
        "externalLink": {
          "type": "string",
          "format": "uri"
        },
        "featured": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "published",
            "draft",
            "pending"
          ],
          "default": "pending"
        },
        "datePublished": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "lastUpdated": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "author",
        "description",
        "category",
        "duration",
        "datePublished"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}